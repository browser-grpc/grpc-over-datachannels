#lang racket

;;; metagen.rkt — the recursive metaprogram.
;;;
;;; Run:  racket racket/metagen.rkt
;;;
;;; Three levels of generation happen here:
;;;   1. Macros in spec.rkt recursively expand the wire tables into codec
;;;      constants and dispatch (macro recursion over table entries).
;;;   2. THIS program reads spec/pb/desc/template modules as *syntax*,
;;;      strips their module plumbing, and splices the bodies into three
;;;      standalone protoc plugins
;;;      (bin/protoc-gen-grpc-dc-{rust,js,go}). The plugins are programs
;;;      that generate programs.
;;;   3. This program also stamps the wire tables into Rust, JS and Go
;;;      (wire_gen.*), emits each language's runtime from
;;;      racket/runtime-<lang>.rkt (bodies + frame dispatch recursively
;;;      expanded from the spec tables), and emits golden frame fixtures
;;;      that all implementations test against. No language runtime uses
;;;      an external gRPC or protobuf library.
;;;
;;; The generated plugins recursively walk CodeGeneratorRequest descriptors
;;; (request -> file -> service -> method) to emit stubs — generation all
;;; the way down.

(require "spec.rkt" "pb.rkt" json racket/runtime-path "webrtc-gen.rkt"
         "oracle-spec.rkt" "oracle-gen.rkt" "bdd-gen.rkt" "webgen.rkt" "mux-gen.rkt"
         "interop-gen.rkt"
         "proxy-gen.rkt" "http2-gen.rkt"
         "runtime-go.rkt" "runtime-js.rkt" "runtime-rust.rkt" "runtime-python.rkt" "runtime-java.rkt" "runtime-csharp.rkt" "runtime-cpp.rkt" "runtime-swift.rkt" "runtime-kotlin.rkt" "runtime-dart.rkt" "runtime-zig.rkt" "runtime-c.rkt" "runtime-lua.rkt" "runtime-ruby.rkt" "runtime-php.rkt" "runtime-scala.rkt")

(define-runtime-path here ".")
(define root (build-path here ".."))

;; ---------------------------------------------------------------------------
;; Read a module file as syntax forms, minus #lang / require / provide.
;; (Splice at the syntax level, not the text level: forms are re-printed
;;  into the generated plugin, so multi-line provide/require forms and
;;  macro definitions survive intact.)
;; ---------------------------------------------------------------------------

(define (module-body-forms relpath)
  (define path (build-path here relpath))
  (call-with-input-file path
    (lambda (in)
      (read-line in) ; discard #lang line
      (port-count-lines! in)
      (let loop ([acc '()])
        (define stx (read-syntax path in))
        (if (eof-object? stx)
            (reverse acc)
            (let ([datum (syntax->datum stx)])
              (if (and (pair? datum) (memq (car datum) '(require provide)))
                  (loop acc)
                  (loop (cons stx acc)))))))))

(define (write-forms forms out)
  (for ([f (in-list forms)])
    (pretty-write (syntax->datum f) out)
    (newline out)))

;; ---------------------------------------------------------------------------
;; Plugin assembly
;; ---------------------------------------------------------------------------

(define plugin-main-template
  '(define (plugin-main)
     (define request-bytes (port->bytes (current-input-port)))
     (define-values (files parameter) (parse-request request-bytes))
     (define params (parse-parameters parameter))
     ;; trace=off|hooks gates stub-level tracing wiring. The
     ;; generated runtimes always carry the (dormant) tracer API;
     ;; any other value is a usage error.
     (define trace-opt (hash-ref params 'trace #f))
     (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
       (error (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
     ;; trace_methods=';'-separated method paths (trailing '*'
     ;; is a prefix match) restricts which methods are traced;
     ;; only meaningful with trace=hooks.
     (define trace-methods (hash-ref params 'trace_methods #f))
     (when trace-methods
       (unless (equal? trace-opt "hooks")
         (error "trace_methods requires trace=hooks"))
       (for ([p (in-list (string-split trace-methods ";"))])
         (unless (string-prefix? p "/")
           (error (format "trace_methods pattern must start with /: ~a" p)))))
     ;; An emit function returns one (name . content) pair or a
     ;; list of them (stub + generated message classes).
     (define (as-file-list out)
       (if (and (pair? out) (string? (car out))) (list out) out))
     (write-bytes (encode-response
                   (append-map (lambda (f) (map stamp-generated-header (as-file-list (EMIT-FN f params)))) files))
                  (current-output-port))
     (flush-output)))

(define (plugin-source emit-fn)
  (define out (open-output-string))
  (fprintf out "#!/usr/bin/env racket\n#lang racket\n")
  (fprintf out ";; @generated by grpc-dc codegen — DO NOT EDIT.\n")
  (fprintf out "(require (for-syntax racket/syntax))\n\n")
  (for ([rel (in-list '("spec.rkt" "pb.rkt" "desc.rkt"))])
    (write-forms (module-body-forms rel) out))
  (write-forms (module-body-forms (case emit-fn
                                    [(emit-rust-file) "template-rust.rkt"]
                                    [(emit-go-file) "template-go.rkt"]
                                    [(emit-python-file) "template-python.rkt"]
                                    [(emit-java-file) "template-java.rkt"]
                                    [(emit-csharp-file) "template-csharp.rkt"]
                                    [(emit-cpp-file) "template-cpp.rkt"]
                                    [(emit-swift-file) "template-swift.rkt"]
                                    [(emit-kotlin-file) "template-kotlin.rkt"]
                                    [(emit-dart-file) "template-dart.rkt"]
                                    [(emit-zig-file) "template-zig.rkt"]
                                    [(emit-c-file) "template-c.rkt"]
                                    [(emit-lua-file) "template-lua.rkt"]
                                    [(emit-ruby-file) "template-ruby.rkt"]
                                    [(emit-php-file) "template-php.rkt"]
                                    [(emit-scala-file) "template-scala.rkt"]
                                    [(emit-wasm-scala-file) "template-wasm-scala.rkt"]
                                    [(emit-wasm-go-file) "template-wasm-go.rkt"]
                                    [(emit-wasm-zig-file) "template-wasm-zig.rkt"]
                                    [(emit-wasm-cpp-file) "template-wasm-cpp.rkt"]
                                    [(emit-wasm-swift-file) "template-wasm-swift.rkt"]
                                    [(emit-wasm-kotlin-file) "template-wasm-kotlin.rkt"]
                                    [(emit-wasm-kotlin-native-file) "template-kotlin.rkt"]
                                    [else "template-js.rkt"]))
               out)
  ;; Splice the emit function name into the main form at the datum level.
  (pretty-write (let loop ([d plugin-main-template])
                  (cond [(eq? d 'EMIT-FN) emit-fn]
                        [(pair? d) (cons (loop (car d)) (loop (cdr d)))]
                        [else d]))
                out)
  (pretty-write '(with-handlers ([exn:fail? (lambda (e)
                                              (write-bytes (encode-error-response (exn-message e))
                                                           (current-output-port))
                                              (flush-output))])
                   (plugin-main))
                out)
  (get-output-string out))

(define (write-plugin filename emit-fn)
  (define path (build-path root "bin" filename))
  (call-with-output-file path #:exists 'replace
    (lambda (out) (display (plugin-source emit-fn) out)))
  (file-or-directory-permissions
   path (bitwise-ior (file-or-directory-permissions path 'bits) #o111))
  (printf "generated ~a\n" (path->string path)))

;; ---------------------------------------------------------------------------
;; wire_gen.rs / wire_gen.js — recursive stamping of the spec tables
;; ---------------------------------------------------------------------------

(define (const-name sym) ; HALF-CLOSE -> HALF_CLOSE
  (string-replace (symbol->string sym) "-" "_"))

(define (pascal-name sym) ; INVALID-ARGUMENT -> InvalidArgument
  (apply string-append
         (for/list ([part (in-list (string-split (symbol->string sym) "-"))])
           (string-append (string (char-upcase (string-ref part 0)))
                          (string-downcase (substring part 1))))))

(define (emit-rust-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n//! @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "/// Frame type bytes (SPEC.md). First byte of every DataChannel message.\n"
   "pub mod frame_type {\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "    /// ~a\n    pub const ~a: u8 = ~a;\n"
                    (third e) (const-name (first e)) (second e))))
   "}\n\n"
   "/// gRPC status codes.\n"
   "#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]\n#[repr(u32)]\n"
   "pub enum Code {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "    ~a = ~a,\n" (pascal-name (first e)) (second e))))
   "}\n\n"
   "impl Code {\n"
   "    pub fn from_u32(v: u32) -> Option<Self> {\n        Some(match v {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "            ~a => Self::~a,\n" (second e) (pascal-name (first e)))))
   "            _ => return None,\n        })\n    }\n"
   "    pub fn name(self) -> &'static str {\n        match self {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "            Self::~a => ~s,\n" (pascal-name (first e)) (symbol->string (first e)))))
   "        }\n    }\n}\n"))

(define (pascal-go sym) ; INVALID-ARGUMENT -> InvalidArgument (Code suffix shape)
  (pascal-name sym))

(define (emit-go-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "package grpcdc\n\n"
   "import \"strconv\"\n\n"
   "// Frame type bytes (SPEC.md). First byte of every DataChannel message.\n"
   "type FrameType byte\n\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "// Frame~a: ~a\nconst Frame~a FrameType = ~a\n\n"
                    (pascal-go (first e)) (third e) (pascal-go (first e)) (second e))))
   "// Valid reports whether f is a known frame type.\n"
   "func (f FrameType) Valid() bool {\n\tswitch f {\n\tcase "
   (string-join
    (for/list ([e (in-list frame-table)]) (format "Frame~a" (pascal-go (first e))))
    ", ")
   ":\n\t\treturn true\n\t}\n\treturn false\n}\n\n"
   "// Code is a gRPC status code.\n"
   "type Code int32\n\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "const Code~a Code = ~a\n\n" (pascal-go (first e)) (second e))))
   "// Name returns the canonical status name (CODE_N for unknown codes).\n"
   "func (c Code) Name() string {\n\tswitch c {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "\tcase Code~a:\n\t\treturn ~s\n" (pascal-go (first e)) (symbol->string (first e)))))
   "\t}\n\treturn \"CODE_\" + strconv.Itoa(int(c))\n}\n"))

(define (emit-js-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "export const FrameType = {\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "  ~a: ~a, // ~a\n" (const-name (first e)) (second e) (third e))))
   "};\n\n"
   "export const StatusCode = {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "  ~a: ~a,\n" (const-name (first e)) (second e))))
   "};\n\n"
   "export const StatusName = {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "  ~a: ~s,\n" (second e) (symbol->string (first e)))))
   "};\n"))

;; screaming-name shared with runtime-python (HALF-CLOSE -> HALF_CLOSE).

(define (emit-java-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "package grpcdc;\n\n"
   "/** Frame type bytes and gRPC status codes (SPEC.md). */\n"
   "public final class Wire {\n"
   "    private Wire() {}\n\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "    /** ~a */\n    public static final int FRAME_~a = ~a;\n"
                    (third e) (screaming-name-p (first e)) (second e))))
   "\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "    public static final int CODE_~a = ~a;\n"
                    (screaming-name-p (first e)) (second e))))
   "\n    /** True when value is a known frame type. */\n"
   "    public static boolean isFrameType(int value) {\n"
   "        return switch (value) {\n"
   (format "            case ~a -> true;\n"
           (string-join (for/list ([e (in-list frame-table)])
                          (format "FRAME_~a" (screaming-name-p (first e)))) ", "))
   "            default -> false;\n"
   "        };\n"
   "    }\n\n"
   "    /** Canonical status name (CODE_N for unknown codes). */\n"
   "    public static String statusName(int code) {\n"
   "        return switch (code) {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "            case CODE_~a -> ~s;\n" (screaming-name-p (first e)) (symbol->string (first e)))))
   "            default -> \"CODE_\" + code;\n"
   "        };\n"
   "    }\n"
   "}\n"))

;; C# wire tables (PascalCase constant names).
(define (pascal-wire sym) ; HALF-CLOSE -> HalfClose ; INVALID-ARGUMENT -> InvalidArgument
  (apply string-append
         (for/list ([part (in-list (string-split (symbol->string sym) "-"))])
           (string-append (string (char-upcase (string-ref part 0)))
                          (string-downcase (substring part 1))))))

(define (emit-csharp-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "namespace Grpcdc;\n\n"
   "/// <summary>Frame type bytes and gRPC status codes (SPEC.md).</summary>\n"
   "public static class Wire\n{\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "    /// <summary>~a</summary>\n    public const int Frame~a = ~a;\n"
                    (third e) (pascal-wire (first e)) (second e))))
   "\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "    public const int Code~a = ~a;\n" (pascal-wire (first e)) (second e))))
   "\n    /// <summary>True when value is a known frame type.</summary>\n"
   "    public static bool IsFrameType(int value) => value switch\n    {\n"
   (format "        ~a => true,\n"
           (string-join (for/list ([e (in-list frame-table)])
                          (format "Frame~a" (pascal-wire (first e)))) " or "))
   "        _ => false,\n    };\n\n"
   "    /// <summary>Canonical status name (CODE_N for unknown codes).</summary>\n"
   "    public static string StatusName(int code) => code switch\n    {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "        Code~a => ~s,\n" (pascal-wire (first e)) (symbol->string (first e)))))
   "        _ => \"CODE_\" + code,\n    };\n}\n"))

