           (string-append (string (char-upcase (string-ref part 0)))
                          (string-downcase (substring part 1))))))

(define (emit-cpp-wire)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by racket/metagen.rkt from racket/spec.rkt. DO NOT EDIT.\n"
   "#pragma once\n\n"
   "#include <string>\n\n"
   "namespace grpcdc {\n\n"
   "/// Frame type bytes and gRPC status codes (SPEC.md).\n"
   "namespace wire {\n\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "/// ~a\nconstexpr int kFrame~a = ~a;\n"
                    (third e) (cpp-wire-name (first e)) (second e))))
   "\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "constexpr int kCode~a = ~a;\n"
                    (cpp-wire-name (first e)) (second e))))
   "\n/// True when value is a known frame type.\n"
   "inline bool IsFrameType(int value) {\n"
   (format "  return ~a;\n"
           (string-join (for/list ([e (in-list frame-table)])
                          (format "value == kFrame~a" (cpp-wire-name (first e)))) " ||\n         "))
   "}\n\n"
   "/// Canonical status name (CODE_N for unknown codes).\n"
   "inline std::string StatusName(int code) {\n"
   "  switch (code) {\n"
   (apply string-append
          (for/list ([e (in-list status-table)])
            (format "    case kCode~a: return ~s;\n"
                    (cpp-wire-name (first e)) (symbol->string (first e)))))
   "    default: return \"CODE_\" + std::to_string(code);\n"
   "  }\n"
   "}\n\n"
   "}  // namespace wire\n"
   "}  // namespace grpcdc\n"))

