;; ---------------------------------------------------------------------------
;; Golden fixtures — computed by the Racket codec, with the protobuf bytes
;; written as a hand-authored literal so Rust and JS encoders are checked
;; against an independent byte string.
;; ---------------------------------------------------------------------------

(define echo-request-protobuf-hex "0a0268691002") ; {message:"hi", count:2}

(define (emit-fixtures)
  (define headers-payload #"{\"path\":\"/echo.Echo/Unary\",\"metadata\":{}}")
  (define trailers-payload #"{\"code\":0,\"message\":\"\"}")
  (define data-payload (hex->bytes echo-request-protobuf-hex))
  (define vectors
    (hasheq 'frames
            (list (hasheq 'name "headers" 'type frame:HEADERS 'stream 1
                          'payload_utf8 (bytes->string/utf-8 headers-payload)
                          'hex (bytes->hex (encode-frame frame:HEADERS 1 headers-payload)))
                  (hasheq 'name "data" 'type frame:DATA 'stream 3
                          'payload_hex echo-request-protobuf-hex
                          'hex (bytes->hex (encode-frame frame:DATA 3 data-payload)))
                  (hasheq 'name "trailers" 'type frame:TRAILERS 'stream 1
                          'payload_utf8 (bytes->string/utf-8 trailers-payload)
                          'hex (bytes->hex (encode-frame frame:TRAILERS 1 trailers-payload))))
            'protobuf
            (hasheq 'echo_request
                    (hasheq 'message "hi" 'count 2 'delay_ms 0
                            'hex echo-request-protobuf-hex))))
  ;; The data-frame hex is also asserted against a fully literal expectation:
  ;; type=0x02 | stream=00000003 | len=00000006 | 0a0268691002.
  (unless (equal? (bytes->hex (encode-frame frame:DATA 3 data-payload))
                  "0200000003000000060a0268691002")
    (error 'metagen "data frame fixture mismatch"))
  (call-with-output-file (build-path root "fixtures" "vectors.json") #:exists 'replace
    (lambda (out) (write-json vectors out) (newline out)))
  (printf "generated fixtures/vectors.json\n"))

;; ---------------------------------------------------------------------------

;; ---------------------------------------------------------------------------
;; Runtime emission: each language's runtime files are generated from
;; the racket/runtime-<lang>.rkt template modules.
;; ---------------------------------------------------------------------------

(define (write-runtime-files subdir template-name files)
  (for ([f (in-list files)])
    (define path (build-path root subdir (car f)))
    (make-directory* (path-only path))
    (call-with-output-file path #:exists 'replace
      (lambda (out)
        (define comment
          (cond [(string-suffix? (car f) ".py") "#"]
                [(string-suffix? (car f) ".rb") "#"]
                [(string-suffix? (car f) ".lua") "--"]
                [else "//"]))
        (fprintf out "~a @generated by racket/metagen.rkt from racket/~a. DO NOT EDIT.\n"
                 comment template-name)
        (fprintf out "~a SPDX-License-Identifier: Apache-2.0\n" comment)
        (display (cdr f) out)
        (unless (string-suffix? (cdr f) "\n") (newline out))))
    (printf "generated ~a\n" (path->string path))))

;; ---------------------------------------------------------------------------
;; Oracle scenarios: one table, recursively stamped into a line-based
;; file that the official-grpc oracle drivers in every language consume
;; verbatim (fixtures/oracle_scenarios.txt). Grammar, one case per line:
;;   UNARY <msg> [EXPECT_STATUS <code>]      ("-" encodes empty message)
;;   SERVER_STREAM <msg> <count>
;;   CLIENT_STREAM <msg>...
;;   BIDI <msg>...
;; Expectation rules are the shared Echo semantics (see the drivers):
;; unary echoes "echo: <msg>", fail -> INVALID_ARGUMENT, streams echo
;; in order, client-stream joins with "+".
;; ---------------------------------------------------------------------------

(define (emit-oracle-scenarios)
  (define text
    (string-append
     "# @generated by racket/metagen.rkt — oracle scenarios, DO NOT EDIT.\n"
     (apply string-append
            (for/list ([s (in-list oracle-scenario-table)])
              (string-append
               (string-join (map (lambda (x) (format "~a" x)) s) " ")
               "\n")))))
  (call-with-output-file (build-path root "fixtures" "oracle_scenarios.txt") #:exists 'replace
    (lambda (out) (display text out)))
  (printf "generated fixtures/oracle_scenarios.txt\n"))

(define (write-bdd-docs)
  (define docs (emit-bdd-docs))
  (call-with-output-file (build-path root (car docs)) #:exists 'replace
    (lambda (out) (display (cdr docs) out)))
  (printf "generated ~a\n" (car docs)))

