;; ---------------------------------------------------------------------------
;; Golden fixtures — computed by the Racket codec, with the protobuf bytes
;; written as a hand-authored literal so Rust and JS encoders are checked
;; against an independent byte string.
;; ---------------------------------------------------------------------------

(define echo-request-protobuf-hex "0a0268691002") ; {message:"hi", count:2}

(define (emit-fixtures)
  (define headers-payload #"{\"path\":\"/echo.Echo/Unary\",\"metadata\":{}}")
  (define trailers-payload #"{\"code\":0,\"message\":\"\"}")
  (define data-payload (hex->bytes echo-request-protobuf-hex))
  (define vectors
    (hasheq 'frames
            (list (hasheq 'name "headers" 'type frame:HEADERS 'stream 1
                          'payload_utf8 (bytes->string/utf-8 headers-payload)
                          'hex (bytes->hex (encode-frame frame:HEADERS 1 headers-payload)))
                  (hasheq 'name "data" 'type frame:DATA 'stream 3
                          'payload_hex echo-request-protobuf-hex
                          'hex (bytes->hex (encode-frame frame:DATA 3 data-payload)))
                  (hasheq 'name "trailers" 'type frame:TRAILERS 'stream 1
                          'payload_utf8 (bytes->string/utf-8 trailers-payload)
                          'hex (bytes->hex (encode-frame frame:TRAILERS 1 trailers-payload))))
            'protobuf
            (hasheq 'echo_request
                    (hasheq 'message "hi" 'count 2 'delay_ms 0
                            'hex echo-request-protobuf-hex))))
  ;; The data-frame hex is also asserted against a fully literal expectation:
  ;; type=0x02 | stream=00000003 | len=00000006 | 0a0268691002.
  (unless (equal? (bytes->hex (encode-frame frame:DATA 3 data-payload))
                  "0200000003000000060a0268691002")
    (error 'metagen "data frame fixture mismatch"))
  (call-with-output-file (build-path root "fixtures" "vectors.json") #:exists 'replace
    (lambda (out) (write-json vectors out) (newline out)))
  (printf "generated fixtures/vectors.json\n"))

