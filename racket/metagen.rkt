(define browser-examples-readme
#<<BROWSER_EXAMPLES_EOF
# Browser examples: Echo in every Wasm language

Each language below runs its generated gRPC client in your
browser (Wasm facade over the JS wire runtime) against the
generated Echo server on the Node WebRTC stack.

Run them all with Docker (signaling included):

    docker compose --profile browser-examples up
    # open http://localhost:8080/ and pick a language

Or locally without Docker (first build the Wasm client
bundles once — they are build outputs, not source):

    make artifacts   # private tree; in the public tree the
                     # bundles ship prebuilt under browser-test/
    node examples/browser/server.mjs
    # open http://localhost:8080/

On a phone or second machine, use the tunnel profile:

    docker compose --profile tunnel-browser up
    # open the printed https://*.trycloudflare.com URL

The pages are the same harnesses the Playwright BDD suites
drive; the server exchanges SDP over WebSocket, then the gRPC
calls run peer-to-peer over the `grpc` DataChannel.
BROWSER_EXAMPLES_EOF
)

(define browser-examples-index
#<<BROWSER_INDEX_EOF
<!doctype html>
<meta charset="utf-8">
<title>grpc-dc browser examples</title>
<h1>Echo in every browser language</h1>
<p>Each client is generated code running in your browser; the server is the generated Echo service on the Node WebRTC stack. Signaling is WebSocket; gRPC runs over the <code>grpc</code> DataChannel.</p>
<ul id="langs"></ul>
<pre id="out">pick a language…</pre>
<script type="module">
const LANGS = __LANGS__;
const out = document.getElementById("out");
const list = document.getElementById("langs");
for (const [name, page, run] of LANGS) {
  const li = document.createElement("li");
  const a = document.createElement("a");
  a.href = "#"; a.textContent = name;
  a.onclick = async (ev) => {
    ev.preventDefault();
    out.textContent = `running ${name}…`;
    const frame = document.createElement("iframe");
    frame.style.display = "none";
    frame.src = "/browser-test/" + page;
    document.body.appendChild(frame);
    const win = frame.contentWindow;
    await new Promise((r) => { const t = setInterval(() => { if (win.__offer) { clearInterval(t); r(); } }, 100); });
    const ws = new WebSocket(`${location.protocol === "https:" ? "wss" : "ws"}://${location.host}/`);
    await new Promise((r) => { ws.onopen = r; });
    ws.send(JSON.stringify({ kind: "offer", sdp: win.__offer }));
    const answer = await new Promise((r) => { ws.onmessage = (e) => { const m = JSON.parse(e.data); if (m.kind === "answer") r(m.sdp); }; });
    await win.__acceptAnswer(answer);
    const result = await win[run]();
    out.textContent = `${name}: ` + JSON.stringify(result);
    frame.remove(); ws.close();
  };
  li.appendChild(a); list.appendChild(li);
}
</script>
BROWSER_INDEX_EOF
)

(define browser-examples-server
#<<BROWSER_SERVER_EOF
import { createServer } from "node:http";
import { readFile } from "node:fs/promises";
import { extname, join, normalize } from "node:path";
import { fileURLToPath } from "node:url";
import { WebSocketServer } from "../starter/signal.mjs";
import { Peer } from "../../webrtc/js/peer.js";
import { Server, StatusCode, StatusError } from "../../js/index.js";
import { EchoResponse } from "../../js/examples/echo_pb.js";
import { createEchoService } from "../../js/examples/echo_grpc_dc.js";
const ROOT = fileURLToPath(new URL("../..", import.meta.url));
const HERE = fileURLToPath(new URL(".", import.meta.url));
const PORT = Number(process.env.PORT || 8080);
const MIME = { ".html": "text/html", ".js": "text/javascript", ".mjs": "text/javascript", ".wasm": "application/wasm" };
const handlers = {
  async unary(req, ctx) {
    if (req.message === "fail") throw new StatusError(StatusCode.INVALID_ARGUMENT, "asked to fail");
    if (req.delayMs > 0) await new Promise((r) => setTimeout(r, req.delayMs));
    const md = ctx?.metadata;
    const mv = typeof md?.get === "function" ? md.get("x-echo") : md?.["x-echo"];
    return new EchoResponse({ message: `echo: ${req.message}${mv ? ` [${mv}]` : ""}`, index: 0 });
  },
  async *serverStream(req) {
    if (req.message === "fail") throw new StatusError(StatusCode.INVALID_ARGUMENT, "asked to fail");
    for (let i = 0; i < Math.max(0, req.count); i++) yield new EchoResponse({ message: req.message, index: i });
  },
  async clientStream(requests) { const p = []; for await (const r of requests) p.push(r.message); return new EchoResponse({ message: p.join("+"), index: p.length }); },
  async *bidi(requests) { let i = 0; for await (const r of requests) { if (r.message === "fail") throw new StatusError(StatusCode.INVALID_ARGUMENT, "asked to fail"); yield new EchoResponse({ message: r.message, index: i++ }); } },
};
const http = createServer(async (req, res) => {
  try {
    const url = new URL(req.url, "http://x");
    const rel = url.pathname === "/" ? "index.html" : decodeURIComponent(url.pathname.slice(1));
    const base = (rel.startsWith("js/") || rel.startsWith("webrtc/") || rel.startsWith("browser-test/")) ? ROOT : HERE;
    const path = normalize(join(base, rel));
    if (!path.startsWith(base)) throw new Error("outside served dir");
    const body = await readFile(path);
    res.writeHead(200, {
      "content-type": MIME[extname(path)] ?? "application/octet-stream",
      // Lua/Rust native Wasm clients use a SharedArrayBuffer
      // worker mailbox; that needs cross-origin isolation.
      "cross-origin-opener-policy": "same-origin",
      "cross-origin-embedder-policy": "require-corp",
    });
    res.end(body);
  } catch { res.writeHead(404); res.end("not found"); }
});
const wss = new WebSocketServer({ server: http });
wss.on("connection", (ws) => {
  ws.on("message", async (data) => {
    const msg = JSON.parse(String(data));
    if (msg.kind === "offer") {
      const answerer = await Peer.create();
      const grpcServer = new Server();
      grpcServer.addService(createEchoService(handlers));
      ws.send(JSON.stringify({ kind: "answer", sdp: answerer.handleOffer(msg.sdp) }));
      const endpoint = await answerer.connect();
      endpoint.onchannel = (channel) => grpcServer.serve(channel);
      ws.on("close", () => answerer.close());
    }
  });
});
http.listen(PORT, () => console.log(`browser examples: open http://localhost:${PORT}/`));
// NOTE: Lua's native Wasm client blocks its worker on a
// SharedArrayBuffer mailbox while waiting for replies; under
// sustained load it can miss frames the JS runtime delivers
// during its startup window. It is listed in the index with
// that caveat until its startup race is fixed upstream.
BROWSER_SERVER_EOF
)

(define (write-starter)
  (define files
    (list (cons "examples/starter/server.mjs" starter-server-js)
          (cons "examples/starter/signal.mjs" starter-signal-mjs)
          (cons "examples/starter/client.html" starter-client-html)
          (cons "examples/starter/README.md" starter-readme)))
  (for ([f (in-list files)])
    (define path (build-path root (car f)))
    (make-directory* (path-only path))
    (call-with-output-file path #:exists 'replace
      (lambda (out) (display (cdr f) out)))
    (printf "generated ~a\n" (car f)))
  (define langs-json
    (string-append "["
                   (string-join
                    (for/list ([l (in-list browser-example-langs)])
                      (format "[~s, ~s, ~s]" (first l) (second l) (third l)))
                    ", ")
                   "]"))
  ;; All nine Wasm languages are listed. Lua's native client
  ;; runs the deep BDD scenario set (failure/metadata/cancel/
  ;; deadline), so the example servers must implement the
  ;; canonical Echo semantics — see the handlers above.
  (define browser-files
    (list (cons "examples/browser/index.html"
                (string-replace browser-examples-index "__LANGS__" langs-json))
          (cons "examples/browser/server.mjs" browser-examples-server)
          (cons "examples/browser/README.md" browser-examples-readme)))
  (for ([f (in-list browser-files)])
    (define path (build-path root (car f)))
    (make-directory* (path-only path))
    (call-with-output-file path #:exists 'replace
      (lambda (out) (display (cdr f) out)))
    (printf "generated ~a\n" (car f))))

;; Browser generators for the web app (see webgen.rkt): the same
;; stub generation the protoc plugins do, stamped as an ES module
;; the page runs client-side over protocompile's descriptor set.
(define (write-web-generators)
  (write-runtime-files "webapp/gen" "webgen.rkt" (list (emit-web-generators))))

;; ---------------------------------------------------------------------------
;; Corpus manifest for the web app's Browse mode: which example and
;; test files exist per language, discovered from the tree so the
;; browser index can never drift from the repository. The Makefile
;; copies exactly these paths into webapp/assets/corpus/.
;; ---------------------------------------------------------------------------

(define corpus-skip-dirs
  '("build" "bin" "obj" "__pycache__" "target" ".zig-cache"
    "node_modules" "dist" ".git" ".gradle" "out"))

(define corpus-skip-suffixes
  '(".pyc" ".class" ".jar" ".o" ".a" ".so" ".dll" ".exe" ".wasm"
    ".lock" ".jar" ".idx" ".pack"))

(define (corpus-file-ok? name)
  (and (not (string-prefix? name "."))
       (not (for/or ([s (in-list corpus-skip-suffixes)])
              (string-suffix? name s)))))

;; Sorted relative paths of source files under dir (recursive).
(define (corpus-list dir #:filter [keep #f])
  (define base (build-path root dir))
  (if (not (directory-exists? base))
      '()
      (let walk ([rel ""])
        (apply
         append
         (for/list ([entry (in-list (directory-list
                                     (if (equal? rel "") base (build-path base rel))))]
                    #:when (corpus-file-ok? (path->string entry)))
           (define name (path->string entry))
           (define child (if (equal? rel "") name (string-append rel "/" name)))
           (cond
             [(member name corpus-skip-dirs) '()]
             [(directory-exists? (build-path base child)) (walk child)]
             [(and keep (not (keep name))) '()]
             [else (list child)]))))))

(define (json-escape s)
  (string-join
   (for/list ([c (in-string s)])
     (case c
       [(#\") "\\\""]
       [(#\\) "\\\\"]
       [(#\newline) "\\n"]
       [(#\tab) "\\t"]
       [else (string c)]))
   ""))

(define (json-str-list xs)
  (string-append "["
                 (string-join (map (lambda (x) (format "\"~a\"" (json-escape x))) xs) ",")
                 "]"))

;; lang -> (examples-dir tests-dir tests-filter-name)
(define corpus-langs
  '(("js" "js/examples" "js/test" #f)
    ("python" "python/examples" "python/tests" #f)
    ("go" "go/examples" "go" go-tests)
    ("rust" "rust/examples" "rust/tests" #f)
    ("java" "java/examples" "java/tests" #f)
    ("csharp" "csharp/examples" "csharp/tests" #f)
    ("cpp" "cpp/examples" "cpp/tests" #f)
    ("swift" "swift/examples" "swift/tests" #f)
    ("kotlin" "kotlin/examples" "kotlin/tests" #f)
    ("dart" "dart/examples" "dart/tests" #f)
    ("zig" "zig/examples" "zig/tests" #f)
    ("c" "c/examples" "c/tests" #f)
    ("lua" "lua/examples" "lua/tests" #f)
    ("ruby" "ruby/examples" "ruby/tests" #f)
    ("php" "php/examples" "php/tests" #f)
    ("scala" "scala/examples" "scala/tests" #f)))

(define (write-corpus-manifest)
  (define (go-test-file? name)
    (string-suffix? name "_test.go"))
  (define testdata
    (sort (for/list ([e (in-list (directory-list (build-path root "webapp/testdata")))]
                     #:when (string-suffix? (path->string e) ".proto"))
            (path->string e))
          string<?))
  (define lang-json
    (for/list ([spec (in-list corpus-langs)])
      (define-values (lang ex-dir test-dir filter-name) (apply values spec))
      (define examples (corpus-list ex-dir))
      (define tests
        (corpus-list test-dir
                     #:filter (and (eq? filter-name 'go-tests) go-test-file?)))
      (format "    \"~a\": {\"examplesDir\": \"~a\", \"testsDir\": \"~a\", \"examples\": ~a, \"tests\": ~a}"
              lang ex-dir test-dir (json-str-list examples) (json-str-list tests))))
  (define text
    (string-append
     "{\n"
     "  \"generatedBy\": \"grpc-dc codegen (write-corpus-manifest)\",\n"
     "  \"schemas\": [\n"
     "    {\"id\": \"echo\", \"label\": \"Echo (proto/echo.proto)\", \"dir\": \"\", \"files\": [\"echo.proto\"]},\n"
     (format "    {\"id\": \"testdata\", \"label\": \"Testdata (webapp/testdata)\", \"dir\": \"testdata\", \"files\": ~a}\n"
             (json-str-list testdata))
     "  ],\n"
     "  \"languages\": {\n"
     (string-join lang-json ",\n")
     "\n  }\n}\n"))
  (call-with-output-file (build-path root "webapp/gen" "corpus-manifest.json")
    #:exists 'replace
    (lambda (out) (display text out)))
  (printf "generated webapp/gen/corpus-manifest.json\n"))

(module+ main
  (write-bdd-docs)
  (write-starter)
