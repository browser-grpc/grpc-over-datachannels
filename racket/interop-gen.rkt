#lang racket

;;; interop-gen.rkt — generated interop case tables.
;;;
;;; interop-spec.rkt is the single source; each emitter stamps it
;;; as a data literal in the target language. Runners (hand-written
;;; harness glue: process spawn, transport setup) interpret the
;;; table against the reference servers. Cases are data, never
;;; unrolled code, so every language grades the same cases.

(require "interop-spec.rkt")
(provide emit-java-interop-cases emit-csharp-interop-cases emit-kotlin-interop-cases emit-scala-interop-cases)

(define (int-list xs)
  (string-join (map number->string xs) ", "))

;; ---------------------------------------------------------------------------
;; Java table -> java/tests/InteropCases.java
;; Rows: name, kind, reqSizes, respSizes, statusCode, statusMessage.
;; ---------------------------------------------------------------------------

(define (java-case c)
  (match-define (list name kind req resp code msg) c)
  (format "        {~s, ~s, new int[]{~a}, new int[]{~a}, ~a, ~s},\n"
          (symbol->string name) (symbol->string kind)
          (int-list req) (int-list resp) code msg))

(define (emit-java-interop-cases)
  (cons "InteropCases.java"
        (string-append
         "// @generated by grpc-dc codegen. DO NOT EDIT.\n"
         "// SPDX-License-Identifier: Apache-2.0\n"
         "package tests;\n\n"
         "/** Interop case table generated by grpc-dc codegen (data only;\n"
         " * the runner is TestInteropOracle). Rows: name, kind, reqSizes,\n"
         " * respSizes, statusCode (-1 = OK), statusMessage. */\n"
         "public final class InteropCases {\n"
         "    private InteropCases() {}\n\n"
         "    public static final Object[][] CASES = {\n"
         (apply string-append (map java-case interop-case-table))
         "    };\n"
         "}\n")))

;; ---------------------------------------------------------------------------
;; C# table -> csharp/tests/InteropCases.cs
;; Rows: name, kind, reqSizes, respSizes, statusCode, statusMessage.
;; ---------------------------------------------------------------------------

(define (csharp-case c)
  (match-define (list name kind req resp code msg) c)
  (format "        new object[] { ~s, ~s, new int[] { ~a }, new int[] { ~a }, ~a, ~s },\n"
          (symbol->string name) (symbol->string kind)
          (int-list req) (int-list resp) code msg))

(define (emit-csharp-interop-cases)
  (cons "InteropCases.cs"
        (string-append
         "// @generated by grpc-dc codegen. DO NOT EDIT.\n"
         "// SPDX-License-Identifier: Apache-2.0\n"
         "namespace Tests;\n\n"
         "/// <summary>Interop case table generated by grpc-dc codegen (data only;\n"
         "/// the runner is TestInteropOracle). Rows: name, kind, reqSizes,\n"
         "/// respSizes, statusCode (-1 = OK), statusMessage.</summary>\n"
         "public static class InteropCases\n"
         "{\n"
         "    public static readonly object[][] Cases =\n"
         "    {\n"
         (apply string-append (map csharp-case interop-case-table))
         "    };\n"
         "}\n")))

;; ---------------------------------------------------------------------------
;; Kotlin table -> kotlin/tests/InteropCases.kt
;; Rows: name, kind, reqSizes, respSizes, statusCode, statusMessage.
;; ---------------------------------------------------------------------------

(define (kotlin-case c)
  (match-define (list name kind req resp code msg) c)
  (format "        arrayOf<Any>(~s, ~s, intArrayOf(~a), intArrayOf(~a), ~a, ~s),\n"
          (symbol->string name) (symbol->string kind)
          (int-list req) (int-list resp) code msg))

(define (emit-kotlin-interop-cases)
  (cons "InteropCases.kt"
        (string-append
         "// @generated by grpc-dc codegen. DO NOT EDIT.\n"
         "// SPDX-License-Identifier: Apache-2.0\n"
         "package tests\n\n"
         "/** Interop case table generated by grpc-dc codegen (data only;\n"
         " * the runner is TestInteropOracle). Rows: name, kind, reqSizes,\n"
         " * respSizes, statusCode (-1 = OK), statusMessage. */\n"
         "object InteropCases {\n"
         "    val CASES: Array<Array<Any>> = arrayOf(\n"
         (apply string-append (map kotlin-case interop-case-table))
         "    )\n"
         "}\n")))

;; ---------------------------------------------------------------------------
;; Scala table -> scala/tests/InteropCases.scala
;; Rows: name, kind, reqSizes, respSizes, statusCode, statusMessage.
;; ---------------------------------------------------------------------------

(define (scala-case c)
  (match-define (list name kind req resp code msg) c)
  (format "        Array[Any](~s, ~s, Array[Int](~a), Array[Int](~a), ~a, ~s),\n"
          (symbol->string name) (symbol->string kind)
          (int-list req) (int-list resp) code msg))

(define (emit-scala-interop-cases)
  (cons "InteropCases.scala"
        (string-append
         "// @generated by grpc-dc codegen. DO NOT EDIT.\n"
         "// SPDX-License-Identifier: Apache-2.0\n"
         "package tests\n\n"
         "/** Interop case table generated by grpc-dc codegen (data only;\n"
         " * the runner is TestInteropOracle). Rows: name, kind, reqSizes,\n"
         " * respSizes, statusCode (-1 = OK), statusMessage. */\n"
         "object InteropCases {\n"
         "    val CASES: Array[Array[Any]] = Array(\n"
         (apply string-append (map scala-case interop-case-table))
         "    )\n"
         "}\n")))
