#lang racket

;;; webrtc-gen.rkt — stamps webrtc-spec.rkt (protocol tables + computed
;;; crypto constants) into the Rust stack crate and the JS stack.
;;; Invoked from metagen.rkt so `make generate` regenerates everything
;;; from the two spec files in one pass.

(require "webrtc-spec.rkt" "sctp-dsl.rkt" racket/runtime-path)
(provide generate-webrtc)

(define-runtime-path here ".")
(define root (build-path here ".."))

(define (hex32 v) (format "0x~a" (~a (number->string v 16) #:width 8 #:align 'right #:pad-string "0")))
(define (name-rust sym) (string-replace (symbol->string sym) "-" "_"))
(define (screaming sym)
  (list->string
   (for/fold ([out '()] [prev-lower? #f] #:result (reverse out))
             ([c (in-string (symbol->string sym))])
     (cond [(char-upper-case? c)
            (values (cons c (if (and prev-lower? (not (null? out))) (cons #\_ out) out)) #f)]
           [else (values (cons (char-upcase c) out) #t)]))))

(define (hexw v w)
  (string-append "0x" (~a (number->string v 16) #:width w #:align 'right #:pad-string "0")))

(define (rust-table mod-name ty entries fmt-val)
  (string-append
   (format "pub mod ~a {\n" mod-name)
   (apply string-append
          (for/list ([e (in-list entries)])
            (format "    pub const ~a: ~a = ~a;\n"
                    (screaming (car e)) ty (fmt-val (cdr e)))))
   "}\n\n"))

(define (emit-rust)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n//! @generated by grpc-dc codegen. DO NOT EDIT.\n"
   "//! Crypto tables below were computed by the metaprogram (integer roots,\n"
   "//! GF(2^8) inversion, CRC polynomial expansion) and asserted by the generator's test suite.\n\n"
   (rust-table "stun_msg" "u16" stun-message-types (lambda (v) (hexw v 4)))
   (rust-table "stun_attr" "u16" stun-attributes (lambda (v) (hexw v 4)))
   (rust-table "sctp_chunk" "u8" sctp-chunk-types number->string)
   (rust-table "sctp_param" "u16" sctp-param-types number->string)
   (rust-table "sctp_reconfig" "u16" sctp-reconfig-params number->string)
   (rust-table "sctp_cause" "u16" sctp-error-causes number->string)
   (rust-table "dtls_content" "u8" dtls-content-types number->string)
   (rust-table "dtls_handshake" "u8" dtls-handshake-types number->string)
   (rust-table "dtls_ext" "u16" dtls-extension-types number->string)
   (rust-table "dtls_group" "u16" dtls-named-groups number->string)
   (rust-table "srtp_profile" "u16" srtp-profiles (lambda (v) (hexw v 4)))
   (format "pub const CIPHER_SUITE_ECDHE_ECDSA_AES128_GCM_SHA256: u16 = ~a;\n\n"
           (hexw cipher-suite-ecdhe-ecdsa-aes128-gcm-sha256 4))
   (format "pub const SHA256_H: [u32; 8] = [~a];\n\n"
           (string-join (map hex32 sha256-h) ", "))
   "pub const SHA256_K: [u32; 64] = [\n"
   (let loop ([ks sha256-k] [i 0] [acc ""])
     (cond [(null? ks) acc]
           [(= (modulo i 6) 5) (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ",\n"))]
           [else (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ", "))]))
   "];\n\n"
   (format "pub const SHA512_H: [u64; 8] = [~a];\n\n"
           (string-join (map (lambda (v) (hexw v 16)) sha512-h) ", "))
   (format "pub const SHA384_H: [u64; 8] = [~a];\n\n"
           (string-join (map (lambda (v) (hexw v 16)) sha384-h) ", "))
   "pub const SHA512_K: [u64; 80] = [\n"
   (let loop ([ks sha512-k] [i 0] [acc ""])
     (cond [(null? ks) acc]
           [(= (modulo i 3) 2) (loop (cdr ks) (add1 i) (string-append acc (hexw (car ks) 16) ",\n"))]
           [else (loop (cdr ks) (add1 i) (string-append acc (hexw (car ks) 16) ", "))]))
   "];\n\n"
   (format "pub const AES_SBOX: [u8; 256] = [~a];\n\n"
           (string-join (map (lambda (v) (hexw v 2)) aes-sbox) ", "))
   (format "pub const AES_INV_SBOX: [u8; 256] = [~a];\n\n"
           (string-join (map (lambda (v) (hexw v 2)) aes-inv-sbox) ", "))
   "pub const CRC32_TABLE: [u32; 256] = [\n"
   (let loop ([ks crc32-table] [i 0] [acc ""])
     (cond [(null? ks) acc]
           [(= (modulo i 4) 3) (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ",\n"))]
           [else (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ", "))]))
   "];\n\n"
   "pub const CRC32C_TABLE: [u32; 256] = [\n"
   (let loop ([ks crc32c-table] [i 0] [acc ""])
     (cond [(null? ks) acc]
           [(= (modulo i 4) 3) (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ",\n"))]
           [else (loop (cdr ks) (add1 i) (string-append acc (hex32 (car ks)) ", "))]))
   "];\n\n"
   (format "pub const MD5_K: [u32; 64] = [~a];\n\n"
           (string-join (map hex32 md5-k) ", "))
   (format "pub const MD5_S: [u32; 64] = [~a];\n"
           (string-join (map number->string md5-s) ", "))))

(define (js-obj name entries)
  (string-append
   (format "export const ~a = {\n" name)
   (apply string-append
          (for/list ([e (in-list entries)])
            (format "  ~a: ~a,\n" (screaming (car e)) (cdr e))))
   "};\n\n"))

(define (emit-js)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   (js-obj "StunMessageType" stun-message-types)
   (js-obj "StunAttribute" stun-attributes)
   (js-obj "SctpChunk" sctp-chunk-types)
   (js-obj "SctpParam" sctp-param-types)
   (js-obj "SctpReconfig" sctp-reconfig-params)
   (js-obj "SctpCause" sctp-error-causes)
   (js-obj "DtlsContentType" dtls-content-types)
   (js-obj "DtlsHandshakeType" dtls-handshake-types)
   (js-obj "DtlsExtension" dtls-extension-types)
   (js-obj "DtlsGroup" dtls-named-groups)
   (js-obj "SrtpProfile" srtp-profiles)
   (format "export const CIPHER_SUITE_ECDHE_ECDSA_AES128_GCM_SHA256 = ~a;\n\n" cipher-suite-ecdhe-ecdsa-aes128-gcm-sha256)
   (format "export const CRC32C_TABLE = [~a];\n\n"
           (string-join (map number->string crc32c-table) ", "))
   (format "export const CRC32_TABLE = [~a];\n"
           (string-join (map number->string crc32-table) ", "))))

(define (go-table prefix entries)
  (apply string-append
         (for/list ([e (in-list entries)])
           (format "const ~a~a = ~a\n" prefix (car e) (cdr e)))))

(define (emit-go)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n// @generated by grpc-dc codegen. DO NOT EDIT.\n\n"
   "package dcwebrtc\n\n"
   (go-table "StunType" stun-message-types)
   "\n"
   (go-table "StunAttr" stun-attributes)
   "\n"
   (go-table "SctpChunk" sctp-chunk-types)
   "\n"
   (go-table "SctpParam" sctp-param-types)
   "\n"
   (go-table "SctpReconfig" sctp-reconfig-params)
   "\n"
   (go-table "SctpCause" sctp-error-causes)
   "\n"
   (go-table "DtlsContent" dtls-content-types)
   "\n"
   (go-table "DtlsHandshake" dtls-handshake-types)
   "\n"
   (go-table "DtlsExt" dtls-extension-types)
   "\n"
   (go-table "DtlsNamedGroup" dtls-named-groups)
   "\n"
   (go-table "SrtpProfile" srtp-profiles)
   (format "\nconst CipherSuiteECDHEECDSAAES128GCMSHA256 = ~a\n\n" cipher-suite-ecdhe-ecdsa-aes128-gcm-sha256)
   (format "var Crc32cTable = [256]uint32{~a}\n\n"
           (string-join (map number->string crc32c-table) ", "))
   (format "var Crc32Table = [256]uint32{~a}\n"
           (string-join (map number->string crc32-table) ", "))))

(define (generate-webrtc)
  (call-with-output-file (build-path root "webrtc" "rust" "src" "proto_gen.rs") #:exists 'replace
    (lambda (out) (display (emit-rust) out)))
  (printf "generated webrtc/rust/src/proto_gen.rs\n")
  (call-with-output-file (build-path root "webrtc" "js" "proto_gen.js") #:exists 'replace
    (lambda (out) (display (emit-js) out)))
  (printf "generated webrtc/js/proto_gen.js\n")
  (define go-dir (build-path root "webrtc" "go"))
  (make-directory* go-dir)
  (call-with-output-file (build-path go-dir "proto_gen.go") #:exists 'replace
    (lambda (out) (display (emit-go) out)))
  (printf "generated webrtc/go/proto_gen.go\n")
  ;; SCTP reassembly, generated from the shared DSL
  ;; (sctp-dsl.rkt) so all three stacks run the same machine.
  (call-with-output-file (build-path go-dir "sctp_reassembly_gen.go") #:exists 'replace
    (lambda (out) (display (emit-go-sctp-reassembly) out)))
  (printf "generated webrtc/go/sctp_reassembly_gen.go\n")
  (call-with-output-file (build-path root "webrtc" "js" "sctp_reassembly_gen.js") #:exists 'replace
    (lambda (out) (display (emit-js-sctp-reassembly) out)))
  (printf "generated webrtc/js/sctp_reassembly_gen.js\n")
  (call-with-output-file (build-path root "webrtc" "rust" "src" "sctp_reassembly_gen.rs") #:exists 'replace
    (lambda (out) (display (emit-rust-sctp-reassembly) out)))
  (printf "generated webrtc/rust/src/sctp_reassembly_gen.rs\n"))
