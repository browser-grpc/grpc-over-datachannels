#lang racket/base
;; coverage-doc-gen.rkt — emit <lang>/TESTS.md for every language:
;; links to that language's generated tests and examples, plus the
;; shared matrix coverage (interop / WebRTC / browser / direct).
;; Run from the repo root via `make generate` (coverage-docs).
(require racket/file
         racket/list
         racket/path
         racket/string)
(require "spec.rkt")

(define languages
  '(("C" . "c") ("C++" . "cpp") ("C#" . "csharp") ("Dart" . "dart")
    ("Go" . "go") ("Java" . "java") ("JavaScript" . "js")
    ("Kotlin" . "kotlin") ("Lua" . "lua") ("PHP" . "php")
    ("Python" . "python") ("Ruby" . "ruby") ("Rust" . "rust")
    ("Scala" . "scala") ("Swift" . "swift") ("Zig" . "zig")))

(define make-targets
  '#hash(("c" . "test-c") ("cpp" . "test-cpp") ("csharp" . "test-csharp")
         ("dart" . "test-dart") ("go" . "test-go") ("java" . "test-java")
         ("js" . "test-js") ("kotlin" . "test-kotlin") ("lua" . "test-lua")
         ("php" . "test-php") ("python" . "test-python") ("ruby" . "test-ruby")
         ("rust" . "test-rust") ("scala" . "test-scala")
         ("swift" . "test-swift") ("zig" . "test-zig")))

(define source-exts
  '(".rs" ".js" ".mjs" ".go" ".py" ".java" ".cs" ".cpp" ".hpp" ".h"
    ".swift" ".kt" ".dart" ".zig" ".lua" ".rb" ".php" ".scala" ".c"
    ".md" ".yml" ".toml"))

(define skip-dirs
  '("target" "build" "obj" "bin" ".dart_tool" "node_modules" ".git"
    "__pycache__" ".build" "vendor" ".scala-build"))

(define (source-file? p)
  (define ext (path-get-extension p))
  (and ext (member (bytes->string/utf-8 ext) source-exts)))

(define (collect root)
  (define out '())
  (let walk ([dir root] [depth 0])
    (when (and (directory-exists? dir) (< depth 4))
      (for ([entry (in-list (directory-list dir #:build? #t))])
        (define name (path->string (file-name-from-path entry)))
        (cond
          [(and (directory-exists? entry)
                (not (member name skip-dirs)))
           (walk entry (add1 depth))]
          [(and (file-exists? entry) (source-file? entry))
           (set! out (cons entry out))]))))
  (sort out string<? #:key path->string))

(define (blurb name)
  (define n (string-downcase name))
  (cond
    [(string-contains? n "oracle") "Official-implementation oracle, via the proxy"]
    [(string-contains? n "interop") "Cross-language interop"]
    [(string-contains? n "matrix") "Matrix harness"]
    [(string-contains? n "bdd") "BDD scenario suite (generated)"]
    [(string-contains? n "trac") "Tracing: traceparent propagation, span observers, nested calls"]
    [(string-contains? n "deadline") "Deadline propagation and enforcement"]
    [(string-contains? n "codec") "Wire codec vectors"]
    [(string-contains? n "kafka") "Kafka end-to-end (broker legs env-gated)"]
    [(string-contains? n "eventbus") "Event bus end-to-end"]
    [(string-contains? n "events") "Event bus end-to-end"]
    [(string-contains? n "direct") "WebRTC-Direct example/test"]
    [(string-contains? n "sidecar") "Sidecar transport"]
    [(string-contains? n "http2") "HTTP/2 transport"]
    [(string-contains? n "webrtc") "WebRTC transport"]
    [(string-contains? n "echo") "Echo: all four call shapes"]
    [(string-contains? n "loopback") "Loopback transport"]
    [(string-contains? n "memory") "In-memory transport"]
    [(string-contains? n "readme") "Guide"]
    [else "Generated suite/example"]))

(define (link-line lang-dir p)
  (define rel (find-relative-path lang-dir p))
  (define name (path->string (file-name-from-path p)))
  (format "- [`~a`](~a) — ~a" name (path->string rel) (blurb name)))

(define (emit lang dir)
  (define lang-dir (build-path dir))
  (define test-files
    (append (collect (build-path lang-dir "tests"))
            (collect (build-path lang-dir "test"))
            (if (equal? dir "go")
                (filter (lambda (p)
                          (string-suffix? (path->string p) "_test.go"))
                        (collect lang-dir))
                '())))
  (define example-files (collect (build-path lang-dir "examples")))
  (define target (hash-ref make-targets dir))
  (define lines
    (append
     (list (format "# Tests and examples — ~a" lang)
           ""
           "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->"
           ""
           (format "Run this language's suite with `make ~a` (in the CI image). "
                   target)
           "Generated tests exercise the wire codec, all four call "
           "shapes, deadlines, and the descriptor-driven dynamic "
           "surface for this runtime."
           ""
           "Tracing (W3C traceparent, span observers, nested-call "
           "propagation) is documented in [`TRACING.md`](TRACING.md)."
           ""
           "## Tests"
           "")
     (if (null? test-files)
         '("- _No test directory found._")
         (map (lambda (p) (link-line lang-dir p)) test-files))
     (list "" "## Examples" "")
     (if (null? example-files)
         '("- _No examples directory found._")
         (map (lambda (p) (link-line lang-dir p)) example-files))
     (list ""
           "## Shared matrix coverage"
           ""
           "Beyond this language's own suites, the same generated "
           "Echo stubs are exercised across languages:"
           ""
           "- [`interop-matrix.mjs`](../js/test/interop-matrix.mjs) — every language's client against every language's server (15×15 stdio pairs)"
           "- [`webrtc_matrix.test.mjs`](../browser-test/webrtc_matrix.test.mjs) — Go/JS/Rust WebRTC stacks over real ICE/DTLS"
           "- [`browser-test/`](../browser-test/) — browser client/server cells in Chromium and Firefox"
           "- [`examples/direct/`](../examples/direct/) — WebRTC-Direct, TURN, and sidecar examples"
           "- Official grpc-java oracle suites (per language, through the TCP↔DataChannel proxy)"
           "")))
  (call-with-output-file (build-path lang-dir "TESTS.md")
    #:exists 'replace
    (lambda (out) (display (string-join lines "\n") out))))

;; ---- TRACING.md ------------------------------------------------------
;; Per-language tracing guide: how to register an observer, start a
;; root trace from a client, and join the trace when a callee makes
;; outbound calls. API names below mirror each generated runtime.
(define tracing-apis
  '#hash(("python" . ("grpcdc.set_tracer(tracer)" "ctx.trace_context" "Channel.with_trace_context(ctx), or the ambient grpcdc.current_trace_context() (set automatically while a handler runs)" "grpcdc.new_trace_context(kind, method)"))
         ("js" . ("setTracer(tracer)" "ctx.traceContext" "Channel.withTraceContext(ctx.traceContext)" "newTraceContext(kind, method)"))
         ("go" . ("grpcdc.SetTracer(tracer)" "grpcdc.TraceContextFromContext(ctx)" "thread the handler's context.Context into outbound stub calls (automatic)" "grpcdc.NewTraceContext(kind, method)"))
         ("rust" . ("grpc_dc::status::set_tracer(Some(tracer))" "CallCtx.trace_context" "CallOptions::default().trace_parent(ctx)" "grpc_dc::status::new_trace_context(kind, method)"))
         ("java" . ("Tracing.setTracer(tracer)" "ctx.traceContext" "Channel.withTraceContext(ctx)" "Tracing.newTraceContext(kind, method)"))
         ("kotlin" . ("Tracing.setTracer(tracer)" "ctx.traceContext" "Channel.withTraceContext(ctx)" "Tracing.newTraceContext(kind, method)"))
         ("scala" . ("Tracing.setTracer(tracer)" "ctx.traceContext" "Channel.withTraceContext(ctx)" "Tracing.newTraceContext(kind, method)"))
         ("csharp" . ("Tracing.SetTracer(tracer)" "ctx.TraceContext" "Channel.WithTraceContext(ctx)" "Tracing.NewTraceContext(kind, method)"))
         ("cpp" . ("Tracing::SetTracer(tracer)" "ctx.trace_context" "Channel::WithTraceContext(ctx)" "Tracing::NewTraceContext(kind, method)"))
         ("swift" . ("Tracing.SetTracer(tracer)" "ctx.traceContext" "Channel.WithTraceContext(ctx)" "Tracing.NewTraceContext(kind, method)"))
         ("dart" . ("setTracer(tracer)" "ctx.traceContext" "Channel.withTraceContext(ctx)" "newTraceContext(kind, method)"))
         ("zig" . ("status.setTracer(tracer)" "CallContext.trace_context" "Channel.setTraceContext(ctx)" "status.newTraceContext(kind, method)"))
         ("c" . ("grpcdc_set_tracer(&tracer)" "grpcdc_current_trace_context()" "automatic on the handler thread, or grpcdc_channel_set_trace_parent(channel, &ctx)" "grpcdc_new_trace_context(kind, method)"))
         ("lua" . ("statusModule.setTracer(tracer)" "ctx.traceContext" "Channel:setTraceContext(ctx)" "statusModule.newTraceContext(kind, method)"))
         ("ruby" . ("Grpcdc.set_tracer(tracer)" "ctx.trace_context" "Channel#with_trace_context(ctx)" "Grpcdc.new_trace_context(kind, method)"))
         ("php" . ("Status::setTracer(tracer)" "$ctx->traceContext" "Channel::withTraceContext(ctx)" "Status::newTraceContext(kind, method)"))))

(define (emit-tracing lang dir)
  (define lang-dir (build-path dir))
  (define api (hash-ref tracing-apis dir))
  (define test-files
    (filter (lambda (p)
              (string-contains? (string-downcase (path->string p)) "trac"))
            (append (collect (build-path lang-dir "tests"))
                    (collect (build-path lang-dir "test"))
                    (if (equal? dir "go")
                        (filter (lambda (p)
                                  (string-suffix? (path->string p) "_test.go"))
                                (collect lang-dir))
                        '()))))
  (define lines
    (list (format "# Tracing — ~a~a" lang (tracing-beta-suffix))
          ""
          "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->"
          ""
          "Dependency-free W3C Trace Context propagation for this "
          "runtime. The wire contract is in [`../SPEC.md`](../SPEC.md) "
          "(Tracing); this page covers the language-level API. A "
          "runnable multi-service example (client -> callee -> "
          "downstream) is in [`../examples/tracing/`](../examples/tracing/)."
          ""
          "## Enabling"
          ""
          (format "Register an observer with `~a`. The observer receives " (first api))
          "`onStart`/`onEnd` callbacks with kind (`client`/`server`), "
          "method, trace/span ids, terminal status, and span duration "
          "in milliseconds. With no observer registered, tracing is "
          "dormant: no `traceparent` header is written and no ids are "
          "minted."
          ""
          "The protoc option `trace=off|hooks` only controls stub "
          "convenience: `hooks` re-exports the registrar from generated "
          "stubs and may bake a `trace_methods` filter. The runtime "
          "capability itself is always present and dormant. Sampling "
          "and export (OTLP or otherwise) are the application's "
          "problem — see the `tracing_demo` and `otlp_tracer` examples."
          ""
          "## Starting a trace (client-initiated)"
          ""
          "A client call with no parent starts a root span "
          "automatically. To group several calls (and local work) "
          (format "under one workflow span, create a root with `~a`, " (fourth api))
          "bind it as the parent of your calls, and end it when the "
          "workflow completes."
          ""
          "## Joining a trace (callee making outbound calls)"
          ""
          (format "While a handler runs, its server span context is available as `~a`. " (second api))
          (format "Parent outbound calls with `~a`; the runtime then " (third api))
          "writes the outbound `traceparent` for you — child client "
          "span, downstream server span, one shared trace id. Explicit "
          "`traceparent` call metadata always wins over the bound or "
          "ambient context."
          ""
          "## Sampled flags"
          ""
          "An upstream `traceparent` ending in `-00` is honored: the "
          "context still propagates downstream, but no spans are "
          "recorded. `-01` (and locally started spans) record "
          "normally. `tracestate` and `baggage` ride as ordinary "
          "metadata."
          ""
          "## Tests"
          ""
          (format "Run with `make ~a` (in the CI image). Tracing coverage:" (hash-ref make-targets dir))
          ""
          (if (null? test-files)
              "- See [`TESTS.md`](TESTS.md) for the full suite index."
              (string-join
               (map (lambda (p) (link-line lang-dir p)) test-files)
               "\n"))
          ""))
  (call-with-output-file (build-path lang-dir "TRACING.md")
    #:exists 'replace
    (lambda (out) (display (string-join lines "\n") out))))

(for ([l (in-list languages)])
  (when (directory-exists? (cdr l))
    (emit (car l) (cdr l))
    (printf "coverage-docs: wrote ~a/TESTS.md\n" (cdr l))
    (emit-tracing (car l) (cdr l))
    (printf "coverage-docs: wrote ~a/TRACING.md\n" (cdr l))))

;; Extra trees: wasm/ (browser runtimes) and webrtc/ (the three
;; hand-rolled stacks) get the same index treatment.
(define (emit-extra title dir run-note test-files example-files)
  (define lang-dir (build-path dir))
  (define lines
    (append
     (list (format "# Tests and examples — ~a" title)
           ""
           "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->"
           ""
           run-note
           ""
           "## Tests and sources"
           "")
     (if (null? test-files)
         '("- _No files found._")
         (map (lambda (p) (link-line lang-dir p)) test-files))
     (list "" "## Examples and harnesses" "")
     (if (null? example-files)
         '("- _No examples found._")
         (map (lambda (p) (link-line lang-dir p)) example-files))
     (list ""
           "## Shared matrix coverage"
           ""
           "- [`interop-matrix.mjs`](../js/test/interop-matrix.mjs) — every language's client against every language's server (15×15 stdio pairs)"
           "- [`webrtc_matrix.test.mjs`](../browser-test/webrtc_matrix.test.mjs) — Go/JS/Rust WebRTC stacks over real ICE/DTLS"
           "- [`browser-test/`](../browser-test/) — browser client/server cells in Chromium and Firefox"
           "")))
  (call-with-output-file (build-path lang-dir "TESTS.md")
    #:exists 'replace
    (lambda (out) (display (string-join lines "\n") out))))

(when (directory-exists? "wasm")
  (define files (collect (build-path "wasm")))
  (emit-extra "Wasm browser runtimes" "wasm"
              "Browser legs run via the `test-wasm*` and `test-*-wasm-browser` make targets (Chromium and Firefox, in the CI image)."
              (filter (lambda (p) (not (string-contains? (path->string p) "examples"))) files)
              (filter (lambda (p) (string-contains? (path->string p) "examples")) files))
  (printf "coverage-docs: wrote wasm/TESTS.md\n"))

(when (directory-exists? "webrtc")
  (define files (collect (build-path "webrtc")))
  (emit-extra "WebRTC stacks (Go, JS, Rust)" "webrtc"
              "Stack suites run via `make test-webrtc-go`, `make test-webrtc-js`, `make test-webrtc-rust`, and `make test-webrtc-matrix`."
              (filter (lambda (p) (string-contains? (string-downcase (path->string p)) "test")) files)
              (filter (lambda (p) (string-contains? (path->string p) "cmd")) files))
  (printf "coverage-docs: wrote webrtc/TESTS.md\n"))
