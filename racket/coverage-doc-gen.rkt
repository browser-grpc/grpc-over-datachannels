#lang racket/base
;; coverage-doc-gen.rkt — emit <lang>/TESTS.md for every language:
;; links to that language's generated tests and examples, plus the
;; shared matrix coverage (interop / WebRTC / browser / direct).
;; Run from the repo root via `make generate` (coverage-docs).
(require racket/file
         racket/list
         racket/path
         racket/string)

(define languages
  '(("C" . "c") ("C++" . "cpp") ("C#" . "csharp") ("Dart" . "dart")
    ("Go" . "go") ("Java" . "java") ("JavaScript" . "js")
    ("Kotlin" . "kotlin") ("Lua" . "lua") ("PHP" . "php")
    ("Python" . "python") ("Ruby" . "ruby") ("Rust" . "rust")
    ("Scala" . "scala") ("Swift" . "swift") ("Zig" . "zig")))

(define make-targets
  '#hash(("c" . "test-c") ("cpp" . "test-cpp") ("csharp" . "test-csharp")
         ("dart" . "test-dart") ("go" . "test-go") ("java" . "test-java")
         ("js" . "test-js") ("kotlin" . "test-kotlin") ("lua" . "test-lua")
         ("php" . "test-php") ("python" . "test-python") ("ruby" . "test-ruby")
         ("rust" . "test-rust") ("scala" . "test-scala")
         ("swift" . "test-swift") ("zig" . "test-zig")))

(define source-exts
  '(".rs" ".js" ".mjs" ".go" ".py" ".java" ".cs" ".cpp" ".hpp" ".h"
    ".swift" ".kt" ".dart" ".zig" ".lua" ".rb" ".php" ".scala" ".c"
    ".md" ".yml" ".toml"))

(define skip-dirs
  '("target" "build" "obj" "bin" ".dart_tool" "node_modules" ".git"
    "__pycache__" ".build" "vendor" ".scala-build"))

(define (source-file? p)
  (define ext (path-get-extension p))
  (and ext (member (bytes->string/utf-8 ext) source-exts)))

(define (collect root)
  (define out '())
  (let walk ([dir root] [depth 0])
    (when (and (directory-exists? dir) (< depth 4))
      (for ([entry (in-list (directory-list dir #:build? #t))])
        (define name (path->string (file-name-from-path entry)))
        (cond
          [(and (directory-exists? entry)
                (not (member name skip-dirs)))
           (walk entry (add1 depth))]
          [(and (file-exists? entry) (source-file? entry))
           (set! out (cons entry out))]))))
  (sort out string<? #:key path->string))

(define (blurb name)
  (define n (string-downcase name))
  (cond
    [(string-contains? n "oracle") "Official-implementation oracle, via the proxy"]
    [(string-contains? n "interop") "Cross-language interop"]
    [(string-contains? n "matrix") "Matrix harness"]
    [(string-contains? n "bdd") "BDD scenario suite (generated)"]
    [(string-contains? n "deadline") "Deadline propagation and enforcement"]
    [(string-contains? n "codec") "Wire codec vectors"]
    [(string-contains? n "kafka") "Kafka end-to-end (broker legs env-gated)"]
    [(string-contains? n "eventbus") "Event bus end-to-end"]
    [(string-contains? n "events") "Event bus end-to-end"]
    [(string-contains? n "direct") "WebRTC-Direct example/test"]
    [(string-contains? n "sidecar") "Sidecar transport"]
    [(string-contains? n "http2") "HTTP/2 transport"]
    [(string-contains? n "webrtc") "WebRTC transport"]
    [(string-contains? n "echo") "Echo: all four call shapes"]
    [(string-contains? n "loopback") "Loopback transport"]
    [(string-contains? n "memory") "In-memory transport"]
    [(string-contains? n "readme") "Guide"]
    [else "Generated suite/example"]))

(define (link-line lang-dir p)
  (define rel (find-relative-path lang-dir p))
  (define name (path->string (file-name-from-path p)))
  (format "- [`~a`](~a) — ~a" name (path->string rel) (blurb name)))

(define (emit lang dir)
  (define lang-dir (build-path dir))
  (define test-files
    (append (collect (build-path lang-dir "tests"))
            (collect (build-path lang-dir "test"))
            (if (equal? dir "go")
                (filter (lambda (p)
                          (string-suffix? (path->string p) "_test.go"))
                        (collect lang-dir))
                '())))
  (define example-files (collect (build-path lang-dir "examples")))
  (define target (hash-ref make-targets dir))
  (define lines
    (append
     (list (format "# Tests and examples — ~a" lang)
           ""
           "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->"
           ""
           (format "Run this language's suite with `make ~a` (in the CI image). "
                   target)
           "Generated tests exercise the wire codec, all four call "
           "shapes, deadlines, and the descriptor-driven dynamic "
           "surface for this runtime."
           ""
           "## Tests"
           "")
     (if (null? test-files)
         '("- _No test directory found._")
         (map (lambda (p) (link-line lang-dir p)) test-files))
     (list "" "## Examples" "")
     (if (null? example-files)
         '("- _No examples directory found._")
         (map (lambda (p) (link-line lang-dir p)) example-files))
     (list ""
           "## Shared matrix coverage"
           ""
           "Beyond this language's own suites, the same generated "
           "Echo stubs are exercised across languages:"
           ""
           "- [`interop-matrix.mjs`](../js/test/interop-matrix.mjs) — every language's client against every language's server (15×15 stdio pairs)"
           "- [`webrtc_matrix.test.mjs`](../browser-test/webrtc_matrix.test.mjs) — Go/JS/Rust WebRTC stacks over real ICE/DTLS"
           "- [`browser-test/`](../browser-test/) — browser client/server cells in Chromium and Firefox"
           "- [`examples/direct/`](../examples/direct/) — WebRTC-Direct, TURN, and sidecar examples"
           "- Official grpc-java oracle suites (per language, through the TCP↔DataChannel proxy)"
           "")))
  (call-with-output-file (build-path lang-dir "TESTS.md")
    #:exists 'replace
    (lambda (out) (display (string-join lines "\n") out))))

(for ([l (in-list languages)])
  (when (directory-exists? (cdr l))
    (emit (car l) (cdr l))
    (printf "coverage-docs: wrote ~a/TESTS.md\n" (cdr l))))

;; Extra trees: wasm/ (browser runtimes) and webrtc/ (the three
;; hand-rolled stacks) get the same index treatment.
(define (emit-extra title dir run-note test-files example-files)
  (define lang-dir (build-path dir))
  (define lines
    (append
     (list (format "# Tests and examples — ~a" title)
           ""
           "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->"
           ""
           run-note
           ""
           "## Tests and sources"
           "")
     (if (null? test-files)
         '("- _No files found._")
         (map (lambda (p) (link-line lang-dir p)) test-files))
     (list "" "## Examples and harnesses" "")
     (if (null? example-files)
         '("- _No examples found._")
         (map (lambda (p) (link-line lang-dir p)) example-files))
     (list ""
           "## Shared matrix coverage"
           ""
           "- [`interop-matrix.mjs`](../js/test/interop-matrix.mjs) — every language's client against every language's server (15×15 stdio pairs)"
           "- [`webrtc_matrix.test.mjs`](../browser-test/webrtc_matrix.test.mjs) — Go/JS/Rust WebRTC stacks over real ICE/DTLS"
           "- [`browser-test/`](../browser-test/) — browser client/server cells in Chromium and Firefox"
           "")))
  (call-with-output-file (build-path lang-dir "TESTS.md")
    #:exists 'replace
    (lambda (out) (display (string-join lines "\n") out))))

(when (directory-exists? "wasm")
  (define files (collect (build-path "wasm")))
  (emit-extra "Wasm browser runtimes" "wasm"
              "Browser legs run via the `test-wasm*` and `test-*-wasm-browser` make targets (Chromium and Firefox, in the CI image)."
              (filter (lambda (p) (not (string-contains? (path->string p) "examples"))) files)
              (filter (lambda (p) (string-contains? (path->string p) "examples")) files))
  (printf "coverage-docs: wrote wasm/TESTS.md\n"))

(when (directory-exists? "webrtc")
  (define files (collect (build-path "webrtc")))
  (emit-extra "WebRTC stacks (Go, JS, Rust)" "webrtc"
              "Stack suites run via `make test-webrtc-go`, `make test-webrtc-js`, `make test-webrtc-rust`, and `make test-webrtc-matrix`."
              (filter (lambda (p) (string-contains? (string-downcase (path->string p)) "test")) files)
              (filter (lambda (p) (string-contains? (path->string p) "cmd")) files))
  (printf "coverage-docs: wrote webrtc/TESTS.md\n"))
