   "    }\n\n"
   "    private void EmitTrailersFrame(uint streamId, long code, string message, Dictionary<string, string> metadata)\n"
   "    {\n"
   "        var sb = new StringBuilder();\n"
   "        sb.Append(\"{\\\"code\\\":\").Append(code).Append(\",\\\"message\\\":\").Append(JsonSerializer.Serialize(message));\n"
   "        if (metadata != null && metadata.Count > 0)\n"
   "        {\n"
   "            sb.Append(\",\\\"metadata\\\":{\");\n"
   "            bool first = true;\n"
   "            foreach (KeyValuePair<string, string> e in metadata)\n"
   "            {\n"
   "                if (!first)\n"
   "                {\n"
   "                    sb.Append(',');\n"
   "                }\n"
   "                first = false;\n"
   "                sb.Append(JsonSerializer.Serialize(e.Key)).Append(':').Append(JsonSerializer.Serialize(e.Value));\n"
   "            }\n"
   "            sb.Append('}');\n"
   "        }\n"
