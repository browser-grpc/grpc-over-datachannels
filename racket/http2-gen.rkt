   "            break\n"
   "        }\n"
   "        return true\n"
   "    }\n"
   "\n"
   "    private func WindowUpdate(_ increment: Int) -> [UInt8] {\n"
   "        return [UInt8((increment >> 24) & 0x7f), UInt8((increment >> 16) & 0xff),\n"
   "                UInt8((increment >> 8) & 0xff), UInt8(increment & 0xff)]\n"
   "    }\n"
   "\n"
   "    private func OnHeaders(_ streamId: UInt32, _ endStream: Bool, _ block: [UInt8]) {\n"
   "        guard let headers = try? decoder.Decode(block) else {\n"
   "            return\n"
   "        }\n"
   "        var metadata: [String: String] = [:]\n"
   "        var status: String? = nil\n"
   "        var message: String? = nil\n"
   "        for (name, value) in headers {\n"
   "            if name == \"grpc-status\" {\n"
   "                status = value\n"
   "            } else if name == \"grpc-message\" {\n"
   "                message = value\n"
   "            } else if name == \"grpc-encoding\" {\n"
   "                if value == \"gzip\" {\n"
   "                    decompressIn.insert(streamId)\n"
   "                }\n"
   "            } else if name.hasPrefix(\":\") || name == \"content-type\" || name == \"grpc-accept-encoding\" {\n"
   "                // transport-owned: not metadata\n"
   "            } else if metadata[name] == nil {\n"
   "                metadata[name] = value\n"
   "            }\n"
   "        }\n"
   "        let first = !headersSeen.contains(streamId)\n"
   "        headersSeen.insert(streamId)\n"
   "        if endStream && status != nil {\n"
   "            EmitTrailersFrame(streamId, Int(status!) ?? 2,\n"
   "                              Http2Transport.PercentDecode(message ?? \"\"), metadata)\n"
   "        } else if first {\n"
   "            EmitHeadersFrame(streamId, metadata)\n"
   "            if endStream {\n"
   "                EmitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata)\n"
   "            }\n"
   "        } else if endStream {\n"
   "            EmitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata)\n"
   "        }\n"
   "    }\n"
   "\n"
   "    private func DrainMessages(_ streamId: UInt32) {\n"
   "        guard var data = dataBuffers[streamId] else {\n"
   "            return\n"
   "        }\n"
   "        var off = 0\n"
   "        while data.count - off >= 5 {\n"
   "            let mlen = (Int(data[off + 1]) << 24) | (Int(data[off + 2]) << 16)\n"
   "                | (Int(data[off + 3]) << 8) | Int(data[off + 4])\n"
   "            if data.count - off - 5 < mlen {\n"
   "                break\n"
   "            }\n"
   "            let compressed = Int(data[off]) & 0xff\n"
   "            var message = Array(data[(off + 5)..<(off + 5 + mlen)])\n"
   "            off += 5 + mlen\n"
   "            if compressed == 1 || decompressIn.contains(streamId) {\n"
   "                guard let plain = try? Http2Transport.Gunzip(message) else {\n"
   "                    dataBuffers[streamId] = Array(data[off...])\n"
   "                    return\n"
   "                }\n"
   "                message = plain\n"
   "            }\n"
   "            Emit(Wire.FrameData, streamId, message)\n"
   "        }\n"
   "        data.removeFirst(off)\n"
   "        dataBuffers[streamId] = data\n"
   "    }\n"
   "\n"
   "    static func PercentDecode(_ value: String) -> String {\n"
   "        var bytes: [UInt8] = []\n"
   "        let units = [UInt8](value.utf8)\n"
   "        var i = 0\n"
   "        while i < units.count {\n"
   "            let c = units[i]\n"
   "            if c == 0x25 && i + 2 < units.count {\n"
   "                let hi = HexDigit(units[i + 1])\n"
   "                let lo = HexDigit(units[i + 2])\n"
   "                if hi >= 0 && lo >= 0 {\n"
   "                    bytes.append(UInt8((hi << 4) | lo))\n"
   "                    i += 3\n"
   "                    continue\n"
   "                }\n"
   "            }\n"
   "            bytes.append(c)\n"
   "            i += 1\n"
   "        }\n"
   "        return String(decoding: bytes, as: UTF8.self)\n"
   "    }\n"
   "\n"
   "    private static func HexDigit(_ c: UInt8) -> Int {\n"
   "        switch c {\n"
   "        case 48...57: return Int(c) - 48\n"
   "        case 97...102: return Int(c) - 97 + 10\n"
   "        case 65...70: return Int(c) - 65 + 10\n"
   "        default: return -1\n"
   "        }\n"
   "    }\n"
   "\n"
   "    func Send(_ message: [UInt8]) throws {\n"
   "        if message.count < 9 {\n"
   "            throw StatusException(Wire.CodeInvalidArgument, \"short frame\")\n"
   "        }\n"
   "        let frame = try Codec.DecodeFrame(message)\n"
   "        let streamId = frame.streamId\n"
   "        let payload = frame.payload\n"
   "        switch frame.type {\n"
   "        case Wire.FrameHeaders:\n"
   "            let headers = try Codec.ParseHeaders(payload)\n"
   "            let metadata = headers.metadata\n"
   "            cond.lock()\n"
   "            if streamWindows[streamId] == nil {\n"
   "                streamWindows[streamId] = peerInitialWindow\n"
   "            }\n"
   "            cond.unlock()\n"
   "            if metadata[\"grpc-encoding\"] == \"gzip\" {\n"
   "                compressOut.insert(streamId)\n"
   "            }\n"
   "            var block: [UInt8] = []\n"
   "            block.append(0x83) // :method: POST\n"
   "            block.append(scheme == \"https\" ? 0x87 : 0x86) // :scheme\n"
   "            Http2Transport.WriteLiteralIndexedName(&block, 4, headers.path ?? \"\") // :path\n"
   "            Http2Transport.WriteLiteralIndexedName(&block, 1, authority) // :authority\n"
   "            Http2Transport.WriteLiteralIndexedName(&block, 31, \"application/grpc\")\n"
   "            Http2Transport.WriteLiteralNewName(&block, \"grpc-accept-encoding\", \"gzip,identity\")\n"
   "            Http2Transport.WriteLiteralNewName(&block, \"te\", \"trailers\")\n"
   "            for (key, value) in metadata {\n"
   "                let k = key.lowercased()\n"
   "                if k == \"grpc-encoding\" {\n"
   "                    Http2Transport.WriteLiteralNewName(&block, k, \"gzip\")\n"
   "                } else {\n"
   "                    Http2Transport.WriteLiteralNewName(&block, k, value)\n"
   "                }\n"
   "            }\n"
   "            WriteFrame(Http2Transport.H2Headers, Http2Transport.FlagEndHeaders, streamId, block)\n"
   "        case Wire.FrameData:\n"
   "            let compressed = compressOut.contains(streamId)\n"
   "            let body = compressed ? Http2Transport.Gzip(payload) : payload\n"
   "            var wire = [UInt8](repeating: 0, count: 5 + body.count)\n"
   "            wire[0] = compressed ? 1 : 0\n"
   "            wire[1] = UInt8((body.count >> 24) & 0xff)\n"
   "            wire[2] = UInt8((body.count >> 16) & 0xff)\n"
   "            wire[3] = UInt8((body.count >> 8) & 0xff)\n"
   "            wire[4] = UInt8(body.count & 0xff)\n"
   "            wire.replaceSubrange(5..<wire.count, with: body)\n"
   "            var sent = 0\n"
   "            while sent < wire.count {\n"
   "                var allowance = 0\n"
   "                cond.lock()\n"
   "                while !closedFlag && (connWindow <= 0 || (streamWindows[streamId] ?? peerInitialWindow) <= 0) {\n"
   "                    cond.wait()\n"
   "                }\n"
   "                if closedFlag {\n"
   "                    cond.unlock()\n"
   "                    throw StatusException(Wire.CodeUnavailable, \"transport closed\")\n"
   "                }\n"
   "                let sw = streamWindows[streamId] ?? peerInitialWindow\n"
   "                allowance = min(min(connWindow, sw),\n"
   "                                min(Http2Transport.MaxFramePayload, wire.count - sent))\n"
   "                connWindow -= allowance\n"
   "                streamWindows[streamId] = sw - allowance\n"
   "                cond.unlock()\n"
   "                WriteFrame(Http2Transport.H2Data, 0, streamId,\n"
   "                           Array(wire[sent..<(sent + allowance)]))\n"
   "                sent += allowance\n"
   "            }\n"
   "        case Wire.FrameHalfClose:\n"
   "            WriteFrame(Http2Transport.H2Data, Http2Transport.FlagEndStream, streamId, [])\n"
   "        case Wire.FrameRst:\n"
   "            WriteFrame(Http2Transport.H2RstStream, 0, streamId, [0, 0, 0, 8])\n"
   "        default:\n"
   "            // Trailers never travel client -> server here.\n"
   "            break\n"
   "        }\n"
   "    }\n"
   "\n"
   "    func Recv() throws -> [UInt8] {\n"
   "        guard let msg = queue.Take() else {\n"
   "            throw EndOfStreamError()\n"
   "        }\n"
   "        return msg\n"
   "    }\n"
   "\n"
   "    func Close() {\n"
   "        MarkClosed()\n"
   "        _ = Glibc.shutdown(fd, Int32(SHUT_RDWR))\n"
   "        Glibc.close(fd)\n"
   "    }\n"
   "}\n"
   ))

(define (emit-swift-http2)
  (cons "Http2Transport.swift"
        (string-replace
         (string-replace
          (string-replace swift-http2-body
                          "SWIFT_STATIC_TABLE" (swift-static-table))
          "SWIFT_HUFF_CODES" (swift-huff-codes))
         "SWIFT_HUFF_LENS" (swift-huff-lens))))

;; ---------------------------------------------------------------------------
;; Zig emitter -> zig/grpcdc/http2_transport.zig
;; ---------------------------------------------------------------------------

(define (zig-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format ".{ ~s, ~s }," (car e) (cdr e)))
   "\n        "))

(define (zig-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (zig-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define zig-http2-body
  (string-append
   "const std = @import(\"std\");\n"
   "const wire = @import(\"wire.zig\");\n"
   "const status_mod = @import(\"status.zig\");\n"
   "const codec_mod = @import(\"codec.zig\");\n"
   "const transport_mod = @import(\"transport.zig\");\n"
   "\n"
   "const Status = status_mod.Status;\n"
   "const Codec = codec_mod.Codec;\n"
   "\n"
   "/// Cleartext HTTP/2 frame transport (RFC 9113, generated from\n"
   "/// http2-spec.rkt) over a TCP socket: a generated client can\n"
   "/// dial a stock gRPC server directly (grpc-java server,\n"
   "/// grpc-go server), no bridge process. Client endpoints only.\n"
   "/// TLS is not offered: Zig's stdlib TLS client cannot verify\n"
   "/// or negotiate ALPN h2 here, so dialTls returns\n"
   "/// error.TlsUnsupported rather than silently dialing\n"
   "/// cleartext.\n"
   "pub const Http2Transport = struct {\n"
   "    pub const h2_data: u8 = 0x0;\n"
   "    pub const h2_headers: u8 = 0x1;\n"
   "    pub const h2_rst_stream: u8 = 0x3;\n"
   "    pub const h2_settings: u8 = 0x4;\n"
   "    pub const h2_ping: u8 = 0x6;\n"
   "    pub const h2_window_update: u8 = 0x8;\n"
   "    pub const h2_continuation: u8 = 0x9;\n"
   "    pub const flag_end_stream: u8 = 0x1;\n"
   "    pub const flag_end_headers: u8 = 0x4;\n"
   "    pub const flag_ack: u8 = 0x1;\n"
   "    pub const flag_padded: u8 = 0x8;\n"
   "    pub const max_frame_payload: usize = 16384;\n"
   "\n"
   "    pub const static_table = [_][2][]const u8{\n"
   "        ZIG_STATIC_TABLE\n"
   "    };\n"
   "\n"
   "    pub const huff_codes = [_]u32{\n"
   "        ZIG_HUFF_CODES\n"
   "    };\n"
   "\n"
   "    pub const huff_lens = [_]u32{\n"
   "        ZIG_HUFF_LENS\n"
   "    };\n"
   "\n"
   "    fn huffDecode(alloc: std.mem.Allocator, data: []const u8, off: usize, len: usize) ![]u8 {\n"
   "        var out: std.ArrayList(u8) = .empty;\n"
   "        errdefer out.deinit(alloc);\n"
   "        var code: u64 = 0;\n"
   "        var bits: u32 = 0;\n"
   "        for (data[off .. off + len]) |byte| {\n"
   "            var j: i32 = 7;\n"
   "            while (j >= 0) : (j -= 1) {\n"
   "                const bit: u64 = (byte >> @intCast(j)) & 1;\n"
   "                code = (code << 1) | bit;\n"
   "                bits += 1;\n"
   "                var found: ?u32 = null;\n"
   "                for (huff_codes, 0..) |hc, sym| {\n"
   "                    if (huff_lens[sym] == bits and hc == code) {\n"
   "                        found = @intCast(sym);\n"
   "                        break;\n"
   "                    }\n"
   "                }\n"
   "                if (found) |sym| {\n"
   "                    if (sym == 256) return error.HuffmanEos;\n"
   "                    try out.append(alloc, @intCast(sym));\n"
   "                    code = 0;\n"
   "                    bits = 0;\n"
   "                } else if (bits > 30) {\n"
   "                    return error.HuffmanTooLong;\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        return out.toOwnedSlice(alloc);\n"
   "    }\n"
   "\n"
   "    pub const HpackDecoder = struct {\n"
   "        dynamic: std.ArrayList([2][]const u8) = .empty,\n"
   "        dynamic_size: usize = 0,\n"
   "\n"
   "        pub fn deinit(self: *HpackDecoder, alloc: std.mem.Allocator) void {\n"
   "            for (self.dynamic.items) |e| {\n"
   "                alloc.free(e[0]);\n"
   "                alloc.free(e[1]);\n"
   "            }\n"
   "            self.dynamic.deinit(alloc);\n"
   "        }\n"
   "\n"
   "        fn entry(self: *HpackDecoder, index: usize) !struct { name: []const u8, value: []const u8 } {\n"
   "            if (index == 0) return error.BadHpackIndex;\n"
   "            if (index <= static_table.len) {\n"
   "                const e = static_table[index - 1];\n"
   "                return .{ .name = e[0], .value = e[1] };\n"
   "            }\n"
   "            const j = index - static_table.len - 1;\n"
   "            if (j >= self.dynamic.items.len) return error.BadHpackIndex;\n"
   "            const e = self.dynamic.items[j];\n"
   "            return .{ .name = e[0], .value = e[1] };\n"
   "        }\n"
   "\n"
   "        fn add(self: *HpackDecoder, alloc: std.mem.Allocator, name: []const u8, value: []const u8) !void {\n"
   "            try self.dynamic.insert(alloc, 0, .{ try alloc.dupe(u8, name), try alloc.dupe(u8, value) });\n"
   "            self.dynamic_size += name.len + value.len + 32;\n"
   "            while (self.dynamic_size > 4096 and self.dynamic.items.len > 0) {\n"
   "                const e = self.dynamic.pop().?;\n"
   "                self.dynamic_size -= e[0].len + e[1].len + 32;\n"
   "                alloc.free(e[0]);\n"
   "                alloc.free(e[1]);\n"
   "            }\n"
   "        }\n"
   "\n"
   "        fn readInt(data: []const u8, pos: *usize, prefix_bits: u32) !usize {\n"
   "            const mask: usize = (@as(usize, 1) << @intCast(prefix_bits)) - 1;\n"
   "            var value: usize = data[pos.*] & mask;\n"
   "            pos.* += 1;\n"
   "            if (value < mask) return value;\n"
   "            var shift: u32 = 0;\n"
   "            while (true) {\n"
   "                if (pos.* >= data.len) return error.TruncatedHpack;\n"
   "                const b = data[pos.*];\n"
   "                pos.* += 1;\n"
   "                value += @as(usize, b & 0x7f) << @intCast(shift);\n"
   "                shift += 7;\n"
   "                if ((b & 0x80) == 0) break;\n"
   "            }\n"
   "            return value;\n"
   "        }\n"
   "\n"
   "        fn readString(self: *HpackDecoder, alloc: std.mem.Allocator, data: []const u8, pos: *usize) ![]u8 {\n"
   "            _ = self;\n"
   "            if (pos.* >= data.len) return error.TruncatedHpack;\n"
   "            const huffman = (data[pos.*] & 0x80) != 0;\n"
   "            const len = try readInt(data, pos, 7);\n"
   "            if (pos.* + len > data.len) return error.TruncatedHpack;\n"
   "            const raw = data[pos.* .. pos.* + len];\n"
   "            const value = if (huffman) try huffDecode(alloc, data, pos.*, len) else try alloc.dupe(u8, raw);\n"
   "            pos.* += len;\n"
   "            return value;\n"
   "        }\n"
   "\n"
   "        pub fn decode(self: *HpackDecoder, alloc: std.mem.Allocator, block: []const u8, out: *std.ArrayList([2][]u8)) !void {\n"
   "            var pos: usize = 0;\n"
   "            while (pos < block.len) {\n"
   "                const b = block[pos];\n"
   "                if ((b & 0x80) != 0) {\n"
   "                    const index = try readInt(block, &pos, 7);\n"
   "                    const e = try self.entry(index);\n"
   "                    try out.append(alloc, .{ try alloc.dupe(u8, e.name), try alloc.dupe(u8, e.value) });\n"
   "                } else if ((b & 0xe0) == 0x20) {\n"
   "                    _ = try readInt(block, &pos, 5);\n"
   "                } else {\n"
   "                    const incremental = (b & 0xc0) == 0x40;\n"
   "                    const index = try readInt(block, &pos, if (incremental) @as(u32, 6) else @as(u32, 4));\n"
   "                    const name: []u8 = if (index > 0) blk: {\n"
   "                        const e = try self.entry(index);\n"
   "                        break :blk try alloc.dupe(u8, e.name);\n"
   "                    } else try self.readString(alloc, block, &pos);\n"
   "                    defer alloc.free(name);\n"
   "                    const value = try self.readString(alloc, block, &pos);\n"
   "                    errdefer alloc.free(value);\n"
   "                    try out.append(alloc, .{ try alloc.dupe(u8, name), value });\n"
   "                    if (incremental) {\n"
   "                        try self.add(alloc, name, value);\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "    };\n"
   "\n"
   "    fn writeInt(out: *std.ArrayList(u8), alloc: std.mem.Allocator, value: usize, prefix_bits: u32, prefix: u8) !void {\n"
   "        const mask: usize = (@as(usize, 1) << @intCast(prefix_bits)) - 1;\n"
   "        if (value < mask) {\n"
   "            try out.append(alloc, prefix | @as(u8, @intCast(value)));\n"
   "            return;\n"
   "        }\n"
   "        try out.append(alloc, prefix | @as(u8, @intCast(mask)));\n"
   "        var rest = value - mask;\n"
   "        while (rest >= 0x80) {\n"
   "            try out.append(alloc, @as(u8, @intCast((rest & 0x7f) | 0x80)));\n"
   "            rest >>= 7;\n"
   "        }\n"
   "        try out.append(alloc, @as(u8, @intCast(rest)));\n"
   "    }\n"
   "\n"
   "    fn writeString(out: *std.ArrayList(u8), alloc: std.mem.Allocator, value: []const u8) !void {\n"
   "        try writeInt(out, alloc, value.len, 7, 0);\n"
   "        try out.appendSlice(alloc, value);\n"
   "    }\n"
   "\n"
   "    fn writeLiteralIndexedName(out: *std.ArrayList(u8), alloc: std.mem.Allocator, index: usize, value: []const u8) !void {\n"
   "        try writeInt(out, alloc, index, 4, 0);\n"
   "        try writeString(out, alloc, value);\n"
   "    }\n"
   "\n"
   "    fn writeLiteralNewName(out: *std.ArrayList(u8), alloc: std.mem.Allocator, name: []const u8, value: []const u8) !void {\n"
   "        try writeInt(out, alloc, 0, 4, 0);\n"
   "        try writeString(out, alloc, name);\n"
   "        try writeString(out, alloc, value);\n"
   "    }\n"
   "\n"
   "    // gzip (RFC 1952) with stored (uncompressed) deflate\n"
   "    // blocks: std.compress.flate's compressors are unfinished\n"
   "    // in Zig 0.15.1 (zero-progress drain / TODO), while its\n"
   "    // Decompress below is complete — so the writer is manual,\n"
   "    // the reader is stdlib.\n"
   "    pub fn gzip(alloc: std.mem.Allocator, data: []const u8) ![]u8 {\n"
   "        var out: std.ArrayList(u8) = .empty;\n"
   "        errdefer out.deinit(alloc);\n"
   "        try out.appendSlice(alloc, &.{ 0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 255 });\n"
   "        if (data.len == 0) {\n"
   "            try out.appendSlice(alloc, &.{ 1, 0, 0, 0xff, 0xff });\n"
   "        } else {\n"
   "            var off: usize = 0;\n"
   "            while (off < data.len) {\n"
   "                const chunk = @min(65535, data.len - off);\n"
   "                const last = off + chunk >= data.len;\n"
   "                try out.append(alloc, if (last) @as(u8, 1) else @as(u8, 0));\n"
   "                var len_buf: [2]u8 = undefined;\n"
   "                std.mem.writeInt(u16, &len_buf, @intCast(chunk), .little);\n"
   "                try out.appendSlice(alloc, &len_buf);\n"
   "                std.mem.writeInt(u16, &len_buf, @as(u16, @truncate(~@as(usize, chunk))), .little);\n"
   "                try out.appendSlice(alloc, &len_buf);\n"
   "                try out.appendSlice(alloc, data[off .. off + chunk]);\n"
   "                off += chunk;\n"
   "            }\n"
   "        }\n"
   "        var crc_buf: [4]u8 = undefined;\n"
   "        std.mem.writeInt(u32, &crc_buf, std.hash.Crc32.hash(data), .little);\n"
   "        try out.appendSlice(alloc, &crc_buf);\n"
   "        std.mem.writeInt(u32, &crc_buf, @truncate(data.len), .little);\n"
   "        try out.appendSlice(alloc, &crc_buf);\n"
   "        return out.toOwnedSlice(alloc);\n"
   "    }\n"
   "\n"
   "    pub fn gunzip(alloc: std.mem.Allocator, data: []const u8) ![]u8 {\n"
   "        var input = std.Io.Reader.fixed(data);\n"
   "        var decomp = std.compress.flate.Decompress.init(&input, .gzip, &.{});\n"
   "        var aw: std.Io.Writer.Allocating = .init(alloc);\n"
   "        errdefer aw.deinit();\n"
   "        _ = try decomp.reader.streamRemaining(&aw.writer);\n"
   "        return aw.toOwnedSlice();\n"
   "    }\n"
   "\n"
   "    alloc: std.mem.Allocator,\n"
   "    authority: []const u8,\n"
   "    scheme: []const u8,\n"
   "    stream: std.net.Stream,\n"
   "    send_mutex: std.Thread.Mutex = .{},\n"
   "    queue_mutex: std.Thread.Mutex = .{},\n"
   "    queue_cond: std.Thread.Condition = .{},\n"
   "    queue: std.ArrayList([]u8) = .empty,\n"
   "    queue_closed: bool = false,\n"
   "    decoder: HpackDecoder = .{},\n"
   "    flow_mutex: std.Thread.Mutex = .{},\n"
   "    flow_cond: std.Thread.Condition = .{},\n"
   "    conn_window: i64 = 65535,\n"
   "    stream_windows: std.AutoHashMap(u32, i64),\n"
   "    peer_initial_window: i64 = 65535,\n"
   "    data_buffers: std.AutoHashMap(u32, std.ArrayList(u8)),\n"
   "    header_blocks: std.AutoHashMap(u32, std.ArrayList(u8)),\n"
   "    headers_seen: std.AutoHashMap(u32, void),\n"
   "    compress_out: std.AutoHashMap(u32, void),\n"
   "    decompress_in: std.AutoHashMap(u32, void),\n"
   "    closed: bool = false,\n"
   "    socket_closed: bool = false,\n"
   "    reader_thread: ?std.Thread = null,\n"
   "    recv_buffer: std.ArrayList(u8) = .empty,\n"
   "\n"
   "    /// Cleartext (h2c, prior knowledge) connection to authority.\n"
   "    pub fn dial(alloc: std.mem.Allocator, authority: []const u8) !*Http2Transport {\n"
   "        return init(alloc, authority, false);\n"
   "    }\n"
   "\n"
   "    /// TLS is not offered by the generated Zig transport:\n"
   "    /// std.crypto.tls cannot negotiate ALPN h2 with\n"
   "    /// verification here, so this returns error.TlsUnsupported\n"
   "    /// rather than silently dialing cleartext.\n"
   "    pub fn dialTls(alloc: std.mem.Allocator, authority: []const u8) !*Http2Transport {\n"
   "        _ = alloc;\n"
   "        _ = authority;\n"
   "        return error.TlsUnsupported;\n"
   "    }\n"
   "\n"
   "    fn init(alloc: std.mem.Allocator, authority: []const u8, tls: bool) !*Http2Transport {\n"
   "        const self = try alloc.create(Http2Transport);\n"
   "        errdefer alloc.destroy(self);\n"
   "        var host: []const u8 = authority;\n"
   "        var port: u16 = if (tls) 443 else 80;\n"
   "        if (std.mem.lastIndexOfScalar(u8, authority, ':')) |colon| {\n"
   "            host = authority[0..colon];\n"
   "            port = std.fmt.parseInt(u16, authority[colon + 1 ..], 10) catch port;\n"
   "        }\n"
   "        const address = std.net.Address.parseIp(host, port) catch blk: {\n"
   "            if (std.mem.eql(u8, host, \"localhost\")) {\n"
   "                break :blk std.net.Address.parseIp(\"127.0.0.1\", port) catch unreachable;\n"
   "            }\n"
   "            return error.UnknownHost;\n"
   "        };\n"
   "        const stream = try std.net.tcpConnectToAddress(address);\n"
   "        self.* = .{\n"
   "            .alloc = alloc,\n"
   "            .authority = authority,\n"
   "            .scheme = if (tls) \"https\" else \"http\",\n"
   "            .stream = stream,\n"
   "            .stream_windows = std.AutoHashMap(u32, i64).init(alloc),\n"
   "            .data_buffers = std.AutoHashMap(u32, std.ArrayList(u8)).init(alloc),\n"
   "            .header_blocks = std.AutoHashMap(u32, std.ArrayList(u8)).init(alloc),\n"
   "            .headers_seen = std.AutoHashMap(u32, void).init(alloc),\n"
   "            .compress_out = std.AutoHashMap(u32, void).init(alloc),\n"
   "            .decompress_in = std.AutoHashMap(u32, void).init(alloc),\n"
   "        };\n"
   "        // Connection preface + an empty SETTINGS frame.\n"
   "        try self.writeRaw(\"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n\");\n"
   "        try self.writeFrame(h2_settings, 0, 0, \"\");\n"
   "        self.reader_thread = std.Thread.spawn(.{}, readerLoop, .{self}) catch null;\n"
   "        return self;\n"
   "    }\n"
   "\n"
   "    pub fn transport(self: *Http2Transport) transport_mod.Transport {\n"
   "        return .{ .ctx = self, .send_fn = sendFn, .recv_fn = recvFn, .close_fn = closeFn };\n"
   "    }\n"
   "\n"
   "    fn writeRaw(self: *Http2Transport, bytes: []const u8) !void {\n"
   "        self.send_mutex.lock();\n"
   "        defer self.send_mutex.unlock();\n"
   "        try self.stream.writeAll(bytes);\n"
   "    }\n"
   "\n"
   "    fn writeFrame(self: *Http2Transport, frame_type: u8, flags: u8, stream_id: u32, payload: []const u8) !void {\n"
   "        var header: [9]u8 = undefined;\n"
   "        header[0] = @intCast((payload.len >> 16) & 0xff);\n"
   "        header[1] = @intCast((payload.len >> 8) & 0xff);\n"
   "        header[2] = @intCast(payload.len & 0xff);\n"
   "        header[3] = frame_type;\n"
   "        header[4] = flags;\n"
   "        header[5] = @intCast((stream_id >> 24) & 0x7f);\n"
   "        header[6] = @intCast((stream_id >> 16) & 0xff);\n"
   "        header[7] = @intCast((stream_id >> 8) & 0xff);\n"
   "        header[8] = @intCast(stream_id & 0xff);\n"
   "        self.send_mutex.lock();\n"
   "        defer self.send_mutex.unlock();\n"
   "        try self.stream.writeAll(&header);\n"
   "        try self.stream.writeAll(payload);\n"
   "    }\n"
   "\n"
   "    fn emit(self: *Http2Transport, frame_type: u8, stream_id: u32, payload: []const u8) void {\n"
   "        const frame = switch (Codec.encodeFrame(self.alloc, frame_type, stream_id, payload)) {\n"
   "            .bytes => |f| f,\n"
   "            .status => return,\n"
   "        };\n"
   "        self.queue_mutex.lock();\n"
   "        defer self.queue_mutex.unlock();\n"
   "        self.queue.append(self.alloc, frame) catch {\n"
   "            self.alloc.free(frame);\n"
   "            return;\n"
   "        };\n"
   "        self.queue_cond.signal();\n"
   "    }\n"
   "\n"
   "    fn emitHeadersFrame(self: *Http2Transport, stream_id: u32, metadata: *const std.StringHashMap([]const u8)) void {\n"
   "        const frame = switch (Codec.headersFrame(self.alloc, stream_id, null, metadata)) {\n"
   "            .bytes => |f| f,\n"
   "            .status => return,\n"
   "        };\n"
   "        // headersFrame includes the 9-byte frame header; emit()\n"
   "        // re-encodes, so queue only the payload.\n"
   "        self.emit(wire.frameHeaders, stream_id, frame[Codec.header_len..]);\n"
   "        self.alloc.free(frame);\n"
   "    }\n"
   "\n"
   "    fn emitTrailersFrame(self: *Http2Transport, stream_id: u32, code: i32, message: []const u8, metadata: ?*const std.StringHashMap([]const u8)) void {\n"
   "        var st = Status.init(code, message);\n"
   "        if (metadata) |md| {\n"
   "            var pairs: std.ArrayList(status_mod.TrailerPair) = .empty;\n"
   "            defer pairs.deinit(self.alloc);\n"
   "            var it = md.iterator();\n"
   "            while (it.next()) |entry| {\n"
   "                pairs.append(self.alloc, .{ .key = entry.key_ptr.*, .value = entry.value_ptr.* }) catch {};\n"
   "            }\n"
   "            st.trailers = pairs.items;\n"
   "        }\n"
   "        const frame = switch (Codec.statusFrame(self.alloc, wire.frameTrailers, stream_id, st)) {\n"
   "            .bytes => |f| f,\n"
   "            .status => return,\n"
   "        };\n"
   "        self.emit(wire.frameTrailers, stream_id, frame[Codec.header_len..]);\n"
   "        self.alloc.free(frame);\n"
   "    }\n"
   "\n"
   "    fn readerLoop(self: *Http2Transport) void {\n"
   "        var chunk: [65536]u8 = undefined;\n"
   "        while (!self.closed) {\n"
   "            var fds = [_]std.posix.pollfd{.{ .fd = self.stream.handle, .events = std.posix.POLL.IN, .revents = 0 }};\n"
   "            const ready = std.posix.poll(&fds, 100) catch break;\n"
   "            if (self.closed) break;\n"
   "            if (ready == 0) continue;\n"
   "            const n = self.stream.read(&chunk) catch break;\n"
   "            if (n == 0) break;\n"
   "            self.recv_buffer.appendSlice(self.alloc, chunk[0..n]) catch break;\n"
   "            while (self.recv_buffer.items.len >= 9) {\n"
   "                const items = self.recv_buffer.items;\n"
   "                const len = (@as(usize, items[0]) << 16) | (@as(usize, items[1]) << 8) | items[2];\n"
   "                if (items.len < 9 + len) break;\n"
   "                const frame_type = items[3];\n"
   "                const flags = items[4];\n"
   "                const stream_id = (@as(u32, items[5] & 0x7f) << 24) | (@as(u32, items[6]) << 16) | (@as(u32, items[7]) << 8) | items[8];\n"
   "                const payload = self.alloc.dupe(u8, items[9 .. 9 + len]) catch return;\n"
   "                const rest = self.alloc.dupe(u8, items[9 + len ..]) catch {\n"
   "                    self.alloc.free(payload);\n"
   "                    return;\n"
   "                };\n"
   "                self.recv_buffer.clearRetainingCapacity();\n"
   "                self.recv_buffer.appendSlice(self.alloc, rest) catch {};\n"
   "                self.alloc.free(rest);\n"
   "                self.onFrame(frame_type, flags, stream_id, payload);\n"
   "                self.alloc.free(payload);\n"
   "            }\n"
   "        }\n"
   "        self.markClosed();\n"
   "        self.queue_mutex.lock();\n"
   "        self.queue_closed = true;\n"
   "        self.queue_cond.broadcast();\n"
   "        self.queue_mutex.unlock();\n"
   "    }\n"
   "\n"
   "    fn markClosed(self: *Http2Transport) void {\n"
   "        self.flow_mutex.lock();\n"
   "        self.closed = true;\n"
   "        self.flow_cond.broadcast();\n"
   "        self.flow_mutex.unlock();\n"
   "    }\n"
   "\n"
   "    fn onFrame(self: *Http2Transport, frame_type: u8, flags: u8, stream_id: u32, payload: []const u8) void {\n"
   "        switch (frame_type) {\n"
   "            h2_settings => {\n"
   "                if ((flags & flag_ack) != 0) return;\n"
   "                var new_initial = self.peer_initial_window;\n"
   "                var off: usize = 0;\n"
   "                while (off + 6 <= payload.len) : (off += 6) {\n"
   "                    const ident = (@as(u16, payload[off]) << 8) | payload[off + 1];\n"
   "                    const value: i64 = (@as(i64, payload[off + 2]) << 24) | (@as(i64, payload[off + 3]) << 16) | (@as(i64, payload[off + 4]) << 8) | payload[off + 5];\n"
   "                    if (ident == 0x3) new_initial = value;\n"
   "                }\n"
   "                const delta = new_initial - self.peer_initial_window;\n"
   "                self.peer_initial_window = new_initial;\n"
   "                if (delta != 0) {\n"
   "                    self.flow_mutex.lock();\n"
   "                    var it = self.stream_windows.valueIterator();\n"
   "                    while (it.next()) |v| v.* += delta;\n"
   "                    self.flow_cond.broadcast();\n"
   "                    self.flow_mutex.unlock();\n"
   "                }\n"
   "                self.writeFrame(h2_settings, flag_ack, 0, \"\") catch {};\n"
   "            },\n"
   "            h2_window_update => {\n"
   "                if (payload.len >= 4) {\n"
   "                    const inc: i64 = (@as(i64, payload[0] & 0x7f) << 24) | (@as(i64, payload[1]) << 16) | (@as(i64, payload[2]) << 8) | payload[3];\n"
   "                    self.flow_mutex.lock();\n"
   "                    if (stream_id == 0) {\n"
   "                        self.conn_window += inc;\n"
   "                    } else {\n"
   "                        const cur = self.stream_windows.get(stream_id) orelse self.peer_initial_window;\n"
   "                        self.stream_windows.put(stream_id, cur + inc) catch {};\n"
   "                    }\n"
   "                    self.flow_cond.broadcast();\n"
   "                    self.flow_mutex.unlock();\n"
   "                }\n"
   "            },\n"
   "            h2_ping => {\n"
   "                if ((flags & flag_ack) == 0 and payload.len == 8) {\n"
   "                    self.writeFrame(h2_ping, flag_ack, 0, payload) catch {};\n"
   "                }\n"
   "            },\n"
   "            h2_rst_stream => {\n"
   "                self.emit(wire.frameRst, stream_id, \"{\\\"code\\\":8,\\\"message\\\":\\\"rst stream\\\"}\");\n"
   "            },\n"
   "            h2_headers, h2_continuation => {\n"
   "                const entry = self.header_blocks.getOrPut(stream_id) catch return;\n"
   "                if (!entry.found_existing) entry.value_ptr.* = .empty;\n"
   "                entry.value_ptr.appendSlice(self.alloc, payload) catch return;\n"
   "                if ((flags & flag_end_headers) != 0) {\n"
   "                    const block = entry.value_ptr.toOwnedSlice(self.alloc) catch return;\n"
   "                    defer self.alloc.free(block);\n"
   "                    _ = self.header_blocks.remove(stream_id);\n"
   "                    self.onHeaders(stream_id, (flags & flag_end_stream) != 0, block);\n"
   "                }\n"
   "            },\n"
   "            h2_data => {\n"
   "                var body = payload;\n"
   "                if ((flags & flag_padded) != 0 and body.len >= 1) {\n"
   "                    const pad: usize = body[0];\n"
   "                    body = if (pad + 1 <= body.len) body[1 .. body.len - pad] else body[0..0];\n"
   "                }\n"
   "                if (body.len > 0) {\n"
   "                    var wu: [4]u8 = undefined;\n"
   "                    writeWindowUpdate(&wu, body.len);\n"
   "                    self.writeFrame(h2_window_update, 0, 0, &wu) catch {};\n"
   "                    self.writeFrame(h2_window_update, 0, stream_id, &wu) catch {};\n"
   "                    const entry = self.data_buffers.getOrPut(stream_id) catch return;\n"
   "                    if (!entry.found_existing) entry.value_ptr.* = .empty;\n"
   "                    entry.value_ptr.appendSlice(self.alloc, body) catch return;\n"
   "                    self.drainMessages(stream_id);\n"
   "                }\n"
   "                if ((flags & flag_end_stream) != 0) {\n"
   "                    self.emitTrailersFrame(stream_id, 2, \"missing grpc-status\", null);\n"
   "                }\n"
   "            },\n"
   "            else => {},\n"
   "        }\n"
   "    }\n"
   "\n"
   "    fn writeWindowUpdate(out: *[4]u8, increment: usize) void {\n"
   "        out[0] = @intCast((increment >> 24) & 0x7f);\n"
   "        out[1] = @intCast((increment >> 16) & 0xff);\n"
   "        out[2] = @intCast((increment >> 8) & 0xff);\n"
   "        out[3] = @intCast(increment & 0xff);\n"
   "    }\n"
   "\n"
   "    fn onHeaders(self: *Http2Transport, stream_id: u32, end_stream: bool, block: []const u8) void {\n"
   "        var headers: std.ArrayList([2][]u8) = .empty;\n"
   "        defer {\n"
   "            for (headers.items) |e| {\n"
   "                self.alloc.free(e[0]);\n"
   "                self.alloc.free(e[1]);\n"
   "            }\n"
   "            headers.deinit(self.alloc);\n"
   "        }\n"
   "        self.decoder.decode(self.alloc, block, &headers) catch return;\n"
   "        var metadata = std.StringHashMap([]const u8).init(self.alloc);\n"
   "        defer metadata.deinit();\n"
   "        // metadata values borrow the decoded header slices, which\n"
   "        // outlive this call until the deferred free above; the\n"
   "        // emit helpers serialize immediately.\n"
   "        var status: ?[]const u8 = null;\n"
   "        var message: ?[]const u8 = null;\n"
   "        for (headers.items) |h| {\n"
   "            const name = h[0];\n"
   "            const value = h[1];\n"
   "            if (std.mem.eql(u8, name, \"grpc-status\")) {\n"
   "                status = value;\n"
   "            } else if (std.mem.eql(u8, name, \"grpc-message\")) {\n"
   "                message = value;\n"
   "            } else if (std.mem.eql(u8, name, \"grpc-encoding\")) {\n"
   "                if (std.mem.eql(u8, value, \"gzip\")) {\n"
   "                    self.decompress_in.put(stream_id, {}) catch {};\n"
   "                }\n"
   "            } else if (std.mem.startsWith(u8, name, \":\") or std.mem.eql(u8, name, \"content-type\") or std.mem.eql(u8, name, \"grpc-accept-encoding\")) {\n"
   "                // transport-owned: not metadata\n"
   "            } else if (!metadata.contains(name)) {\n"
   "                metadata.put(name, value) catch {};\n"
   "            }\n"
   "        }\n"
   "        const first = !self.headers_seen.contains(stream_id);\n"
   "        self.headers_seen.put(stream_id, {}) catch {};\n"
   "        if (end_stream and status != null) {\n"
   "            const code = std.fmt.parseInt(i32, status.?, 10) catch 2;\n"
   "            const decoded = percentDecode(self.alloc, message orelse \"\");\n"
   "            defer if (decoded) |d| self.alloc.free(d);\n"
   "            self.emitTrailersFrame(stream_id, code, decoded orelse \"\", &metadata);\n"
   "        } else if (first) {\n"
   "            self.emitHeadersFrame(stream_id, &metadata);\n"
   "            if (end_stream) {\n"
   "                self.emitTrailersFrame(stream_id, 2, \"missing grpc-status\", &metadata);\n"
   "            }\n"
   "        } else if (end_stream) {\n"
   "            self.emitTrailersFrame(stream_id, 2, \"missing grpc-status\", &metadata);\n"
   "        }\n"
   "    }\n"
   "\n"
   "    fn drainMessages(self: *Http2Transport, stream_id: u32) void {\n"
   "        const buf = self.data_buffers.getPtr(stream_id) orelse return;\n"
   "        var off: usize = 0;\n"
   "        while (buf.items.len - off >= 5) {\n"
   "            const data = buf.items;\n"
   "            const mlen = (@as(usize, data[off + 1]) << 24) | (@as(usize, data[off + 2]) << 16) | (@as(usize, data[off + 3]) << 8) | data[off + 4];\n"
   "            if (data.len - off - 5 < mlen) break;\n"
   "            const compressed = data[off] & 0xff;\n"
   "            const raw = data[off + 5 .. off + 5 + mlen];\n"
   "            off += 5 + mlen;\n"
   "            if (compressed == 1 or self.decompress_in.contains(stream_id)) {\n"
   "                const plain = gunzip(self.alloc, raw) catch continue;\n"
   "                defer self.alloc.free(plain);\n"
   "                self.emit(wire.frameData, stream_id, plain);\n"
   "            } else {\n"
   "                self.emit(wire.frameData, stream_id, raw);\n"
   "            }\n"
   "        }\n"
   "        if (off > 0) {\n"
   "            const rest = self.alloc.dupe(u8, buf.items[off..]) catch return;\n"
   "            buf.clearRetainingCapacity();\n"
   "            buf.appendSlice(self.alloc, rest) catch {};\n"
   "            self.alloc.free(rest);\n"
   "        }\n"
   "    }\n"
   "\n"
   "    fn percentDecode(alloc: std.mem.Allocator, value: []const u8) ?[]u8 {\n"
   "        var out: std.ArrayList(u8) = .empty;\n"
   "        var i: usize = 0;\n"
   "        while (i < value.len) {\n"
   "            const c = value[i];\n"
   "            if (c == '%' and i + 2 < value.len) {\n"
   "                const hi = hexDigit(value[i + 1]);\n"
   "                const lo = hexDigit(value[i + 2]);\n"
   "                if (hi >= 0 and lo >= 0) {\n"
   "                    out.append(alloc, @intCast((hi << 4) | lo)) catch return null;\n"
   "                    i += 3;\n"
   "                    continue;\n"
   "                }\n"
   "            }\n"
   "            out.append(alloc, c) catch return null;\n"
   "            i += 1;\n"
   "        }\n"
   "        return out.toOwnedSlice(alloc) catch null;\n"
   "    }\n"
   "\n"
   "    fn hexDigit(c: u8) i32 {\n"
   "        return switch (c) {\n"
   "            '0'...'9' => c - '0',\n"
   "            'a'...'f' => c - 'a' + 10,\n"
   "            'A'...'F' => c - 'A' + 10,\n"
   "            else => -1,\n"
   "        };\n"
   "    }\n"
   "\n"
   "    fn sendFn(ctx: *anyopaque, data: []const u8) anyerror!void {\n"
   "        const self: *Http2Transport = @ptrCast(@alignCast(ctx));\n"
   "        try self.handleSend(data);\n"
   "    }\n"
   "\n"
   "    fn handleSend(self: *Http2Transport, message: []const u8) !void {\n"
   "        const frame = switch (Codec.decodeFrame(message)) {\n"
   "            .frame => |f| f,\n"
   "            .status => |st| {\n"
   "                if (st.code != wire.codeOk) return error.BadFrame;\n"
   "                return;\n"
   "            },\n"
   "        };\n"
   "        const stream_id = frame.stream_id;\n"
   "        const payload = frame.payload;\n"
   "        switch (frame.type) {\n"
   "            wire.frameHeaders => {\n"
   "                var headers = switch (Codec.parseHeaders(self.alloc, payload)) {\n"
   "                    .headers => |h| h,\n"
   "                    .status => return error.BadFrame,\n"
   "                };\n"
   "                defer Codec.freeHeaders(self.alloc, &headers);\n"
   "                self.flow_mutex.lock();\n"
   "                if (!self.stream_windows.contains(stream_id)) {\n"
   "                    self.stream_windows.put(stream_id, self.peer_initial_window) catch {};\n"
   "                }\n"
   "                self.flow_mutex.unlock();\n"
   "                if (headers.metadata.get(\"grpc-encoding\")) |enc| {\n"
   "                    if (std.mem.eql(u8, enc, \"gzip\")) {\n"
   "                        self.compress_out.put(stream_id, {}) catch {};\n"
   "                    }\n"
   "                }\n"
   "                var block: std.ArrayList(u8) = .empty;\n"
   "                defer block.deinit(self.alloc);\n"
   "                try block.append(self.alloc, 0x83); // :method: POST\n"
   "                try block.append(self.alloc, if (std.mem.eql(u8, self.scheme, \"https\")) @as(u8, 0x87) else @as(u8, 0x86)); // :scheme\n"
   "                try writeLiteralIndexedName(&block, self.alloc, 4, headers.path orelse \"\"); // :path\n"
   "                try writeLiteralIndexedName(&block, self.alloc, 1, self.authority); // :authority\n"
   "                try writeLiteralIndexedName(&block, self.alloc, 31, \"application/grpc\");\n"
   "                try writeLiteralNewName(&block, self.alloc, \"grpc-accept-encoding\", \"gzip,identity\");\n"
   "                try writeLiteralNewName(&block, self.alloc, \"te\", \"trailers\");\n"
   "                var it = headers.metadata.iterator();\n"
   "                while (it.next()) |entry| {\n"
   "                    var lower_buf: [256]u8 = undefined;\n"
   "                    const key_src = entry.key_ptr.*;\n"
   "                    if (key_src.len > lower_buf.len) continue;\n"
   "                    for (key_src, 0..) |ch, idx| lower_buf[idx] = std.ascii.toLower(ch);\n"
   "                    const key = lower_buf[0..key_src.len];\n"
   "                    if (std.mem.eql(u8, key, \"grpc-encoding\")) {\n"
   "                        try writeLiteralNewName(&block, self.alloc, key, \"gzip\");\n"
   "                    } else {\n"
   "                        try writeLiteralNewName(&block, self.alloc, key, entry.value_ptr.*);\n"
   "                    }\n"
   "                }\n"
   "                try self.writeFrame(h2_headers, flag_end_headers, stream_id, block.items);\n"
   "            },\n"
   "            wire.frameData => {\n"
   "                const compressed = self.compress_out.contains(stream_id);\n"
   "                const body = if (compressed) try gzip(self.alloc, payload) else payload;\n"
   "                defer if (compressed) self.alloc.free(body);\n"
   "                var wire_buf: std.ArrayList(u8) = .empty;\n"
   "                defer wire_buf.deinit(self.alloc);\n"
   "                try wire_buf.append(self.alloc, if (compressed) @as(u8, 1) else @as(u8, 0));\n"
   "                var len_buf: [4]u8 = undefined;\n"
   "                std.mem.writeInt(u32, &len_buf, @intCast(body.len), .big);\n"
   "                try wire_buf.appendSlice(self.alloc, &len_buf);\n"
   "                try wire_buf.appendSlice(self.alloc, body);\n"
   "                const bytes = wire_buf.items;\n"
   "                var sent: usize = 0;\n"
   "                while (sent < bytes.len) {\n"
   "                    var allowance: usize = 0;\n"
   "                    self.flow_mutex.lock();\n"
   "                    while (!self.closed and (self.conn_window <= 0 or (self.stream_windows.get(stream_id) orelse self.peer_initial_window) <= 0)) {\n"
   "                        self.flow_cond.wait(&self.flow_mutex);\n"
   "                    }\n"
   "                    if (self.closed) {\n"
   "                        self.flow_mutex.unlock();\n"
   "                        return error.Closed;\n"
   "                    }\n"
   "                    const sw = self.stream_windows.get(stream_id) orelse self.peer_initial_window;\n"
   "                    var allow = @min(self.conn_window, sw);\n"
   "                    if (allow > @as(i64, @intCast(max_frame_payload))) allow = max_frame_payload;\n"
   "                    if (allow > @as(i64, @intCast(bytes.len - sent))) allow = @intCast(bytes.len - sent);\n"
   "                    if (allow <= 0) {\n"
   "                        self.flow_mutex.unlock();\n"
   "                        continue;\n"
   "                    }\n"
   "                    allowance = @intCast(allow);\n"
   "                    self.conn_window -= allow;\n"
   "                    self.stream_windows.put(stream_id, sw - allow) catch {};\n"
   "                    self.flow_mutex.unlock();\n"
   "                    try self.writeFrame(h2_data, 0, stream_id, bytes[sent .. sent + allowance]);\n"
   "                    sent += allowance;\n"
   "                }\n"
   "            },\n"
   "            wire.frameHalfClose => {\n"
   "                try self.writeFrame(h2_data, flag_end_stream, stream_id, \"\");\n"
   "            },\n"
   "            wire.frameRst => {\n"
   "                try self.writeFrame(h2_rst_stream, 0, stream_id, &.{ 0, 0, 0, 8 });\n"
   "            },\n"
   "            else => {},\n"
   "        }\n"
   "    }\n"
   "\n"
   "    fn recvFn(ctx: *anyopaque, alloc: std.mem.Allocator) anyerror!?[]u8 {\n"
   "        const self: *Http2Transport = @ptrCast(@alignCast(ctx));\n"
   "        _ = alloc; // messages were copied with the transport allocator\n"
   "        self.queue_mutex.lock();\n"
   "        defer self.queue_mutex.unlock();\n"
   "        while (self.queue.items.len == 0) {\n"
   "            if (self.queue_closed) return null;\n"
   "            self.queue_cond.wait(&self.queue_mutex);\n"
   "        }\n"
   "        return self.queue.orderedRemove(0);\n"
   "    }\n"
   "\n"
   "    fn closeFn(ctx: *anyopaque) void {\n"
   "        const self: *Http2Transport = @ptrCast(@alignCast(ctx));\n"
   "        self.close();\n"
   "    }\n"
   "\n"
   "    pub fn close(self: *Http2Transport) void {\n"
   "        self.markClosed();\n"
   "        if (self.socket_closed) return;\n"
   "        self.socket_closed = true;\n"
   "        self.stream.close();\n"
   "        self.queue_mutex.lock();\n"
   "        self.queue_closed = true;\n"
   "        self.queue_cond.broadcast();\n"
   "        self.queue_mutex.unlock();\n"
   "    }\n"
   "\n"
   "    pub fn deinit(self: *Http2Transport) void {\n"
   "        self.close();\n"
   "        if (self.reader_thread) |t| t.join();\n"
   "        self.decoder.deinit(self.alloc);\n"
   "        self.stream_windows.deinit();\n"
   "        var dit = self.data_buffers.valueIterator();\n"
   "        while (dit.next()) |v| v.deinit(self.alloc);\n"
   "        self.data_buffers.deinit();\n"
   "        var hit = self.header_blocks.valueIterator();\n"
   "        while (hit.next()) |v| v.deinit(self.alloc);\n"
   "        self.header_blocks.deinit();\n"
   "        self.headers_seen.deinit();\n"
   "        self.compress_out.deinit();\n"
   "        self.decompress_in.deinit();\n"
   "        for (self.queue.items) |item| self.alloc.free(item);\n"
   "        self.queue.deinit(self.alloc);\n"
   "        self.recv_buffer.deinit(self.alloc);\n"
   "        self.alloc.destroy(self);\n"
   "    }\n"
   "};\n"
   ))

(define (emit-zig-http2)
  (cons "http2_transport.zig"
        (string-replace
         (string-replace
          (string-replace zig-http2-body
                          "ZIG_STATIC_TABLE" (zig-static-table))
          "ZIG_HUFF_CODES" (zig-huff-codes))
         "ZIG_HUFF_LENS" (zig-huff-lens))))
