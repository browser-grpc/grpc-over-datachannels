   "    private static readonly int[] HuffLens = { CS_HUFF_LENS };\n"
   "    private static readonly Dictionary<long, int> HuffDecode = BuildHuffDecode();\n\n"
   "    private static Dictionary<long, int> BuildHuffDecode()\n"
   "    {\n"
   "        var map = new Dictionary<long, int>();\n"
