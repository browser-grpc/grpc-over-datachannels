   "        }\n"
   "        return out.toString();\n"
   "    }\n\n"
   "    static final class HpackDecoder {\n"
   "        final List<String[]> dynamic = new ArrayList<>();\n"
   "        int dynamicSize = 0;\n"
   "        static final int MAX_DYNAMIC = 4096;\n\n"
   "        String[] entry(int index) throws IOException {\n"
   "            if (index <= 0) {\n"
   "                throw new IOException(\"bad hpack index 0\");\n"
   "            }\n"
   "            if (index <= STATIC_TABLE.length) {\n"
   "                String[] e = STATIC_TABLE[index - 1];\n"
   "                return new String[]{e[0], e[1]};\n"
   "            }\n"
   "            int j = index - STATIC_TABLE.length - 1;\n"
   "            if (j >= dynamic.size()) {\n"
   "                throw new IOException(\"bad hpack dynamic index \" + index);\n"
   "            }\n"
   "            return dynamic.get(j);\n"
   "        }\n\n"
   "        void add(String name, String value) {\n"
   "            dynamic.add(0, new String[]{name, value});\n"
   "            dynamicSize += name.length() + value.length() + 32;\n"
   "            while (dynamicSize > MAX_DYNAMIC && !dynamic.isEmpty()) {\n"
   "                String[] e = dynamic.remove(dynamic.size() - 1);\n"
   "                dynamicSize -= e[0].length() + e[1].length() + 32;\n"
   "            }\n"
   "        }\n\n"
   "        static int[] readInt(byte[] data, int[] pos, int prefixBits) throws IOException {\n"
   "            int mask = (1 << prefixBits) - 1;\n"
   "            int value = data[pos[0]] & mask;\n"
   "            pos[0]++;\n"
   "            if (value < mask) {\n"
   "                return new int[]{value};\n"
   "            }\n"
   "            int shift = 0;\n"
   "            while (true) {\n"
   "                if (pos[0] >= data.length) {\n"
   "                    throw new IOException(\"truncated hpack int\");\n"
   "                }\n"
   "                int b = data[pos[0]] & 0xff;\n"
   "                pos[0]++;\n"
   "                value += (b & 0x7f) << shift;\n"
   "                shift += 7;\n"
   "                if ((b & 0x80) == 0) {\n"
   "                    break;\n"
   "                }\n"
   "            }\n"
   "            return new int[]{value};\n"
   "        }\n\n"
   "        static String readString(byte[] data, int[] pos) throws IOException {\n"
   "            if (pos[0] >= data.length) {\n"
   "                throw new IOException(\"truncated hpack string\");\n"
   "            }\n"
   "            boolean huffman = (data[pos[0]] & 0x80) != 0;\n"
   "            int len = readInt(data, pos, 7)[0];\n"
   "            if (pos[0] + len > data.length) {\n"
   "                throw new IOException(\"truncated hpack string body\");\n"
   "            }\n"
   "            String value = huffman\n"
   "                    ? huffDecode(data, pos[0], len)\n"
   "                    : new String(data, pos[0], len, StandardCharsets.UTF_8);\n"
   "            pos[0] += len;\n"
   "            return value;\n"
   "        }\n\n"
   "        List<String[]> decode(byte[] block) throws IOException {\n"
   "            List<String[]> out = new ArrayList<>();\n"
   "            int[] pos = {0};\n"
   "            while (pos[0] < block.length) {\n"
   "                int b = block[pos[0]] & 0xff;\n"
   "                if ((b & 0x80) != 0) {\n"
   "                    int index = readInt(block, pos, 7)[0];\n"
   "                    out.add(entry(index));\n"
   "                } else if ((b & 0xe0) == 0x20) {\n"
   "                    readInt(block, pos, 5);\n"
   "                } else {\n"
   "                    boolean incremental = (b & 0xc0) == 0x40;\n"
   "                    int index = readInt(block, pos, incremental ? 6 : 4)[0];\n"
   "                    String name = index > 0 ? entry(index)[0] : readString(block, pos);\n"
   "                    String value = readString(block, pos);\n"
   "                    out.add(new String[]{name, value});\n"
   "                    if (incremental) {\n"
   "                        add(name, value);\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            return out;\n"
   "        }\n"
   "    }\n\n"
   "    static void writeInt(ByteArrayOutputStream out, int value, int prefixBits, int prefix) {\n"
   "        int mask = (1 << prefixBits) - 1;\n"
   "        if (value < mask) {\n"
   "            out.write(prefix | value);\n"
   "            return;\n"
   "        }\n"
   "        out.write(prefix | mask);\n"
   "        value -= mask;\n"
   "        while (value >= 0x80) {\n"
   "            out.write((value & 0x7f) | 0x80);\n"
   "            value >>= 7;\n"
   "        }\n"
   "        out.write(value);\n"
   "    }\n\n"
   "    static void writeString(ByteArrayOutputStream out, String value) {\n"
   "        byte[] raw = value.getBytes(StandardCharsets.UTF_8);\n"
   "        writeInt(out, raw.length, 7, 0);\n"
   "        out.write(raw, 0, raw.length);\n"
   "    }\n\n"
   "    static void writeLiteralIndexedName(ByteArrayOutputStream out, int index, String value) {\n"
   "        writeInt(out, index, 4, 0);\n"
   "        writeString(out, value);\n"
   "    }\n\n"
   "    static void writeLiteralNewName(ByteArrayOutputStream out, String name, String value) {\n"
   "        writeInt(out, 0, 4, 0);\n"
   "        writeString(out, name);\n"
   "        writeString(out, value);\n"
   "    }\n\n"))

