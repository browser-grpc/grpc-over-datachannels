#lang racket

;;; http2-gen.rkt — generated HTTP/2 client transports.
;;;
;;; http2-spec.rkt is the single source for the protocol tables
;;; (RFC 9113 frame/settings/error ids, RFC 7541 HPACK static +
;;; Huffman tables). Each emitter below stamps one transport
;;; implementing the runtime's existing frame Transport interface,
;;; so generated stubs call official gRPC servers (grpc-java and
;;; peers) directly over HTTP/2 — no bridge process:
;;;
;;;   JS     js/src/http2.js        Http2DataChannel (dc-like
;;;                                 adapter over node:http2; the
;;;                                 session/HPACK/flow-control
;;;                                 layer is Node stdlib)
;;;   Python python/grpcdc/http2.py Http2Transport (manual
;;;                                 HPACK + session from tables)
;;;   Go     go/http2.go            Http2Transport (same manual
;;;                                 session, Go stdlib sockets)
;;;
;;; TLS is not generated: the byte stream is wrapped with the
;;; stdlib TLS of each language (ALPN "h2"); only the dial glue
;;; and verification policy are emitted here.

(require "http2-spec.rkt")
(provide emit-js-http2 emit-python-http2 emit-go-http2 emit-java-http2 emit-csharp-http2)

(define (code->number c)
  (cond [(number? c) c]
        [else (string->number (regexp-replace #rx"^0x" (symbol->string c) "#x"))]))

(define (hex n) (format "0x~x" (code->number n)))

;; ---------------------------------------------------------------------------
;; Python: python/grpcdc/http2.py
;; ---------------------------------------------------------------------------

(define (py-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "    (~s, ~s)," (car e) (cdr e)))
   "\n"))

(define (py-huffman-table)
  (define entries
    (for/list ([e (in-list http2-huffman-codes)])
      (format "(~a, ~a)" (hex (car e)) (cdr e))))
  (define lines
    (let loop ([xs entries] [acc '()])
      (cond [(null? xs) (reverse acc)]
            [else (loop (if (> (length xs) 8) (list-tail xs 8) '())
                        (cons (string-join (take xs (min 8 (length xs))) ", ") acc))])))
  (string-join (map (lambda (l) (string-append "    " l ",")) lines) "\n"))

(define (emit-python-http2)
  (cons
   "http2.py"
   (string-append
    "\"\"\"HTTP/2 client transport: call official gRPC servers directly.\n"
    "\n"
    "Http2Transport implements the grpcdc Transport contract (one\n"
    "Send/Recv is one grpc-dc frame) over a manual HTTP/2 session\n"
    "(RFC 9113 framing + RFC 7541 HPACK from generated tables).\n"
    "TLS, when requested, is Python ssl with ALPN h2 — the TLS\n"
    "protocol itself is stdlib, only the dial glue is generated.\n"
    "\"\"\"\n"
    "\n"
    "import gzip\n"
    "import json\n"
    "import queue\n"
    "import socket\n"
    "import ssl\n"
    "import struct\n"
    "import threading\n"
    "import urllib.parse\n"
    "\n"
    "from .wire_gen import (\n"
    "    FRAME_DATA,\n"
    "    FRAME_HALF_CLOSE,\n"
    "    FRAME_HEADERS,\n"
    "    FRAME_RST,\n"
    "    FRAME_TRAILERS,\n"
    ")\n"
    "\n"
    "H2_DATA = 0\n"
    "H2_HEADERS = 1\n"
    "H2_RST_STREAM = 3\n"
    "H2_SETTINGS = 4\n"
    "H2_PING = 6\n"
    "H2_GOAWAY = 7\n"
    "H2_WINDOW_UPDATE = 8\n"
    "H2_CONTINUATION = 9\n"
    "\n"
    "STATIC = [\n"
    (py-static-table)
    "\n]\n"
    "\n"
    "HUFF = [\n"
    (py-huffman-table)
    "\n]\n"
    "\n"
    "HUFF_DECODE = {(length, code): sym for sym, (code, length) in enumerate(HUFF)}\n"
    "\n"
    "\n"
    "def hpack_decode_int(data, pos, prefix_bits):\n"
    "    mask = (1 << prefix_bits) - 1\n"
    "    value = data[pos] & mask\n"
    "    pos += 1\n"
    "    if value < mask:\n"
    "        return value, pos\n"
    "    shift = 0\n"
    "    while True:\n"
    "        b = data[pos]\n"
    "        pos += 1\n"
    "        value += (b & 0x7F) << shift\n"
    "        shift += 7\n"
    "        if not (b & 0x80):\n"
    "            return value, pos\n"
    "\n"
    "\n"
    "def huffman_decode(data):\n"
    "    out = bytearray()\n"
    "    cur = 0\n"
    "    bits = 0\n"
    "    for byte in data:\n"
    "        for i in range(7, -1, -1):\n"
    "            cur = (cur << 1) | ((byte >> i) & 1)\n"
    "            bits += 1\n"
    "            sym = HUFF_DECODE.get((bits, cur))\n"
    "            if sym is not None:\n"
    "                if sym != 256:\n"
    "                    out.append(sym)\n"
    "                cur = 0\n"
    "                bits = 0\n"
    "    return bytes(out)\n"
    "\n"
    "\n"
    "def hpack_decode_string(data, pos):\n"
    "    huffman = bool(data[pos] & 0x80)\n"
    "    length, pos = hpack_decode_int(data, pos, 7)\n"
    "    raw = data[pos:pos + length]\n"
    "    decoded = huffman_decode(raw) if huffman else raw\n"
    "    return decoded.decode('utf-8', 'replace'), pos + length\n"
    "\n"
    "\n"
    "class HpackDecoder:\n"
    "    def __init__(self):\n"
    "        self.dynamic = []\n"
    "        self.dynamic_size = 0\n"
    "\n"
    "    def _entry(self, index):\n"
    "        if index <= len(STATIC):\n"
    "            return STATIC[index - 1]\n"
    "        return self.dynamic[index - len(STATIC) - 1]\n"
    "\n"
    "    def _add(self, name, value):\n"
    "        self.dynamic.insert(0, (name, value))\n"
    "        self.dynamic_size += len(name) + len(value) + 32\n"
    "        while self.dynamic_size > 4096 and self.dynamic:\n"
    "            n, v = self.dynamic.pop()\n"
    "            self.dynamic_size -= len(n) + len(v) + 32\n"
    "\n"
    "    def decode(self, data):\n"
    "        headers = []\n"
    "        pos = 0\n"
    "        while pos < len(data):\n"
    "            b = data[pos]\n"
    "            if b & 0x80:\n"
    "                index, pos = hpack_decode_int(data, pos, 7)\n"
    "                headers.append(self._entry(index))\n"
    "            elif b & 0xC0 == 0x40:\n"
    "                entry, pos = self._literal(data, pos, 6)\n"
    "                headers.append(entry)\n"
    "            elif b & 0xE0 == 0x20:\n"
    "                _size, pos = hpack_decode_int(data, pos, 5)\n"
    "            else:\n"
    "                entry, pos = self._literal(data, pos, 4)\n"
    "                headers.append(entry)\n"
    "        return headers\n"
    "\n"
    "    def _literal(self, data, pos, prefix):\n"
    "        index, pos = hpack_decode_int(data, pos, prefix)\n"
    "        if index == 0:\n"
    "            name, pos = hpack_decode_string(data, pos)\n"
    "        else:\n"
    "            name = self._entry(index)[0]\n"
    "        value, pos = hpack_decode_string(data, pos)\n"
    "        if prefix == 6:\n"
    "            self._add(name, value)\n"
    "        return (name, value), pos\n"
    "\n"
    "\n"
    "def hpack_encode_int(value, prefix_bits, prefix):\n"
    "    mask = (1 << prefix_bits) - 1\n"
    "    if value < mask:\n"
    "        return bytes([prefix | value])\n"
    "    out = bytearray([prefix | mask])\n"
    "    value -= mask\n"
    "    while value >= 128:\n"
    "        out.append((value % 128) + 128)\n"
    "        value //= 128\n"
    "    out.append(value)\n"
    "    return bytes(out)\n"
    "\n"
    "\n"
    "def hpack_encode_string(text):\n"
    "    raw = text.encode()\n"
    "    return hpack_encode_int(len(raw), 7, 0) + raw\n"
    "\n"
    "\n"
    "def hpack_literal(name_index, value):\n"
    "    if name_index:\n"
    "        return hpack_encode_int(name_index, 4, 0) + hpack_encode_string(value)\n"
    "    raise AssertionError('literal name handled by caller')\n"
    "\n"
    "\n"
    "def hpack_literal_new_name(name, value):\n"
    "    return b'\\x00' + hpack_encode_string(name) + hpack_encode_string(value)\n"
    "\n"
    "\n"
    "class Http2Transport:\n"
    "    \"\"\"Transport over one HTTP/2 connection to an official gRPC\n"
    "    server. authority is host or host:port (the :authority and\n"
    "    Host of the dial). use_tls wraps the socket with stdlib ssl\n"
    "    (ALPN h2, system trust store); server_name overrides SNI.\"\"\"\n"
    "\n"
    "    def __init__(self, authority, use_tls=False, server_name=None, cafile=None):\n"
    "        if ':' in authority:\n"
    "            host, port_text = authority.rsplit(':', 1)\n"
    "            port = int(port_text)\n"
    "        else:\n"
    "            host, port = authority, (443 if use_tls else 80)\n"
    "        self.authority = authority\n"
    "        raw = socket.create_connection((host, port))\n"
    "        if use_tls:\n"
    "            ctx = ssl.create_default_context(cafile=cafile)\n"
    "            ctx.set_alpn_protocols(['h2'])\n"
    "            raw = ctx.wrap_socket(raw, server_hostname=server_name or host)\n"
    "        self.sock = raw\n"
    "        self.send_lock = threading.Lock()\n"
    "        self.queue = queue.Queue()\n"
    "        self.decoder = HpackDecoder()\n"
    "        self.cond = threading.Condition()\n"
    "        self.conn_window = 65535\n"
    "        self.stream_windows = {}\n"
    "        self.peer_initial_window = 65535\n"
    "        self.data_buffers = {}\n"
    "        self.header_blocks = {}\n"
    "        self.headers_seen = set()\n"
    "        # Per-stream gzip state: requests compress when the\n"
    "        # call metadata carries grpc-encoding: gzip; responses\n"
    "        # decompress when the response headers do. Streams\n"
    "        # advertise gzip via grpc-accept-encoding.\n"
    "        self.compress_out = {}\n"
    "        self.decompress_in = set()\n"
    "        self.closed = False\n"
    "        raw.sendall(b'PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n')\n"
    "        self._send_frame(H2_SETTINGS, 0, 0, b'')\n"
    "        self.thread = threading.Thread(target=self._reader, daemon=True)\n"
    "        self.thread.start()\n"
    "\n"
    "    def _send_frame(self, ftype, stream_id, flags, payload):\n"
    "        header = struct.pack('>I', len(payload))[1:] + bytes([ftype, flags])\n"
    "        header += struct.pack('>I', stream_id & 0x7FFFFFFF)\n"
    "        with self.send_lock:\n"
    "            self.sock.sendall(header + payload)\n"
    "\n"
    "    def _reader(self):\n"
    "        buf = b''\n"
    "        try:\n"
    "            while True:\n"
    "                chunk = self.sock.recv(65536)\n"
    "                if not chunk:\n"
    "                    break\n"
    "                buf += chunk\n"
    "                while len(buf) >= 9:\n"
    "                    length = int.from_bytes(buf[0:3], 'big')\n"
    "                    if len(buf) < 9 + length:\n"
    "                        break\n"
    "                    ftype, flags = buf[3], buf[4]\n"
    "                    stream_id = int.from_bytes(buf[5:9], 'big') & 0x7FFFFFFF\n"
    "                    payload = buf[9:9 + length]\n"
    "                    buf = buf[9 + length:]\n"
    "                    self._on_frame(ftype, flags, stream_id, payload)\n"
    "        except OSError:\n"
    "            pass\n"
    "        self.closed = True\n"
    "        self.queue.put(None)\n"
    "\n"
    "    def _emit(self, frame_type, stream_id, payload):\n"
    "        frame = bytes([frame_type]) + struct.pack('>I', stream_id)\n"
    "        frame += struct.pack('>I', len(payload)) + payload\n"
    "        self.queue.put(frame)\n"
    "\n"
    "    def _on_frame(self, ftype, flags, stream_id, payload):\n"
    "        if ftype == H2_SETTINGS:\n"
    "            if flags & 0x1:\n"
    "                return\n"
    "            for i in range(0, len(payload) - 5, 6):\n"
    "                ident, value = struct.unpack('>HI', payload[i:i + 6])\n"
    "                if ident == 0x4:\n"
    "                    delta = value - self.peer_initial_window\n"
    "                    self.peer_initial_window = value\n"
    "                    with self.cond:\n"
    "                        for key in self.stream_windows:\n"
    "                            self.stream_windows[key] += delta\n"
    "                        self.cond.notify_all()\n"
    "            self._send_frame(H2_SETTINGS, 0, 0x1, b'')\n"
    "        elif ftype == H2_PING:\n"
    "            if not (flags & 0x1):\n"
    "                self._send_frame(H2_PING, 0, 0x1, payload)\n"
    "        elif ftype == H2_WINDOW_UPDATE:\n"
    "            increment = int.from_bytes(payload, 'big') & 0x7FFFFFFF\n"
    "            with self.cond:\n"
    "                if stream_id == 0:\n"
    "                    self.conn_window += increment\n"
    "                else:\n"
    "                    current = self.stream_windows.get(stream_id, self.peer_initial_window)\n"
    "                    self.stream_windows[stream_id] = current + increment\n"
    "                self.cond.notify_all()\n"
    "        elif ftype == H2_RST_STREAM:\n"
    "            body = json.dumps({'code': 8, 'message': 'rst stream'}).encode()\n"
    "            self._emit(FRAME_RST, stream_id, body)\n"
    "        elif ftype == H2_HEADERS or ftype == H2_CONTINUATION:\n"
    "            block = self.header_blocks.get(stream_id, b'') + payload\n"
    "            if not (flags & 0x4):\n"
    "                self.header_blocks[stream_id] = block\n"
    "                return\n"
    "            self.header_blocks.pop(stream_id, None)\n"
    "            self._on_headers(stream_id, bool(flags & 0x1), block)\n"
    "        elif ftype == H2_DATA:\n"
    "            buf = self.data_buffers.get(stream_id, b'') + payload\n"
    "            if payload:\n"
    "                self._send_frame(H2_WINDOW_UPDATE, 0, 0, struct.pack('>I', len(payload)))\n"
    "                self._send_frame(H2_WINDOW_UPDATE, stream_id, 0, struct.pack('>I', len(payload)))\n"
    "            while len(buf) >= 5:\n"
    "                msg_len = int.from_bytes(buf[1:5], 'big')\n"
    "                if len(buf) < 5 + msg_len:\n"
    "                    break\n"
    "                message = buf[5:5 + msg_len]\n"
    "                if buf[0] == 1 and stream_id in self.decompress_in:\n"
    "                    message = gzip.decompress(message)\n"
    "                self._emit(FRAME_DATA, stream_id, message)\n"
    "                buf = buf[5 + msg_len:]\n"
    "            self.data_buffers[stream_id] = buf\n"
    "            if flags & 0x1:\n"
    "                body = json.dumps({'code': 2, 'message': 'missing grpc-status'}).encode()\n"
    "                self._emit(FRAME_TRAILERS, stream_id, body)\n"
    "\n"
    "    def _on_headers(self, stream_id, end_stream, block):\n"
    "        headers = dict(self.decoder.decode(block))\n"
    "        if headers.get('grpc-encoding') == 'gzip':\n"
    "            self.decompress_in.add(stream_id)\n"
    "        status = headers.get('grpc-status')\n"
    "        # Response metadata: transport keys drop out; -bin values\n"
    "        # are base64 in both the HPACK and JSON domains.\n"
    "        metadata = {k: v for k, v in headers.items()\n"
    "                    if not k.startswith(':')\n"
    "                    and k not in ('content-type', 'grpc-status', 'grpc-message', 'grpc-encoding', 'grpc-accept-encoding')}\n"
    "        if end_stream and status is not None:\n"
    "            message = urllib.parse.unquote(headers.get('grpc-message', ''))\n"
    "            body = json.dumps({'code': int(status), 'message': message, 'metadata': metadata}).encode()\n"
    "            self._emit(FRAME_TRAILERS, stream_id, body)\n"
    "        elif stream_id not in self.headers_seen:\n"
    "            self.headers_seen.add(stream_id)\n"
    "            body = json.dumps({'metadata': metadata}).encode()\n"
    "            self._emit(FRAME_HEADERS, stream_id, body)\n"
    "            if end_stream:\n"
    "                body = json.dumps({'code': 2, 'message': 'missing grpc-status'}).encode()\n"
    "                self._emit(FRAME_TRAILERS, stream_id, body)\n"
    "        else:\n"
    "            message = urllib.parse.unquote(headers.get('grpc-message', ''))\n"
    "            code = int(status) if status is not None else 2\n"
    "            body = json.dumps({'code': code, 'message': message, 'metadata': metadata}).encode()\n"
    "            self._emit(FRAME_TRAILERS, stream_id, body)\n"
    "\n"
    "    def send(self, data):\n"
    "        frame_type = data[0]\n"
    "        stream_id = int.from_bytes(data[1:5], 'big')\n"
    "        payload = data[9:]\n"
    "        if frame_type == FRAME_HEADERS:\n"
    "            head = json.loads(payload)\n"
    "            fields = [\n"
    "                (':method', 'POST'), (':scheme', 'http'),\n"
    "                (':path', head['path']), (':authority', self.authority),\n"
    "                ('content-type', 'application/grpc'), ('te', 'trailers'),\n"
    "                ('grpc-accept-encoding', 'gzip,identity'),\n"
    "            ]\n"
    "            metadata = head.get('metadata') or {}\n"
    "            self.compress_out[stream_id] = metadata.get('grpc-encoding') == 'gzip'\n"
    "            for key, value in metadata.items():\n"
    "                fields.append((key.lower(), str(value)))\n"
    "            block = b''\n"
    "            for name, value in fields:\n"
    "                if name == ':method':\n"
    "                    block += bytes([0x83])\n"
    "                elif name == ':scheme':\n"
    "                    block += bytes([0x86])\n"
    "                elif name == ':path':\n"
    "                    block += hpack_literal(4, value)\n"
    "                else:\n"
    "                    block += hpack_literal_new_name(name, value)\n"
    "            with self.cond:\n"
    "                self.stream_windows.setdefault(stream_id, self.peer_initial_window)\n"
    "            self._send_frame(H2_HEADERS, stream_id, 0x4, block)\n"
    "        elif frame_type == FRAME_DATA:\n"
    "            if self.compress_out.get(stream_id):\n"
    "                payload = gzip.compress(payload)\n"
    "                lpm = b'\\x01' + struct.pack('>I', len(payload)) + payload\n"
    "            else:\n"
    "                lpm = b'\\x00' + struct.pack('>I', len(payload)) + payload\n"
    "            offset = 0\n"
    "            while offset < len(lpm):\n"
    "                with self.cond:\n"
    "                    while (self.conn_window <= 0\n"
    "                           or self.stream_windows.get(stream_id, self.peer_initial_window) <= 0):\n"
    "                        self.cond.wait()\n"
    "                    allowance = min(self.conn_window,\n"
    "                                    self.stream_windows.get(stream_id, self.peer_initial_window),\n"
    "                                    16384, len(lpm) - offset)\n"
    "                chunk = lpm[offset:offset + allowance]\n"
    "                offset += allowance\n"
    "                with self.cond:\n"
    "                    self.conn_window -= allowance\n"
    "                    current = self.stream_windows.get(stream_id, self.peer_initial_window)\n"
    "                    self.stream_windows[stream_id] = current - allowance\n"
    "                self._send_frame(H2_DATA, stream_id, 0, chunk)\n"
    "        elif frame_type == FRAME_HALF_CLOSE:\n"
    "            self._send_frame(H2_DATA, stream_id, 0x1, b'')\n"
    "        elif frame_type == FRAME_RST:\n"
    "            self._send_frame(H2_RST_STREAM, stream_id, 0, struct.pack('>I', 8))\n"
    "\n"
    "    def recv(self):\n"
    "        frame = self.queue.get()\n"
    "        if frame is None:\n"
    "            raise EOFError('http2 transport closed')\n"
    "        return frame\n"
    "\n"
    "    def close(self):\n"
    "        try:\n"
    "            self.sock.close()\n"
    "        except OSError:\n"
    "            pass\n")))

;; ---------------------------------------------------------------------------
;; JavaScript: js/src/http2.js (adapter over node:http2)
;; ---------------------------------------------------------------------------

(define (emit-js-http2)
  (cons
   "http2.js"
   (string-append
    "// HTTP/2 client transport: call official gRPC servers directly.\n"
    "//\n"
    "// Http2DataChannel is a DataChannel-like adapter over a\n"
    "// node:http2 client session: Endpoint/Channel above it speak\n"
    "// grpc-dc frames; each frame is translated to HTTP/2 streams\n"
    "// and back. The session layer (HPACK, flow control) is Node\n"
    "// stdlib; TLS comes from node:http2 connect options (ALPN h2)\n"
    "// — only the dial glue is generated. Node only: browsers keep\n"
    "// using WebRTC DataChannels.\n"
    "\n"
    "import http2 from \"node:http2\";\n"
    "import zlib from \"node:zlib\";\n"
    "import { decodeFrame, encodeFrame, FrameType } from \"./codec.js\";\n"
    "import { parseHeaders } from \"./codec.js\";\n"
    "import { Channel } from \"./channel.js\";\n"
    "\n"
    "export class Http2DataChannel {\n"
    "  #listeners = new Map();\n"
    "  #streams = new Map();\n"
    "  #buffers = new Map();\n"
    "  // Per-stream gzip state: requests compress when the call\n"
    "  // metadata carries grpc-encoding: gzip; responses decompress\n"
    "  // when the response headers do. Every stream advertises\n"
    "  // gzip in grpc-accept-encoding, and per-message compression\n"
    "  // still follows the LPM compressed flag.\n"
    "  #compressOut = new Map();\n"
    "  #decompressIn = new Map();\n"
    "\n"
    "  constructor(authority, { secure = false, ...connectOptions } = {}) {\n"
    "    this.readyState = \"open\";\n"
    "    this.bufferedAmount = 0;\n"
    "    const url = `${secure ? \"https\" : \"http\"}://${authority}`;\n"
    "    this.session = http2.connect(url, connectOptions);\n"
    "    this.session.on(\"error\", () => {});\n"
    "  }\n"
    "\n"
    "  addEventListener(name, fn) {\n"
    "    if (!this.#listeners.has(name)) this.#listeners.set(name, []);\n"
    "    this.#listeners.get(name).push(fn);\n"
    "  }\n"
    "\n"
    "  #emit(bytes) {\n"
    "    const data = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);\n"
    "    for (const fn of this.#listeners.get(\"message\") ?? []) fn({ data });\n"
    "  }\n"
    "\n"
    "  #emitFrame(type, streamId, payloadText) {\n"
    "    this.#emit(encodeFrame(type, streamId, new TextEncoder().encode(payloadText)));\n"
    "  }\n"
    "\n"
    "  send(frameBytes) {\n"
    "    const frame = decodeFrame(frameBytes);\n"
    "    const id = frame.streamId;\n"
    "    // HTTP/2 header block -> grpc-dc metadata: transport keys\n"
    "    // drop out. -bin values are base64 in both domains (the\n"
    "    // gRPC HTTP/2 spec base64s them; so does the JSON wire).\n"
    "    const toDcMetadata = (headers) => {\n"
    "      const meta = {};\n"
    "      for (const [k, v] of Object.entries(headers)) {\n"
    "        if (k.startsWith(\":\") || typeof v !== \"string\") continue;\n"
    "        if ([\"content-type\", \"grpc-status\", \"grpc-message\", \"grpc-encoding\", \"grpc-accept-encoding\"].includes(k)) continue;\n"
    "        meta[k] = v;\n"
    "      }\n"
    "      return meta;\n"
    "    };\n"
    "    if (frame.type === FrameType.HEADERS) {\n"
    "      const head = parseHeaders(frame.payload);\n"
    "      const metadata = {};\n"
    "      for (const [k, v] of Object.entries(head.metadata ?? {})) metadata[k.toLowerCase()] = v;\n"
    "      const stream = this.session.request({\n"
    "        \":path\": head.path,\n"
    "        \":method\": \"POST\",\n"
    "        \"content-type\": \"application/grpc\",\n"
    "        te: \"trailers\",\n"
    "        \"grpc-accept-encoding\": \"gzip,identity\",\n"
    "        ...metadata,\n"
    "      });\n"
    "      this.#streams.set(id, stream);\n"
    "      this.#buffers.set(id, Buffer.alloc(0));\n"
    "      this.#compressOut.set(id, metadata[\"grpc-encoding\"] === \"gzip\");\n"
    "      stream.on(\"response\", (headers, flags) => {\n"
    "        this.#decompressIn.set(id, headers[\"grpc-encoding\"] === \"gzip\");\n"
    "        const trailersOnly =\n"
    "          (flags & http2.constants.NGHTTP2_FLAG_END_STREAM) !== 0 && headers[\"grpc-status\"] !== undefined;\n"
    "        if (trailersOnly) {\n"
    "          this.#emitFrame(FrameType.TRAILERS, id, JSON.stringify({\n"
    "            code: Number(headers[\"grpc-status\"]),\n"
    "            message: decodeURIComponent(headers[\"grpc-message\"] ?? \"\"),\n"
    "            metadata: toDcMetadata(headers),\n"
    "          }));\n"
    "        } else {\n"
    "          this.#emitFrame(FrameType.HEADERS, id, JSON.stringify({ metadata: toDcMetadata(headers) }));\n"
    "        }\n"
    "      });\n"
    "      stream.on(\"trailers\", (headers) => {\n"
    "        this.#emitFrame(FrameType.TRAILERS, id, JSON.stringify({\n"
    "          code: Number(headers[\"grpc-status\"] ?? 2),\n"
    "          message: decodeURIComponent(headers[\"grpc-message\"] ?? \"\"),\n"
    "          metadata: toDcMetadata(headers),\n"
    "        }));\n"
    "      });\n"
    "      stream.on(\"data\", (chunk) => {\n"
    "        let buf = Buffer.concat([this.#buffers.get(id), chunk]);\n"
    "        while (buf.length >= 5) {\n"
    "          const len = buf.readUInt32BE(1);\n"
    "          if (buf.length < 5 + len) break;\n"
    "          let payload = buf.subarray(5, 5 + len);\n"
    "          if (buf[0] === 1 && this.#decompressIn.get(id)) {\n"
    "            try {\n"
    "              payload = zlib.gunzipSync(payload);\n"
    "            } catch {\n"
    "              stream.close(http2.constants.NGHTTP2_CANCEL);\n"
    "              this.#emitFrame(FrameType.RST, id, JSON.stringify({ code: 3, message: \"gzip decompression failed\" }));\n"
    "              return;\n"
    "            }\n"
    "          }\n"
    "          this.#emit(encodeFrame(FrameType.DATA, id, new Uint8Array(payload)));\n"
    "          buf = buf.subarray(5 + len);\n"
    "        }\n"
    "        this.#buffers.set(id, buf);\n"
    "      });\n"
    "      stream.on(\"error\", () => {\n"
    "        this.#emitFrame(FrameType.RST, id, JSON.stringify({ code: 8, message: \"h2 stream error\" }));\n"
    "      });\n"
    "    } else if (frame.type === FrameType.DATA) {\n"
    "      const stream = this.#streams.get(id);\n"
    "      if (stream) {\n"
    "        let payload = frame.payload;\n"
    "        let flag = 0;\n"
    "        if (this.#compressOut.get(id)) {\n"
    "          payload = zlib.gzipSync(payload);\n"
    "          flag = 1;\n"
    "        }\n"
    "        const lpm = Buffer.alloc(5 + payload.length);\n"
    "        lpm[0] = flag;\n"
    "        lpm.writeUInt32BE(payload.length, 1);\n"
    "        Buffer.from(payload).copy(lpm, 5);\n"
    "        stream.write(lpm);\n"
    "      }\n"
    "    } else if (frame.type === FrameType.HALF_CLOSE) {\n"
    "      this.#streams.get(id)?.end();\n"
    "    } else if (frame.type === FrameType.RST) {\n"
    "      this.#streams.get(id)?.close(http2.constants.NGHTTP2_CANCEL);\n"
    "    }\n"
    "  }\n"
    "\n"
    "  close() {\n"
    "    this.session.close();\n"
    "  }\n"
    "}\n"
    "\n"
    "/** Channel over HTTP/2 to an official gRPC server. */\n"
    "export function http2Channel(authority, options) {\n"
    "  return new Channel(new Http2DataChannel(authority, options));\n"
    "}\n")))




