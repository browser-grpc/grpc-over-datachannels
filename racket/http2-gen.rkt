(define (java-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "{~s, ~s}," (car e) (cdr e)))
   "\n        "))

(define (java-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (java-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define java-http2-part1
  (string-append
   "package grpcdc;\n\n"
   "import java.io.ByteArrayInputStream;\n"
   "import java.io.ByteArrayOutputStream;\n"
   "import java.io.DataInputStream;\n"
   "import java.io.EOFException;\n"
   "import java.io.IOException;\n"
   "import java.io.InputStream;\n"
   "import java.io.OutputStream;\n"
   "import java.net.Socket;\n"
   "import java.nio.charset.StandardCharsets;\n"
   "import java.util.ArrayList;\n"
   "import java.util.Arrays;\n"
   "import java.util.HashMap;\n"
   "import java.util.HashSet;\n"
   "import java.util.LinkedHashMap;\n"
   "import java.util.List;\n"
   "import java.util.Map;\n"
   "import java.util.Set;\n"
   "import java.util.concurrent.LinkedBlockingQueue;\n"
   "import java.util.zip.GZIPInputStream;\n"
   "import java.util.zip.GZIPOutputStream;\n"
   "import javax.net.ssl.SSLContext;\n"
   "import javax.net.ssl.SSLParameters;\n"
   "import javax.net.ssl.SSLSocket;\n"
   "import javax.net.ssl.SSLSocketFactory;\n\n"
   "/**\n"
   " * Cleartext/TLS HTTP/2 frame transport (RFC 9113, generated from\n"
   " * http2-spec.rkt) over a TCP socket. The mirror image of\n"
   " * oracle/bridge.mjs: a generated client can dial a stock gRPC\n"
   " * server directly (grpc-java server, grpc-go server), and a\n"
   " * front-end can terminate HTTP/2 for a generated server. TLS\n"
   " * via dialTls (ALPN h2). HTTP/2 server endpoints must enable\n"
   " * cleartext h2c upgrades / prior knowledge (stock servers do\n"
   " * not all listen plain HTTP/2; tests use the Java/Go greeters).\n"
   " * Client endpoints only.\n"
   " */\n"
   "public final class Http2Transport implements Transport {\n"
   "    static final int H2_DATA = 0x0;\n"
   "    static final int H2_HEADERS = 0x1;\n"
   "    static final int H2_RST_STREAM = 0x3;\n"
   "    static final int H2_SETTINGS = 0x4;\n"
   "    static final int H2_PING = 0x6;\n"
   "    static final int H2_GOAWAY = 0x7;\n"
   "    static final int H2_WINDOW_UPDATE = 0x8;\n"
   "    static final int H2_CONTINUATION = 0x9;\n"
   "    static final int FLAG_END_STREAM = 0x1;\n"
   "    static final int FLAG_END_HEADERS = 0x4;\n"
   "    static final int FLAG_ACK = 0x1;\n"
   "    static final int FLAG_PADDED = 0x8;\n"
   "    static final int FLAG_PRIORITY = 0x20;\n"
   "    static final int MAX_FRAME_PAYLOAD = 16384;\n\n"
   "    private static final String[][] STATIC_TABLE = {\n        JAVA_STATIC_TABLE\n    };\n\n"
   "    private static final int[] HUFF_CODES = {JAVA_HUFF_CODES};\n"
   "    private static final int[] HUFF_LENS = {JAVA_HUFF_LENS};\n"
   "    private static final Map<Long, Integer> HUFF_DECODE = new HashMap<>();\n\n"
   "    static {\n"
   "        for (int sym = 0; sym < HUFF_CODES.length; sym++) {\n"
   "            HUFF_DECODE.put(((long) HUFF_LENS[sym] << 32) | (HUFF_CODES[sym] & 0xffffffffL), sym);\n"
   "        }\n"
   "    }\n\n"
   "    static String huffDecode(byte[] data, int off, int len) throws IOException {\n"
   "        StringBuilder out = new StringBuilder();\n"
   "        long code = 0;\n"
   "        int bits = 0;\n"
   "        for (int i = 0; i < len; i++) {\n"
   "            int b = data[off + i] & 0xff;\n"
   "            for (int j = 7; j >= 0; j--) {\n"
   "                code = (code << 1) | ((b >> j) & 1);\n"
   "                bits++;\n"
   "                Integer sym = HUFF_DECODE.get(((long) bits << 32) | code);\n"
   "                if (sym != null) {\n"
   "                    if (sym == 256) {\n"
   "                        throw new IOException(\"huffman EOS symbol\");\n"
   "                    }\n"
   "                    out.append((char) sym.intValue());\n"
   "                    code = 0;\n"
   "                    bits = 0;\n"
   "                } else if (bits > 30) {\n"
   "                    throw new IOException(\"huffman code too long\");\n"
   "                }\n"
