   "        queue.Close()\n"
   "    }\n"
   "\n"
   "    private func MarkClosed() {\n"
   "        cond.lock()\n"
   "        closedFlag = true\n"
   "        cond.broadcast()\n"
   "        cond.unlock()\n"
   "    }\n"
   "\n"
   "    private func OnFrame(_ type: Int, _ flags: Int, _ streamId: UInt32, _ payload: [UInt8]) -> Bool {\n"
   "        switch type {\n"
   "        case Http2Transport.H2Settings:\n"
