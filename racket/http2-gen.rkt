   "            }\n"
   "            queue.CompleteAdding();\n"
   "        }\n"
   "    }\n\n"))

(define cs-http2-part3
  (string-append
   "    private void OnFrame(int type, int flags, uint streamId, byte[] payload)\n"
   "    {\n"
   "        switch (type)\n"
   "        {\n"
   "            case H2Settings:\n"
   "            {\n"
   "                if ((flags & FlagAck) != 0)\n"
   "                {\n"
   "                    break;\n"
   "                }\n"
   "                long newInitial = peerInitialWindow;\n"
   "                for (int off = 0; off + 6 <= payload.Length; off += 6)\n"
   "                {\n"
   "                    int ident = (payload[off] << 8) | payload[off + 1];\n"
   "                    long value = ((long)payload[off + 2] << 24) | ((long)payload[off + 3] << 16)\n"
   "                        | ((long)payload[off + 4] << 8) | (uint)payload[off + 5];\n"
   "                    if (ident == 0x3)\n"
   "                    {\n"
   "                        newInitial = value;\n"
   "                    }\n"
   "                }\n"
   "                long delta = newInitial - peerInitialWindow;\n"
   "                peerInitialWindow = newInitial;\n"
   "                if (delta != 0)\n"
   "                {\n"
   "                    lock (cond)\n"
   "                    {\n"
   "                        foreach (uint key in new List<uint>(streamWindows.Keys))\n"
   "                        {\n"
   "                            streamWindows[key] += delta;\n"
   "                        }\n"
   "                        Monitor.PulseAll(cond);\n"
   "                    }\n"
   "                }\n"
   "                WriteFrame(H2Settings, FlagAck, 0, Array.Empty<byte>());\n"
   "                break;\n"
   "            }\n"
   "            case H2WindowUpdate:\n"
   "            {\n"
   "                if (payload.Length >= 4)\n"
   "                {\n"
   "                    long inc = ((long)(payload[0] & 0x7f) << 24) | ((long)payload[1] << 16)\n"
   "                        | ((long)payload[2] << 8) | (uint)payload[3];\n"
   "                    lock (cond)\n"
   "                    {\n"
   "                        if (streamId == 0)\n"
   "                        {\n"
   "                            connWindow += inc;\n"
   "                        }\n"
   "                        else\n"
   "                        {\n"
   "                            streamWindows[streamId] = streamWindows.GetValueOrDefault(streamId) + inc;\n"
   "                        }\n"
   "                        Monitor.PulseAll(cond);\n"
   "                    }\n"
   "                }\n"
   "                break;\n"
   "            }\n"
   "            case H2Ping:\n"
   "                if ((flags & FlagAck) == 0 && payload.Length == 8)\n"
   "                {\n"
   "                    WriteFrame(H2Ping, FlagAck, 0, payload);\n"
   "                }\n"
   "                break;\n"
   "            case H2RstStream:\n"
   "                queue.Add(Codec.StatusFrame(Wire.FrameRst, streamId, new StatusException(8, \"rst stream\")));\n"
   "                break;\n"
   "            case H2Headers:\n"
   "            case H2Continuation:\n"
   "            {\n"
   "                if (!headerBlocks.TryGetValue(streamId, out MemoryStream block))\n"
   "                {\n"
   "                    block = new MemoryStream();\n"
   "                    headerBlocks[streamId] = block;\n"
   "                }\n"
   "                block.Write(payload, 0, payload.Length);\n"
   "                if ((flags & FlagEndHeaders) != 0)\n"
   "                {\n"
   "                    headerBlocks.Remove(streamId);\n"
   "                    OnHeaders(streamId, (flags & FlagEndStream) != 0, block.ToArray());\n"
   "                }\n"
   "                break;\n"
   "            }\n"
   "            case H2Data:\n"
   "            {\n"
   "                byte[] body = payload;\n"
   "                if ((flags & FlagPadded) != 0 && body.Length >= 1)\n"
   "                {\n"
   "                    int pad = body[0];\n"
   "                    body = pad + 1 <= body.Length ? body[1..(body.Length - pad)] : Array.Empty<byte>();\n"
   "                }\n"
   "                if (body.Length > 0)\n"
   "                {\n"
   "                    WriteFrame(H2WindowUpdate, 0, 0, WindowUpdateBytes(body.Length));\n"
   "                    WriteFrame(H2WindowUpdate, 0, streamId, WindowUpdateBytes(body.Length));\n"
   "                    if (!dataBuffers.TryGetValue(streamId, out MemoryStream buf))\n"
   "                    {\n"
   "                        buf = new MemoryStream();\n"
   "                        dataBuffers[streamId] = buf;\n"
   "                    }\n"
   "                    buf.Write(body, 0, body.Length);\n"
   "                    DrainMessages(streamId);\n"
   "                }\n"
   "                if ((flags & FlagEndStream) != 0)\n"
   "                {\n"
   "                    EmitTrailersFrame(streamId, 2, \"missing grpc-status\", null);\n"
   "                }\n"
   "                break;\n"
   "            }\n"
   "            default:\n"
   "                // GOAWAY and unknown frames: nothing to do.\n"
   "                break;\n"
   "        }\n"
   "    }\n\n"
   "    private static byte[] WindowUpdateBytes(int increment)\n"
   "    {\n"
   "        return new[]\n"
   "        {\n"
   "            (byte)((increment >> 24) & 0x7f), (byte)(increment >> 16),\n"
   "            (byte)(increment >> 8), (byte)increment,\n"
   "        };\n"
   "    }\n\n"
   "    private void OnHeaders(uint streamId, bool endStream, byte[] block)\n"
   "    {\n"
   "        List<(string, string)> headers = decoder.Decode(block);\n"
   "        var metadata = new Dictionary<string, string>();\n"
   "        string status = null;\n"
   "        string message = null;\n"
   "        foreach ((string name, string value) in headers)\n"
   "        {\n"
   "            if (name == \"grpc-status\")\n"
   "            {\n"
   "                status = value;\n"
   "            }\n"
   "            else if (name == \"grpc-message\")\n"
   "            {\n"
   "                message = value;\n"
   "            }\n"
   "            else if (name == \"grpc-encoding\")\n"
   "            {\n"
   "                if (value == \"gzip\")\n"
   "                {\n"
   "                    decompressIn.Add(streamId);\n"
   "                }\n"
   "            }\n"
   "            else if (name.StartsWith(\":\") || name == \"content-type\" || name == \"grpc-accept-encoding\")\n"
   "            {\n"
   "                // transport-owned: not metadata\n"
   "            }\n"
   "            else if (!metadata.ContainsKey(name))\n"
   "            {\n"
   "                metadata[name] = value;\n"
   "            }\n"
   "        }\n"
   "        bool first = headersSeen.Add(streamId);\n"
   "        if (endStream && status != null)\n"
   "        {\n"
   "            EmitTrailersFrame(streamId, long.Parse(status),\n"
   "                Uri.UnescapeDataString(message ?? \"\"), metadata);\n"
   "        }\n"
   "        else if (first)\n"
   "        {\n"
   "            EmitHeadersFrame(streamId, metadata);\n"
   "            if (endStream)\n"
   "            {\n"
   "                EmitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata);\n"
   "            }\n"
   "        }\n"
   "        else if (endStream)\n"
   "        {\n"
   "            EmitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata);\n"
   "        }\n"
   "    }\n\n"
   "    private void DrainMessages(uint streamId)\n"
   "    {\n"
   "        MemoryStream buf = dataBuffers[streamId];\n"
   "        byte[] data = buf.ToArray();\n"
   "        int off = 0;\n"
   "        while (data.Length - off >= 5)\n"
   "        {\n"
   "            long mlen = ((long)data[off + 1] << 24) | ((long)data[off + 2] << 16)\n"
   "                | ((long)data[off + 3] << 8) | (uint)data[off + 4];\n"
   "            if (data.Length - off - 5 < mlen)\n"
   "            {\n"
   "                break;\n"
   "            }\n"
   "            int compressed = data[off];\n"
   "            byte[] message = data[(off + 5)..(off + 5 + (int)mlen)];\n"
   "            off += 5 + (int)mlen;\n"
   "            if (compressed == 1 || decompressIn.Contains(streamId))\n"
   "            {\n"
   "                message = Gunzip(message);\n"
   "            }\n"
   "            Emit(Wire.FrameData, streamId, message);\n"
   "        }\n"
   "        buf.SetLength(0);\n"
   "        buf.Write(data, off, data.Length - off);\n"
   "    }\n\n"
   "    private static byte[] Gunzip(byte[] data)\n"
   "    {\n"
   "        using var input = new MemoryStream(data);\n"
   "        using var gz = new GZipStream(input, CompressionMode.Decompress);\n"
   "        using var output = new MemoryStream();\n"
   "        gz.CopyTo(output);\n"
   "        return output.ToArray();\n"
   "    }\n\n"
   "    private static byte[] Gzip(byte[] data)\n"
   "    {\n"
   "        using var output = new MemoryStream();\n"
   "        using (var gz = new GZipStream(output, CompressionMode.Compress))\n"
   "        {\n"
   "            gz.Write(data, 0, data.Length);\n"
   "        }\n"
   "        return output.ToArray();\n"
   "    }\n\n"))

(define cs-http2-part4
  (string-append
   "    public void Send(byte[] message)\n"
   "    {\n"
   "        if (message.Length < 9)\n"
   "        {\n"
   "            throw new InvalidOperationException(\"short frame\");\n"
   "        }\n"
   "        int type = message[0];\n"
   "        uint streamId = (uint)((message[1] << 24) | (message[2] << 16) | (message[3] << 8) | message[4]);\n"
   "        int flen = (message[5] << 24) | (message[6] << 16) | (message[7] << 8) | message[8];\n"
   "        byte[] payload = message[9..(9 + flen)];\n"
   "        switch (type)\n"
   "        {\n"
   "            case Wire.FrameHeaders:\n"
   "            {\n"
   "                Codec.Headers headers = Codec.ParseHeaders(payload);\n"
   "                string path = headers.Path ?? \"\";\n"
   "                Dictionary<string, string> metadata = headers.Metadata;\n"
   "                lock (cond)\n"
   "                {\n"
   "                    streamWindows.TryAdd(streamId, peerInitialWindow);\n"
   "                }\n"
   "                if (metadata.TryGetValue(\"grpc-encoding\", out string enc) && enc == \"gzip\")\n"
   "                {\n"
   "                    compressOut[streamId] = true;\n"
   "                }\n"
   "                var block = new MemoryStream();\n"
   "                block.WriteByte(0x83); // :method: POST\n"
   "                block.WriteByte((byte)(scheme == \"https\" ? 0x87 : 0x86)); // :scheme\n"
   "                WriteLiteralIndexedName(block, 4, path); // :path\n"
   "                WriteLiteralIndexedName(block, 1, authority); // :authority\n"
   "                WriteLiteralIndexedName(block, 31, \"application/grpc\"); // content-type\n"
   "                WriteLiteralNewName(block, \"grpc-accept-encoding\", \"gzip,identity\");\n"
   "                WriteLiteralNewName(block, \"te\", \"trailers\");\n"
   "                foreach (KeyValuePair<string, string> e in metadata)\n"
   "                {\n"
   "                    string key = e.Key.ToLowerInvariant();\n"
   "                    WriteLiteralNewName(block, key, key == \"grpc-encoding\" ? \"gzip\" : e.Value);\n"
   "                }\n"
   "                WriteFrame(H2Headers, FlagEndHeaders, streamId, block.ToArray());\n"
   "                break;\n"
   "            }\n"
   "            case Wire.FrameData:\n"
   "            {\n"
   "                bool compressed = compressOut.GetValueOrDefault(streamId);\n"
   "                byte[] body = compressed ? Gzip(payload) : payload;\n"
   "                byte[] wire = new byte[5 + body.Length];\n"
   "                wire[0] = (byte)(compressed ? 1 : 0);\n"
   "                wire[1] = (byte)(body.Length >> 24);\n"
   "                wire[2] = (byte)(body.Length >> 16);\n"
   "                wire[3] = (byte)(body.Length >> 8);\n"
   "                wire[4] = (byte)body.Length;\n"
   "                Array.Copy(body, 0, wire, 5, body.Length);\n"
   "                int sent = 0;\n"
   "                while (sent < wire.Length)\n"
   "                {\n"
   "                    int allowance;\n"
   "                    lock (cond)\n"
   "                    {\n"
   "                        while (!closed && (connWindow <= 0\n"
   "                            || streamWindows.GetValueOrDefault(streamId, peerInitialWindow) <= 0))\n"
   "                        {\n"
   "                            Monitor.Wait(cond);\n"
   "                        }\n"
   "                        if (closed)\n"
   "                        {\n"
   "                            throw new IOException(\"transport closed\");\n"
   "                        }\n"
   "                        long sw = streamWindows.GetValueOrDefault(streamId, peerInitialWindow);\n"
   "                        allowance = (int)Math.Min(Math.Min(connWindow, sw),\n"
   "                            Math.Min(MaxFramePayload, wire.Length - sent));\n"
   "                        connWindow -= allowance;\n"
   "                        streamWindows[streamId] = sw - allowance;\n"
   "                    }\n"
   "                    WriteFrame(H2Data, 0, streamId, wire[sent..(sent + allowance)]);\n"
   "                    sent += allowance;\n"
   "                }\n"
   "                break;\n"
   "            }\n"
   "            case Wire.FrameHalfClose:\n"
   "                WriteFrame(H2Data, FlagEndStream, streamId, Array.Empty<byte>());\n"
   "                break;\n"
   "            case Wire.FrameRst:\n"
   "                WriteFrame(H2RstStream, 0, streamId, new byte[] { 0, 0, 0, 8 });\n"
   "                break;\n"
   "            default:\n"
   "                // Trailers never travel client -> server here.\n"
   "                break;\n"
   "        }\n"
   "    }\n\n"
   "    public byte[] Recv()\n"
   "    {\n"
   "        if (queue.TryTake(out byte[] msg, Timeout.Infinite))\n"
   "        {\n"
   "            return msg;\n"
   "        }\n"
   "        throw new EndOfStreamException(\"transport closed\");\n"
   "    }\n\n"
   "    public void Close()\n"
   "    {\n"
   "        try\n"
   "        {\n"
   "            socket.Close();\n"
   "        }\n"
   "        catch (Exception)\n"
   "        {\n"
   "            // already closed\n"
   "        }\n"
   "    }\n"
   "}\n"))

(define (emit-csharp-http2)
  (cons "Http2Transport.cs"
        (string-replace
         (string-replace
          (string-replace (string-append cs-http2-part1 cs-http2-part2 cs-http2-part3 cs-http2-part4)
                          "CS_STATIC_TABLE" (cs-static-table))
          "CS_HUFF_CODES" (cs-huff-codes))
         "CS_HUFF_LENS" (cs-huff-lens))))
