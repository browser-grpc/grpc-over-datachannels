(define (go-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "{~s, ~s}," (car e) (cdr e)))
   " "))

(define (go-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (go-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define go-http2-part1
  (string-append
   "package grpcdc\n"
   "\n"
   "import (\n"
   "\t\"bytes\"\n"
   "\t\"compress/gzip\"\n"
   "\t\"crypto/tls\"\n"
   "\t\"encoding/binary\"\n"
   "\t\"encoding/json\"\n"
   "\t\"errors\"\n"
   "\t\"fmt\"\n"
   "\t\"io\"\n"
   "\t\"net\"\n"
   "\t\"net/url\"\n"
   "\t\"sort\"\n"
   "\t\"strconv\"\n"
   "\t\"strings\"\n"
   "\t\"sync\"\n"
   ")\n"
   "\n"
   "// HTTP/2 client transport: call official gRPC servers directly.\n"
   "// Http2Transport implements the Transport contract (one Send/Recv\n"
   "// is one grpc-dc frame) over a manual HTTP/2 session (RFC 9113\n"
   "// framing + RFC 7541 HPACK from generated tables). TLS, when a\n"
   "// *tls.Config is supplied, is crypto/tls with ALPN h2 — the TLS\n"
   "// protocol itself is stdlib, only the dial glue is generated.\n"
   "\n"
   "const (\n"
   "\th2Data = 0\n"
   "\th2Headers = 1\n"
   "\th2RSTStream = 3\n"
   "\th2Settings = 4\n"
   "\th2Ping = 6\n"
   "\th2WindowUpdate = 8\n"
   "\th2Continuation = 9\n"
   ")\n"
   "\n"
   "var hpackStatic = [61][2]string{\n"
   "GO_STATIC_TABLE"
   "\n}\n"
   "\n"
   "var hpackHuffCodes = [257]uint32{GO_HUFF_CODES}\n"
   "\n"
   "var hpackHuffLens = [257]uint8{GO_HUFF_LENS}\n"
   "\n"
   "var hpackHuffDecode = buildHuffDecode()\n"
   "\n"
   "func buildHuffDecode() map[uint64]int {\n"
   "\tm := make(map[uint64]int, 257)\n"
   "\tfor sym := 0; sym < 257; sym++ {\n"
   "\t\tkey := uint64(hpackHuffLens[sym])<<32 | uint64(hpackHuffCodes[sym])\n"
   "\t\tm[key] = sym\n"
   "\t}\n"
   "\treturn m\n"
   "}\n"
   "\n"
   "func hpackDecodeInt(data []byte, pos int, prefixBits uint) (int, int, error) {\n"
   "\tmask := int((1 << prefixBits) - 1)\n"
   "\tif pos >= len(data) {\n"
   "\t\treturn 0, pos, errors.New(\"hpack: truncated int\")\n"
   "\t}\n"
   "\tvalue := int(data[pos]) & mask\n"
   "\tpos++\n"
   "\tif value < mask {\n"
   "\t\treturn value, pos, nil\n"
   "\t}\n"
   "\tshift := uint(0)\n"
   "\tfor {\n"
   "\t\tif pos >= len(data) {\n"
   "\t\t\treturn 0, pos, errors.New(\"hpack: truncated int\")\n"
   "\t\t}\n"
   "\t\tb := data[pos]\n"
   "\t\tpos++\n"
   "\t\tvalue += int(b&0x7f) << shift\n"
   "\t\tshift += 7\n"
   "\t\tif b&0x80 == 0 {\n"
   "\t\t\treturn value, pos, nil\n"
   "\t\t}\n"
   "\t}\n"
   "}\n"
   "\n"
   "func huffmanDecode(data []byte) []byte {\n"
   "\tout := make([]byte, 0, len(data))\n"
   "\tvar cur uint32\n"
   "\tvar bits uint\n"
   "\tfor _, byt := range data {\n"
   "\t\tfor i := 7; i >= 0; i-- {\n"
   "\t\t\tcur = cur<<1 | uint32((byt>>uint(i))&1)\n"
   "\t\t\tbits++\n"
   "\t\t\tif sym, ok := hpackHuffDecode[uint64(bits)<<32|uint64(cur)]; ok {\n"
   "\t\t\t\tif sym != 256 {\n"
   "\t\t\t\t\tout = append(out, byte(sym))\n"
   "\t\t\t\t}\n"
   "\t\t\t\tcur, bits = 0, 0\n"
   "\t\t\t}\n"
   "\t\t}\n"
   "\t}\n"
   "\treturn out\n"
   "}\n"
   "\n"
   "func hpackDecodeString(data []byte, pos int) (string, int, error) {\n"
   "\tif pos >= len(data) {\n"
   "\t\treturn \"\", pos, errors.New(\"hpack: truncated string\")\n"
   "\t}\n"
   "\thuffman := data[pos]&0x80 != 0\n"
   "\tlength, pos, err := hpackDecodeInt(data, pos, 7)\n"
   "\tif err != nil || pos+length > len(data) {\n"
   "\t\treturn \"\", pos, errors.New(\"hpack: truncated string\")\n"
   "\t}\n"
   "\traw := data[pos : pos+length]\n"
   "\tif huffman {\n"
   "\t\traw = huffmanDecode(raw)\n"
   "\t}\n"
   "\treturn string(raw), pos + length, nil\n"
   "}\n"
   "\n"
   "type hpackDecoder struct {\n"
   "\tdynamic [][2]string\n"
   "\tsize    int\n"
   "}\n"
   "\n"
   "func (d *hpackDecoder) entry(index int) ([2]string, error) {\n"
   "\tif index >= 1 && index <= len(hpackStatic) {\n"
   "\t\treturn hpackStatic[index-1], nil\n"
   "\t}\n"
   "\tdyn := index - len(hpackStatic) - 1\n"
   "\tif dyn < 0 || dyn >= len(d.dynamic) {\n"
   "\t\treturn [2]string{}, fmt.Errorf(\"hpack: bad index %d\", index)\n"
   "\t}\n"
   "\treturn d.dynamic[dyn], nil\n"
   "}\n"
   "\n"
   "func (d *hpackDecoder) add(name, value string) {\n"
   "\td.dynamic = append([][2]string{{name, value}}, d.dynamic...)\n"
   "\td.size += len(name) + len(value) + 32\n"
   "\tfor d.size > 4096 && len(d.dynamic) > 0 {\n"
   "\t\tlast := d.dynamic[len(d.dynamic)-1]\n"
   "\t\td.dynamic = d.dynamic[:len(d.dynamic)-1]\n"
   "\t\td.size -= len(last[0]) + len(last[1]) + 32\n"
   "\t}\n"
   "}\n"
   "\n"
   "func (d *hpackDecoder) literal(data []byte, pos int, prefix uint) ([2]string, int, error) {\n"
   "\tindex, pos, err := hpackDecodeInt(data, pos, prefix)\n"
   "\tif err != nil {\n"
   "\t\treturn [2]string{}, pos, err\n"
   "\t}\n"
   "\tvar name string\n"
   "\tif index == 0 {\n"
   "\t\tname, pos, err = hpackDecodeString(data, pos)\n"
   "\t\tif err != nil {\n"
   "\t\t\treturn [2]string{}, pos, err\n"
   "\t\t}\n"
   "\t} else {\n"
   "\t\tentry, err := d.entry(index)\n"
   "\t\tif err != nil {\n"
   "\t\t\treturn [2]string{}, pos, err\n"
   "\t\t}\n"
   "\t\tname = entry[0]\n"
   "\t}\n"
   "\tvalue, pos, err := hpackDecodeString(data, pos)\n"
   "\tif err != nil {\n"
   "\t\treturn [2]string{}, pos, err\n"
   "\t}\n"
   "\tif prefix == 6 {\n"
   "\t\td.add(name, value)\n"
   "\t}\n"
   "\treturn [2]string{name, value}, pos, nil\n"
   "}\n"
   "\n"
   "func (d *hpackDecoder) decode(data []byte) ([][2]string, error) {\n"
   "\theaders := [][2]string{}\n"
   "\tpos := 0\n"
   "\tfor pos < len(data) {\n"
   "\t\tb := data[pos]\n"
   "\tswitch {\n"
   "\t\tcase b&0x80 != 0:\n"
   "\t\t\tindex, np, err := hpackDecodeInt(data, pos, 7)\n"
   "\t\t\tif err != nil {\n"
   "\t\t\t\treturn nil, err\n"
   "\t\t\t}\n"
   "\t\t\tentry, err := d.entry(index)\n"
   "\t\t\tif err != nil {\n"
   "\t\t\t\treturn nil, err\n"
   "\t\t\t}\n"
   "\t\t\theaders = append(headers, entry)\n"
   "\t\t\tpos = np\n"
   "\t\tcase b&0xc0 == 0x40:\n"
   "\t\t\tentry, np, err := d.literal(data, pos, 6)\n"
   "\t\t\tif err != nil {\n"
   "\t\t\t\treturn nil, err\n"
   "\t\t\t}\n"
   "\t\t\theaders = append(headers, entry)\n"
   "\t\t\tpos = np\n"
   "\t\tcase b&0xe0 == 0x20:\n"
   "\t\t\t_, np, err := hpackDecodeInt(data, pos, 5)\n"
   "\t\t\tif err != nil {\n"
   "\t\t\t\treturn nil, err\n"
   "\t\t\t}\n"
   "\t\t\tpos = np\n"
   "\t\tdefault:\n"
   "\t\t\tentry, np, err := d.literal(data, pos, 4)\n"
   "\t\t\tif err != nil {\n"
   "\t\t\t\treturn nil, err\n"
   "\t\t\t}\n"
   "\t\t\theaders = append(headers, entry)\n"
   "\t\t\tpos = np\n"
   "\t\t}\n"
   "\t}\n"
   "\treturn headers, nil\n"
   "}\n"
   "\n"
   "func hpackEncodeInt(value int, prefixBits uint, prefix byte) []byte {\n"
   "\tmask := int((1 << prefixBits) - 1)\n"
   "\tif value < mask {\n"
   "\t\treturn []byte{prefix | byte(value)}\n"
   "\t}\n"
   "\tout := []byte{prefix | byte(mask)}\n"
   "\tvalue -= mask\n"
   "\tfor value >= 128 {\n"
   "\t\tout = append(out, byte(value%128+128))\n"
   "\t\tvalue /= 128\n"
   "\t}\n"
   "\treturn append(out, byte(value))\n"
   "}\n"
   "\n"
   "func hpackEncodeString(text string) []byte {\n"
   "\tout := hpackEncodeInt(len(text), 7, 0)\n"
   "\treturn append(out, text...)\n"
   "}\n"
   "\n"
   "func hpackLiteralIndexedName(index int, value string) []byte {\n"
   "\tout := hpackEncodeInt(index, 4, 0)\n"
   "\treturn append(out, hpackEncodeString(value)...)\n"
   "}\n"
   "\n"
   "func hpackLiteralNewName(name, value string) []byte {\n"
   "\tout := []byte{0}\n"
   "\tout = append(out, hpackEncodeString(name)...)\n"
   "\treturn append(out, hpackEncodeString(value)...)\n"
   "}\n"))

(define go-http2-part2
  (string-append
   "\n"
   "type h2StreamState struct {\n"
   "\twindow int\n"
   "}\n"
   "\n"
   "// Http2Transport carries grpc-dc frames over one HTTP/2\n"
   "// connection to an official gRPC server.\n"
   "type Http2Transport struct {\n"
   "\tconn      net.Conn\n"
   "\tauthority string\n"
   "\tscheme    string\n"
   "\tsendMu    sync.Mutex\n"
   "\trecvCh    chan []byte\n"
   "\tdecoder   hpackDecoder\n"
   "\tcond      *sync.Cond\n"
   "\twinMu     sync.Mutex\n"
   "\tconnWindow int\n"
   "\tpeerInitial int\n"
   "\twindows   map[uint32]int\n"
   "\tbuffers   map[uint32][]byte\n"
   "\tblocks    map[uint32][]byte\n"
   "\theadersSeen map[uint32]bool\n"
   "\t// Per-stream gzip state: requests compress when the call\n"
   "\t// metadata carries grpc-encoding: gzip; responses decompress\n"
   "\t// when the response headers do. Streams advertise gzip via\n"
   "\t// grpc-accept-encoding.\n"
   "\tcompressOut  map[uint32]bool\n"
   "\tdecompressIn map[uint32]bool\n"
   "}\n"
   "\n"
   "func gzipCompress(payload []byte) []byte {\n"
   "\tvar buf bytes.Buffer\n"
   "\tw := gzip.NewWriter(&buf)\n"
   "\t_, _ = w.Write(payload)\n"
   "\t_ = w.Close()\n"
   "\treturn buf.Bytes()\n"
   "}\n"
   "\n"
   "func gzipDecompress(payload []byte) ([]byte, error) {\n"
   "\tr, err := gzip.NewReader(bytes.NewReader(payload))\n"
   "\tif err != nil {\n"
   "\t\treturn nil, err\n"
   "\t}\n"
   "\tdefer r.Close()\n"
   "\treturn io.ReadAll(r)\n"
   "}\n"
   "\n"
   "// DialHttp2 opens an HTTP/2 connection to authority (host or\n"
   "// host:port). A nil tlsConfig dials cleartext h2c; otherwise\n"
   "// crypto/tls wraps the socket (ALPN h2 forced when the config\n"
   "// has no NextProtos).\n"
   "func DialHttp2(authority string, tlsConfig *tls.Config) (*Http2Transport, error) {\n"
   "\thost, port, err := net.SplitHostPort(authority)\n"
   "\tif err != nil {\n"
   "\t\thost = authority\n"
   "\t\tif tlsConfig != nil {\n"
   "\t\t\tport = \"443\"\n"
   "\t\t} else {\n"
   "\t\t\tport = \"80\"\n"
   "\t\t}\n"
   "\t}\n"
   "\tt := &Http2Transport{\n"
   "\t\tauthority: authority,\n"
   "\t\tscheme:    \"http\",\n"
   "\t\trecvCh:    make(chan []byte, 4096),\n"
   "\t\tconnWindow: 65535,\n"
   "\t\tpeerInitial: 65535,\n"
   "\t\twindows:   map[uint32]int{},\n"
   "\t\tbuffers:   map[uint32][]byte{},\n"
   "\t\tblocks:    map[uint32][]byte{},\n"
   "\t\theadersSeen: map[uint32]bool{},\n"
   "\t\tcompressOut:  map[uint32]bool{},\n"
   "\t\tdecompressIn: map[uint32]bool{},\n"
   "\t}\n"
   "\tt.cond = sync.NewCond(&t.winMu)\n"
   "\tvar conn net.Conn\n"
   "\tif tlsConfig != nil {\n"
   "\t\tt.scheme = \"https\"\n"
   "\t\tcfg := tlsConfig.Clone()\n"
   "\t\tif len(cfg.NextProtos) == 0 {\n"
   "\t\t\tcfg.NextProtos = []string{\"h2\"}\n"
   "\t\t}\n"
   "\t\tif cfg.ServerName == \"\" {\n"
   "\t\t\tcfg.ServerName = host\n"
   "\t\t}\n"
   "\t\tconn, err = tls.Dial(\"tcp\", net.JoinHostPort(host, port), cfg)\n"
   "\t} else {\n"
   "\t\tconn, err = net.Dial(\"tcp\", net.JoinHostPort(host, port))\n"
   "\t}\n"
   "\tif err != nil {\n"
   "\t\treturn nil, err\n"
   "\t}\n"
   "\tt.conn = conn\n"
   "\tif _, err := conn.Write([]byte(\"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n\")); err != nil {\n"
   "\t\treturn nil, err\n"
   "\t}\n"
   "\tif err := t.sendFrame(h2Settings, 0, 0, nil); err != nil {\n"
   "\t\treturn nil, err\n"
   "\t}\n"
   "\tgo t.reader()\n"
   "\treturn t, nil\n"
   "}\n"
   "\n"
   "func (t *Http2Transport) sendFrame(ftype byte, streamID uint32, flags byte, payload []byte) error {\n"
   "\theader := []byte{byte(len(payload) >> 16), byte(len(payload) >> 8), byte(len(payload)), ftype, flags,\n"
   "\t\tbyte(streamID >> 24), byte(streamID >> 16), byte(streamID >> 8), byte(streamID)}\n"
   "\tt.sendMu.Lock()\n"
   "\tdefer t.sendMu.Unlock()\n"
   "\tif _, err := t.conn.Write(header); err != nil {\n"
   "\t\treturn err\n"
   "\t}\n"
   "\tif len(payload) > 0 {\n"
   "\t\t_, err := t.conn.Write(payload)\n"
   "\t\treturn err\n"
   "\t}\n"
   "\treturn nil\n"
   "}\n"
   "\n"
   "func (t *Http2Transport) emit(frameType FrameType, streamID uint32, payload []byte) {\n"
   "\tframe := make([]byte, 9+len(payload))\n"
   "\tframe[0] = byte(frameType)\n"
   "\tbinary.BigEndian.PutUint32(frame[1:5], streamID)\n"
   "\tbinary.BigEndian.PutUint32(frame[5:9], uint32(len(payload)))\n"
   "\tcopy(frame[9:], payload)\n"
   "\tt.recvCh <- frame\n"
   "}\n"
   "\n"
   "func (t *Http2Transport) reader() {\n"
   "\theader := make([]byte, 9)\n"
   "\tfor {\n"
   "\t\tif _, err := io.ReadFull(t.conn, header); err != nil {\n"
   "\t\t\tclose(t.recvCh)\n"
   "\t\t\treturn\n"
   "\t\t}\n"
   "\t\tlength := int(header[0])<<16 | int(header[1])<<8 | int(header[2])\n"
   "\t\tpayload := make([]byte, length)\n"
   "\t\tif _, err := io.ReadFull(t.conn, payload); err != nil {\n"
   "\t\t\tclose(t.recvCh)\n"
   "\t\t\treturn\n"
   "\t\t}\n"
   "\t\tstreamID := binary.BigEndian.Uint32(header[5:9]) & 0x7fffffff\n"
   "\t\tt.onFrame(header[3], header[4], streamID, payload)\n"
   "\t}\n"
   "}\n"
   "\n"
   "func (t *Http2Transport) onFrame(ftype byte, flags byte, streamID uint32, payload []byte) {\n"
   "\tswitch ftype {\n"
   "\tcase h2Settings:\n"
   "\t\tif flags&0x1 != 0 {\n"
   "\t\t\treturn\n"
   "\t\t}\n"
   "\t\tfor i := 0; i+6 <= len(payload); i += 6 {\n"
   "\t\t\tident := binary.BigEndian.Uint16(payload[i:])\n"
   "\t\t\tvalue := int(binary.BigEndian.Uint32(payload[i+2:]))\n"
   "\t\t\tif ident == 0x4 {\n"
   "\t\t\t\tt.winMu.Lock()\n"
   "\t\t\t\tdelta := value - t.peerInitial\n"
   "\t\t\t\tt.peerInitial = value\n"
   "\t\t\t\tfor k := range t.windows {\n"
   "\t\t\t\t\tt.windows[k] += delta\n"
   "\t\t\t\t}\n"
   "\t\t\t\tt.cond.Broadcast()\n"
   "\t\t\t\tt.winMu.Unlock()\n"
   "\t\t\t}\n"
   "\t\t}\n"
   "\t\t_ = t.sendFrame(h2Settings, 0, 0x1, nil)\n"
   "\tcase h2Ping:\n"
   "\t\tif flags&0x1 == 0 {\n"
   "\t\t\t_ = t.sendFrame(h2Ping, 0, 0x1, payload)\n"
   "\t\t}\n"
   "\tcase h2WindowUpdate:\n"
   "\t\tincrement := int(binary.BigEndian.Uint32(payload) & 0x7fffffff)\n"
   "\t\tt.winMu.Lock()\n"
   "\t\tif streamID == 0 {\n"
   "\t\t\tt.connWindow += increment\n"
   "\t\t} else {\n"
   "\t\t\tif _, ok := t.windows[streamID]; !ok {\n"
   "\t\t\t\tt.windows[streamID] = t.peerInitial\n"
   "\t\t\t}\n"
   "\t\t\tt.windows[streamID] += increment\n"
   "\t\t}\n"
   "\t\tt.cond.Broadcast()\n"
   "\t\tt.winMu.Unlock()\n"
   "\tcase h2RSTStream:\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"code\": 8, \"message\": \"rst stream\"})\n"
   "\t\tt.emit(FrameRst, streamID, body)\n"
   "\tcase h2Headers, h2Continuation:\n"
   "\t\tblock := append(t.blocks[streamID], payload...)\n"
   "\t\tif flags&0x4 == 0 {\n"
   "\t\t\tt.blocks[streamID] = block\n"
   "\t\t\treturn\n"
   "\t\t}\n"
   "\t\tdelete(t.blocks, streamID)\n"
   "\t\tt.onHeaders(streamID, flags&0x1 != 0, block)\n"
   "\tcase h2Data:\n"
   "\t\tbuf := append(t.buffers[streamID], payload...)\n"
   "\t\tif len(payload) > 0 {\n"
   "\t\t\tinc := make([]byte, 4)\n"
   "\t\t\tbinary.BigEndian.PutUint32(inc, uint32(len(payload)))\n"
   "\t\t\t_ = t.sendFrame(h2WindowUpdate, 0, 0, inc)\n"
   "\t\t\t_ = t.sendFrame(h2WindowUpdate, streamID, 0, inc)\n"
   "\t\t}\n"
   "\t\tfor len(buf) >= 5 {\n"
   "\t\t\tmsgLen := int(binary.BigEndian.Uint32(buf[1:5]))\n"
   "\t\t\tif len(buf) < 5+msgLen {\n"
   "\t\t\t\tbreak\n"
   "\t\t\t}\n"
   "\t\t\tmessage := buf[5 : 5+msgLen]\n"
   "\t\t\tif buf[0] == 1 && t.decompressIn[streamID] {\n"
   "\t\t\t\tplain, err := gzipDecompress(message)\n"
   "\t\t\t\tif err != nil {\n"
   "\t\t\t\t\tbody, _ := json.Marshal(map[string]any{\"code\": 3, \"message\": \"gzip decompression failed\"})\n"
   "\t\t\t\t\tt.emit(FrameRst, streamID, body)\n"
   "\t\t\t\t\treturn\n"
   "\t\t\t\t}\n"
   "\t\t\t\tmessage = plain\n"
   "\t\t\t}\n"
   "\t\t\tt.emit(FrameData, streamID, message)\n"
   "\t\t\tbuf = buf[5+msgLen:]\n"
   "\t\t}\n"
   "\t\tt.buffers[streamID] = buf\n"
   "\t\tif flags&0x1 != 0 {\n"
   "\t\t\tbody, _ := json.Marshal(map[string]any{\"code\": 2, \"message\": \"missing grpc-status\"})\n"
   "\t\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\t}\n"
   "\t}\n"
   "}\n"
   "\n"))

(define go-http2-part3
  (string-append
   "\n"
   "func (t *Http2Transport) onHeaders(streamID uint32, endStream bool, block []byte) {\n"
   "\tfields, err := t.decoder.decode(block)\n"
   "\tif err != nil {\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"code\": 13, \"message\": \"hpack decode failed\"})\n"
   "\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\treturn\n"
   "\t}\n"
   "\theaders := map[string]string{}\n"
   "\tfor _, kv := range fields {\n"
   "\t\theaders[kv[0]] = kv[1]\n"
   "\t}\n"
   "\tif headers[\"grpc-encoding\"] == \"gzip\" {\n"
   "\t\tt.decompressIn[streamID] = true\n"
   "\t}\n"
   "\t// Response metadata: transport keys drop out; -bin values\n"
   "\t// are base64 in both the HPACK and JSON domains.\n"
   "\tresponseMeta := func() map[string]string {\n"
   "\t\tmetadata := map[string]string{}\n"
   "\t\tfor k, v := range headers {\n"
   "\t\t\tif strings.HasPrefix(k, \":\") || k == \"content-type\" || k == \"grpc-status\" || k == \"grpc-message\" || k == \"grpc-encoding\" || k == \"grpc-accept-encoding\" {\n"
   "\t\t\t\tcontinue\n"
   "\t\t\t}\n"
   "\t\t\tmetadata[k] = v\n"
   "\t\t}\n"
   "\t\treturn metadata\n"
   "\t}\n"
   "\tstatus, hasStatus := headers[\"grpc-status\"]\n"
   "\tif endStream && hasStatus {\n"
   "\t\tcode, _ := strconv.Atoi(status)\n"
   "\t\tmessage, _ := url.PathUnescape(headers[\"grpc-message\"])\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"code\": code, \"message\": message, \"metadata\": responseMeta()})\n"
   "\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\treturn\n"
   "\t}\n"
   "\tif !t.headersSeen[streamID] {\n"
   "\t\tt.headersSeen[streamID] = true\n"
   "\t\tmetadata := map[string]string{}\n"
   "\t\tfor k, v := range headers {\n"
   "\t\t\tif strings.HasPrefix(k, \":\") || k == \"content-type\" || k == \"grpc-status\" || k == \"grpc-message\" {\n"
   "\t\t\t\tcontinue\n"
   "\t\t\t}\n"
   "\t\t\tmetadata[k] = v\n"
   "\t\t}\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"metadata\": metadata})\n"
   "\t\tt.emit(FrameHeaders, streamID, body)\n"
   "\t\tif endStream {\n"
   "\t\t\tbody, _ := json.Marshal(map[string]any{\"code\": 2, \"message\": \"missing grpc-status\"})\n"
   "\t\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\t}\n"
   "\t\treturn\n"
   "\t}\n"
   "\tcode := 2\n"
   "\tif hasStatus {\n"
   "\t\tcode, _ = strconv.Atoi(status)\n"
   "\t}\n"
   "\tmessage, _ := url.PathUnescape(headers[\"grpc-message\"])\n"
   "\tbody, _ := json.Marshal(map[string]any{\"code\": code, \"message\": message, \"metadata\": responseMeta()})\n"
   "\tt.emit(FrameTrailers, streamID, body)\n"
   "}\n"
   "\n"
   "type h2Head struct {\n"
   "\tPath     string            `json:\"path\"`\n"
   "\tMetadata map[string]string `json:\"metadata\"`\n"
   "}\n"
   "\n"
   "// Send carries one grpc-dc frame to the HTTP/2 peer.\n"
   "func (t *Http2Transport) Send(data []byte) error {\n"
   "\tif len(data) < 9 {\n"
   "\t\treturn errors.New(\"http2: short frame\")\n"
   "\t}\n"
   "\tframeType := FrameType(data[0])\n"
   "\tstreamID := binary.BigEndian.Uint32(data[1:5])\n"
   "\tpayload := data[9:]\n"
   "\tswitch frameType {\n"
   "\tcase FrameHeaders:\n"
   "\t\tvar head h2Head\n"
   "\t\tif err := json.Unmarshal(payload, &head); err != nil {\n"
   "\t\t\treturn err\n"
   "\t\t}\n"
   "\t\tblock := []byte{0x83}\n"
   "\t\tif t.scheme == \"https\" {\n"
   "\t\t\tblock = append(block, 0x87)\n"
   "\t\t} else {\n"
   "\t\t\tblock = append(block, 0x86)\n"
   "\t\t}\n"
   "\t\tblock = append(block, hpackLiteralIndexedName(4, head.Path)...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\":authority\", t.authority)...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\"content-type\", \"application/grpc\")...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\"te\", \"trailers\")...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\"grpc-accept-encoding\", \"gzip,identity\")...)\n"
   "\t\tfor k, v := range head.Metadata {\n"
   "\t\t\tif strings.ToLower(k) == \"grpc-encoding\" && v == \"gzip\" {\n"
   "\t\t\t\tt.compressOut[streamID] = true\n"
   "\t\t\t}\n"
   "\t\t}\n"
   "\t\tkeys := make([]string, 0, len(head.Metadata))\n"
   "\t\tfor k := range head.Metadata {\n"
   "\t\t\tkeys = append(keys, k)\n"
   "\t\t}\n"
   "\t\tsort.Strings(keys)\n"
   "\t\tfor _, k := range keys {\n"
   "\t\t\tblock = append(block, hpackLiteralNewName(strings.ToLower(k), head.Metadata[k])...)\n"
   "\t\t}\n"
   "\t\tt.winMu.Lock()\n"
   "\t\tif _, ok := t.windows[streamID]; !ok {\n"
   "\t\t\tt.windows[streamID] = t.peerInitial\n"
   "\t\t}\n"
   "\t\tt.winMu.Unlock()\n"
   "\t\treturn t.sendFrame(h2Headers, streamID, 0x4, block)\n"
   "\tcase FrameData:\n"
   "\t\tif t.compressOut[streamID] {\n"
   "\t\t\tpayload = gzipCompress(payload)\n"
   "\t\t}\n"
   "\t\tlpm := make([]byte, 5+len(payload))\n"
   "\t\tif t.compressOut[streamID] {\n"
   "\t\t\tlpm[0] = 1\n"
   "\t\t}\n"
   "\t\tbinary.BigEndian.PutUint32(lpm[1:5], uint32(len(payload)))\n"
   "\t\tcopy(lpm[5:], payload)\n"
   "\t\toffset := 0\n"
   "\t\tfor offset < len(lpm) {\n"
   "\t\t\tt.winMu.Lock()\n"
   "\t\t\tfor t.connWindow <= 0 || t.windows[streamID] <= 0 {\n"
   "\t\t\t\tt.cond.Wait()\n"
   "\t\t\t}\n"
   "\t\t\tallowance := t.connWindow\n"
   "\t\t\tif t.windows[streamID] < allowance {\n"
   "\t\t\t\tallowance = t.windows[streamID]\n"
   "\t\t\t}\n"
   "\t\t\tif allowance > 16384 {\n"
   "\t\t\t\tallowance = 16384\n"
   "\t\t\t}\n"
   "\t\t\tif allowance > len(lpm)-offset {\n"
   "\t\t\t\tallowance = len(lpm) - offset\n"
   "\t\t\t}\n"
   "\t\t\tt.connWindow -= allowance\n"
   "\t\t\tt.windows[streamID] -= allowance\n"
   "\t\t\tt.winMu.Unlock()\n"
   "\t\t\tchunk := lpm[offset : offset+allowance]\n"
   "\t\t\toffset += allowance\n"
   "\t\t\tif err := t.sendFrame(h2Data, streamID, 0, chunk); err != nil {\n"
   "\t\t\t\treturn err\n"
   "\t\t\t}\n"
   "\t\t}\n"
   "\t\treturn nil\n"
   "\tcase FrameHalfClose:\n"
   "\t\treturn t.sendFrame(h2Data, streamID, 0x1, nil)\n"
   "\tcase FrameRst:\n"
   "\t\tpayload := make([]byte, 4)\n"
   "\t\tbinary.BigEndian.PutUint32(payload, 8)\n"
   "\t\treturn t.sendFrame(h2RSTStream, streamID, 0, payload)\n"
   "\t}\n"
   "\treturn nil\n"
   "}\n"
   "\n"
   "// Recv returns the next synthesized grpc-dc frame, or io.EOF\n"
   "// when the connection closes.\n"
   "func (t *Http2Transport) Recv() ([]byte, error) {\n"
   "\tframe, ok := <-t.recvCh\n"
   "\tif !ok {\n"
   "\t\treturn nil, io.EOF\n"
   "\t}\n"
   "\treturn frame, nil\n"
   "}\n"
   "\n"
   "// Close shuts the connection down.\n"
   "func (t *Http2Transport) Close() error {\n"
   "\treturn t.conn.Close()\n"
   "}\n"))

(define (emit-go-http2)
  (cons "http2.go"
        (string-replace
         (string-replace
          (string-replace (string-append go-http2-part1 go-http2-part2 go-http2-part3)
                          "GO_STATIC_TABLE" (go-static-table))
          "GO_HUFF_CODES" (go-huff-codes))
         "GO_HUFF_LENS" (go-huff-lens))))

