   "    private void Emit(int frameType, uint streamId, byte[] payload)\n"
   "    {\n"
   "        queue.Add(Codec.EncodeFrame(frameType, streamId, payload));\n"
   "    }\n\n"
   "    private void EmitHeadersFrame(uint streamId, Dictionary<string, string> metadata)\n"
   "    {\n"
   "        var sb = new StringBuilder(\"{\\\"metadata\\\":{\");\n"
   "        bool first = true;\n"
   "        foreach (KeyValuePair<string, string> e in metadata)\n"
   "        {\n"
   "            if (!first)\n"
