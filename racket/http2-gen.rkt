   "        WriteString(output, value);\n"
   "    }\n\n"
   "    private static void WriteLiteralNewName(MemoryStream output, string name, string value)\n"
   "    {\n"
   "        WriteInt(output, 0, 4, 0);\n"
   "        WriteString(output, name);\n"
   "        WriteString(output, value);\n"
   "    }\n\n"))

(define cs-http2-part2
  (string-append
   "    private readonly string authority;\n"
   "    private readonly string scheme;\n"
   "    private readonly TcpClient socket;\n"
   "    private readonly Stream stream;\n"
   "    private readonly object sendLock = new();\n"
   "    private readonly System.Collections.Concurrent.BlockingCollection<byte[]> queue = new();\n"
   "    private readonly HpackDecoder decoder = new();\n"
   "    private readonly object cond = new();\n"
   "    private long connWindow = 65535;\n"
   "    private readonly Dictionary<uint, long> streamWindows = new();\n"
   "    private long peerInitialWindow = 65535;\n"
   "    private readonly Dictionary<uint, MemoryStream> dataBuffers = new();\n"
   "    private readonly Dictionary<uint, MemoryStream> headerBlocks = new();\n"
   "    private readonly HashSet<uint> headersSeen = new();\n"
   "    private readonly Dictionary<uint, bool> compressOut = new();\n"
   "    private readonly HashSet<uint> decompressIn = new();\n"
   "    private volatile bool closed;\n\n"
   "    /// <summary>Cleartext (h2c, prior knowledge) connection to authority.</summary>\n"
   "    public static Http2Transport Dial(string authority)\n"
   "    {\n"
   "        return new Http2Transport(authority, null, null);\n"
   "    }\n\n"
   "    /// <summary>\n"
   "    /// TLS connection to authority (ALPN h2). roots, when given,\n"
   "    /// are the only trusted roots; serverName overrides\n"
   "    /// SNI/verification name (defaults to the authority host).\n"
   "    /// </summary>\n"
   "    public static Http2Transport DialTls(string authority, X509Certificate2[] roots = null, string serverName = null)\n"
   "    {\n"
   "        var options = new SslClientAuthenticationOptions\n"
   "        {\n"
   "            ApplicationProtocols = new List<SslApplicationProtocol> { SslApplicationProtocol.Http2 },\n"
   "        };\n"
   "        if (roots != null && roots.Length > 0)\n"
   "        {\n"
   "            options.RemoteCertificateValidationCallback = (sender, cert, chain, errors) =>\n"
   "            {\n"
   "                if (cert == null)\n"
   "                {\n"
   "                    return false;\n"
   "                }\n"
   "                using var custom = new X509Chain();\n"
   "                custom.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;\n"
   "                foreach (X509Certificate2 root in roots)\n"
   "                {\n"
   "                    custom.ChainPolicy.CustomTrustStore.Add(root);\n"
   "                }\n"
   "                custom.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;\n"
   "                return custom.Build((X509Certificate2)cert);\n"
   "            };\n"
   "        }\n"
   "        return new Http2Transport(authority, options, serverName);\n"
   "    }\n\n"
   "    private Http2Transport(string authority, SslClientAuthenticationOptions tlsOptions, string serverName)\n"
   "    {\n"
   "        this.authority = authority;\n"
   "        scheme = tlsOptions != null ? \"https\" : \"http\";\n"
   "        string host = authority;\n"
   "        int port = tlsOptions != null ? 443 : 80;\n"
   "        int colon = authority.LastIndexOf(':');\n"
   "        if (colon > 0)\n"
   "        {\n"
   "            host = authority[..colon];\n"
   "            port = int.Parse(authority[(colon + 1)..]);\n"
   "        }\n"
   "        socket = new TcpClient();\n"
   "        socket.Connect(host, port);\n"
   "        Stream raw = socket.GetStream();\n"
   "        if (tlsOptions != null)\n"
   "        {\n"
   "            tlsOptions.TargetHost = serverName ?? host;\n"
   "            var ssl = new SslStream(raw, false);\n"
   "            ssl.AuthenticateAsClient(tlsOptions);\n"
   "            if (ssl.NegotiatedApplicationProtocol != SslApplicationProtocol.Http2)\n"
   "            {\n"
