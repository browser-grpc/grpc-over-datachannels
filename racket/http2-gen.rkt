;; Kotlin emitter -> kotlin/grpcdc/Http2Transport.kt
;; ---------------------------------------------------------------------------

(define (kt-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "arrayOf(~s, ~s)," (car e) (cdr e)))
   "\n            "))

(define (kt-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (kt-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define kotlin-http2-body
  (string-append
   "package grpcdc\n"
   "\n"
   "import java.io.ByteArrayInputStream\n"
   "import java.io.ByteArrayOutputStream\n"
   "import java.io.DataInputStream\n"
   "import java.io.EOFException\n"
   "import java.io.IOException\n"
   "import java.io.InputStream\n"
   "import java.io.OutputStream\n"
   "import java.net.Socket\n"
   "import java.nio.charset.StandardCharsets\n"
   "import java.util.concurrent.LinkedBlockingQueue\n"
   "import java.util.zip.GZIPInputStream\n"
   "import java.util.zip.GZIPOutputStream\n"
   "import javax.net.ssl.SSLContext\n"
   "import javax.net.ssl.SSLParameters\n"
   "import javax.net.ssl.SSLSocket\n"
   "import javax.net.ssl.SSLSocketFactory\n"
   "\n"
   "/**\n"
   " * Cleartext/TLS HTTP/2 frame transport (RFC 9113, generated\n"
   " * from http2-spec.rkt) over a TCP socket: a generated client\n"
   " * can dial a stock gRPC server directly (grpc-java server,\n"
   " * grpc-go server), no bridge process. TLS via dialTls (ALPN\n"
   " * h2). Client endpoints only.\n"
   " */\n"
   "class Http2Transport private constructor(\n"
   "    private val authority: String,\n"
   "    tlsFactory: SSLSocketFactory?,\n"
   "    serverName: String?,\n"
   ") : Transport {\n"
   "    companion object {\n"
   "        const val H2_DATA = 0x0\n"
   "        const val H2_HEADERS = 0x1\n"
   "        const val H2_RST_STREAM = 0x3\n"
   "        const val H2_SETTINGS = 0x4\n"
   "        const val H2_PING = 0x6\n"
   "        const val H2_WINDOW_UPDATE = 0x8\n"
   "        const val H2_CONTINUATION = 0x9\n"
   "        const val FLAG_END_STREAM = 0x1\n"
   "        const val FLAG_END_HEADERS = 0x4\n"
   "        const val FLAG_ACK = 0x1\n"
   "        const val FLAG_PADDED = 0x8\n"
   "        const val MAX_FRAME_PAYLOAD = 16384\n"
   "\n"
   "        private val STATIC_TABLE: Array<Array<String>> = arrayOf(\n"
   "            KT_STATIC_TABLE\n"
   "        )\n"
   "\n"
   "        // Packed tables: a 257-entry array literal would exceed\n"
   "        // the JVM 64KB method limit, so parse from text at init.\n"
   "        private const val HUFF_CODES_TEXT = \"KT_HUFF_CODES\"\n"
   "        private const val HUFF_LENS_TEXT = \"KT_HUFF_LENS\"\n"
   "\n"
   "        private val HUFF_CODES: IntArray =\n"
   "            HUFF_CODES_TEXT.split(\",\").map { it.trim().removePrefix(\"0x\").toInt(16) }.toIntArray()\n"
   "        private val HUFF_LENS: IntArray =\n"
   "            HUFF_LENS_TEXT.split(\",\").map { it.trim().toInt() }.toIntArray()\n"
   "\n"
   "        private val HUFF_DECODE = HashMap<Long, Int>()\n"
   "\n"
   "        init {\n"
   "            for (sym in HUFF_CODES.indices) {\n"
   "                HUFF_DECODE[(HUFF_LENS[sym].toLong() shl 32) or (HUFF_CODES[sym].toLong() and 0xffffffffL)] = sym\n"
   "            }\n"
   "        }\n"
   "\n"
   "        private val CLOSED_MARK = ByteArray(0)\n"
   "\n"
   "        fun huffDecode(data: ByteArray, off: Int, len: Int): String {\n"
   "            val out = StringBuilder()\n"
   "            var code = 0L\n"
   "            var bits = 0\n"
   "            for (i in 0 until len) {\n"
   "                val b = data[off + i].toInt() and 0xff\n"
   "                for (j in 7 downTo 0) {\n"
   "                    code = (code shl 1) or ((b shr j) and 1).toLong()\n"
   "                    bits++\n"
   "                    val sym = HUFF_DECODE[(bits.toLong() shl 32) or code]\n"
   "                    if (sym != null) {\n"
   "                        if (sym == 256) throw IOException(\"huffman EOS symbol\")\n"
   "                        out.append(sym.toChar())\n"
   "                        code = 0\n"
   "                        bits = 0\n"
   "                    } else if (bits > 30) {\n"
   "                        throw IOException(\"huffman code too long\")\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            return out.toString()\n"
   "        }\n"
   "\n"
   "        fun writeInt(out: ByteArrayOutputStream, value: Int, prefixBits: Int, prefix: Int) {\n"
   "            val mask = (1 shl prefixBits) - 1\n"
   "            if (value < mask) {\n"
   "                out.write(prefix or value)\n"
   "                return\n"
   "            }\n"
   "            out.write(prefix or mask)\n"
   "            var v = value - mask\n"
   "            while (v >= 0x80) {\n"
   "                out.write((v and 0x7f) or 0x80)\n"
   "                v = v shr 7\n"
   "            }\n"
   "            out.write(v)\n"
   "        }\n"
   "\n"
   "        fun writeString(out: ByteArrayOutputStream, value: String) {\n"
   "            val raw = value.toByteArray(StandardCharsets.UTF_8)\n"
   "            writeInt(out, raw.size, 7, 0)\n"
   "            out.write(raw, 0, raw.size)\n"
   "        }\n"
   "\n"
   "        fun writeLiteralIndexedName(out: ByteArrayOutputStream, index: Int, value: String) {\n"
   "            writeInt(out, index, 4, 0)\n"
   "            writeString(out, value)\n"
   "        }\n"
   "\n"
   "        fun writeLiteralNewName(out: ByteArrayOutputStream, name: String, value: String) {\n"
   "            writeInt(out, 0, 4, 0)\n"
   "            writeString(out, name)\n"
   "            writeString(out, value)\n"
   "        }\n"
   "\n"
   "        fun gunzip(data: ByteArray): ByteArray {\n"
   "            val out = ByteArrayOutputStream()\n"
   "            GZIPInputStream(ByteArrayInputStream(data)).use { gz -> gz.copyTo(out) }\n"
   "            return out.toByteArray()\n"
   "        }\n"
   "\n"
   "        fun gzip(data: ByteArray): ByteArray {\n"
   "            val out = ByteArrayOutputStream()\n"
   "            GZIPOutputStream(out).use { gz -> gz.write(data) }\n"
   "            return out.toByteArray()\n"
   "        }\n"
   "\n"
   "        fun percentDecode(value: String): String {\n"
   "            val bytes = ByteArrayOutputStream()\n"
   "            var i = 0\n"
   "            while (i < value.length) {\n"
   "                val c = value[i]\n"
   "                if (c == '%' && i + 2 < value.length) {\n"
   "                    val hi = Character.digit(value[i + 1], 16)\n"
   "                    val lo = Character.digit(value[i + 2], 16)\n"
   "                    if (hi >= 0 && lo >= 0) {\n"
   "                        bytes.write((hi shl 4) or lo)\n"
   "                        i += 3\n"
   "                        continue\n"
   "                    }\n"
   "                }\n"
   "                bytes.write(c.code)\n"
   "                i++\n"
   "            }\n"
   "            return bytes.toString(StandardCharsets.UTF_8)\n"
   "        }\n"
   "\n"
   "        /** Cleartext (h2c, prior knowledge) connection to authority. */\n"
   "        fun dial(authority: String): Http2Transport = Http2Transport(authority, null, null)\n"
   "\n"
   "        /**\n"
   "         * TLS connection to authority (ALPN h2). context supplies\n"
   "         * trust/key material; serverName overrides SNI/verification\n"
   "         * name (defaults to the authority host).\n"
   "         */\n"
   "        fun dialTls(authority: String, context: SSLContext?, serverName: String?): Http2Transport =\n"
   "            Http2Transport(\n"
   "                authority,\n"
   "                (if (context != null) context.socketFactory else SSLSocketFactory.getDefault()) as SSLSocketFactory,\n"
   "                serverName)\n"
   "    }\n"
   "\n"
   "    private class HpackDecoder {\n"
   "        val dynamic = ArrayList<Array<String>>()\n"
   "        var dynamicSize = 0\n"
   "\n"
   "        fun entry(index: Int): Array<String> {\n"
   "            if (index <= 0) throw IOException(\"bad hpack index 0\")\n"
   "            if (index <= STATIC_TABLE.size) {\n"
   "                val e = STATIC_TABLE[index - 1]\n"
   "                return arrayOf(e[0], e[1])\n"
   "            }\n"
   "            val j = index - STATIC_TABLE.size - 1\n"
   "            if (j >= dynamic.size) throw IOException(\"bad hpack dynamic index $index\")\n"
   "            return dynamic[j]\n"
   "        }\n"
   "\n"
   "        fun add(name: String, value: String) {\n"
   "            dynamic.add(0, arrayOf(name, value))\n"
   "            dynamicSize += name.length + value.length + 32\n"
   "            while (dynamicSize > MAX_DYNAMIC && dynamic.isNotEmpty()) {\n"
   "                val e = dynamic.removeAt(dynamic.size - 1)\n"
   "                dynamicSize -= e[0].length + e[1].length + 32\n"
   "            }\n"
   "        }\n"
   "\n"
   "        fun readInt(data: ByteArray, pos: IntArray, prefixBits: Int): Int {\n"
   "            val mask = (1 shl prefixBits) - 1\n"
   "            var value = data[pos[0]].toInt() and mask\n"
   "            pos[0]++\n"
   "            if (value < mask) return value\n"
   "            var shift = 0\n"
   "            while (true) {\n"
   "                if (pos[0] >= data.size) throw IOException(\"truncated hpack int\")\n"
   "                val b = data[pos[0]].toInt() and 0xff\n"
   "                pos[0]++\n"
   "                value += (b and 0x7f) shl shift\n"
   "                shift += 7\n"
   "                if ((b and 0x80) == 0) break\n"
   "            }\n"
   "            return value\n"
   "        }\n"
   "\n"
   "        fun readString(data: ByteArray, pos: IntArray): String {\n"
   "            if (pos[0] >= data.size) throw IOException(\"truncated hpack string\")\n"
   "            val huffman = (data[pos[0]].toInt() and 0x80) != 0\n"
   "            val len = readInt(data, pos, 7)\n"
   "            if (pos[0] + len > data.size) throw IOException(\"truncated hpack string body\")\n"
   "            val value = if (huffman) {\n"
   "                huffDecode(data, pos[0], len)\n"
   "            } else {\n"
   "                String(data, pos[0], len, StandardCharsets.UTF_8)\n"
   "            }\n"
   "            pos[0] += len\n"
   "            return value\n"
   "        }\n"
   "\n"
   "        fun decode(block: ByteArray): List<Array<String>> {\n"
   "            val out = ArrayList<Array<String>>()\n"
   "            val pos = intArrayOf(0)\n"
   "            while (pos[0] < block.size) {\n"
   "                val b = block[pos[0]].toInt() and 0xff\n"
   "                if ((b and 0x80) != 0) {\n"
   "                    val index = readInt(block, pos, 7)\n"
   "                    out.add(entry(index))\n"
   "                } else if ((b and 0xe0) == 0x20) {\n"
   "                    readInt(block, pos, 5)\n"
   "                } else {\n"
   "                    val incremental = (b and 0xc0) == 0x40\n"
   "                    val index = readInt(block, pos, if (incremental) 6 else 4)\n"
   "                    val name = if (index > 0) entry(index)[0] else readString(block, pos)\n"
   "                    val value = readString(block, pos)\n"
   "                    out.add(arrayOf(name, value))\n"
   "                    if (incremental) add(name, value)\n"
   "                }\n"
   "            }\n"
   "            return out\n"
   "        }\n"
   "\n"
   "        companion object {\n"
   "            const val MAX_DYNAMIC = 4096\n"
   "        }\n"
   "    }\n"
   "\n"
   "    private val scheme: String = if (tlsFactory != null) \"https\" else \"http\"\n"
   "    private val socket: Socket\n"
   "    private val inp: DataInputStream\n"
   "    private val out: OutputStream\n"
   "    private val sendLock = Object()\n"
   "    private val queue = LinkedBlockingQueue<ByteArray>()\n"
   "    private val decoder = HpackDecoder()\n"
   "    private val cond = Object()\n"
   "    private var connWindow = 65535L\n"
   "    private val streamWindows = HashMap<Long, Long>()\n"
   "    private var peerInitialWindow = 65535L\n"
   "    private val dataBuffers = HashMap<Long, ByteArrayOutputStream>()\n"
   "    private val headerBlocks = HashMap<Long, ByteArrayOutputStream>()\n"
   "    private val headersSeen = HashSet<Long>()\n"
   "    private val compressOut = HashMap<Long, Boolean>()\n"
   "    private val decompressIn = HashSet<Long>()\n"
   "\n"
   "    @Volatile\n"
   "    private var closed = false\n"
   "\n"
   "    init {\n"
   "        var host = authority\n"
   "        var port = if (tlsFactory != null) 443 else 80\n"
   "        val colon = authority.lastIndexOf(':')\n"
   "        if (colon > 0) {\n"
   "            host = authority.substring(0, colon)\n"
   "            port = authority.substring(colon + 1).toInt()\n"
   "        }\n"
   "        val sock: Socket\n"
   "        if (tlsFactory != null) {\n"
   "            val ssl = tlsFactory.createSocket(host, port) as SSLSocket\n"
   "            val params: SSLParameters = ssl.sslParameters\n"
   "            params.applicationProtocols = arrayOf(\"h2\")\n"
   "            val sni = serverName ?: host\n"
   "            params.serverNames = listOf(javax.net.ssl.SNIHostName(sni))\n"
   "            ssl.sslParameters = params\n"
   "            ssl.startHandshake()\n"
   "            if (\"h2\" != ssl.applicationProtocol) {\n"
   "                ssl.close()\n"
   "                throw IOException(\"ALPN did not negotiate h2\")\n"
   "            }\n"
   "            sock = ssl\n"
   "        } else {\n"
   "            sock = Socket(host, port)\n"
   "        }\n"
   "        socket = sock\n"
   "        inp = DataInputStream(sock.getInputStream())\n"
   "        out = sock.getOutputStream()\n"
   "        // Connection preface + an empty SETTINGS frame.\n"
   "        val preface = \"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n\".toByteArray(StandardCharsets.UTF_8)\n"
   "        synchronized(sendLock) {\n"
   "            out.write(preface)\n"
   "            writeFrame(H2_SETTINGS, 0, 0, ByteArray(0))\n"
   "            out.flush()\n"
   "        }\n"
   "        val reader = Thread({ readerLoop() }, \"http2-reader\")\n"
   "        reader.isDaemon = true\n"
   "        reader.start()\n"
   "    }\n"
   "\n"
   "    private fun writeFrame(type: Int, flags: Int, streamId: Long, payload: ByteArray) {\n"
   "        val header = ByteArray(9)\n"
   "        header[0] = (payload.size shr 16).toByte()\n"
   "        header[1] = (payload.size shr 8).toByte()\n"
   "        header[2] = payload.size.toByte()\n"
   "        header[3] = type.toByte()\n"
   "        header[4] = flags.toByte()\n"
   "        header[5] = (streamId shr 24).toByte()\n"
   "        header[6] = (streamId shr 16).toByte()\n"
   "        header[7] = (streamId shr 8).toByte()\n"
   "        header[8] = streamId.toByte()\n"
   "        synchronized(sendLock) {\n"
   "            out.write(header)\n"
   "            out.write(payload)\n"
   "            out.flush()\n"
   "        }\n"
   "    }\n"
   "\n"
   "    private fun emit(frameType: Long, streamId: Long, payload: ByteArray) {\n"
   "        queue.offer(Codec.encodeFrame(frameType.toInt(), streamId, payload))\n"
   "    }\n"
   "\n"
   "    private fun emitHeadersFrame(streamId: Long, metadata: Map<String, String>) {\n"
   "        val sb = StringBuilder(\"{\\\"metadata\\\":{\")\n"
   "        var first = true\n"
   "        for ((key, value) in metadata) {\n"
   "            if (!first) sb.append(',')\n"
   "            first = false\n"
   "            sb.append(Codec.jsonString(key)).append(':').append(Codec.jsonString(value))\n"
   "        }\n"
   "        sb.append(\"}}\")\n"
   "        emit(Wire.FRAME_HEADERS.toLong(), streamId, sb.toString().toByteArray(StandardCharsets.UTF_8))\n"
   "    }\n"
   "\n"
   "    private fun emitTrailersFrame(streamId: Long, code: Long, message: String, metadata: Map<String, String>?) {\n"
   "        val sb = StringBuilder()\n"
   "        sb.append(\"{\\\"code\\\":\").append(code).append(\",\\\"message\\\":\").append(Codec.jsonString(message))\n"
   "        if (metadata != null && metadata.isNotEmpty()) {\n"
   "            sb.append(\",\\\"metadata\\\":{\")\n"
   "            var first = true\n"
   "            for ((key, value) in metadata) {\n"
   "                if (!first) sb.append(',')\n"
   "                first = false\n"
   "                sb.append(Codec.jsonString(key)).append(':').append(Codec.jsonString(value))\n"
   "            }\n"
   "            sb.append('}')\n"
   "        }\n"
   "        sb.append('}')\n"
   "        emit(Wire.FRAME_TRAILERS.toLong(), streamId, sb.toString().toByteArray(StandardCharsets.UTF_8))\n"
   "    }\n"
   "\n"
   "    private fun readerLoop() {\n"
   "        try {\n"
   "            val header = ByteArray(9)\n"
   "            while (true) {\n"
   "                inp.readFully(header)\n"
   "                val len = ((header[0].toInt() and 0xff) shl 16) or ((header[1].toInt() and 0xff) shl 8) or (header[2].toInt() and 0xff)\n"
   "                val type = header[3].toInt() and 0xff\n"
   "                val flags = header[4].toInt() and 0xff\n"
   "                val streamId = ((header[5].toInt() and 0x7f).toLong() shl 24) or ((header[6].toInt() and 0xff).toLong() shl 16) or\n"
   "                    ((header[7].toInt() and 0xff).toLong() shl 8) or (header[8].toInt() and 0xff).toLong()\n"
   "                val payload = ByteArray(len)\n"
   "                inp.readFully(payload)\n"
   "                if (!onFrame(type, flags, streamId, payload)) {\n"
   "                    return\n"
   "                }\n"
   "            }\n"
   "        } catch (e: Exception) {\n"
   "            // Closed by peer or locally: recv() reports EOF.\n"
   "        } finally {\n"
   "            closed = true\n"
   "            synchronized(cond) { cond.notifyAll() }\n"
   "            queue.offer(CLOSED_MARK)\n"
   "        }\n"
   "    }\n"
   "\n"
   "    private fun onFrame(type: Int, flags: Int, streamId: Long, payload: ByteArray): Boolean {\n"
   "        when (type) {\n"
   "            H2_SETTINGS -> {\n"
   "                if ((flags and FLAG_ACK) != 0) return true\n"
   "                var newInitial = peerInitialWindow\n"
   "                var off = 0\n"
   "                while (off + 6 <= payload.size) {\n"
   "                    val ident = ((payload[off].toInt() and 0xff) shl 8) or (payload[off + 1].toInt() and 0xff)\n"
   "                    val value = ((payload[off + 2].toInt() and 0xff).toLong() shl 24) or ((payload[off + 3].toInt() and 0xff).toLong() shl 16) or\n"
   "                        ((payload[off + 4].toInt() and 0xff).toLong() shl 8) or (payload[off + 5].toInt() and 0xff).toLong()\n"
   "                    if (ident == 0x3) newInitial = value\n"
   "                    off += 6\n"
   "                }\n"
   "                val delta = newInitial - peerInitialWindow\n"
   "                peerInitialWindow = newInitial\n"
   "                if (delta != 0L) {\n"
   "                    synchronized(cond) {\n"
   "                        for ((key, value) in streamWindows) {\n"
   "                            streamWindows[key] = value + delta\n"
   "                        }\n"
   "                        cond.notifyAll()\n"
   "                    }\n"
   "                }\n"
   "                writeFrame(H2_SETTINGS, FLAG_ACK, 0, ByteArray(0))\n"
   "            }\n"
   "            H2_WINDOW_UPDATE -> {\n"
   "                if (payload.size >= 4) {\n"
   "                    val inc = ((payload[0].toInt() and 0x7f).toLong() shl 24) or ((payload[1].toInt() and 0xff).toLong() shl 16) or\n"
   "                        ((payload[2].toInt() and 0xff).toLong() shl 8) or (payload[3].toInt() and 0xff).toLong()\n"
   "                    synchronized(cond) {\n"
   "                        if (streamId == 0L) {\n"
   "                            connWindow += inc\n"
   "                        } else {\n"
   "                            streamWindows[streamId] = (streamWindows[streamId] ?: 0L) + inc\n"
   "                        }\n"
   "                        cond.notifyAll()\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            H2_PING -> {\n"
   "                if ((flags and FLAG_ACK) == 0 && payload.size == 8) {\n"
   "                    writeFrame(H2_PING, FLAG_ACK, 0, payload)\n"
   "                }\n"
   "            }\n"
   "            H2_RST_STREAM -> emit(\n"
   "                Wire.FRAME_RST.toLong(), streamId,\n"
   "                \"{\\\"code\\\":8,\\\"message\\\":\\\"rst stream\\\"}\".toByteArray(StandardCharsets.UTF_8))\n"
   "            H2_HEADERS, H2_CONTINUATION -> {\n"
   "                val block = headerBlocks.getOrPut(streamId) { ByteArrayOutputStream() }\n"
   "                block.write(payload, 0, payload.size)\n"
   "                if ((flags and FLAG_END_HEADERS) != 0) {\n"
   "                    headerBlocks.remove(streamId)\n"
   "                    onHeaders(streamId, (flags and FLAG_END_STREAM) != 0, block.toByteArray())\n"
   "                }\n"
   "            }\n"
   "            H2_DATA -> {\n"
   "                var body = payload\n"
   "                if ((flags and FLAG_PADDED) != 0 && body.isNotEmpty()) {\n"
   "                    val pad = body[0].toInt() and 0xff\n"
   "                    body = if (pad + 1 <= body.size) body.copyOfRange(1, body.size - pad) else ByteArray(0)\n"
   "                }\n"
   "                if (body.isNotEmpty()) {\n"
   "                    val wu = ByteArrayOutputStream()\n"
   "                    writeWindowUpdate(wu, body.size)\n"
   "                    writeFrame(H2_WINDOW_UPDATE, 0, 0, wu.toByteArray())\n"
   "                    val wu2 = ByteArrayOutputStream()\n"
   "                    writeWindowUpdate(wu2, body.size)\n"
   "                    writeFrame(H2_WINDOW_UPDATE, 0, streamId, wu2.toByteArray())\n"
   "                    val buf = dataBuffers.getOrPut(streamId) { ByteArrayOutputStream() }\n"
   "                    buf.write(body, 0, body.size)\n"
   "                    drainMessages(streamId)\n"
   "                }\n"
   "                if ((flags and FLAG_END_STREAM) != 0) {\n"
   "                    emitTrailersFrame(streamId, 2, \"missing grpc-status\", null)\n"
   "                }\n"
   "            }\n"
   "            else -> {\n"
   "                // GOAWAY and unknown frames: nothing to do.\n"
   "            }\n"
   "        }\n"
   "        return true\n"
   "    }\n"
   "\n"
   "    private fun writeWindowUpdate(out: ByteArrayOutputStream, increment: Int) {\n"
   "        out.write((increment shr 24) and 0x7f)\n"
   "        out.write((increment shr 16) and 0xff)\n"
   "        out.write((increment shr 8) and 0xff)\n"
   "        out.write(increment and 0xff)\n"
   "    }\n"
   "\n"
   "    private fun onHeaders(streamId: Long, endStream: Boolean, block: ByteArray) {\n"
   "        val headers = decoder.decode(block)\n"
   "        val metadata = LinkedHashMap<String, String>()\n"
   "        var status: String? = null\n"
   "        var message: String? = null\n"
   "        for (h in headers) {\n"
   "            val name = h[0]\n"
   "            val value = h[1]\n"
   "            when {\n"
   "                name == \"grpc-status\" -> status = value\n"
   "                name == \"grpc-message\" -> message = value\n"
   "                name == \"grpc-encoding\" -> {\n"
   "                    if (value == \"gzip\") decompressIn.add(streamId)\n"
   "                }\n"
   "                name.startsWith(\":\") || name == \"content-type\" || name == \"grpc-accept-encoding\" -> {\n"
   "                    // transport-owned: not metadata\n"
   "                }\n"
   "                else -> metadata.putIfAbsent(name, value)\n"
   "            }\n"
   "        }\n"
   "        val first = headersSeen.add(streamId)\n"
   "        if (endStream && status != null) {\n"
   "            emitTrailersFrame(streamId, status.toLong(), percentDecode(message ?: \"\"), metadata)\n"
   "        } else if (first) {\n"
   "            emitHeadersFrame(streamId, metadata)\n"
   "            if (endStream) {\n"
   "                emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata)\n"
   "            }\n"
   "        } else if (endStream) {\n"
   "            emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata)\n"
   "        }\n"
   "    }\n"
   "\n"
   "    private fun drainMessages(streamId: Long) {\n"
   "        val buf = dataBuffers[streamId] ?: return\n"
   "        val data = buf.toByteArray()\n"
   "        var off = 0\n"
   "        while (data.size - off >= 5) {\n"
   "            val mlen = ((data[off + 1].toInt() and 0xff).toLong() shl 24) or ((data[off + 2].toInt() and 0xff).toLong() shl 16) or\n"
   "                ((data[off + 3].toInt() and 0xff).toLong() shl 8) or (data[off + 4].toInt() and 0xff).toLong()\n"
   "            if (data.size - off - 5 < mlen) break\n"
   "            val compressed = data[off].toInt() and 0xff\n"
   "            var message = data.copyOfRange(off + 5, off + 5 + mlen.toInt())\n"
   "            off += 5 + mlen.toInt()\n"
   "            if (compressed == 1 || decompressIn.contains(streamId)) {\n"
   "                message = gunzip(message)\n"
   "            }\n"
   "            emit(Wire.FRAME_DATA.toLong(), streamId, message)\n"
   "        }\n"
   "        buf.reset()\n"
   "        buf.write(data, off, data.size - off)\n"
   "    }\n"
   "\n"
   "    override fun send(message: ByteArray) {\n"
   "        if (message.size < 9) throw IOException(\"short frame\")\n"
   "        val type = message[0].toInt() and 0xff\n"
   "        val streamId = ((message[1].toInt() and 0xff).toLong() shl 24) or ((message[2].toInt() and 0xff).toLong() shl 16) or\n"
   "            ((message[3].toInt() and 0xff).toLong() shl 8) or (message[4].toInt() and 0xff).toLong()\n"
   "        val flen = ((message[5].toInt() and 0xff) shl 24) or ((message[6].toInt() and 0xff) shl 16) or\n"
   "            ((message[7].toInt() and 0xff) shl 8) or (message[8].toInt() and 0xff)\n"
   "        val payload = message.copyOfRange(9, 9 + flen)\n"
   "        when (type) {\n"
   "            Wire.FRAME_HEADERS -> {\n"
   "                val body = Codec.parseJsonObject(String(payload, StandardCharsets.UTF_8))\n"
   "                val path = body[\"path\"] as? String ?: \"\"\n"
   "                val metadata = LinkedHashMap<String, String>()\n"
   "                val md = body[\"metadata\"]\n"
   "                if (md is Map<*, *>) {\n"
   "                    for ((key, value) in md) {\n"
   "                        metadata[key.toString()] = value.toString()\n"
   "                    }\n"
   "                }\n"
   "                synchronized(cond) {\n"
   "                    streamWindows.putIfAbsent(streamId, peerInitialWindow)\n"
   "                }\n"
   "                if (metadata[\"grpc-encoding\"] == \"gzip\") {\n"
   "                    compressOut[streamId] = true\n"
   "                }\n"
   "                val block = ByteArrayOutputStream()\n"
   "                block.write(0x83) // :method: POST\n"
   "                block.write(if (scheme == \"https\") 0x87 else 0x86) // :scheme\n"
   "                writeLiteralIndexedName(block, 4, path) // :path\n"
   "                writeLiteralIndexedName(block, 1, authority) // :authority\n"
   "                writeLiteralIndexedName(block, 31, \"application/grpc\") // content-type\n"
   "                writeLiteralNewName(block, \"grpc-accept-encoding\", \"gzip,identity\")\n"
   "                writeLiteralNewName(block, \"te\", \"trailers\")\n"
   "                for ((key, value) in metadata) {\n"
   "                    val k = key.lowercase()\n"
   "                    if (k == \"grpc-encoding\") {\n"
   "                        writeLiteralNewName(block, k, \"gzip\")\n"
   "                    } else {\n"
   "                        writeLiteralNewName(block, k, value)\n"
   "                    }\n"
   "                }\n"
   "                writeFrame(H2_HEADERS, FLAG_END_HEADERS, streamId, block.toByteArray())\n"
   "            }\n"
   "            Wire.FRAME_DATA -> {\n"
   "                val compressed = compressOut[streamId] == true\n"
   "                var body = payload\n"
   "                if (compressed) body = gzip(payload)\n"
   "                val wire = ByteArray(5 + body.size)\n"
   "                wire[0] = (if (compressed) 1 else 0).toByte()\n"
   "                wire[1] = (body.size shr 24).toByte()\n"
   "                wire[2] = (body.size shr 16).toByte()\n"
   "                wire[3] = (body.size shr 8).toByte()\n"
   "                wire[4] = body.size.toByte()\n"
   "                body.copyInto(wire, 5)\n"
   "                var sent = 0\n"
   "                while (sent < wire.size) {\n"
   "                    var allowance = 0\n"
   "                    synchronized(cond) {\n"
   "                        while (!closed && (connWindow <= 0 ||\n"
   "                                (streamWindows[streamId] ?: peerInitialWindow) <= 0)) {\n"
   "                            cond.wait()\n"
   "                        }\n"
   "                        if (closed) throw IOException(\"transport closed\")\n"
   "                        val sw = streamWindows[streamId] ?: peerInitialWindow\n"
   "                        allowance = minOf(minOf(connWindow, sw),\n"
   "                            minOf(MAX_FRAME_PAYLOAD.toLong(), (wire.size - sent).toLong())).toInt()\n"
   "                        connWindow -= allowance\n"
   "                        streamWindows[streamId] = sw - allowance\n"
   "                    }\n"
   "                    writeFrame(H2_DATA, 0, streamId, wire.copyOfRange(sent, sent + allowance))\n"
   "                    sent += allowance\n"
   "                }\n"
   "            }\n"
   "            Wire.FRAME_HALF_CLOSE -> writeFrame(H2_DATA, FLAG_END_STREAM, streamId, ByteArray(0))\n"
   "            Wire.FRAME_RST -> writeFrame(H2_RST_STREAM, 0, streamId, byteArrayOf(0, 0, 0, 8))\n"
   "            else -> {\n"
   "                // Trailers never travel client -> server here.\n"
   "            }\n"
   "        }\n"
   "    }\n"
   "\n"
   "    override fun recv(): ByteArray {\n"
   "        val msg = queue.take()\n"
   "        if (msg === CLOSED_MARK) {\n"
   "            queue.offer(CLOSED_MARK)\n"
   "            throw EOFException(\"transport closed\")\n"
   "        }\n"
   "        return msg\n"
   "    }\n"
   "\n"
   "    override fun close() {\n"
   "        try {\n"
   "            socket.close()\n"
   "        } catch (e: IOException) {\n"
   "            // already closed\n"
   "        }\n"
   "    }\n"
   "\n"
   "}\n"
   ))

(define (emit-kotlin-http2)
  (cons "Http2Transport.kt"
        (string-replace
         (string-replace
          (string-replace kotlin-http2-body
                          "KT_STATIC_TABLE" (kt-static-table))
          "KT_HUFF_CODES" (kt-huff-codes))
         "KT_HUFF_LENS" (kt-huff-lens))))

;; ---------------------------------------------------------------------------
;; Scala emitter -> scala/grpcdc/Http2Transport.scala
;; ---------------------------------------------------------------------------

(define (sc-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "Array(~s, ~s)," (car e) (cdr e)))
   "\n    "))

(define (sc-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (sc-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define scala-http2-body
  (string-append
   "package grpcdc\n"
   "\n"
   "import java.io.ByteArrayInputStream\n"
   "import java.io.ByteArrayOutputStream\n"
   "import java.io.DataInputStream\n"
   "import java.io.EOFException\n"
   "import java.io.IOException\n"
   "import java.net.Socket\n"
   "import java.nio.charset.StandardCharsets\n"
   "import java.util.concurrent.LinkedBlockingQueue\n"
   "import java.util.zip.GZIPInputStream\n"
   "import java.util.zip.GZIPOutputStream\n"
   "import javax.net.ssl.SSLContext\n"
   "import javax.net.ssl.SSLParameters\n"
   "import javax.net.ssl.SSLSocket\n"
   "import javax.net.ssl.SSLSocketFactory\n"
   "\n"
   "/**\n"
   " * Cleartext/TLS HTTP/2 frame transport (RFC 9113, generated\n"
   " * from http2-spec.rkt) over a TCP socket: a generated client\n"
   " * can dial a stock gRPC server directly (grpc-java server,\n"
   " * grpc-go server), no bridge process. TLS via dialTls (ALPN\n"
   " * h2). Client endpoints only.\n"
   " */\n"
   "class Http2Transport private (\n"
   "    private val authority: String,\n"
   "    tlsFactory: SSLSocketFactory,\n"
   "    serverName: String,\n"
   ") extends Transport {\n"
   "  import Http2Transport.*\n"
   "\n"
   "  private val scheme: String = if (tlsFactory != null) \"https\" else \"http\"\n"
   "  private val socket: Socket = {\n"
   "    var host = authority\n"
   "    var port = if (tlsFactory != null) 443 else 80\n"
   "    val colon = authority.lastIndexOf(':')\n"
   "    if (colon > 0) {\n"
   "      host = authority.substring(0, colon)\n"
   "      port = authority.substring(colon + 1).toInt\n"
   "    }\n"
   "    if (tlsFactory != null) {\n"
   "      val ssl = tlsFactory.createSocket(host, port).asInstanceOf[SSLSocket]\n"
   "      val params: SSLParameters = ssl.getSSLParameters\n"
   "      params.setApplicationProtocols(Array(\"h2\"))\n"
   "      val sni = if (serverName != null) serverName else host\n"
   "      params.setServerNames(java.util.List.of(new javax.net.ssl.SNIHostName(sni)))\n"
   "      ssl.setSSLParameters(params)\n"
   "      ssl.startHandshake()\n"
   "      if (\"h2\" != ssl.getApplicationProtocol) {\n"
   "        ssl.close()\n"
   "        throw new IOException(\"ALPN did not negotiate h2\")\n"
   "      }\n"
   "      ssl\n"
   "    } else {\n"
   "      new Socket(host, port)\n"
   "    }\n"
   "  }\n"
   "  private val inp = new DataInputStream(socket.getInputStream)\n"
   "  private val out = socket.getOutputStream\n"
   "  private val sendLock = new Object()\n"
   "  private val queue = new LinkedBlockingQueue[Array[Byte]]()\n"
   "  private val decoder = new Http2Transport.HpackDecoder()\n"
   "  private val cond = new Object()\n"
   "  private var connWindow = 65535L\n"
   "  private val streamWindows = new java.util.HashMap[Long, Long]()\n"
   "  private var peerInitialWindow = 65535L\n"
   "  private val dataBuffers = new java.util.HashMap[Long, ByteArrayOutputStream]()\n"
   "  private val headerBlocks = new java.util.HashMap[Long, ByteArrayOutputStream]()\n"
   "  private val headersSeen = new java.util.HashSet[Long]()\n"
   "  private val compressOut = new java.util.HashMap[Long, Boolean]()\n"
   "  private val decompressIn = new java.util.HashSet[Long]()\n"
   "\n"
   "  @volatile private var closed = false\n"
   "\n"
   "  // Connection preface + an empty SETTINGS frame.\n"
   "  {\n"
   "    val preface = \"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n\".getBytes(StandardCharsets.UTF_8)\n"
   "    sendLock.synchronized {\n"
   "      out.write(preface)\n"
   "      writeFrame(H2_SETTINGS, 0, 0, new Array[Byte](0))\n"
   "      out.flush()\n"
   "    }\n"
   "    val reader = new Thread(() => readerLoop(), \"http2-reader\")\n"
   "    reader.setDaemon(true)\n"
   "    reader.start()\n"
   "  }\n"
   "\n"
   "  private def writeFrame(frameType: Int, flags: Int, streamId: Long, payload: Array[Byte]): Unit = {\n"
   "    val header = new Array[Byte](9)\n"
   "    header(0) = (payload.length >> 16).toByte\n"
   "    header(1) = (payload.length >> 8).toByte\n"
   "    header(2) = payload.length.toByte\n"
   "    header(3) = frameType.toByte\n"
   "    header(4) = flags.toByte\n"
   "    header(5) = (streamId >> 24).toByte\n"
   "    header(6) = (streamId >> 16).toByte\n"
   "    header(7) = (streamId >> 8).toByte\n"
   "    header(8) = streamId.toByte\n"
   "    sendLock.synchronized {\n"
   "      out.write(header)\n"
   "      out.write(payload)\n"
   "      out.flush()\n"
   "    }\n"
   "  }\n"
   "\n"
   "  private def emit(frameType: Int, streamId: Long, payload: Array[Byte]): Unit = {\n"
   "    queue.offer(Codec.encodeFrame(frameType, streamId, payload))\n"
   "  }\n"
   "\n"
   "  private def emitHeadersFrame(streamId: Long, metadata: Map[String, String]): Unit = {\n"
   "    val sb = new StringBuilder(\"{\\\"metadata\\\":{\")\n"
   "    var first = true\n"
   "    for ((key, value) <- metadata) {\n"
   "      if (!first) sb.append(',')\n"
   "      first = false\n"
   "      sb.append(Codec.jsonString(key)).append(':').append(Codec.jsonString(value))\n"
   "    }\n"
   "    sb.append(\"}}\")\n"
   "    emit(Wire.FRAME_HEADERS, streamId, sb.toString.getBytes(StandardCharsets.UTF_8))\n"
   "  }\n"
   "\n"
   "  private def emitTrailersFrame(streamId: Long, code: Long, message: String, metadata: Map[String, String]): Unit = {\n"
   "    val sb = new StringBuilder()\n"
   "    sb.append(\"{\\\"code\\\":\").append(code).append(\",\\\"message\\\":\").append(Codec.jsonString(message))\n"
   "    if (metadata != null && metadata.nonEmpty) {\n"
   "      sb.append(\",\\\"metadata\\\":{\")\n"
   "      var first = true\n"
   "      for ((key, value) <- metadata) {\n"
   "        if (!first) sb.append(',')\n"
   "        first = false\n"
   "        sb.append(Codec.jsonString(key)).append(':').append(Codec.jsonString(value))\n"
   "      }\n"
   "      sb.append('}')\n"
   "    }\n"
   "    sb.append('}')\n"
   "    emit(Wire.FRAME_TRAILERS, streamId, sb.toString.getBytes(StandardCharsets.UTF_8))\n"
   "  }\n"
   "\n"
   "  private def readerLoop(): Unit = {\n"
   "    try {\n"
   "      val header = new Array[Byte](9)\n"
   "      var running = true\n"
   "      while (running) {\n"
   "        inp.readFully(header)\n"
   "        val len = ((header(0) & 0xff) << 16) | ((header(1) & 0xff) << 8) | (header(2) & 0xff)\n"
   "        val frameType = header(3) & 0xff\n"
   "        val flags = header(4) & 0xff\n"
   "        val streamId = ((header(5) & 0x7f).toLong << 24) | ((header(6) & 0xff).toLong << 16) |\n"
   "          ((header(7) & 0xff).toLong << 8) | (header(8) & 0xff).toLong\n"
   "        val payload = new Array[Byte](len)\n"
   "        inp.readFully(payload)\n"
   "        running = onFrame(frameType, flags, streamId, payload)\n"
   "      }\n"
   "    } catch {\n"
   "      case _: Exception => // Closed by peer or locally: recv() reports EOF.\n"
   "    } finally {\n"
   "      closed = true\n"
   "      cond.synchronized { cond.notifyAll() }\n"
   "      queue.offer(CLOSED_MARK)\n"
   "    }\n"
   "  }\n"
   "\n"
   "  private def onFrame(frameType: Int, flags: Int, streamId: Long, payload: Array[Byte]): Boolean = {\n"
   "    frameType match {\n"
   "      case H2_SETTINGS =>\n"
   "        if ((flags & FLAG_ACK) == 0) {\n"
   "          var newInitial = peerInitialWindow\n"
   "          var off = 0\n"
   "          while (off + 6 <= payload.length) {\n"
   "            val ident = ((payload(off) & 0xff) << 8) | (payload(off + 1) & 0xff)\n"
   "            val value = ((payload(off + 2) & 0xff).toLong << 24) | ((payload(off + 3) & 0xff).toLong << 16) |\n"
   "              ((payload(off + 4) & 0xff).toLong << 8) | (payload(off + 5) & 0xff).toLong\n"
   "            if (ident == 0x3) newInitial = value\n"
   "            off += 6\n"
   "          }\n"
   "          val delta = newInitial - peerInitialWindow\n"
   "          peerInitialWindow = newInitial\n"
   "          if (delta != 0) {\n"
   "            cond.synchronized {\n"
   "              val it = streamWindows.entrySet().iterator()\n"
   "              while (it.hasNext) {\n"
   "                val e = it.next()\n"
   "                e.setValue(e.getValue + delta)\n"
   "              }\n"
   "              cond.notifyAll()\n"
   "            }\n"
   "          }\n"
   "          writeFrame(H2_SETTINGS, FLAG_ACK, 0, new Array[Byte](0))\n"
   "        }\n"
   "      case H2_WINDOW_UPDATE =>\n"
   "        if (payload.length >= 4) {\n"
   "          val inc = ((payload(0) & 0x7f).toLong << 24) | ((payload(1) & 0xff).toLong << 16) |\n"
   "            ((payload(2) & 0xff).toLong << 8) | (payload(3) & 0xff).toLong\n"
   "          cond.synchronized {\n"
   "            if (streamId == 0) {\n"
   "              connWindow += inc\n"
   "            } else {\n"
   "              streamWindows.put(streamId, streamWindows.getOrDefault(streamId, 0L) + inc)\n"
   "            }\n"
   "            cond.notifyAll()\n"
   "          }\n"
   "        }\n"
   "      case H2_PING =>\n"
   "        if ((flags & FLAG_ACK) == 0 && payload.length == 8) {\n"
   "          writeFrame(H2_PING, FLAG_ACK, 0, payload)\n"
   "        }\n"
   "      case H2_RST_STREAM =>\n"
   "        emit(Wire.FRAME_RST, streamId, \"{\\\"code\\\":8,\\\"message\\\":\\\"rst stream\\\"}\".getBytes(StandardCharsets.UTF_8))\n"
   "      case H2_HEADERS | H2_CONTINUATION =>\n"
   "        val block = headerBlocks.computeIfAbsent(streamId, _ => new ByteArrayOutputStream())\n"
   "        block.write(payload, 0, payload.length)\n"
   "        if ((flags & FLAG_END_HEADERS) != 0) {\n"
   "          headerBlocks.remove(streamId)\n"
   "          onHeaders(streamId, (flags & FLAG_END_STREAM) != 0, block.toByteArray)\n"
   "        }\n"
   "      case H2_DATA =>\n"
   "        var body = payload\n"
   "        if ((flags & FLAG_PADDED) != 0 && body.length >= 1) {\n"
   "          val pad = body(0) & 0xff\n"
   "          body = if (pad + 1 <= body.length) java.util.Arrays.copyOfRange(body, 1, body.length - pad) else new Array[Byte](0)\n"
   "        }\n"
   "        if (body.length > 0) {\n"
   "          val wu = new ByteArrayOutputStream()\n"
   "          writeWindowUpdate(wu, body.length)\n"
   "          writeFrame(H2_WINDOW_UPDATE, 0, 0, wu.toByteArray)\n"
   "          val wu2 = new ByteArrayOutputStream()\n"
   "          writeWindowUpdate(wu2, body.length)\n"
   "          writeFrame(H2_WINDOW_UPDATE, 0, streamId, wu2.toByteArray)\n"
   "          val buf = dataBuffers.computeIfAbsent(streamId, _ => new ByteArrayOutputStream())\n"
   "          buf.write(body, 0, body.length)\n"
   "          drainMessages(streamId)\n"
   "        }\n"
   "        if ((flags & FLAG_END_STREAM) != 0) {\n"
   "          emitTrailersFrame(streamId, 2, \"missing grpc-status\", null)\n"
   "        }\n"
   "      case _ => // GOAWAY and unknown frames: nothing to do.\n"
   "    }\n"
   "    true\n"
   "  }\n"
   "\n"
   "  private def writeWindowUpdate(out: ByteArrayOutputStream, increment: Int): Unit = {\n"
   "    out.write((increment >> 24) & 0x7f)\n"
   "    out.write((increment >> 16) & 0xff)\n"
   "    out.write((increment >> 8) & 0xff)\n"
   "    out.write(increment & 0xff)\n"
   "  }\n"
   "\n"
   "  private def onHeaders(streamId: Long, endStream: Boolean, block: Array[Byte]): Unit = {\n"
   "    val headers = decoder.decode(block)\n"
   "    val metadata = scala.collection.mutable.LinkedHashMap[String, String]()\n"
   "    var status: String = null\n"
   "    var message: String = null\n"
   "    for (h <- headers) {\n"
   "      val name = h(0)\n"
   "      val value = h(1)\n"
   "      if (name == \"grpc-status\") {\n"
   "        status = value\n"
   "      } else if (name == \"grpc-message\") {\n"
   "        message = value\n"
   "      } else if (name == \"grpc-encoding\") {\n"
   "        if (value == \"gzip\") decompressIn.add(streamId)\n"
   "      } else if (name.startsWith(\":\") || name == \"content-type\" || name == \"grpc-accept-encoding\") {\n"
   "        // transport-owned: not metadata\n"
   "      } else {\n"
   "        if (!metadata.contains(name)) metadata.put(name, value)\n"
   "      }\n"
   "    }\n"
   "    val first = headersSeen.add(streamId)\n"
   "    if (endStream && status != null) {\n"
   "      emitTrailersFrame(streamId, status.toLong, percentDecode(if (message != null) message else \"\"), metadata.toMap)\n"
   "    } else if (first) {\n"
   "      emitHeadersFrame(streamId, metadata.toMap)\n"
   "      if (endStream) {\n"
   "        emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata.toMap)\n"
   "      }\n"
   "    } else if (endStream) {\n"
   "      emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata.toMap)\n"
   "    }\n"
   "  }\n"
   "\n"
   "  private def drainMessages(streamId: Long): Unit = {\n"
   "    val buf = dataBuffers.get(streamId)\n"
   "    if (buf != null) {\n"
   "      val data = buf.toByteArray\n"
   "      var off = 0\n"
   "      var draining = true\n"
   "      while (draining && data.length - off >= 5) {\n"
   "        val mlen = ((data(off + 1) & 0xff).toLong << 24) | ((data(off + 2) & 0xff).toLong << 16) |\n"
   "          ((data(off + 3) & 0xff).toLong << 8) | (data(off + 4) & 0xff).toLong\n"
   "        if (data.length - off - 5 < mlen) {\n"
   "          draining = false\n"
   "        } else {\n"
   "          val compressed = data(off) & 0xff\n"
   "          var message = java.util.Arrays.copyOfRange(data, off + 5, off + 5 + mlen.toInt)\n"
   "          off += 5 + mlen.toInt\n"
   "          if (compressed == 1 || decompressIn.contains(streamId)) {\n"
   "            message = gunzip(message)\n"
   "          }\n"
   "          emit(Wire.FRAME_DATA, streamId, message)\n"
   "        }\n"
   "      }\n"
   "      buf.reset()\n"
   "      buf.write(data, off, data.length - off)\n"
   "    }\n"
   "  }\n"
   "\n"
   "  override def send(message: Array[Byte]): Unit = {\n"
   "    if (message.length < 9) throw new IOException(\"short frame\")\n"
   "    val frameType = message(0) & 0xff\n"
   "    val streamId = ((message(1) & 0xff).toLong << 24) | ((message(2) & 0xff).toLong << 16) |\n"
   "      ((message(3) & 0xff).toLong << 8) | (message(4) & 0xff).toLong\n"
   "    val flen = ((message(5) & 0xff) << 24) | ((message(6) & 0xff) << 16) |\n"
   "      ((message(7) & 0xff) << 8) | (message(8) & 0xff)\n"
   "    val payload = java.util.Arrays.copyOfRange(message, 9, 9 + flen)\n"
   "    frameType match {\n"
   "      case Wire.FRAME_HEADERS =>\n"
   "        val body = Codec.parseJsonObject(new String(payload, StandardCharsets.UTF_8))\n"
   "        val path: String = body.get(\"path\") match {\n"
   "          case Some(str: String) => str\n"
   "          case _ => \"\"\n"
   "        }\n"
   "        val metadata = scala.collection.mutable.LinkedHashMap[String, String]()\n"
   "        body.get(\"metadata\") match {\n"
   "          case Some(md: Map[_, _]) =>\n"
   "            for ((k, v) <- md) metadata.put(k.toString, v.toString)\n"
   "          case _ => ()\n"
   "        }\n"
   "        cond.synchronized {\n"
   "          streamWindows.putIfAbsent(streamId, peerInitialWindow)\n"
   "        }\n"
   "        if (metadata.get(\"grpc-encoding\").contains(\"gzip\")) {\n"
   "          compressOut.put(streamId, true)\n"
   "        }\n"
   "        val block = new ByteArrayOutputStream()\n"
   "        block.write(0x83) // :method: POST\n"
   "        block.write(if (scheme == \"https\") 0x87 else 0x86) // :scheme\n"
   "        writeLiteralIndexedName(block, 4, path) // :path\n"
   "        writeLiteralIndexedName(block, 1, authority) // :authority\n"
   "        writeLiteralIndexedName(block, 31, \"application/grpc\") // content-type\n"
   "        writeLiteralNewName(block, \"grpc-accept-encoding\", \"gzip,identity\")\n"
   "        writeLiteralNewName(block, \"te\", \"trailers\")\n"
   "        for ((key, value) <- metadata) {\n"
   "          val k = key.toLowerCase(java.util.Locale.ROOT)\n"
   "          if (k == \"grpc-encoding\") {\n"
   "            writeLiteralNewName(block, k, \"gzip\")\n"
   "          } else {\n"
   "            writeLiteralNewName(block, k, value)\n"
   "          }\n"
   "        }\n"
   "        writeFrame(H2_HEADERS, FLAG_END_HEADERS, streamId, block.toByteArray)\n"
   "      case Wire.FRAME_DATA =>\n"
   "        val compressed = compressOut.getOrDefault(streamId, false)\n"
   "        var body = payload\n"
   "        if (compressed) body = gzip(payload)\n"
   "        val wire = new Array[Byte](5 + body.length)\n"
   "        wire(0) = (if (compressed) 1 else 0).toByte\n"
   "        wire(1) = (body.length >> 24).toByte\n"
   "        wire(2) = (body.length >> 16).toByte\n"
   "        wire(3) = (body.length >> 8).toByte\n"
   "        wire(4) = body.length.toByte\n"
   "        System.arraycopy(body, 0, wire, 5, body.length)\n"
   "        var sent = 0\n"
   "        while (sent < wire.length) {\n"
   "          var allowance = 0\n"
   "          cond.synchronized {\n"
   "            while (!closed && (connWindow <= 0 || streamWindows.getOrDefault(streamId, peerInitialWindow) <= 0)) {\n"
   "              cond.wait()\n"
   "            }\n"
   "            if (closed) throw new IOException(\"transport closed\")\n"
   "            val sw = streamWindows.getOrDefault(streamId, peerInitialWindow)\n"
   "            allowance = math.min(math.min(connWindow, sw), math.min(MAX_FRAME_PAYLOAD.toLong, (wire.length - sent).toLong)).toInt\n"
   "            connWindow -= allowance\n"
   "            streamWindows.put(streamId, sw - allowance)\n"
   "          }\n"
   "          writeFrame(H2_DATA, 0, streamId, java.util.Arrays.copyOfRange(wire, sent, sent + allowance))\n"
   "          sent += allowance\n"
   "        }\n"
   "      case Wire.FRAME_HALF_CLOSE =>\n"
   "        writeFrame(H2_DATA, FLAG_END_STREAM, streamId, new Array[Byte](0))\n"
   "      case Wire.FRAME_RST =>\n"
   "        writeFrame(H2_RST_STREAM, 0, streamId, Array[Byte](0, 0, 0, 8))\n"
   "      case _ => // Trailers never travel client -> server here.\n"
   "    }\n"
   "  }\n"
   "\n"
   "  override def recv(): Array[Byte] = {\n"
   "    val msg = queue.take()\n"
   "    if (msg eq CLOSED_MARK) {\n"
   "      queue.offer(CLOSED_MARK)\n"
   "      throw new EOFException(\"transport closed\")\n"
   "    }\n"
   "    msg\n"
   "  }\n"
   "\n"
   "  override def close(): Unit = {\n"
   "    try {\n"
   "      socket.close()\n"
   "    } catch {\n"
   "      case _: IOException => // already closed\n"
   "    }\n"
   "  }\n"
   "}\n"
   "\n"
   "object Http2Transport {\n"
   "  val H2_DATA = 0x0\n"
   "  val H2_HEADERS = 0x1\n"
   "  val H2_RST_STREAM = 0x3\n"
   "  val H2_SETTINGS = 0x4\n"
   "  val H2_PING = 0x6\n"
   "  val H2_WINDOW_UPDATE = 0x8\n"
   "  val H2_CONTINUATION = 0x9\n"
   "  val FLAG_END_STREAM = 0x1\n"
   "  val FLAG_END_HEADERS = 0x4\n"
   "  val FLAG_ACK = 0x1\n"
   "  val FLAG_PADDED = 0x8\n"
   "  val MAX_FRAME_PAYLOAD = 16384\n"
   "\n"
   "  private val STATIC_TABLE: Array[Array[String]] = Array(\n"
   "    SCALA_STATIC_TABLE\n"
   "  )\n"
   "\n"
   "  // Packed tables: a 257-entry array literal would exceed the\n"
   "  // JVM 64KB method limit, so parse from text at init.\n"
   "  private val HUFF_CODES_TEXT = \"SCALA_HUFF_CODES\"\n"
   "  private val HUFF_LENS_TEXT = \"SCALA_HUFF_LENS\"\n"
   "\n"
   "  private val HUFF_CODES: Array[Int] =\n"
   "    HUFF_CODES_TEXT.split(\",\").map(s => Integer.parseInt(s.trim.stripPrefix(\"0x\"), 16))\n"
   "  private val HUFF_LENS: Array[Int] =\n"
   "    HUFF_LENS_TEXT.split(\",\").map(s => Integer.parseInt(s.trim))\n"
   "\n"
   "  private val HUFF_DECODE = new java.util.HashMap[Long, Integer]()\n"
   "  for (sym <- HUFF_CODES.indices) {\n"
   "    HUFF_DECODE.put((HUFF_LENS(sym).toLong << 32) | (HUFF_CODES(sym).toLong & 0xffffffffL), Integer.valueOf(sym))\n"
   "  }\n"
   "\n"
   "  private val CLOSED_MARK = new Array[Byte](0)\n"
   "\n"
   "  def huffDecode(data: Array[Byte], off: Int, len: Int): String = {\n"
   "    val out = new StringBuilder()\n"
   "    var code = 0L\n"
   "    var bits = 0\n"
   "    for (i <- 0 until len) {\n"
   "      val b = data(off + i) & 0xff\n"
   "      for (j <- 7 to 0 by -1) {\n"
   "        code = (code << 1) | ((b >> j) & 1)\n"
   "        bits += 1\n"
   "        val sym = HUFF_DECODE.get((bits.toLong << 32) | code)\n"
   "        if (sym != null) {\n"
   "          if (sym.intValue() == 256) throw new IOException(\"huffman EOS symbol\")\n"
   "          out.append(sym.intValue().toChar)\n"
   "          code = 0\n"
   "          bits = 0\n"
   "        } else if (bits > 30) {\n"
   "          throw new IOException(\"huffman code too long\")\n"
   "        }\n"
   "      }\n"
   "    }\n"
   "    out.toString\n"
   "  }\n"
   "\n"
   "  def writeInt(out: ByteArrayOutputStream, value: Int, prefixBits: Int, prefix: Int): Unit = {\n"
   "    val mask = (1 << prefixBits) - 1\n"
   "    if (value < mask) {\n"
   "      out.write(prefix | value)\n"
   "      return\n"
   "    }\n"
   "    out.write(prefix | mask)\n"
   "    var v = value - mask\n"
   "    while (v >= 0x80) {\n"
   "      out.write((v & 0x7f) | 0x80)\n"
   "      v = v >> 7\n"
   "    }\n"
   "    out.write(v)\n"
   "  }\n"
   "\n"
   "  def writeString(out: ByteArrayOutputStream, value: String): Unit = {\n"
   "    val raw = value.getBytes(StandardCharsets.UTF_8)\n"
   "    writeInt(out, raw.length, 7, 0)\n"
   "    out.write(raw, 0, raw.length)\n"
   "  }\n"
   "\n"
   "  def writeLiteralIndexedName(out: ByteArrayOutputStream, index: Int, value: String): Unit = {\n"
   "    writeInt(out, index, 4, 0)\n"
   "    writeString(out, value)\n"
   "  }\n"
   "\n"
   "  def writeLiteralNewName(out: ByteArrayOutputStream, name: String, value: String): Unit = {\n"
   "    writeInt(out, 0, 4, 0)\n"
   "    writeString(out, name)\n"
   "    writeString(out, value)\n"
   "  }\n"
   "\n"
   "  def gunzip(data: Array[Byte]): Array[Byte] = {\n"
   "    val out = new ByteArrayOutputStream()\n"
   "    val gz = new GZIPInputStream(new ByteArrayInputStream(data))\n"
   "    try {\n"
   "      gz.transferTo(out)\n"
   "    } finally {\n"
   "      gz.close()\n"
   "    }\n"
   "    out.toByteArray\n"
   "  }\n"
   "\n"
   "  def gzip(data: Array[Byte]): Array[Byte] = {\n"
   "    val out = new ByteArrayOutputStream()\n"
   "    val gz = new GZIPOutputStream(out)\n"
   "    try {\n"
   "      gz.write(data)\n"
   "    } finally {\n"
   "      gz.close()\n"
   "    }\n"
   "    out.toByteArray\n"
   "  }\n"
   "\n"
   "  def percentDecode(value: String): String = {\n"
   "    val bytes = new ByteArrayOutputStream()\n"
   "    var i = 0\n"
   "    while (i < value.length) {\n"
   "      val c = value.charAt(i)\n"
   "      var consumed = false\n"
   "      if (c == '%' && i + 2 < value.length) {\n"
   "        val hi = Character.digit(value.charAt(i + 1), 16)\n"
   "        val lo = Character.digit(value.charAt(i + 2), 16)\n"
   "        if (hi >= 0 && lo >= 0) {\n"
   "          bytes.write((hi << 4) | lo)\n"
   "          i += 2\n"
   "          consumed = true\n"
   "        }\n"
   "      }\n"
   "      if (!consumed) bytes.write(c.toByte)\n"
   "      i += 1\n"
   "    }\n"
   "    bytes.toString(StandardCharsets.UTF_8)\n"
   "  }\n"
   "\n"
   "  /** Cleartext (h2c, prior knowledge) connection to authority. */\n"
   "  def dial(authority: String): Http2Transport = new Http2Transport(authority, null, null)\n"
   "\n"
   "  /**\n"
   "   * TLS connection to authority (ALPN h2). context supplies\n"
   "   * trust/key material; serverName overrides SNI/verification\n"
   "   * name (defaults to the authority host).\n"
   "   */\n"
   "  def dialTls(authority: String, context: SSLContext, serverName: String): Http2Transport =\n"
   "    new Http2Transport(\n"
   "      authority,\n"
   "      (if (context != null) context.getSocketFactory else SSLSocketFactory.getDefault()).asInstanceOf[SSLSocketFactory],\n"
   "      serverName)\n"
   "\n"
   "  class HpackDecoder {\n"
   "    val dynamic = new java.util.ArrayList[Array[String]]()\n"
   "    var dynamicSize = 0\n"
   "\n"
   "    def entry(index: Int): Array[String] = {\n"
   "      if (index <= 0) throw new IOException(\"bad hpack index 0\")\n"
   "      if (index <= STATIC_TABLE.length) {\n"
   "        val e = STATIC_TABLE(index - 1)\n"
   "        return Array(e(0), e(1))\n"
   "      }\n"
   "      val j = index - STATIC_TABLE.length - 1\n"
   "      if (j >= dynamic.size()) throw new IOException(s\"bad hpack dynamic index $index\")\n"
   "      dynamic.get(j)\n"
   "    }\n"
   "\n"
   "    def add(name: String, value: String): Unit = {\n"
   "      dynamic.add(0, Array(name, value))\n"
   "      dynamicSize += name.length + value.length + 32\n"
   "      while (dynamicSize > HpackDecoder.MAX_DYNAMIC && !dynamic.isEmpty) {\n"
   "        val e = dynamic.remove(dynamic.size() - 1)\n"
   "        dynamicSize -= e(0).length + e(1).length + 32\n"
   "      }\n"
   "    }\n"
   "\n"
   "    def readInt(data: Array[Byte], pos: Array[Int], prefixBits: Int): Int = {\n"
   "      val mask = (1 << prefixBits) - 1\n"
   "      var value = data(pos(0)) & mask\n"
   "      pos(0) += 1\n"
   "      if (value < mask) return value\n"
   "      var shift = 0\n"
   "      var done = false\n"
   "      while (!done) {\n"
   "        if (pos(0) >= data.length) throw new IOException(\"truncated hpack int\")\n"
   "        val b = data(pos(0)) & 0xff\n"
   "        pos(0) += 1\n"
   "        value += (b & 0x7f) << shift\n"
   "        shift += 7\n"
   "        if ((b & 0x80) == 0) done = true\n"
   "      }\n"
   "      value\n"
   "    }\n"
   "\n"
   "    def readString(data: Array[Byte], pos: Array[Int]): String = {\n"
   "      if (pos(0) >= data.length) throw new IOException(\"truncated hpack string\")\n"
   "      val huffman = (data(pos(0)) & 0x80) != 0\n"
   "      val len = readInt(data, pos, 7)\n"
   "      if (pos(0) + len > data.length) throw new IOException(\"truncated hpack string body\")\n"
   "      val value = if (huffman) {\n"
   "        huffDecode(data, pos(0), len)\n"
   "      } else {\n"
   "        new String(data, pos(0), len, StandardCharsets.UTF_8)\n"
   "      }\n"
   "      pos(0) += len\n"
   "      value\n"
   "    }\n"
   "\n"
   "    def decode(block: Array[Byte]): List[Array[String]] = {\n"
   "      val out = scala.collection.mutable.ListBuffer[Array[String]]()\n"
   "      val pos = Array(0)\n"
   "      while (pos(0) < block.length) {\n"
   "        val b = block(pos(0)) & 0xff\n"
   "        if ((b & 0x80) != 0) {\n"
   "          val index = readInt(block, pos, 7)\n"
   "          out += entry(index)\n"
   "        } else if ((b & 0xe0) == 0x20) {\n"
   "          readInt(block, pos, 5)\n"
   "        } else {\n"
   "          val incremental = (b & 0xc0) == 0x40\n"
   "          val index = readInt(block, pos, if (incremental) 6 else 4)\n"
   "          val name = if (index > 0) entry(index)(0) else readString(block, pos)\n"
   "          val value = readString(block, pos)\n"
   "          out += Array(name, value)\n"
   "          if (incremental) add(name, value)\n"
   "        }\n"
   "      }\n"
   "      out.toList\n"
   "    }\n"
   "  }\n"
   "\n"
   "  object HpackDecoder {\n"
   "    val MAX_DYNAMIC = 4096\n"
   "  }\n"
   "}\n"
   ))

(define (emit-scala-http2)
  (cons "Http2Transport.scala"
        (string-replace
         (string-replace
          (string-replace scala-http2-body
                          "SCALA_STATIC_TABLE" (sc-static-table))
          "SCALA_HUFF_CODES" (sc-huff-codes))
         "SCALA_HUFF_LENS" (sc-huff-lens))))

;; ---------------------------------------------------------------------------
;; Dart emitter -> dart/grpcdc/http2_transport.dart
;; ---------------------------------------------------------------------------

(define (dart-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "[~s, ~s]," (car e) (cdr e)))
   "\n    "))

(define (dart-wrap-values vals)
  (define lines '())
  (define cur "    ")
  (for ([p (in-list vals)])
    (when (> (+ (string-length cur) (string-length p) 2) 100)
      (set! lines (cons cur lines))
      (set! cur "    "))
    (set! cur (string-append cur p ", ")))
  (set! lines (cons (string-trim cur #:left? #f) lines))
  (string-join (reverse lines) "\n"))

(define (dart-huff-codes)
  (dart-wrap-values (map (lambda (e) (hex (car e))) http2-huffman-codes)))

(define (dart-huff-lens)
  (dart-wrap-values (map (lambda (e) (number->string (cdr e))) http2-huffman-codes)))

(define dart-http2-body
  (string-append
   "import 'dart:async';\n"
   "import 'dart:convert';\n"
   "import 'dart:io';\n"
   "import 'dart:typed_data';\n"
   "\n"
   "import 'codec.dart';\n"
   "import 'status.dart';\n"
   "import 'transport.dart';\n"
   "import 'wire.dart';\n"
   "\n"
   "/// Cleartext/TLS HTTP/2 frame transport (RFC 9113, generated\n"
   "/// from http2-spec.rkt) over a TCP socket: a generated client\n"
   "/// can dial a stock gRPC server directly (grpc-java server,\n"
   "/// grpc-go server), no bridge process. TLS via dialTls (ALPN\n"
   "/// h2). Client endpoints only.\n"
   "class Http2Transport implements Transport {\n"
   "  static const int h2Data = 0x0;\n"
   "  static const int h2Headers = 0x1;\n"
   "  static const int h2RstStream = 0x3;\n"
   "  static const int h2Settings = 0x4;\n"
   "  static const int h2Ping = 0x6;\n"
   "  static const int h2WindowUpdate = 0x8;\n"
   "  static const int h2Continuation = 0x9;\n"
   "  static const int flagEndStream = 0x1;\n"
   "  static const int flagEndHeaders = 0x4;\n"
   "  static const int flagAck = 0x1;\n"
   "  static const int flagPadded = 0x8;\n"
   "  static const int maxFramePayload = 16384;\n"
   "\n"
   "  static const List<List<String>> staticTable = [\n"
   "    DART_STATIC_TABLE\n"
   "  ];\n"
   "\n"
   "  static const List<int> huffCodes = [\n"
   "DART_HUFF_CODES\n"
   "  ];\n"
   "\n"
   "  static const List<int> huffLens = [\n"
   "DART_HUFF_LENS\n"
   "  ];\n"
   "\n"
   "  static final Map<int, int> _huffDecode = {\n"
   "    for (var sym = 0; sym < huffCodes.length; sym++)\n"
   "      (huffLens[sym] << 32) | huffCodes[sym]: sym,\n"
   "  };\n"
   "\n"
   "  static String huffDecode(Uint8List data, int off, int len) {\n"
   "    final out = StringBuffer();\n"
   "    var code = 0;\n"
   "    var bits = 0;\n"
   "    for (var i = 0; i < len; i++) {\n"
   "      final b = data[off + i] & 0xff;\n"
   "      for (var j = 7; j >= 0; j--) {\n"
   "        code = (code << 1) | ((b >> j) & 1);\n"
   "        bits++;\n"
   "        final sym = _huffDecode[(bits << 32) | code];\n"
   "        if (sym != null) {\n"
   "          if (sym == 256) {\n"
   "            throw const FormatException('huffman EOS symbol');\n"
   "          }\n"
   "          out.writeCharCode(sym);\n"
   "          code = 0;\n"
   "          bits = 0;\n"
   "        } else if (bits > 30) {\n"
   "          throw const FormatException('huffman code too long');\n"
   "        }\n"
   "      }\n"
   "    }\n"
   "    return out.toString();\n"
   "  }\n"
   "\n"
   "  final String authority;\n"
   "  final String scheme;\n"
   "  final Socket _socket;\n"
   "  final _controller = StreamController<Uint8List>();\n"
   "  final _decoder = _HpackDecoder();\n"
   "  final _sendQueue = <Uint8List>[];\n"
   "  bool _sending = false;\n"
   "  Completer<void>? _flowNotify;\n"
   "  int _connWindow = 65535;\n"
   "  final _streamWindows = <int, int>{};\n"
   "  int _peerInitialWindow = 65535;\n"
   "  final _dataBuffers = <int, BytesBuilder>{};\n"
   "  final _headerBlocks = <int, BytesBuilder>{};\n"
   "  final _headersSeen = <int>{};\n"
   "  final _compressOut = <int>{};\n"
   "  final _decompressIn = <int>{};\n"
   "  bool _closed = false;\n"
   "  final _recvBuffer = BytesBuilder();\n"
   "\n"
   "  Http2Transport._(this.authority, this.scheme, this._socket) {\n"
   "    _socket.listen(_onSocketData, onError: (_) => _onClosed(), onDone: _onClosed);\n"
   "    // Connection preface + an empty SETTINGS frame.\n"
   "    final preface = utf8.encode('PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n');\n"
   "    _writeRaw(preface);\n"
   "    _writeFrame(h2Settings, 0, 0, Uint8List(0));\n"
   "  }\n"
   "\n"
   "  /// Cleartext (h2c, prior knowledge) connection to authority.\n"
   "  static Future<Http2Transport> dial(String authority) async {\n"
   "    final (host, port) = _splitAuthority(authority, 80);\n"
   "    final socket = await Socket.connect(host, port);\n"
   "    return Http2Transport._(authority, 'http', socket);\n"
   "  }\n"
   "\n"
   "  /// TLS connection to authority (ALPN h2). [context] supplies\n"
   "  /// trust material; [serverName] overrides SNI (defaults to\n"
   "  /// the authority host).\n"
   "  static Future<Http2Transport> dialTls(String authority, SecurityContext context,\n"
   "      {String? serverName}) async {\n"
   "    final (host, port) = _splitAuthority(authority, 443);\n"
   "    final raw = await Socket.connect(host, port);\n"
   "    final secure = await SecureSocket.secure(raw,\n"
   "        host: serverName ?? host,\n"
   "        context: context,\n"
   "        supportedProtocols: ['h2']);\n"
   "    if (secure.selectedProtocol != 'h2') {\n"
   "      await secure.close();\n"
   "      throw StateError('ALPN did not negotiate h2');\n"
   "    }\n"
   "    return Http2Transport._(authority, 'https', secure);\n"
   "  }\n"
   "\n"
   "  static (String, int) _splitAuthority(String authority, int defaultPort) {\n"
   "    final colon = authority.lastIndexOf(':');\n"
   "    if (colon > 0) {\n"
   "      return (authority.substring(0, colon), int.parse(authority.substring(colon + 1)));\n"
   "    }\n"
   "    return (authority, defaultPort);\n"
   "  }\n"
   "\n"
   "  @override\n"
   "  Stream<Uint8List> get onMessage => _controller.stream;\n"
   "\n"
   "  @override\n"
   "  void send(Uint8List data) {\n"
   "    _sendQueue.add(data);\n"
   "    if (!_sending) {\n"
   "      _sending = true;\n"
   "      unawaited(_pump());\n"
   "    }\n"
   "  }\n"
   "\n"
   "  @override\n"
   "  Future<void> close() async {\n"
   "    _onClosed();\n"
   "    try {\n"
   "      await _socket.close();\n"
   "    } catch (_) {\n"
   "      // already closed\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _onClosed() {\n"
   "    if (_closed) return;\n"
   "    _closed = true;\n"
   "    _notifyFlow();\n"
   "    if (!_controller.isClosed) {\n"
   "      _controller.close();\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _notifyFlow() {\n"
   "    final pending = _flowNotify;\n"
   "    _flowNotify = null;\n"
   "    pending?.complete();\n"
   "  }\n"
   "\n"
   "  Future<void> _waitFlow() {\n"
   "    _flowNotify ??= Completer<void>();\n"
   "    return _flowNotify!.future;\n"
   "  }\n"
   "\n"
   "  void _writeRaw(List<int> bytes) {\n"
   "    _socket.add(bytes is Uint8List ? bytes : Uint8List.fromList(bytes));\n"
   "  }\n"
   "\n"
   "  void _writeFrame(int type, int flags, int streamId, Uint8List payload) {\n"
   "    final frame = Uint8List(9 + payload.length);\n"
   "    frame[0] = (payload.length >> 16) & 0xff;\n"
   "    frame[1] = (payload.length >> 8) & 0xff;\n"
   "    frame[2] = payload.length & 0xff;\n"
   "    frame[3] = type & 0xff;\n"
   "    frame[4] = flags & 0xff;\n"
   "    frame[5] = (streamId >> 24) & 0x7f;\n"
   "    frame[6] = (streamId >> 16) & 0xff;\n"
   "    frame[7] = (streamId >> 8) & 0xff;\n"
   "    frame[8] = streamId & 0xff;\n"
   "    frame.setRange(9, frame.length, payload);\n"
   "    _writeRaw(frame);\n"
   "  }\n"
   "\n"
   "  void _emit(int frameType, int streamId, List<int> payload) {\n"
   "    if (!_controller.isClosed) {\n"
   "      _controller.add(Codec.encodeFrame(frameType, streamId, payload));\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _emitHeaders(int streamId, Map<String, String> metadata) {\n"
   "    _emit(Wire.frameHeaders, streamId,\n"
   "        utf8.encode(jsonEncode({'metadata': metadata})));\n"
   "  }\n"
   "\n"
   "  void _emitTrailers(\n"
   "      int streamId, int code, String message, Map<String, String>? metadata) {\n"
   "    final status = StatusException(code, message);\n"
   "    if (metadata != null) {\n"
   "      status.trailers = metadata;\n"
   "    }\n"
   "    _emit(Wire.frameTrailers, streamId,\n"
   "        Codec.statusFrame(Wire.frameTrailers, streamId, status).sublist(9));\n"
   "  }\n"
   "\n"
   "  void _onSocketData(Uint8List chunk) {\n"
   "    _recvBuffer.add(chunk);\n"
   "    while (true) {\n"
   "      final data = _recvBuffer.toBytes();\n"
   "      if (data.length < 9) {\n"
   "        _resetBuffer(data, 0);\n"
   "        return;\n"
   "      }\n"
   "      final len = (data[0] << 16) | (data[1] << 8) | data[2];\n"
   "      if (data.length < 9 + len) {\n"
   "        _resetBuffer(data, 0);\n"
   "        return;\n"
   "      }\n"
   "      final type = data[3];\n"
   "      final flags = data[4];\n"
   "      final streamId =\n"
   "          ((data[5] & 0x7f) << 24) | (data[6] << 16) | (data[7] << 8) | data[8];\n"
   "      final payload = Uint8List.sublistView(data, 9, 9 + len);\n"
   "      _resetBuffer(data, 9 + len);\n"
   "      try {\n"
   "        _onFrame(type, flags, streamId, payload);\n"
   "      } catch (_) {\n"
   "        _onClosed();\n"
   "        return;\n"
   "      }\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _resetBuffer(Uint8List data, int consumed) {\n"
   "    _recvBuffer.clear();\n"
   "    if (consumed < data.length) {\n"
   "      _recvBuffer.add(Uint8List.sublistView(data, consumed));\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _onFrame(int type, int flags, int streamId, Uint8List payload) {\n"
   "    switch (type) {\n"
   "      case h2Settings:\n"
   "        if ((flags & flagAck) != 0) return;\n"
   "        var newInitial = _peerInitialWindow;\n"
   "        for (var off = 0; off + 6 <= payload.length; off += 6) {\n"
   "          final ident = (payload[off] << 8) | payload[off + 1];\n"
   "          final value = (payload[off + 2] << 24) |\n"
   "              (payload[off + 3] << 16) |\n"
   "              (payload[off + 4] << 8) |\n"
   "              payload[off + 5];\n"
   "          if (ident == 0x3) newInitial = value;\n"
   "        }\n"
   "        final delta = newInitial - _peerInitialWindow;\n"
   "        _peerInitialWindow = newInitial;\n"
   "        if (delta != 0) {\n"
   "          for (final key in _streamWindows.keys.toList()) {\n"
   "            _streamWindows[key] = _streamWindows[key]! + delta;\n"
   "          }\n"
   "          _notifyFlow();\n"
   "        }\n"
   "        _writeFrame(h2Settings, flagAck, 0, Uint8List(0));\n"
   "        break;\n"
   "      case h2WindowUpdate:\n"
   "        if (payload.length >= 4) {\n"
   "          final inc = ((payload[0] & 0x7f) << 24) |\n"
   "              (payload[1] << 16) |\n"
   "              (payload[2] << 8) |\n"
   "              payload[3];\n"
   "          if (streamId == 0) {\n"
   "            _connWindow += inc;\n"
   "          } else {\n"
   "            _streamWindows[streamId] = (_streamWindows[streamId] ?? _peerInitialWindow) + inc;\n"
   "          }\n"
   "          _notifyFlow();\n"
   "        }\n"
   "        break;\n"
   "      case h2Ping:\n"
   "        if ((flags & flagAck) == 0 && payload.length == 8) {\n"
   "          _writeFrame(h2Ping, flagAck, 0, payload);\n"
   "        }\n"
   "        break;\n"
   "      case h2RstStream:\n"
   "        _emit(Wire.frameRst, streamId,\n"
   "            utf8.encode('{\"code\":8,\"message\":\"rst stream\"}'));\n"
   "        break;\n"
   "      case h2Headers:\n"
   "      case h2Continuation:\n"
   "        final block = _headerBlocks.putIfAbsent(streamId, () => BytesBuilder());\n"
   "        block.add(payload);\n"
   "        if ((flags & flagEndHeaders) != 0) {\n"
   "          _headerBlocks.remove(streamId);\n"
   "          _onHeaders(streamId, (flags & flagEndStream) != 0, block.toBytes());\n"
   "        }\n"
   "        break;\n"
   "      case h2Data:\n"
   "        var body = payload;\n"
   "        if ((flags & flagPadded) != 0 && body.isNotEmpty) {\n"
   "          final pad = body[0];\n"
   "          body = pad + 1 <= body.length\n"
   "              ? Uint8List.sublistView(body, 1, body.length - pad)\n"
   "              : Uint8List(0);\n"
   "        }\n"
   "        if (body.isNotEmpty) {\n"
   "          _writeFrame(h2WindowUpdate, 0, 0, _windowUpdate(body.length));\n"
   "          _writeFrame(h2WindowUpdate, 0, streamId, _windowUpdate(body.length));\n"
   "          final buf = _dataBuffers.putIfAbsent(streamId, () => BytesBuilder());\n"
   "          buf.add(body);\n"
   "          _drainMessages(streamId);\n"
   "        }\n"
   "        if ((flags & flagEndStream) != 0) {\n"
   "          _emitTrailers(streamId, 2, 'missing grpc-status', null);\n"
   "        }\n"
   "        break;\n"
   "      default:\n"
   "        // GOAWAY and unknown frames: nothing to do.\n"
   "        break;\n"
   "    }\n"
   "  }\n"
   "\n"
   "  static Uint8List _windowUpdate(int increment) {\n"
   "    final out = Uint8List(4);\n"
   "    out[0] = (increment >> 24) & 0x7f;\n"
   "    out[1] = (increment >> 16) & 0xff;\n"
   "    out[2] = (increment >> 8) & 0xff;\n"
   "    out[3] = increment & 0xff;\n"
   "    return out;\n"
   "  }\n"
   "\n"
   "  void _onHeaders(int streamId, bool endStream, Uint8List block) {\n"
   "    final headers = _decoder.decode(block);\n"
   "    final metadata = <String, String>{};\n"
   "    String? status;\n"
   "    String? message;\n"
   "    for (final h in headers) {\n"
   "      final name = h.$1;\n"
   "      final value = h.$2;\n"
   "      if (name == 'grpc-status') {\n"
   "        status = value;\n"
   "      } else if (name == 'grpc-message') {\n"
   "        message = value;\n"
   "      } else if (name == 'grpc-encoding') {\n"
   "        if (value == 'gzip') _decompressIn.add(streamId);\n"
   "      } else if (name.startsWith(':') ||\n"
   "          name == 'content-type' ||\n"
   "          name == 'grpc-accept-encoding') {\n"
   "        // transport-owned: not metadata\n"
   "      } else {\n"
   "        metadata.putIfAbsent(name, () => value);\n"
   "      }\n"
   "    }\n"
   "    final first = _headersSeen.add(streamId);\n"
   "    if (endStream && status != null) {\n"
   "      _emitTrailers(streamId, int.parse(status),\n"
   "          _percentDecode(message ?? ''), metadata);\n"
   "    } else if (first) {\n"
   "      _emitHeaders(streamId, metadata);\n"
   "      if (endStream) {\n"
   "        _emitTrailers(streamId, 2, 'missing grpc-status', metadata);\n"
   "      }\n"
   "    } else if (endStream) {\n"
   "      _emitTrailers(streamId, 2, 'missing grpc-status', metadata);\n"
   "    }\n"
   "  }\n"
   "\n"
   "  void _drainMessages(int streamId) {\n"
   "    final buf = _dataBuffers[streamId];\n"
   "    if (buf == null) return;\n"
   "    final data = buf.takeBytes();\n"
   "    var off = 0;\n"
   "    while (data.length - off >= 5) {\n"
   "      final mlen = (data[off + 1] << 24) |\n"
   "          (data[off + 2] << 16) |\n"
   "          (data[off + 3] << 8) |\n"
   "          data[off + 4];\n"
   "      if (data.length - off - 5 < mlen) break;\n"
   "      final compressed = data[off] & 0xff;\n"
   "      var message = Uint8List.sublistView(data, off + 5, off + 5 + mlen);\n"
   "      off += 5 + mlen;\n"
   "      if (compressed == 1 || _decompressIn.contains(streamId)) {\n"
   "        message = Uint8List.fromList(gzip.decode(message));\n"
   "      }\n"
   "      _emit(Wire.frameData, streamId, message);\n"
   "    }\n"
   "    if (off < data.length) {\n"
   "      buf.add(Uint8List.sublistView(data, off));\n"
   "    }\n"
   "  }\n"
   "\n"
   "  static String _percentDecode(String value) {\n"
   "    final bytes = BytesBuilder();\n"
   "    final units = value.codeUnits;\n"
   "    for (var i = 0; i < units.length; i++) {\n"
   "      final c = units[i];\n"
   "      if (c == 0x25 && i + 2 < units.length) {\n"
   "        final hi = _hexDigit(units[i + 1]);\n"
   "        final lo = _hexDigit(units[i + 2]);\n"
   "        if (hi >= 0 && lo >= 0) {\n"
   "          bytes.addByte((hi << 4) | lo);\n"
   "          i += 2;\n"
   "          continue;\n"
   "        }\n"
   "      }\n"
   "      bytes.addByte(c & 0xff);\n"
   "    }\n"
   "    return utf8.decode(bytes.toBytes(), allowMalformed: true);\n"
   "  }\n"
   "\n"
   "  static int _hexDigit(int c) {\n"
   "    if (c >= 0x30 && c <= 0x39) return c - 0x30;\n"
   "    if (c >= 0x61 && c <= 0x66) return c - 0x61 + 10;\n"
   "    if (c >= 0x41 && c <= 0x46) return c - 0x41 + 10;\n"
   "    return -1;\n"
   "  }\n"
   "\n"
   "  Future<void> _pump() async {\n"
   "    try {\n"
   "      while (_sendQueue.isNotEmpty) {\n"
   "        final message = _sendQueue.removeAt(0);\n"
   "        await _handleSend(message);\n"
   "      }\n"
   "    } catch (_) {\n"
   "      _onClosed();\n"
   "    } finally {\n"
   "      _sending = false;\n"
   "    }\n"
   "  }\n"
   "\n"
   "  Future<void> _handleSend(Uint8List message) async {\n"
   "    final frame = Codec.decodeFrame(message);\n"
   "    final streamId = frame.streamId;\n"
   "    final payload = frame.payload;\n"
   "    switch (frame.type) {\n"
   "      case Wire.frameHeaders:\n"
   "        final headers = Codec.parseHeaders(payload);\n"
   "        final metadata = headers.metadata;\n"
   "        _streamWindows.putIfAbsent(streamId, () => _peerInitialWindow);\n"
   "        if (metadata['grpc-encoding'] == 'gzip') {\n"
   "          _compressOut.add(streamId);\n"
   "        }\n"
   "        final block = BytesBuilder();\n"
   "        block.addByte(0x83); // :method: POST\n"
   "        block.addByte(scheme == 'https' ? 0x87 : 0x86); // :scheme\n"
   "        _writeLiteralIndexedName(block, 4, headers.path ?? ''); // :path\n"
   "        _writeLiteralIndexedName(block, 1, authority); // :authority\n"
   "        _writeLiteralIndexedName(block, 31, 'application/grpc');\n"
   "        _writeLiteralNewName(block, 'grpc-accept-encoding', 'gzip,identity');\n"
   "        _writeLiteralNewName(block, 'te', 'trailers');\n"
   "        for (final e in metadata.entries) {\n"
   "          final key = e.key.toLowerCase();\n"
   "          if (key == 'grpc-encoding') {\n"
   "            _writeLiteralNewName(block, key, 'gzip');\n"
   "          } else {\n"
   "            _writeLiteralNewName(block, key, e.value);\n"
   "          }\n"
   "        }\n"
   "        _writeFrame(h2Headers, flagEndHeaders, streamId, block.toBytes());\n"
   "        break;\n"
   "      case Wire.frameData:\n"
   "        final compressed = _compressOut.contains(streamId);\n"
   "        var body = payload;\n"
   "        if (compressed) {\n"
   "          body = Uint8List.fromList(gzip.encode(payload));\n"
   "        }\n"
   "        final wire = Uint8List(5 + body.length);\n"
   "        wire[0] = compressed ? 1 : 0;\n"
   "        wire[1] = (body.length >> 24) & 0xff;\n"
   "        wire[2] = (body.length >> 16) & 0xff;\n"
   "        wire[3] = (body.length >> 8) & 0xff;\n"
   "        wire[4] = body.length & 0xff;\n"
   "        wire.setRange(5, wire.length, body);\n"
   "        var sent = 0;\n"
   "        while (sent < wire.length) {\n"
   "          while (!_closed &&\n"
   "              (_connWindow <= 0 ||\n"
   "                  (_streamWindows[streamId] ?? _peerInitialWindow) <= 0)) {\n"
   "            await _waitFlow();\n"
   "          }\n"
   "          if (_closed) throw StateError('transport closed');\n"
   "          final sw = _streamWindows[streamId] ?? _peerInitialWindow;\n"
   "          var allowance = _connWindow < sw ? _connWindow : sw;\n"
   "          final remaining = wire.length - sent;\n"
   "          if (allowance > maxFramePayload) allowance = maxFramePayload;\n"
   "          if (allowance > remaining) allowance = remaining;\n"
   "          if (allowance <= 0) {\n"
   "            await _waitFlow();\n"
   "            continue;\n"
   "          }\n"
   "          _connWindow -= allowance;\n"
   "          _streamWindows[streamId] = sw - allowance;\n"
   "          _writeFrame(h2Data, 0, streamId,\n"
   "              Uint8List.sublistView(wire, sent, sent + allowance));\n"
   "          sent += allowance;\n"
   "        }\n"
   "        break;\n"
   "      case Wire.frameHalfClose:\n"
   "        _writeFrame(h2Data, flagEndStream, streamId, Uint8List(0));\n"
   "        break;\n"
   "      case Wire.frameRst:\n"
   "        _writeFrame(h2RstStream, 0, streamId,\n"
   "            Uint8List.fromList([0, 0, 0, 8]));\n"
   "        break;\n"
   "      default:\n"
   "        // Trailers never travel client -> server here.\n"
   "        break;\n"
   "    }\n"
   "  }\n"
   "\n"
   "  static void _writeInt(BytesBuilder out, int value, int prefixBits, int prefix) {\n"
   "    final mask = (1 << prefixBits) - 1;\n"
   "    if (value < mask) {\n"
   "      out.addByte(prefix | value);\n"
   "      return;\n"
   "    }\n"
   "    out.addByte(prefix | mask);\n"
   "    var rest = value - mask;\n"
   "    while (rest >= 0x80) {\n"
   "      out.addByte((rest & 0x7f) | 0x80);\n"
   "      rest >>= 7;\n"
   "    }\n"
   "    out.addByte(rest);\n"
   "  }\n"
   "\n"
   "  static void _writeString(BytesBuilder out, String value) {\n"
   "    final raw = utf8.encode(value);\n"
   "    _writeInt(out, raw.length, 7, 0);\n"
   "    out.add(raw);\n"
   "  }\n"
   "\n"
   "  static void _writeLiteralIndexedName(BytesBuilder out, int index, String value) {\n"
   "    _writeInt(out, index, 4, 0);\n"
   "    _writeString(out, value);\n"
   "  }\n"
   "\n"
   "  static void _writeLiteralNewName(BytesBuilder out, String name, String value) {\n"
   "    _writeInt(out, 0, 4, 0);\n"
   "    _writeString(out, name);\n"
   "    _writeString(out, value);\n"
   "  }\n"
   "}\n"
   "\n"
   "class _HpackDecoder {\n"
   "  final List<(String, String)> _dynamic = [];\n"
   "  int _dynamicSize = 0;\n"
   "  static const int maxDynamic = 4096;\n"
   "\n"
   "  (String, String) _entry(int index) {\n"
   "    if (index <= 0) {\n"
   "      throw FormatException('bad hpack index 0');\n"
   "    }\n"
   "    if (index <= Http2Transport.staticTable.length) {\n"
   "      final e = Http2Transport.staticTable[index - 1];\n"
   "      return (e[0], e[1]);\n"
   "    }\n"
   "    final j = index - Http2Transport.staticTable.length - 1;\n"
   "    if (j >= _dynamic.length) {\n"
   "      throw FormatException('bad hpack dynamic index $index');\n"
   "    }\n"
   "    return _dynamic[j];\n"
   "  }\n"
   "\n"
   "  void _add(String name, String value) {\n"
   "    _dynamic.insert(0, (name, value));\n"
   "    _dynamicSize += name.length + value.length + 32;\n"
   "    while (_dynamicSize > maxDynamic && _dynamic.isNotEmpty) {\n"
   "      final e = _dynamic.removeLast();\n"
   "      _dynamicSize -= e.$1.length + e.$2.length + 32;\n"
   "    }\n"
   "  }\n"
   "\n"
   "  static int _readInt(Uint8List data, List<int> pos, int prefixBits) {\n"
   "    final mask = (1 << prefixBits) - 1;\n"
   "    var value = data[pos[0]] & mask;\n"
   "    pos[0]++;\n"
   "    if (value < mask) return value;\n"
   "    var shift = 0;\n"
   "    while (true) {\n"
   "      if (pos[0] >= data.length) {\n"
   "        throw const FormatException('truncated hpack int');\n"
   "      }\n"
   "      final b = data[pos[0]] & 0xff;\n"
   "      pos[0]++;\n"
   "      value += (b & 0x7f) << shift;\n"
   "      shift += 7;\n"
   "      if ((b & 0x80) == 0) break;\n"
   "    }\n"
   "    return value;\n"
   "  }\n"
   "\n"
   "  static String _readString(Uint8List data, List<int> pos) {\n"
   "    if (pos[0] >= data.length) {\n"
   "      throw const FormatException('truncated hpack string');\n"
   "    }\n"
   "    final huffman = (data[pos[0]] & 0x80) != 0;\n"
   "    final len = _readInt(data, pos, 7);\n"
   "    if (pos[0] + len > data.length) {\n"
   "      throw const FormatException('truncated hpack string body');\n"
   "    }\n"
   "    final value = huffman\n"
   "        ? Http2Transport.huffDecode(data, pos[0], len)\n"
   "        : utf8.decode(Uint8List.sublistView(data, pos[0], pos[0] + len));\n"
   "    pos[0] += len;\n"
   "    return value;\n"
   "  }\n"
   "\n"
   "  List<(String, String)> decode(Uint8List block) {\n"
   "    final out = <(String, String)>[];\n"
   "    final pos = [0];\n"
   "    while (pos[0] < block.length) {\n"
   "      final b = block[pos[0]] & 0xff;\n"
   "      if ((b & 0x80) != 0) {\n"
   "        final index = _readInt(block, pos, 7);\n"
   "        out.add(_entry(index));\n"
   "      } else if ((b & 0xe0) == 0x20) {\n"
   "        _readInt(block, pos, 5);\n"
   "      } else {\n"
   "        final incremental = (b & 0xc0) == 0x40;\n"
   "        final index = _readInt(block, pos, incremental ? 6 : 4);\n"
   "        final name = index > 0 ? _entry(index).$1 : _readString(block, pos);\n"
   "        final value = _readString(block, pos);\n"
   "        out.add((name, value));\n"
   "        if (incremental) _add(name, value);\n"
   "      }\n"
   "    }\n"
   "    return out;\n"
   "  }\n"
   "}\n"
   ))

(define (emit-dart-http2)
  (cons "http2_transport.dart"
        (string-replace
         (string-replace
          (string-replace dart-http2-body
                          "DART_STATIC_TABLE" (dart-static-table))
          "DART_HUFF_CODES" (dart-huff-codes))
         "DART_HUFF_LENS" (dart-huff-lens))))

;; ---------------------------------------------------------------------------
;; Swift emitter -> swift/grpcdc/Http2Transport.swift
;; ---------------------------------------------------------------------------

(define (swift-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "(~s, ~s)," (car e) (cdr e)))
   "\n        "))

(define (swift-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (swift-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define swift-http2-body
  (string-append
   "import Foundation\n"
   "\n"
   "#if canImport(Glibc)\n"
   "import Glibc\n"
   "#endif\n"
   "\n"
   "/// Cleartext HTTP/2 frame transport (RFC 9113, generated from\n"
   "/// http2-spec.rkt) over a POSIX TCP socket: a generated client\n"
   "/// can dial a stock gRPC server directly (grpc-java server,\n"
   "/// grpc-go server), no bridge process. Client endpoints only.\n"
   "/// TLS is not offered: Swift has no stdlib TLS on this\n"
   "/// platform, so DialTls throws CodeUnimplemented with that\n"
   "/// message rather than silently dialing cleartext.\n"
   "final class Http2Transport: Transport {\n"
   "    static let H2Data = 0x0\n"
   "    static let H2Headers = 0x1\n"
   "    static let H2RstStream = 0x3\n"
   "    static let H2Settings = 0x4\n"
   "    static let H2Ping = 0x6\n"
   "    static let H2WindowUpdate = 0x8\n"
   "    static let H2Continuation = 0x9\n"
   "    static let FlagEndStream = 0x1\n"
   "    static let FlagEndHeaders = 0x4\n"
   "    static let FlagAck = 0x1\n"
   "    static let FlagPadded = 0x8\n"
   "    static let MaxFramePayload = 16384\n"
   "\n"
   "    static let StaticTable: [(String, String)] = [\n"
   "        SWIFT_STATIC_TABLE\n"
   "    ]\n"
   "\n"
   "    static let HuffCodes: [Int] = [\n"
   "        SWIFT_HUFF_CODES\n"
   "    ]\n"
   "\n"
   "    static let HuffLens: [Int] = [\n"
   "        SWIFT_HUFF_LENS\n"
   "    ]\n"
   "\n"
   "    static let HuffDecode: [Int: Int] = {\n"
   "        var map: [Int: Int] = [:]\n"
   "        for sym in 0..<HuffCodes.count {\n"
   "            map[(HuffLens[sym] << 32) | HuffCodes[sym]] = sym\n"
   "        }\n"
   "        return map\n"
   "    }()\n"
   "\n"
   "    static func HuffDecodeString(_ data: [UInt8], _ off: Int, _ len: Int) throws -> String {\n"
   "        var out = String()\n"
   "        var code = 0\n"
   "        var bits = 0\n"
   "        for i in 0..<len {\n"
   "            let b = Int(data[off + i])\n"
   "            for j in stride(from: 7, through: 0, by: -1) {\n"
   "                code = (code << 1) | ((b >> j) & 1)\n"
   "                bits += 1\n"
   "                if let sym = HuffDecode[(bits << 32) | code] {\n"
   "                    if sym == 256 {\n"
   "                        throw StatusException(Wire.CodeInternal, \"huffman EOS symbol\")\n"
   "                    }\n"
   "                    out.unicodeScalars.append(Unicode.Scalar(UInt8(sym)))\n"
   "                    code = 0\n"
   "                    bits = 0\n"
   "                } else if bits > 30 {\n"
   "                    throw StatusException(Wire.CodeInternal, \"huffman code too long\")\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        return out\n"
   "    }\n"
   "\n"
   "    final class HpackDecoder {\n"
   "        var dynamic: [(String, String)] = []\n"
   "        var dynamicSize = 0\n"
   "        static let MaxDynamic = 4096\n"
   "\n"
   "        func Entry(_ index: Int) throws -> (String, String) {\n"
   "            if index <= 0 {\n"
   "                throw StatusException(Wire.CodeInternal, \"bad hpack index 0\")\n"
   "            }\n"
   "            if index <= Http2Transport.StaticTable.count {\n"
   "                return Http2Transport.StaticTable[index - 1]\n"
   "            }\n"
   "            let j = index - Http2Transport.StaticTable.count - 1\n"
   "            if j >= dynamic.count {\n"
   "                throw StatusException(Wire.CodeInternal, \"bad hpack dynamic index \\(index)\")\n"
   "            }\n"
   "            return dynamic[j]\n"
   "        }\n"
   "\n"
   "        func Add(_ name: String, _ value: String) {\n"
   "            dynamic.insert((name, value), at: 0)\n"
   "            dynamicSize += name.count + value.count + 32\n"
   "            while dynamicSize > HpackDecoder.MaxDynamic && !dynamic.isEmpty {\n"
   "                let e = dynamic.removeLast()\n"
   "                dynamicSize -= e.0.count + e.1.count + 32\n"
   "            }\n"
   "        }\n"
   "\n"
   "        static func ReadInt(_ data: [UInt8], _ pos: inout Int, _ prefixBits: Int) throws -> Int {\n"
   "            let mask = (1 << prefixBits) - 1\n"
   "            var value = Int(data[pos]) & mask\n"
   "            pos += 1\n"
   "            if value < mask {\n"
   "                return value\n"
   "            }\n"
   "            var shift = 0\n"
   "            while true {\n"
   "                if pos >= data.count {\n"
   "                    throw StatusException(Wire.CodeInternal, \"truncated hpack int\")\n"
   "                }\n"
   "                let b = Int(data[pos])\n"
   "                pos += 1\n"
   "                value += (b & 0x7f) << shift\n"
   "                shift += 7\n"
   "                if (b & 0x80) == 0 {\n"
   "                    break\n"
   "                }\n"
   "            }\n"
   "            return value\n"
   "        }\n"
   "\n"
   "        static func ReadString(_ data: [UInt8], _ pos: inout Int) throws -> String {\n"
   "            if pos >= data.count {\n"
   "                throw StatusException(Wire.CodeInternal, \"truncated hpack string\")\n"
   "            }\n"
   "            let huffman = (data[pos] & 0x80) != 0\n"
   "            let len = try ReadInt(data, &pos, 7)\n"
   "            if pos + len > data.count {\n"
   "                throw StatusException(Wire.CodeInternal, \"truncated hpack string body\")\n"
   "            }\n"
   "            let value = huffman\n"
   "                ? try Http2Transport.HuffDecodeString(data, pos, len)\n"
   "                : String(decoding: Array(data[pos..<(pos + len)]), as: UTF8.self)\n"
   "            pos += len\n"
   "            return value\n"
   "        }\n"
   "\n"
   "        func Decode(_ block: [UInt8]) throws -> [(String, String)] {\n"
   "            var out: [(String, String)] = []\n"
   "            var pos = 0\n"
   "            while pos < block.count {\n"
   "                let b = Int(block[pos])\n"
   "                if (b & 0x80) != 0 {\n"
   "                    let index = try HpackDecoder.ReadInt(block, &pos, 7)\n"
   "                    out.append(try Entry(index))\n"
   "                } else if (b & 0xe0) == 0x20 {\n"
   "                    _ = try HpackDecoder.ReadInt(block, &pos, 5)\n"
   "                } else {\n"
   "                    let incremental = (b & 0xc0) == 0x40\n"
   "                    let index = try HpackDecoder.ReadInt(block, &pos, incremental ? 6 : 4)\n"
   "                    let name = index > 0 ? try Entry(index).0 : try HpackDecoder.ReadString(block, &pos)\n"
   "                    let value = try HpackDecoder.ReadString(block, &pos)\n"
   "                    out.append((name, value))\n"
   "                    if incremental {\n"
   "                        Add(name, value)\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            return out\n"
   "        }\n"
   "    }\n"
   "\n"
   "    static func WriteInt(_ out: inout [UInt8], _ value: Int, _ prefixBits: Int, _ prefix: Int) {\n"
   "        let mask = (1 << prefixBits) - 1\n"
   "        if value < mask {\n"
   "            out.append(UInt8(prefix | value))\n"
   "            return\n"
   "        }\n"
   "        out.append(UInt8(prefix | mask))\n"
   "        var rest = value - mask\n"
   "        while rest >= 0x80 {\n"
   "            out.append(UInt8((rest & 0x7f) | 0x80))\n"
   "            rest >>= 7\n"
   "        }\n"
   "        out.append(UInt8(rest))\n"
   "    }\n"
   "\n"
   "    static func WriteString(_ out: inout [UInt8], _ value: String) {\n"
   "        let raw = [UInt8](value.utf8)\n"
   "        WriteInt(&out, raw.count, 7, 0)\n"
   "        out.append(contentsOf: raw)\n"
   "    }\n"
   "\n"
   "    static func WriteLiteralIndexedName(_ out: inout [UInt8], _ index: Int, _ value: String) {\n"
   "        WriteInt(&out, index, 4, 0)\n"
   "        WriteString(&out, value)\n"
   "    }\n"
   "\n"
   "    static func WriteLiteralNewName(_ out: inout [UInt8], _ name: String, _ value: String) {\n"
   "        WriteInt(&out, 0, 4, 0)\n"
   "        WriteString(&out, name)\n"
   "        WriteString(&out, value)\n"
   "    }\n"
   "\n"
   "    // ---- gzip (RFC 1952) over a stored-block deflate writer and\n"
   "    // a full inflate reader: no zlib in the Swift stdlib. ----\n"
   "\n"
   "    static let CrcTable: [UInt32] = {\n"
   "        var table = [UInt32](repeating: 0, count: 256)\n"
   "        for i in 0..<256 {\n"
   "            var c = UInt32(i)\n"
   "            for _ in 0..<8 {\n"
   "                c = (c & 1) != 0 ? (0xedb88320 ^ (c >> 1)) : (c >> 1)\n"
   "            }\n"
   "            table[i] = c\n"
   "        }\n"
   "        return table\n"
   "    }()\n"
   "\n"
   "    static func Crc32(_ data: [UInt8]) -> UInt32 {\n"
   "        var crc: UInt32 = 0xffffffff\n"
   "        for b in data {\n"
   "            crc = CrcTable[Int((crc ^ UInt32(b)) & 0xff)] ^ (crc >> 8)\n"
   "        }\n"
   "        return crc ^ 0xffffffff\n"
   "    }\n"
   "\n"
   "    static func Gzip(_ data: [UInt8]) -> [UInt8] {\n"
   "        var out: [UInt8] = [0x1f, 0x8b, 8, 0, 0, 0, 0, 0, 0, 255]\n"
   "        if data.isEmpty {\n"
   "            out.append(contentsOf: [1, 0, 0, 0xff, 0xff])\n"
   "        } else {\n"
   "            var off = 0\n"
   "            while off < data.count {\n"
   "                let chunk = min(65535, data.count - off)\n"
   "                let last = off + chunk >= data.count\n"
   "                out.append(last ? 1 : 0)\n"
   "                out.append(UInt8(chunk & 0xff))\n"
   "                out.append(UInt8((chunk >> 8) & 0xff))\n"
   "                let nlen = (~chunk) & 0xffff\n"
   "                out.append(UInt8(nlen & 0xff))\n"
   "                out.append(UInt8((nlen >> 8) & 0xff))\n"
   "                out.append(contentsOf: data[off..<(off + chunk)])\n"
   "                off += chunk\n"
   "            }\n"
   "        }\n"
   "        let crc = Crc32(data)\n"
   "        out.append(UInt8(crc & 0xff))\n"
   "        out.append(UInt8((crc >> 8) & 0xff))\n"
   "        out.append(UInt8((crc >> 16) & 0xff))\n"
   "        out.append(UInt8((crc >> 24) & 0xff))\n"
   "        let isize = UInt32(data.count)\n"
   "        out.append(UInt8(isize & 0xff))\n"
   "        out.append(UInt8((isize >> 8) & 0xff))\n"
   "        out.append(UInt8((isize >> 16) & 0xff))\n"
   "        out.append(UInt8((isize >> 24) & 0xff))\n"
   "        return out\n"
   "    }\n"
   "\n"
   "    final class BitReader {\n"
   "        let data: [UInt8]\n"
   "        var pos = 0\n"
   "        var bitPos = 0\n"
   "\n"
   "        init(_ data: [UInt8]) { self.data = data }\n"
   "\n"
   "        func Bit() throws -> Int {\n"
   "            if pos >= data.count {\n"
   "                throw StatusException(Wire.CodeInternal, \"inflate: out of input\")\n"
   "            }\n"
   "            let bit = (Int(data[pos]) >> bitPos) & 1\n"
   "            bitPos += 1\n"
   "            if bitPos == 8 {\n"
   "                bitPos = 0\n"
   "                pos += 1\n"
   "            }\n"
   "            return bit\n"
   "        }\n"
   "\n"
   "        func Bits(_ n: Int) throws -> Int {\n"
   "            var value = 0\n"
   "            for i in 0..<n {\n"
   "                value |= try Bit() << i\n"
   "            }\n"
   "            return value\n"
   "        }\n"
   "\n"
   "        func AlignByte() {\n"
   "            if bitPos != 0 {\n"
   "                bitPos = 0\n"
   "                pos += 1\n"
   "            }\n"
   "        }\n"
   "    }\n"
   "\n"
   "    static func BuildHuffman(_ lengths: [Int]) -> [Int: Int] {\n"
   "        var blCount = [Int](repeating: 0, count: 16)\n"
   "        for l in lengths where l > 0 {\n"
   "            blCount[l] += 1\n"
   "        }\n"
   "        var code = 0\n"
   "        var nextCode = [Int](repeating: 0, count: 16)\n"
   "        for bits in 1...15 {\n"
   "            code = (code + blCount[bits - 1]) << 1\n"
   "            nextCode[bits] = code\n"
   "        }\n"
   "        var map: [Int: Int] = [:]\n"
   "        for sym in 0..<lengths.count {\n"
   "            let len = lengths[sym]\n"
   "            if len > 0 {\n"
   "                map[(len << 32) | nextCode[len]] = sym\n"
   "                nextCode[len] += 1\n"
   "            }\n"
   "        }\n"
   "        return map\n"
   "    }\n"
   "\n"
   "    static func DecodeSymbol(_ reader: BitReader, _ table: [Int: Int]) throws -> Int {\n"
   "        var code = 0\n"
   "        for len in 1...15 {\n"
   "            let bit = try reader.Bit()\n"
