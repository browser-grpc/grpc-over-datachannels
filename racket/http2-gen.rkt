   "    {\n"
   "        byte[] raw = Encoding.UTF8.GetBytes(value);\n"
   "        WriteInt(output, raw.Length, 7, 0);\n"
   "        output.Write(raw, 0, raw.Length);\n"
   "    }\n\n"
   "    private static void WriteLiteralIndexedName(MemoryStream output, int index, string value)\n"
