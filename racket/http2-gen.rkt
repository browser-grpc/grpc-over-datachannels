   "            var block = headerBlocks[streamId] ?? []\n"
   "            block.append(contentsOf: payload)\n"
   "            headerBlocks[streamId] = block\n"
   "            if (flags & Http2Transport.FlagEndHeaders) != 0 {\n"
   "                headerBlocks.removeValue(forKey: streamId)\n"
   "                OnHeaders(streamId, (flags & Http2Transport.FlagEndStream) != 0, block)\n"
   "            }\n"
   "        case Http2Transport.H2Data:\n"
