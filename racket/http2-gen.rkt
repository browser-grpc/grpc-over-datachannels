(define java-http2-part3
  (string-append
   "    private boolean onFrame(int type, int flags, long streamId, byte[] payload) throws IOException {\n"
   "        switch (type) {\n"
   "            case H2_SETTINGS -> {\n"
   "                if ((flags & FLAG_ACK) != 0) {\n"
   "                    return true;\n"
   "                }\n"
   "                long newInitial = peerInitialWindow;\n"
   "                for (int off = 0; off + 6 <= payload.length; off += 6) {\n"
   "                    int ident = ((payload[off] & 0xff) << 8) | (payload[off + 1] & 0xff);\n"
   "                    long value = ((long) (payload[off + 2] & 0xff) << 24) | ((payload[off + 3] & 0xff) << 16)\n"
   "                            | ((payload[off + 4] & 0xff) << 8) | (payload[off + 5] & 0xff);\n"
   "                    if (ident == 0x3) {\n"
   "                        newInitial = value;\n"
   "                    }\n"
   "                }\n"
   "                long delta = newInitial - peerInitialWindow;\n"
   "                peerInitialWindow = newInitial;\n"
   "                if (delta != 0) {\n"
   "                    synchronized (cond) {\n"
   "                        for (Map.Entry<Long, Long> e : streamWindows.entrySet()) {\n"
   "                            e.setValue(e.getValue() + delta);\n"
   "                        }\n"
   "                        cond.notifyAll();\n"
   "                    }\n"
   "                }\n"
   "                writeFrame(H2_SETTINGS, FLAG_ACK, 0, new byte[0]);\n"
   "            }\n"
   "            case H2_WINDOW_UPDATE -> {\n"
   "                if (payload.length >= 4) {\n"
   "                    long inc = ((long) (payload[0] & 0x7f) << 24) | ((payload[1] & 0xff) << 16)\n"
   "                            | ((payload[2] & 0xff) << 8) | (payload[3] & 0xff);\n"
   "                    synchronized (cond) {\n"
   "                        if (streamId == 0) {\n"
   "                            connWindow += inc;\n"
   "                        } else {\n"
   "                            streamWindows.merge(streamId, inc, Long::sum);\n"
   "                        }\n"
   "                        cond.notifyAll();\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            case H2_PING -> {\n"
   "                if ((flags & FLAG_ACK) == 0 && payload.length == 8) {\n"
   "                    writeFrame(H2_PING, FLAG_ACK, 0, payload);\n"
   "                }\n"
   "            }\n"
   "            case H2_RST_STREAM -> emit(Wire.FRAME_RST, streamId,\n"
   "                    \"{\\\"code\\\":8,\\\"message\\\":\\\"rst stream\\\"}\".getBytes(StandardCharsets.UTF_8));\n"
   "            case H2_HEADERS, H2_CONTINUATION -> {\n"
   "                ByteArrayOutputStream block = headerBlocks.computeIfAbsent(streamId, k -> new ByteArrayOutputStream());\n"
   "                block.write(payload, 0, payload.length);\n"
   "                if ((flags & FLAG_END_HEADERS) != 0) {\n"
   "                    headerBlocks.remove(streamId);\n"
   "                    onHeaders(streamId, (flags & FLAG_END_STREAM) != 0, block.toByteArray());\n"
   "                }\n"
   "            }\n"
   "            case H2_DATA -> {\n"
   "                byte[] body = payload;\n"
   "                if ((flags & FLAG_PADDED) != 0 && body.length >= 1) {\n"
   "                    int pad = body[0] & 0xff;\n"
   "                    body = pad + 1 <= body.length ? Arrays.copyOfRange(body, 1, body.length - pad) : new byte[0];\n"
   "                }\n"
   "                if (body.length > 0) {\n"
   "                    ByteArrayOutputStream wu = new ByteArrayOutputStream();\n"
   "                    writeWindowUpdate(wu, body.length);\n"
   "                    writeFrame(H2_WINDOW_UPDATE, 0, 0, wu.toByteArray());\n"
   "                    ByteArrayOutputStream wu2 = new ByteArrayOutputStream();\n"
   "                    writeWindowUpdate(wu2, body.length);\n"
   "                    writeFrame(H2_WINDOW_UPDATE, 0, streamId, wu2.toByteArray());\n"
   "                    ByteArrayOutputStream buf = dataBuffers.computeIfAbsent(streamId, k -> new ByteArrayOutputStream());\n"
   "                    buf.write(body, 0, body.length);\n"
   "                    drainMessages(streamId);\n"
   "                }\n"
   "                if ((flags & FLAG_END_STREAM) != 0) {\n"
   "                    emitTrailersFrame(streamId, 2, \"missing grpc-status\", null);\n"
   "                }\n"
   "            }\n"
   "            default -> {\n"
   "                // GOAWAY and unknown frames: nothing to do.\n"
   "            }\n"
   "        }\n"
   "        return true;\n"
   "    }\n\n"
   "    private static void writeWindowUpdate(ByteArrayOutputStream out, int increment) {\n"
   "        out.write((increment >> 24) & 0x7f);\n"
   "        out.write((increment >> 16) & 0xff);\n"
   "        out.write((increment >> 8) & 0xff);\n"
   "        out.write(increment & 0xff);\n"
   "    }\n\n"
   "    private void onHeaders(long streamId, boolean endStream, byte[] block) throws IOException {\n"
   "        List<String[]> headers = decoder.decode(block);\n"
   "        Map<String, String> metadata = new LinkedHashMap<>();\n"
   "        String status = null;\n"
   "        String message = null;\n"
   "        for (String[] h : headers) {\n"
   "            String name = h[0];\n"
   "            String value = h[1];\n"
   "            if (name.equals(\"grpc-status\")) {\n"
   "                status = value;\n"
   "            } else if (name.equals(\"grpc-message\")) {\n"
   "                message = value;\n"
   "            } else if (name.equals(\"grpc-encoding\")) {\n"
   "                if (value.equals(\"gzip\")) {\n"
   "                    decompressIn.add(streamId);\n"
   "                }\n"
   "            } else if (name.startsWith(\":\") || name.equals(\"content-type\")\n"
   "                    || name.equals(\"grpc-accept-encoding\")) {\n"
   "                // transport-owned: not metadata\n"
   "            } else {\n"
   "                metadata.putIfAbsent(name, value);\n"
   "            }\n"
   "        }\n"
   "        boolean first = headersSeen.add(streamId);\n"
   "        if (endStream && status != null) {\n"
   "            emitTrailersFrame(streamId, Long.parseLong(status),\n"
   "                    percentDecode(message != null ? message : \"\"), metadata);\n"
   "        } else if (first) {\n"
   "            emitHeadersFrame(streamId, metadata);\n"
   "            if (endStream) {\n"
   "                emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata);\n"
   "            }\n"
   "        } else if (endStream) {\n"
   "            emitTrailersFrame(streamId, 2, \"missing grpc-status\", metadata);\n"
   "        }\n"
   "    }\n\n"
   "    private void drainMessages(long streamId) throws IOException {\n"
   "        ByteArrayOutputStream buf = dataBuffers.get(streamId);\n"
   "        if (buf == null) {\n"
   "            return;\n"
   "        }\n"
   "        byte[] data = buf.toByteArray();\n"
   "        int off = 0;\n"
   "        while (data.length - off >= 5) {\n"
   "            long mlen = ((long) (data[off + 1] & 0xff) << 24) | ((data[off + 2] & 0xff) << 16)\n"
   "                    | ((data[off + 3] & 0xff) << 8) | (data[off + 4] & 0xff);\n"
   "            if (data.length - off - 5 < mlen) {\n"
   "                break;\n"
   "            }\n"
   "            int compressed = data[off] & 0xff;\n"
   "            byte[] message = Arrays.copyOfRange(data, off + 5, off + 5 + (int) mlen);\n"
   "            off += 5 + (int) mlen;\n"
   "            if (compressed == 1 || decompressIn.contains(streamId)) {\n"
   "                message = gunzip(message);\n"
   "            }\n"
   "            emit(Wire.FRAME_DATA, streamId, message);\n"
   "        }\n"
   "        buf.reset();\n"
   "        buf.write(data, off, data.length - off);\n"
   "    }\n\n"
   "    static byte[] gunzip(byte[] data) throws IOException {\n"
   "        ByteArrayOutputStream out = new ByteArrayOutputStream();\n"
   "        try (GZIPInputStream gz = new GZIPInputStream(new ByteArrayInputStream(data))) {\n"
   "            gz.transferTo(out);\n"
   "        }\n"
   "        return out.toByteArray();\n"
   "    }\n\n"
   "    static byte[] gzip(byte[] data) throws IOException {\n"
   "        ByteArrayOutputStream out = new ByteArrayOutputStream();\n"
   "        try (GZIPOutputStream gz = new GZIPOutputStream(out)) {\n"
   "            gz.write(data);\n"
   "        }\n"
   "        return out.toByteArray();\n"
   "    }\n\n"
   "    static String percentDecode(String value) {\n"
   "        ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n"
   "        for (int i = 0; i < value.length(); i++) {\n"
   "            char c = value.charAt(i);\n"
   "            if (c == '%' && i + 2 < value.length()) {\n"
   "                int hi = Character.digit(value.charAt(i + 1), 16);\n"
   "                int lo = Character.digit(value.charAt(i + 2), 16);\n"
   "                if (hi >= 0 && lo >= 0) {\n"
   "                    bytes.write((hi << 4) | lo);\n"
   "                    i += 2;\n"
   "                    continue;\n"
   "                }\n"
   "            }\n"
   "            bytes.write((byte) c);\n"
   "        }\n"
   "        return bytes.toString(StandardCharsets.UTF_8);\n"
   "    }\n\n"))

(define java-http2-part4
  (string-append
   "    @Override\n"
   "    public void send(byte[] message) throws Exception {\n"
   "        if (message.length < 9) {\n"
   "            throw new IOException(\"short frame\");\n"
   "        }\n"
   "        int type = message[0] & 0xff;\n"
   "        long streamId = ((long) (message[1] & 0xff) << 24) | ((message[2] & 0xff) << 16)\n"
   "                | ((message[3] & 0xff) << 8) | (message[4] & 0xff);\n"
   "        int flen = ((message[5] & 0xff) << 24) | ((message[6] & 0xff) << 16)\n"
   "                | ((message[7] & 0xff) << 8) | (message[8] & 0xff);\n"
   "        byte[] payload = Arrays.copyOfRange(message, 9, 9 + flen);\n"
   "        switch (type) {\n"
   "            case Wire.FRAME_HEADERS -> {\n"
   "                Map<String, Object> body = Codec.parseJsonObject(new String(payload, StandardCharsets.UTF_8));\n"
   "                String path = body.get(\"path\") instanceof String s ? s : \"\";\n"
   "                Map<String, String> metadata = new LinkedHashMap<>();\n"
   "                if (body.get(\"metadata\") instanceof Map<?, ?> md) {\n"
   "                    for (Map.Entry<?, ?> e : md.entrySet()) {\n"
   "                        metadata.put(String.valueOf(e.getKey()), String.valueOf(e.getValue()));\n"
   "                    }\n"
   "                }\n"
   "                synchronized (cond) {\n"
   "                    streamWindows.putIfAbsent(streamId, peerInitialWindow);\n"
   "                }\n"
   "                if (metadata.containsKey(\"grpc-encoding\")\n"
   "                        && metadata.get(\"grpc-encoding\").equals(\"gzip\")) {\n"
   "                    compressOut.put(streamId, Boolean.TRUE);\n"
   "                }\n"
   "                ByteArrayOutputStream block = new ByteArrayOutputStream();\n"
   "                block.write(0x83); // :method: POST\n"
   "                block.write(scheme.equals(\"https\") ? 0x87 : 0x86); // :scheme\n"
   "                writeLiteralIndexedName(block, 4, path); // :path\n"
   "                writeLiteralIndexedName(block, 1, authority); // :authority\n"
   "                writeLiteralIndexedName(block, 31, \"application/grpc\"); // content-type\n"
   "                writeLiteralNewName(block, \"grpc-accept-encoding\", \"gzip,identity\");\n"
   "                writeLiteralNewName(block, \"te\", \"trailers\");\n"
   "                for (Map.Entry<String, String> e : metadata.entrySet()) {\n"
   "                    String key = e.getKey().toLowerCase(java.util.Locale.ROOT);\n"
   "                    if (key.equals(\"grpc-encoding\")) {\n"
   "                        writeLiteralNewName(block, key, \"gzip\");\n"
   "                    } else {\n"
   "                        writeLiteralNewName(block, key, e.getValue());\n"
   "                    }\n"
   "                }\n"
   "                writeFrame(H2_HEADERS, FLAG_END_HEADERS, streamId, block.toByteArray());\n"
   "            }\n"
   "            case Wire.FRAME_DATA -> {\n"
   "                boolean compressed = compressOut.getOrDefault(streamId, Boolean.FALSE);\n"
   "                byte[] body = payload;\n"
   "                if (compressed) {\n"
   "                    body = gzip(payload);\n"
   "                }\n"
   "                byte[] wire = new byte[5 + body.length];\n"
   "                wire[0] = (byte) (compressed ? 1 : 0);\n"
   "                wire[1] = (byte) (body.length >> 24);\n"
   "                wire[2] = (byte) (body.length >> 16);\n"
   "                wire[3] = (byte) (body.length >> 8);\n"
   "                wire[4] = (byte) body.length;\n"
   "                System.arraycopy(body, 0, wire, 5, body.length);\n"
   "                int sent = 0;\n"
   "                while (sent < wire.length) {\n"
   "                    int allowance;\n"
   "                    synchronized (cond) {\n"
   "                        while (!closed && (connWindow <= 0\n"
   "                                || streamWindows.getOrDefault(streamId, peerInitialWindow) <= 0)) {\n"
   "                            cond.wait();\n"
   "                        }\n"
   "                        if (closed) {\n"
   "                            throw new IOException(\"transport closed\");\n"
   "                        }\n"
   "                        long sw = streamWindows.getOrDefault(streamId, peerInitialWindow);\n"
   "                        allowance = (int) Math.min(Math.min(connWindow, sw),\n"
   "                                Math.min(MAX_FRAME_PAYLOAD, wire.length - sent));\n"
   "                        connWindow -= allowance;\n"
   "                        streamWindows.put(streamId, sw - allowance);\n"
   "                    }\n"
   "                    writeFrame(H2_DATA, 0, streamId,\n"
   "                            Arrays.copyOfRange(wire, sent, sent + allowance));\n"
   "                    sent += allowance;\n"
   "                }\n"
   "            }\n"
   "            case Wire.FRAME_HALF_CLOSE -> writeFrame(H2_DATA, FLAG_END_STREAM, streamId, new byte[0]);\n"
   "            case Wire.FRAME_RST -> {\n"
   "                byte[] cancel = {0, 0, 0, 8};\n"
   "                writeFrame(H2_RST_STREAM, 0, streamId, cancel);\n"
   "            }\n"
   "            default -> {\n"
   "                // Trailers never travel client -> server here.\n"
   "            }\n"
   "        }\n"
   "    }\n\n"
   "    @Override\n"
   "    public byte[] recv() throws Exception {\n"
   "        byte[] msg = queue.take();\n"
   "        if (msg == CLOSED_MARK) {\n"
   "            queue.offer(CLOSED_MARK);\n"
   "            throw new EOFException(\"transport closed\");\n"
   "        }\n"
   "        return msg;\n"
   "    }\n\n"
   "    @Override\n"
   "    public void close() {\n"
   "        try {\n"
   "            socket.close();\n"
   "        } catch (IOException ignored) {\n"
   "            // already closed\n"
   "        }\n"
   "    }\n"
   "}\n"))

(define (emit-java-http2)
  (cons "Http2Transport.java"
        (string-replace
