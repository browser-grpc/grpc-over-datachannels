(define (java-static-table)
  (string-join
   (for/list ([e (in-list http2-hpack-static-table)])
     (format "{~s, ~s}," (car e) (cdr e)))
   "\n        "))

(define (java-huff-codes)
  (string-join (map (lambda (e) (hex (car e))) http2-huffman-codes) ", "))

(define (java-huff-lens)
  (string-join (map (lambda (e) (number->string (cdr e))) http2-huffman-codes) ", "))

(define java-http2-part1
  (string-append
   "package grpcdc;\n\n"
   "import java.io.ByteArrayInputStream;\n"
   "import java.io.ByteArrayOutputStream;\n"
   "import java.io.DataInputStream;\n"
   "import java.io.EOFException;\n"
   "import java.io.IOException;\n"
   "import java.io.InputStream;\n"
   "import java.io.OutputStream;\n"
   "import java.net.Socket;\n"
   "import java.nio.charset.StandardCharsets;\n"
   "import java.util.ArrayList;\n"
   "import java.util.Arrays;\n"
   "import java.util.HashMap;\n"
   "import java.util.HashSet;\n"
   "import java.util.LinkedHashMap;\n"
   "import java.util.List;\n"
   "import java.util.Map;\n"
   "import java.util.Set;\n"
   "import java.util.concurrent.LinkedBlockingQueue;\n"
   "import java.util.zip.GZIPInputStream;\n"
   "import java.util.zip.GZIPOutputStream;\n"
   "import javax.net.ssl.SSLContext;\n"
   "import javax.net.ssl.SSLParameters;\n"
   "import javax.net.ssl.SSLSocket;\n"
   "import javax.net.ssl.SSLSocketFactory;\n\n"
   "/**\n"
   " * Cleartext/TLS HTTP/2 frame transport (RFC 9113, generated from\n"
   " * http2-spec.rkt) over a TCP socket. The mirror image of\n"
   " * oracle/bridge.mjs: a generated client can dial a stock gRPC\n"
   " * server directly (grpc-java server, grpc-go server), and a\n"
   " * front-end can terminate HTTP/2 for a generated server. TLS\n"
   " * via dialTls (ALPN h2). HTTP/2 server endpoints must enable\n"
   " * cleartext h2c upgrades / prior knowledge (stock servers do\n"
   " * not all listen plain HTTP/2; tests use the Java/Go greeters).\n"
   " * Client endpoints only.\n"
   " */\n"
   "public final class Http2Transport implements Transport {\n"
   "    static final int H2_DATA = 0x0;\n"
   "    static final int H2_HEADERS = 0x1;\n"
   "    static final int H2_RST_STREAM = 0x3;\n"
   "    static final int H2_SETTINGS = 0x4;\n"
   "    static final int H2_PING = 0x6;\n"
   "    static final int H2_GOAWAY = 0x7;\n"
   "    static final int H2_WINDOW_UPDATE = 0x8;\n"
   "    static final int H2_CONTINUATION = 0x9;\n"
   "    static final int FLAG_END_STREAM = 0x1;\n"
   "    static final int FLAG_END_HEADERS = 0x4;\n"
   "    static final int FLAG_ACK = 0x1;\n"
   "    static final int FLAG_PADDED = 0x8;\n"
   "    static final int FLAG_PRIORITY = 0x20;\n"
   "    static final int MAX_FRAME_PAYLOAD = 16384;\n\n"
   "    private static final String[][] STATIC_TABLE = {\n        JAVA_STATIC_TABLE\n    };\n\n"
   "    private static final int[] HUFF_CODES = {JAVA_HUFF_CODES};\n"
   "    private static final int[] HUFF_LENS = {JAVA_HUFF_LENS};\n"
   "    private static final Map<Long, Integer> HUFF_DECODE = new HashMap<>();\n\n"
   "    static {\n"
   "        for (int sym = 0; sym < HUFF_CODES.length; sym++) {\n"
   "            HUFF_DECODE.put(((long) HUFF_LENS[sym] << 32) | (HUFF_CODES[sym] & 0xffffffffL), sym);\n"
   "        }\n"
   "    }\n\n"
   "    static String huffDecode(byte[] data, int off, int len) throws IOException {\n"
   "        StringBuilder out = new StringBuilder();\n"
   "        long code = 0;\n"
   "        int bits = 0;\n"
   "        for (int i = 0; i < len; i++) {\n"
   "            int b = data[off + i] & 0xff;\n"
   "            for (int j = 7; j >= 0; j--) {\n"
   "                code = (code << 1) | ((b >> j) & 1);\n"
   "                bits++;\n"
   "                Integer sym = HUFF_DECODE.get(((long) bits << 32) | code);\n"
   "                if (sym != null) {\n"
   "                    if (sym == 256) {\n"
   "                        throw new IOException(\"huffman EOS symbol\");\n"
   "                    }\n"
   "                    out.append((char) sym.intValue());\n"
   "                    code = 0;\n"
   "                    bits = 0;\n"
   "                } else if (bits > 30) {\n"
   "                    throw new IOException(\"huffman code too long\");\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        return out.toString();\n"
   "    }\n\n"
   "    static final class HpackDecoder {\n"
   "        final List<String[]> dynamic = new ArrayList<>();\n"
   "        int dynamicSize = 0;\n"
   "        static final int MAX_DYNAMIC = 4096;\n\n"
   "        String[] entry(int index) throws IOException {\n"
   "            if (index <= 0) {\n"
   "                throw new IOException(\"bad hpack index 0\");\n"
   "            }\n"
   "            if (index <= STATIC_TABLE.length) {\n"
   "                String[] e = STATIC_TABLE[index - 1];\n"
   "                return new String[]{e[0], e[1]};\n"
   "            }\n"
   "            int j = index - STATIC_TABLE.length - 1;\n"
   "            if (j >= dynamic.size()) {\n"
   "                throw new IOException(\"bad hpack dynamic index \" + index);\n"
   "            }\n"
   "            return dynamic.get(j);\n"
   "        }\n\n"
   "        void add(String name, String value) {\n"
   "            dynamic.add(0, new String[]{name, value});\n"
   "            dynamicSize += name.length() + value.length() + 32;\n"
   "            while (dynamicSize > MAX_DYNAMIC && !dynamic.isEmpty()) {\n"
   "                String[] e = dynamic.remove(dynamic.size() - 1);\n"
   "                dynamicSize -= e[0].length() + e[1].length() + 32;\n"
   "            }\n"
   "        }\n\n"
   "        static int[] readInt(byte[] data, int[] pos, int prefixBits) throws IOException {\n"
   "            int mask = (1 << prefixBits) - 1;\n"
   "            int value = data[pos[0]] & mask;\n"
   "            pos[0]++;\n"
   "            if (value < mask) {\n"
   "                return new int[]{value};\n"
   "            }\n"
   "            int shift = 0;\n"
   "            while (true) {\n"
   "                if (pos[0] >= data.length) {\n"
   "                    throw new IOException(\"truncated hpack int\");\n"
   "                }\n"
   "                int b = data[pos[0]] & 0xff;\n"
   "                pos[0]++;\n"
   "                value += (b & 0x7f) << shift;\n"
   "                shift += 7;\n"
   "                if ((b & 0x80) == 0) {\n"
   "                    break;\n"
   "                }\n"
   "            }\n"
   "            return new int[]{value};\n"
   "        }\n\n"
   "        static String readString(byte[] data, int[] pos) throws IOException {\n"
   "            if (pos[0] >= data.length) {\n"
   "                throw new IOException(\"truncated hpack string\");\n"
   "            }\n"
   "            boolean huffman = (data[pos[0]] & 0x80) != 0;\n"
   "            int len = readInt(data, pos, 7)[0];\n"
   "            if (pos[0] + len > data.length) {\n"
   "                throw new IOException(\"truncated hpack string body\");\n"
   "            }\n"
   "            String value = huffman\n"
   "                    ? huffDecode(data, pos[0], len)\n"
   "                    : new String(data, pos[0], len, StandardCharsets.UTF_8);\n"
   "            pos[0] += len;\n"
   "            return value;\n"
   "        }\n\n"
   "        List<String[]> decode(byte[] block) throws IOException {\n"
   "            List<String[]> out = new ArrayList<>();\n"
   "            int[] pos = {0};\n"
   "            while (pos[0] < block.length) {\n"
   "                int b = block[pos[0]] & 0xff;\n"
   "                if ((b & 0x80) != 0) {\n"
   "                    int index = readInt(block, pos, 7)[0];\n"
   "                    out.add(entry(index));\n"
   "                } else if ((b & 0xe0) == 0x20) {\n"
   "                    readInt(block, pos, 5);\n"
   "                } else {\n"
   "                    boolean incremental = (b & 0xc0) == 0x40;\n"
   "                    int index = readInt(block, pos, incremental ? 6 : 4)[0];\n"
   "                    String name = index > 0 ? entry(index)[0] : readString(block, pos);\n"
   "                    String value = readString(block, pos);\n"
   "                    out.add(new String[]{name, value});\n"
   "                    if (incremental) {\n"
   "                        add(name, value);\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            return out;\n"
   "        }\n"
   "    }\n\n"
   "    static void writeInt(ByteArrayOutputStream out, int value, int prefixBits, int prefix) {\n"
   "        int mask = (1 << prefixBits) - 1;\n"
   "        if (value < mask) {\n"
   "            out.write(prefix | value);\n"
   "            return;\n"
   "        }\n"
   "        out.write(prefix | mask);\n"
   "        value -= mask;\n"
   "        while (value >= 0x80) {\n"
   "            out.write((value & 0x7f) | 0x80);\n"
   "            value >>= 7;\n"
   "        }\n"
   "        out.write(value);\n"
   "    }\n\n"
   "    static void writeString(ByteArrayOutputStream out, String value) {\n"
   "        byte[] raw = value.getBytes(StandardCharsets.UTF_8);\n"
   "        writeInt(out, raw.length, 7, 0);\n"
   "        out.write(raw, 0, raw.length);\n"
   "    }\n\n"
   "    static void writeLiteralIndexedName(ByteArrayOutputStream out, int index, String value) {\n"
   "        writeInt(out, index, 4, 0);\n"
   "        writeString(out, value);\n"
   "    }\n\n"
   "    static void writeLiteralNewName(ByteArrayOutputStream out, String name, String value) {\n"
   "        writeInt(out, 0, 4, 0);\n"
   "        writeString(out, name);\n"
   "        writeString(out, value);\n"
   "    }\n\n"))

(define java-http2-part2
