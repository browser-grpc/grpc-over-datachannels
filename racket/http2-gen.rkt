   "\tif endStream && hasStatus {\n"
   "\t\tcode, _ := strconv.Atoi(status)\n"
   "\t\tmessage, _ := url.PathUnescape(headers[\"grpc-message\"])\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"code\": code, \"message\": message})\n"
   "\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\treturn\n"
   "\t}\n"
   "\tif !t.headersSeen[streamID] {\n"
   "\t\tt.headersSeen[streamID] = true\n"
   "\t\tmetadata := map[string]string{}\n"
   "\t\tfor k, v := range headers {\n"
   "\t\t\tif strings.HasPrefix(k, \":\") || k == \"content-type\" || k == \"grpc-status\" || k == \"grpc-message\" {\n"
   "\t\t\t\tcontinue\n"
   "\t\t\t}\n"
   "\t\t\tmetadata[k] = v\n"
   "\t\t}\n"
   "\t\tbody, _ := json.Marshal(map[string]any{\"metadata\": metadata})\n"
   "\t\tt.emit(FrameHeaders, streamID, body)\n"
   "\t\tif endStream {\n"
   "\t\t\tbody, _ := json.Marshal(map[string]any{\"code\": 2, \"message\": \"missing grpc-status\"})\n"
   "\t\t\tt.emit(FrameTrailers, streamID, body)\n"
   "\t\t}\n"
   "\t\treturn\n"
   "\t}\n"
   "\tcode := 2\n"
   "\tif hasStatus {\n"
   "\t\tcode, _ = strconv.Atoi(status)\n"
   "\t}\n"
   "\tmessage, _ := url.PathUnescape(headers[\"grpc-message\"])\n"
   "\tbody, _ := json.Marshal(map[string]any{\"code\": code, \"message\": message})\n"
   "\tt.emit(FrameTrailers, streamID, body)\n"
   "}\n"
   "\n"
   "type h2Head struct {\n"
   "\tPath     string            `json:\"path\"`\n"
   "\tMetadata map[string]string `json:\"metadata\"`\n"
   "}\n"
   "\n"
   "// Send carries one grpc-dc frame to the HTTP/2 peer.\n"
   "func (t *Http2Transport) Send(data []byte) error {\n"
   "\tif len(data) < 9 {\n"
   "\t\treturn errors.New(\"http2: short frame\")\n"
   "\t}\n"
   "\tframeType := FrameType(data[0])\n"
   "\tstreamID := binary.BigEndian.Uint32(data[1:5])\n"
   "\tpayload := data[9:]\n"
   "\tswitch frameType {\n"
   "\tcase FrameHeaders:\n"
   "\t\tvar head h2Head\n"
   "\t\tif err := json.Unmarshal(payload, &head); err != nil {\n"
   "\t\t\treturn err\n"
   "\t\t}\n"
   "\t\tblock := []byte{0x83}\n"
   "\t\tif t.scheme == \"https\" {\n"
   "\t\t\tblock = append(block, 0x87)\n"
   "\t\t} else {\n"
   "\t\t\tblock = append(block, 0x86)\n"
   "\t\t}\n"
   "\t\tblock = append(block, hpackLiteralIndexedName(4, head.Path)...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\":authority\", t.authority)...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\"content-type\", \"application/grpc\")...)\n"
   "\t\tblock = append(block, hpackLiteralNewName(\"te\", \"trailers\")...)\n"
   "\t\tkeys := make([]string, 0, len(head.Metadata))\n"
   "\t\tfor k := range head.Metadata {\n"
   "\t\t\tkeys = append(keys, k)\n"
   "\t\t}\n"
   "\t\tsort.Strings(keys)\n"
   "\t\tfor _, k := range keys {\n"
   "\t\t\tblock = append(block, hpackLiteralNewName(strings.ToLower(k), head.Metadata[k])...)\n"
   "\t\t}\n"
   "\t\tt.winMu.Lock()\n"
   "\t\tif _, ok := t.windows[streamID]; !ok {\n"
   "\t\t\tt.windows[streamID] = t.peerInitial\n"
   "\t\t}\n"
   "\t\tt.winMu.Unlock()\n"
   "\t\treturn t.sendFrame(h2Headers, streamID, 0x4, block)\n"
   "\tcase FrameData:\n"
   "\t\tlpm := make([]byte, 5+len(payload))\n"
   "\t\tbinary.BigEndian.PutUint32(lpm[1:5], uint32(len(payload)))\n"
   "\t\tcopy(lpm[5:], payload)\n"
   "\t\toffset := 0\n"
   "\t\tfor offset < len(lpm) {\n"
   "\t\t\tt.winMu.Lock()\n"
   "\t\t\tfor t.connWindow <= 0 || t.windows[streamID] <= 0 {\n"
   "\t\t\t\tt.cond.Wait()\n"
   "\t\t\t}\n"
   "\t\t\tallowance := t.connWindow\n"
   "\t\t\tif t.windows[streamID] < allowance {\n"
   "\t\t\t\tallowance = t.windows[streamID]\n"
   "\t\t\t}\n"
   "\t\t\tif allowance > 16384 {\n"
   "\t\t\t\tallowance = 16384\n"
   "\t\t\t}\n"
   "\t\t\tif allowance > len(lpm)-offset {\n"
   "\t\t\t\tallowance = len(lpm) - offset\n"
   "\t\t\t}\n"
   "\t\t\tt.connWindow -= allowance\n"
   "\t\t\tt.windows[streamID] -= allowance\n"
   "\t\t\tt.winMu.Unlock()\n"
   "\t\t\tchunk := lpm[offset : offset+allowance]\n"
   "\t\t\toffset += allowance\n"
   "\t\t\tif err := t.sendFrame(h2Data, streamID, 0, chunk); err != nil {\n"
   "\t\t\t\treturn err\n"
   "\t\t\t}\n"
   "\t\t}\n"
   "\t\treturn nil\n"
   "\tcase FrameHalfClose:\n"
   "\t\treturn t.sendFrame(h2Data, streamID, 0x1, nil)\n"
   "\tcase FrameRst:\n"
   "\t\tpayload := make([]byte, 4)\n"
   "\t\tbinary.BigEndian.PutUint32(payload, 8)\n"
   "\t\treturn t.sendFrame(h2RSTStream, streamID, 0, payload)\n"
   "\t}\n"
   "\treturn nil\n"
   "}\n"
   "\n"
   "// Recv returns the next synthesized grpc-dc frame, or io.EOF\n"
   "// when the connection closes.\n"
   "func (t *Http2Transport) Recv() ([]byte, error) {\n"
   "\tframe, ok := <-t.recvCh\n"
   "\tif !ok {\n"
   "\t\treturn nil, io.EOF\n"
   "\t}\n"
   "\treturn frame, nil\n"
   "}\n"
   "\n"
   "// Close shuts the connection down.\n"
   "func (t *Http2Transport) Close() error {\n"
   "\treturn t.conn.Close()\n"
   "}\n"))

