   "        }\n"
   "        // Connection preface + an empty SETTINGS frame.\n"
   "        byte[] preface = Encoding.UTF8.GetBytes(\"PRI * HTTP/2.0\\r\\n\\r\\nSM\\r\\n\\r\\n\");\n"
