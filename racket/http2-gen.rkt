   "                cond.lock()\n"
   "                for key in Array(streamWindows.keys) {\n"
   "                    streamWindows[key] = (streamWindows[key] ?? 0) + delta\n"
   "                }\n"
   "                cond.broadcast()\n"
   "                cond.unlock()\n"
   "            }\n"
   "            WriteFrame(Http2Transport.H2Settings, Http2Transport.FlagAck, 0, [])\n"
   "        case Http2Transport.H2WindowUpdate:\n"
   "            if payload.count >= 4 {\n"
   "                let inc = (Int(payload[0] & 0x7f) << 24) | (Int(payload[1]) << 16)\n"
   "                    | (Int(payload[2]) << 8) | Int(payload[3])\n"
   "                cond.lock()\n"
   "                if streamId == 0 {\n"
   "                    connWindow += inc\n"
   "                } else {\n"
   "                    streamWindows[streamId] = (streamWindows[streamId] ?? peerInitialWindow) + inc\n"
   "                }\n"
   "                cond.broadcast()\n"
   "                cond.unlock()\n"
   "            }\n"
   "        case Http2Transport.H2Ping:\n"
   "            if (flags & Http2Transport.FlagAck) == 0 && payload.count == 8 {\n"
   "                WriteFrame(Http2Transport.H2Ping, Http2Transport.FlagAck, 0, payload)\n"
   "            }\n"
   "        case Http2Transport.H2RstStream:\n"
   "            Emit(Wire.FrameRst, streamId, [UInt8](\"{\\\"code\\\":8,\\\"message\\\":\\\"rst stream\\\"}\".utf8))\n"
