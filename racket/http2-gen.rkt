   "                let pad = Int(body[0])\n"
   "                body = pad + 1 <= body.count ? Array(body[1..<(body.count - pad)]) : []\n"
   "            }\n"
   "            if !body.isEmpty {\n"
   "                WriteFrame(Http2Transport.H2WindowUpdate, 0, 0, WindowUpdate(body.count))\n"
   "                WriteFrame(Http2Transport.H2WindowUpdate, 0, streamId, WindowUpdate(body.count))\n"
   "                var buf = dataBuffers[streamId] ?? []\n"
   "                buf.append(contentsOf: body)\n"
   "                dataBuffers[streamId] = buf\n"
   "                DrainMessages(streamId)\n"
   "            }\n"
   "            if (flags & Http2Transport.FlagEndStream) != 0 {\n"
   "                EmitTrailersFrame(streamId, 2, \"missing grpc-status\", nil)\n"
   "            }\n"
