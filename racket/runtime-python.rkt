(define python-codec-body
#<<GRPC_RUNTIME_EOF
"""Codec + status types for gRPC over WebRTC DataChannels.

Wire protocol in ../SPEC.md. Frame, status, channel and server
semantics mirror the Rust, JavaScript and Go runtimes; the tables in
wire_gen.py are generated by grpc-dc codegen.
"""

import json
import struct

from .wire_gen import (
    CODE_INVALID_ARGUMENT,
    CODE_OK,
    CODE_RESOURCE_EXHAUSTED,
    CODE_UNKNOWN,
    FRAME_DATA,
    FRAME_HEADERS,
    FRAME_NAMES,
    STATUS_NAMES,
)

HEADER_LEN = 9
MAX_DATA_PAYLOAD = 16 * 1024 * 1024


def status_name(code):
    """Canonical status name (CODE_N for unknown codes)."""
    return STATUS_NAMES.get(code, f"CODE_{code}")


# --- Homegrown tracing@@TRACING_BETA@@ (W3C traceparent propagation) -----------------
# Dormant until set_tracer() registers an observer. The observer is
# any object with on_start(kind, method, trace_id, span_id,
# parent_span_id) and on_end(kind, method, trace_id, span_id,
# status_name). Generated code stays dependency-free: sampling,
# batching and export are the application's problem.

import secrets as _secrets
import time as _time

_tracer = None


def set_tracer(tracer):
    """Register the global span observer (None disables tracing)."""
    global _tracer
    _tracer = tracer


_trace_filter = []


def set_trace_filter(patterns):
    """Restrict traced methods: ';'-separated paths, a trailing
    '*' means prefix match ('/echo.Echo/*'). Empty = trace all."""
    global _trace_filter
    _trace_filter = [p for p in patterns.split(";") if p]


def _trace_allowed(method):
    if not _trace_filter:
        return True
    for pattern in _trace_filter:
        if pattern.endswith("*"):
            if method.startswith(pattern[:-1]):
                return True
        elif method == pattern:
            return True
    return False


def get_tracer():
    return _tracer


def _new_trace_id():
    return _secrets.token_hex(16)


def _new_span_id():
    return _secrets.token_hex(8)


def format_traceparent(trace_id, span_id, sampled=True):
    return f"00-{trace_id}-{span_id}-{'01' if sampled else '00'}"


def parse_traceparent(value):
    """Parse a traceparent header -> (trace_id, span_id, sampled) or None."""
    if not isinstance(value, str):
        return None
    parts = value.split("-")
    if len(parts) != 4:
        return None
    _, trace_id, span_id, flags = parts
    if len(trace_id) != 32 or len(span_id) != 16 or len(flags) != 2:
        return None
    try:
        int(trace_id, 16)
        int(span_id, 16)
        flags_int = int(flags, 16)
    except ValueError:
        return None
    return (trace_id, span_id, bool(flags_int & 1))


def trace_start(kind, method, parent):
    """Begin a span; parent is a parsed traceparent or None.

    Returns a context dict (keys: trace_id, span_id,
    parent_span_id, sampled) or None when no tracer is
    registered. An upstream not-sampled decision is honored:
    the context still propagates (flags 00) but no span is
    recorded.
    """
    if _tracer is None or not _trace_allowed(method):
        return None
    if parent is not None:
        trace_id, parent_span_id, sampled = parent
    else:
        trace_id, parent_span_id, sampled = _new_trace_id(), "", True
    ctx = {
        "trace_id": trace_id,
        "span_id": _new_span_id(),
        "parent_span_id": parent_span_id,
        "sampled": sampled,
        "start": _time.monotonic(),
    }
    if not sampled:
        return ctx
    try:
        _tracer.on_start(kind, method, ctx["trace_id"], ctx["span_id"], parent_span_id)
    except Exception:
        pass  # observers must never break the call
    return ctx


def trace_end(kind, method, ctx, status):
    if ctx is None or _tracer is None or not ctx.get("sampled", True):
        return
    try:
        duration_ms = (_time.monotonic() - ctx["start"]) * 1000.0
        _tracer.on_end(kind, method, ctx["trace_id"], ctx["span_id"], status, duration_ms)
    except Exception:
        pass


# --- Trace-context propagation (ambient + explicit) ----------------
# The server activates its span context while the handler runs;
# Channel._open then parents outbound client spans to it with no
# manual metadata handling. ContextVar storage keeps concurrent
# calls (threads and asyncio tasks) apart.
import contextvars as _contextvars
from contextlib import contextmanager as _contextmanager

_current_trace_context = _contextvars.ContextVar(
    "grpcdc_current_trace_context", default=None)


def current_trace_context():
    """The trace context active in this execution context, or None."""
    return _current_trace_context.get()


@_contextmanager
def with_trace_context(ctx):
    """Run the enclosed block with ctx as the ambient trace context."""
    token = _current_trace_context.set(ctx)
    try:
        yield ctx
    finally:
        _current_trace_context.reset(token)


def new_trace_context(kind="internal", method=""):
    """Start a root span context (e.g. for a client workflow that
    groups several outbound calls under one trace). Pair with
    trace_end. Returns None when tracing is dormant."""
    return trace_start(kind, method, None)


def _trace_parent(ctx):
    if ctx is None:
        return None
    return (ctx["trace_id"], ctx["span_id"], ctx["sampled"])


class StatusError(Exception):
    """A gRPC status (code + message) carried as an exception."""

    def __init__(self, code, message=""):
        super().__init__(message)
        self.code = code
        self.message = message
        # Trailing metadata carried by a status frame ({} when
        # the peer sent none); parse_status fills it in.
        self.trailers = {}

    def __str__(self):
        return f"{status_name(self.code)}: {self.message}"


class CallClosed(EOFError):
    """The call completed OK (client-side stream end)."""


def to_status(err):
    """Convert an exception to StatusError (OK for None)."""
    if err is None:
        return StatusError(CODE_OK, "")
    if isinstance(err, StatusError):
        return err
    return StatusError(16, str(err))  # INTERNAL


def encode_frame(frame_type, stream_id, payload):
    """Build one DataChannel message: header + payload."""
    if frame_type not in FRAME_NAMES.values():
        raise StatusError(
            CODE_INVALID_ARGUMENT, f"unknown frame type {frame_type}"
        )
    if frame_type == FRAME_DATA and len(payload) > MAX_DATA_PAYLOAD:
        raise StatusError(CODE_RESOURCE_EXHAUSTED, "DATA payload exceeds 16 MiB")
    return struct.pack(">BII", frame_type, stream_id, len(payload)) + payload


def decode_frame(data):
    """Parse one DataChannel message -> (frame_type, stream_id, payload)."""
    if len(data) < HEADER_LEN:
        raise StatusError(
            CODE_INVALID_ARGUMENT,
            f"frame shorter than 9-byte header: {len(data)} bytes",
        )
    frame_type, stream_id, length = struct.unpack(">BII", data[:HEADER_LEN])
    if length != len(data) - HEADER_LEN:
        raise StatusError(
            CODE_INVALID_ARGUMENT,
            f"payload length {length} does not match message size {len(data)}",
        )
    return frame_type, stream_id, data[HEADER_LEN:]


class Headers:
    """A parsed HEADERS payload: path=None marks response headers."""

    def __init__(self, path=None, metadata=None):
        self.path = path
        self.metadata = metadata or {}

    def __repr__(self):
        return f"Headers(path={self.path!r}, metadata={self.metadata!r})"


def headers_frame(stream_id, path, metadata):
    body = {}
    if path is not None:
        body["path"] = path
    if metadata:
        body["metadata"] = dict(metadata)
    return encode_frame(FRAME_HEADERS, stream_id, json.dumps(body).encode("utf-8"))


def parse_headers(payload):
    try:
        body = json.loads(payload.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        raise StatusError(CODE_INVALID_ARGUMENT, f"bad HEADERS payload: {e}")
    if not isinstance(body, dict):
        raise StatusError(CODE_INVALID_ARGUMENT, "HEADERS payload is not an object")
    metadata = body.get("metadata") or {}
    if not isinstance(metadata, dict):
        raise StatusError(CODE_INVALID_ARGUMENT, "HEADERS metadata is not an object")
    return Headers(body.get("path"), metadata)


# gRPC timeout grammar (grpc-timeout metadata): <digits><unit> with
# units H/M/S/m/u/n. Encoding picks milliseconds (seconds past the
# 8-digit limit); values are rounded up so a deadline never shrinks.
_TIMEOUT_UNITS = {"H": 3600.0, "M": 60.0, "S": 1.0, "m": 1e-3, "u": 1e-6, "n": 1e-9}


def encode_timeout(seconds):
    import math

    ms = int(math.ceil(seconds * 1000.0))
    if ms <= 99999999:
        return f"{ms}m"
    return f"{int(math.ceil(seconds))}S"


def parse_timeout(text):
    """Seconds for a grpc-timeout value, or None when malformed."""
    if not isinstance(text, str) or len(text) < 2:
        return None
    unit = _TIMEOUT_UNITS.get(text[-1])
    digits = text[:-1]
    if unit is None or not digits.isdigit() or len(digits) > 8:
        return None
    return int(digits) * unit


# Status frames (TRAILERS/RST) carry {code, message} and, when
# the call produced trailing metadata, a metadata member with
# the same JSON shape as HEADERS metadata (SPEC.md). Peers that
# predate trailing metadata ignore the member.
def status_frame(frame_type, stream_id, status, trailers=None):
    body = {"code": status.code, "message": status.message}
    md = trailers if trailers is not None else getattr(status, "trailers", None)
    if md:
        body["metadata"] = dict(md)
    return encode_frame(frame_type, stream_id, json.dumps(body).encode("utf-8"))


def parse_status(payload):
    try:
        body = json.loads(payload.decode("utf-8"))
        status = StatusError(int(body["code"]), str(body.get("message", "")))
        status.trailers = body.get("metadata") or {}
        return status
    except (ValueError, KeyError, TypeError, UnicodeDecodeError):
        return StatusError(CODE_UNKNOWN, "malformed trailers")
GRPC_RUNTIME_EOF
)

(define python-endpoint-body
#<<GRPC_RUNTIME_EOF
"""Endpoint: multiplexes grpc-dc streams over one Transport."""

import queue
import threading
import time as _time

from .codec import (
    StatusError,
    decode_frame,
    headers_frame,
    parse_headers,
    parse_status,
    parse_timeout,
    status_frame,
    to_status,
)


def _monotonic():
    return _time.monotonic()
from .wire_gen import (
    CODE_CANCELLED,
    CODE_INTERNAL,
    CODE_UNAVAILABLE,
    CODE_UNIMPLEMENTED,
    FRAME_RST,
    FRAME_TRAILERS,
)

EVENT_HEADERS = "headers"
EVENT_DATA = "data"
EVENT_HALF_CLOSE = "half-close"
EVENT_TRAILERS = "trailers"
EVENT_RST = "rst"

_CLOSED = object()
TIMEOUT = object()


class Transport:
    """Carries whole DataChannel messages (boundaries preserved).

    recv() returns one message, or raises EOFError when the transport
    is closed.
    """

    def send(self, data):
        raise NotImplementedError

    def recv(self):
        raise NotImplementedError


class StreamEvent:
    def __init__(self, kind, headers=None, payload=None, status=None):
        self.kind = kind
        self.headers = headers
        self.payload = payload
        self.status = status


class StreamInput:
    """Receiving queue of one stream; closed after a terminal event."""

    def __init__(self):
        self.events = queue.Queue()

    def put(self, event):
        self.events.put(event)

    def close(self):
        self.events.put(_CLOSED)

    def get(self, timeout=None):
        """Next event, or None once the stream is closed.

        With a timeout (seconds), returns the TIMEOUT sentinel
        instead of an event when the wait expires.
        """
        try:
            event = self.events.get(timeout=timeout)
        except queue.Empty:
            return TIMEOUT
        if event is _CLOSED:
            return None
        return event


class ResponseSink:
    def __init__(self, endpoint, stream_id):
        self._endpoint = endpoint
        self._id = stream_id
        # Initial/trailing metadata accumulated via the call
        # context (wired to CallContext by the endpoint). Initial
        # metadata flushes lazily before the first DATA frame;
        # trailers merge into the terminal status frame.
        self.resp_headers = {}
        self.resp_trailers = {}
        self.headers_sent = False

    def send_data(self, payload):
        from .codec import encode_frame
        from .wire_gen import FRAME_DATA

        if self._endpoint._stream(self._id) is None:
            # RST by the peer (or the channel went away): fail
            # the send so a producing handler stops instead of
            # streaming into the void.
            raise StatusError(CODE_CANCELLED, "call cancelled")
        self.flush_headers()
        self._endpoint.send_frame(encode_frame(FRAME_DATA, self._id, payload))

    def flush_headers(self):
        if not self.headers_sent:
            self.headers_sent = True
            self.send_headers()

    def send_headers(self, metadata=None):
        if metadata is None:
            metadata = self.resp_headers
        if self._endpoint._stream(self._id) is None:
            raise StatusError(CODE_CANCELLED, "call cancelled")
        self.headers_sent = True
        self._endpoint.send_frame(headers_frame(self._id, None, metadata))

    def send_trailers(self, status):
        merged = dict(self.resp_trailers)
        merged.update(getattr(status, "trailers", None) or {})
        self._endpoint.send_frame(
            status_frame(FRAME_TRAILERS, self._id, status, merged)
        )

    # ServerSink interface used by Server.
    def send(self, payload):
        self.send_data(payload)


class CallContext:
    """Per-call context: metadata sent in HEADERS, plus the call's
    deadline derived from the grpc-timeout metadata value."""

    def __init__(self, metadata=None):
        self.metadata = metadata or {}
        self.response_headers = {}
        self.response_trailers = {}
        self.trace_context = None
        self.deadline = None
        remaining = parse_timeout(self.metadata.get("grpc-timeout"))
        if remaining is not None:
            self.deadline = _monotonic() + remaining

    def set_headers(self, md):
        """Record response initial metadata (dict update)."""
        self.response_headers.update(md)

    def set_trailers(self, md):
        """Record response trailing metadata (dict update)."""
        self.response_trailers.update(md)

    def time_remaining(self):
        """Seconds until the deadline (may be negative), or None
        when the call carries no deadline."""
        if self.deadline is None:
            return None
        return self.deadline - _monotonic()

    def deadline_exceeded(self):
        remaining = self.time_remaining()
        return remaining is not None and remaining <= 0


class Endpoint:
    """Multiplexes streams over one Transport.

    The side that created the channel allocates odd stream ids, the
    answerer even.
    """

    def __init__(self, transport, creator):
        self.transport = transport
        self.dispatcher = None
        self._next_id = 1 if creator else 2
        self._send_lock = threading.Lock()
        self._streams = {}
        self._streams_lock = threading.Lock()
        self._closed = False
        self._started = False

    def start(self):
        """Start the read loop (idempotent). Called after any
        dispatcher is installed, so an early HEADERS can never race
        dispatcher setup."""
        if self._started:
            return
        self._started = True
        threading.Thread(target=self._read_loop, daemon=True).start()

    def set_dispatcher(self, dispatcher):
        self.dispatcher = dispatcher

    def send_frame(self, frame):
        with self._send_lock:
            self.transport.send(frame)

    def open_stream(self):
        with self._send_lock:
            stream_id = self._next_id
            self._next_id += 2
        stream_input = StreamInput()
        with self._streams_lock:
            self._streams[stream_id] = stream_input
        return stream_id, stream_input

    def close_stream(self, stream_id):
        with self._streams_lock:
            self._streams.pop(stream_id, None)

    def cancel_stream(self, stream_id):
        """Abort one stream: RST towards the peer, forget it locally.

        Any thread blocked in recv on this stream wakes with the
        cancellation status (the local input is closed with a
        synthetic RST event).
        """
        status = StatusError(CODE_CANCELLED, "call cancelled")
        with self._streams_lock:
            stream_input = self._streams.pop(stream_id, None)
        if stream_input is not None:
            stream_input.put(StreamEvent(EVENT_RST, status=status))
            stream_input.close()
        try:
            self.send_frame(status_frame(FRAME_RST, stream_id, status))
        except Exception:
            pass

    def _stream(self, stream_id):
        with self._streams_lock:
            return self._streams.get(stream_id)

    def close(self):
        if self._closed:
            return
        self._closed = True
        closer = getattr(self.transport, "close", None)
        if closer is not None:
            try:
                closer()
            except Exception:
                pass
        self._fail_all()

    def _fail_all(self):
        with self._streams_lock:
            pending = list(self._streams.items())
            self._streams.clear()
        for _stream_id, stream_input in pending:
            stream_input.put(
                StreamEvent(
                    EVENT_RST,
                    status=StatusError(CODE_UNAVAILABLE, "data channel closed"),
                )
            )
            stream_input.close()

    def _read_loop(self):
        while True:
            try:
                data = self.transport.recv()
            except Exception:
                self._fail_all()
                return
            if self._closed:
                return
            self._on_bytes(data)

    def _on_bytes(self, data):
        try:
            frame_type, stream_id, payload = decode_frame(data)
        except StatusError:
            return  # malformed frame: drop, keep the channel up
@@FRAME_DISPATCH@@

    def _on_terminal(self, stream_id, payload, kind):
        stream_input = self._stream(stream_id)
        if stream_input is not None:
            stream_input.put(StreamEvent(kind, status=parse_status(payload)))
            stream_input.close()
            self.close_stream(stream_id)

    def _push_event(self, stream_id, event):
        stream_input = self._stream(stream_id)
        if stream_input is not None:
            stream_input.put(event)

    def _on_headers(self, stream_id, payload):
        try:
            headers = parse_headers(payload)
        except StatusError as e:
            try:
                self.send_frame(status_frame(FRAME_RST, stream_id, to_status(e)))
            except Exception:
                pass
            return
        if headers.path is None:
            # Server response headers for one of our outbound streams.
            stream_input = self._stream(stream_id)
            if stream_input is not None:
                stream_input.put(StreamEvent(EVENT_HEADERS, headers=headers))
            return
        if self._stream(stream_id) is not None:
            try:
                self.send_frame(
                    status_frame(
                        FRAME_RST,
                        stream_id,
                        StatusError(CODE_INTERNAL, "HEADERS for stream already in use"),
                    )
                )
            except Exception:
                pass
            return
        if self.dispatcher is None:
            try:
                self.send_frame(
                    status_frame(
                        FRAME_TRAILERS,
                        stream_id,
                        StatusError(
                            CODE_UNIMPLEMENTED, f"unknown method {headers.path}"
                        ),
                    )
                )
            except Exception:
                pass
            return
        stream_input = StreamInput()
        with self._streams_lock:
            self._streams[stream_id] = stream_input
        sink = ResponseSink(self, stream_id)

        def run_call():
            try:
                # No eager HEADERS: initial metadata flushes
                # lazily via the sink (first DATA, or below on a
                # DATA-less success) so handlers can set_headers
                # first. Errors end trailers-only, as gRPC allows.
                ctx = CallContext(headers.metadata)
                sink.resp_headers = ctx.response_headers
                sink.resp_trailers = ctx.response_trailers
                status = self.dispatcher(ctx, headers, stream_input, sink)
                if status is None:
                    status = StatusError(0, "")
                    try:
                        sink.flush_headers()
                    except Exception:
                        pass
                try:
                    sink.send_trailers(status)
                except Exception:
                    pass
            finally:
                self.close_stream(stream_id)

        threading.Thread(target=run_call, daemon=True).start()
GRPC_RUNTIME_EOF
)

(define python-channel-body
#<<GRPC_RUNTIME_EOF
"""Channel: the client side of one Endpoint."""

import asyncio

from .codec import (
    StatusError,
    encode_frame,
    encode_timeout,
    format_traceparent,
    get_tracer,
    headers_frame,
    _trace_parent,
    current_trace_context,
    parse_traceparent,
    status_name,
    trace_end,
    trace_start,
)
from .endpoint import (
    EVENT_DATA,
    EVENT_HEADERS,
    EVENT_RST,
    EVENT_TRAILERS,
    TIMEOUT,
    Endpoint,
    _monotonic,
)
from .wire_gen import (
    CODE_DEADLINE_EXCEEDED,
    CODE_INTERNAL,
    CODE_UNAVAILABLE,
    FRAME_DATA,
    FRAME_HALF_CLOSE,
)


class Channel:
    """Client side; allocates odd stream ids on a fresh Endpoint."""

    def __init__(self, transport=None, endpoint=None):
        if endpoint is not None:
            self.endpoint = endpoint
        else:
            self.endpoint = Endpoint(transport, creator=True)
        self._trace_context = None
        self.endpoint.start()

    def with_trace_context(self, ctx):
        """A Channel view sharing this endpoint, whose outbound
        spans are parented to ctx (a server span context or a root
        from new_trace_context). Explicit call metadata still wins."""
        ch = Channel.__new__(Channel)
        ch.endpoint = self.endpoint
        ch._trace_context = ctx
        return ch

    def _open(self, path, metadata, timeout=None):
        deadline = None
        trace_ctx = None
        if timeout is not None or get_tracer() is not None:
            merged = dict(metadata) if metadata else {}
            if timeout is not None:
                deadline = _monotonic() + timeout
                merged["grpc-timeout"] = encode_timeout(timeout)
            if get_tracer() is not None:
                parent = parse_traceparent(merged.get("traceparent"))
                if parent is None:
                    parent = _trace_parent(self._trace_context)
                if parent is None:
                    parent = _trace_parent(current_trace_context())
                trace_ctx = trace_start("client", path, parent)
                if trace_ctx is not None:
                    merged["traceparent"] = format_traceparent(
                        trace_ctx["trace_id"], trace_ctx["span_id"],
                        trace_ctx["sampled"]
                    )
            metadata = merged
        stream_id, stream_input = self.endpoint.open_stream()
        try:
            self.endpoint.send_frame(headers_frame(stream_id, path, metadata))
        except Exception:
            self.endpoint.close_stream(stream_id)
            trace_end("client", path, trace_ctx, "UNAVAILABLE")
            raise
        stream = ClientStream(self.endpoint, stream_id, stream_input)
        stream.deadline = deadline
        stream.trace_ctx = trace_ctx
        stream.trace_path = path
        return stream

    def _send_message(self, stream, msg):
        self.endpoint.send_frame(
            encode_frame(FRAME_DATA, stream.stream_id, msg.marshal_dc())
        )

    def _half_close(self, stream):
        self.endpoint.send_frame(encode_frame(FRAME_HALF_CLOSE, stream.stream_id, b""))

    def _send_all(self, stream, reqs):
        for req in reqs:
            self._send_message(stream, req)
        self._half_close(stream)

    def cancel(self, stream):
        """Abort an open ClientStream (sends RST)."""
        self.endpoint.cancel_stream(stream.stream_id)

    def unary(self, path, req, resp, metadata=None, timeout=None):
        """Run a unary call, decoding the single response into resp.

        timeout (seconds) sets a deadline: it is propagated as
        grpc-timeout metadata and enforced locally — on expiry the
        call is aborted with RST and DEADLINE_EXCEEDED is raised.
        """
        return self._unary(path, req, resp, metadata, timeout)

    def _unary(self, path, req, resp, metadata, timeout=None):
        stream = self._open(path, metadata, timeout)
        try:
            self._send_message(stream, req)
            self._half_close(stream)
            got = False
            while True:
                try:
                    stream.recv(resp)
                except EOFError:
                    if not got:
                        raise StatusError(
                            CODE_INTERNAL, "call closed with no response"
                        )
                    return resp
                if got:
                    raise StatusError(
                        CODE_INTERNAL, "unary call received more than one response"
                    )
                got = True
        finally:
            self.endpoint.close_stream(stream.stream_id)

    def server_stream(self, path, req, metadata=None, timeout=None):
        """Start a server-streaming call; returns a ClientStream."""
        stream = self._open(path, metadata, timeout)
        self._send_message(stream, req)
        self._half_close(stream)
        return stream

    def unary_stream(self, path, req, metadata=None, timeout=None):
        """Start a unary call; returns the ClientStream so
        callers can inspect .headers/.trailers around recv."""
        stream = self._open(path, metadata, timeout)
        self._send_message(stream, req)
        self._half_close(stream)
        return stream

    def client_stream(self, path, reqs, resp, metadata=None, timeout=None):
        """Send all requests, then decode the one response into resp."""
        stream = self._open(path, metadata, timeout)
        try:
            self._send_all(stream, reqs)
            got = False
            while True:
                try:
                    stream.recv(resp)
                except EOFError:
                    if not got:
                        raise StatusError(
                            CODE_INTERNAL, "call closed with no response"
                        )
                    return resp
                if got:
                    raise StatusError(
                        CODE_INTERNAL,
                        "client-streaming call received more than one response",
                    )
                got = True
        finally:
            self.endpoint.close_stream(stream.stream_id)

    def bidi(self, path, reqs, metadata=None, timeout=None):
        """Start a bidi call with all requests sent up front."""
        stream = self._open(path, metadata, timeout)
        self._send_all(stream, reqs)
        return stream


class ClientStream:
    """Receives response messages of one call."""

    def __init__(self, endpoint, stream_id, stream_input):
        self._endpoint = endpoint
        self.stream_id = stream_id
        self._input = stream_input
        self.headers = None
        self.trailers = None
        self.deadline = None
        self.trace_ctx = None
        self.trace_path = None
        self._trace_ended = False
        self._terminated = False

    def _end_trace(self, status):
        if not self._trace_ended:
            self._trace_ended = True
            trace_end("client", self.trace_path, self.trace_ctx, status)

    def cancel(self):
        """Abort the call (RST) unless it already terminated."""
        if not self._terminated:
            self._terminated = True
            self._endpoint.cancel_stream(self.stream_id)

    def _fail_deadline(self):
        self._end_trace("DEADLINE_EXCEEDED")
        self._terminated = True
        self._endpoint.cancel_stream(self.stream_id)
        raise StatusError(CODE_DEADLINE_EXCEEDED, "deadline exceeded")

    def recv(self, resp):
        """Decode the next response into resp.

        Raises EOFError when the call completed OK; StatusError
        reports the trailers status (or DEADLINE_EXCEEDED when
        the stream's deadline passed waiting for a response).
        """
        while True:
            wait = None
            if self.deadline is not None:
                wait = self.deadline - _monotonic()
                if wait <= 0:
                    self._fail_deadline()
            event = self._input.get(timeout=wait)
            if event is TIMEOUT:
                self._fail_deadline()
            if event is None:
                self._terminated = True
                raise StatusError(CODE_UNAVAILABLE, "data channel closed")
            if event.kind == EVENT_HEADERS:
                self.headers = event.headers
            elif event.kind == EVENT_DATA:
                resp.unmarshal_dc(event.payload)
                return resp
            elif event.kind == EVENT_TRAILERS:
                self._terminated = True
                self.trailers = event.status.trailers
                self._end_trace(status_name(event.status.code))
                if event.status.code != 0:
                    raise event.status
                raise EOFError("call completed")
            elif event.kind == EVENT_RST:
                self._terminated = True
                self.trailers = event.status.trailers
                self._end_trace(status_name(event.status.code))
                raise event.status


class AsyncClientStream:
    """Asyncio receiving stream wrapping a ClientStream.

    The blocking wait runs on the event loop's default executor,
    so awaiting never stalls the loop. Cancelling the awaiting
    task aborts the stream with RST (CODE_CANCELLED).
    """

    def __init__(self, stream):
        self._stream = stream

    @property
    def stream_id(self):
        return self._stream.stream_id

    @property
    def headers(self):
        return self._stream.headers

    async def recv(self, resp):
        loop = asyncio.get_running_loop()
        # shield: task cancellation surfaces immediately (the
        # executor thread cannot be cancelled); we then abort
        # the stream, which wakes that thread with RST.
        future = loop.run_in_executor(None, self._stream.recv, resp)
        try:
            return await asyncio.shield(future)
        except asyncio.CancelledError:
            self.cancel()
            raise

    def cancel(self):
        self._stream.cancel()


class AsyncChannel:
    """Asyncio client facade over Channel (mirrors grpc.aio shape).

    Unary and client-streaming calls are awaited on executor
    threads; server-streaming and bidi calls return an
    AsyncClientStream. Construct directly over a transport or
    wrap an existing sync Channel to share its Endpoint.
    """

    def __init__(self, channel=None, transport=None, endpoint=None):
        if isinstance(channel, Channel):
            self._channel = channel
        elif channel is not None and transport is None and endpoint is None:
            self._channel = Channel(channel)  # a bare transport
        else:
            self._channel = Channel(transport, endpoint)

    @property
    def channel(self):
        return self._channel

    @property
    def endpoint(self):
        return self._channel.endpoint

    def with_trace_context(self, ctx):
        """AsyncChannel view whose calls parent to ctx (see Channel)."""
        return AsyncChannel(channel=self._channel.with_trace_context(ctx))

    async def unary(self, path, req, resp, metadata=None, timeout=None):
        loop = asyncio.get_running_loop()
        return await loop.run_in_executor(
            None, lambda: self._channel.unary(path, req, resp, metadata, timeout))

    async def client_stream(self, path, reqs, resp, metadata=None, timeout=None):
        loop = asyncio.get_running_loop()
        return await loop.run_in_executor(
            None,
            lambda: self._channel.client_stream(path, reqs, resp, metadata, timeout))

    async def server_stream(self, path, req, metadata=None, timeout=None):
        loop = asyncio.get_running_loop()
        stream = await loop.run_in_executor(
            None, lambda: self._channel.server_stream(path, req, metadata, timeout))
        return AsyncClientStream(stream)

    async def bidi(self, path, reqs, metadata=None, timeout=None):
        loop = asyncio.get_running_loop()
        stream = await loop.run_in_executor(
            None, lambda: self._channel.bidi(path, reqs, metadata, timeout))
        return AsyncClientStream(stream)
GRPC_RUNTIME_EOF
)

