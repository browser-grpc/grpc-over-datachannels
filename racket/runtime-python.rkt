#<<GRPC_RUNTIME_EOF
"""In-memory transport pair for tests (one queue per direction)."""

import queue

from .endpoint import Transport

_SENTINEL = object()


class _MemoryTransport(Transport):
    def __init__(self, inbox, outbox):
        self._inbox = inbox
        self._outbox = outbox
        self._closed = False

    def send(self, data):
        if self._closed:
            raise EOFError("transport closed")
        self._outbox.put(bytes(data))

    def recv(self):
        item = self._inbox.get()
        if item is _SENTINEL:
            raise EOFError("transport closed")
        return item

    def close(self):
        self._closed = True
        self._inbox.put(_SENTINEL)


def memory_transport_pair():
    """Two connected in-memory transports."""
    a_to_b = queue.Queue()
    b_to_a = queue.Queue()
    return _MemoryTransport(b_to_a, a_to_b), _MemoryTransport(a_to_b, b_to_a)
GRPC_RUNTIME_EOF
)

(define python-sidecar-body
#<<GRPC_RUNTIME_EOF
"""Transport over the Rust WebRTC-Direct sidecar.

Every generated language can reach WebRTC-Direct listeners (and
dial them, including over TURN for symmetric-NAT paths) through
the Rust `direct_sidecar`: it owns the DTLS/SCTP/TURN stack and
bridges one datachannel to a local TCP socket using u32
big-endian length-prefixed messages (one prefix per
DataChannel message, boundaries preserved). This module is the
client half of that bridge -- stdlib only.

    # Rust sidecar already running:
    #   direct_sidecar dial --multiaddr /ip4/.../webrtc-direct/certhash/f... --tcp 127.0.0.1:50051
    channel = Channel(SidecarTransport.connect("127.0.0.1", 50051))
"""

import socket
import struct

from .endpoint import Transport


class SidecarTransport(Transport):
    """One length-prefixed TCP connection to a direct_sidecar."""

    def __init__(self, sock):
        self._sock = sock
        self._buf = bytearray()
        self._closed = False

    @classmethod
    def connect(cls, host, port):
        return cls(socket.create_connection((host, port)))

    @classmethod
    def from_socket(cls, sock):
        return cls(sock)

    def send(self, data):
        if self._closed:
            raise EOFError("transport closed")
        payload = bytes(data)
        self._sock.sendall(struct.pack(">I", len(payload)) + payload)

    def _fill(self, need):
        while len(self._buf) < need:
            chunk = self._sock.recv(65536)
            if not chunk:
                raise EOFError("transport closed")
            self._buf.extend(chunk)

    def recv(self):
        self._fill(4)
        (length,) = struct.unpack(">I", bytes(self._buf[:4]))
        del self._buf[:4]
        self._fill(length)
        payload = bytes(self._buf[:length])
        del self._buf[:length]
        return payload

    def close(self):
        self._closed = True
        try:
            self._sock.close()
        except OSError:
            pass
GRPC_RUNTIME_EOF
)

(define python-kafka-native-body
#<<GRPC_RUNTIME_EOF
"""In-process Kafka client via libkafka_native (native only).

The collapsed form of the Kafka proxy: the Kafka protocol
implementation runs in this process through the kafka-native
shared library (C ABI), instead of in a kafka_proxy sidecar
reached over gRPC. Method surface mirrors the generated
KafkaClient; requests and responses are the same generated
kafka_pb messages. No proxy process, no gRPC hop.

    client = NativeKafkaClient("127.0.0.1:9092")
    client.CreateTopics(CreateTopicsRequest(topics=[...]))

The library is located via the `lib` argument, the
GRPC_DC_KAFKA_NATIVE_LIB environment variable, or a
libkafka_native shared library sitting next to this package.
SASL/TLS via the sasl_*/tls_* constructor arguments.
"""

import ctypes
import os

from . import kafka_pb


class NativeKafkaError(Exception):
    """A kafka-native FFI call failed."""


_UNARY = {
    "Metadata": kafka_pb.MetadataResponse,
    "OpenProducer": kafka_pb.OpenProducerResponse,
    "CloseProducer": kafka_pb.CloseProducerResponse,
    "EndTransaction": kafka_pb.EndTransactionResponse,
    "Produce": kafka_pb.ProduceResponse,
    "ListOffsets": kafka_pb.ListOffsetsResponse,
    "CommitOffset": kafka_pb.CommitOffsetResponse,
    "FetchOffset": kafka_pb.FetchOffsetResponse,
    "CreateTopics": kafka_pb.CreateTopicsResponse,
    "DeleteTopics": kafka_pb.DeleteTopicsResponse,
    "DescribeConfigs": kafka_pb.DescribeConfigsResponse,
    "AlterConfigs": kafka_pb.AlterConfigsResponse,
    "CreatePartitions": kafka_pb.CreatePartitionsResponse,
    "DeleteRecords": kafka_pb.DeleteRecordsResponse,
    "ListGroups": kafka_pb.ListGroupsResponse,
    "DescribeGroups": kafka_pb.DescribeGroupsResponse,
    "DeleteGroups": kafka_pb.DeleteGroupsResponse,
    "DeleteGroupOffsets": kafka_pb.DeleteGroupOffsetsResponse,
    "DescribeAcls": kafka_pb.DescribeAclsResponse,
    "CreateAcls": kafka_pb.CreateAclsResponse,
    "DeleteAcls": kafka_pb.DeleteAclsResponse,
    "ListTransactions": kafka_pb.ListTransactionsResponse,
    "DescribeTransactions": kafka_pb.DescribeTransactionsResponse,
}

_STREAMS = {
    "Consume": kafka_pb.ConsumeResponse,
    "Subscribe": kafka_pb.GroupSubscribeResponse,
}


def _lib_candidates(explicit=None):
    names = ("libkafka_native.so", "libkafka_native.dylib", "kafka_native.dll")
    out = []
    if explicit:
        # An explicit path is authoritative: no fallthrough.
        return [explicit]
    env = os.environ.get("GRPC_DC_KAFKA_NATIVE_LIB")
    if env:
        out.append(env)
    here = os.path.dirname(os.path.abspath(__file__))
    for name in names:
        out.append(os.path.join(here, name))
        out.append(name)
    return out


def _load_lib(explicit=None):
    errors = []
    for cand in _lib_candidates(explicit):
        try:
            lib = ctypes.CDLL(cand)
        except OSError as e:
            errors.append(f"{cand}: {e}")
            continue
        lib.kafka_native_new.restype = ctypes.c_void_p
        lib.kafka_native_new.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        lib.kafka_native_new_v2.restype = ctypes.c_void_p
        lib.kafka_native_new_v2.argtypes = [ctypes.POINTER(_Config)]
        lib.kafka_native_free.restype = None
        lib.kafka_native_free.argtypes = [ctypes.c_void_p]
        lib.kafka_native_call.restype = ctypes.c_int
        lib.kafka_native_call.argtypes = [
            ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t,
            ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t),
        ]
        lib.kafka_native_stream_new.restype = ctypes.c_void_p
        lib.kafka_native_stream_new.argtypes = [
            ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p, ctypes.c_size_t,
        ]
        lib.kafka_native_stream_next.restype = ctypes.c_int
        lib.kafka_native_stream_next.argtypes = [
            ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_size_t),
        ]
        lib.kafka_native_stream_free.restype = None
        lib.kafka_native_stream_free.argtypes = [ctypes.c_void_p]
        lib.kafka_native_bytes_free.restype = None
        lib.kafka_native_bytes_free.argtypes = [ctypes.c_void_p, ctypes.c_size_t]
        lib.kafka_native_last_error.restype = ctypes.c_char_p
        lib.kafka_native_last_error.argtypes = []
        return lib
    raise NativeKafkaError(
        "libkafka_native not found; set GRPC_DC_KAFKA_NATIVE_LIB ("
        + "; ".join(errors) + ")")


def _take_bytes(lib, out_ptr, out_len):
    if not out_ptr:
        return b""
    data = ctypes.string_at(out_ptr, out_len)
    lib.kafka_native_bytes_free(out_ptr, out_len)
    return data


class _NativeStream:
    def __init__(self, lib, stream, resp_cls):
        self._lib = lib
        self._stream = stream
        self._resp_cls = resp_cls
        self._done = False

    def __iter__(self):
        return self

    def __next__(self):
        if self._done or not self._stream:
            raise StopIteration
        out = ctypes.c_void_p()
        out_len = ctypes.c_size_t()
        rc = self._lib.kafka_native_stream_next(
            self._stream, ctypes.byref(out), ctypes.byref(out_len))
        if rc == 0:
            self._done = True
            raise StopIteration
        if rc < 0:
            self._done = True
            raise NativeKafkaError(_last_error(self._lib))
        resp = self._resp_cls()
        resp.unmarshal_dc(_take_bytes(self._lib, out.value, out_len.value))
        return resp

    def close(self):
        if self._stream:
            self._lib.kafka_native_stream_free(self._stream)
            self._stream = None
        self._done = True

    def __del__(self):
        try:
            self.close()
        except Exception:
            pass


def _last_error(lib):
    msg = lib.kafka_native_last_error()
    return msg.decode("utf-8", "replace") if msg else "kafka-native error"


class _Config(ctypes.Structure):
    _fields_ = [
        ("broker", ctypes.c_char_p),
        ("client_id", ctypes.c_char_p),
        ("sasl_mechanism", ctypes.c_char_p),
        ("username", ctypes.c_char_p),
        ("password", ctypes.c_char_p),
        ("tls_ca_cert", ctypes.c_char_p),
        ("tls_server_name", ctypes.c_char_p),
        ("tls_insecure_skip_verify", ctypes.c_int),
    ]


def _enc(value):
    return value.encode() if value is not None else None


class NativeKafkaClient:
    """Direct in-process Kafka client (see module docstring)."""

    def __init__(self, broker, client_id="grpc-dc-kafka-native", lib=None,
                 sasl_mechanism=None, username=None, password=None,
                 tls_ca_cert=None, tls_server_name=None,
                 tls_insecure_skip_verify=False):
        self._lib = _load_lib(lib)
        if (sasl_mechanism is None and tls_ca_cert is None
                and not tls_insecure_skip_verify):
            self._handle = self._lib.kafka_native_new(
                broker.encode(), client_id.encode())
        else:
            cfg = _Config(
                broker=broker.encode(),
                client_id=client_id.encode(),
                sasl_mechanism=_enc(sasl_mechanism),
                username=_enc(username),
                password=_enc(password),
                tls_ca_cert=_enc(tls_ca_cert),
                tls_server_name=_enc(tls_server_name),
                tls_insecure_skip_verify=1 if tls_insecure_skip_verify else 0,
            )
            self._handle = self._lib.kafka_native_new_v2(ctypes.byref(cfg))
        if not self._handle:
            raise NativeKafkaError(_last_error(self._lib))

    def close(self):
        if getattr(self, "_handle", None):
            self._lib.kafka_native_free(self._handle)
            self._handle = None

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    def __del__(self):
        try:
            self.close()
        except Exception:
            pass

    def _call(self, method, req):
        resp_cls = _UNARY[method]
        payload = bytes(req.marshal_dc())
        out = ctypes.c_void_p()
        out_len = ctypes.c_size_t()
        rc = self._lib.kafka_native_call(
            self._handle, method.encode(), payload, len(payload),
            ctypes.byref(out), ctypes.byref(out_len))
        if rc != 0:
            raise NativeKafkaError(_last_error(self._lib))
        resp = resp_cls()
        resp.unmarshal_dc(_take_bytes(self._lib, out.value, out_len.value))
        return resp

    def _stream(self, method, req):
        payload = bytes(req.marshal_dc())
        stream = self._lib.kafka_native_stream_new(
            self._handle, method.encode(), payload, len(payload))
        if not stream:
            raise NativeKafkaError(_last_error(self._lib))
        return _NativeStream(self._lib, stream, _STREAMS[method])

    def Metadata(self, req):
        return self._call("Metadata", req)

    def OpenProducer(self, req):
        return self._call("OpenProducer", req)

    def CloseProducer(self, req):
        return self._call("CloseProducer", req)

    def EndTransaction(self, req):
        return self._call("EndTransaction", req)

    def Produce(self, req):
        return self._call("Produce", req)

    def Consume(self, req):
        return self._stream("Consume", req)

    def Subscribe(self, req):
        return self._stream("Subscribe", req)

    def ListOffsets(self, req):
        return self._call("ListOffsets", req)

    def CommitOffset(self, req):
        return self._call("CommitOffset", req)

    def FetchOffset(self, req):
        return self._call("FetchOffset", req)

    def CreateTopics(self, req):
        return self._call("CreateTopics", req)

    def DeleteTopics(self, req):
        return self._call("DeleteTopics", req)

    def DescribeConfigs(self, req):
        return self._call("DescribeConfigs", req)

    def AlterConfigs(self, req):
        return self._call("AlterConfigs", req)

    def CreatePartitions(self, req):
        return self._call("CreatePartitions", req)

    def DeleteRecords(self, req):
        return self._call("DeleteRecords", req)

    def ListGroups(self, req):
        return self._call("ListGroups", req)

    def DescribeGroups(self, req):
        return self._call("DescribeGroups", req)

    def DeleteGroups(self, req):
        return self._call("DeleteGroups", req)

    def DeleteGroupOffsets(self, req):
        return self._call("DeleteGroupOffsets", req)

    def DescribeAcls(self, req):
        return self._call("DescribeAcls", req)

    def CreateAcls(self, req):
        return self._call("CreateAcls", req)

    def DeleteAcls(self, req):
        return self._call("DeleteAcls", req)

    def ListTransactions(self, req):
        return self._call("ListTransactions", req)

    def DescribeTransactions(self, req):
        return self._call("DescribeTransactions", req)
GRPC_RUNTIME_EOF
)

