   "#   docker build -f docker/" key ".Dockerfile -t grpc-dc-" key " .\n"
   "#   docker run --rm grpc-dc-" key "\n"
   "FROM " (second spec) "\n"
   "WORKDIR /src\n"
   (string-join (third spec) "\n") "\n"
   "CMD [\"sh\", \"-c\", \"" (fourth spec) "\"]\n"))

