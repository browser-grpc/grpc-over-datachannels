#<<GRPC_RUNTIME_EOF
// Codec + status types for gRPC over WebRTC DataChannels.
//
// Wire protocol in ../SPEC.md. Frame, status, channel and server
// semantics mirror the Lua and Ruby runtimes; the tables in
// wire_gen.php are generated by grpc-dc codegen.

namespace Grpcdc;

require_once __DIR__ . "/wire_gen.php";

/** A gRPC status (code + message) carried as an exception. */
class StatusError extends \Exception
{
    public int $statusCode;
    public string $statusMessage;
    /** @var array<string,string> Trailing metadata carried by a status frame. */
    public array $trailers = [];

    public function __construct(int $code, string $message = "")
    {
        parent::__construct($message);
        $this->statusCode = $code;
        $this->statusMessage = $message;
    }

    public function __toString(): string
    {
        return Status::name($this->statusCode) . ": " . $this->statusMessage;
    }
}

/** The call completed OK (client-side stream end marker). */
class CallClosed extends \Exception
{
}

/** Canonical status names and conversions. */
final class Status
{
    public static function name(int $code): string
    {
        return Wire::STATUS_NAMES[$code] ?? ("CODE_" . $code);
    }

    // --- Homegrown tracing@@TRACING_BETA@@ (W3C traceparent propagation) --------
    // Dormant until Status::setTracer registers an observer with
    // traceStart/traceEnd-style callbacks. Provide an object with
    // onStart($kind, $method, $traceId, $spanId, $parentSpanId)
    // and onEnd($kind, $method, $traceId, $spanId, $status).
    // Dependency-free: sampling/export are the app's problem.

    private static mixed $tracer = null;

    public static function setTracer(mixed $tracer): void
    {
        self::$tracer = $tracer;
    }

    public static function tracer(): mixed
    {
        return self::$tracer;
    }

    /** @var string[] */
    private static array $traceFilter = [];

    // Restrict traced methods: ';'-separated paths, a trailing
    // '*' means prefix match ('/echo.Echo/*'). Empty = trace all.
    public static function setTraceFilter(string $patterns): void
    {
        self::$traceFilter = array_values(array_filter(explode(";", $patterns), fn($p) => $p !== ""));
    }

    private static function traceAllowed(string $method): bool
    {
        foreach (self::$traceFilter as $p) {
            if (str_ends_with($p, "*")) {
                if (str_starts_with($method, substr($p, 0, -1))) {
                    return true;
                }
            } elseif ($method === $p) {
                return true;
            }
        }
        return self::$traceFilter === [];
    }

    public static function formatTraceparent(string $traceId, string $spanId, bool $sampled = true): string
    {
        return "00-$traceId-$spanId-" . ($sampled ? "01" : "00");
    }

    /** @return array{string,string,bool}|null [traceId, spanId, sampled] */
    public static function parseTraceparent(?string $value): ?array
    {
        if ($value === null) {
            return null;
        }
        $parts = explode("-", $value);
        if (count($parts) !== 4 || strlen($parts[1]) !== 32 || strlen($parts[2]) !== 16) {
            return null;
        }
        if (!ctype_xdigit($parts[1]) || !ctype_xdigit($parts[2])
            || strlen($parts[3]) !== 2 || !ctype_xdigit($parts[3])) {
            return null;
        }
        return [$parts[1], $parts[2], (hexdec($parts[3]) & 1) === 1];
    }

    /** @return array{trace_id:string,span_id:string,parent_span_id:string,sampled:bool,start_time:float}|null */
    public static function traceStart(string $kind, string $method, ?array $parent): ?array
    {
        if (self::$tracer === null || !self::traceAllowed($method)) {
            return null;
        }
        $ctx = [
            "trace_id" => $parent !== null ? $parent[0] : bin2hex(random_bytes(16)),
            "span_id" => bin2hex(random_bytes(8)),
            "parent_span_id" => $parent !== null ? $parent[1] : "",
            "sampled" => $parent !== null ? $parent[2] : true,
            "start_time" => microtime(true),
        ];
        if ($ctx["sampled"]) {
            try {
                self::$tracer->onStart($kind, $method, $ctx["trace_id"], $ctx["span_id"], $ctx["parent_span_id"]);
            } catch (\Throwable) {
            }
        }
        return $ctx;
    }

    /** Start a root span context (client workflows). Pair with traceEnd. */
    public static function newTraceContext(string $kind, string $method): ?array
    {
        return self::traceStart($kind, $method, null);
    }

    /** View a span context as a traceparent parent for an outbound call. */
    public static function parentOf(?array $ctx): ?array
    {
        return $ctx === null ? null : [$ctx["trace_id"], $ctx["span_id"], $ctx["sampled"]];
    }

    public static function traceEnd(string $kind, string $method, ?array $ctx, string $status): void
    {
        if ($ctx === null || self::$tracer === null || ($ctx["sampled"] ?? true) === false) {
            return;
        }
        try {
            $durationMs = (microtime(true) - $ctx["start_time"]) * 1000.0;
            self::$tracer->onEnd($kind, $method, $ctx["trace_id"], $ctx["span_id"], $status, $durationMs);
        } catch (\Throwable) {
        }
    }

    /** Convert any throwable to StatusError (OK for null). */
    public static function toStatus(?\Throwable $err): StatusError
    {
        if ($err === null) {
            return new StatusError(Wire::CODE_OK, "");
        }
        if ($err instanceof StatusError) {
            return $err;
        }
        return new StatusError(Wire::CODE_INTERNAL, $err->getMessage());
    }
}

/** A parsed HEADERS payload: path=null marks response headers. */
class Headers
{
    public ?string $path;
    /** @var array<string,string> */
    public array $metadata;

    public function __construct(?string $path = null, array $metadata = [])
    {
        $this->path = $path;
        $this->metadata = $metadata;
    }
}

/** Frame codec (one DataChannel message = one frame). */
final class Codec
{
    public const HEADER_LEN = 9;
    public const MAX_DATA_PAYLOAD = 16 * 1024 * 1024;

    // HEADERS metadata key/value a client sends to request the
    // struct codec for a call (see SPEC.md struct codec).
    public const STRUCT_CODEC_HEADER = "dc-codec";
    public const STRUCT_CODEC_V1 = "struct-v1";

    /** Marshal $msg with the codec selected for a call
     *  (struct layout when negotiated). */
    public static function marshalForCodec(bool $structCodec, object $msg): string
    {
        if (!$structCodec) {
            return $msg->marshalDc();
        }
        if (!method_exists($msg, "marshalStruct")) {
            throw new StatusError(Wire::CODE_INTERNAL, "message has no struct codec");
        }
        return $msg->marshalStruct();
    }

    /** Decode $data into $msg with the codec selected for a call. */
    public static function unmarshalForCodec(bool $structCodec, string $data, object $msg): object
    {
        if ($structCodec) {
            if (!method_exists($msg, "unmarshalStruct")) {
                throw new StatusError(Wire::CODE_INTERNAL, "message has no struct codec");
            }
            $msg->unmarshalStruct($data);
        } else {
            $msg->unmarshalDc($data);
        }
        return $msg;
    }

    /** Build one DataChannel message: header + payload. */
    public static function encodeFrame(int $frameType, int $streamId, string $payload): string
    {
        if (!in_array($frameType, Wire::FRAME_NAMES, true)) {
            throw new StatusError(Wire::CODE_INVALID_ARGUMENT, "unknown frame type $frameType");
        }
        if ($frameType === Wire::FRAME_DATA && strlen($payload) > self::MAX_DATA_PAYLOAD) {
            throw new StatusError(Wire::CODE_RESOURCE_EXHAUSTED, "DATA payload exceeds 16 MiB");
        }
        return pack("CNN", $frameType, $streamId, strlen($payload)) . $payload;
    }

    /** Parse one DataChannel message -> [frameType, streamId, payload]. */
    public static function decodeFrame(string $data): array
    {
        if (strlen($data) < self::HEADER_LEN) {
            throw new StatusError(
                Wire::CODE_INVALID_ARGUMENT,
                "frame shorter than 9-byte header: " . strlen($data) . " bytes"
            );
        }
        $parts = unpack("Ctype/Nstream/Nlength", substr($data, 0, self::HEADER_LEN));
        $length = $parts["length"];
        if ($length !== strlen($data) - self::HEADER_LEN) {
            throw new StatusError(
                Wire::CODE_INVALID_ARGUMENT,
                "payload length $length does not match message size " . strlen($data)
            );
        }
        return [$parts["type"], $parts["stream"], substr($data, self::HEADER_LEN)];
    }

    public static function headersFrame(int $streamId, ?string $path, ?array $metadata): string
    {
        $body = [];
        if ($path !== null) {
            $body["path"] = $path;
        }
        if ($metadata !== null && count($metadata) > 0) {
            $body["metadata"] = $metadata;
        }
        return self::encodeFrame(Wire::FRAME_HEADERS, $streamId, json_encode((object)$body));
    }

    public static function parseHeaders(string $payload): Headers
    {
        try {
            $body = json_decode($payload, true, 512, JSON_THROW_ON_ERROR);
        } catch (\JsonException $e) {
            throw new StatusError(Wire::CODE_INVALID_ARGUMENT, "bad HEADERS payload: " . $e->getMessage());
        }
        if (!is_array($body)) {
            throw new StatusError(Wire::CODE_INVALID_ARGUMENT, "HEADERS payload is not an object");
        }
        $metadata = $body["metadata"] ?? [];
        if (!is_array($metadata)) {
            throw new StatusError(Wire::CODE_INVALID_ARGUMENT, "HEADERS metadata is not an object");
        }
        return new Headers($body["path"] ?? null, $metadata);
    }

    // gRPC timeout grammar (grpc-timeout metadata): <digits><unit>,
    // units H/M/S/m/u/n (at most 8 digits). Encoding uses
    // milliseconds (seconds past the digit limit), rounded up.
    public static function encodeTimeout(float $seconds): string
    {
        $ms = (int)ceil($seconds * 1000.0);
        if ($ms <= 99999999) {
            return $ms . "m";
        }
        return ((int)ceil($seconds)) . "S";
    }

    /** Decoded grpc-timeout in seconds, or null when malformed. */
    public static function parseTimeout($text): ?float
    {
        if (!is_string($text) || strlen($text) < 2 || strlen($text) > 9) {
            return null;
        }
        $digits = substr($text, 0, -1);
        if (!ctype_digit($digits)) {
            return null;
        }
        $n = (float)$digits;
        switch (substr($text, -1)) {
            case "H":
                return $n * 3600.0;
            case "M":
                return $n * 60.0;
            case "S":
                return $n;
            case "m":
                return $n / 1000.0;
            case "u":
                return $n / 1000000.0;
            case "n":
                return $n / 1000000000.0;
        }
        return null;
    }

    public static function statusFrame(int $frameType, int $streamId, StatusError $status): string
    {
        $body = ["code" => $status->statusCode, "message" => $status->statusMessage];
        if (!empty($status->trailers)) {
            $body["metadata"] = $status->trailers;
        }
        return self::encodeFrame($frameType, $streamId, json_encode($body));
    }

    public static function parseStatus(string $payload): StatusError
    {
        try {
            $body = json_decode($payload, true, 512, JSON_THROW_ON_ERROR);
            if (!is_array($body) || !isset($body["code"])) {
                return new StatusError(Wire::CODE_UNKNOWN, "malformed trailers");
            }
            $status = new StatusError((int)$body["code"], (string)($body["message"] ?? ""));
            if (isset($body["metadata"]) && is_array($body["metadata"])) {
                foreach ($body["metadata"] as $k => $v) {
                    $status->trailers[(string)$k] = (string)$v;
                }
            }
            return $status;
        } catch (\JsonException $e) {
            return new StatusError(Wire::CODE_UNKNOWN, "malformed trailers");
        }
    }
}
GRPC_RUNTIME_EOF
)

(define php-endpoint-body
#<<GRPC_RUNTIME_EOF
// Endpoint: multiplexes grpc-dc streams over one Transport.
//
// Single-threaded cooperative model (PHP CLI has no threads):
// pump() processes at most one inbound transport message, running
// server handlers inline; client calls loop on pump() — consulting
// the transport's peerPump hook when idle so an in-process loopback
// peer makes progress. Blocking transports (stdio) simply block
// inside recvMessage during pump().

namespace Grpcdc;

require_once __DIR__ . "/codec.php";
require_once __DIR__ . "/wire_gen.php";

/**
 * Carries whole DataChannel messages (boundaries preserved).
 * recvMessage returns one message, or null when nothing is
 * available right now (or the transport is closed).
 */
abstract class Transport
{
    /** @var null|\Closure():bool drives the in-process peer, when any */
    public $peerPump = null;

    /** True once the transport is known closed/EOF (recv can never succeed). */
    public bool $gone = false;

    abstract public function send(string $data): void;

    abstract public function recvMessage(): ?string;

    public function close(): void
    {
    }
}

/** One stream event (headers/data/half_close/trailers/rst). */
class StreamEvent
{
    public string $kind;
    public ?Headers $headers;
    public ?string $payload;
    public ?StatusError $status;

    public function __construct(string $kind, ?Headers $headers = null, ?string $payload = null, ?StatusError $status = null)
    {
        $this->kind = $kind;
        $this->headers = $headers;
        $this->payload = $payload;
        $this->status = $status;
    }
}

/** Receiving queue of one stream; closed after a terminal event. */
class StreamInput
{
    /** @var StreamEvent[] */
    private array $items = [];
    public bool $closedFlag = false;

    public function put(StreamEvent $event): void
    {
        if ($this->closedFlag) {
            return;
        }
        $this->items[] = $event;
    }

    public function close(): void
    {
        $this->closedFlag = true;
    }

    /** Next event, or null when empty. Never blocks. */
    public function get(): ?StreamEvent
    {
        if (count($this->items) > 0) {
            return array_shift($this->items);
        }
        return null;
    }

    public function hasData(): bool
    {
        return count($this->items) > 0;
    }
}

/** Sends response payloads of one inbound call. */
class ResponseSink
{
    private Endpoint $endpoint;
    private int $streamId;

    public function __construct(Endpoint $endpoint, int $streamId)
    {
        $this->endpoint = $endpoint;
        $this->streamId = $streamId;
    }

    /** @var array<string,string> Wired to the CallContext maps by the endpoint. */
    public array $respHeaders = [];
    /** @var array<string,string> */
    public array $respTrailers = [];
    public bool $headersSent = false;

    public function send(string $payload): void
    {
        // A stream the endpoint has forgotten was RST by the peer
        // (or the channel went away): fail the send so a producing
        // handler stops instead of streaming into the void.
        if ($this->endpoint->streamInput($this->streamId) === null) {
            throw new StatusError(Wire::CODE_CANCELLED, "call cancelled");
        }
        $this->flushHeaders();
        $this->endpoint->sendFrame(Codec::encodeFrame(Wire::FRAME_DATA, $this->streamId, $payload));
    }

    public function flushHeaders(): void
    {
        if (!$this->headersSent) {
            $this->headersSent = true;
            $this->sendHeaders($this->respHeaders);
        }
    }

    public function sendHeaders(?array $metadata = null): void
    {
        if ($this->endpoint->streamInput($this->streamId) === null) {
            throw new StatusError(Wire::CODE_CANCELLED, "call cancelled");
        }
        $this->headersSent = true;
        $this->endpoint->sendFrame(Codec::headersFrame($this->streamId, null, $metadata ?? $this->respHeaders));
    }

    public function sendTrailers(StatusError $status): void
    {
        if (!empty($this->respTrailers)) {
            $merged = array_merge($this->respTrailers, $status->trailers);
            $status = new StatusError($status->statusCode, $status->statusMessage);
            $status->trailers = $merged;
        }
        $this->endpoint->sendFrame(Codec::statusFrame(Wire::FRAME_TRAILERS, $this->streamId, $status));
    }
}

/** Per-call context: metadata sent in HEADERS, plus deadline. */
class CallContext
{
    /** @var array<string,string> */
    public array $metadata;
    /** @var array<string,string> Response initial metadata recorded via setHeaders. */
    public array $responseHeaders = [];
    /** @var array<string,string> Response trailing metadata recorded via setTrailers. */
    public array $responseTrailers = [];
    /** This call's server span context (null when dormant). */
    public ?array $traceContext = null;
    /** Whether this call negotiated the struct codec
     *  (HEADERS dc-codec: struct-v1). */
    public bool $structCodec = false;
    public ?float $deadline;

    /** Marshal a response message with this call's negotiated
     *  codec (generated server code calls this). */
    public function encodeMessage(object $msg): string
    {
        return Codec::marshalForCodec($this->structCodec, $msg);
    }

    /** Record response initial metadata (sent lazily, before the first response message). */
    public function setHeaders(array $md): void
    {
        foreach ($md as $k => $v) {
            $this->responseHeaders[$k] = $v;
        }
    }

    /** Record response trailing metadata (rides the terminal status frame). */
    public function setTrailers(array $md): void
    {
        foreach ($md as $k => $v) {
            $this->responseTrailers[$k] = $v;
        }
    }

    public function __construct(array $metadata = [])
    {
        $this->metadata = $metadata;
        $remaining = Codec::parseTimeout($metadata["grpc-timeout"] ?? null);
        $this->deadline = $remaining === null ? null : Endpoint::nowSeconds() + $remaining;
    }

    /** Seconds left before the deadline, or null when unbounded. */
    public function timeRemaining(): ?float
    {
        if ($this->deadline === null) {
            return null;
        }
        return max(0.0, $this->deadline - Endpoint::nowSeconds());
    }

    public function deadlineExceeded(): bool
    {
        return $this->timeRemaining() === 0.0;
    }
}

/** Multiplexes grpc-dc streams over one Transport. */
class Endpoint
{
    public Transport $transport;
    /** @var null|\Closure(CallContext, Headers, StreamInput, ResponseSink): ?StatusError */
    public $dispatcher = null;
    private int $nextId;
    /** @var array<int, StreamInput> */
    private array $streams = [];
    public bool $closed = false;
    /** @var array<int, array{fiber: \Fiber, input: StreamInput}> server-dispatch fibers by stream id */
    private array $dispatchFibers = [];
    /** @var array<int, bool> dispatch fibers suspended waiting for input, by fiber object id */
    private array $waitingFibers = [];
    private bool $scheduling = false;

    /** The side that created the channel allocates odd ids, the answerer even. */
    public function __construct(Transport $transport, bool $creator)
    {
        $this->transport = $transport;
        $this->nextId = $creator ? 1 : 2;
    }

    public static function nowSeconds(): float
    {
        return microtime(true);
    }

    public function setDispatcher(\Closure $dispatcher): void
    {
        $this->dispatcher = $dispatcher;
    }

    public function sendFrame(string $frame): void
    {
        $this->transport->send($frame);
    }

    /** @return array{0:int, 1:StreamInput} */
    public function openStream(): array
    {
        $id = $this->nextId;
        $this->nextId += 2;
        $input = new StreamInput();
        $this->streams[$id] = $input;
        return [$id, $input];
    }

    public function closeStream(int $id): void
    {
        unset($this->streams[$id]);
    }

    public function streamInput(int $id): ?StreamInput
    {
        return $this->streams[$id] ?? null;
    }

    /**
     * Abort one stream: RST towards the peer; a pending recv wakes
     * with the cancellation status (the local input is closed with
     * a synthetic RST event).
     */
    public function cancelStream(int $id): void
    {
        $status = new StatusError(Wire::CODE_CANCELLED, "call cancelled");
        $input = $this->streams[$id] ?? null;
        unset($this->streams[$id]);
        if ($input !== null) {
            $input->put(new StreamEvent("rst", null, null, $status));
            $input->close();
        }
        try {
            $this->sendFrame(Codec::statusFrame(Wire::FRAME_RST, $id, $status));
        } catch (\Throwable $ignored) {
        }
    }

    public function close(): void
    {
        if ($this->closed) {
            return;
        }
        $this->closed = true;
        try {
            $this->transport->close();
        } catch (\Throwable $ignored) {
        }
        $this->failAll();
    }

    public function failAll(): void
    {
        $streams = $this->streams;
        $this->streams = [];
        foreach ($streams as $input) {
            $input->put(new StreamEvent("rst", null, null, new StatusError(Wire::CODE_UNAVAILABLE, "data channel closed")));
            $input->close();
        }
        // Wake dispatch fibers so they observe the failure.
        $this->resumeDispatchFibers();
    }

    /**
     * Process at most one inbound message; true when one was
     * processed. Server dispatch runs inline (handlers may pump
     * reentrantly to receive their own request stream).
     */
    public function pump(): bool
    {
        if ($this->closed) {
            return false;
        }
        try {
            $data = $this->transport->recvMessage();
        } catch (CallClosed $e) {
            $this->transport->gone = true;
            $this->failAll();
            return false;
        }
        if ($data === null) {
            // Idle: still give dispatch fibers a turn (a fiber
            // may be runnable without new inbound data).
            $this->resumeDispatchFibers();
            return false;
        }
        $this->onBytes($data);
        $this->resumeDispatchFibers();
        return true;
    }

    /**
     * Give each suspended server-dispatch fiber one turn: each
     * inbound call runs in its own Fiber so concurrent streams
     * interleave regardless of HEADERS order. Fibers waiting
     * for input (suspended from pumpWhile) resume only when
     * their input has data or is closed; other fibers (handlers
     * suspending cooperatively) get one turn per pass, which
     * keeps producer pacing under the caller's control.
     * Guarded against reentry from fibers that pump.
     */
    private function resumeDispatchFibers(): void
    {
        if ($this->scheduling) {
            return;
        }
        $this->scheduling = true;
        try {
            foreach (array_keys($this->dispatchFibers) as $streamId) {
                $entry = $this->dispatchFibers[$streamId] ?? null;
                if ($entry === null) {
                    continue;
                }
                $fiber = $entry["fiber"];
                if ($fiber->isTerminated()) {
                    unset($this->dispatchFibers[$streamId]);
                    continue;
                }
                if (!$fiber->isSuspended()) {
                    continue;
                }
                if (isset($this->waitingFibers[spl_object_id($fiber)])) {
                    $input = $entry["input"];
                    if (!$input->hasData() && !$input->closedFlag) {
                        continue;
                    }
                }
                $fiber->resume();
                if ($fiber->isTerminated()) {
                    unset($this->dispatchFibers[$streamId]);
                }
            }
        } finally {
            $this->scheduling = false;
        }
    }

    /**
     * Pump until $fn() reports progress. Throws UNAVAILABLE when
     * the transport is known gone; otherwise waits briefly and
     * re-checks (a held-back transport must not mask a deadline
     * that $fn observes, mirroring the Lua pump caveat).
     */
    public function pumpWhile(\Closure $fn): void
    {
        while (!$fn()) {
            $fiber = \Fiber::getCurrent();
            if ($fiber !== null) {
                // Inside a server-dispatch fiber: yield to the
                // endpoint scheduler instead of pumping
                // reentrantly; it resumes us once our input has
                // data (or is closed).
                foreach ($this->dispatchFibers as $entry) {
                    if ($entry["fiber"] === $fiber) {
                        $oid = spl_object_id($fiber);
                        $this->waitingFibers[$oid] = true;
                        try {
                            \Fiber::suspend();
                        } finally {
                            unset($this->waitingFibers[$oid]);
                        }
                        continue 2;
                    }
                }
            }
            if ($this->pump()) {
                continue;
            }
            $peerPump = $this->transport->peerPump;
            if ($peerPump !== null && $peerPump()) {
                continue;
            }
            if ($this->transport->gone || $this->closed) {
                throw new StatusError(Wire::CODE_UNAVAILABLE, "data channel closed");
            }
            usleep(200);
        }
    }

    public function onBytes(string $data): void
    {
        if ($this->closed) {
            return;
        }
        try {
            [$frameType, $streamId, $payload] = Codec::decodeFrame($data);
        } catch (StatusError $e) {
            return; // malformed frame: drop, keep the channel up
        }
        switch ($frameType) {
            case Wire::FRAME_HEADERS:
                $this->onHeaders($streamId, $payload);
                break;
            case Wire::FRAME_DATA:
                $input = $this->streamInput($streamId);
                if ($input !== null) {
                    $input->put(new StreamEvent("data", null, $payload));
                }
                break;
            case Wire::FRAME_TRAILERS:
                $this->onTerminal($streamId, $payload, "trailers");
                break;
            case Wire::FRAME_HALF_CLOSE:
                $input = $this->streamInput($streamId);
                if ($input !== null) {
                    $input->put(new StreamEvent("half_close"));
                }
                break;
            case Wire::FRAME_RST:
                $this->onTerminal($streamId, $payload, "rst");
                break;
            default:
                // Unknown frame type: ignore for forward compatibility.
                break;
        }
    }

    private function onTerminal(int $streamId, string $payload, string $kind): void
    {
        $input = $this->streamInput($streamId);
        if ($input !== null) {
            $input->put(new StreamEvent($kind, null, null, Codec::parseStatus($payload)));
            $input->close();
            $this->closeStream($streamId);
        }
    }

    private function onHeaders(int $streamId, string $payload): void
    {
        try {
            $headers = Codec::parseHeaders($payload);
        } catch (StatusError $e) {
            try {
                $this->sendFrame(Codec::statusFrame(Wire::FRAME_RST, $streamId, Status::toStatus($e)));
            } catch (\Throwable $ignored) {
            }
            return;
        }
        if ($headers->path === null) {
            // Server response headers for one of our outbound streams.
            $input = $this->streamInput($streamId);
            if ($input !== null) {
                $input->put(new StreamEvent("headers", $headers));
            }
            return;
        }
        if ($this->streamInput($streamId) !== null) {
            try {
                $this->sendFrame(Codec::statusFrame(
                    Wire::FRAME_RST,
                    $streamId,
                    new StatusError(Wire::CODE_INTERNAL, "HEADERS for stream already in use")
                ));
            } catch (\Throwable $ignored) {
            }
            return;
        }
        if ($this->dispatcher === null) {
            try {
                $this->sendFrame(Codec::statusFrame(
                    Wire::FRAME_TRAILERS,
                    $streamId,
                    new StatusError(Wire::CODE_UNIMPLEMENTED, "unknown method " . $headers->path)
                ));
            } catch (\Throwable $ignored) {
            }
            return;
        }
        $input = new StreamInput();
        $this->streams[$streamId] = $input;
        $sink = new ResponseSink($this, $streamId);
        // No eager HEADERS: initial metadata flushes lazily via
        // the sink (first DATA, or below on a DATA-less success)
        // so handlers can setHeaders first. Errors end
        // trailers-only, as gRPC allows.
        $ctx = new CallContext($headers->metadata);
        $sink->respHeaders = &$ctx->responseHeaders;
        $sink->respTrailers = &$ctx->responseTrailers;
        // Dispatch in a dedicated Fiber: a handler that waits
        // for its request stream suspends (see pumpWhile) and
        // the scheduler resumes it when data lands, so
        // concurrent streams interleave.
        $fiber = new \Fiber(function () use ($ctx, $headers, $input, $sink, $streamId) {
            $ok = false;
            try {
                $result = ($this->dispatcher)($ctx, $headers, $input, $sink);
                $status = $result ?? new StatusError(Wire::CODE_OK, "");
                $ok = $result === null;
            } catch (\Throwable $e) {
                $status = Status::toStatus($e);
            }
            if ($ok) {
                try {
                    $sink->flushHeaders();
                } catch (\Throwable $ignored) {
                }
            }
            try {
                $sink->sendTrailers($status);
            } catch (\Throwable $ignored) {
            }
            $this->closeStream($streamId);
        });
        $this->dispatchFibers[$streamId] = ["fiber" => $fiber, "input" => $input];
        $fiber->start();
        if ($fiber->isTerminated()) {
            unset($this->dispatchFibers[$streamId]);
        }
    }
}
GRPC_RUNTIME_EOF
)

