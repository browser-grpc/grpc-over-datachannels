(define php-structdc-body
#<<GRPC_RUNTIME_EOF
// Descriptor-driven struct codec (layout v1, DCS1): the packed
// struct format from SPEC.md, implemented over the dynamic
// model (dynamic.php) so browser-tier runtimes transcode
// protobuf <-> struct without a native bridge. Byte-identical
// to the shared Rust implementation (conformance/struct).

namespace Grpcdc;

require_once __DIR__ . "/codec.php";
require_once __DIR__ . "/dynamic.php";
require_once __DIR__ . "/wire_gen.php";

final class Structdc
{
    /** @var array<string, FileModel> */
    private static array $cache = [];

    private static function fail(string $msg): StatusError
    {
        return new StatusError(Wire::CODE_INVALID_ARGUMENT, $msg);
    }

    private static function fingerprint(string $fullName): int
    {
        $h = 2166136261;
        $n = strlen($fullName);
        for ($i = 0; $i < $n; $i++) {
            $h = (($h ^ ord($fullName[$i])) * 16777619) & 0xFFFFFFFF;
        }
        return $h;
    }

    private static function isFixed32(FieldModel $f): bool
    {
        return $f->type === Dyn::TYPE_FLOAT || $f->type === Dyn::TYPE_FIXED32
            || $f->type === Dyn::TYPE_SFIXED32;
    }

    private static function slotSize(FieldModel $f): int
    {
        return self::isFixed32($f) ? 4 : 8;
    }

    private static function s64(int $v): int
    {
        return $v; // PHP ints are signed 64-bit patterns already
    }

    private static function s32(int $v): int
    {
        $v &= 0xFFFFFFFF;
        return $v >= 0x80000000 ? $v - 0x100000000 : $v;
    }

    private static function asI64($v): int
    {
        if (is_bool($v)) {
            return $v ? 1 : 0;
        }
        if (is_float($v)) {
            return (int)$v;
        }
        return (int)$v;
    }

    private static function bytesOf(FieldModel $f, $v): string
    {
        if (is_string($v)) {
            return $v;
        }
        throw self::fail("value does not match field " . $f->name . " type " . $f->type);
    }

    private static function nonzero(FieldModel $f, $v): bool
    {
        $t = $f->type;
        if ($t === Dyn::TYPE_STRING || $t === Dyn::TYPE_BYTES) {
            return strlen((string)$v) > 0;
        }
        if ($t === Dyn::TYPE_MESSAGE) {
            return $v instanceof GenericMessage;
        }
        if ($t === Dyn::TYPE_BOOL) {
            return $v === true || self::asI64($v) !== 0;
        }
        if ($t === Dyn::TYPE_FLOAT || $t === Dyn::TYPE_DOUBLE) {
            return (float)$v != 0.0;
        }
        return self::asI64($v) !== 0;
    }

    /** @return FieldModel[] fields sorted by number */
    private static function sortedFields(MessageModel $model): array
    {
        $fields = $model->fields;
        ksort($fields);
        return array_values($fields);
    }

    private static function mapModel(FieldModel $f, FileModel $fm): ?MessageModel
    {
        if ($f->type !== Dyn::TYPE_MESSAGE || !$f->repeated) {
            return null;
        }
        $m = $fm->messages[$f->typeName] ?? null;
        return ($m !== null && $m->mapEntry) ? $m : null;
    }

    private static function isMap(FieldModel $f, FileModel $fm): bool
    {
        return self::mapModel($f, $fm) !== null;
    }

    private static function defaultValue(FieldModel $f)
    {
        switch ($f->type) {
            case Dyn::TYPE_STRING:
            case Dyn::TYPE_BYTES:
                return "";
            case Dyn::TYPE_BOOL:
                return false;
            case Dyn::TYPE_FLOAT:
            case Dyn::TYPE_DOUBLE:
                return 0.0;
            case Dyn::TYPE_MESSAGE:
                return new GenericMessage();
            default:
                return 0;
        }
    }

    private static function keyCmp(FieldModel $kf, $a, $b): int
    {
        if ($kf->type === Dyn::TYPE_STRING) {
            return strcmp((string)$a, (string)$b) <=> 0;
        }
        if ($kf->type === Dyn::TYPE_BOOL || $kf->type === Dyn::TYPE_UINT32
            || $kf->type === Dyn::TYPE_UINT64 || $kf->type === Dyn::TYPE_FIXED32
            || $kf->type === Dyn::TYPE_FIXED64) {
            // Unsigned compare via sign-bit flip on the 64-bit pattern.
            $av = self::asI64($a) ^ PHP_INT_MIN;
            $bv = self::asI64($b) ^ PHP_INT_MIN;
            return $av <=> $bv;
        }
        return self::asI64($a) <=> self::asI64($b);
    }

    /** @return array<int, array{0:mixed,1:mixed}> sorted [key,value] pairs */
    private static function mapEntries(FieldModel $f, array $values, MessageModel $entryModel): array
    {
        $kf = $entryModel->fields[1];
        $vf = $entryModel->fields[2];
        $entries = [];
        foreach ($values as $entry) {
            $key = $entry->get(1);
            if ($key === null) {
                throw self::fail("map field " . $f->name . " entry missing key");
            }
            $entries[] = [$key, $entry->get(2, self::defaultValue($vf))];
        }
        usort($entries, function ($x, $y) use ($kf) {
            return self::keyCmp($kf, $x[0], $y[0]);
        });
        return $entries;
    }

    private static function valueSize(FieldModel $f, $v, FileModel $fm): int
    {
        $t = $f->type;
        if ($t === Dyn::TYPE_STRING || $t === Dyn::TYPE_BYTES) {
            return strlen(self::bytesOf($f, $v));
        }
        if ($t === Dyn::TYPE_MESSAGE) {
            return strlen(self::encodeStruct($fm->messages[$f->typeName], $v, $fm));
        }
        return self::isFixed32($f) ? 4 : 8;
    }

    private static function fieldPresent(FieldModel $f, GenericMessage $msg, FileModel $fm): bool
    {
        $values = $msg->getAll($f->number);
        if (self::isMap($f, $fm) || $f->repeated) {
            return count($values) > 0;
        }
        return count($values) > 0 && self::nonzero($f, $values[0]);
    }

    private static function structSize(MessageModel $model, GenericMessage $msg, FileModel $fm): int
    {
        $fields = self::sortedFields($model);
        $words = max(1, intdiv(count($fields) + 31, 32));
        $size = 12 + 4 * $words;
        foreach ($fields as $f) {
            $size += self::slotSize($f);
        }
        foreach ($fields as $f) {
            $values = $msg->getAll($f->number);
            if (self::isMap($f, $fm)) {
                $entryModel = self::mapModel($f, $fm);
                $kf = $entryModel->fields[1];
                $vf = $entryModel->fields[2];
                foreach (self::mapEntries($f, $values, $entryModel) as [$k, $v]) {
                    $size += 8 + self::valueSize($kf, $k, $fm) + self::valueSize($vf, $v, $fm);
                }
            } elseif ($f->repeated) {
                if (count($values) === 0) {
                    continue;
                }
                if ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                    || $f->type === Dyn::TYPE_MESSAGE) {
                    $size += 8 * count($values);
                }
                foreach ($values as $v) {
                    $size += self::valueSize($f, $v, $fm);
                }
            } elseif (($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                    || $f->type === Dyn::TYPE_MESSAGE)
                && self::fieldPresent($f, $msg, $fm)) {
                $size += self::valueSize($f, $values[0], $fm);
            }
        }
        foreach ($msg->unknown as $chunk) {
            $size += strlen($chunk);
        }
        return $size;
    }

    private static function putU32(string &$buf, int $off, int $v): void
    {
        $buf = substr_replace($buf, pack("V", $v & 0xFFFFFFFF), $off, 4);
    }

    private static function putU64(string &$buf, int $off, int $v): void
    {
        $buf = substr_replace($buf, pack("q", $v), $off, 8);
    }

    private static function getU32(string $data, int $off): int
    {
        if ($off + 4 > strlen($data)) {
            throw self::fail("struct codec: out of bounds");
        }
        return unpack("V", substr($data, $off, 4))[1];
    }

    private static function getU64(string $data, int $off): int
    {
        if ($off + 8 > strlen($data)) {
            throw self::fail("struct codec: out of bounds");
        }
        return unpack("q", substr($data, $off, 8))[1];
    }

    private static function writeScalar(string &$buf, int $off, FieldModel $f, $v): void
    {
        $t = $f->type;
        if ($t === Dyn::TYPE_FLOAT) {
            $buf = substr_replace($buf, pack("g", (float)$v), $off, 4);
        } elseif ($t === Dyn::TYPE_FIXED32) {
            self::putU32($buf, $off, self::asI64($v));
        } elseif ($t === Dyn::TYPE_SFIXED32) {
            self::putU32($buf, $off, self::s32(self::asI64($v)));
        } elseif ($t === Dyn::TYPE_DOUBLE) {
            $buf = substr_replace($buf, pack("e", (float)$v), $off, 8);
        } elseif ($t === Dyn::TYPE_FIXED64 || $t === Dyn::TYPE_SFIXED64) {
            self::putU64($buf, $off, self::asI64($v));
        } elseif ($t === Dyn::TYPE_BOOL) {
            $buf[$off] = chr(self::asI64($v) !== 0 ? 1 : 0);
        } else {
            self::putU64($buf, $off, self::asI64($v));
        }
    }

    private static function writeValue(string &$buf, int $off, FieldModel $f, $v, FileModel $fm): void
    {
        $t = $f->type;
        if ($t === Dyn::TYPE_STRING || $t === Dyn::TYPE_BYTES) {
            $b = self::bytesOf($f, $v);
            $buf = substr_replace($buf, $b, $off, strlen($b));
        } elseif ($t === Dyn::TYPE_MESSAGE) {
            $enc = self::encodeStruct($fm->messages[$f->typeName], $v, $fm);
            $buf = substr_replace($buf, $enc, $off, strlen($enc));
        } else {
            self::writeScalar($buf, $off, $f, $v);
        }
    }

    public static function encodeStruct(MessageModel $model, GenericMessage $msg, FileModel $fm): string
    {
        $fields = self::sortedFields($model);
        $words = max(1, intdiv(count($fields) + 31, 32));
        $header = 12 + 4 * $words;
        $offsets = [];
        $cursor = $header;
        foreach ($fields as $f) {
            $offsets[] = $cursor;
            $cursor += self::slotSize($f);
        }
        $fixedEnd = $cursor;
        $buf = str_repeat("\0", self::structSize($model, $msg, $fm));
        $buf = substr_replace($buf, "DCS1", 0, 4);
        self::putU32($buf, 4, strlen($buf));
        self::putU32($buf, 8, self::fingerprint($model->fullName));
        foreach ($fields as $i => $f) {
            if (self::fieldPresent($f, $msg, $fm)) {
                $at = 12 + 4 * intdiv($i, 32);
                self::putU32($buf, $at, self::getU32($buf, $at) | (1 << ($i % 32)));
            }
        }
        $vp = $fixedEnd;
        foreach ($fields as $i => $f) {
            $off = $offsets[$i];
            $values = $msg->getAll($f->number);
            if (self::isMap($f, $fm)) {
                if (count($values) === 0) {
                    continue;
                }
                $entryModel = self::mapModel($f, $fm);
                $kf = $entryModel->fields[1];
                $vf = $entryModel->fields[2];
                self::putU32($buf, $off, $vp);
                self::putU32($buf, $off + 4, count($values));
                foreach (self::mapEntries($f, $values, $entryModel) as [$k, $v]) {
                    $klen = self::valueSize($kf, $k, $fm);
                    $vlen = self::valueSize($vf, $v, $fm);
                    self::putU32($buf, $vp, $klen);
                    self::putU32($buf, $vp + 4, $vlen);
                    $vp += 8;
                    self::writeValue($buf, $vp, $kf, $k, $fm);
                    $vp += $klen;
                    self::writeValue($buf, $vp, $vf, $v, $fm);
                    $vp += $vlen;
                }
            } elseif ($f->repeated) {
                if (count($values) === 0) {
                    continue;
                }
                self::putU32($buf, $off, $vp);
                self::putU32($buf, $off + 4, count($values));
                if ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                    || $f->type === Dyn::TYPE_MESSAGE) {
                    $doff = $vp + 8 * count($values);
                    foreach ($values as $v) {
                        self::putU32($buf, $vp, $doff);
                        self::putU32($buf, $vp + 4, self::valueSize($f, $v, $fm));
                        $doff += self::valueSize($f, $v, $fm);
                        $vp += 8;
                    }
                    foreach ($values as $v) {
                        self::writeValue($buf, $vp, $f, $v, $fm);
                        $vp += self::valueSize($f, $v, $fm);
                    }
                } else {
                    foreach ($values as $v) {
                        self::writeScalar($buf, $vp, $f, $v);
                        $vp += self::slotSize($f);
                    }
                }
            } elseif ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                || $f->type === Dyn::TYPE_MESSAGE) {
                if (!self::fieldPresent($f, $msg, $fm)) {
                    continue;
                }
                self::putU32($buf, $off, $vp);
                self::putU32($buf, $off + 4, self::valueSize($f, $values[0], $fm));
                self::writeValue($buf, $vp, $f, $values[0], $fm);
                $vp += self::valueSize($f, $values[0], $fm);
            } elseif (self::fieldPresent($f, $msg, $fm)) {
                self::writeScalar($buf, $off, $f, $values[0]);
            }
        }
        foreach ($msg->unknown as $chunk) {
            $buf = substr_replace($buf, $chunk, $vp, strlen($chunk));
            $vp += strlen($chunk);
        }
        return $buf;
    }

    private static function readScalar(string $data, int $off, FieldModel $f)
    {
        $t = $f->type;
        if ($t === Dyn::TYPE_FLOAT) {
            return unpack("g", substr($data, $off, 4))[1];
        }
        if ($t === Dyn::TYPE_FIXED32) {
            return self::getU32($data, $off);
        }
        if ($t === Dyn::TYPE_SFIXED32) {
            return self::s32(self::getU32($data, $off));
        }
        if ($t === Dyn::TYPE_DOUBLE) {
            return unpack("e", substr($data, $off, 8))[1];
        }
        if ($t === Dyn::TYPE_FIXED64) {
            return self::getU64($data, $off);
        }
        if ($t === Dyn::TYPE_SFIXED64) {
            return self::getU64($data, $off);
        }
        if ($t === Dyn::TYPE_BOOL) {
            return ord($data[$off]) !== 0;
        }
        if ($t === Dyn::TYPE_ENUM || $t === Dyn::TYPE_INT32 || $t === Dyn::TYPE_SINT32) {
            return self::s32(self::getU64($data, $off));
        }
        if ($t === Dyn::TYPE_INT64 || $t === Dyn::TYPE_SINT64) {
            return self::getU64($data, $off);
        }
        if ($t === Dyn::TYPE_UINT32) {
            return self::getU64($data, $off) & 0xFFFFFFFF;
        }
        return self::getU64($data, $off);
    }

    private static function readValue(string $data, int $off, int $len, FieldModel $f, FileModel $fm)
    {
        if ($off + $len > strlen($data)) {
            throw self::fail("struct codec: out of bounds");
        }
        $raw = substr($data, $off, $len);
        $t = $f->type;
        if ($t === Dyn::TYPE_STRING || $t === Dyn::TYPE_BYTES) {
            return $raw;
        }
        if ($t === Dyn::TYPE_MESSAGE) {
            if ($len === 0) {
                return new GenericMessage();
            }
            return self::decodeStruct($fm->messages[$f->typeName], $raw, $fm);
        }
        return self::readScalar($data, $off, $f);
    }

    public static function decodeStruct(MessageModel $model, string $data, FileModel $fm): GenericMessage
    {
        $fields = self::sortedFields($model);
        $words = max(1, intdiv(count($fields) + 31, 32));
        $header = 12 + 4 * $words;
        if (strlen($data) < $header || substr($data, 0, 4) !== "DCS1") {
            throw self::fail("struct codec: bad header");
        }
        if (self::getU32($data, 8) !== self::fingerprint($model->fullName)) {
            throw self::fail("struct codec: schema fingerprint mismatch");
        }
        if (self::getU32($data, 4) !== strlen($data)) {
            throw self::fail("struct codec: length mismatch");
        }
        $offsets = [];
        $cursor = $header;
        foreach ($fields as $f) {
            $offsets[] = $cursor;
            $cursor += self::slotSize($f);
        }
        $msg = new GenericMessage($model);
        $vend = $cursor;
        foreach ($fields as $i => $f) {
            if ((self::getU32($data, 12 + 4 * intdiv($i, 32)) & (1 << ($i % 32))) === 0) {
                continue;
            }
            $off = $offsets[$i];
            if (self::isMap($f, $fm)) {
                $entryModel = self::mapModel($f, $fm);
                $kf = $entryModel->fields[1];
                $vf = $entryModel->fields[2];
                $base = self::getU32($data, $off);
                $n = self::getU32($data, $off + 4);
                $p = $base;
                for ($j = 0; $j < $n; $j++) {
                    $kl = self::getU32($data, $p);
                    $vl = self::getU32($data, $p + 4);
                    $p += 8;
                    $key = self::readValue($data, $p, $kl, $kf, $fm);
                    $val = self::readValue($data, $p + $kl, $vl, $vf, $fm);
                    $entry = new GenericMessage($entryModel);
                    $entry->set(1, $key);
                    $entry->set(2, $val);
                    $msg->add($f->number, $entry);
                    $p += $kl + $vl;
                }
                $vend = max($vend, $p);
            } elseif ($f->repeated) {
                $base = self::getU32($data, $off);
                $n = self::getU32($data, $off + 4);
                if ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                    || $f->type === Dyn::TYPE_MESSAGE) {
                    for ($j = 0; $j < $n; $j++) {
                        $eo = self::getU32($data, $base + 8 * $j);
                        $el = self::getU32($data, $base + 8 * $j + 4);
                        if ($el > 0 || $f->type !== Dyn::TYPE_MESSAGE) {
                            $msg->add($f->number, self::readValue($data, $eo, $el, $f, $fm));
                        }
                        $vend = max($vend, $eo + $el);
                    }
                } else {
                    for ($j = 0; $j < $n; $j++) {
                        $msg->add($f->number, self::readScalar($data, $base + $j * self::slotSize($f), $f));
                    }
                    $vend = max($vend, $base + $n * self::slotSize($f));
                }
            } elseif ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES
                || $f->type === Dyn::TYPE_MESSAGE) {
                $base = self::getU32($data, $off);
                $len = self::getU32($data, $off + 4);
                $msg->add($f->number, self::readValue($data, $base, $len, $f, $fm));
                $vend = max($vend, $base + $len);
            } else {
                $msg->add($f->number, self::readScalar($data, $off, $f));
            }
        }
        if ($vend < strlen($data)) {
            $msg->unknown[] = substr($data, $vend);
        }
        return $msg;
    }

    private static function zigzagDecode(int $v): int
    {
        return ($v >> 1) ^ -($v & 1);
    }

    private static function decodeValueS(FieldModel $f, int $wire, $raw, FileModel $fm)
    {
        if ($wire === 0) {
            if ($f->type === Dyn::TYPE_BOOL) {
                return $raw !== 0;
            }
            if ($f->type === Dyn::TYPE_SINT32 || $f->type === Dyn::TYPE_SINT64) {
                return self::zigzagDecode($raw);
            }
            if ($f->type === Dyn::TYPE_INT32 || $f->type === Dyn::TYPE_ENUM) {
                return self::s32($raw);
            }
            if ($f->type === Dyn::TYPE_INT64) {
                return $raw;
            }
            if ($f->type === Dyn::TYPE_UINT32) {
                return $raw & 0xFFFFFFFF;
            }
            return $raw;
        }
        if ($wire === 1) {
            if ($f->type === Dyn::TYPE_DOUBLE) {
                return unpack("e", $raw)[1];
            }
            if ($f->type === Dyn::TYPE_SFIXED64) {
                return unpack("q", $raw)[1];
            }
            return unpack("q", $raw)[1];
        }
        if ($wire === 5) {
            if ($f->type === Dyn::TYPE_FLOAT) {
                return unpack("g", $raw)[1];
            }
            if ($f->type === Dyn::TYPE_SFIXED32) {
                return self::s32(unpack("V", $raw)[1]);
            }
            return unpack("V", $raw)[1];
        }
        if ($f->type === Dyn::TYPE_STRING || $f->type === Dyn::TYPE_BYTES) {
            return $raw;
        }
        if ($f->type === Dyn::TYPE_MESSAGE) {
            return self::decodeGenericS($fm->messages[$f->typeName], $raw, $fm);
        }
        return $raw;
    }

    /** @return array<int,mixed> */
    private static function decodePacked(FieldModel $f, string $data, FileModel $fm): array
    {
        $out = [];
        $t = $f->type;
        if ($t === Dyn::TYPE_DOUBLE || $t === Dyn::TYPE_FIXED64 || $t === Dyn::TYPE_SFIXED64) {
            for ($i = 0; $i + 8 <= strlen($data); $i += 8) {
                $out[] = self::decodeValueS($f, 1, substr($data, $i, 8), $fm);
            }
        } elseif ($t === Dyn::TYPE_FLOAT || $t === Dyn::TYPE_FIXED32 || $t === Dyn::TYPE_SFIXED32) {
            for ($i = 0; $i + 4 <= strlen($data); $i += 4) {
                $out[] = self::decodeValueS($f, 5, substr($data, $i, 4), $fm);
            }
        } else {
            $n = strlen($data);
            $i = 0;
            while ($i < $n) {
                $result = 0;
                $shift = 0;
                while (true) {
                    if ($i >= $n) {
                        throw self::fail("truncated varint");
                    }
                    $b = ord($data[$i]);
                    $i++;
                    if ($shift === 63) {
                        if (($b & 1) !== 0) {
                            $result |= PHP_INT_MIN;
                        }
                    } elseif ($shift < 63) {
                        $result |= ($b & 0x7F) << $shift;
                    }
                    if (($b & 0x80) === 0) {
                        break;
                    }
                    $shift += 7;
                    if ($shift >= 70) {
                        throw self::fail("varint too long");
                    }
                }
                $out[] = self::decodeValueS($f, 0, $result, $fm);
            }
        }
        return $out;
    }

    public static function decodeGenericS(MessageModel $model, string $data, FileModel $fm): GenericMessage
    {
        $msg = new GenericMessage($model);
        try {
            $fields = (new PbReader($data))->fields();
        } catch (\InvalidArgumentException $e) {
            throw self::fail($e->getMessage());
        }
        foreach ($fields as [$number, $wire, $raw, $chunk]) {
            $f = $model->fields[$number] ?? null;
            if ($f === null) {
                $msg->unknown[] = $chunk;
                continue;
            }
            if ($f->repeated && $wire === 2
                && $f->type !== Dyn::TYPE_STRING && $f->type !== Dyn::TYPE_BYTES
                && $f->type !== Dyn::TYPE_MESSAGE && $f->type !== Dyn::TYPE_GROUP) {
                foreach (self::decodePacked($f, $raw, $fm) as $v) {
                    $msg->add($number, $v);
                }
                continue;
            }
            $msg->add($number, self::decodeValueS($f, $wire, $raw, $fm));
        }
        return $msg;
    }

    /** Transcode protobuf <-> struct bytes for $typeName under
     *  the FileDescriptorSet bytes $descriptor. */
    public static function transcodeStruct(string $descriptor, string $typeName, string $data, bool $encode): string
    {
        $key = hash("sha256", $descriptor);
        $fm = self::$cache[$key] ?? null;
        if ($fm === null) {
            $fm = Dyn::parseDescriptorSet($descriptor);
            self::$cache[$key] = $fm;
        }
        $model = $fm->messages[$typeName] ?? ($fm->messages["." . $typeName] ?? null);
        if ($model === null) {
            throw self::fail("unknown message type " . $typeName);
        }
        if ($encode) {
            return self::encodeStruct($model, self::decodeGenericS($model, $data, $fm), $fm);
        }
        return Dyn::encodeGeneric($model, self::decodeStruct($model, $data, $fm), $fm);
    }
}
GRPC_RUNTIME_EOF
)

(define php-dynamic-body
#<<GRPC_RUNTIME_EOF
// Dynamic, descriptor-driven client and server.
//
// Parses a FileDescriptorSet (as produced by
// `protoc --descriptor_set_out`) at runtime and builds clients
// and servers whose messages are generic field maps — no
// generated stubs required. This is the runtime-generation
// counterpart of the protoc-plugin surfaces: schemas arrive as
// data (descriptor.proto), not as code.
//
// Generic values by field type: varint family -> int,
// string -> string, bytes/message -> string / GenericMessage,
// fixed/float -> int / float, bool -> bool. Repeated
// fields are arrays in field-number order.

namespace Grpcdc;

require_once __DIR__ . "/codec.php";
require_once __DIR__ . "/server.php";
require_once __DIR__ . "/wire_gen.php";

/** Minimal protobuf reader over a binary string. */
class PbReader
{
    private string $buf;
    private int $pos = 0;
    public ?string $lastChunk = null;

    public function __construct(string $data)
    {
        $this->buf = $data;
    }

    public function varint(): int
    {
        $result = 0;
        $shift = 0;
        while (true) {
            if ($this->pos >= strlen($this->buf)) {
                throw new \InvalidArgumentException("truncated varint");
            }
            $b = ord($this->buf[$this->pos]);
            $this->pos++;
            if ($shift === 63) {
                if (($b & 1) !== 0) {
                    $result |= PHP_INT_MIN;
                }
            } elseif ($shift < 63) {
                $result |= ($b & 0x7F) << $shift;
            }
            if (($b & 0x80) === 0) {
                return $result;
            }
            $shift += 7;
            if ($shift >= 70) {
                throw new \InvalidArgumentException("varint too long");
            }
        }
    }

    public function bytesField(): string
    {
        $n = $this->varint();
        if ($this->pos + $n > strlen($this->buf)) {
            throw new \InvalidArgumentException("truncated bytes field");
        }
        $out = substr($this->buf, $this->pos, $n);
        $this->pos += $n;
        return $out;
    }

    /**
     * All fields as [number, wireType, value] triples; lastChunk
     * holds the raw bytes of the most recent field (captured
     * before the consumer processes it).
     */
    public function fields(): array
    {
        $out = [];
        while ($this->pos < strlen($this->buf)) {
            $start = $this->pos;
            $tag = $this->varint();
            $number = $tag >> 3;
            $wire = $tag & 7;
            switch ($wire) {
                case 0:
                    $value = $this->varint();
                    break;
                case 2:
                    $value = $this->bytesField();
                    break;
                case 1:
                    if ($this->pos + 8 > strlen($this->buf)) {
                        throw new \InvalidArgumentException("truncated fixed64");
                    }
                    $value = substr($this->buf, $this->pos, 8);
                    $this->pos += 8;
                    break;
                case 5:
                    if ($this->pos + 4 > strlen($this->buf)) {
                        throw new \InvalidArgumentException("truncated fixed32");
                    }
                    $value = substr($this->buf, $this->pos, 4);
                    $this->pos += 4;
                    break;
                default:
                    throw new \InvalidArgumentException("unsupported wire type $wire");
            }
            $this->lastChunk = substr($this->buf, $start, $this->pos - $start);
            $out[] = [$number, $wire, $value, $this->lastChunk];
        }
        return $out;
    }
}

class FieldModel
{
    public int $number;
    public string $name;
    public int $type;
    public bool $repeated;
    public string $typeName;

    public function __construct(int $number, string $name, int $fieldType, int $label, string $typeName)
    {
        $this->number = $number;
        $this->name = $name;
        $this->type = $fieldType;
        $this->repeated = ($label === Dyn::LABEL_REPEATED);
        $this->typeName = $typeName; // for TYPE_MESSAGE, e.g. ".echo.EchoRequest"
    }
}

class MessageModel
{
    public string $fullName;
    /** @var array<int, FieldModel> */
    public array $fields;
    /** @var array<string, FieldModel> */
    public array $byName = [];
    public bool $mapEntry;

    public function __construct(string $fullName, array $fields, bool $mapEntry = false)
    {
        $this->fullName = $fullName;
        $this->fields = $fields;
        $this->mapEntry = $mapEntry;
        $this->refreshByName();
    }

    public function refreshByName(): void
    {
        $this->byName = [];
        foreach ($this->fields as $f) {
            $this->byName[$f->name] = $f;
        }
    }
}

class MethodModel
{
    public string $name;
    public string $path;
    public string $kind;
    public MessageModel $input;
    public MessageModel $output;

    public function __construct(string $name, string $path, string $kind, MessageModel $input, MessageModel $output)
    {
        $this->name = $name;
        $this->path = $path;
        $this->kind = $kind;
        $this->input = $input;
        $this->output = $output;
    }
}

class ServiceModel
{
    public string $fullName;
    /** @var array<string, MethodModel> */
    public array $methods;

    public function __construct(string $fullName, array $methods)
    {
        $this->fullName = $fullName;
        $this->methods = $methods;
    }
}

/** Parsed descriptor set: messages and services by full name. */
class FileModel
{
    /** @var array<string, MessageModel> ".echo.EchoRequest" -> model */
    public array $messages = [];
    /** @var array<string, ServiceModel> "echo.Echo" -> model */
    public array $services = [];

    public function message(string $fullName): MessageModel
    {
        return $this->messages[$fullName];
    }

    public function service(string $fullName): ServiceModel
    {
        return $this->services[$fullName];
    }
}

/**
 * A message as field number -> list of values (descriptor order).
 *
 * Fields not in the model are retained as raw encoded chunks in
 * `unknown` (protobuf unknown-field retention): a decode ->
 * encode round trip re-emits them after the known fields, so
 * intermediate hops do not strip newer fields.
 */
class GenericMessage
{
    public ?MessageModel $model;
    /** @var array<int, array> */
    public array $values = [];
    /** @var string[] */
    public array $unknown = [];

    public function __construct(?MessageModel $model = null)
    {
        $this->model = $model;
    }

    public function set(int $number, $value): self
    {
        $this->values[$number] = [$value];
        return $this;
    }

    public function add(int $number, $value): self
    {
        $this->values[$number][] = $value;
        return $this;
    }

    public function getAll(int $number): array
    {
        return $this->values[$number] ?? [];
    }

    public function get(int $number, $default = null)
    {
        $items = $this->values[$number] ?? [];
        return count($items) > 0 ? $items[0] : $default;
    }

    public function getString(int $number, string $default = ""): string
    {
        $value = $this->get($number);
        return is_string($value) ? $value : $default;
    }

    public function getInt(int $number, int $default = 0): int
    {
        $value = $this->get($number);
        return is_int($value) ? $value : $default;
    }

    public function equals(?object $other): bool
    {
        return $other instanceof GenericMessage && $this->values === $other->values;
    }
}

/** Descriptor-driven encode/decode and registration (Grpcdc statics). */
final class Dyn
{
    // FieldDescriptorProto.Type values (descriptor.proto).
    public const TYPE_DOUBLE = 1;
    public const TYPE_FLOAT = 2;
    public const TYPE_INT64 = 3;
    public const TYPE_UINT64 = 4;
    public const TYPE_INT32 = 5;
    public const TYPE_FIXED64 = 6;
    public const TYPE_FIXED32 = 7;
    public const TYPE_BOOL = 8;
    public const TYPE_STRING = 9;
    public const TYPE_GROUP = 10;
    public const TYPE_MESSAGE = 11;
    public const TYPE_BYTES = 12;
    public const TYPE_UINT32 = 13;
    public const TYPE_ENUM = 14;
    public const TYPE_SFIXED32 = 15;
    public const TYPE_SFIXED64 = 16;
    public const TYPE_SINT32 = 17;
    public const TYPE_SINT64 = 18;

    public const LABEL_REPEATED = 3;

    private static function wireType(int $fieldType): int
    {
        switch ($fieldType) {
            case self::TYPE_INT64:
            case self::TYPE_UINT64:
            case self::TYPE_INT32:
            case self::TYPE_BOOL:
            case self::TYPE_UINT32:
            case self::TYPE_ENUM:
            case self::TYPE_SINT32:
            case self::TYPE_SINT64:
                return 0;
            case self::TYPE_FIXED64:
            case self::TYPE_SFIXED64:
            case self::TYPE_DOUBLE:
                return 1;
            case self::TYPE_STRING:
            case self::TYPE_BYTES:
            case self::TYPE_MESSAGE:
            case self::TYPE_GROUP:
                return 2;
            default:
                return 5;
        }
    }

    public static function encodeVarint(int $value): string
    {
        $out = "";
        $v = $value;
        while (true) {
            $b = $v & 0x7F;
            // Logical shift right by 7 on the 64-bit pattern.
            $v = ($v >> 7) & 0x01FFFFFFFFFFFFFF;
            if ($v === 0) {
                $out .= chr($b);
                return $out;
            }
            $out .= chr($b | 0x80);
        }
    }

    public static function encodeGeneric(MessageModel $model, GenericMessage $message, FileModel $fileModel): string
    {
        $out = "";
        $numbers = array_keys($message->values);
        sort($numbers);
        foreach ($numbers as $number) {
            $field = $model->fields[$number] ?? null;
            if ($field === null) {
                throw new StatusError(Wire::CODE_INVALID_ARGUMENT, "unknown field $number for " . $model->fullName);
            }
            $values = $message->values[$number];
            if ($field->repeated) {
                foreach ($values as $value) {
                    $out .= self::encodeValue($field, $value, $fileModel);
                }
            } elseif (count($values) > 0) {
                $out .= self::encodeValue($field, $values[0], $fileModel);
            }
        }
        foreach ($message->unknown as $chunk) {
            $out .= $chunk;
        }
        return $out;
    }

    public static function decodeGeneric(MessageModel $model, string $data, FileModel $fileModel): GenericMessage
    {
        $message = new GenericMessage($model);
        $reader = new PbReader($data);
        foreach ($reader->fields() as [$number, $wire, $raw, $chunk]) {
            $field = $model->fields[$number] ?? null;
            if ($field === null) {
                // Unknown field: retain the raw encoded chunk verbatim.
                $message->unknown[] = $chunk;
                continue;
            }
            $message->values[$number][] = self::decodeValue($field, $wire, $raw, $fileModel);
        }
        return $message;
    }

    /** Parse FileDescriptorSet bytes into a FileModel. */
    public static function parseDescriptorSet(string $data): FileModel
    {
        $fileModel = new FileModel();
        $pendingServices = [];
        foreach ((new PbReader($data))->fields() as [$number, $wire, $fileBytes]) {
            if ($number !== 1) {
                continue;
            }
            $package = "";
            $serviceTypes = [];
            $fieldsOfFile = (new PbReader($fileBytes))->fields();
            foreach ($fieldsOfFile as [$fnum, $w, $fval]) {
                if ($fnum === 2) {
                    $package = $fval;
                }
            }
            foreach ($fieldsOfFile as [$fnum, $w, $fval]) {
                if ($fnum === 4) {
                    self::parseMessage($package, $fval, $fileModel);
                } elseif ($fnum === 6) {
                    $serviceTypes[] = [$package, $fval];
                }
            }
            foreach ($serviceTypes as $st) {
                $pendingServices[] = $st;
            }
        }
        foreach ($pendingServices as [$package, $bytes]) {
            self::parseService($package, $bytes, $fileModel);
        }
        return $fileModel;
    }

    /**
     * Register a runtime-built service on a Server.
     *
     * $handler is an object with methods by kind:
     *   unary(ctx, method, request) -> GenericMessage
     *   serverStream(ctx, method, request, send) -> null
     *   clientStream(ctx, method, requestGenerator) -> GenericMessage
     *   bidi(ctx, method, requestGenerator, send) -> null
     * where send is a callable taking a GenericMessage and the
     * request generator yields GenericMessages until half-close.
     */
    public static function registerDynamicService(Server $server, FileModel $fileModel, string $serviceName, object $handler): void
    {
        $service = $fileModel->services[$serviceName];
        $methods = [];
        foreach ($service->methods as $method) {
            $methods[] = new Method($method->name, $method->path, $method->kind, self::makeHandler($handler, $method, $fileModel));
        }
        $server->registerService(new ServiceDesc($service->fullName, $methods));
    }

    private static function toSigned(int $value, int $bits): int
    {
        if ($bits === 32) {
            $v = $value & 0xFFFFFFFF;
            return $v >= 0x80000000 ? $v - 0x100000000 : $v;
        }
        return $value; // PHP ints are signed 64-bit already
    }

    private static function zigzagDecode(int $value): int
    {
        return ($value >> 1) ^ -($value & 1);
    }

    private static function zigzagEncode(int $value): int
    {
        return ($value << 1) ^ ($value >> 63);
    }

    private static function encodeValue(FieldModel $field, $value, FileModel $fileModel): string
    {
        $wire = self::wireType($field->type);
        $out = self::encodeVarint(($field->number << 3) | $wire);
        switch ($wire) {
            case 0:
                if ($field->type === self::TYPE_SINT32 || $field->type === self::TYPE_SINT64) {
                    $bits = $field->type === self::TYPE_SINT32 ? 32 : 64;
                    $enc = self::zigzagEncode((int)$value);
                    if ($bits === 32) {
                        $enc &= 0xFFFFFFFF;
                    }
                    $out .= self::encodeVarint($enc);
                } elseif ($field->type === self::TYPE_BOOL) {
                    $out .= self::encodeVarint($value ? 1 : 0);
                } else {
                    $out .= self::encodeVarint((int)$value);
                }
                break;
            case 1:
                if ($field->type === self::TYPE_DOUBLE) {
                    $out .= pack("e", (float)$value);
                } elseif ($field->type === self::TYPE_SFIXED64) {
                    $out .= pack("q", (int)$value);
                } else {
                    $out .= pack("Q", (int)$value);
                }
                break;
            case 5:
                if ($field->type === self::TYPE_FLOAT) {
                    $out .= pack("g", (float)$value);
                } elseif ($field->type === self::TYPE_SFIXED32) {
                    $v = (int)$value & 0xFFFFFFFF;
                    $out .= pack("V", $v);
                } else {
                    $out .= pack("V", (int)$value & 0xFFFFFFFF);
                }
                break;
            default:
                if ($field->type === self::TYPE_STRING) {
                    $data = (string)$value;
                } elseif ($field->type === self::TYPE_MESSAGE) {
                    $data = self::encodeGeneric($fileModel->messages[$field->typeName], $value, $fileModel);
                } else {
                    $data = (string)$value;
                }
                $out .= self::encodeVarint(strlen($data));
                $out .= $data;
                break;
        }
        return $out;
    }

    private static function decodeValue(FieldModel $field, int $wire, $raw, FileModel $fileModel)
    {
        switch ($wire) {
            case 0:
                switch ($field->type) {
                    case self::TYPE_BOOL:
                        return $raw !== 0;
                    case self::TYPE_SINT32:
                    case self::TYPE_SINT64:
                        return self::zigzagDecode($raw);
                    case self::TYPE_INT32:
                    case self::TYPE_ENUM:
                        return self::toSigned($raw, 32);
                    case self::TYPE_INT64:
                        return self::toSigned($raw, 64);
                    default:
                        return $raw;
                }
            case 1:
                switch ($field->type) {
                    case self::TYPE_DOUBLE:
                        return unpack("e", $raw)[1];
                    case self::TYPE_SFIXED64:
                        return unpack("q", $raw)[1];
                    default:
                        return unpack("Q", $raw)[1];
                }
            case 5:
                switch ($field->type) {
                    case self::TYPE_FLOAT:
                        return unpack("g", $raw)[1];
                    case self::TYPE_SFIXED32:
                        $v = unpack("V", $raw)[1];
                        return $v >= 0x80000000 ? $v - 0x100000000 : $v;
                    default:
                        return unpack("V", $raw)[1];
                }
            default:
                switch ($field->type) {
                    case self::TYPE_STRING:
                        return $raw;
                    case self::TYPE_MESSAGE:
                        return self::decodeGeneric($fileModel->messages[$field->typeName], $raw, $fileModel);
                    default:
                        return $raw;
                }
        }
    }

    /** MessageOptions.map_entry (field 7) marks map entries. */
    private static function parseMapEntry(?string $options): bool
    {
        if ($options === null) {
            return false;
        }
        foreach ((new PbReader($options))->fields() as [$fnum, $w, $fval]) {
            if ($fnum === 7 && $fval !== 0) {
                return true;
            }
        }
        return false;
    }

    private static function parseMessage(string $package, string $data, FileModel $fileModel): MessageModel
    {
        $name = "";
        $rawFields = [];
        $nested = [];
        $options = null;
        foreach ((new PbReader($data))->fields() as [$fnum, $w, $fval]) {
            if ($fnum === 1) {
                $name = $fval;
            } elseif ($fnum === 2) {
                $rawFields[] = $fval;
            } elseif ($fnum === 3) {
                $nested[] = $fval;
            } elseif ($fnum === 7) {
                $options = $fval;
            }
        }
        $fullName = $package === "" ? $name : $package . "." . $name;
        $fields = [];
        $model = new MessageModel($fullName, $fields, self::parseMapEntry($options));
        $fileModel->messages["." . $fullName] = $model;
        foreach ($nested as $bytes) {
            self::parseNested($fullName, $bytes, $fileModel);
        }
        foreach ($rawFields as $fieldBytes) {
            $field = self::parseField($fieldBytes);
            $fields[$field->number] = $field;
        }
        $model->fields = $fields;
        $model->refreshByName();
        return $model;
    }

    private static function parseNested(string $outerFull, string $data, FileModel $fileModel): MessageModel
    {
        $name = "";
        $rawFields = [];
        $nested = [];
        $options = null;
        foreach ((new PbReader($data))->fields() as [$fnum, $w, $fval]) {
            if ($fnum === 1) {
                $name = $fval;
            } elseif ($fnum === 2) {
                $rawFields[] = $fval;
            } elseif ($fnum === 3) {
                $nested[] = $fval;
            } elseif ($fnum === 7) {
                $options = $fval;
            }
        }
        $fullName = $outerFull . "." . $name;
        $fields = [];
        $model = new MessageModel($fullName, $fields, self::parseMapEntry($options));
        $fileModel->messages["." . $fullName] = $model;
        foreach ($nested as $bytes) {
            self::parseNested($fullName, $bytes, $fileModel);
        }
        foreach ($rawFields as $fieldBytes) {
            $field = self::parseField($fieldBytes);
            $fields[$field->number] = $field;
        }
        $model->fields = $fields;
        $model->refreshByName();
        return $model;
    }

    private static function parseField(string $data): FieldModel
    {
        $name = "";
        $number = 0;
        $label = 1;
        $fieldType = 0;
        $typeName = "";
        foreach ((new PbReader($data))->fields() as [$fnum, $w, $fval]) {
            if ($fnum === 1) {
                $name = $fval;
            } elseif ($fnum === 3) {
                $number = $fval;
            } elseif ($fnum === 4) {
                $label = $fval;
            } elseif ($fnum === 5) {
                $fieldType = $fval;
            } elseif ($fnum === 6) {
                $typeName = $fval;
            }
        }
        return new FieldModel($number, $name, $fieldType, $label, $typeName);
    }

    private static function kindOf(bool $clientStreaming, bool $serverStreaming): string
    {
        if ($clientStreaming && $serverStreaming) {
            return Server::KIND_BIDI;
        } elseif ($serverStreaming) {
            return Server::KIND_SERVER_STREAMING;
        } elseif ($clientStreaming) {
            return Server::KIND_CLIENT_STREAMING;
        }
        return Server::KIND_UNARY;
    }

    private static function parseService(string $package, string $data, FileModel $fileModel): ServiceModel
    {
        $name = "";
        $rawMethods = [];
        foreach ((new PbReader($data))->fields() as [$fnum, $w, $fval]) {
            if ($fnum === 1) {
                $name = $fval;
            } elseif ($fnum === 2) {
                $rawMethods[] = $fval;
            }
        }
        $fullName = $package === "" ? $name : $package . "." . $name;
        $methods = [];
        foreach ($rawMethods as $methodBytes) {
            $mname = "";
            $inputType = "";
            $outputType = "";
            $clientStreaming = false;
            $serverStreaming = false;
            foreach ((new PbReader($methodBytes))->fields() as [$fnum, $w, $fval]) {
                if ($fnum === 1) {
                    $mname = $fval;
                } elseif ($fnum === 2) {
                    $inputType = $fval;
                } elseif ($fnum === 3) {
                    $outputType = $fval;
                } elseif ($fnum === 5) {
                    $clientStreaming = $fval !== 0;
                } elseif ($fnum === 6) {
                    $serverStreaming = $fval !== 0;
                }
            }
            $methods[$mname] = new MethodModel(
                $mname,
                "/" . $fullName . "/" . $mname,
                self::kindOf($clientStreaming, $serverStreaming),
                $fileModel->messages[$inputType],
                $fileModel->messages[$outputType]
            );
        }
        $service = new ServiceModel($fullName, $methods);
        $fileModel->services[$fullName] = $service;
        return $service;
    }

    private static function makeHandler(object $handler, MethodModel $method, FileModel $fileModel): \Closure
    {
        return function (CallContext $ctx, RequestStream $reqs, ResponseSink $sink) use ($handler, $method, $fileModel) {
            $send = function (GenericMessage $generic) use ($sink, $method, $fileModel) {
                $sink->send(Dyn::encodeGeneric($method->output, $generic, $fileModel));
            };
            $requests = (function () use ($reqs, $method, $fileModel) {
                while (true) {
                    try {
                        $payload = $reqs->recvRaw();
                    } catch (CallClosed $e) {
                        return;
                    }
                    yield Dyn::decodeGeneric($method->input, $payload, $fileModel);
                }
            })();
            switch ($method->kind) {
                case Server::KIND_UNARY:
                    $requests->rewind();
                    $send($handler->unary($ctx, $method, $requests->current()));
                    break;
                case Server::KIND_SERVER_STREAMING:
                    $requests->rewind();
                    $handler->serverStream($ctx, $method, $requests->current(), $send);
                    break;
                case Server::KIND_CLIENT_STREAMING:
                    $send($handler->clientStream($ctx, $method, $requests));
                    break;
                default:
                    $handler->bidi($ctx, $method, $requests, $send);
                    break;
            }
        };
    }
}

/** Adapts a (MessageModel, GenericMessage) pair to the Channel marshal/unmarshal contract. */
class BoundMessage
{
    public MessageModel $model;
    public GenericMessage $generic;
    public FileModel $fileModel;

    public function __construct(MessageModel $model, ?GenericMessage $generic, FileModel $fileModel)
    {
        $this->model = $model;
        $this->generic = $generic ?? new GenericMessage($model);
        $this->fileModel = $fileModel;
    }

    public function marshalDc(): string
    {
        return Dyn::encodeGeneric($this->model, $this->generic, $this->fileModel);
    }

    public function unmarshalDc(string $data): self
    {
        $this->generic = Dyn::decodeGeneric($this->model, $data, $this->fileModel);
        return $this;
    }
}

class DynamicRecvStream
{
    private object $stream;
    private MessageModel $model;
    private FileModel $fileModel;

    public function __construct(object $stream, MessageModel $model, FileModel $fileModel)
    {
        $this->stream = $stream;
        $this->model = $model;
        $this->fileModel = $fileModel;
    }

    /** Next response GenericMessage; CallClosed at end. */
    public function recv(): GenericMessage
    {
        return $this->stream->recv(new BoundMessage($this->model, null, $this->fileModel))->generic;
    }

    /** Abandon the call early: RST unless it already terminated. */
    public function cancel(): void
    {
        $this->stream->cancel();
    }

    public function close(): void
    {
        $this->stream->cancel();
    }

    public function __destruct()
    {
        $this->close();
    }

    /** @return \Generator<int, GenericMessage> */
    public function iterate(): \Generator
    {
        $completed = false;
        try {
            while (true) {
                yield $this->recv();
            }
        } catch (CallClosed $e) {
            $completed = true;
            return;
        } finally {
            // Abandoning the generator early RSTs the call so the
            // server stops producing (no-op once terminated).
            if (!$completed) {
                $this->close();
            }
        }
    }
}

/** Runtime-built client: methods resolve from the FileModel. */
class DynamicClient
{
    private Channel $channel;
    private FileModel $model;

    public function __construct(Channel $channel, FileModel $fileModel)
    {
        $this->channel = $channel;
        $this->model = $fileModel;
    }

    public function unary(string $serviceName, string $methodName, GenericMessage $request, ?array $metadata = null, ?float $timeout = null): GenericMessage
    {
        $method = $this->resolve($serviceName, $methodName);
        $resp = new BoundMessage($method->output, null, $this->model);
        $this->channel->unary($method->path, new BoundMessage($method->input, $request, $this->model), $resp, $metadata, $timeout);
        return $resp->generic;
    }

    public function serverStream(string $serviceName, string $methodName, GenericMessage $request, ?array $metadata = null, ?float $timeout = null): DynamicRecvStream
    {
        $method = $this->resolve($serviceName, $methodName);
        $stream = $this->channel->serverStream($method->path, new BoundMessage($method->input, $request, $this->model), $metadata, $timeout);
        return new DynamicRecvStream($stream, $method->output, $this->model);
    }

    public function clientStream(string $serviceName, string $methodName, array $requests, ?array $metadata = null, ?float $timeout = null): GenericMessage
    {
        $method = $this->resolve($serviceName, $methodName);
        $resp = new BoundMessage($method->output, null, $this->model);
        $bound = array_map(function ($r) use ($method) {
            return new BoundMessage($method->input, $r, $this->model);
        }, $requests);
        $this->channel->clientStream($method->path, $bound, $resp, $metadata, $timeout);
        return $resp->generic;
    }

    public function bidi(string $serviceName, string $methodName, array $requests, ?array $metadata = null, ?float $timeout = null): DynamicRecvStream
    {
        $method = $this->resolve($serviceName, $methodName);
        $bound = array_map(function ($r) use ($method) {
            return new BoundMessage($method->input, $r, $this->model);
        }, $requests);
        $stream = $this->channel->bidi($method->path, $bound, $metadata, $timeout);
        return new DynamicRecvStream($stream, $method->output, $this->model);
    }

    private function resolve(string $serviceName, string $methodName): MethodModel
    {
        return $this->model->services[$serviceName]->methods[$methodName];
    }
}
GRPC_RUNTIME_EOF
