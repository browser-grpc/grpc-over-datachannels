(define php-kafka-native-body
#<<GRPC_RUNTIME_EOF
// In-process Kafka client via libkafka_native (native only).
//
// The collapsed form of the Kafka proxy: the Kafka protocol
// implementation runs in this process through the
// kafka-native shared library (C ABI via stdlib FFI),
// instead of in a kafka_proxy sidecar reached over gRPC.
// Method surface mirrors the generated KafkaClient;
// requests and responses are the same generated KafkaPb
// messages. Library location: the $lib argument, the
// GRPC_DC_KAFKA_NATIVE_LIB environment variable, or the
// loader path.

namespace Grpcdc;

require_once __DIR__ . "/kafka_pb.php";

class KafkaNativeException extends \Exception
{
}

class KafkaNativeStream implements \Iterator
{
    private KafkaNativeClient $client;
    private mixed $stream;
    private string $respClass;
    private ?object $current = null;
    private bool $started = false;
    private bool $done = false;

    public function __construct(KafkaNativeClient $client, mixed $stream, string $respClass)
    {
        $this->client = $client;
        $this->stream = $stream;
        $this->respClass = $respClass;
    }

    public function close(): void
    {
        if ($this->stream !== null) {
            $this->client->streamFree($this->stream);
            $this->stream = null;
        }
        $this->done = true;
    }

    private function fill(): void
    {
        if ($this->started || $this->done || $this->stream === null) {
            return;
        }
        $this->started = true;
        $data = $this->client->streamNext($this->stream);
        if ($data === null) {
            $this->done = true;
            $this->current = null;
            return;
        }
        $cls = $this->respClass;
        $resp = new $cls();
        $resp->unmarshalDc($data);
        $this->current = $resp;
    }

    public function rewind(): void
    {
        $this->fill();
    }

    public function valid(): bool
    {
        return $this->current !== null;
    }

    public function current(): mixed
    {
        return $this->current;
    }

    public function key(): int
    {
        return 0;
    }

    public function next(): void
    {
        $this->started = false;
        $this->current = null;
        $this->fill();
    }
}

class KafkaNativeClient
{
    private const UNARY = [
        "Metadata" => "MetadataResponse",
        "OpenProducer" => "OpenProducerResponse",
        "CloseProducer" => "CloseProducerResponse",
        "EndTransaction" => "EndTransactionResponse",
        "Produce" => "ProduceResponse",
        "ListOffsets" => "ListOffsetsResponse",
        "CommitOffset" => "CommitOffsetResponse",
        "FetchOffset" => "FetchOffsetResponse",
        "CreateTopics" => "CreateTopicsResponse",
        "DeleteTopics" => "DeleteTopicsResponse",
        "DescribeConfigs" => "DescribeConfigsResponse",
        "AlterConfigs" => "AlterConfigsResponse",
        "CreatePartitions" => "CreatePartitionsResponse",
        "DeleteRecords" => "DeleteRecordsResponse",
        "ListGroups" => "ListGroupsResponse",
        "DescribeGroups" => "DescribeGroupsResponse",
        "DeleteGroups" => "DeleteGroupsResponse",
        "DeleteGroupOffsets" => "DeleteGroupOffsetsResponse",
        "DescribeAcls" => "DescribeAclsResponse",
        "CreateAcls" => "CreateAclsResponse",
        "DeleteAcls" => "DeleteAclsResponse",
        "ListTransactions" => "ListTransactionsResponse",
        "DescribeTransactions" => "DescribeTransactionsResponse",
        "DescribeShareGroups" => "DescribeShareGroupsResponse",
        "OpenShareGroup" => "OpenShareGroupResponse",
        "SharePoll" => "SharePollResponse",
        "ShareAck" => "ShareAckResponse",
        "CloseShareGroup" => "CloseShareGroupResponse",
    ];

    private const STREAMS = [
        "Consume" => "ConsumeResponse",
        "Subscribe" => "GroupSubscribeResponse",
    ];

    private \FFI $ffi;
    private mixed $handle;

    public function __construct(string $broker, string $clientId = "grpc-dc-kafka-native", ?string $lib = null)
    {
        $path = $lib ?? getenv("GRPC_DC_KAFKA_NATIVE_LIB");
        if ($path === false || $path === "") {
            $path = "libkafka_native.so";
        }
        try {
            $this->ffi = \FFI::cdef(
                "typedef struct KafkaNativeHandle KafkaNativeHandle;" .
                "typedef struct KafkaNativeStream KafkaNativeStream;" .
                "KafkaNativeHandle* kafka_native_new(const char* broker, const char* client_id);" .
                "void kafka_native_free(KafkaNativeHandle* handle);" .
                "int kafka_native_call(KafkaNativeHandle* handle, const char* method, const uint8_t* req, size_t req_len, uint8_t** out, size_t* out_len);" .
                "KafkaNativeStream* kafka_native_stream_new(KafkaNativeHandle* handle, const char* method, const uint8_t* req, size_t req_len);" .
                "int kafka_native_stream_next(KafkaNativeStream* stream, uint8_t** out, size_t* out_len);" .
                "void kafka_native_stream_free(KafkaNativeStream* stream);" .
                "void kafka_native_bytes_free(uint8_t* ptr, size_t len);" .
                "const char* kafka_native_last_error(void);",
                $path
            );
        } catch (\FFI\Exception $e) {
            throw new KafkaNativeException("libkafka_native not loadable: " . $e->getMessage());
        }
        $this->handle = $this->ffi->kafka_native_new($broker, $clientId);
        if ($this->handle === null) {
            throw new KafkaNativeException($this->lastError());
        }
    }

    public function close(): void
    {
        if ($this->handle !== null) {
            $this->ffi->kafka_native_free($this->handle);
            $this->handle = null;
        }
    }

    private function lastError(): string
    {
        $msg = $this->ffi->kafka_native_last_error();
        return $msg === null ? "kafka-native error" : \FFI::string($msg);
    }

    private function takeBytes(mixed $out, mixed $outLen): string
    {
        $ptr = $out[0];
        $len = (int) $outLen[0];
        if ($ptr === null || $len === 0) {
            return "";
        }
        $data = \FFI::string($ptr, $len);
        $this->ffi->kafka_native_bytes_free($ptr, $len);
        return $data;
    }

    private function bytesArg(string $payload): mixed
    {
        $buf = $this->ffi->new("uint8_t[" . max(strlen($payload), 1) . "]");
        if ($payload !== "") {
            \FFI::memcpy($buf, $payload, strlen($payload));
        }
        return $buf;
    }

    private function callUnary(string $method, object $req): object
    {
        $payload = $req->marshalDc();
        $out = $this->ffi->new("uint8_t*[1]");
        $outLen = $this->ffi->new("size_t[1]");
        $rc = $this->ffi->kafka_native_call($this->handle, $method, $this->bytesArg($payload), strlen($payload), $out, $outLen);
        if ($rc !== 0) {
            throw new KafkaNativeException($this->lastError());
        }
        $cls = "KafkaPb\\" . self::UNARY[$method];
        $resp = new $cls();
        $resp->unmarshalDc($this->takeBytes($out, $outLen));
        return $resp;
    }

    private function openStream(string $method, object $req): KafkaNativeStream
    {
        $payload = $req->marshalDc();
        $stream = $this->ffi->kafka_native_stream_new($this->handle, $method, $this->bytesArg($payload), strlen($payload));
        if ($stream === null) {
            throw new KafkaNativeException($this->lastError());
        }
        return new KafkaNativeStream($this, $stream, "KafkaPb\\" . self::STREAMS[$method]);
    }

    /** @internal for KafkaNativeStream */
    public function streamNext(mixed $stream): ?string
    {
        $out = $this->ffi->new("uint8_t*[1]");
        $outLen = $this->ffi->new("size_t[1]");
        $rc = $this->ffi->kafka_native_stream_next($stream, $out, $outLen);
        if ($rc === 0) {
            return null;
        }
        if ($rc < 0) {
            throw new KafkaNativeException($this->lastError());
        }
        return $this->takeBytes($out, $outLen);
    }

    /** @internal for KafkaNativeStream */
    public function streamFree(mixed $stream): void
    {
        $this->ffi->kafka_native_stream_free($stream);
    }

    public function __call(string $name, array $args): mixed
    {
        if (isset(self::UNARY[$name])) {
            return $this->callUnary($name, $args[0]);
        }
        if (isset(self::STREAMS[$name])) {
            return $this->openStream($name, $args[0]);
        }
        throw new KafkaNativeException("unknown kafka-native method $name");
    }
}
GRPC_RUNTIME_EOF
)

