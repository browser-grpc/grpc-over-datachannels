#lang racket

;;; proxy-gen.rkt — stamps proxy-spec.rkt into the generated
;;; proxy artifacts: proxy_modes.generated.json (parity data
;;; for proxy/proxy.test.mjs) and proxy/README.md (the
;;; supported-proxy document). Invoked from metagen.rkt so
;;; `make generate` regenerates everything in one pass.
;;; The proxy kernels (Node bridge, Rust sidecars) are
;;; hand-written; this generated surface around them —
;;; mode table, client notes, run docs — cannot drift.

(require "proxy-spec.rkt" json racket/runtime-path)
(provide generate-proxy)

(define-runtime-path here ".")
(define root (build-path here ".."))

(define (mode-json mode)
  (hasheq 'id (symbol->string (first mode))
          'title (second mode)
          'status (symbol->string (third mode))
          'implementation (fourth mode)
          'note (fifth mode)))

(define (modes-json-text)
  (with-output-to-string
    (lambda ()
      (write-json
       (hasheq 'modes (map mode-json proxy-mode-table)
               'clients
               (map (lambda (c)
                      (hasheq 'surface (symbol->string (first c))
                              'title (second c)
                              'note (third c)))
                    proxy-client-notes)))
      (newline))))

(define (mode-rows)
  (string-join
   (for/list ([mode (in-list proxy-mode-table)])
     (string-append "| `" (symbol->string (first mode)) "` | "
                    (second mode) " | " (symbol->string (third mode))
                    " | " (fourth mode) " | " (fifth mode) " |"))
   "\n"))

(define (client-rows)
  (string-join
   (for/list ([c (in-list proxy-client-notes)])
     (string-append "- **" (second c) "** — " (third c) "."))
   "\n"))

(define (readme-text)
  (string-append
   "# grpc-dc-proxy\n\n"
   "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->\n\n"
   "A supported HTTP/2 <-> DataChannel proxy. Stock gRPC\n"
   "clients (grpc-java and peers, HTTP/2 over TCP) call a\n"
   "grpc-dc server through this proxy; it dials the server\n"
   "over WebRTC-Direct and maps every call onto the existing\n"
   "grpc-dc server interface. gRPC compression is terminated\n"
   "in the proxy; the DataChannel wire is uncompressed.\n\n"
   "## Modes\n\n"
   "| Mode | Backend | Status | Implementation | Notes |\n"
   "|---|---|---|---|---|\n"
   (mode-rows) "\n\n"
   "## Client surfaces\n\n"
   (client-rows) "\n\n"
   "## Run (ingress-first)\n\n"
   "Server side — a grpc-dc server on WebRTC-Direct (the Echo\n"
   "demo agent; real deployments serve their own service the\n"
   "same way). It prints its certhash multiaddr:\n\n"
   "    node proxy/grpc-dc-agent.mjs --port 4001\n\n"
   "Proxy — HTTP/2 over TCP ingress in front of that server:\n\n"
   "    node proxy/grpc-dc-proxy.mjs --dc-dial <multiaddr> --http2 50051\n\n"
   "- `--dc-dial` — WebRTC-Direct multiaddr of the server\n"
   "  (no signaling server; the proxy is the direct dialer).\n"
   "- `--http2` — stock HTTP/2 gRPC clients call here:\n"
   "  plaintext h2c, or TLS with `--tls-cert/--tls-key`.\n"
   "  Scope is exactly the official gRPC transport set\n"
   "  (grpc-java and peers): HTTP/2 over TCP. No HTTP/3,\n"
   "  no custom framed-TCP ingress.\n\n"
   "## Test\n\n"
   "    node --test proxy/proxy.test.mjs     # or: make test-proxy\n\n"
   "Starts the Echo agent on WebRTC-Direct and drives a stock\n"
   "HTTP/2 client through the proxy:\n"
   "unary, server-streaming, and an INVALID_ARGUMENT case.\n"
   "The test also checks this spec's mode table against the\n"
   "implementation (parity).\n\n"
   "## Rust proxy (homegrown HTTP/2)\n\n"
   "The Rust runtime carries a generated, dependency-free\n"
   "HTTP/2 + HPACK stack (`grpc_dc::http2`); the example\n"
   "binary speaks it in both directions (h2c only):\n\n"
   "    # direction 1: stock client -> grpc-dc server\n"
   "    cargo run --features webrtc --example grpc_dc_proxy -- --dc-dial <multiaddr> --http2 50051\n"
   "    # direction 2: grpc-dc client -> stock backend\n"
   "    cargo run --features webrtc --example grpc_dc_proxy -- --dc-listen 4001 --http2-dial 127.0.0.1:50051\n\n"
   "    node --test proxy/rust_proxy.test.mjs   # also in make test-proxy\n\n"
   "Drives the Rust proxy in both directions against stock\n"
   "Node HTTP/2 peers and the grpc-java oracle (client and\n"
   "server), including the gzip-compressed oracle client.\n\n"
))

(define (generate-proxy)
  (make-directory* (build-path root "proxy"))
  (call-with-output-file (build-path root "proxy" "proxy_modes.generated.json")
    #:exists 'replace
    (lambda (out) (display (modes-json-text) out)))
  (printf "generated proxy/proxy_modes.generated.json\n")
  (call-with-output-file (build-path root "proxy" "README.md")
    #:exists 'replace
    (lambda (out) (display (readme-text) out)))
  (printf "generated proxy/README.md\n"))
