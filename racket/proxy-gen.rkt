#lang racket

;;; proxy-gen.rkt — stamps proxy-spec.rkt into the generated
;;; proxy artifacts: proxy_modes.generated.json (parity data
;;; for proxy/proxy.test.mjs) and proxy/README.md (the
;;; supported-proxy document). Invoked from metagen.rkt so
;;; `make generate` regenerates everything in one pass.
;;; The proxy kernels (Node bridge, Rust sidecars) are
;;; hand-written; this generated surface around them —
;;; mode table, client notes, run docs — cannot drift.

(require "proxy-spec.rkt" json racket/runtime-path)
(provide generate-proxy)

(define-runtime-path here ".")
(define root (build-path here ".."))

(define (mode-json mode)
  (hasheq 'id (symbol->string (first mode))
          'title (second mode)
          'status (symbol->string (third mode))
          'implementation (fourth mode)
          'note (fifth mode)))

(define (modes-json-text)
  (with-output-to-string
    (lambda ()
      (write-json
       (hasheq 'modes (map mode-json proxy-mode-table)
               'clients
               (map (lambda (c)
                      (hasheq 'surface (symbol->string (first c))
                              'title (second c)
                              'note (third c)))
                    proxy-client-notes)))
      (newline))))

(define (mode-rows)
  (string-join
   (for/list ([mode (in-list proxy-mode-table)])
     (string-append "| `" (symbol->string (first mode)) "` | "
                    (second mode) " | " (symbol->string (third mode))
                    " | " (fourth mode) " | " (fifth mode) " |"))
   "\n"))

(define (client-rows)
  (string-join
   (for/list ([c (in-list proxy-client-notes)])
     (string-append "- **" (second c) "** — " (third c) "."))
   "\n"))

(define (readme-text)
  (string-append
   "# grpc-dc-proxy\n\n"
   "<!-- @generated by grpc-dc codegen. DO NOT EDIT. -->\n\n"
   "A supported TCP <-> DataChannel proxy. grpc-dc clients\n"
   "(browser tabs, native peers) connect over WebRTC\n"
   "DataChannels; calls are bridged to real backends, so\n"
   "unmodified backend servers become reachable from a browser\n"
   "with no grpc-web proxy in the page path and no backend\n"
   "changes. gRPC compression is terminated in the proxy; the\n"
   "DataChannel wire is always uncompressed.\n\n"
   "## Modes\n\n"
   "| Mode | Backend | Status | Implementation | Notes |\n"
   "|---|---|---|---|---|\n"
   (mode-rows) "\n\n"
   "## Client surfaces\n\n"
   (client-rows) "\n\n"
   "## Run (HTTP/2 bridge)\n\n"
   "    node proxy/grpc-dc-proxy.mjs --backend 127.0.0.1:50051 [--port 8090]\n\n"
   "- `--backend host:port` — the stock HTTP/2 gRPC server (h2c).\n"
   "- Clients signal through `ws://<proxy>/` with the starter\n"
   "  offer/answer exchange (`{kind:\"offer\",sdp}` ->\n"
   "  `{kind:\"answer\",sdp}`), then open the `grpc` DataChannel.\n"
   "- `GET /healthz` returns `ok`.\n"
   "- For remote browsers, put the proxy behind any HTTPS\n"
   "  tunnel (e.g. `cloudflared tunnel --url http://localhost:8090`);\n"
   "  pages must then use `wss://`.\n\n"
   "## Test\n\n"
   "    node --test proxy/proxy.test.mjs     # or: make test-proxy\n\n"
   "Spins up a minimal HTTP/2 Echo backend and drives a\n"
   "generated JS client over a real DataChannel through the\n"
   "proxy: unary, server-streaming, and an INVALID_ARGUMENT\n"
   "trailers-only case. The test also checks this spec's mode\n"
   "table against the implementation (parity).\n\n"
   "## Sidecar spikes\n\n"
   "- `proxy/tcp-sidecar/` — smoltcp userspace TCP proof\n"
   "  (`cargo test` in that crate; zero OS sockets).\n"
   "- `proxy/h3-terminator/` — QUIC termination proof\n"
   "  (`cargo test` in that crate; quinn, self-signed).\n\n"
   "Both are standalone spikes today: packet/stream transport\n"
   "is transport-agnostic, and carrying it over DataChannels\n"
   "into the release gate is the follow-up.\n"))

(define (generate-proxy)
  (make-directory* (build-path root "proxy"))
  (call-with-output-file (build-path root "proxy" "proxy_modes.generated.json")
    #:exists 'replace
    (lambda (out) (display (modes-json-text) out)))
  (printf "generated proxy/proxy_modes.generated.json\n")
  (call-with-output-file (build-path root "proxy" "README.md")
    #:exists 'replace
    (lambda (out) (display (readme-text) out)))
  (printf "generated proxy/README.md\n"))
