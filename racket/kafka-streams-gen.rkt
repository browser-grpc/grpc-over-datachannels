#lang racket

;;; kafka-streams-gen.rkt — stamps kafka-streams-spec.rkt's
;;; scenario table as data literals for the JS and Python
;;; streams suites.

(require "kafka-streams-spec.rkt")
(provide emit-js-kafka-streams emit-python-kafka-streams)

(define (op-name sym)
  (string-upcase (string-replace (symbol->string sym) "-" "_")))

(define (scenario-json s)
  (define-values (name _title steps produce expect) (apply values s))
  (define chain
    (string-join
     (for/list ([st (in-list steps)])
       (format "{\"operator\": \"~a\", \"param\": \"~a\", \"aggregator\": ~a}"
               (op-name (first st)) (second st) (third st)))
     ", "))
  (define lines
    (string-join
     (for/list ([l (in-list (first produce))]) (format "~s" l))
     ", "))
  (define (pairs which)
    (define entry (assoc which expect))
    (if entry
        (string-join
         (for/list ([kv (in-list (second entry))])
           (format "[~s, ~a]" (car kv) (cdr kv)))
         ", ")
        ""))
  (format "  {\"name\": \"~a\", \"chain\": [~a], \"lines\": [~a], \"store\": {~a}, \"sink\": {~a}}"
          name chain lines
          (string-join
           (for/list ([kv (in-list (second (assoc 'store expect)))])
             (format "~s: ~a" (car kv) (cdr kv)))
           ", ")
          (string-join
           (for/list ([kv (in-list (second (assoc 'sink expect)))])
             (format "~s: ~s" (car kv) (cdr kv)))
           ", ")))

(define (emit-js-kafka-streams)
  (cons "kafka_streams_scenarios.generated.js"
        (string-append
         "// @generated by kafka-streams-gen.rkt. DO NOT EDIT.\n"
         "export const KAFKA_STREAMS_SCENARIOS = [\n"
         (string-join (map scenario-json kafka-streams-scenarios) ",\n")
         "\n];\n")))

(define (emit-python-kafka-streams)
  (define (py-scenario s)
    (define-values (name _title steps produce expect) (apply values s))
    (define chain
      (string-join
       (for/list ([st (in-list steps)])
         (format "(\"~a\", \"~a\", ~a)" (op-name (first st)) (second st) (third st)))
       ", "))
    (format "    {\"name\": \"~a\", \"chain\": [~a], \"lines\": [~a], \"store\": {~a}, \"sink\": {~a}},"
            name chain
            (string-join (for/list ([l (in-list (first produce))]) (format "~s" l)) ", ")
            (string-join
             (for/list ([kv (in-list (second (assoc 'store expect)))])
               (format "~s: ~a" (car kv) (cdr kv)))
             ", ")
            (string-join
             (for/list ([kv (in-list (second (assoc 'sink expect)))])
               (format "~s: ~s" (car kv) (cdr kv)))
             ", ")))
  (cons "kafka_streams_scenarios_generated.py"
        (string-append
         "# @generated by kafka-streams-gen.rkt. DO NOT EDIT.\n"
         "KAFKA_STREAMS_SCENARIOS = [\n"
         (string-join (map py-scenario kafka-streams-scenarios) "\n")
         "\n]\n")))
