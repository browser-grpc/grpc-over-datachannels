#lang racket/base
;; Generates the WebRTC-Direct examples: native stack examples for
;; Go and Rust, sidecar client/server examples for every other
;; language, and the examples/direct compose wiring. Run from the
;; repo root (the Makefile `generate` target does). Generated files
;; carry a DO NOT EDIT header; change this file and regenerate.
;;
;; Modes covered, honestly scoped:
;;   direct  -- UDP dial of the listener's certhash multiaddr.
;;   turn    -- same dial through a TURN allocation (client-side).
;;   stun    -- full-ICE peer mode (Go/Rust peer examples) where
;;              STUN discovers server-reflexive candidates; a Direct
;;              listener itself gathers no ICE candidates.
;; Browsers cannot dial multiaddrs (no UDP); see examples/direct.

(require racket/file
         racket/list
         racket/string)

(define files '())
(define (emit path content)
  (set! files
        (cons (cons path
                    (if (string-suffix? content "\n")
                        content
                        (string-append content "\n")))
              files)))

(define header-line
  (list "@generated by grpc-dc codegen. DO NOT EDIT."
        "SPDX-License-Identifier: Apache-2.0"))

(define (with-header comment-prefix lines body)
  (string-join
   (append (map (lambda (h) (string-append comment-prefix " " h)) header-line)
           (map (lambda (l) (if (string=? l "") comment-prefix
                                (string-append comment-prefix " " l))) lines)
           (list body))
   "\n"))

(define (with-php-header lines body)
  (string-append "<?php\n"
                 (with-header "//" lines
                              (if (string-prefix? body "<?php\n")
                                  (substring body 6)
                                  body))))

;; ---------------------------------------------------------------- Go
(emit
 "go/examples/direct_echo/main.go"
 (with-header
  "//"
  '("WebRTC-Direct Echo example (Go, generated runtime + Go WebRTC stack)."
    ""
    "cd go && go run ./examples/direct_echo serve"
    "cd go && go run ./examples/direct_echo dial '/ip4/.../webrtc-direct/certhash/f...'"
    ""
    "dial through TURN (symmetric NAT; the server never changes):"
    "DIRECT_TURN=host:3478 DIRECT_TURN_USER=u DIRECT_TURN_PASS=p \\"
    "go run ./examples/direct_echo dial '/ip4/...'"
    ""
    "Full-ICE peer mode (this is where STUN belongs; SDP is exchanged"
    "through files in GRPC_DC_SIGNAL_DIR, default /tmp/grpc-dc-signal):"
    "GRPC_DC_STUN=stun.l.google.com:19302 go run ./examples/direct_echo peer-serve"
    "GRPC_DC_STUN=stun.l.google.com:19302 go run ./examples/direct_echo peer-dial"
    "Add DIRECT_TURN* in peer mode for a TURN relay candidate as well.")
  #<<GOEOF
package main

import (
	"context"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"
	"time"

	grpcdc "github.com/browser-grpc/grpc-over-datachannels/go"
	echo "github.com/browser-grpc/grpc-over-datachannels/go/examples"
	dcwebrtc "github.com/browser-grpc/grpc-over-datachannels/webrtc/go"
)

func turnFromEnv() (dcwebrtc.TurnServerConfig, bool) {
	addr := os.Getenv("DIRECT_TURN")
	if addr == "" {
		return dcwebrtc.TurnServerConfig{}, false
	}
	return dcwebrtc.TurnServerConfig{
		Address:  addr,
		Username: os.Getenv("DIRECT_TURN_USER"),
		Password: os.Getenv("DIRECT_TURN_PASS"),
	}, true
}

func runCalls(client *echo.EchoClient) error {
	ctx := context.Background()
	unary, err := client.Unary(ctx, &echo.EchoRequest{Message: "hello direct"})
	if err != nil {
		return err
	}
	fmt.Printf("unary -> %s\n", unary.Message)
	stream, err := client.ServerStream(ctx, &echo.EchoRequest{Message: "tick", Count: 3})
	if err != nil {
		return err
	}
	parts := []string{}
	for {
		resp, err := stream.Recv()
		if err == io.EOF {
			break
		}
		if err != nil {
			return err
		}
		parts = append(parts, fmt.Sprintf("%s#%d", resp.Message, resp.Index))
	}
	fmt.Printf("serverStream -> %s\n", strings.Join(parts, " "))
	fmt.Println("direct-echo OK")
	return nil
}

func serve() error {
	addr := os.Getenv("DIRECT_ADDR")
	if addr == "" {
		addr = "127.0.0.1:0"
	}
	listener, err := grpcdc.DirectListener(addr)
	if err != nil {
		return err
	}
	defer listener.Close()
	fmt.Printf("MULTIADDR %s\n", listener.Multiaddr())
	server := grpcdc.NewServer()
	echo.RegisterEchoServer(server, echo.EchoService{})
	for {
		transport, err := grpcdc.AcceptDirectTransport(listener)
		if err != nil {
			return err
		}
		go server.ServeTransport(transport)
	}
}

func dial(multiaddr string) error {
	var transport *grpcdc.DcTransport
	var err error
	if turn, ok := turnFromEnv(); ok {
		fmt.Printf("mode: turn (allocation via %s)\n", turn.Address)
		transport, err = grpcdc.DirectClientTurnTransport(multiaddr, turn)
	} else {
		fmt.Println("mode: direct (no TURN)")
		transport, err = grpcdc.DirectClientTransport(multiaddr)
	}
	if err != nil {
		return err
	}
	return runCalls(echo.NewEchoClient(grpcdc.NewChannel(transport)))
}

func signalDir() string {
	if d := os.Getenv("GRPC_DC_SIGNAL_DIR"); d != "" {
		return d
	}
	return "/tmp/grpc-dc-signal"
}

func writeSignal(name, content string) error {
	dir := signalDir()
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return err
	}
	return os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644)
}

func readSignal(name string) (string, error) {
	path := filepath.Join(signalDir(), name)
	deadline := time.Now().Add(60 * time.Second)
	for time.Now().Before(deadline) {
		data, err := os.ReadFile(path)
		if err == nil && len(data) > 0 {
			return string(data), nil
		}
		time.Sleep(200 * time.Millisecond)
	}
	return "", fmt.Errorf("timed out waiting for %s", path)
}

func peerOptions() dcwebrtc.PeerOptions {
	opts := dcwebrtc.PeerOptions{}
	if stun := os.Getenv("GRPC_DC_STUN"); stun != "" {
		opts.StunServers = strings.Split(stun, ",")
	}
	if turn, ok := turnFromEnv(); ok {
		opts.TurnServers = []dcwebrtc.TurnServerConfig{turn}
	}
	return opts
}

func peerServe() error {
	peer, err := dcwebrtc.NewPeer(peerOptions())
	if err != nil {
		return err
	}
	defer peer.Close()
	offer, err := readSignal("offer.sdp")
	if err != nil {
		return err
	}
	answer, err := peer.HandleOffer(offer)
	if err != nil {
		return err
	}
	if err := writeSignal("answer.sdp", answer); err != nil {
		return err
	}
	fmt.Println("peer-serve: answer written, connecting")
	server := grpcdc.NewServer()
	echo.RegisterEchoServer(server, echo.EchoService{})
	endpoint, err := peer.ConnectWithOptions(true)
	if err != nil {
		return err
	}
	endpoint.SetOnChannel(func(channel *dcwebrtc.DataChannel) {
		server.ServeTransport(grpcdc.NewDcTransport(channel))
	})
	fmt.Println("peer-serve: connected, serving Echo")
	select {}
}

func peerDial() error {
	peer, err := dcwebrtc.NewPeer(peerOptions())
	if err != nil {
		return err
	}
	defer peer.Close()
	if err := writeSignal("offer.sdp", peer.CreateOffer()); err != nil {
		return err
	}
	answer, err := readSignal("answer.sdp")
	if err != nil {
		return err
	}
	if err := peer.HandleAnswer(answer); err != nil {
		return err
	}
	endpoint, err := peer.ConnectWithOptions(true)
	if err != nil {
		return err
	}
	channel := endpoint.OpenChannel(dcwebrtc.DefaultChannelParams("grpc"))
	client := echo.NewEchoClient(grpcdc.NewChannel(grpcdc.NewDcTransport(channel)))
	return runCalls(client)
}

func main() {
	var err error
	mode := "dial"
	if len(os.Args) > 1 {
		mode = os.Args[1]
	}
	switch mode {
	case "serve":
		err = serve()
	case "dial":
		addr := ""
		if len(os.Args) > 2 {
			addr = os.Args[2]
		} else {
			addr = os.Getenv("GRPC_DC_ADDR")
		}
		if addr == "" {
			fmt.Fprintln(os.Stderr, "usage: direct_echo dial <multiaddr> (or GRPC_DC_ADDR)")
			os.Exit(2)
		}
		err = dial(addr)
	case "peer-serve":
		err = peerServe()
	case "peer-dial":
		err = peerDial()
	default:
		fmt.Fprintf(os.Stderr, "unknown mode %q (serve|dial|peer-serve|peer-dial)\n", mode)
		os.Exit(2)
	}
	if err != nil {
		fmt.Fprintln(os.Stderr, "direct_echo:", err)
		os.Exit(1)
	}
}
GOEOF
  ))

;; -------------------------------------------------------------- Rust
(emit
 "rust/examples/direct_echo.rs"
 (with-header
  "//!"
  '("WebRTC-Direct Echo example (Rust, generated runtime + Rust stack)."
    ""
    "  cargo run --features webrtc --example direct_echo -- serve"
    "  cargo run --features webrtc --example direct_echo -- dial '/ip4/...'"
    ""
    "Through TURN: DIRECT_TURN=host:3478 DIRECT_TURN_USER=u \\"
    "  DIRECT_TURN_PASS=p ... -- dial '/ip4/...'"
    ""
    "Full-ICE peer mode (STUN belongs here; SDP via files in"
    "GRPC_DC_SIGNAL_DIR, default /tmp/grpc-dc-signal):"
    "  GRPC_DC_STUN=stun.l.google.com:19302 ... -- peer-serve"
    "  GRPC_DC_STUN=stun.l.google.com:19302 ... -- peer-dial")
  #<<RSEOF
#[path = "../gen/echo_pb.rs"]
mod pb;

#[path = "echo_demo/pb_message_impl.rs"]
mod pb_message_impl;

#[path = "../gen/echo_grpc_dc.rs"]
mod stub;

use futures_util::StreamExt;
use grpc_dc::webrtc_direct::{
    accept_direct_transport, direct_client, direct_client_turn, direct_listener,
    TurnServerConfig,
};
use grpc_dc::{CallCtx, Channel, RequestStream, ResponseStream, Server, Status};
use std::net::SocketAddr;
use std::sync::Arc;
use stub::{echo_service, Echo, EchoClient};

struct EchoService;

#[grpc_dc::async_trait]
impl Echo for EchoService {
    async fn unary(&self, req: pb::EchoRequest, _ctx: CallCtx) -> Result<pb::EchoResponse, Status> {
        Ok(pb::EchoResponse { message: format!("echo: {}", req.message), index: 0, ..Default::default() })
    }
    async fn server_stream(
        &self,
        req: pb::EchoRequest,
        _ctx: CallCtx,
    ) -> Result<ResponseStream<pb::EchoResponse>, Status> {
        let responses = (0..req.count.max(0))
            .map(move |i| Ok(pb::EchoResponse { message: req.message.clone(), index: i, ..Default::default() }));
        Ok(Box::pin(futures_util::stream::iter(responses)))
    }
    async fn client_stream(
        &self,
        mut reqs: RequestStream<pb::EchoRequest>,
        _ctx: CallCtx,
    ) -> Result<pb::EchoResponse, Status> {
        let mut parts = Vec::new();
        while let Some(req) = reqs.next().await {
            parts.push(req?.message);
        }
        Ok(pb::EchoResponse { message: parts.join("+"), index: parts.len() as i32, ..Default::default() })
    }
    async fn bidi(
        &self,
        reqs: RequestStream<pb::EchoRequest>,
        _ctx: CallCtx,
    ) -> Result<ResponseStream<pb::EchoResponse>, Status> {
        let stream = futures_util::stream::unfold((reqs, 0i32), |(mut reqs, mut i)| async move {
            match reqs.next().await {
                Some(Ok(req)) => {
                    let r = pb::EchoResponse { message: req.message, index: i, ..Default::default() };
                    i += 1;
                    Some((Ok(r), (reqs, i)))
                }
                Some(Err(e)) => Some((Err(e), (reqs, i))),
                None => None,
            }
        });
        Ok(Box::pin(stream))
    }
}

fn req(message: &str, count: i32) -> pb::EchoRequest {
    pb::EchoRequest { message: message.into(), count, delay_ms: 0, ..Default::default() }
}

fn turn_from_env() -> Option<TurnServerConfig> {
    let addr = std::env::var("DIRECT_TURN").ok()?;
    if addr.is_empty() {
        return None;
    }
    Some(TurnServerConfig::new(
        &addr,
        &std::env::var("DIRECT_TURN_USER").unwrap_or_default(),
        &std::env::var("DIRECT_TURN_PASS").unwrap_or_default(),
    ))
}

async fn run_calls(client: EchoClient) -> Result<(), Box<dyn std::error::Error>> {
    let unary = client.unary(req("hello direct", 0)).await?;
    println!("unary -> {}", unary.message);
    let mut stream = client.server_stream(req("tick", 3)).await?;
    let mut parts = Vec::new();
    while let Some(item) = stream.next().await {
        let resp = item?;
        parts.push(format!("{}#{}", resp.message, resp.index));
    }
    println!("serverStream -> {}", parts.join(" "));
    println!("direct-echo OK");
    Ok(())
}

async fn serve() -> Result<(), Box<dyn std::error::Error>> {
    let addr: SocketAddr = std::env::var("DIRECT_ADDR")
        .unwrap_or_else(|_| "127.0.0.1:0".into())
        .parse()?;
    let listener = Arc::new(direct_listener(addr)?);
    println!("MULTIADDR {}", listener.multiaddr());
    loop {
        let transport = accept_direct_transport(listener.clone()).await?;
        tokio::spawn(async move {
            Server::serve(transport, vec![echo_service(Arc::new(EchoService))]).await;
        });
    }
}

async fn dial(multiaddr: &str) -> Result<(), Box<dyn std::error::Error>> {
    let transport = if let Some(turn) = turn_from_env() {
        println!("mode: turn (allocation via {})", turn.address);
        direct_client_turn(multiaddr, &turn).await?
    } else {
        println!("mode: direct (no TURN)");
        direct_client(multiaddr).await?
    };
    run_calls(EchoClient::new(Channel::new(transport))).await
}

fn signal_dir() -> std::path::PathBuf {
    std::env::var("GRPC_DC_SIGNAL_DIR")
        .map(Into::into)
        .unwrap_or_else(|_| "/tmp/grpc-dc-signal".into())
}

fn write_signal(name: &str, content: &str) -> std::io::Result<()> {
    let dir = signal_dir();
    std::fs::create_dir_all(&dir)?;
    std::fs::write(dir.join(name), content)
}

fn read_signal(name: &str) -> Result<String, Box<dyn std::error::Error>> {
    let path = signal_dir().join(name);
    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(60);
    loop {
        if let Ok(s) = std::fs::read_to_string(&path) {
            if !s.is_empty() {
                return Ok(s);
            }
        }
        if std::time::Instant::now() > deadline {
            return Err(format!("timed out waiting for {}", path.display()).into());
        }
        std::thread::sleep(std::time::Duration::from_millis(200));
    }
}

fn peer_config() -> dc_webrtc::peer::PeerConfig {
    let mut config = dc_webrtc::peer::PeerConfig::default();
    if let Ok(stun) = std::env::var("GRPC_DC_STUN") {
        if !stun.is_empty() {
            config.stun_servers = stun.split(',').map(|s| s.to_string()).collect();
        }
    }
    if let Some(turn) = turn_from_env() {
        config.turn_servers = vec![turn];
    }
    config
}

async fn serve_endpoint(endpoint: dc_webrtc::endpoint::DcEndpoint) {
    let endpoint = Arc::new(endpoint);
    let ep = endpoint.clone();
    let channel = tokio::task::spawn_blocking(move || loop {
        match ep.recv_event_timeout(std::time::Duration::from_secs(30)) {
            Some(dc_webrtc::endpoint::EndpointEvent::ChannelOpened { channel }) => {
                break Ok::<_, Status>(channel)
            }
            Some(_) => continue,
            None => break Err(Status::unavailable("peer: no channel")),
        }
    })
    .await
    .expect("join")
    .expect("channel");
    let transport: Arc<dyn grpc_dc::transport::DcTransport> =
        Arc::new(grpc_dc::webrtc_transport::WebRtcDc::new(endpoint, channel));
    Server::serve(transport, vec![echo_service(Arc::new(EchoService))]).await;
}

async fn peer_serve() -> Result<(), Box<dyn std::error::Error>> {
    let mut peer = dc_webrtc::peer::Peer::new(peer_config())?;
    let offer = read_signal("offer.sdp")?;
    let answer = peer.handle_offer(&offer)?;
    write_signal("answer.sdp", &answer)?;
    println!("peer-serve: answer written, connecting");
    let endpoint = peer.connect()?;
    println!("peer-serve: connected, serving Echo");
    serve_endpoint(endpoint).await;
    Ok(())
}

async fn peer_dial() -> Result<(), Box<dyn std::error::Error>> {
    let mut peer = dc_webrtc::peer::Peer::new(peer_config())?;
    write_signal("offer.sdp", &peer.create_offer())?;
    let answer = read_signal("answer.sdp")?;
    peer.handle_answer(&answer)?;
    let endpoint = Arc::new(peer.connect()?);
    let channel = endpoint.open_channel(dc_webrtc::dcep::ChannelParams {
        label: "grpc".into(),
        ..Default::default()
    })?;
    let transport: Arc<dyn grpc_dc::transport::DcTransport> =
        Arc::new(grpc_dc::webrtc_transport::WebRtcDc::new(endpoint, channel));
    run_calls(EchoClient::new(Channel::new(transport))).await
}

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    let args: Vec<String> = std::env::args().collect();
    let mode = args.get(1).map(|s| s.as_str()).unwrap_or("dial");
    match mode {
        "serve" => serve().await,
        "dial" => {
            let addr = args
                .get(2)
                .cloned()
                .or_else(|| std::env::var("GRPC_DC_ADDR").ok())
                .unwrap_or_default();
            if addr.is_empty() {
                eprintln!("usage: direct_echo dial <multiaddr> (or GRPC_DC_ADDR)");
                std::process::exit(2);
            }
            dial(&addr).await
        }
        "peer-serve" => peer_serve().await,
        "peer-dial" => peer_dial().await,
        other => {
            eprintln!("unknown mode {other:?} (serve|dial|peer-serve|peer-dial)");
            std::process::exit(2);
        }
    }
}

RSEOF
  ))

;; ------------------------------------------------- sidecar languages
;; One file per language with serve/dial modes. serve binds a local
;; TCP port and serves Echo over the sidecar bridge; dial connects
;; to a dial-sidecar's TCP port. The two sidecar commands (listen /
;; dial, plus --turn forms) are in each file's header.

(define sidecar-note
  '("WebRTC-Direct via the Rust sidecar: this language has no embedded"
    "WebRTC stack, so direct_sidecar owns DTLS/SCTP/TURN and bridges a"
    "local TCP socket to the DataChannel; this code only sees the"
    "generated gRPC runtime over SidecarTransport."
    ""
    "Server side (prints the multiaddr to hand to clients):"
    "  direct_sidecar listen --udp 0.0.0.0:4001 --tcp 127.0.0.1:50061"
    "  <this example> serve 50061"
    "Client side:"
    "  direct_sidecar dial --multiaddr '/ip4/...' --tcp 127.0.0.1:50062"
    "  <this example> dial 127.0.0.1:50062"
    "TURN: add --turn host:3478 --turn-user u --turn-pass p to the dial"
    "sidecar command. The language code is identical either way."))

(emit
 "ruby/examples/direct_echo.rb"
 (with-header "#" sidecar-note
  #<<RBEOF
root = File.expand_path("../..", __dir__)
$LOAD_PATH.unshift(File.join(root, "ruby"))
$LOAD_PATH.unshift(File.join(root, "ruby", "examples"))

require "grpcdc"
require "socket"
require "echo_grpc_dc"
require "echo_pb"
require "echo_service"

mode = ARGV[0]
case mode
when "serve"
  port = Integer(ARGV[1] || "50061")
  server_sock = TCPServer.new("127.0.0.1", port)
  server = Grpcdc::Server.new
  EchoGrpcDc.register_echo_server(server, EchoService.new)
  sock = server_sock.accept
  server.serve_transport(Grpcdc::SidecarTransport.from_socket(sock))
  sleep
when "dial"
  host, _, port = (ARGV[1] || "127.0.0.1:50062").rpartition(":")
  client = EchoGrpcDc::EchoClient.new(
    Grpcdc::Channel.new(Grpcdc::SidecarTransport.connect(host, Integer(port)))
  )
  unary = client.Unary(EchoPb::EchoRequest.new(message: "hello direct", count: 0))
  puts "unary -> #{unary.message}"
  parts = client.ServerStream(EchoPb::EchoRequest.new(message: "tick", count: 3)).to_a
          .map { |r| "#{r.message}##{r.index}" }
  puts "serverStream -> #{parts.join(' ')}"
  puts "direct-echo OK"
else
  warn "usage: direct_echo.rb serve <port> | dial <host:port>"
  exit 2
end
RBEOF
  ))

(emit
 "php/examples/direct_echo.php"
 (with-php-header sidecar-note
  #<<PHPEOF
<?php
// Run: php php/examples/direct_echo.php serve 50061
//      php php/examples/direct_echo.php dial 127.0.0.1:50062

require_once dirname(__DIR__) . "/grpcdc.php";
require_once __DIR__ . "/echo_grpc_dc.php";
require_once __DIR__ . "/echo_pb.php";
require_once __DIR__ . "/echo_service.php";

$mode = $argv[1] ?? "";
if ($mode === "serve") {
    $port = (int) ($argv[2] ?? 50061);
    $listener = stream_socket_server("tcp://127.0.0.1:{$port}");
    $conn = stream_socket_accept($listener);
    $server = new \Grpcdc\Server();
    \EchoGrpcDc\registerEchoServer($server, new EchoService());
    $endpoint = $server->serveTransport(new \Grpcdc\SidecarTransport($conn));
    $server->serveForever($endpoint);
} elseif ($mode === "dial") {
    [$host, $port] = explode(":", $argv[2] ?? "127.0.0.1:50062") + [1 => "50062"];
    $client = new \EchoGrpcDc\EchoClient(
        new \Grpcdc\Channel(\Grpcdc\SidecarTransport::connect($host, (int) $port))
    );
    $unary = $client->Unary(new \EchoPb\EchoRequest("hello direct", 0));
    echo "unary -> {$unary->message}\n";
    $parts = [];
    foreach ($client->ServerStream(new \EchoPb\EchoRequest("tick", 3))->iterate() as $r) {
        $parts[] = "{$r->message}#{$r->index}";
    }
    echo "serverStream -> " . implode(" ", $parts) . "\n";
    echo "direct-echo OK\n";
} else {
    fwrite(STDERR, "usage: direct_echo.php serve <port> | dial <host:port>\n");
    exit(2);
}
PHPEOF
  ))

(emit
