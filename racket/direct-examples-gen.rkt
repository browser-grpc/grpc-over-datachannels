func parseAddr(_ addr: String) -> (String, Int) {
    let parts = addr.split(separator: ":", maxSplits: 1)
    return (String(parts[0]), Int(parts[1]) ?? 50062)
}

let args = CommandLine.arguments
let mode = args.count > 1 ? args[1] : ""
if mode == "serve" {
    let port = args.count > 2 ? Int(args[2]) ?? 50061 : 50061
    var listenFd: Int32 = -1
