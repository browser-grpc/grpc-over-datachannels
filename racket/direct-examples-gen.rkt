const std = @import("std");
const grpcdc = @import("grpcdc");
const examples = @import("examples");

const Channel = grpcdc.channel.Channel;
const Server = grpcdc.server.Server;
const EchoRequest = examples.echo_messages.EchoRequest;

fn req(message: []const u8, count: i32) EchoRequest {
    return .{ .message = message, .count = count };
}

fn serve(alloc: std.mem.Allocator, port: u16) void {
    var server = Server.init(alloc);
    defer server.deinit();
    examples.echo_grpc_dc.EchoGrpcDc.registerEchoServer(&server, &examples.echo_service_impl.echo_server_impl);
    const addr = std.net.Address.parseIp4("127.0.0.1", port) catch unreachable;
    var listener = addr.listen(.{ .reuse_address = true }) catch unreachable;
    defer listener.deinit();
    const conn = listener.accept() catch return;
    var sidecar: grpcdc.sidecar_transport.SidecarTransport = .{ .stream = conn.stream };
    _ = server.serveTransport(sidecar.transport());
    while (true) std.Thread.sleep(3_600_000_000_000);
}

fn dial(alloc: std.mem.Allocator, addr_text: []const u8) void {
    const colon = std.mem.lastIndexOfScalar(u8, addr_text, ':').?;
    const host = addr_text[0..colon];
    const port = std.fmt.parseInt(u16, addr_text[colon + 1 ..], 10) catch unreachable;
    const transport = grpcdc.sidecar_transport.SidecarTransport.connect(alloc, host, port) catch unreachable;
    var channel = Channel.init(alloc, transport.transport());
    defer channel.deinit();
    var client = examples.echo_grpc_dc.EchoClient.init(&channel);

    const unary = switch (client.unary(&req("hello direct", 0), null, null)) {
        .ok => |r| r,
        .status => |st| {
            std.debug.print("unary status {d} {s}\n", .{ st.code, st.message });
            std.process.exit(1);
        },
    };
    std.debug.print("unary -> {s}\n", .{unary.message});

    var stream = switch (client.serverStream(&req("tick", 3), null, null)) {
        .ok => |s| s,
        .status => |st| {
            std.debug.print("serverStream status {d}\n", .{st.code});
            std.process.exit(1);
        },
    };
    defer stream.deinit();
    var first = true;
    std.debug.print("serverStream ->", .{});
    while (true) {
        switch (stream.recv()) {
            .message => |resp| {
                std.debug.print("{s}{s}#{d}", .{ if (first) " " else " ", resp.message, resp.index });
                first = false;
            },
            .end => break,
            .status => break,
        }
    }
    std.debug.print("\ndirect-echo OK\n", .{});
    std.process.exit(0);
}

pub fn main() void {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    const alloc = arena.allocator();
    const args = std.process.argsAlloc(alloc) catch unreachable;
    const mode = if (args.len > 1) args[1] else "";
    if (std.mem.eql(u8, mode, "serve")) {
        const port = if (args.len > 2) std.fmt.parseInt(u16, args[2], 10) catch 50061 else 50061;
        serve(alloc, port);
    } else if (std.mem.eql(u8, mode, "dial")) {
        dial(alloc, if (args.len > 2) args[2] else "127.0.0.1:50062");
    } else {
        std.debug.print("usage: direct_echo serve <port> | dial <host:port>\n", .{});
        std.process.exit(2);
    }
}
ZIGEOF
  ))

(emit
 "examples/direct/python_server.py"
 (with-header "#"
  '("WebRTC-Direct Echo server in Python via the Rust sidecar"
    "(companion to python_client.py; see README.md in this directory)."
    ""
    "  direct_sidecar listen --udp 0.0.0.0:4001 --tcp 127.0.0.1:50061"
    "  python3 examples/direct/python_server.py 50061"
    ""
    "The sidecar prints MULTIADDR ...; hand that line to any client.")
  #<<PYEOF
import socket
import sys
import time

sys.path.insert(0, "python")
sys.path.insert(0, "python/examples")

import grpcdc  # noqa: E402
import echo_grpc_dc  # noqa: E402
import echo_service  # noqa: E402


def main() -> int:
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 50061
    listen_sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    listen_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listen_sock.bind(("127.0.0.1", port))
    listen_sock.listen(4)
    server = grpcdc.Server()
    echo_grpc_dc.register_echo_server(server, echo_service.EchoService())
    conn, _ = listen_sock.accept()
    server.serve_transport(grpcdc.SidecarTransport.from_socket(conn))
    while True:
        time.sleep(3600)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PYEOF
  ))

