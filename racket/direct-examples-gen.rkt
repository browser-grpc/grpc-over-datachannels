#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <arpa/inet.h>
#include <sys/socket.h>
#include <unistd.h>

#include "echo_grpc_dc.h"
#include "echo_messages.h"
#include "echo_service_impl.h"
#include "grpcdc/sidecar_transport.h"

static int fail(const char *what, grpcdc_status st) {
    fprintf(stderr, "%s status: %d %s\n", what, st.code, st.message);
    return 1;
}

static int serve(int port) {
    int listen_fd = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
    addr.sin_port = htons((uint16_t)port);
    if (bind(listen_fd, (struct sockaddr *)&addr, sizeof(addr)) != 0) {
        perror("bind");
        return 1;
    }
    listen(listen_fd, 4);
    int fd = accept(listen_fd, NULL, NULL);
    grpcdc_sidecar *sidecar = grpcdc_sidecar_from_fd(fd);
    grpcdc_transport transport;
    grpcdc_sidecar_transport(sidecar, &transport);
    grpcdc_server *server = grpcdc_server_new();
    EchoServer_register(server, &echo_server_impl);
    grpcdc_server_serve(server, &transport);
    return 0;
}

static int dial(const char *host, int port) {
    grpcdc_sidecar *sidecar = grpcdc_sidecar_connect(host, (uint16_t)port);
    if (sidecar == NULL) {
        fprintf(stderr, "sidecar connect failed\n");
        return 1;
    }
    grpcdc_transport transport;
    grpcdc_sidecar_transport(sidecar, &transport);
    grpcdc_channel channel;
    grpcdc_channel_init(&channel, &transport);
    EchoClient client;
    client.channel = &channel;

    EchoRequest req;
    EchoRequest_init(&req);
    req.message = "hello direct";
    EchoResponse resp;
    grpcdc_status st = EchoClient_unary(&client, &req, &resp, NULL, 0, 0);
    if (!grpcdc_status_is_ok(st)) return fail("unary", st);
    printf("unary -> %s\n", resp.message);

    req.message = "tick";
    req.count = 3;
    EchoServerStreamClient stream;
    st = EchoClient_server_stream(&client, &req, &stream, NULL, 0, 0);
    if (!grpcdc_status_is_ok(st)) return fail("server_stream", st);
    char parts[256] = "";
    int first = 1;
    for (;;) {
        EchoResponse tick;
        grpcdc_status rst;
        int r = EchoServerStreamClient_recv(&stream, &tick, &rst);
        if (r == 0) break;
        if (r < 0) return fail("server_stream recv", rst);
        char tmp[128];
        snprintf(tmp, sizeof(tmp), "%s%s#%d", first ? "" : " ", tick.message,
                 tick.index);
        strcat(parts, tmp);
        first = 0;
    }
    EchoServerStreamClient_close(&stream);
    printf("serverStream -> %s\n", parts);
    printf("direct-echo OK\n");
    return 0;
}

int main(int argc, char **argv) {
    if (argc > 1 && strcmp(argv[1], "serve") == 0) {
        return serve(argc > 2 ? atoi(argv[2]) : 50061);
    }
    if (argc > 1 && strcmp(argv[1], "dial") == 0) {
        const char *addr = argc > 2 ? argv[2] : "127.0.0.1:50062";
        const char *colon = strrchr(addr, ':');
        char host[128];
        size_t host_len = (size_t)(colon - addr);
        memcpy(host, addr, host_len);
        host[host_len] = '\0';
        return dial(host, atoi(colon + 1));
    }
    fprintf(stderr, "usage: direct_echo serve <port> | dial <host:port>\n");
    return 2;
}
CEOF
