(define (emit-rust-bdd)
  (cons "bdd_scenarios/mod.rs"
        (string-append
         "//! Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "//! the interpreter is the bdd integration test).\n\n"
         "pub struct BddScenario {\n"
         "    pub name: &'static str,\n"
         "    pub kind: &'static str,\n"
         "    pub messages: &'static [&'static str],\n"
         "    pub count: i32,\n"
         "    pub path: &'static str,\n"
         "    pub metadata: &'static str,\n"
         "    pub expect_message: &'static str,\n"
         "    pub expect_num: i32,\n"
         "    pub expect_status: Option<u32>,\n"
         "}\n\n"
         "pub const BDD_SCENARIOS: &[BddScenario] = &[\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  (format "    BddScenario { name: ~s, kind: ~s, messages: &[~a], count: ~a, path: ~s, metadata: ~s, expect_message: ~s, expect_num: ~a, expect_status: ~a },\n"
                          name kind (q msgs) count path md em en
                          (if es (format "Some(~a)" es) "None"))))
