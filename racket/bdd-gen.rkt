;; ---------------------------------------------------------------------------
;; C# -> csharp/tests/BddScenarios.cs
;; ---------------------------------------------------------------------------

(define (emit-csharp-bdd)
  (cons "BddScenarios.cs"
        (string-append
         "namespace Tests;\n\n"
         "/// <summary>Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "/// the interpreter is TestBdd). Rows: name, kind, messages, count,\n"
         "/// path, metadata, expectMessage, expectNum, expectStatus (-1 = none).</summary>\n"
         "public static class BddScenarios\n"
         "{\n"
         "    public static readonly object[][] Cases =\n"
         "    {\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  ;; Typed array: an implicitly-typed new[] {} for
                  ;; the empty-messages row has no best type (CS0826).
                  (format "        new object[] {~s, ~s, new string[] {~a}, ~a, ~s, ~s, ~s, ~a, ~a},\n"
                          name kind (q msgs) count path md em en (or es -1))))
         "    };\n"
         "}\n")))

