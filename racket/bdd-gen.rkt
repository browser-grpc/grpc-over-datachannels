;; ---------------------------------------------------------------------------
;; C++ -> cpp/tests/bdd_scenarios.hpp
;; ---------------------------------------------------------------------------

(define (emit-cpp-bdd)
  (cons "bdd_scenarios.hpp"
        (string-append
         "#pragma once\n\n"
         "#include <string>\n"
         "#include <vector>\n\n"
         "namespace tests {\n\n"
         "/// Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "/// the interpreter is TestBdd). Rows: name, kind, messages, count,\n"
         "/// path, metadata, expectMessage, expectNum, expectStatus (-1 = none).\n"
         "struct BddCase {\n"
         "  const char* name;\n"
         "  const char* kind;\n"
         "  std::vector<const char*> messages;\n"
         "  int count;\n"
         "  const char* path;\n"
         "  const char* metadata;\n"
         "  const char* expectMessage;\n"
         "  int expectNum;\n"
         "  int expectStatus;\n"
         "};\n\n"
         "inline const std::vector<BddCase>& BddCases() {\n"
         "  static const std::vector<BddCase> cases = {\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  (format "      {~s, ~s, {~a}, ~a, ~s, ~s, ~s, ~a, ~a},\n"
                          name kind (q msgs) count path md em en (or es -1))))
         "  };\n"
         "  return cases;\n"
         "}\n\n"
         "}  // namespace tests\n")))

