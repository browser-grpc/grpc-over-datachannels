#lang racket

;;; bdd-gen.rkt — stamps bdd-spec.rkt's scenario table as data
;;; literals per language plus the BDD.md documentation. Cases are
;;; data, never unrolled code; each language keeps one small
;;; hand-written TestBdd interpreter (mirroring the oracle drivers).

(require "bdd-spec.rkt")
(provide emit-bdd-docs
         emit-js-bdd emit-go-bdd emit-rust-bdd emit-python-bdd
         emit-java-bdd emit-csharp-bdd emit-cpp-bdd emit-swift-bdd
         emit-kotlin-bdd emit-dart-bdd emit-zig-bdd emit-lua-bdd emit-ruby-bdd)

(define (q strs)
  (string-join (for/list ([s (in-list strs)]) (format "~s" s)) ", "))

(define (row s)
  (apply values (bdd-fields s)))

;; ---------------------------------------------------------------------------
;; Documentation -> BDD.md
;; ---------------------------------------------------------------------------

(define (action-prose action)
  (case (first action)
    [(unary) (format "the client calls Unary with message ~s" (second action))]
    [(unary-metadata)
     (format "the client calls Unary with message ~s and metadata x-echo: ~s"
             (second action) (third action))]
    [(server-stream)
     (format "the client calls ServerStream with message ~s and count ~a"
             (second action) (third action))]
    [(client-stream)
     (format "the client calls ClientStream with messages ~a"
             (string-join (map (lambda (m) (format "~s" m)) (rest action)) ", "))]
    [(bidi)
     (format "the client calls Bidi with messages ~a"
             (string-join (map (lambda (m) (format "~s" m)) (rest action)) ", "))]
    [(raw-unary)
     (format "the client calls the unknown method ~s with message ~s"
             (second action) (third action))]))

(define (expectation-prose expectation)
  (case (first expectation)
    [(responds)
     (format "the response is ~s with index ~a" (second expectation) (third expectation))]
    [(fails)
     (format "the call fails with status code ~a" (second expectation))]
    [(streams)
     (if (zero? (third expectation))
         "no responses are produced"
         (format "the responses are ~a copies of ~s with indexes 0..~a"
                 (third expectation) (second expectation) (sub1 (third expectation))))]
    [(echoes)
     (format "the responses echo ~a in order with increasing indexes"
             (string-join (map (lambda (m) (format "~s" m)) (rest expectation)) ", "))]))

(define (emit-bdd-docs)
  (cons "BDD.md"
        (string-append
         "# Behavior scenarios (BDD)\n\n"
         "Generated by `racket/bdd-gen.rkt` from `racket/bdd-spec.rkt` — do not edit.\n"
         "Every scenario below is an executable example: the same table is stamped\n"
         "as data into each language's `bdd_scenarios` file and interpreted by its\n"
         "`TestBdd` suite against a loopback client and server, so this document\n"
         "cannot drift from the behavior the tests enforce.\n\n"
         "Given an Echo service (the reference implementation in each language's\n"
         "examples) connected to a client over a loopback DataChannel:\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)] [i (in-naturals 1)])
                  (format "\n## ~a. ~a\n\n- **Given** the Echo service over a loopback DataChannel\n- **When** ~a\n- **Then** ~a\n"
                          i (second s)
                          (action-prose (third s))
                          (expectation-prose (fourth s)))))
         "\nRun them per language with `make test-<lang>` (suite `TestBdd`), or all\n"
         "of them with `make test`.\n")))

;; ---------------------------------------------------------------------------
;; JavaScript -> js/test/bdd_scenarios.generated.js
;; ---------------------------------------------------------------------------

(define (emit-js-bdd)
  (cons "bdd_scenarios.generated.js"
        (string-append
         "// Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "// the interpreter is TestBdd). Rows: name, kind, messages, count,\n"
         "// path, metadata, expectMessage, expectNum, expectStatus (-1 = none).\n"
         "export const BDD_SCENARIOS = [\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  (format "  { name: ~s, kind: ~s, messages: [~a], count: ~a, path: ~s, metadata: ~s, expectMessage: ~s, expectNum: ~a, expectStatus: ~a },\n"
                          name kind (q msgs) count path md em en (or es -1))))
         "];\n")))

;; ---------------------------------------------------------------------------
;; Go -> go/bdd_scenarios_generated_test.go
;; ---------------------------------------------------------------------------

(define (emit-go-bdd)
  (cons "bdd_scenarios_generated_test.go"
        (string-append
         "package grpcdc_test\n\n"
         "// Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "// the interpreter is TestBdd). Rows: name, kind, messages, count,\n"
         "// path, metadata, expectMessage, expectNum, expectStatus (-1 = none).\n"
         "type bddCase struct {\n"
         "\tname, kind string\n"
         "\tmessages   []string\n"
         "\tcount      int\n"
         "\tpath       string\n"
         "\tmetadata   string\n"
         "\texpectMessage string\n"
         "\texpectNum  int\n"
         "\texpectStatus int\n"
         "}\n\n"
         "var bddCases = []bddCase{\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  (format "\t{name: ~s, kind: ~s, messages: []string{~a}, count: ~a, path: ~s, metadata: ~s, expectMessage: ~s, expectNum: ~a, expectStatus: ~a},\n"
                          name kind (q msgs) count path md em en (or es -1))))
         "}\n")))

;; ---------------------------------------------------------------------------
;; Rust -> rust/tests/bdd_scenarios/mod.rs
;; ---------------------------------------------------------------------------

(define (emit-rust-bdd)
  (cons "bdd_scenarios/mod.rs"
        (string-append
         "//! Scenario table stamped from racket/bdd-spec.rkt (data only;\n"
         "//! the interpreter is the bdd integration test).\n\n"
         "pub struct BddScenario {\n"
         "    pub name: &'static str,\n"
         "    pub kind: &'static str,\n"
         "    pub messages: &'static [&'static str],\n"
         "    pub count: i32,\n"
         "    pub path: &'static str,\n"
         "    pub metadata: &'static str,\n"
         "    pub expect_message: &'static str,\n"
         "    pub expect_num: i32,\n"
         "    pub expect_status: Option<u32>,\n"
         "}\n\n"
         "pub const BDD_SCENARIOS: &[BddScenario] = &[\n"
         (apply string-append
                (for/list ([s (in-list bdd-scenarios)])
                  (define-values (name kind msgs count path md em en es) (row s))
                  (format "    BddScenario { name: ~s, kind: ~s, messages: &[~a], count: ~a, path: ~s, metadata: ~s, expect_message: ~s, expect_num: ~a, expect_status: ~a },\n"
                          name kind (q msgs) count path md em en
                          (if es (format "Some(~a)" es) "None"))))
         "];\n")))

