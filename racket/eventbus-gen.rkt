// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. This file sits in the
// generated events package itself (package v1, from
// proto/events.proto) so the broker can use the wire types
// directly; it imports the grpcdc runtime one-way, like the
// stub beside it. The broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SubscriberQueueCapacity) and drops its oldest events
// when it falls behind; Stats reports the drops.
package v1

import (
	"context"
	"fmt"
	"math"
	"strconv"
	"sync"
	"time"

	"grpcdc"
)

// SubscriberQueueCapacity is the per-subscriber queue bound:
// a slower subscriber drops its oldest queued events instead
// of blocking publishers.
const SubscriberQueueCapacity = ~a

// TagString builds a string-valued tag.
func TagString(tag Tag, value string) *TagValue {
	return &TagValue{Tag: tag, StringValue: value}
}

// TagInt builds an int64-valued tag.
func TagInt(tag Tag, value int64) *TagValue {
	return &TagValue{Tag: tag, IntValue: value}
}

// TagDouble builds a float64-valued tag.
func TagDouble(tag Tag, value float64) *TagValue {
	return &TagValue{Tag: tag, DoubleValue: value}
}

// TagBool builds a bool-valued tag.
func TagBool(tag Tag, value bool) *TagValue {
	return &TagValue{Tag: tag, BoolValue: value}
}

// TagEnum builds an enum-valued tag (any enum, carried as its
// number so it survives peers that do not know the enum).
func TagEnum(tag Tag, value int32) *TagValue {
	return &TagValue{Tag: tag, EnumValue: value}
}

func valueKey(tv *TagValue) string {
	// Canonical identity of one tag value. The oneof kind is
	// part of the identity (int 5 != "5" != enum 5). Kinds
	// are told apart by value, so an all-default TagValue
	// reads as the empty string value; numbers compare
	// bit-exact, never via decimal text.
	switch {
	case tv.StringValue != "":
		return "s:" + tv.StringValue
	case tv.IntValue != 0:
		return "i:" + strconv.FormatInt(tv.IntValue, 10)
	case tv.DoubleValue != 0:
		return "d:" + fmt.Sprintf("%016x", math.Float64bits(tv.DoubleValue))
	case tv.BoolValue:
		return "b:true"
	case tv.EnumValue != 0:
		return "e:" + strconv.FormatInt(int64(tv.EnumValue), 10)
	default:
		return "s:"
	}
}

// TagValueKey is the stable key for one TagValue, e.g.
// "1|s:orders".
func TagValueKey(tv *TagValue) string {
	return strconv.Itoa(int(tv.Tag)) + "|" + valueKey(tv)
}

// TagsMatch reports containment: an event is delivered when
// its tag list contains every (tag, value) pair of the
// filter. An empty filter matches everything.
func TagsMatch(eventTags, filter []*TagValue) bool {
	if len(filter) == 0 {
		return true
	}
	have := make(map[string]bool, len(eventTags))
	for _, tv := range eventTags {
		have[TagValueKey(tv)] = true
	}
	for _, f := range filter {
		if !have[TagValueKey(f)] {
			return false
		}
	}
	return true
}

type brokerSubscriber struct {
	filter  []*TagValue
	queue   []*Event
	dropped int
	wake    chan struct{}
}

// EventBusStats is a point-in-time broker snapshot.
type EventBusStats struct {
	Published   int
	Subscribers int
	Dropped     int
}

// EventBusBroker is an in-memory grpcdc.events.v1.EventBus
// broker. Any peer can host it: Register it on a Server next
// to your own services, or call PublishEvent directly
// in-process. Safe for concurrent use.
type EventBusBroker struct {
	// QueueCapacity bounds each subscriber's queue; values
	// <= 0 mean SubscriberQueueCapacity.
	QueueCapacity int

	mu          sync.Mutex
	subscribers map[*brokerSubscriber]struct{}
	seq         uint64
	published   int
	dropped     int
}

// NewEventBusBroker builds an empty broker.
func NewEventBusBroker() *EventBusBroker {
	return &EventBusBroker{subscribers: map[*brokerSubscriber]struct{}{}}
}

func (b *EventBusBroker) capacity() int {
	if b.QueueCapacity > 0 {
		return b.QueueCapacity
	}
	return SubscriberQueueCapacity
}

// PublishEvent accepts an event: it assigns the sequence
// number and timestamp and fans the event out to matching
// subscribers. It returns the stamped event.
func (b *EventBusBroker) PublishEvent(tags []*TagValue, payload []byte, publisherID string) *Event {
	b.mu.Lock()
	defer b.mu.Unlock()
	b.seq++
	event := &Event{
		Tags:            append([]*TagValue(nil), tags...),
		Payload:         append([]byte(nil), payload...),
		Seq:             b.seq,
		PublisherId:     publisherID,
		TimestampUnixMs: time.Now().UnixMilli(),
	}
	b.published++
	for sub := range b.subscribers {
		if !TagsMatch(event.Tags, sub.filter) {
			continue
		}
		if len(sub.queue) >= b.capacity() {
			sub.queue = sub.queue[1:]
			sub.dropped++
			b.dropped++
		}
		sub.queue = append(sub.queue, event)
		select {
		case sub.wake <- struct{}{}:
		default:
		}
	}
	return event
}

// Stats returns a broker snapshot.
func (b *EventBusBroker) Stats() EventBusStats {
	b.mu.Lock()
	defer b.mu.Unlock()
	return EventBusStats{Published: b.published, Subscribers: len(b.subscribers), Dropped: b.dropped}
}

// Publish implements EventBusServer.
func (b *EventBusBroker) Publish(ctx context.Context, req *PublishRequest) (*PublishReply, error) {
	event := b.PublishEvent(req.Tags, req.Payload, req.PublisherId)
	return &PublishReply{Seq: event.Seq}, nil
}

// Subscribe implements EventBusServer.
func (b *EventBusBroker) Subscribe(req *SubscribeRequest, stream EventBusSubscribeServer) error {
	sub := &brokerSubscriber{filter: req.Filter, wake: make(chan struct{}, 1)}
	b.mu.Lock()
	b.subscribers[sub] = struct{}{}
	b.mu.Unlock()
	defer func() {
		b.mu.Lock()
		delete(b.subscribers, sub)
		b.mu.Unlock()
	}()
	ctx := stream.Context()
	for {
		event, err := b.take(ctx, sub)
		if err != nil {
			// Call cancelled: unsubscribe quietly.
			return nil
		}
		if err := stream.Send(event); err != nil {
			return nil
		}
	}
}

func (b *EventBusBroker) take(ctx context.Context, sub *brokerSubscriber) (*Event, error) {
	for {
		b.mu.Lock()
		if len(sub.queue) > 0 {
			event := sub.queue[0]
			sub.queue = sub.queue[1:]
			b.mu.Unlock()
			return event, nil
		}
		b.mu.Unlock()
		select {
		case <-sub.wake:
		case <-ctx.Done():
			return nil, ctx.Err()
		}
	}
}

// LocalSubscription is an in-process subscription returned
// by SubscribeLocal: events fan out to it exactly like an RPC
// subscriber, without a call.
type LocalSubscription struct {
	broker *EventBusBroker
	sub    *brokerSubscriber
}

// SubscribeLocal registers an in-process subscription.
// Close unregisters it.
func (b *EventBusBroker) SubscribeLocal(filter []*TagValue) *LocalSubscription {
	sub := &brokerSubscriber{filter: filter, wake: make(chan struct{}, 1)}
	b.mu.Lock()
	b.subscribers[sub] = struct{}{}
	b.mu.Unlock()
	return &LocalSubscription{broker: b, sub: sub}
}

// Recv waits for the next event; it returns ctx.Err() when
// the context ends.
func (s *LocalSubscription) Recv(ctx context.Context) (*Event, error) {
	return s.broker.take(ctx, s.sub)
}

// Dropped counts this subscription's drop-oldest losses.
func (s *LocalSubscription) Dropped() int {
	s.broker.mu.Lock()
	defer s.broker.mu.Unlock()
	return s.sub.dropped
}

// Close unregisters the subscription.
func (s *LocalSubscription) Close() {
	s.broker.mu.Lock()
	delete(s.broker.subscribers, s.sub)
	s.broker.mu.Unlock()
}

// Register attaches the broker to a Server.
func (b *EventBusBroker) Register(server *grpcdc.Server) {
	RegisterEventBusServer(server, b)
}

// PublishEvent publishes through a generated EventBus client
// and returns the broker-assigned sequence number.
func PublishEvent(ctx context.Context, client *EventBusClient, tags []*TagValue, payload []byte, publisherID string) (uint64, error) {
	reply, err := client.Publish(ctx, &PublishRequest{Tags: tags, Payload: payload, PublisherId: publisherID})
	if err != nil {
		return 0, err
