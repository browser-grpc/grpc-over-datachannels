    publisherId or ""))
  return reply.seq
end

-- Subscribe through a generated EventBusClient; returns the
-- receiving stream (recv from it, or close it to
-- unsubscribe).
function M.subscribeEvents(client, filterTags)
  return client:subscribe(SubscribeRequest.new(filterTags or {}))
end

-- Re-exported so users can build a client without requiring
-- the stub module directly.
M.EventBusClient = stubs.EventBusClient

return M
TPL
