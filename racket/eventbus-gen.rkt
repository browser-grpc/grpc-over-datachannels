//! Event bus demo: a broker, one filtered subscriber, and
//! three publishes over the loopback transport.
//! `cargo run --example eventbus_demo`

use futures_util::StreamExt;
use grpc_dc::eventbus::pb::{Event, PublishReply, PublishRequest, SubscribeRequest, Tag, TagValue};
use grpc_dc::eventbus::{tag_string, EventBusBroker};
use grpc_dc::{loopback_pair, Channel, DcTransport, Server};
use std::sync::Arc;

#[tokio::main]
async fn main() {
    let broker = Arc::new(EventBusBroker::new());
    let (a, b) = loopback_pair();
    let server_transport: Arc<dyn DcTransport> = Arc::new(b);
    tokio::spawn(Server::serve(server_transport, vec![broker.service()]));
    let client_transport: Arc<dyn DcTransport> = Arc::new(a);
    let channel = Channel::new(client_transport);

    let mut stream = channel
        .server_stream::<SubscribeRequest, Event>(
            "/grpcdc.events.v1.EventBus/Subscribe",
            SubscribeRequest { filter: vec![tag_string(Tag::Topic, "orders")], ..Default::default() },
        )
        .await
        .unwrap();
    while broker.stats().subscribers < 1 {
        tokio::time::sleep(std::time::Duration::from_millis(5)).await;
    }
    for (topic, payload) in [("orders", "order-1"), ("other", "noise"), ("orders", "order-2")] {
        let _: PublishReply = channel
            .unary(
                "/grpcdc.events.v1.EventBus/Publish",
