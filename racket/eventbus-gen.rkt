// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using System.Threading;
using Grpcdc;
using Grpcdc.events.v1;

namespace Tests;

public static class TestEventBus
{
    private static void Check(bool condition, string what)
    {
        if (!condition) throw new Exception("check failed: " + what);
    }

    private static void WaitFor(Func<bool> fn, string what)
    {
        var deadline = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() + 5000;
        while (!fn())
        {
            if (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() > deadline)
            {
                throw new Exception("waitFor timed out: " + what);
            }
            Thread.Sleep(5);
        }
    }

    private static (EventBusBroker, EventsGrpcDc.EventBusClient) SetupBus()
    {
        var broker = new EventBusBroker();
        (ITransport a, ITransport b) = MemoryTransport.Pair();
        var server = new Server();
        broker.Register(server);
        server.ServeTransport(b);
        return (broker, new EventsGrpcDc.EventBusClient(new Channel(a)));
    }

    private static Thread Collect(EventsGrpcDc.EventBusSubscribeStream stream, List<Event> outList)
    {
        var thread = new Thread(() =>
        {
            try
            {
                while (true) outList.Add(stream.Recv());
            }
            catch (Exception)
            {
                // stream closed
            }
        });
        thread.IsBackground = true;
        thread.Start();
        return thread;
    }

    private static byte[] Bytes(string s) => Encoding.UTF8.GetBytes(s);
    private static string Text(byte[] b) => Encoding.UTF8.GetString(b);

    public static void Run()
    {
        // -- TagsMatch: containment, kinds, empty --
        var tags = new List<TagValue>
        {
            Eventbus.TagString(Tag.TOPIC, "orders"),
            Eventbus.TagInt(Tag.KIND, 5),
        };
        Check(Eventbus.TagsMatch(tags, new List<TagValue>()), "empty filter matches");
        Check(Eventbus.TagsMatch(tags,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") }), "containment");
        Check(Eventbus.TagsMatch(tags, tags), "self match");
        Check(!Eventbus.TagsMatch(tags,
            new List<TagValue> { Eventbus.TagEnum(Tag.KIND, 5) }), "int != enum");
        Check(!Eventbus.TagsMatch(tags,
            new List<TagValue> { Eventbus.TagString(Tag.KIND, "5") }), "int != string");
        Check(!Eventbus.TagsMatch(tags,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "other") }), "value mismatch");

        // -- fan-out honors filters --
        var (broker, client) = SetupBus();
        var orders = new List<Event>();
        var all = new List<Event>();
        Collect(Eventbus.SubscribeEvents(client,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") }), orders);
        Collect(Eventbus.SubscribeEvents(client, new List<TagValue>()), all);
        WaitFor(() => broker.Stats()["subscribers"] == 2, "2 subscribers");
        Check(Eventbus.PublishEvent(client,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") },
            Bytes("o1"), "test") == 1, "seq 1");
        Check(Eventbus.PublishEvent(client,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "other") },
            Bytes("x1"), "test") == 2, "seq 2");
        WaitFor(() => orders.Count == 1 && all.Count == 2, "fanout");
        Check(Text(orders[0].Payload) == "o1", "filtered payload");
        Check(orders[0].PublisherId == "test", "publisher");
        Check(all[0].Seq == 1 && all[1].Seq == 2, "all seqs");

        // -- kinds never cross-match --
        var (_, client2) = SetupBus();
        var got = new List<Event>();
        Collect(Eventbus.SubscribeEvents(client2,
            new List<TagValue> { Eventbus.TagInt(Tag.KIND, 5) }), got);
        Eventbus.PublishEvent(client2,
            new List<TagValue> { Eventbus.TagString(Tag.KIND, "5") }, Bytes("s"));
        Eventbus.PublishEvent(client2,
            new List<TagValue> { Eventbus.TagEnum(Tag.KIND, 5) }, Bytes("e"));
        Check(Eventbus.PublishEvent(client2,
            new List<TagValue> { Eventbus.TagInt(Tag.KIND, 5) }, Bytes("i")) == 3, "seq 3");
        WaitFor(() => got.Count == 1, "kind match");
        Check(Text(got[0].Payload) == "i", "int kind only");

        // -- user tags pass through (C# enums carry unknown values) --
        var (_, client3) = SetupBus();
        var got3 = new List<Event>();
        Collect(Eventbus.SubscribeEvents(client3,
            new List<TagValue> { new TagValue((Tag)1004, "x", 0, 0, false, 0) }), got3);
        Eventbus.PublishEvent(client3,
            new List<TagValue> { new TagValue((Tag)1004, "x", 0, 0, false, 0) }, Bytes("u"));
        WaitFor(() => got3.Count == 1, "user tag");
        Check((int)got3[0].Tags[0].Tag == 1004, "user tag number");
        Check(got3[0].Tags[0].StringValue == "x", "user tag value");

        // -- slow subscriber drops oldest --
        var broker4 = new EventBusBroker(4);
        var sub = broker4.SubscribeLocal(new List<TagValue>());
        for (var i = 1; i <= 6; i++) broker4.PublishEvent(new List<TagValue>(), Bytes("m" + i));
        Check(broker4.Stats()["dropped"] == 2, "dropped count");
        Check(sub.Dropped == 2, "sub dropped");
        var seqs = new List<ulong>();
        for (var i = 0; i < 4; i++) seqs.Add(sub.Take().Seq);
        Check(string.Join(",", seqs) == "3,4,5,6", "kept newest");
        sub.Close();
        Check(broker4.Stats()["subscribers"] == 0, "close unregisters");

        // -- close unsubscribes (RPC) --
        var (broker5, client5) = SetupBus();
        var stream = Eventbus.SubscribeEvents(client5, new List<TagValue>());
        WaitFor(() => broker5.Stats()["subscribers"] == 1, "1 subscriber");
        Eventbus.PublishEvent(client5, new List<TagValue>(), Bytes("a"));
        Check(Text(stream.Recv().Payload) == "a", "recv before close");
        stream.Dispose();
        Eventbus.PublishEvent(client5, new List<TagValue>(), Bytes("b"));
        WaitFor(() => broker5.Stats()["subscribers"] == 0, "reaped");

        // -- git log round-trip + idempotent --
        var repo = Path.Combine(Path.GetTempPath(),
            "grpc-dc-eventbus-" + Guid.NewGuid().ToString("N"));
        Directory.CreateDirectory(repo);
        var broker6 = new EventBusBroker();
        var events = new List<Event>
        {
            broker6.PublishEvent(
                new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") },
                Bytes("o1"), "test"),
            broker6.PublishEvent(
                new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "other") },
                Bytes("x1"), "test"),
            broker6.PublishEvent(
                new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") },
                Bytes("o2"), "test"),
        };
        var head1 = EventbusGit.ExportEvents(repo, events);
        Check(EventbusGit.GitText(repo,
            new List<string> { "rev-list", "--count", "grpc-dc-events" }) == "3",
            "commit count");
        Check(EventbusGit.ExportEvents(repo, events) == head1, "idempotent re-export");
        var imported = EventbusGit.ImportEvents(repo);
        Check(imported.Count == 3 && imported[0].Seq == 1 && imported[2].Seq == 3,
            "import seqs");
        Check(Text(imported[0].Payload) == "o1" && Text(imported[2].Payload) == "o2",
            "import payloads");
        var filtered = EventbusGit.ImportEvents(repo, EventbusGit.EventLogBranch, 0, null,
            new List<TagValue> { Eventbus.TagString(Tag.TOPIC, "orders") });
        Check(filtered.Count == 2 && filtered[1].Seq == 3, "import filter");
        var window = EventbusGit.ImportEvents(repo, EventbusGit.EventLogBranch, 1, 2);
        Check(window.Count == 1 && window[0].Seq == 2, "import window");

        Console.WriteLine("TestEventBus OK");
    }
}
