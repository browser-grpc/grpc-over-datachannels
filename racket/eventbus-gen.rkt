"""Event bus demo: a broker, one filtered subscriber, and
three publishes over one in-memory data channel.
`python3 python/examples/eventbus_demo.py`
"""

import os
import sys
import threading

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

import grpcdc
from grpcdc import eventbus
from grpcdc.events_pb import Tag


def main():
    broker = eventbus.EventBusBroker()
    a, b = grpcdc.memory_transport_pair()
    server = grpcdc.Server()
    broker.register(server)
    server.serve_transport(b)
    client = eventbus.EventBusClient(grpcdc.Channel(a))

    received = []

    def subscribe():
        stream = eventbus.subscribe_events(client, [eventbus.tag_string(Tag.TOPIC, "orders")])
        for event in stream:
            received.append("#%d %s" % (event.seq, event.payload.decode()))
            if len(received) == 2:
                stream.close()
                return

    thread = threading.Thread(target=subscribe, daemon=True)
    thread.start()
    while broker.stats()["subscribers"] < 1:
        pass
    eventbus.publish_event(client, [eventbus.tag_string(Tag.TOPIC, "orders")], b"order-1", "demo")
    eventbus.publish_event(client, [eventbus.tag_string(Tag.TOPIC, "other")], b"noise", "demo")
    eventbus.publish_event(client, [eventbus.tag_string(Tag.TOPIC, "orders")], b"order-2", "demo")
    thread.join(timeout=5)
    print("subscriber got: " + ", ".join(received))
    print("broker stats: %s" % (broker.stats(),))


if __name__ == "__main__":
    main()
TPL
   ))

