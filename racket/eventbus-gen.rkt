      end

      def remove_subscriber(sub)
        @mutex.synchronize { @subscribers.delete(sub) }
      end

      def register(server)
        EventsGrpcDc.register_event_bus_server(server, self)
        self
      end
    end

    # Handle for EventBusBroker#subscribe_local: pull events
    # in-process. take returns the next event (waiting up to
    # the timeout, in seconds), or nil; dropped counts this
    # subscription's drop-oldest losses.
    class LocalSubscription
      def initialize(broker, sub)
        @broker = broker
        @sub = sub
      end

      def dropped
        @sub.dropped
      end

      def take(timeout = 1.0)
        deadline = Time.now + timeout
        loop do
          remaining = deadline - Time.now
          return @sub.take(0) if remaining <= 0

          event = @sub.take([remaining, 0.1].min)
          return event unless event.nil?
          return nil if Time.now >= deadline
        end
      end

      def close
        @broker.remove_subscriber(@sub)
      end
    end

