(define (emit-js-eventbus)
  (string-append
   (js-header)
   (format #<<TPL
// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (events_pb.js,
// events_grpc_dc.js); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
// events when it falls behind; stats() reports the drops.

import { createEventBusService, EventBusClient } from "./events_grpc_dc.js";
import { Event, PublishReply, PublishRequest, SubscribeRequest, TagValue } from "./events_pb.js";

export const SUBSCRIBER_QUEUE_CAPACITY = ~a;

const _doubleView = new DataView(new ArrayBuffer(8));

function doubleBits(value) {
  _doubleView.setFloat64(0, value);
  return _doubleView.getBigUint64(0).toString(16).padStart(16, "0");
}

// Canonical identity of one tag value. The oneof kind is part
// of the identity (int 5 != "5" != enum 5). Kinds are told
// apart by value, so an all-default TagValue reads as the
// empty string value; numbers compare bit-exact, never via
// decimal text.
function valueKey(tv) {
  if (tv.stringValue !== "") return `s:${tv.stringValue}`;
  if (tv.intValue !== 0n) return `i:${tv.intValue.toString()}`;
  if (tv.doubleValue !== 0) return `d:${doubleBits(tv.doubleValue)}`;
  if (tv.boolValue) return "b:true";
  if (tv.enumValue !== 0) return `e:${tv.enumValue}`;
  return "s:";
}

// Stable key for one TagValue, e.g. "1|s:orders".
export function tagValueKey(tv) {
  return `${tv.tag}|${valueKey(tv)}`;
}

// Containment match: the event is delivered when its tag list
// contains every (tag, value) pair of the filter. An empty
// filter matches everything.
export function tagsMatch(eventTags, filter) {
  if (!filter || filter.length === 0) return true;
  const have = new Set();
  for (const tv of eventTags ?? []) have.add(tagValueKey(tv));
  return filter.every((f) => have.has(tagValueKey(f)));
}

export function tagString(tag, value) {
  return new TagValue({ tag, stringValue: String(value) });
}

export function tagInt(tag, value) {
  return new TagValue({ tag, intValue: BigInt(value) });
}

export function tagDouble(tag, value) {
  return new TagValue({ tag, doubleValue: value });
}

export function tagBool(tag, value) {
  return new TagValue({ tag, boolValue: Boolean(value) });
}

export function tagEnum(tag, value) {
  return new TagValue({ tag, enumValue: value | 0 });
}

class Subscriber {
  constructor(filter, capacity) {
    this.filter = filter;
    this.capacity = capacity;
    this.queue = [];
    this.waiter = null;
    this.dropped = 0;
  }

  push(event) {
    let dropped = false;
    if (this.queue.length >= this.capacity) {
      this.queue.shift();
      this.dropped += 1;
      dropped = true;
    }
    this.queue.push(event);
    if (this.waiter) {
      const waiter = this.waiter;
      this.waiter = null;
      waiter();
    }
    return dropped;
  }

  // Next queued event, or null when the wait times out. The
  // broker re-checks every tick; a cancelled call is reaped
  // when its next matching send fails (the runtime surfaces
  // cancellation only at send time).
  async take(timeoutMs) {
    if (this.queue.length > 0) return this.queue.shift();
    await new Promise((resolve) => {
      const wake = () => {
        clearTimeout(timer);
        if (this.waiter === wake) this.waiter = null;
        resolve();
      };
      const timer = setTimeout(wake, timeoutMs);
      this.waiter = wake;
    });
    return this.queue.length > 0 ? this.queue.shift() : null;
  }
}

// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: register() it on a Server next to your own
// services, or call publishEvent() directly in-process.
export class EventBusBroker {
  #subscribers = new Set();
  #seq = 0;
  #published = 0;
  #dropped = 0;

  constructor({ queueCapacity = SUBSCRIBER_QUEUE_CAPACITY } = {}) {
    this.queueCapacity = queueCapacity;
  }

  // Accept an event: assign its sequence number and timestamp
  // and fan it out to matching subscribers. Returns the
  // stamped Event.
  publishEvent(tags, payload, publisherId = "") {
    const event = new Event({
      tags: [...(tags ?? [])],
      payload: payload ?? new Uint8Array(0),
      seq: BigInt(++this.#seq),
      publisherId: publisherId ?? "",
      timestampUnixMs: BigInt(Date.now()),
    });
    this.#published += 1;
    for (const sub of this.#subscribers) {
      if (tagsMatch(event.tags, sub.filter) && sub.push(event)) {
        this.#dropped += 1;
      }
    }
    return event;
  }

  stats() {
    return {
      published: this.#published,
      subscribers: this.#subscribers.size,
      dropped: this.#dropped,
    };
  }

  // In-process subscription: events fan out to it exactly
  // like an RPC subscriber, without a call. Useful embedded
  // and for tests; close() unregisters.
  subscribeLocal(filter) {
    const sub = new Subscriber(filter ?? [], this.queueCapacity);
    this.#subscribers.add(sub);
    return new LocalSubscription(sub, () => this.#subscribers.delete(sub));
  }

  serviceHandlers() {
    const broker = this;
    return {
      async publish(req) {
        const event = broker.publishEvent(req.tags, req.payload, req.publisherId);
        return new PublishReply({ seq: event.seq });
      },
      async *subscribe(req) {
        const sub = new Subscriber(req.filter ?? [], broker.queueCapacity);
        broker.#subscribers.add(sub);
        try {
          for (;;) {
            const event = await sub.take(100);
            if (event !== null) yield event;
          }
        } finally {
          broker.#subscribers.delete(sub);
        }
      },
    };
  }

  service() {
    return createEventBusService(this.serviceHandlers());
  }

  register(server) {
    server.addService(this.service());
    return this;
  }
}

// Handle for EventBusBroker.subscribeLocal: pull events
// in-process. take() resolves to the next event, or null on
// timeout; dropped counts this subscription's drop-oldest
// losses.
export class LocalSubscription {
  #sub;
  #unregister;
  constructor(sub, unregister) {
    this.#sub = sub;
    this.#unregister = unregister;
  }

  get dropped() {
    return this.#sub.dropped;
  }

  async take(timeoutMs = 1000) {
    const deadline = Date.now() + timeoutMs;
    for (;;) {
      const event = await this.#sub.take(Math.max(0, deadline - Date.now()));
      if (event !== null || Date.now() >= deadline) return event;
    }
  }

  close() {
    this.#unregister();
  }
}

// Publish through a generated EventBusClient; resolves to the
// broker-assigned sequence number (a BigInt).
export async function publishEvent(client, tags, payload, publisherId = "") {
  const reply = await client.publish(
    new PublishRequest({
      tags: tags ?? [],
      payload: payload ?? new Uint8Array(0),
      publisherId: publisherId ?? "",
    }),
  );
  return reply.seq;
}

// Subscribe through a generated EventBusClient; resolves to an
// async iterable of Event. Breaking out of the iteration
// cancels the call and unsubscribes.
export function subscribeEvents(client, filter) {
  return client.subscribe(new SubscribeRequest({ filter: filter ?? [] }));
}

export { EventBusClient };
TPL
           queue-capacity)))

;; ---------------------------------------------------------------------------
;; JavaScript git log serde (Node only): js/src/eventbus_gitlog.js
;; ---------------------------------------------------------------------------

(define (emit-js-gitlog)
  (string-append
   (js-header)
   (format #<<TPL
// Git log serde for the event bus (Node only): exports an
// event log to a git branch (one commit per event) and
// imports it back. The live broker never touches git; this is
// the durable serde layer beside it.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is a
// no-op (each event's sequence number is the dedup key). The
// commit blob (~a) is authoritative; the message subject and
// trailers are a human index for `git log`.

import { execFileSync } from "node:child_process";

import { Event } from "./events_pb.js";
import { tagValueKey, tagsMatch } from "./eventbus.js";

const AUTHOR_NAME = "~a";
const AUTHOR_EMAIL = "~a";
const BLOB_PATH = "~a";
const COMMIT_SUBJECT = "~a";
const ZERO_SHA = "0".repeat(40);

export const EVENT_LOG_BRANCH = "grpc-dc-events";

function gitText(repo, args, { input, env } = {}) {
  return execFileSync("git", ["-C", repo, ...args], {
    input,
    env: env ? { ...process.env, ...env } : process.env,
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
  }).trim();
}

function gitBytes(repo, args) {
  return execFileSync("git", ["-C", repo, ...args], {
    maxBuffer: 256 * 1024 * 1024,
  });
}

// Create the log repo if needed (a plain `git init`).
export function initEventLogRepo(repo) {
  try {
    gitText(repo, ["rev-parse", "--git-dir"]);
  } catch {
    execFileSync("git", ["init", "-q", repo], { encoding: "utf8" });
  }
}

function branchHead(repo, branch) {
  try {
    return gitText(repo, ["rev-parse", "--verify", `refs/heads/${branch}`]);
  } catch {
    return null;
  }
}

// "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
// `git log` alone can filter the log without decoding blobs.
export function commitMessage(event) {
  const lines = [`${COMMIT_SUBJECT} ${event.seq}`, "", `~a: ${event.seq}`];
  if (event.publisherId) lines.push(`~a: ${event.publisherId}`);
  for (const tv of event.tags) lines.push(`~a: ${tagValueKey(tv)}`);
  return lines.join("\n") + "\n";
}

function commitEnv(event) {
  const seconds = Math.max(0, Math.floor(Number(event.timestampUnixMs) / 1000));
  const date = `${seconds} +0000`;
  return {
    GIT_AUTHOR_NAME: AUTHOR_NAME,
    GIT_AUTHOR_EMAIL: AUTHOR_EMAIL,
    GIT_COMMITTER_NAME: AUTHOR_NAME,
    GIT_COMMITTER_EMAIL: AUTHOR_EMAIL,
    GIT_AUTHOR_DATE: date,
    GIT_COMMITTER_DATE: date,
  };
}

// Import a branch: events in chain order (oldest first),
// optionally windowed by sequence number and narrowed by a
// tag filter (same containment semantics as Subscribe). A
// missing branch imports as an empty log.
export function importEvents(repo, branch = EVENT_LOG_BRANCH, { fromSeq = 0n, toSeq = null, filter = null } = {}) {
  if (!branchHead(repo, branch)) return [];
  const shas = gitText(repo, ["rev-list", "--reverse", branch]).split("\n").filter(Boolean);
  const events = [];
  for (const sha of shas) {
    const event = Event.decode(gitBytes(repo, ["cat-file", "-p", `${sha}:${BLOB_PATH}`]));
    if (event.seq <= BigInt(fromSeq)) continue;
    if (toSeq !== null && event.seq > BigInt(toSeq)) continue;
    if (filter && !tagsMatch(event.tags, filter)) continue;
    events.push(event);
  }
  return events;
}

// Export events onto the branch: one commit per event, in
// sequence order, skipping sequence numbers the branch
// already has. Returns the new head sha (or the existing one
// when nothing was appended). The ref update is a
// compare-and-swap: a concurrent exporter fails loudly
// instead of forking the log; retrying is safe.
export function exportEvents(repo, events, branch = EVENT_LOG_BRANCH) {
  initEventLogRepo(repo);
  const existing = new Set(importEvents(repo, branch).map((e) => e.seq.toString()));
  const ordered = [...events].sort((a, b) => (a.seq < b.seq ? -1 : a.seq > b.seq ? 1 : 0));
  let head = branchHead(repo, branch);
  const before = head;
  for (const event of ordered) {
    if (existing.has(event.seq.toString())) continue;
    const blob = gitText(repo, ["hash-object", "-w", "--stdin"], { input: Buffer.from(Event.encode(event)) });
    const tree = gitText(repo, ["mktree"], { input: `100644 blob ${blob}\t${BLOB_PATH}\n` });
    const commitArgs = ["commit-tree", tree, "-m", commitMessage(event)];
    if (head) commitArgs.push("-p", head);
    head = gitText(repo, commitArgs, { env: commitEnv(event) });
    existing.add(event.seq.toString());
  }
  if (head && head !== before) {
    gitText(repo, ["update-ref", `refs/heads/${branch}`, head, before ?? ZERO_SHA]);
  } else if (head && !before) {
    gitText(repo, ["update-ref", `refs/heads/${branch}`, head, ZERO_SHA]);
  }
  return head;
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

