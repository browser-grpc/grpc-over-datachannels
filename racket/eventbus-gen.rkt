        EB::publishEvent($client2, [EB::tagEnum(\EventsPb\Tag::KIND, 5)], "e");
        T::assertEq(EB::publishEvent($client2, [EB::tagInt(\EventsPb\Tag::KIND, 5)], "i"), 3, "seq 3");
        T::assertEq($kindStream->recv()->payload, "i", "int kind only");
        $kindStream->close();

