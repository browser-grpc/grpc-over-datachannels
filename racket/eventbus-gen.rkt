   (scala-header)
   (format #<<TPL
package grpcdc.events.v1

// Git log serde for the event bus: exports an event log to
// a git branch (one commit per event) and imports it back.
// The live broker never touches git; this is the durable
// serde layer beside it. ProcessBuilder drives the git
// plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is
// a no-op (each event's sequence number is the dedup key).
// The commit blob (~a) is authoritative; the message
// subject and trailers are a human index for `git log`.

import java.nio.charset.StandardCharsets
import scala.collection.mutable

object EventbusGit {
  final val AUTHOR_NAME = "~a"
  final val AUTHOR_EMAIL = "~a"
  final val BLOB_PATH = "~a"
  final val COMMIT_SUBJECT = "~a"
  final val TRAILER_SEQ = "~a"
  final val TRAILER_PUBLISHER = "~a"
  final val TRAILER_TAG = "~a"
  final val ZERO_SHA = "0000000000000000000000000000000000000000"

  final val EVENT_LOG_BRANCH = "grpc-dc-events"

  def git(repo: String, args: List[String], inputBytes: Array[Byte] = null,
          envExtra: Map[String, String] = null): Array[Byte] = {
    val cmd = mutable.ArrayBuffer[String]()
    cmd += "git"
    cmd += "-C"
    cmd += repo
    cmd ++= args
    val pb = new ProcessBuilder(cmd.toList: _*)
    if (envExtra != null) {
      for ((k, v) <- envExtra) pb.environment().put(k, v)
    }
    val proc = pb.start()
    if (inputBytes != null) {
      val in = proc.getOutputStream
      in.write(inputBytes)
      in.close()
    } else {
      proc.getOutputStream.close()
    }
    val out = proc.getInputStream.readAllBytes()
    proc.getErrorStream.readAllBytes()
    if (proc.waitFor() != 0) {
      throw new IllegalStateException("git " + args.head + " failed in " + repo)
    }
    out
  }

  def gitText(repo: String, args: List[String], inputBytes: Array[Byte] = null,
              envExtra: Map[String, String] = null): String =
    new String(git(repo, args, inputBytes, envExtra), StandardCharsets.UTF_8).trim

  /** Create the log repo if needed (a plain `git init`). */
  def initEventLogRepo(repo: String): Unit = {
    try {
      gitText(repo, List("rev-parse", "--git-dir"))
    } catch {
      case _: Exception =>
        val proc = new ProcessBuilder("git", "init", "-q", repo).start()
        proc.getInputStream.readAllBytes()
        proc.getErrorStream.readAllBytes()
        if (proc.waitFor() != 0) {
          throw new IllegalStateException("git init failed for " + repo)
        }
    }
  }

  def branchHead(repo: String, branch: String): String = {
    try {
      gitText(repo, List("rev-parse", "--verify", "refs/heads/" + branch))
    } catch {
      case _: Exception => null
    }
  }

  // "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
  // `git log` alone can filter the log without decoding blobs.
  def commitMessage(event: Event): String = {
    val sb = new StringBuilder
    sb.append(COMMIT_SUBJECT).append(' ').append(event.seq).append("\n\n")
    sb.append(TRAILER_SEQ).append(": ").append(event.seq)
    if (event.publisherId != "") {
      sb.append('\n').append(TRAILER_PUBLISHER).append(": ")
        .append(event.publisherId)
    }
    for (tv <- event.tags) {
      sb.append('\n').append(TRAILER_TAG).append(": ")
        .append(Eventbus.tagValueKey(tv))
    }
    sb.append('\n').toString
  }

  def commitEnv(event: Event): Map[String, String] = {
    val seconds = Math.max(0, event.timestampUnixMs / 1000)
    val date = seconds.toString + " +0000"
    Map(
      "GIT_AUTHOR_NAME" -> AUTHOR_NAME,
      "GIT_AUTHOR_EMAIL" -> AUTHOR_EMAIL,
      "GIT_COMMITTER_NAME" -> AUTHOR_NAME,
      "GIT_COMMITTER_EMAIL" -> AUTHOR_EMAIL,
      "GIT_AUTHOR_DATE" -> date,
      "GIT_COMMITTER_DATE" -> date)
  }

  // Import a branch: events in chain order (oldest first),
  // optionally windowed by sequence number and narrowed by
  // a tag filter (same containment semantics as
  // Subscribe). A missing branch imports as an empty log.
  def importEvents(repo: String, branch: String = EVENT_LOG_BRANCH,
                   fromSeq: Long = 0, toSeq: Long = -1,
                   filterTags: List[TagValue] = null): List[Event] = {
    val events = mutable.ArrayBuffer[Event]()
    if (branchHead(repo, branch) == null) return events.toList
    val list = gitText(repo, List("rev-list", "--reverse", branch))
    for (sha <- list.split("\n")) {
      if (sha != "") {
        val data = git(repo, List("cat-file", "-p", sha + ":" + BLOB_PATH))
        val event = new Event()
        event.unmarshalDc(data)
        val skip = event.seq <= fromSeq ||
          (toSeq >= 0 && event.seq > toSeq) ||
          (filterTags != null && !Eventbus.tagsMatch(event.tags, filterTags))
        if (!skip) events += event
      }
    }
    events.toList
  }

  // Export events onto the branch: one commit per event, in
  // sequence order, skipping sequence numbers the branch
  // already has. Returns the new head sha (or the existing
  // one when nothing was appended). The ref update is a
  // compare-and-swap: a concurrent exporter fails loudly
  // instead of forking the log; retrying is safe.
  def exportEvents(repo: String, events: List[Event],
                   branch: String = EVENT_LOG_BRANCH): String = {
    initEventLogRepo(repo)
    val existing = mutable.HashSet[Long]()
    for (e <- importEvents(repo, branch)) existing.add(e.seq)
    val ordered = events.sortBy(_.seq)
    var head = branchHead(repo, branch)
    val before = head
    for (event <- ordered) {
      if (!existing.contains(event.seq)) {
        val blob = gitText(repo, List("hash-object", "-w", "--stdin"),
          event.marshalDc())
        val tree = gitText(repo, List("mktree"),
          ("100644 blob " + blob + "\t" + BLOB_PATH + "\n")
            .getBytes(StandardCharsets.UTF_8))
        val args = mutable.ArrayBuffer[String](
          "commit-tree", tree, "-m", commitMessage(event))
        if (head != null) {
          args += "-p"
          args += head
        }
        head = gitText(repo, args.toList, null, commitEnv(event))
        existing.add(event.seq)
      }
    }
    if (head != null && head != before) {
      gitText(repo, List("update-ref", "refs/heads/" + branch, head,
        if (before == null) ZERO_SHA else before))
    }
    head
  }
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

(define (emit-scala-test)
  (string-append
   (scala-header)
   #<<TPL
package tests

// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

import grpcdc.Channel
import grpcdc.MemoryTransport
import grpcdc.Server
import grpcdc.events.v1.Event
import grpcdc.events.v1.EventBusBroker
import grpcdc.events.v1.Eventbus
import grpcdc.events.v1.EventbusGit
import grpcdc.events.v1.EventsGrpcDc
import grpcdc.events.v1.Tag
import grpcdc.events.v1.TagValue
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import scala.collection.mutable

object TestEventBus {
  private def check(condition: Boolean, what: String): Unit = {
    if (!condition) throw new AssertionError(what)
  }

  private def waitFor(fn: () => Boolean, what: String): Unit = {
    val deadline = System.currentTimeMillis() + 5000
    while (!fn()) {
      if (System.currentTimeMillis() > deadline) {
        throw new AssertionError("waitFor timed out: " + what)
      }
      Thread.sleep(5)
    }
  }

  private def setupBus(): (EventBusBroker, EventsGrpcDc.EventBusClient) = {
    val broker = new EventBusBroker()
    val (a, b) = MemoryTransport.pair()
    val server = new Server()
    broker.register(server)
    server.serveTransport(b)
    (broker, new EventsGrpcDc.EventBusClient(new Channel(a)))
  }

  private def collect(stream: EventsGrpcDc.EventBusClient#EventBusServerStreamStream,
                      out: mutable.ArrayBuffer[Event]): Thread = {
    val thread = new Thread {
      override def run(): Unit = {
        try {
          while (true) out += stream.recv()
        } catch {
          case _: Exception => () // stream closed
        }
      }
    }
    thread.setDaemon(true)
    thread.start()
    thread
  }

  private def bytes(s: String): Array[Byte] = s.getBytes(StandardCharsets.UTF_8)
  private def text(b: Array[Byte]): String = new String(b, StandardCharsets.UTF_8)

  def run(): Unit = {
    // -- tagsMatch: containment, kinds, empty --
    val tags = List(
      Eventbus.tagString(Tag.TOPIC, "orders"),
      Eventbus.tagInt(Tag.KIND, 5))
    check(Eventbus.tagsMatch(tags, List.empty), "empty filter matches")
    check(Eventbus.tagsMatch(tags,
      List(Eventbus.tagString(Tag.TOPIC, "orders"))), "containment")
    check(Eventbus.tagsMatch(tags, tags), "self match")
    check(!Eventbus.tagsMatch(tags,
      List(Eventbus.tagEnum(Tag.KIND, 5))), "int != enum")
    check(!Eventbus.tagsMatch(tags,
      List(Eventbus.tagString(Tag.KIND, "5"))), "int != string")
    check(!Eventbus.tagsMatch(tags,
      List(Eventbus.tagString(Tag.TOPIC, "other"))), "value mismatch")

    // -- fan-out honors filters --
    val (broker, client) = setupBus()
    val orders = mutable.ArrayBuffer[Event]()
    val all = mutable.ArrayBuffer[Event]()
    collect(Eventbus.subscribeEvents(client,
      List(Eventbus.tagString(Tag.TOPIC, "orders"))), orders)
    collect(Eventbus.subscribeEvents(client, List.empty), all)
    waitFor(() => broker.stats()("subscribers") == 2L, "2 subscribers")
    check(Eventbus.publishEvent(client,
      List(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o1"), "test") == 1L,
      "seq 1")
    check(Eventbus.publishEvent(client,
      List(Eventbus.tagString(Tag.TOPIC, "other")), bytes("x1"), "test") == 2L,
      "seq 2")
    waitFor(() => orders.size == 1 && all.size == 2, "fanout")
    check(text(orders(0).payload) == "o1", "filtered payload")
    check(orders(0).publisherId == "test", "publisher")
    check(all(0).seq == 1L && all(1).seq == 2L, "all seqs")

    // -- kinds never cross-match --
    val (_, client2) = setupBus()
    val got = mutable.ArrayBuffer[Event]()
    collect(Eventbus.subscribeEvents(client2,
      List(Eventbus.tagInt(Tag.KIND, 5))), got)
    Eventbus.publishEvent(client2,
      List(Eventbus.tagString(Tag.KIND, "5")), bytes("s"), "")
    Eventbus.publishEvent(client2,
      List(Eventbus.tagEnum(Tag.KIND, 5)), bytes("e"), "")
    check(Eventbus.publishEvent(client2,
      List(Eventbus.tagInt(Tag.KIND, 5)), bytes("i"), "") == 3L, "seq 3")
    waitFor(() => got.size == 1, "kind match")
    check(text(got(0).payload) == "i", "int kind only")

    // -- user tags pass through (Tag is a plain Int) --
    val (_, client3) = setupBus()
    val got3 = mutable.ArrayBuffer[Event]()
    collect(Eventbus.subscribeEvents(client3,
      List(new TagValue(1004, "x", 0, 0.0, false, 0))), got3)
    Eventbus.publishEvent(client3,
      List(new TagValue(1004, "x", 0, 0.0, false, 0)), bytes("u"), "")
    waitFor(() => got3.size == 1, "user tag")
    check(got3(0).tags(0).tag == 1004, "user tag number")
    check(got3(0).tags(0).stringValue == "x", "user tag value")

    // -- slow subscriber drops oldest --
    val broker4 = new EventBusBroker(4)
    val sub = broker4.subscribeLocal(List.empty)
    for (i <- 1 to 6) broker4.publishEvent(List.empty, bytes("m" + i), "")
    check(broker4.stats()("dropped") == 2L, "dropped count")
    check(sub.dropped == 2, "sub dropped")
    val seqs = mutable.ArrayBuffer[Long]()
    for (_ <- 0 until 4) seqs += sub.take().seq
    check(seqs.toList == List(3L, 4L, 5L, 6L), "kept newest: " + seqs)
    sub.close()
    check(broker4.stats()("subscribers") == 0L, "close unregisters")

    // -- close unsubscribes (RPC) --
    val (broker5, client5) = setupBus()
    val stream = Eventbus.subscribeEvents(client5, List.empty)
    waitFor(() => broker5.stats()("subscribers") == 1L, "1 subscriber")
    Eventbus.publishEvent(client5, List.empty, bytes("a"), "")
    check(text(stream.recv().payload) == "a", "recv before close")
    stream.close()
    Eventbus.publishEvent(client5, List.empty, bytes("b"), "")
    waitFor(() => broker5.stats()("subscribers") == 0L, "reaped")

    // -- git log round-trip + idempotent --
    val repo = Files.createTempDirectory("grpc-dc-eventbus-").toFile
    val broker6 = new EventBusBroker()
    val events = List(
      broker6.publishEvent(
        List(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o1"), "test"),
      broker6.publishEvent(
        List(Eventbus.tagString(Tag.TOPIC, "other")), bytes("x1"), "test"),
      broker6.publishEvent(
        List(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o2"), "test"))
    val head1 = EventbusGit.exportEvents(repo.getPath, events)
    check(EventbusGit.gitText(repo.getPath,
      List("rev-list", "--count", "grpc-dc-events")) == "3", "commit count")
    check(EventbusGit.exportEvents(repo.getPath, events) == head1,
      "idempotent re-export")
    val imported = EventbusGit.importEvents(repo.getPath)
    check(imported.size == 3 && imported(0).seq == 1L && imported(2).seq == 3L,
      "import seqs")
    check(text(imported(0).payload) == "o1" && text(imported(2).payload) == "o2",
      "import payloads")
    val filtered = EventbusGit.importEvents(repo.getPath,
      EventbusGit.EVENT_LOG_BRANCH, 0, -1,
      List(Eventbus.tagString(Tag.TOPIC, "orders")))
    check(filtered.size == 2 && filtered(1).seq == 3L, "import filter")
    val window = EventbusGit.importEvents(repo.getPath,
      EventbusGit.EVENT_LOG_BRANCH, 1, 2, null)
    check(window.size == 1 && window(0).seq == 2L, "import window")

    println("TestEventBus OK")
  }
}
TPL
   ))

(define (emit-scala-demo)
  (string-append
   (scala-header)
   #<<TPL
// Event bus demo: a broker, one filtered subscriber, and
// three publishes over one in-memory data channel. Compile
// and run like the Kotlin demo:
//   scalac -d /tmp/eventbus_demo.jar scala/grpcdc/*.scala \
//     scala/examples/EventBusDemo.scala
//   scala -cp /tmp/eventbus_demo.jar examples.EventBusDemo

package examples

import grpcdc.Channel
import grpcdc.MemoryTransport
import grpcdc.Server
import grpcdc.events.v1.Eventbus
import grpcdc.events.v1.EventBusBroker
import grpcdc.events.v1.EventsGrpcDc
import grpcdc.events.v1.Tag
import java.nio.charset.StandardCharsets
import java.util.Collections
import scala.collection.mutable

object EventBusDemo {
  def main(args: Array[String]): Unit = {
    val broker = new EventBusBroker()
    val (a, b) = MemoryTransport.pair()
    val server = new Server()
    broker.register(server)
    server.serveTransport(b)
    val client = new EventsGrpcDc.EventBusClient(new Channel(a))

    val received = Collections.synchronizedList(
      new java.util.ArrayList[String]())
    val thread = new Thread {
      override def run(): Unit = {
        val stream = Eventbus.subscribeEvents(client,
          List(Eventbus.tagString(Tag.TOPIC, "orders")))
        while (received.size() < 2) {
          val ev = stream.recv()
          received.add("#" + ev.seq + " " +
            new String(ev.payload, StandardCharsets.UTF_8))
        }
        stream.close()
      }
    }
    thread.setDaemon(true)
    thread.start()
    while (broker.stats()("subscribers") < 1) Thread.sleep(5)
    Eventbus.publishEvent(client,
      List(Eventbus.tagString(Tag.TOPIC, "orders")),
      "order-1".getBytes(StandardCharsets.UTF_8), "demo")
    Eventbus.publishEvent(client,
      List(Eventbus.tagString(Tag.TOPIC, "other")),
      "noise".getBytes(StandardCharsets.UTF_8), "demo")
    Eventbus.publishEvent(client,
      List(Eventbus.tagString(Tag.TOPIC, "orders")),
      "order-2".getBytes(StandardCharsets.UTF_8), "demo")
    thread.join(5000)
    val parts = mutable.ArrayBuffer[String]()
    val it = received.iterator()
    while (it.hasNext) parts += it.next()
    println("subscriber got: " + parts.mkString(", "))
    println("broker stats: " + broker.stats())
  }
}
TPL
   ))

