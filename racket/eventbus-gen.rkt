   (java-header)
   #<<TPL
package tests;

// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

import grpcdc.Channel;
import grpcdc.MemoryTransport;
import grpcdc.Server;
import grpcdc.Transport;
import grpcdc.events.v1.Event;
import grpcdc.events.v1.EventBusBroker;
import grpcdc.events.v1.Eventbus;
import grpcdc.events.v1.EventbusGit;
import grpcdc.events.v1.EventsGrpcDc;
import grpcdc.events.v1.LocalSubscription;
import grpcdc.events.v1.Tag;
import grpcdc.events.v1.TagValue;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.List;
import java.util.function.BooleanSupplier;

public final class TestEventBus {
    private TestEventBus() {}

    private static void check(boolean condition, String what) {
        if (!condition) throw new AssertionError(what);
    }

    private static void waitFor(BooleanSupplier fn, String what) throws Exception {
        long deadline = System.currentTimeMillis() + 5000;
        while (!fn.getAsBoolean()) {
            if (System.currentTimeMillis() > deadline) {
                throw new AssertionError("waitFor timed out: " + what);
            }
            Thread.sleep(5);
        }
    }

    private static Object[] setupBus() {
        EventBusBroker broker = new EventBusBroker();
        Transport[] pair = MemoryTransport.pair();
        Server server = new Server();
        broker.register(server);
        server.serveTransport(pair[1]);
        return new Object[]{broker,
                new EventsGrpcDc.EventBusClient(new Channel(pair[0]))};
    }

    private static Thread collect(EventsGrpcDc.EventBusSubscribeStream stream,
                                  List<Event> out) {
        Thread thread = new Thread(() -> {
            try {
                while (true) out.add(stream.recv());
            } catch (Exception e) {
                // stream closed
            }
        });
        thread.setDaemon(true);
        thread.start();
        return thread;
    }

    private static byte[] bytes(String s) {
        return s.getBytes(StandardCharsets.UTF_8);
    }

    private static String text(byte[] b) {
        return new String(b, StandardCharsets.UTF_8);
    }

    public static void main(String[] args) throws Exception {
        // -- tagsMatch: containment, kinds, empty --
        List<TagValue> tags = List.of(
                Eventbus.tagString(Tag.TOPIC, "orders"),
                Eventbus.tagInt(Tag.KIND, 5));
        check(Eventbus.tagsMatch(tags, List.of()), "empty filter matches");
        check(Eventbus.tagsMatch(tags,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders"))), "containment");
        check(Eventbus.tagsMatch(tags, tags), "self match");
        check(!Eventbus.tagsMatch(tags,
                List.of(Eventbus.tagEnum(Tag.KIND, 5))), "int != enum");
        check(!Eventbus.tagsMatch(tags,
                List.of(Eventbus.tagString(Tag.KIND, "5"))), "int != string");
        check(!Eventbus.tagsMatch(tags,
                List.of(Eventbus.tagString(Tag.TOPIC, "other"))), "value mismatch");

        // -- fan-out honors filters --
        Object[] bus = setupBus();
        EventBusBroker broker = (EventBusBroker) bus[0];
        EventsGrpcDc.EventBusClient client = (EventsGrpcDc.EventBusClient) bus[1];
        List<Event> orders = new ArrayList<>();
        List<Event> all = new ArrayList<>();
        collect(Eventbus.subscribeEvents(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders"))), orders);
        collect(Eventbus.subscribeEvents(client, List.of()), all);
        waitFor(() -> broker.stats().get("subscribers") == 2L, "2 subscribers");
        check(Eventbus.publishEvent(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders")),
                bytes("o1"), "test") == 1, "seq 1");
        check(Eventbus.publishEvent(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "other")),
                bytes("x1"), "test") == 2, "seq 2");
        waitFor(() -> orders.size() == 1 && all.size() == 2, "fanout");
        check(text(orders.get(0).payload).equals("o1"), "filtered payload");
        check(orders.get(0).publisherId.equals("test"), "publisher");
        check(all.get(0).seq == 1 && all.get(1).seq == 2, "all seqs");

        // -- kinds never cross-match --
        Object[] bus2 = setupBus();
        EventsGrpcDc.EventBusClient client2 = (EventsGrpcDc.EventBusClient) bus2[1];
        List<Event> got = new ArrayList<>();
        collect(Eventbus.subscribeEvents(client2,
                List.of(Eventbus.tagInt(Tag.KIND, 5))), got);
        Eventbus.publishEvent(client2,
                List.of(Eventbus.tagString(Tag.KIND, "5")), bytes("s"), "");
        Eventbus.publishEvent(client2,
                List.of(Eventbus.tagEnum(Tag.KIND, 5)), bytes("e"), "");
        check(Eventbus.publishEvent(client2,
                List.of(Eventbus.tagInt(Tag.KIND, 5)), bytes("i"), "") == 3, "seq 3");
        waitFor(() -> got.size() == 1, "kind match");
        check(text(got.get(0).payload).equals("i"), "int kind only");

        // (No user-tag pass-through leg: the generated Tag is a
        // closed Java enum; see Eventbus.java. Own tags arrive
        // by regenerating from an extended events.proto copy.)

        // -- slow subscriber drops oldest --
        EventBusBroker broker4 = new EventBusBroker(4);
        LocalSubscription sub = broker4.subscribeLocal(List.of());
        for (int i = 1; i <= 6; i++) broker4.publishEvent(List.of(), bytes("m" + i), "");
        check(broker4.stats().get("dropped") == 2L, "dropped count");
        check(sub.dropped() == 2, "sub dropped");
        List<Long> seqs = new ArrayList<>();
        for (int i = 0; i < 4; i++) seqs.add(sub.take().seq);
        check(seqs.equals(List.of(3L, 4L, 5L, 6L)), "kept newest: " + seqs);
        sub.close();
        check(broker4.stats().get("subscribers") == 0L, "close unregisters");

        // -- close unsubscribes (RPC) --
        Object[] bus5 = setupBus();
        EventBusBroker broker5 = (EventBusBroker) bus5[0];
        EventsGrpcDc.EventBusClient client5 = (EventsGrpcDc.EventBusClient) bus5[1];
        EventsGrpcDc.EventBusSubscribeStream stream =
                Eventbus.subscribeEvents(client5, List.of());
        waitFor(() -> broker5.stats().get("subscribers") == 1L, "1 subscriber");
        Eventbus.publishEvent(client5, List.of(), bytes("a"), "");
        check(text(stream.recv().payload).equals("a"), "recv before close");
        stream.close();
        Eventbus.publishEvent(client5, List.of(), bytes("b"), "");
        waitFor(() -> broker5.stats().get("subscribers") == 0L, "reaped");

        // -- git log round-trip + idempotent --
        File repo = Files.createTempDirectory("grpc-dc-eventbus-").toFile();
        EventBusBroker broker6 = new EventBusBroker();
        List<Event> events = List.of(
                broker6.publishEvent(
                        List.of(Eventbus.tagString(Tag.TOPIC, "orders")),
                        bytes("o1"), "test"),
                broker6.publishEvent(
                        List.of(Eventbus.tagString(Tag.TOPIC, "other")),
                        bytes("x1"), "test"),
                broker6.publishEvent(
                        List.of(Eventbus.tagString(Tag.TOPIC, "orders")),
                        bytes("o2"), "test"));
        String head1 = EventbusGit.exportEvents(repo.getPath(), events);
        check(EventbusGit.gitText(repo.getPath(),
                List.of("rev-list", "--count", "grpc-dc-events"), null, null)
                .equals("3"), "commit count");
        check(EventbusGit.exportEvents(repo.getPath(), events).equals(head1),
                "idempotent re-export");
        List<Event> imported = EventbusGit.importEvents(repo.getPath());
        check(imported.size() == 3
                && imported.get(0).seq == 1 && imported.get(2).seq == 3,
                "import seqs");
        check(text(imported.get(0).payload).equals("o1")
                && text(imported.get(2).payload).equals("o2"), "import payloads");
        List<Event> filtered = EventbusGit.importEvents(repo.getPath(),
                EventbusGit.EVENT_LOG_BRANCH, 0, null,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders")));
        check(filtered.size() == 2 && filtered.get(1).seq == 3, "import filter");
        List<Event> window = EventbusGit.importEvents(repo.getPath(),
                EventbusGit.EVENT_LOG_BRANCH, 1, 2L, null);
        check(window.size() == 1 && window.get(0).seq == 2, "import window");

        System.out.println("TestEventBus OK");
    }
}
TPL
