(define (emit-java-broker)
  (string-append
   (java-header)
   #<<TPL
package grpcdc.events.v1;

// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: register() it on a grpcdc.Server next to your own
// services, or call publishEvent() directly in-process.

import grpcdc.Endpoint;
import grpcdc.Server;
import java.util.ArrayDeque;
import java.util.ArrayList;
import java.util.Deque;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public final class EventBusBroker implements EventsGrpcDc.EventBusServer {
    static final class Subscriber {
        final List<TagValue> filter;
        final int capacity;
        final Deque<Event> queue = new ArrayDeque<>();
        int dropped = 0;

        Subscriber(List<TagValue> filter, int capacity) {
            this.filter = filter == null ? new ArrayList<>() : filter;
            this.capacity = capacity;
        }

        synchronized boolean push(Event event) {
            boolean wasDropped = false;
            if (queue.size() >= capacity) {
                queue.pollFirst();
                dropped++;
                wasDropped = true;
            }
            queue.addLast(event);
            notifyAll();
            return wasDropped;
        }

        // Next queued event, or null when the wait times out.
        // The broker re-checks every tick; a cancelled call is
        // reaped when its next matching send fails (the
        // runtime surfaces cancellation only at send time).
        synchronized Event take(long timeoutMs) throws InterruptedException {
            long deadline = System.currentTimeMillis() + timeoutMs;
            while (queue.isEmpty()) {
                long remaining = deadline - System.currentTimeMillis();
                if (remaining <= 0) return null;
                wait(remaining);
            }
            return queue.pollFirst();
        }

        synchronized int droppedCount() {
            return dropped;
        }
    }

    private final int queueCapacity;
    private final List<Subscriber> subscribers = new ArrayList<>();
    private long seq = 0;
    private long published = 0;
    private long dropped = 0;

    public EventBusBroker() {
        this(Eventbus.SUBSCRIBER_QUEUE_CAPACITY);
    }

    public EventBusBroker(int queueCapacity) {
        this.queueCapacity = queueCapacity;
    }

    // Accept an event: assign its sequence number and
    // timestamp and fan it out to matching subscribers.
    // Returns the stamped Event.
    public synchronized Event publishEvent(List<TagValue> tags, byte[] payload,
                                            String publisherId) {
        seq++;
        Event event = new Event(
                tags == null ? new ArrayList<>() : new ArrayList<>(tags),
                payload == null ? new byte[0] : payload,
                seq,
                publisherId == null ? "" : publisherId,
                System.currentTimeMillis());
        published++;
        for (Subscriber sub : new ArrayList<>(subscribers)) {
            if (Eventbus.tagsMatch(event.tags, sub.filter) && sub.push(event)) {
                dropped++;
            }
        }
        return event;
    }

    public synchronized Map<String, Long> stats() {
        Map<String, Long> stats = new HashMap<>();
        stats.put("published", published);
        stats.put("subscribers", (long) subscribers.size());
        stats.put("dropped", dropped);
        return stats;
    }

    // grpcdc.events.v1.EventBus service implementation
    // (register calls these).
    @Override
    public PublishReply Publish(Endpoint.CallContext ctx, PublishRequest req) {
        Event event = publishEvent(req.tags, req.payload, req.publisherId);
        return new PublishReply(event.seq);
    }

    @Override
    public void Subscribe(SubscribeRequest req,
                          EventsGrpcDc.EventBusSubscribeServer stream) throws Exception {
        Subscriber sub = new Subscriber(req.filter, queueCapacity);
        synchronized (this) {
            subscribers.add(sub);
        }
        try {
            while (true) {
                Event event = sub.take(100);
                if (event != null) stream.send(event);
            }
        } finally {
            synchronized (this) {
                subscribers.remove(sub);
            }
        }
    }

    // In-process subscription: events fan out to it exactly
    // like an RPC subscriber, without a call. Useful embedded
    // and for tests; close() unregisters.
    public LocalSubscription subscribeLocal(List<TagValue> filterTags) {
        Subscriber sub = new Subscriber(filterTags, queueCapacity);
        synchronized (this) {
            subscribers.add(sub);
        }
        return new LocalSubscription(this, sub);
    }

    synchronized void removeSubscriber(Subscriber sub) {
        subscribers.remove(sub);
    }

    public EventBusBroker register(Server server) {
        EventsGrpcDc.registerEventBusServer(server, this);
        return this;
    }
}
TPL
   ))

