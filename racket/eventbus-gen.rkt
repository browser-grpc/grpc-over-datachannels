(define (emit-lua-gitlog)
  (string-append
   (lua-header)
   (format #<<TPL
-- Git log serde for the event bus: exports an event log to
-- a git branch (one commit per event) and imports it back.
-- The live broker never touches git; this is the durable
-- serde layer beside it. Stdlib io/os drives the git
-- plumbing through temp files (Lua has no bidirectional
-- popen; this is the documented Lua process caveat).
--
-- Deterministic: the same events always produce the same
-- commits, so re-exporting a log the branch already has is
-- a no-op (each event's sequence number is the dedup key).
-- The commit blob (~a) is authoritative; the message
-- subject and trailers are a human index for `git log`.

local eventbus = require("grpcdc.eventbus")
local messages = require("examples.events_messages")

local Event = messages.Event

local M = {}

M.AUTHOR_NAME = "~a"
M.AUTHOR_EMAIL = "~a"
M.BLOB_PATH = "~a"
M.COMMIT_SUBJECT = "~a"
M.TRAILER_SEQ = "~a"
M.TRAILER_PUBLISHER = "~a"
M.TRAILER_TAG = "~a"
M.ZERO_SHA = "0000000000000000000000000000000000000000"

M.EVENT_LOG_BRANCH = "grpc-dc-events"

local function shellQuote(s)
  return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local tmpCounter = 0
local function tmpPath()
  tmpCounter = tmpCounter + 1
  return os.tmpname() .. ".grpcdc" .. tostring(tmpCounter)
end

local function writeFile(path, bytes)
  local f = assert(io.open(path, "wb"))
  f:write(bytes)
  f:close()
end

local function readFile(path)
  local f = io.open(path, "rb")
  if f == nil then return "" end
  local data = f:read("a") or ""
  f:close()
  return data
end

-- Run git in repo; args is an array of argv strings. stdin
-- bytes go through a temp file when given; stdout is
-- captured through one as well. envExtra is a {NAME=value}
-- table applied via env(1). Raises on non-zero exit.
function M.git(repo, args, inputBytes, envExtra)
  local parts = {}
  if envExtra ~~= nil then
    parts[#parts + 1] = "env"
    for k, v in pairs(envExtra) do
      parts[#parts + 1] = shellQuote(k .. "=" .. v)
    end
  end
  parts[#parts + 1] = "git"
  parts[#parts + 1] = "-C"
  parts[#parts + 1] = shellQuote(repo)
  for _, a in ipairs(args) do
    parts[#parts + 1] = shellQuote(a)
  end
  local cmd = table.concat(parts, " ")
  local inPath, outPath = nil, tmpPath()
  if inputBytes ~~= nil then
    inPath = tmpPath()
    writeFile(inPath, inputBytes)
    cmd = cmd .. " < " .. shellQuote(inPath)
  end
  cmd = cmd .. " > " .. shellQuote(outPath)
  local ok = os.execute(cmd)
  local out = readFile(outPath)
  os.remove(outPath)
  if inPath ~~= nil then os.remove(inPath) end
  if ok ~~= true then
    error("git " .. tostring(args[1]) .. " failed in " .. repo, 0)
  end
  return out
end

function M.gitText(repo, args, inputBytes, envExtra)
  local out = M.git(repo, args, inputBytes, envExtra)
  return (out:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- Create the log repo if needed (a plain `git init`).
function M.initEventLogRepo(repo)
  local ok = pcall(M.gitText, repo, { "rev-parse", "--git-dir" })
  if not ok then
    local ok2 = os.execute("git init -q " .. shellQuote(repo))
    if ok2 ~~= true then error("git init failed for " .. repo, 0) end
  end
end

function M.branchHead(repo, branch)
  local ok, head = pcall(M.gitText, repo,
    { "rev-parse", "--verify", "refs/heads/" .. branch })
  if not ok then return nil end
  return head
end

-- "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
-- `git log` alone can filter the log without decoding blobs.
function M.commitMessage(event)
  local lines = {
    M.COMMIT_SUBJECT .. " " .. tostring(event.seq),
    "",
    M.TRAILER_SEQ .. ": " .. tostring(event.seq),
  }
  if event.publisherId ~~= "" then
    lines[#lines + 1] = M.TRAILER_PUBLISHER .. ": " .. event.publisherId
  end
  for _, tv in ipairs(event.tags or {}) do
    lines[#lines + 1] = M.TRAILER_TAG .. ": " .. eventbus.tagValueKey(tv)
  end
  return table.concat(lines, "\n") .. "\n"
end

function M.commitEnv(event)
  local seconds = math.max(0, math.floor(event.timestampUnixMs / 1000))
  local date = tostring(seconds) .. " +0000"
  return {
    GIT_AUTHOR_NAME = M.AUTHOR_NAME,
    GIT_AUTHOR_EMAIL = M.AUTHOR_EMAIL,
    GIT_COMMITTER_NAME = M.AUTHOR_NAME,
    GIT_COMMITTER_EMAIL = M.AUTHOR_EMAIL,
    GIT_AUTHOR_DATE = date,
    GIT_COMMITTER_DATE = date,
  }
end

-- Import a branch: events in chain order (oldest first),
-- optionally windowed by sequence number and narrowed by a
-- tag filter (same containment semantics as Subscribe). A
-- missing branch imports as an empty log.
function M.importEvents(repo, branch, fromSeq, toSeq, filterTags)
  branch = branch or M.EVENT_LOG_BRANCH
  if M.branchHead(repo, branch) == nil then return {} end
  local events = {}
  local list = M.gitText(repo, { "rev-list", "--reverse", branch })
  for sha in list:gmatch("[^\n]+") do
    local data = M.git(repo, { "cat-file", "-p", sha .. ":" .. M.BLOB_PATH })
    local event = Event.new()
    event:unmarshalDc(data)
    local skip = false
    if fromSeq ~~= nil and event.seq <= fromSeq then skip = true end
    if toSeq ~~= nil and event.seq > toSeq then skip = true end
    if filterTags ~~= nil and not eventbus.tagsMatch(event.tags, filterTags) then
      skip = true
    end
    if not skip then events[#events + 1] = event end
  end
  return events
end

-- Export events onto the branch: one commit per event, in
-- sequence order, skipping sequence numbers the branch
-- already has. Returns the new head sha (or the existing
-- one when nothing was appended). The ref update is a
-- compare-and-swap: a concurrent exporter fails loudly
-- instead of forking the log; retrying is safe.
function M.exportEvents(repo, events, branch)
  branch = branch or M.EVENT_LOG_BRANCH
  M.initEventLogRepo(repo)
  local existing = {}
  for _, e in ipairs(M.importEvents(repo, branch)) do
    existing[e.seq] = true
  end
  local ordered = {}
  for _, e in ipairs(events) do ordered[#ordered + 1] = e end
  table.sort(ordered, function(a, b) return a.seq < b.seq end)
  local head = M.branchHead(repo, branch)
  local before = head
  for _, event in ipairs(ordered) do
    if not existing[event.seq] then
      local blobPath = tmpPath()
      writeFile(blobPath, event:marshalDc())
      local blob = M.gitText(repo, { "hash-object", "-w", blobPath })
      os.remove(blobPath)
      local tree = M.gitText(repo, { "mktree" },
        "100644 blob " .. blob .. "\t" .. M.BLOB_PATH .. "\n")
      local msgPath = tmpPath()
      writeFile(msgPath, M.commitMessage(event))
      local args = { "commit-tree", tree, "-F", msgPath }
      if head ~~= nil then
        args[#args + 1] = "-p"
        args[#args + 1] = head
      end
      head = M.gitText(repo, args, nil, M.commitEnv(event))
      os.remove(msgPath)
      existing[event.seq] = true
    end
  end
  if head ~~= nil and head ~~= before then
    M.gitText(repo, { "update-ref", "refs/heads/" .. branch, head,
      before or M.ZERO_SHA })
  end
  return head
end

return M
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

(define (emit-lua-test)
  (string-append
   (lua-header)
   #<<TPL
-- Event bus end-to-end (Publish over loopback + Subscribe
-- against a spawned broker process, since Lua server
-- dispatch is synchronous), plus the git log serde
-- round-trip.

local channelModule = require("grpcdc.channel")
local serverModule = require("grpcdc.server")
local memoryModule = require("grpcdc.memory_transport")
local eventbus = require("grpcdc.eventbus")
local eventbusGit = require("grpcdc.eventbus_git")
local messages = require("examples.events_messages")
local util = require("test_util")

local EB = eventbus
local GIT = eventbusGit
local Tag = messages.Tag

local function eq(got, want, what)
  util.check(got == want,
    (what or "eq") .. ": got " .. tostring(got) .. ", want " .. tostring(want))
end

local function run()
  -- tagsMatch: containment, kinds, empty
  local tags = { EB.tagString(Tag.TOPIC, "orders"), EB.tagInt(Tag.KIND, 5) }
  util.check(EB.tagsMatch(tags, {}), "empty filter matches")
  util.check(EB.tagsMatch(tags, { EB.tagString(Tag.TOPIC, "orders") }), "containment")
  util.check(EB.tagsMatch(tags, tags), "self match")
  util.check(not EB.tagsMatch(tags, { EB.tagEnum(Tag.KIND, 5) }), "int ~= enum")
  util.check(not EB.tagsMatch(tags, { EB.tagString(Tag.KIND, "5") }), "int ~= string")
  util.check(not EB.tagsMatch(tags, { EB.tagString(Tag.TOPIC, "other") }), "value mismatch")

  -- Publish RPC + fan-out in-process via subscribeLocal
  local broker = EB.EventBusBroker.new()
  local a, b = memoryModule.memoryTransportPair()
  local server = serverModule.Server.new()
  broker:register(server)
  server:serveTransport(b)
  local client = EB.EventBusClient.new(channelModule.Channel.new(a))
  local localSub = broker:subscribeLocal({ EB.tagString(Tag.TOPIC, "orders") })
  eq(EB.publishEvent(client, { EB.tagString(Tag.TOPIC, "orders") }, "o1", "test"), 1, "seq 1")
  eq(EB.publishEvent(client, { EB.tagString(Tag.TOPIC, "other") }, "x1", "test"), 2, "seq 2")
  eq(EB.publishEvent(client, { EB.tagString(Tag.TOPIC, "orders") }, "o2", "test"), 3, "seq 3")
  eq(localSub:take(1.0).payload, "o1", "local filtered 1")
  eq(localSub:take(1.0).payload, "o2", "local filtered 2")
  localSub:close()
  eq(broker:stats().subscribers, 0, "local close unregisters")

  -- kinds never cross-match (in-process)
  local broker2 = EB.EventBusBroker.new()
  local kinds = broker2:subscribeLocal({ EB.tagInt(Tag.KIND, 5) })
  broker2:publishEvent({ EB.tagString(Tag.KIND, "5") }, "s")
  broker2:publishEvent({ EB.tagEnum(Tag.KIND, 5) }, "e")
  broker2:publishEvent({ EB.tagInt(Tag.KIND, 5) }, "i")
  eq(kinds:take(1.0).payload, "i", "int kind only")
  kinds:close()

  -- user tags pass through (in-process)
  local broker3 = EB.EventBusBroker.new()
  local mine = messages.TagValue.new(1004, "x")
  local userSub = broker3:subscribeLocal({ mine })
  broker3:publishEvent({ messages.TagValue.new(1004, "x") }, "u")
  local userEvent = userSub:take(1.0)
  eq(userEvent.tags[1].tag, 1004, "user tag number")
  eq(userEvent.tags[1].stringValue, "x", "user tag value")
  userSub:close()

  -- slow subscriber drops oldest
  local broker4 = EB.EventBusBroker.new(4)
  local sub = broker4:subscribeLocal({})
  for i = 1, 6 do broker4:publishEvent({}, "m" .. i) end
  eq(broker4:stats().dropped, 2, "dropped count")
  eq(sub:droppedCount(), 2, "sub dropped")
  local seqs = {}
  for _ = 1, 4 do seqs[#seqs + 1] = sub:take(1.0).seq end
  eq(table.concat(seqs, ","), "3,4,5,6", "kept newest")
  sub:close()
  eq(broker4:stats().subscribers, 0, "close unregisters")

  -- Subscribe RPC against a spawned broker process: Lua
  -- server dispatch is synchronous, so the broker loops in
  -- its own process (examples/eventbus_server_stdio.lua)
  -- and this test drives it over FIFO pipes.
  local root = util.root()
  local luaExe = (arg and arg[-1]) or "lua"
  local cmd = luaExe .. " " .. root .. "/lua/examples/eventbus_server_stdio.lua"
  local spawned = util.spawnPipe(cmd)
  if spawned == nil then
    print("TestEventBus SKIP (broker process did not start)")
    return
  end
  local ok, err = pcall(function()
    local rpcClient = EB.EventBusClient.new(
      channelModule.Channel.new(spawned.transport))
    -- Lua dispatch is synchronous: the second Subscribe
    -- handler runs nested inside the first handler's pump,
    -- so subscribe the catch-all first (its handler ends up
    -- at the bottom of the pump stack) and the filtered one
    -- second (its handler is the active one). Recv from the
    -- filtered stream first, close it, then one more publish
    -- reaps its handler (send to the closed stream fails) and
    -- the catch-all handler resumes underneath.
    local all = EB.subscribeEvents(rpcClient, {})
    local orders = EB.subscribeEvents(rpcClient,
      { EB.tagString(Tag.TOPIC, "orders") })
    eq(EB.publishEvent(rpcClient,
      { EB.tagString(Tag.TOPIC, "orders") }, "o1", "test"), 1, "rpc seq 1")
    eq(EB.publishEvent(rpcClient,
      { EB.tagString(Tag.TOPIC, "other") }, "x1", "test"), 2, "rpc seq 2")
    local filtered = orders:recv()
    eq(filtered.payload, "o1", "rpc filtered payload")
    eq(filtered.publisherId, "test", "rpc publisher")
    orders:close()
    eq(EB.publishEvent(rpcClient,
      { EB.tagString(Tag.TOPIC, "orders") }, "o2", "test"), 3, "rpc seq 3")
    eq(all:recv().seq, 1, "rpc all 1")
    eq(all:recv().seq, 2, "rpc all 2")
    eq(all:recv().payload, "o2", "rpc all 3")
    all:close()
  end)
  util.kill(spawned.pid)
  if not ok then error(err, 0) end

  -- git log round-trip + idempotent
  local repo = util.tmpdir()
  local broker6 = EB.EventBusBroker.new()
  local events = {
    broker6:publishEvent({ EB.tagString(Tag.TOPIC, "orders") }, "o1", "test"),
    broker6:publishEvent({ EB.tagString(Tag.TOPIC, "other") }, "x1", "test"),
    broker6:publishEvent({ EB.tagString(Tag.TOPIC, "orders") }, "o2", "test"),
  }
  local head1 = GIT.exportEvents(repo, events)
  eq(GIT.gitText(repo, { "rev-list", "--count", "grpc-dc-events" }), "3", "commit count")
  eq(GIT.exportEvents(repo, events), head1, "idempotent re-export")
  local imported = GIT.importEvents(repo)
  eq(#imported, 3, "import count")
  eq(imported[1].payload, "o1", "import payload 1")
  eq(imported[3].payload, "o2", "import payload 3")
  local filtered = GIT.importEvents(repo, nil, nil, nil,
    { EB.tagString(Tag.TOPIC, "orders") })
  eq(#filtered, 2, "import filter count")
  eq(filtered[2].seq, 3, "import filter seq")
  local window = GIT.importEvents(repo, nil, 1, 2)
  eq(#window, 1, "import window count")
  eq(window[1].seq, 2, "import window seq")

  print("TestEventBus OK")
end

return run
TPL
