            while (true) {
                $event = $sub->take(0.1);
                if ($event !== null) {
                    $stream->send($event);
                }
            }
        } finally {
            $this->removeSubscriber($sub);
        }
    }

    // In-process subscription: events fan out to it exactly
    // like an RPC subscriber, without a call. Useful embedded
    // and for tests; close() unregisters.
    public function subscribeLocal(array $filterTags): LocalSubscription
    {
        $sub = new EventbusSubscriber($filterTags, $this->queueCapacity);
        $this->subscribers[] = $sub;
        return new LocalSubscription($this, $sub);
    }

    public function removeSubscriber(EventbusSubscriber $sub): void
    {
        $this->subscribers = array_values(array_filter(
            $this->subscribers,
            fn ($s) => $s !== $sub
        ));
    }

    public function register(\Grpcdc\Server $server): self
    {
        \EventsGrpcDc\registerEventBusServer($server, $this);
        return $this;
    }
}

