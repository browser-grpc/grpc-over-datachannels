(define (emit-rust-test)
  (string-append
   (rust-header)
   #<<TPL
//! Event bus end-to-end (loopback): the generated stub client
//! against the generated broker, plus the git log serde
//! round-trip.

#[path = "../gen/events_pb.rs"]
mod pb;

#[path = "../gen/events_grpc_dc.rs"]
mod stub;

use futures_util::StreamExt;
use grpc_dc::eventbus::{tag_string, EventBusBroker};
use grpc_dc::{loopback_pair, Channel, DcTransport, Message, Server};
use pb::{Event, PublishReply, PublishRequest, SubscribeRequest, Tag, TagValue};
use std::sync::Arc;
use std::time::Duration;
use stub::EventBusClient;

macro_rules! impl_message {
    ($t:ty) => {
        impl Message for $t {
            fn encode(&self) -> Vec<u8> {
                <$t>::encode(self)
            }
            fn decode(bytes: &[u8]) -> Result<Self, grpc_dc::Status> {
                <$t>::decode(bytes).map_err(grpc_dc::Status::invalid_argument)
            }
        }
    };
}
impl_message!(TagValue);
impl_message!(PublishRequest);
impl_message!(PublishReply);
impl_message!(SubscribeRequest);
impl_message!(Event);

fn tv_string(tag: Tag, value: &str) -> TagValue {
    TagValue { tag, string_value: value.to_string(), ..Default::default() }
}

async fn setup() -> (Arc<EventBusBroker>, EventBusClient) {
    let broker = Arc::new(EventBusBroker::new());
    let (a, b) = loopback_pair();
    let server_transport: Arc<dyn DcTransport> = Arc::new(b);
    tokio::spawn(Server::serve(server_transport, vec![broker.service()]));
    let client_transport: Arc<dyn DcTransport> = Arc::new(a);
    (broker.clone(), EventBusClient::new(Channel::new(client_transport)))
}

async fn wait_subscribers(broker: &EventBusBroker, want: u64) {
    let deadline = std::time::Instant::now() + Duration::from_secs(5);
    while broker.stats().subscribers != want {
        assert!(
            std::time::Instant::now() < deadline,
            "subscriber count stuck at {}",
            broker.stats().subscribers
        );
        tokio::time::sleep(Duration::from_millis(10)).await;
    }
}

async fn publish(client: &EventBusClient, tags: Vec<TagValue>, payload: &str, publisher: &str) -> u64 {
    client
        .publish(PublishRequest {
            tags,
            payload: payload.as_bytes().to_vec(),
            publisher_id: publisher.to_string(),
            ..Default::default()
        })
        .await
        .unwrap()
        .seq
}

#[tokio::test]
async fn fanout_honors_filters() {
    let (broker, client) = setup().await;
    let mut orders = client
        .subscribe(SubscribeRequest { filter: vec![tv_string(Tag::Topic, "orders")], ..Default::default() })
        .await
        .unwrap();
    let mut all = client.subscribe(SubscribeRequest::default()).await.unwrap();
    wait_subscribers(&broker, 2).await;
    assert_eq!(publish(&client, vec![tv_string(Tag::Topic, "orders")], "o1", "test").await, 1);
    assert_eq!(publish(&client, vec![tv_string(Tag::Topic, "other")], "x1", "test").await, 2);
    let first = orders.next().await.unwrap().unwrap();
    assert_eq!(first.payload, b"o1");
    assert_eq!(first.publisher_id, "test");
    let a1 = all.next().await.unwrap().unwrap();
    let a2 = all.next().await.unwrap().unwrap();
    assert_eq!((a1.seq, a2.seq), (1, 2));
}

#[tokio::test]
async fn kinds_never_cross_match() {
    let (broker, client) = setup().await;
    let mut got = client
        .subscribe(SubscribeRequest {
            filter: vec![TagValue { tag: Tag::Kind, int_value: 5, ..Default::default() }],
            ..Default::default()
        })
        .await
        .unwrap();
    wait_subscribers(&broker, 1).await;
    publish(&client, vec![TagValue { tag: Tag::Kind, string_value: "5".into(), ..Default::default() }], "s", "").await;
    publish(&client, vec![TagValue { tag: Tag::Kind, enum_value: 5, ..Default::default() }], "e", "").await;
    assert_eq!(
        publish(&client, vec![TagValue { tag: Tag::Kind, int_value: 5, ..Default::default() }], "i", "").await,
        3
    );
    let event = got.next().await.unwrap().unwrap();
    assert_eq!(event.payload, b"i");
}

#[tokio::test]
async fn user_tags_pass_through() {
    let (broker, client) = setup().await;
    let mine = || TagValue { tag: Tag::Unknown(1004), string_value: "x".into(), ..Default::default() };
    let mut got = client
        .subscribe(SubscribeRequest { filter: vec![mine()], ..Default::default() })
        .await
        .unwrap();
    wait_subscribers(&broker, 1).await;
    publish(&client, vec![mine()], "u", "").await;
    let event = got.next().await.unwrap().unwrap();
    assert_eq!(event.tags[0].tag, Tag::Unknown(1004));
    assert_eq!(event.tags[0].string_value, "x");
}

#[tokio::test]
async fn slow_subscriber_drops_oldest() {
    let mut broker = EventBusBroker::new();
    broker.queue_capacity = 4;
    let broker = Arc::new(broker);
    let sub = broker.subscribe_local(vec![]);
    for i in 1..=6 {
        broker.publish_event(vec![], format!("m{i}").into_bytes(), "");
    }
    assert_eq!(broker.stats().dropped, 2);
    assert_eq!(sub.dropped(), 2);
    for want in 3..=6u64 {
        assert_eq!(sub.try_recv().unwrap().seq, want);
    }
    drop(sub);
    assert_eq!(broker.stats().subscribers, 0);
}

#[tokio::test]
async fn dropping_stream_unsubscribes() {
    let (broker, client) = setup().await;
    let mut stream = client.subscribe(SubscribeRequest::default()).await.unwrap();
    wait_subscribers(&broker, 1).await;
    publish(&client, vec![], "a", "").await;
    assert_eq!(stream.next().await.unwrap().unwrap().payload, b"a");
    drop(stream);
    publish(&client, vec![], "b", "").await;
    wait_subscribers(&broker, 0).await;
}

#[test]
fn git_log_round_trip() {
    use grpc_dc::eventbus::pb as buspb;
    let dir = std::env::temp_dir().join(format!("grpc-dc-eventbus-{}", std::process::id()));
    let _ = std::fs::remove_dir_all(&dir);
    let broker = EventBusBroker::new();
    let events = vec![
        broker.publish_event(vec![tag_string(buspb::Tag::Topic, "orders")], b"o1".to_vec(), "test"),
        broker.publish_event(vec![tag_string(buspb::Tag::Topic, "other")], b"x1".to_vec(), "test"),
        broker.publish_event(vec![tag_string(buspb::Tag::Topic, "orders")], b"o2".to_vec(), "test"),
    ];
    let head1 = grpc_dc::eventbus_git::export_events(&dir, &events, grpc_dc::eventbus_git::EVENT_LOG_BRANCH).unwrap();
    let count = std::process::Command::new("git")
        .arg("-C")
        .arg(&dir)
        .args(["rev-list", "--count", "grpc-dc-events"])
        .output()
        .unwrap();
    assert_eq!(String::from_utf8_lossy(&count.stdout).trim(), "3");
    let head2 = grpc_dc::eventbus_git::export_events(&dir, &events, grpc_dc::eventbus_git::EVENT_LOG_BRANCH).unwrap();
    assert_eq!(head1, head2);
    let all = grpc_dc::eventbus_git::import_events(&dir, "grpc-dc-events", &[], 0, 0).unwrap();
    assert_eq!(all.iter().map(|e| e.seq).collect::<Vec<_>>(), vec![1, 2, 3]);
    assert_eq!(all.iter().map(|e| e.payload.clone()).collect::<Vec<_>>(), vec![b"o1".to_vec(), b"x1".to_vec(), b"o2".to_vec()]);
    assert!(all.iter().all(|e| e.publisher_id == "test"));
    let orders = grpc_dc::eventbus_git::import_events(
        &dir,
        "grpc-dc-events",
        &[tag_string(buspb::Tag::Topic, "orders")],
        0,
        0,
    )
    .unwrap();
    assert_eq!(orders.iter().map(|e| e.seq).collect::<Vec<_>>(), vec![1, 3]);
    let window = grpc_dc::eventbus_git::import_events(&dir, "grpc-dc-events", &[], 1, 2).unwrap();
    assert_eq!(window.iter().map(|e| e.seq).collect::<Vec<_>>(), vec![2]);
    let _ = std::fs::remove_dir_all(&dir);
}
