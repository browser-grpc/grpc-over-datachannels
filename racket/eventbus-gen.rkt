-- Event bus (grpcdc.events.v1.EventBus): in-memory broker,
-- client helpers, and tag matching. Wire messages and stubs
-- are generated from proto/events.proto (examples.events_*);
-- the broker policy comes from the shared event-bus spec.
--
-- Delivery is at-most-once: each subscriber has a bounded
-- queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
-- events when it falls behind; stats reports the drops.
--
-- Lua server dispatch is synchronous, so the Subscribe
-- handler loops polling its queue and pumping the endpoint
-- (broker.pumpFn, wired by the host after serveTransport) --
-- the same reentrant-pump pattern as the interop impl. Host
-- the broker in a dedicated serving loop (see
-- examples/eventbus_server_stdio.lua); in-process, Publish
-- and subscribeLocal work without it.

local messages = require("examples.events_messages")
local stubs = require("examples.events_grpc_dc")

local TagValue = messages.TagValue
local Event = messages.Event
local PublishRequest = messages.PublishRequest
local PublishReply = messages.PublishReply
local SubscribeRequest = messages.SubscribeRequest

local M = {}

M.SUBSCRIBER_QUEUE_CAPACITY = ~a

local function doubleBits(value)
  return (string.pack(">d", value):gsub(".", function(c)
    return string.format("%02x", c:byte())
  end))
end

-- Canonical identity of one tag value. The oneof kind is
-- part of the identity (int 5 ~~= "5" ~~= enum 5). Kinds are
-- told apart by value, so an all-default TagValue reads as
-- the empty string value; numbers compare bit-exact, never
-- via decimal text.
local function valueKey(tv)
  if tv.stringValue ~~= "" then return "s:" .. tv.stringValue end
  if tv.intValue ~~= 0 then return "i:" .. tostring(tv.intValue) end
  if tv.doubleValue ~~= 0 then return "d:" .. doubleBits(tv.doubleValue) end
  if tv.boolValue then return "b:true" end
  if tv.enumValue ~~= 0 then return "e:" .. tostring(tv.enumValue) end
  return "s:"
end
M.valueKey = valueKey

-- Stable key for one TagValue, e.g. "1|s:orders".
function M.tagValueKey(tv)
  return tostring(tv.tag) .. "|" .. valueKey(tv)
end

-- Containment match: the event is delivered when its tag
-- list contains every (tag, value) pair of the filter. An
-- empty filter matches everything.
function M.tagsMatch(eventTags, filterTags)
  if filterTags == nil or #filterTags == 0 then return true end
  local have = {}
  for _, tv in ipairs(eventTags or {}) do
    have[M.tagValueKey(tv)] = true
  end
  for _, f in ipairs(filterTags) do
    if not have[M.tagValueKey(f)] then return false end
  end
  return true
end

function M.tagString(tag, value)
  return TagValue.new(tag, tostring(value))
end

function M.tagInt(tag, value)
  return TagValue.new(tag, "", math.tointeger(value) or math.floor(value))
end

function M.tagDouble(tag, value)
  return TagValue.new(tag, "", 0, value + 0.0)
end

function M.tagBool(tag, value)
  return TagValue.new(tag, "", 0, 0, value and true or false)
end

function M.tagEnum(tag, value)
  return TagValue.new(tag, "", 0, 0, false, math.tointeger(value) or math.floor(value))
end

local Subscriber = {}
Subscriber.__index = Subscriber

function Subscriber.new(filterTags, capacity)
  return setmetatable({
    filter = filterTags or {},
    capacity = capacity,
    queue = {},
    dropped = 0,
  }, Subscriber)
end

function Subscriber:push(event)
  local dropped = false
  if #self.queue >= self.capacity then
    table.remove(self.queue, 1)
    self.dropped = self.dropped + 1
    dropped = true
  end
  self.queue[#self.queue + 1] = event
  return dropped
end

function Subscriber:poll()
  if #self.queue == 0 then return nil end
  return table.remove(self.queue, 1)
end

-- Next queued event, or nil when the wait times out: poll,
-- pumping via pumpFn between polls so a hosting endpoint
-- keeps moving while this subscription waits.
function Subscriber:take(seconds, pumpFn)
  local deadline = os.clock() + seconds
  while true do
    local event = self:poll()
    if event ~~= nil then return event end
    if os.clock() >= deadline then return nil end
    if pumpFn ~~= nil then pumpFn() end
  end
end

-- Handle for EventBusBroker:subscribeLocal: pull events
-- in-process. take returns the next event (waiting up to
-- the timeout, in seconds), or nil; dropped counts this
-- subscription's drop-oldest losses.
local LocalSubscription = {}
LocalSubscription.__index = LocalSubscription
M.LocalSubscription = LocalSubscription

function LocalSubscription.new(broker, sub)
  return setmetatable({ broker = broker, sub = sub }, LocalSubscription)
end

function LocalSubscription:take(seconds)
  return self.sub:take(seconds or 1.0, nil)
end

function LocalSubscription:droppedCount()
  return self.sub.dropped
end

function LocalSubscription:close()
  self.broker:removeSubscriber(self.sub)
end

-- In-memory grpcdc.events.v1.EventBus broker. Any peer can
-- host it: register() it on a Server next to your own
-- services, or call publishEvent directly in-process.
local EventBusBroker = {}
EventBusBroker.__index = EventBusBroker
M.EventBusBroker = EventBusBroker

function EventBusBroker.new(queueCapacity)
  return setmetatable({
    queueCapacity = queueCapacity or M.SUBSCRIBER_QUEUE_CAPACITY,
    subscribers = {},
    seq = 0,
    published = 0,
    dropped = 0,
    pumpFn = nil,
  }, EventBusBroker)
end

-- Accept an event: assign its sequence number and timestamp
-- and fan it out to matching subscribers. Returns the
-- stamped Event.
function EventBusBroker:publishEvent(tags, payload, publisherId)
  self.seq = self.seq + 1
  local event = Event.new(tags or {}, payload or "", self.seq,
    publisherId or "", os.time() * 1000)
  self.published = self.published + 1
  for _, sub in ipairs(self.subscribers) do
    if M.tagsMatch(event.tags, sub.filter) and sub:push(event) then
      self.dropped = self.dropped + 1
    end
  end
  return event
end

function EventBusBroker:stats()
  return {
    published = self.published,
    subscribers = #self.subscribers,
    dropped = self.dropped,
  }
end

-- grpcdc.events.v1.EventBus service implementation
-- (register calls these).
function EventBusBroker:publish(ctx, req)
  local event = self:publishEvent(req.tags, req.payload, req.publisherId)
  return PublishReply.new(event.seq)
end

function EventBusBroker:subscribe(ctx, req, stream)
  local sub = Subscriber.new(req.filter, self.queueCapacity)
  self.subscribers[#self.subscribers + 1] = sub
  local ok, err = pcall(function()
    while true do
      local event = sub:take(0.1, self.pumpFn)
      if event ~~= nil then stream:send(event) end
    end
  end)
  self:removeSubscriber(sub)
  if not ok then error(err, 0) end
end

-- In-process subscription: events fan out to it exactly
-- like an RPC subscriber, without a call. Useful embedded
-- and for tests; close() unregisters.
function EventBusBroker:subscribeLocal(filterTags)
  local sub = Subscriber.new(filterTags, self.queueCapacity)
  self.subscribers[#self.subscribers + 1] = sub
  return LocalSubscription.new(self, sub)
end

function EventBusBroker:removeSubscriber(sub)
  for i, s in ipairs(self.subscribers) do
    if s == sub then
      table.remove(self.subscribers, i)
      return
    end
  end
end

function EventBusBroker:register(server)
  stubs.registerEventBusServer(server, self)
  return self
end

-- Publish through a generated EventBusClient; returns the
-- broker-assigned sequence number.
function M.publishEvent(client, tags, payload, publisherId)
