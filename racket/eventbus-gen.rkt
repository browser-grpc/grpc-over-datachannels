// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: Register() it on a Grpcdc.Server next to your own
// services, or call PublishEvent() directly in-process.

using System;
using System.Collections.Generic;
using System.Threading;

namespace Grpcdc.events.v1;

public sealed class EventBusBroker : EventsGrpcDc.EventBusServer
{
    internal sealed class Subscriber
    {
        public readonly List<TagValue> Filter;
        private readonly int _capacity;
        private readonly Queue<Event> _queue = new();
        public int Dropped;

        public Subscriber(List<TagValue> filter, int capacity)
        {
            Filter = filter ?? new List<TagValue>();
            _capacity = capacity;
        }

        public bool Push(Event ev)
        {
            lock (this)
            {
                var wasDropped = false;
                if (_queue.Count >= _capacity)
                {
                    _queue.Dequeue();
                    Dropped++;
                    wasDropped = true;
                }
                _queue.Enqueue(ev);
                Monitor.PulseAll(this);
                return wasDropped;
            }
        }

        // Next queued event, or null when the wait times out.
        // The broker re-checks every tick; a cancelled call is
        // reaped when its next matching send fails (the
        // runtime surfaces cancellation only at send time).
        public Event Take(int timeoutMs)
        {
            lock (this)
            {
                var deadline = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() + timeoutMs;
                while (_queue.Count == 0)
                {
                    var remaining = deadline - DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                    if (remaining <= 0) return null;
                    Monitor.Wait(this, (int)remaining);
                }
                return _queue.Dequeue();
            }
        }
    }

    private readonly int _queueCapacity;
    private readonly List<Subscriber> _subscribers = new();
    private long _seq;
    private long _published;
    private long _dropped;

    public EventBusBroker(int queueCapacity = Eventbus.SubscriberQueueCapacity)
    {
        _queueCapacity = queueCapacity;
    }

    // Accept an event: assign its sequence number and
    // timestamp and fan it out to matching subscribers.
    // Returns the stamped Event.
    public Event PublishEvent(List<TagValue> tags, byte[] payload, string publisherId = "")
    {
        Event ev;
        List<Subscriber> subscribers;
        lock (this)
        {
            _seq++;
            ev = new Event(
                tags == null ? new List<TagValue>() : new List<TagValue>(tags),
                payload ?? Array.Empty<byte>(),
                (ulong)_seq,
                publisherId ?? "",
                DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
            _published++;
            subscribers = new List<Subscriber>(_subscribers);
        }
        foreach (var sub in subscribers)
        {
            if (Eventbus.TagsMatch(ev.Tags, sub.Filter) && sub.Push(ev))
            {
                lock (this) _dropped++;
            }
        }
        return ev;
    }

    public Dictionary<string, long> Stats()
    {
        lock (this)
        {
            return new Dictionary<string, long>
            {
                ["published"] = _published,
                ["subscribers"] = _subscribers.Count,
                ["dropped"] = _dropped,
            };
        }
    }

    // grpcdc.events.v1.EventBus service implementation
    // (Register calls these).
    public PublishReply Publish(Endpoint.CallContext ctx, PublishRequest req)
    {
        var ev = PublishEvent(req.Tags, req.Payload, req.PublisherId);
        return new PublishReply(ev.Seq);
    }

    public void Subscribe(SubscribeRequest req, EventsGrpcDc.EventBusSubscribeServer stream)
    {
        var sub = new Subscriber(req.Filter, _queueCapacity);
        lock (this) _subscribers.Add(sub);
        try
        {
            while (true)
            {
                var ev = sub.Take(100);
                if (ev != null) stream.Send(ev);
            }
        }
        finally
        {
            lock (this) _subscribers.Remove(sub);
        }
    }

    // In-process subscription: events fan out to it exactly
    // like an RPC subscriber, without a call. Useful embedded
    // and for tests; Close() unregisters.
    public LocalSubscription SubscribeLocal(List<TagValue> filterTags)
    {
        var sub = new Subscriber(filterTags, _queueCapacity);
        lock (this) _subscribers.Add(sub);
        return new LocalSubscription(this, sub);
    }

    internal void RemoveSubscriber(Subscriber sub)
    {
        lock (this) _subscribers.Remove(sub);
    }

    public EventBusBroker Register(Server server)
    {
        EventsGrpcDc.RegisterEventBusServer(server, this);
        return this;
    }
}
