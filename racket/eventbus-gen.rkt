// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (events_pb,
// events_grpc_dc); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
// events when it falls behind; stats reports the drops.
// PHP handlers are cooperative (Fibers): an idle Subscribe
// handler suspends and is resumed by the endpoint pump.

namespace Grpcdc;

require_once __DIR__ . "/events_pb.php";
require_once __DIR__ . "/events_grpc_dc.php";

final class Eventbus
{
    public const SUBSCRIBER_QUEUE_CAPACITY = ~a;

    // Canonical identity of one tag value. The oneof kind is
    // part of the identity (int 5 != "5" != enum 5). Kinds are
    // told apart by value, so an all-default TagValue reads as
    // the empty string value; numbers compare bit-exact, never
    // via decimal text.
    public static function valueKey(\EventsPb\TagValue $tv): string
    {
        if ($tv->stringValue !== "") {
            return "s:" . $tv->stringValue;
        }
        if ($tv->intValue !== 0) {
            return "i:" . $tv->intValue;
        }
        if ($tv->doubleValue !== 0.0) {
            return "d:" . bin2hex(pack("E", $tv->doubleValue));
        }
        if ($tv->boolValue) {
            return "b:true";
        }
        if ($tv->enumValue !== 0) {
            return "e:" . $tv->enumValue;
        }
        return "s:";
    }

    /** Stable key for one TagValue, e.g. "1|s:orders". */
    public static function tagValueKey(\EventsPb\TagValue $tv): string
    {
        return $tv->tag . "|" . self::valueKey($tv);
    }

    // Containment match: the event is delivered when its tag
    // list contains every (tag, value) pair of the filter. An
    // empty filter matches everything.
    public static function tagsMatch(array $eventTags, array $filterTags): bool
    {
        if (count($filterTags) === 0) {
            return true;
        }
        $have = [];
        foreach ($eventTags as $tv) {
            $have[self::tagValueKey($tv)] = true;
        }
        foreach ($filterTags as $f) {
            if (!isset($have[self::tagValueKey($f)])) {
                return false;
            }
        }
        return true;
    }

    public static function tagString(int $tag, $value): \EventsPb\TagValue
    {
        return new \EventsPb\TagValue($tag, (string) $value);
    }

    public static function tagInt(int $tag, $value): \EventsPb\TagValue
    {
        return new \EventsPb\TagValue($tag, "", (int) $value);
    }

    public static function tagDouble(int $tag, $value): \EventsPb\TagValue
    {
        return new \EventsPb\TagValue($tag, "", 0, (float) $value);
    }

    public static function tagBool(int $tag, $value): \EventsPb\TagValue
    {
        return new \EventsPb\TagValue($tag, "", 0, 0.0, (bool) $value);
    }

    public static function tagEnum(int $tag, $value): \EventsPb\TagValue
    {
        return new \EventsPb\TagValue($tag, "", 0, 0.0, false, (int) $value);
    }

    // Publish through a generated EventBusClient; returns the
    // broker-assigned sequence number.
    public static function publishEvent(\EventsGrpcDc\EventBusClient $client, array $tags, string $payload, string $publisherId = ""): int
    {
