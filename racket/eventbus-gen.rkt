#lang racket

;;; eventbus-gen.rkt — stamps eventbus-spec.rkt (the event bus
;;; policy) into the generated `eventbus` module of each
;;; language's runtime package: broker + client helpers + tag
;;; matching, plus the native git log serde module, generated
;;; tests, and a self-checking demo. Invoked from metagen.rkt
;;; so `make generate` regenerates everything in one pass.
;;;
;;; The wire messages and service stubs are NOT stamped here:
;;; the protoc plugins generate them from proto/events.proto
;;; (make eventbus-stubs), and these modules build on them.

(require "eventbus-spec.rkt" racket/runtime-path)
(provide generate-eventbus)

(define-runtime-path here ".")
(define root (build-path here ".."))

(define queue-capacity (eventbus-spec 'subscriber-queue-capacity))
(define git-blob-path (eventbus-spec 'git-blob-path))
(define git-author-name (eventbus-spec 'git-author-name))
(define git-author-email (eventbus-spec 'git-author-email))
(define git-commit-subject (eventbus-spec 'git-commit-subject))
(define git-trailer-seq (eventbus-spec 'git-trailer-seq))
(define git-trailer-publisher (eventbus-spec 'git-trailer-publisher))
(define git-trailer-tag (eventbus-spec 'git-trailer-tag))

