(define (emit-py-eventbus)
  (string-append
   (py-header)
   (format #<<TPL
"""Event bus (grpcdc.events.v1.EventBus): in-memory broker,
client helpers, and tag matching. Wire messages and stubs are
generated from proto/events.proto (grpcdc.events_pb,
grpcdc.events_grpc_dc); the broker policy comes from the
shared event-bus spec.

Delivery is at-most-once: each subscriber has a bounded queue
(SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest events when
it falls behind; stats() reports the drops.
"""

import collections
import struct
import threading
import time

from . import events_grpc_dc, events_pb
from .events_pb import Event, PublishReply, PublishRequest, SubscribeRequest, TagValue

SUBSCRIBER_QUEUE_CAPACITY = ~a


def _value_key(tv):
    # Canonical identity of one tag value. The oneof kind is
    # part of the identity (int 5 != "5" != enum 5). Kinds are
    # told apart by value, so an all-default TagValue reads as
    # the empty string value; numbers compare bit-exact, never
    # via decimal text.
    if tv.string_value != "":
        return "s:" + tv.string_value
    if tv.int_value != 0:
        return "i:" + str(tv.int_value)
    if tv.double_value != 0:
        return "d:" + struct.pack(">d", tv.double_value).hex()
    if tv.bool_value:
        return "b:true"
    if tv.enum_value != 0:
        return "e:" + str(tv.enum_value)
    return "s:"


def tag_value_key(tv):
    """Stable key for one TagValue, e.g. "1|s:orders"."""
    return "%d|%s" % (tv.tag, _value_key(tv))


def tags_match(event_tags, filter_tags):
    """Containment match: the event is delivered when its tag
    list contains every (tag, value) pair of the filter. An
    empty filter matches everything."""
    if not filter_tags:
        return True
    have = {tag_value_key(tv) for tv in event_tags or []}
    return all(tag_value_key(f) in have for f in filter_tags)


def tag_string(tag, value):
    return TagValue(tag=tag, string_value=str(value))


def tag_int(tag, value):
    return TagValue(tag=tag, int_value=int(value))


def tag_double(tag, value):
    return TagValue(tag=tag, double_value=float(value))


def tag_bool(tag, value):
    return TagValue(tag=tag, bool_value=bool(value))


def tag_enum(tag, value):
    return TagValue(tag=tag, enum_value=int(value))


class _Subscriber:
    def __init__(self, filter_tags, capacity):
        self.filter = list(filter_tags or [])
        self.capacity = capacity
        self.queue = collections.deque()
        self.cond = threading.Condition()
        self.dropped = 0

    def push(self, event):
        with self.cond:
            dropped = False
            if len(self.queue) >= self.capacity:
                self.queue.popleft()
                self.dropped += 1
                dropped = True
            self.queue.append(event)
            self.cond.notify_all()
            return dropped

    def take(self, timeout):
        # Next queued event, or None when the wait times out.
        # The broker re-checks every tick; a cancelled call is
        # reaped when its next matching send fails (the runtime
        # surfaces cancellation only at send time).
        with self.cond:
            if not self.queue:
                self.cond.wait(timeout)
            if self.queue:
                return self.queue.popleft()
            return None


class EventBusBroker:
    """In-memory grpcdc.events.v1.EventBus broker. Any peer
    can host it: register() it on a grpcdc.Server next to your
    own services, or call publish_event() directly in-process.
    """

    def __init__(self, queue_capacity=SUBSCRIBER_QUEUE_CAPACITY):
        self.queue_capacity = queue_capacity
        self._lock = threading.Lock()
        self._subscribers = set()
        self._seq = 0
        self._published = 0
        self._dropped = 0

    def publish_event(self, tags, payload, publisher_id=""):
        """Accept an event: assign its sequence number and
        timestamp and fan it out to matching subscribers.
        Returns the stamped Event."""
        with self._lock:
            self._seq += 1
            event = Event(
                tags=list(tags or []),
                payload=bytes(payload or b""),
                seq=self._seq,
                publisher_id=publisher_id or "",
                timestamp_unix_ms=int(time.time() * 1000),
            )
            self._published += 1
            subscribers = list(self._subscribers)
        for sub in subscribers:
            if tags_match(event.tags, sub.filter) and sub.push(event):
                with self._lock:
                    self._dropped += 1
        return event

    def stats(self):
        with self._lock:
            return {
                "published": self._published,
                "subscribers": len(self._subscribers),
                "dropped": self._dropped,
            }

    # grpcdc.events.v1.EventBus service implementation
    # (register_event_bus_server calls these).
    def Publish(self, ctx, req):
        event = self.publish_event(req.tags, req.payload, req.publisher_id)
        return PublishReply(seq=event.seq)

    def Subscribe(self, req, stream):
        sub = _Subscriber(req.filter, self.queue_capacity)
        with self._lock:
            self._subscribers.add(sub)
        try:
            while True:
                event = sub.take(0.1)
                if event is not None:
                    stream.send(event)
        finally:
            with self._lock:
                self._subscribers.discard(sub)

    def subscribe_local(self, filter_tags):
        """In-process subscription: events fan out to it
        exactly like an RPC subscriber, without a call. Useful
        embedded and for tests; close() unregisters."""
        sub = _Subscriber(filter_tags, self.queue_capacity)
        with self._lock:
            self._subscribers.add(sub)
        return LocalSubscription(self, sub)

    def _remove_subscriber(self, sub):
        with self._lock:
            self._subscribers.discard(sub)

    def register(self, server):
        events_grpc_dc.register_event_bus_server(server, self)
        return self


class LocalSubscription:
    """Handle for EventBusBroker.subscribe_local: pull events
    in-process. take() returns the next event (waiting up to
    the timeout, in seconds), or None; dropped counts this
    subscription's drop-oldest losses."""

    def __init__(self, broker, sub):
        self._broker = broker
        self._sub = sub

    @property
    def dropped(self):
        return self._sub.dropped

    def take(self, timeout=1.0):
        deadline = time.time() + timeout
        while True:
            remaining = deadline - time.time()
            if remaining <= 0:
                return self._sub.take(0)
            event = self._sub.take(min(remaining, 0.1))
            if event is not None or time.time() >= deadline:
                return event

    def close(self):
        self._broker._remove_subscriber(self._sub)


def publish_event(client, tags, payload, publisher_id=""):
    """Publish through a generated EventBusClient; returns the
    broker-assigned sequence number."""
    reply = client.Publish(
        PublishRequest(
            tags=list(tags or []),
            payload=bytes(payload or b""),
            publisher_id=publisher_id or "",
        )
    )
    return reply.seq


def subscribe_events(client, filter_tags):
    """Subscribe through a generated EventBusClient; returns
    the receiving stream (iterate it, or close() it to
    unsubscribe)."""
    return client.Subscribe(SubscribeRequest(filter=list(filter_tags or [])))


# Re-exported so users can build a client without importing
# the stub module directly.
EventBusClient = events_grpc_dc.EventBusClient
TPL
           queue-capacity)))

(define (emit-py-gitlog)
  (string-append
   (py-header)
   (format #<<TPL
"""Git log serde for the event bus: exports an event log to a
git branch (one commit per event) and imports it back. The
live broker never touches git; this is the durable serde
layer beside it. Stdlib subprocess drives the git plumbing.

Deterministic: the same events always produce the same
commits, so re-exporting a log the branch already has is a
no-op (each event's sequence number is the dedup key). The
commit blob (~a) is authoritative; the message subject and
trailers are a human index for `git log`.
"""

import os
import subprocess

from .eventbus import tag_value_key, tags_match
from .events_pb import Event

_AUTHOR_NAME = "~a"
_AUTHOR_EMAIL = "~a"
_BLOB_PATH = "~a"
_COMMIT_SUBJECT = "~a"
_TRAILER_SEQ = "~a"
_TRAILER_PUBLISHER = "~a"
_TRAILER_TAG = "~a"
_ZERO_SHA = "0" * 40

EVENT_LOG_BRANCH = "grpc-dc-events"


def _git(repo, args, input_bytes=None, env_extra=None):
    env = None
    if env_extra:
        env = dict(os.environ)
        env.update(env_extra)
    out = subprocess.run(
        ["git", "-C", repo] + args,
        input=input_bytes,
        env=env,
        stdout=subprocess.PIPE,
        check=True,
    )
    return out.stdout


def _git_text(repo, args, input_bytes=None, env_extra=None):
    return _git(repo, args, input_bytes, env_extra).decode("utf-8").strip()


def init_event_log_repo(repo):
    """Create the log repo if needed (a plain `git init`)."""
    try:
        _git_text(repo, ["rev-parse", "--git-dir"])
    except Exception:
        subprocess.run(["git", "init", "-q", repo], check=True)


def _branch_head(repo, branch):
    try:
        return _git_text(repo, ["rev-parse", "--verify", "refs/heads/" + branch])
    except Exception:
        return None


def commit_message(event):
    """"grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    `git log` alone can filter the log without decoding blobs.
    """
    lines = ["%s %d" % (_COMMIT_SUBJECT, event.seq), "", "%s: %d" % (_TRAILER_SEQ, event.seq)]
    if event.publisher_id:
        lines.append("%s: %s" % (_TRAILER_PUBLISHER, event.publisher_id))
    for tv in event.tags:
        lines.append("%s: %s" % (_TRAILER_TAG, tag_value_key(tv)))
    return "\n".join(lines) + "\n"


def _commit_env(event):
    seconds = max(0, event.timestamp_unix_ms // 1000)
    date = "%d +0000" % seconds
    return {
        "GIT_AUTHOR_NAME": _AUTHOR_NAME,
        "GIT_AUTHOR_EMAIL": _AUTHOR_EMAIL,
        "GIT_COMMITTER_NAME": _AUTHOR_NAME,
        "GIT_COMMITTER_EMAIL": _AUTHOR_EMAIL,
        "GIT_AUTHOR_DATE": date,
        "GIT_COMMITTER_DATE": date,
    }


def import_events(repo, branch=EVENT_LOG_BRANCH, from_seq=0, to_seq=None, filter_tags=None):
    """Import a branch: events in chain order (oldest first),
    optionally windowed by sequence number and narrowed by a
    tag filter (same containment semantics as Subscribe). A
    missing branch imports as an empty log."""
    if not _branch_head(repo, branch):
        return []
    shas = _git_text(repo, ["rev-list", "--reverse", branch]).split("\n")
    events = []
    for sha in shas:
        if not sha:
            continue
        data = _git(repo, ["cat-file", "-p", "%s:%s" % (sha, _BLOB_PATH)])
        event = Event()
        event.unmarshal_dc(data)
        if event.seq <= from_seq:
            continue
        if to_seq is not None and event.seq > to_seq:
            continue
        if filter_tags and not tags_match(event.tags, filter_tags):
            continue
        events.append(event)
    return events


def export_events(repo, events, branch=EVENT_LOG_BRANCH):
    """Export events onto the branch: one commit per event, in
    sequence order, skipping sequence numbers the branch
    already has. Returns the new head sha (or the existing one
    when nothing was appended). The ref update is a
    compare-and-swap: a concurrent exporter fails loudly
    instead of forking the log; retrying is safe."""
    init_event_log_repo(repo)
    existing = {e.seq for e in import_events(repo, branch)}
    ordered = sorted(events, key=lambda e: e.seq)
    head = _branch_head(repo, branch)
    before = head
    for event in ordered:
        if event.seq in existing:
            continue
        blob = _git_text(repo, ["hash-object", "-w", "--stdin"], event.marshal_dc())
        tree = _git_text(repo, ["mktree"], ("100644 blob %s\t%s\n" % (blob, _BLOB_PATH)).encode("utf-8"))
        args = ["commit-tree", tree, "-m", commit_message(event)]
        if head:
            args += ["-p", head]
        head = _git_text(repo, args, None, _commit_env(event))
        existing.add(event.seq)
    if head and head != before:
        _git_text(repo, ["update-ref", "refs/heads/" + branch, head, before or _ZERO_SHA])
    return head
