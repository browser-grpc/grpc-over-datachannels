/// Git log serde for the event bus: exports an event log to
/// a git branch (one commit per event) and imports it back.
/// The live broker never touches git; this is the durable
/// serde layer beside it. dart:io Process drives the git
/// plumbing.
///
/// Deterministic: the same events always produce the same
/// commits, so re-exporting a log the branch already has is
/// a no-op (each event's sequence number is the dedup key).
/// The commit blob (~a) is authoritative; the message
/// subject and trailers are a human index for `git log`.

import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';

import 'eventbus.dart';
import 'events_messages.dart';

const String gitAuthorName = '~a';
const String gitAuthorEmail = '~a';
const String gitBlobPath = '~a';
const String gitCommitSubject = '~a';
const String gitTrailerSeq = '~a';
const String gitTrailerPublisher = '~a';
const String gitTrailerTag = '~a';
const String zeroSha = '0000000000000000000000000000000000000000';

const String eventLogBranch = 'grpc-dc-events';

Future<List<int>> gitBytes(String repo, List<String> args,
    {List<int>? inputBytes, Map<String, String>? envExtra}) async {
  final process = await Process.start('git', ['-C', repo, ...args],
      environment: envExtra, includeParentEnvironment: true);
  if (inputBytes != null) process.stdin.add(inputBytes);
  await process.stdin.close();
  final out = <int>[];
  await for (final chunk in process.stdout) {
    out.addAll(chunk);
  }
  await for (final _ in process.stderr) {}
  final code = await process.exitCode;
  if (code != 0) {
    throw StateError('git ${args.first} failed in $repo');
  }
  return out;
}

Future<String> gitText(String repo, List<String> args,
        {List<int>? inputBytes, Map<String, String>? envExtra}) async =>
    utf8.decode(await gitBytes(repo, args,
        inputBytes: inputBytes, envExtra: envExtra)).trim();

/// Create the log repo if needed (a plain `git init`).
Future<void> initEventLogRepo(String repo) async {
  try {
    await gitText(repo, ['rev-parse', '--git-dir']);
  } catch (_) {
    final result = await Process.run('git', ['init', '-q', repo]);
    if (result.exitCode != 0) {
      throw StateError('git init failed for $repo');
    }
  }
}

Future<String?> branchHead(String repo, String branch) async {
  try {
    return await gitText(repo, ['rev-parse', '--verify', 'refs/heads/$branch']);
  } catch (_) {
    return null;
  }
}

/// "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
/// `git log` alone can filter the log without decoding blobs.
String commitMessage(Event event) {
  final lines = <String>[
    '$gitCommitSubject ${event.seq}',
    '',
    '$gitTrailerSeq: ${event.seq}',
  ];
  if (event.publisherId != '') {
    lines.add('$gitTrailerPublisher: ${event.publisherId}');
  }
  for (final tv in event.tags) {
    lines.add('$gitTrailerTag: ${tagValueKey(tv)}');
  }
  return lines.join('\n') + '\n';
}

Map<String, String> commitEnv(Event event) {
  final seconds = event.timestampUnixMs ~~/ 1000;
  final date = '${seconds < 0 ? 0 : seconds} +0000';
  return {
    'GIT_AUTHOR_NAME': gitAuthorName,
    'GIT_AUTHOR_EMAIL': gitAuthorEmail,
    'GIT_COMMITTER_NAME': gitAuthorName,
    'GIT_COMMITTER_EMAIL': gitAuthorEmail,
    'GIT_AUTHOR_DATE': date,
    'GIT_COMMITTER_DATE': date,
  };
}

/// Import a branch: events in chain order (oldest first),
/// optionally windowed by sequence number and narrowed by a
/// tag filter (same containment semantics as Subscribe). A
/// missing branch imports as an empty log.
Future<List<Event>> importEvents(String repo,
    {String branch = eventLogBranch,
    int fromSeq = 0,
    int? toSeq,
    List<TagValue>? filterTags}) async {
  if (await branchHead(repo, branch) == null) return [];
  final events = <Event>[];
  final shas = (await gitText(repo, ['rev-list', '--reverse', branch]))
      .split('\n');
  for (final sha in shas) {
    if (sha.isEmpty) continue;
    final data = await gitBytes(repo, ['cat-file', '-p', '$sha:$gitBlobPath']);
    final event = Event();
    event.unmarshalDc(data);
    if (event.seq <= fromSeq) continue;
    if (toSeq != null && event.seq > toSeq) continue;
    if (filterTags != null && !tagsMatch(event.tags, filterTags)) continue;
    events.add(event);
  }
  return events;
}

/// Export events onto the branch: one commit per event, in
/// sequence order, skipping sequence numbers the branch
/// already has. Returns the new head sha (or the existing
/// one when nothing was appended). The ref update is a
/// compare-and-swap: a concurrent exporter fails loudly
/// instead of forking the log; retrying is safe.
Future<String?> exportEvents(String repo, List<Event> events,
    {String branch = eventLogBranch}) async {
  await initEventLogRepo(repo);
  final existing = <int>{};
  for (final e in await importEvents(repo, branch: branch)) {
    existing.add(e.seq);
  }
  final ordered = List<Event>.from(events)
    ..sort((a, b) => a.seq.compareTo(b.seq));
  var head = await branchHead(repo, branch);
  final before = head;
  for (final event in ordered) {
    if (existing.contains(event.seq)) continue;
    final blob = await gitText(repo, ['hash-object', '-w', '--stdin'],
        inputBytes: event.marshalDc());
    final tree = await gitText(repo, ['mktree'],
        inputBytes:
            utf8.encode('100644 blob $blob\t$gitBlobPath\n'));
    final args = ['commit-tree', tree, '-m', commitMessage(event)];
    if (head != null) {
      args.add('-p');
      args.add(head);
    }
    head = await gitText(repo, args, envExtra: commitEnv(event));
    existing.add(event.seq);
  }
  if (head != null && head != before) {
    await gitText(
        repo, ['update-ref', 'refs/heads/$branch', head, before ?? zeroSha]);
  }
  return head;
}
