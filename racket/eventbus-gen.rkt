	return reply.Seq, nil
}

// SubscribeEvents subscribes through a generated EventBus
// client; cancel the context to unsubscribe.
func SubscribeEvents(ctx context.Context, client *EventBusClient, filter []*TagValue) (*EventBusSubscribeStream, error) {
	return client.Subscribe(ctx, &SubscribeRequest{Filter: filter})
}
