(define (emit-java-gitlog)
  (string-append
   (java-header)
   (format #<<TPL
package grpcdc.events.v1;

// Git log serde for the event bus: exports an event log to
// a git branch (one commit per event) and imports it back.
// The live broker never touches git; this is the durable
// serde layer beside it. ProcessBuilder drives the git
// plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is
// a no-op (each event's sequence number is the dedup key).
// The commit blob (~a) is authoritative; the message
// subject and trailers are a human index for `git log`.

import java.io.File;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

public final class EventbusGit {
    public static final String AUTHOR_NAME = "~a";
    public static final String AUTHOR_EMAIL = "~a";
    public static final String BLOB_PATH = "~a";
    public static final String COMMIT_SUBJECT = "~a";
    public static final String TRAILER_SEQ = "~a";
    public static final String TRAILER_PUBLISHER = "~a";
    public static final String TRAILER_TAG = "~a";
    public static final String ZERO_SHA =
            "0000000000000000000000000000000000000000";

    public static final String EVENT_LOG_BRANCH = "grpc-dc-events";

    private EventbusGit() {}

    public static byte[] git(String repo, List<String> args, byte[] inputBytes,
                             Map<String, String> envExtra) throws Exception {
        List<String> cmd = new ArrayList<>();
        cmd.add("git");
        cmd.add("-C");
        cmd.add(repo);
        cmd.addAll(args);
        ProcessBuilder pb = new ProcessBuilder(cmd);
        pb.directory(new File(repo).getParentFile());
        if (envExtra != null) pb.environment().putAll(envExtra);
        Process proc = pb.start();
        if (inputBytes != null) {
            try (OutputStream in = proc.getOutputStream()) {
                in.write(inputBytes);
            }
        } else {
            proc.getOutputStream().close();
        }
        byte[] out = proc.getInputStream().readAllBytes();
        proc.getErrorStream().readAllBytes();
        if (proc.waitFor() != 0) {
            throw new IllegalStateException("git " + args.get(0) + " failed in " + repo);
        }
        return out;
    }

    public static String gitText(String repo, List<String> args, byte[] inputBytes,
                                 Map<String, String> envExtra) throws Exception {
        return new String(git(repo, args, inputBytes, envExtra),
                StandardCharsets.UTF_8).trim();
    }

    /** Create the log repo if needed (a plain `git init`). */
    public static void initEventLogRepo(String repo) throws Exception {
        try {
            gitText(repo, List.of("rev-parse", "--git-dir"), null, null);
        } catch (Exception e) {
            Process proc = new ProcessBuilder("git", "init", "-q", repo).start();
            proc.getInputStream().readAllBytes();
            proc.getErrorStream().readAllBytes();
            if (proc.waitFor() != 0) {
                throw new IllegalStateException("git init failed for " + repo);
            }
        }
    }

    public static String branchHead(String repo, String branch) {
        try {
            return gitText(repo, List.of("rev-parse", "--verify",
                    "refs/heads/" + branch), null, null);
        } catch (Exception e) {
            return null;
        }
    }

    // "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    // `git log` alone can filter the log without decoding blobs.
    public static String commitMessage(Event event) {
        StringBuilder sb = new StringBuilder();
        sb.append(COMMIT_SUBJECT).append(' ').append(event.seq).append("\n\n");
        sb.append(TRAILER_SEQ).append(": ").append(event.seq);
        if (!event.publisherId.isEmpty()) {
            sb.append('\n').append(TRAILER_PUBLISHER).append(": ")
                    .append(event.publisherId);
        }
        for (TagValue tv : event.tags) {
            sb.append('\n').append(TRAILER_TAG).append(": ")
                    .append(Eventbus.tagValueKey(tv));
        }
        return sb.append('\n').toString();
    }

    public static Map<String, String> commitEnv(Event event) {
        long seconds = Math.max(0, event.timestampUnixMs / 1000);
        String date = seconds + " +0000";
        Map<String, String> env = new HashMap<>();
        env.put("GIT_AUTHOR_NAME", AUTHOR_NAME);
        env.put("GIT_AUTHOR_EMAIL", AUTHOR_EMAIL);
        env.put("GIT_COMMITTER_NAME", AUTHOR_NAME);
        env.put("GIT_COMMITTER_EMAIL", AUTHOR_EMAIL);
        env.put("GIT_AUTHOR_DATE", date);
        env.put("GIT_COMMITTER_DATE", date);
        return env;
    }

    // Import a branch: events in chain order (oldest first),
    // optionally windowed by sequence number and narrowed by
    // a tag filter (same containment semantics as
    // Subscribe). A missing branch imports as an empty log.
    public static List<Event> importEvents(String repo, String branch, long fromSeq,
                                           Long toSeq, List<TagValue> filterTags)
            throws Exception {
        List<Event> events = new ArrayList<>();
        if (branchHead(repo, branch) == null) return events;
        String list = gitText(repo, List.of("rev-list", "--reverse", branch),
                null, null);
        for (String sha : list.split("\n")) {
            if (sha.isEmpty()) continue;
            byte[] data = git(repo, List.of("cat-file", "-p", sha + ":" + BLOB_PATH),
                    null, null);
            Event event = new Event();
            event.unmarshalDc(data);
            if (event.seq <= fromSeq) continue;
            if (toSeq != null && event.seq > toSeq) continue;
            if (filterTags != null
                    && !Eventbus.tagsMatch(event.tags, filterTags)) continue;
            events.add(event);
        }
        return events;
    }

    public static List<Event> importEvents(String repo) throws Exception {
        return importEvents(repo, EVENT_LOG_BRANCH, 0, null, null);
    }

    // Export events onto the branch: one commit per event, in
    // sequence order, skipping sequence numbers the branch
    // already has. Returns the new head sha (or the existing
    // one when nothing was appended). The ref update is a
    // compare-and-swap: a concurrent exporter fails loudly
    // instead of forking the log; retrying is safe.
    public static String exportEvents(String repo, List<Event> events,
                                      String branch) throws Exception {
        initEventLogRepo(repo);
        Set<Long> existing = new HashSet<>();
        for (Event e : importEvents(repo, branch, 0, null, null)) {
            existing.add(e.seq);
        }
        List<Event> ordered = new ArrayList<>(events);
        ordered.sort(Comparator.comparingLong(e -> e.seq));
        String head = branchHead(repo, branch);
        String before = head;
        for (Event event : ordered) {
            if (existing.contains(event.seq)) continue;
            String blob = gitText(repo, List.of("hash-object", "-w", "--stdin"),
                    event.marshalDc(), null);
            String tree = gitText(repo, List.of("mktree"),
                    ("100644 blob " + blob + "\t" + BLOB_PATH + "\n")
                            .getBytes(StandardCharsets.UTF_8), null);
            List<String> args = new ArrayList<>(
                    List.of("commit-tree", tree, "-m", commitMessage(event)));
            if (head != null) {
                args.add("-p");
                args.add(head);
            }
            head = gitText(repo, args, null, commitEnv(event));
            existing.add(event.seq);
        }
        if (head != null && !head.equals(before)) {
            gitText(repo, List.of("update-ref", "refs/heads/" + branch, head,
                    before == null ? ZERO_SHA : before), null, null);
        }
        return head;
    }

