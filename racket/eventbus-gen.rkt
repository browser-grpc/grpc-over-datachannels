// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

import 'dart:async';
import 'dart:convert';
import 'dart:io';

import '../grpcdc/channel.dart';
import '../grpcdc/eventbus.dart' as eb;
import '../grpcdc/eventbus_git.dart' as ebgit;
import '../grpcdc/events_grpc_dc.dart';
import '../grpcdc/events_messages.dart';
import '../grpcdc/memory_transport.dart';
import '../grpcdc/server.dart';
import 'test_util.dart';

Future<void> waitFor(bool Function() fn, String what) async {
  final deadline = DateTime.now().add(const Duration(seconds: 5));
  while (!fn()) {
    if (DateTime.now().isAfter(deadline)) {
      throw StateError('waitFor timed out: $what');
    }
    await Future<void>.delayed(const Duration(milliseconds: 5));
  }
}

Future<(eb.EventBusBroker, EventBusClient)> setupBus() async {
  final broker = eb.EventBusBroker();
  final (a, b) = memoryTransportPair();
  final server = Server();
  broker.register(server);
  server.serveTransport(b);
  return (broker, EventBusClient(Channel(a)));
}

Future<void> testEventBus() async {
  List<int> bytes(String s) => utf8.encode(s);

  // -- tagsMatch: containment, kinds, empty --
  final tags = [eb.tagString(Tag.TOPIC, 'orders'), eb.tagInt(Tag.KIND, 5)];
  check(eb.tagsMatch(tags, []), 'empty filter matches');
  check(eb.tagsMatch(tags, [eb.tagString(Tag.TOPIC, 'orders')]), 'containment');
  check(eb.tagsMatch(tags, tags), 'self match');
  check(!eb.tagsMatch(tags, [eb.tagEnum(Tag.KIND, 5)]), 'int != enum');
  check(!eb.tagsMatch(tags, [eb.tagString(Tag.KIND, '5')]), 'int != string');
  check(!eb.tagsMatch(tags, [eb.tagString(Tag.TOPIC, 'other')]), 'value mismatch');

  // -- fan-out honors filters --
  final (broker, client) = await setupBus();
  final orders = <Event>[];
  final allEvents = <Event>[];
  final ordersSub = (await eb.subscribeEvents(
          client, [eb.tagString(Tag.TOPIC, 'orders')]))
      .responses
      .listen(orders.add);
  final allSub = (await eb.subscribeEvents(client, []))
      .responses
      .listen(allEvents.add);
  await waitFor(() => broker.stats()['subscribers'] == 2, '2 subscribers');
  check(
      await eb.publishEvent(
              client, [eb.tagString(Tag.TOPIC, 'orders')], bytes('o1'), 'test') ==
          1,
      'seq 1');
  check(
      await eb.publishEvent(
              client, [eb.tagString(Tag.TOPIC, 'other')], bytes('x1'), 'test') ==
          2,
      'seq 2');
  await waitFor(() => orders.length == 1 && allEvents.length == 2, 'fanout');
  check(utf8.decode(orders[0].payload) == 'o1', 'filtered payload');
  check(orders[0].publisherId == 'test', 'publisher');
  check(allEvents.map((e) => e.seq).toList().toString() == '[1, 2]', 'all seqs');
  await ordersSub.cancel();
  await allSub.cancel();

  // -- kinds never cross-match --
  final (_, client2) = await setupBus();
  final got = <Event>[];
  final kindSub = (await eb.subscribeEvents(
          client2, [eb.tagInt(Tag.KIND, 5)]))
      .responses
      .listen(got.add);
  await eb.publishEvent(client2, [eb.tagString(Tag.KIND, '5')], bytes('s'));
  await eb.publishEvent(client2, [eb.tagEnum(Tag.KIND, 5)], bytes('e'));
  check(
      await eb.publishEvent(client2, [eb.tagInt(Tag.KIND, 5)], bytes('i')) == 3,
      'seq 3');
  await waitFor(() => got.length == 1, 'kind match');
  check(utf8.decode(got[0].payload) == 'i', 'int kind only');
  await kindSub.cancel();

  // (No user-tag pass-through leg: the generated Tag is a
  // closed Dart enum; see eventbus.dart. Own tags arrive by
  // regenerating from an extended events.proto copy.)

  // -- slow subscriber drops oldest --
  final broker4 = eb.EventBusBroker(queueCapacity: 4);
  final sub = broker4.subscribeLocal([]);
  for (var i = 1; i <= 6; i++) {
    broker4.publishEvent([], bytes('m$i'));
  }
  check(broker4.stats()['dropped'] == 2, 'dropped count');
  check(sub.dropped == 2, 'sub dropped');
  final seqs = <int>[];
  for (var i = 0; i < 4; i++) {
    seqs.add((await sub.take())!.seq);
  }
  check(seqs.toString() == '[3, 4, 5, 6]', 'kept newest: $seqs');
  sub.close();
  check(broker4.stats()['subscribers'] == 0, 'close unregisters');

  // -- close unsubscribes (RPC) --
  final (broker5, client5) = await setupBus();
  final stream = await eb.subscribeEvents(client5, []);
  await waitFor(() => broker5.stats()['subscribers'] == 1, '1 subscriber');
  await eb.publishEvent(client5, [], bytes('a'));
  check(utf8.decode((await stream.recv()).payload) == 'a', 'recv before close');
  stream.close();
  await eb.publishEvent(client5, [], bytes('b'));
  await waitFor(() => broker5.stats()['subscribers'] == 0, 'reaped');

  // -- git log round-trip + idempotent --
  final repo =
      await Directory.systemTemp.createTemp('grpc-dc-eventbus-');
  final broker6 = eb.EventBusBroker();
  final events = [
    broker6.publishEvent(
        [eb.tagString(Tag.TOPIC, 'orders')], bytes('o1'), 'test'),
    broker6.publishEvent(
        [eb.tagString(Tag.TOPIC, 'other')], bytes('x1'), 'test'),
    broker6.publishEvent(
        [eb.tagString(Tag.TOPIC, 'orders')], bytes('o2'), 'test'),
  ];
  final head1 = await ebgit.exportEvents(repo.path, events);
  check(
      await ebgit.gitText(
              repo.path, ['rev-list', '--count', 'grpc-dc-events']) ==
          '3',
      'commit count');
  check(await ebgit.exportEvents(repo.path, events) == head1,
      'idempotent re-export');
  final imported = await ebgit.importEvents(repo.path);
  check(imported.map((e) => e.seq).toList().toString() == '[1, 2, 3]', 'import seqs');
  check(
      imported.map((e) => utf8.decode(e.payload)).toList().toString() ==
          '[o1, x1, o2]',
      'import payloads');
  final filtered = await ebgit.importEvents(repo.path,
      filterTags: [eb.tagString(Tag.TOPIC, 'orders')]);
  check(filtered.map((e) => e.seq).toList().toString() == '[1, 3]', 'import filter');
  final window =
      await ebgit.importEvents(repo.path, fromSeq: 1, toSeq: 2);
  check(window.map((e) => e.seq).toList().toString() == '[2]', 'import window');

  print('TestEventBus OK');
}
TPL
   ))

