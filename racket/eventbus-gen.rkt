// Event bus demo: a broker, one filtered subscriber, and
// three publishes over one in-memory data channel.
//   kotlinc -include-runtime kotlin/grpcdc/*.kt \
//     kotlin/examples/EventBusDemo.kt -d /tmp/eventbus_demo.jar
//   java -jar /tmp/eventbus_demo.jar

import grpcdc.Channel
import grpcdc.MemoryTransport
import grpcdc.Server
import grpcdc.events.v1.Eventbus
import grpcdc.events.v1.EventBusBroker
import grpcdc.events.v1.EventsGrpcDc
import grpcdc.events.v1.Tag
import java.nio.charset.StandardCharsets
import java.util.Collections

fun main() {
    val broker = EventBusBroker()
    val (a, b) = MemoryTransport.pair()
    val server = Server()
    broker.register(server)
    server.serveTransport(b)
    val client = EventsGrpcDc.EventBusClient(Channel(a))

    val received = Collections.synchronizedList(ArrayList<String>())
    val thread = Thread {
        val stream = Eventbus.subscribeEvents(client,
            listOf(Eventbus.tagString(Tag.TOPIC, "orders")))
        while (received.size < 2) {
            val ev = stream.recv()
            received.add("#" + ev.seq + " " +
                String(ev.payload, StandardCharsets.UTF_8))
        }
        stream.close()
    }
    thread.isDaemon = true
    thread.start()
    while (broker.stats()["subscribers"]!! < 1) Thread.sleep(5)
    Eventbus.publishEvent(client,
        listOf(Eventbus.tagString(Tag.TOPIC, "orders")),
        "order-1".toByteArray(StandardCharsets.UTF_8), "demo")
    Eventbus.publishEvent(client,
