package grpcdc.events.v1;

// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (EventsPb,
// EventsGrpcDc); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
// events when it falls behind; stats reports the drops.
//
// Note: the generated Tag is a closed Java enum, so a Java
// peer can only carry tag values present in its generated
// copy of events.proto. To use your own tags, copy
// events.proto, add values (1000+), and regenerate -- the
// standard extension flow. Brokers in open-enum languages
// pass unknown tag numbers through unchanged.

import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

public final class Eventbus {
    public static final int SUBSCRIBER_QUEUE_CAPACITY = ~a;

    private Eventbus() {}

    // Canonical identity of one tag value. The oneof kind is
    // part of the identity (int 5 != "5" != enum 5). Kinds are
    // told apart by value, so an all-default TagValue reads as
    // the empty string value; numbers compare bit-exact, never
    // via decimal text.
    private static String valueKey(TagValue tv) {
        if (!tv.stringValue.isEmpty()) return "s:" + tv.stringValue;
        if (tv.intValue != 0) return "i:" + tv.intValue;
        if (tv.doubleValue != 0) {
            long bits = ByteBuffer.allocate(8).order(ByteOrder.BIG_ENDIAN)
                    .putDouble(tv.doubleValue).getLong(0);
            return "d:" + String.format("%016x", bits);
        }
        if (tv.boolValue) return "b:true";
        if (tv.enumValue != 0) return "e:" + tv.enumValue;
        return "s:";
    }

    /** Stable key for one TagValue, e.g. "1|s:orders". */
    public static String tagValueKey(TagValue tv) {
        return tv.tag.number + "|" + valueKey(tv);
    }

    // Containment match: the event is delivered when its tag
    // list contains every (tag, value) pair of the filter. An
    // empty filter matches everything.
    public static boolean tagsMatch(List<TagValue> eventTags, List<TagValue> filterTags) {
        if (filterTags == null || filterTags.isEmpty()) return true;
        Set<String> have = new HashSet<>();
        if (eventTags != null) {
            for (TagValue tv : eventTags) have.add(tagValueKey(tv));
        }
        for (TagValue f : filterTags) {
            if (!have.contains(tagValueKey(f))) return false;
        }
        return true;
    }

    public static TagValue tagString(Tag tag, Object value) {
        return new TagValue(tag, String.valueOf(value), 0, 0, false, 0);
    }

    public static TagValue tagInt(Tag tag, Object value) {
        return new TagValue(tag, "", ((Number) value).longValue(), 0, false, 0);
    }

    public static TagValue tagDouble(Tag tag, Object value) {
        return new TagValue(tag, "", 0, ((Number) value).doubleValue(), false, 0);
    }

    public static TagValue tagBool(Tag tag, Object value) {
        return new TagValue(tag, "", 0, 0, Boolean.TRUE.equals(value), 0);
    }

    public static TagValue tagEnum(Tag tag, Object value) {
        return new TagValue(tag, "", 0, 0, false, ((Number) value).intValue());
    }

    // Publish through a generated EventBusClient; returns the
    // broker-assigned sequence number.
    public static long publishEvent(EventsGrpcDc.EventBusClient client,
                                    List<TagValue> tags, byte[] payload,
                                    String publisherId) throws Exception {
        PublishReply reply = client.Publish(new PublishRequest(
                tags == null ? new ArrayList<>() : tags,
                payload == null ? new byte[0] : payload,
                publisherId == null ? "" : publisherId));
        return reply.seq;
    }

    // Subscribe through a generated EventBusClient; returns
    // the receiving stream (recv from it, or close it to
    // unsubscribe).
    public static EventsGrpcDc.EventBusSubscribeStream subscribeEvents(
            EventsGrpcDc.EventBusClient client, List<TagValue> filterTags) throws Exception {
        return client.Subscribe(new SubscribeRequest(
                filterTags == null ? new ArrayList<>() : filterTags));
    }
}
