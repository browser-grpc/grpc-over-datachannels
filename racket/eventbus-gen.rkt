            .await
            .unwrap();
    }
    let _ = TagValue::default();
    let mut received = Vec::new();
    while received.len() < 2 {
        let event = stream.next().await.unwrap().unwrap();
        received.push(format!("#{} {}", event.seq, String::from_utf8_lossy(&event.payload)));
    }
    println!("subscriber got: {}", received.join(", "));
    println!("broker stats: {:?}", broker.stats());
}
