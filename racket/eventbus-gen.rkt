// in-process. take returns the next event (waiting up to the
// timeout, in seconds), or null; dropped counts this
// subscription's drop-oldest losses.
final class LocalSubscription
{
    private EventBusBroker $broker;
    private EventbusSubscriber $sub;

    public function __construct(EventBusBroker $broker, EventbusSubscriber $sub)
    {
