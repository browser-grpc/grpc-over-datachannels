package grpcdc.events.v1

// Handle for EventBusBroker.subscribeLocal: pull events
// in-process. take returns the next event (waiting up to
// the timeout, in milliseconds), or null; dropped counts
// this subscription's drop-oldest losses.

class LocalSubscription(broker: EventBusBroker, sub: EventbusSubscriber) {
  def dropped: Int = sub.dropped

  def take(timeoutMs: Long = 1000): Event = sub.take(timeoutMs)

  def close(): Unit = {
    broker.removeSubscriber(sub)
  }
}
