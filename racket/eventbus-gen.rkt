(define (emit-php-gitlog)
  (string-append
   (php-header)
   (format #<<TPL
// Git log serde for the event bus: exports an event log to a
// git branch (one commit per event) and imports it back. The
// live broker never touches git; this is the durable serde
// layer beside it. proc_open drives the git plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is a
// no-op (each event's sequence number is the dedup key). The
// commit blob (~a) is authoritative; the message subject and
// trailers are a human index for `git log`.

namespace Grpcdc;

require_once __DIR__ . "/eventbus.php";
require_once __DIR__ . "/events_pb.php";

final class EventbusGit
{
    public const AUTHOR_NAME = "~a";
    public const AUTHOR_EMAIL = "~a";
    public const BLOB_PATH = "~a";
    public const COMMIT_SUBJECT = "~a";
    public const TRAILER_SEQ = "~a";
    public const TRAILER_PUBLISHER = "~a";
    public const TRAILER_TAG = "~a";
    public const ZERO_SHA = "0000000000000000000000000000000000000000";

    public const EVENT_LOG_BRANCH = "grpc-dc-events";

    public static function git(string $repo, array $args, ?string $inputBytes = null, ?array $envExtra = null): string
    {
        $env = getenv();
        if ($envExtra !== null) {
            $env = array_merge($env, $envExtra);
        }
        $proc = proc_open(
            array_merge(["git", "-C", $repo], $args),
            [["pipe", "r"], ["pipe", "w"], ["pipe", "w"]],
            $pipes,
            null,
            $env
        );
        if ($proc === false) {
            throw new \RuntimeException("could not start git");
        }
        fwrite($pipes[0], $inputBytes ?? "");
        fclose($pipes[0]);
        $out = stream_get_contents($pipes[1]);
        fclose($pipes[1]);
        fclose($pipes[2]);
        $code = proc_close($proc);
        if ($code !== 0) {
            throw new \RuntimeException("git " . $args[0] . " failed in " . $repo);
        }
        return $out === false ? "" : $out;
    }

    public static function gitText(string $repo, array $args, ?string $inputBytes = null, ?array $envExtra = null): string
    {
        return trim(self::git($repo, $args, $inputBytes, $envExtra));
    }

    /** Create the log repo if needed (a plain `git init`). */
    public static function initEventLogRepo(string $repo): void
    {
        try {
            self::gitText($repo, ["rev-parse", "--git-dir"]);
        } catch (\Throwable $e) {
            $proc = proc_open(["git", "init", "-q", $repo], [["pipe", "r"], ["pipe", "w"], ["pipe", "w"]], $pipes);
            if ($proc === false || proc_close($proc) !== 0) {
                throw new \RuntimeException("git init failed for " . $repo);
            }
        }
    }

    public static function branchHead(string $repo, string $branch): ?string
    {
        try {
            return self::gitText($repo, ["rev-parse", "--verify", "refs/heads/" . $branch]);
        } catch (\Throwable $e) {
            return null;
        }
    }

    // "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    // `git log` alone can filter the log without decoding blobs.
    public static function commitMessage(\EventsPb\Event $event): string
    {
        $lines = [self::COMMIT_SUBJECT . " " . $event->seq, "", self::TRAILER_SEQ . ": " . $event->seq];
        if ($event->publisherId !== "") {
            $lines[] = self::TRAILER_PUBLISHER . ": " . $event->publisherId;
        }
        foreach ($event->tags as $tv) {
            $lines[] = self::TRAILER_TAG . ": " . Eventbus::tagValueKey($tv);
        }
        return implode("\n", $lines) . "\n";
    }

    public static function commitEnv(\EventsPb\Event $event): array
    {
        $seconds = max(0, intdiv($event->timestampUnixMs, 1000));
        $date = $seconds . " +0000";
        return [
            "GIT_AUTHOR_NAME" => self::AUTHOR_NAME,
            "GIT_AUTHOR_EMAIL" => self::AUTHOR_EMAIL,
            "GIT_COMMITTER_NAME" => self::AUTHOR_NAME,
            "GIT_COMMITTER_EMAIL" => self::AUTHOR_EMAIL,
            "GIT_AUTHOR_DATE" => $date,
            "GIT_COMMITTER_DATE" => $date,
        ];
    }

    // Import a branch: events in chain order (oldest first),
    // optionally windowed by sequence number and narrowed by a
    // tag filter (same containment semantics as Subscribe). A
    // missing branch imports as an empty log.
    public static function importEvents(string $repo, string $branch = self::EVENT_LOG_BRANCH, int $fromSeq = 0, ?int $toSeq = null, ?array $filterTags = null): array
    {
        if (self::branchHead($repo, $branch) === null) {
            return [];
        }
        $events = [];
        foreach (explode("\n", self::gitText($repo, ["rev-list", "--reverse", $branch])) as $sha) {
            if ($sha === "") {
                continue;
            }
            $data = self::git($repo, ["cat-file", "-p", $sha . ":" . self::BLOB_PATH]);
            $event = new \EventsPb\Event();
            $event->unmarshalDc($data);
            if ($event->seq <= $fromSeq) {
                continue;
            }
            if ($toSeq !== null && $event->seq > $toSeq) {
                continue;
            }
            if ($filterTags !== null && !Eventbus::tagsMatch($event->tags, $filterTags)) {
                continue;
            }
            $events[] = $event;
        }
        return $events;
    }

    // Export events onto the branch: one commit per event, in
    // sequence order, skipping sequence numbers the branch
    // already has. Returns the new head sha (or the existing
    // one when nothing was appended). The ref update is a
    // compare-and-swap: a concurrent exporter fails loudly
    // instead of forking the log; retrying is safe.
    public static function exportEvents(string $repo, array $events, string $branch = self::EVENT_LOG_BRANCH): ?string
    {
        self::initEventLogRepo($repo);
        $existing = [];
        foreach (self::importEvents($repo, $branch) as $e) {
            $existing[$e->seq] = true;
        }
        usort($events, fn ($a, $b) => $a->seq <=> $b->seq);
        $head = self::branchHead($repo, $branch);
        $before = $head;
        foreach ($events as $event) {
            if (isset($existing[$event->seq])) {
                continue;
            }
            $blob = self::gitText($repo, ["hash-object", "-w", "--stdin"], $event->marshalDc());
            $tree = self::gitText($repo, ["mktree"], "100644 blob " . $blob . "\t" . self::BLOB_PATH . "\n");
            $args = ["commit-tree", $tree, "-m", self::commitMessage($event)];
            if ($head !== null) {
                $args[] = "-p";
                $args[] = $head;
            }
            $head = self::gitText($repo, $args, null, self::commitEnv($event));
            $existing[$event->seq] = true;
        }
        if ($head !== null && $head !== $before) {
            self::gitText($repo, ["update-ref", "refs/heads/" . $branch, $head, $before ?? self::ZERO_SHA]);
        }
        return $head;
    }
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

(define (emit-php-test)
  (string-append
   (php-header)
   #<<TPL
// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip. Cooperative (Fiber) counterpart
// of the Python/Ruby suites: collectors run in Fibers and the
// test pumps both endpoints while waiting.

require_once __DIR__ . "/../grpcdc.php";
require_once __DIR__ . "/../grpcdc/eventbus.php";
require_once __DIR__ . "/../grpcdc/eventbus_git.php";
require_once __DIR__ . "/test_util.php";

use Grpcdc\Eventbus as EB;

final class TestEventBus
{
    /** @var \Grpcdc\Endpoint[] endpoints pumped while waiting */
    private static array $pumps = [];

    private static function waitFor(callable $fn, string $what): void
    {
        $deadline = microtime(true) + 5.0;
        while (!$fn()) {
            if (microtime(true) > $deadline) {
                throw new \Exception("waitFor timed out: " . $what);
            }
            foreach (self::$pumps as $ep) {
                $ep->pump();
            }
            usleep(1000);
        }
    }

    /** @return array{0: \Grpcdc\EventBusBroker, 1: \EventsGrpcDc\EventBusClient} */
    private static function setupBus(): array
    {
        $broker = new \Grpcdc\EventBusBroker();
        [$a, $b] = \Grpcdc\memoryTransportPair();
        $server = new \Grpcdc\Server();
        $broker->register($server);
        $serverEp = $server->serveTransport($b);
        $channel = new \Grpcdc\Channel($a);
        T::wirePeerPumps($channel->endpoint, $serverEp);
        self::$pumps = [$channel->endpoint, $serverEp];
        return [$broker, new \EventsGrpcDc\EventBusClient($channel)];
    }

    // PHP is cooperative: client streams are received on the
    // main thread (recv pumps both endpoints), so subscribers
    // register first, publishes follow, then the test recvs
    // the expected events from each stream in turn.

    public static function run(): void
    {
        // -- tagsMatch: containment, kinds, empty --
        $tags = [EB::tagString(\EventsPb\Tag::TOPIC, "orders"), EB::tagInt(\EventsPb\Tag::KIND, 5)];
        T::check(EB::tagsMatch($tags, []), "empty filter matches");
        T::check(EB::tagsMatch($tags, [EB::tagString(\EventsPb\Tag::TOPIC, "orders")]), "containment");
        T::check(EB::tagsMatch($tags, $tags), "self match");
        T::check(!EB::tagsMatch($tags, [EB::tagEnum(\EventsPb\Tag::KIND, 5)]), "int != enum");
        T::check(!EB::tagsMatch($tags, [EB::tagString(\EventsPb\Tag::KIND, "5")]), "int != string");
