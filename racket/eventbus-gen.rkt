package events;

// Event bus demo: a broker, one filtered subscriber, and
// three publishes over one in-memory data channel.
// Build with the test-java compile step, then run:
//   java -cp java/build events.EventBusDemo

import grpcdc.Channel;
import grpcdc.MemoryTransport;
import grpcdc.Server;
import grpcdc.Transport;
import grpcdc.events.v1.Event;
import grpcdc.events.v1.EventBusBroker;
import grpcdc.events.v1.Eventbus;
import grpcdc.events.v1.EventsGrpcDc;
import grpcdc.events.v1.Tag;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

public final class EventBusDemo {
    private EventBusDemo() {}

    public static void main(String[] args) throws Exception {
        EventBusBroker broker = new EventBusBroker();
        Transport[] pair = MemoryTransport.pair();
        Server server = new Server();
        broker.register(server);
        server.serveTransport(pair[1]);
        EventsGrpcDc.EventBusClient client =
                new EventsGrpcDc.EventBusClient(new Channel(pair[0]));

        List<String> received = Collections.synchronizedList(new ArrayList<>());
        Thread thread = new Thread(() -> {
            try {
                EventsGrpcDc.EventBusSubscribeStream stream =
                        Eventbus.subscribeEvents(client, List.of(
                                Eventbus.tagString(Tag.TOPIC, "orders")));
                while (received.size() < 2) {
                    Event event = stream.recv();
                    received.add("#" + event.seq + " "
                            + new String(event.payload, StandardCharsets.UTF_8));
                }
                stream.close();
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        });
        thread.setDaemon(true);
        thread.start();
        while (broker.stats().get("subscribers") < 1) Thread.sleep(5);
        Eventbus.publishEvent(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders")),
                "order-1".getBytes(StandardCharsets.UTF_8), "demo");
        Eventbus.publishEvent(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "other")),
                "noise".getBytes(StandardCharsets.UTF_8), "demo");
        Eventbus.publishEvent(client,
                List.of(Eventbus.tagString(Tag.TOPIC, "orders")),
                "order-2".getBytes(StandardCharsets.UTF_8), "demo");
        thread.join(5000);
        System.out.println("subscriber got: " + String.join(", ", received));
        System.out.println("broker stats: " + broker.stats());
    }
}
