(define (emit-ruby-gitlog)
  (string-append
   (ruby-header)
   (format #<<TPL
# Git log serde for the event bus: exports an event log to a
# git branch (one commit per event) and imports it back. The
# live broker never touches git; this is the durable serde
# layer beside it. Stdlib Open3 drives the git plumbing.
#
# Deterministic: the same events always produce the same
# commits, so re-exporting a log the branch already has is a
# no-op (each event's sequence number is the dedup key). The
# commit blob (~a) is authoritative; the message subject and
# trailers are a human index for `git log`.

require "open3"

require_relative "eventbus"
require_relative "events_pb"

module Grpcdc
  module EventbusGit
    AUTHOR_NAME = "~a"
    AUTHOR_EMAIL = "~a"
    BLOB_PATH = "~a"
    COMMIT_SUBJECT = "~a"
    TRAILER_SEQ = "~a"
    TRAILER_PUBLISHER = "~a"
    TRAILER_TAG = "~a"
    ZERO_SHA = "0" * 40

    EVENT_LOG_BRANCH = "grpc-dc-events"

    def self.git(repo, args, input_bytes = nil, env_extra = nil)
      out, _err, status = Open3.capture3(env_extra || {}, "git", "-C", repo, *args, stdin_data: input_bytes || "".b)
      raise "git #{args.first} failed in #{repo}" unless status.success?

      out
    end

    def self.git_text(repo, args, input_bytes = nil, env_extra = nil)
      git(repo, args, input_bytes, env_extra).strip
    end

    # Create the log repo if needed (a plain `git init`).
    def self.init_event_log_repo(repo)
      git_text(repo, ["rev-parse", "--git-dir"])
    rescue StandardError
      out, _err, status = Open3.capture3("git", "init", "-q", repo)
      raise "git init failed for #{repo}" unless status.success?

      out
    end

    def self.branch_head(repo, branch)
      git_text(repo, ["rev-parse", "--verify", "refs/heads/#{branch}"])
    rescue StandardError
      nil
    end

    # "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    # `git log` alone can filter the log without decoding blobs.
    def self.commit_message(event)
      lines = ["#{COMMIT_SUBJECT} #{event.seq}", "", "#{TRAILER_SEQ}: #{event.seq}"]
      lines << "#{TRAILER_PUBLISHER}: #{event.publisher_id}" unless event.publisher_id.empty?
      (event.tags || []).each { |tv| lines << "#{TRAILER_TAG}: #{Eventbus.tag_value_key(tv)}" }
      lines.join("\n") + "\n"
    end

    def self.commit_env(event)
      seconds = [0, event.timestamp_unix_ms / 1000].max
      date = "#{seconds} +0000"
      {
        "GIT_AUTHOR_NAME" => AUTHOR_NAME,
        "GIT_AUTHOR_EMAIL" => AUTHOR_EMAIL,
        "GIT_COMMITTER_NAME" => AUTHOR_NAME,
        "GIT_COMMITTER_EMAIL" => AUTHOR_EMAIL,
        "GIT_AUTHOR_DATE" => date,
        "GIT_COMMITTER_DATE" => date
      }
    end

    # Import a branch: events in chain order (oldest first),
    # optionally windowed by sequence number and narrowed by a
    # tag filter (same containment semantics as Subscribe). A
    # missing branch imports as an empty log.
    def self.import_events(repo, branch = EVENT_LOG_BRANCH, from_seq: 0, to_seq: nil, filter_tags: nil)
      return [] if branch_head(repo, branch).nil?

      events = []
      git_text(repo, ["rev-list", "--reverse", branch]).split("\n").each do |sha|
        next if sha.empty?

        data = git(repo, ["cat-file", "-p", "#{sha}:#{BLOB_PATH}"])
        event = EventsPb::Event.new
        event.unmarshal_dc(data)
        next if event.seq <= from_seq
        next if !to_seq.nil? && event.seq > to_seq
        next if filter_tags && !Eventbus.tags_match(event.tags, filter_tags)

        events << event
      end
      events
    end

    # Export events onto the branch: one commit per event, in
    # sequence order, skipping sequence numbers the branch
    # already has. Returns the new head sha (or the existing one
    # when nothing was appended). The ref update is a
    # compare-and-swap: a concurrent exporter fails loudly
    # instead of forking the log; retrying is safe.
    def self.export_events(repo, events, branch = EVENT_LOG_BRANCH)
      init_event_log_repo(repo)
      existing = {}
      import_events(repo, branch).each { |e| existing[e.seq] = true }
      head = branch_head(repo, branch)
      before = head
      events.sort_by(&:seq).each do |event|
        next if existing.key?(event.seq)

        blob = git_text(repo, ["hash-object", "-w", "--stdin"], event.marshal_dc)
        tree = git_text(repo, ["mktree"], "100644 blob #{blob}\t#{BLOB_PATH}\n".encode(Encoding::UTF_8))
        args = ["commit-tree", tree, "-m", commit_message(event)]
        args += ["-p", head] unless head.nil?
        head = git_text(repo, args, nil, commit_env(event))
        existing[event.seq] = true
      end
      if !head.nil? && head != before
        git_text(repo, ["update-ref", "refs/heads/#{branch}", head, before || ZERO_SHA])
      end
      head
    end
  end
end
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

(define (emit-ruby-test)
  (string-append
   (ruby-header)
   #<<TPL
# Event bus end-to-end over the loopback transport, plus the
# git log serde round-trip.

require "grpcdc"
require "grpcdc/eventbus"
require "grpcdc/eventbus_git"
require_relative "test_util"

module TestEventBus
  EB = Grpcdc::Eventbus
  GIT = Grpcdc::EventbusGit
  TAG = EventsPb::Tag

  def self.wait_for(what)
    deadline = Time.now + 5
    until yield
      raise "wait_for timed out: #{what}" if Time.now > deadline

      sleep(0.01)
    end
  end

  def self.setup_bus(queue_capacity: nil)
    broker = queue_capacity.nil? ? EB::EventBusBroker.new : EB::EventBusBroker.new(queue_capacity: queue_capacity)
    a, b = Grpcdc.memory_transport_pair
    server = Grpcdc::Server.new
    broker.register(server)
    server.serve_transport(b)
    [broker, EB::EventBusClient.new(Grpcdc::Channel.new(a))]
  end

  def self.collect(stream, out)
    Thread.new do
      begin
        stream.each { |event| out << event }
      rescue StandardError
        nil
      end
    end
  end

  def self.run
    # -- tags_match: containment, kinds, empty --
    tags = [EB.tag_string(TAG::TOPIC, "orders"), EB.tag_int(TAG::KIND, 5)]
    TestUtil.check(EB.tags_match(tags, []), "empty filter matches")
    TestUtil.check(EB.tags_match(tags, [EB.tag_string(TAG::TOPIC, "orders")]), "containment")
    TestUtil.check(EB.tags_match(tags, tags), "self match")
    TestUtil.check(!EB.tags_match(tags, [EB.tag_enum(TAG::KIND, 5)]), "int != enum")
    TestUtil.check(!EB.tags_match(tags, [EB.tag_string(TAG::KIND, "5")]), "int != string")
    TestUtil.check(!EB.tags_match(tags, [EB.tag_string(TAG::TOPIC, "other")]), "value mismatch")

    # -- fan-out honors filters --
    broker, client = setup_bus
    orders = []
    all_events = []
    collect(EB.subscribe_events(client, [EB.tag_string(TAG::TOPIC, "orders")]), orders)
    collect(EB.subscribe_events(client, []), all_events)
    wait_for("2 subscribers") { broker.stats["subscribers"] == 2 }
    TestUtil.assert_eq(EB.publish_event(client, [EB.tag_string(TAG::TOPIC, "orders")], "o1", "test"), 1, "seq 1")
    TestUtil.assert_eq(EB.publish_event(client, [EB.tag_string(TAG::TOPIC, "other")], "x1", "test"), 2, "seq 2")
    wait_for("fanout") { orders.length == 1 && all_events.length == 2 }
    TestUtil.assert_eq(orders[0].payload, "o1", "filtered payload")
    TestUtil.assert_eq(orders[0].publisher_id, "test", "publisher")
    TestUtil.assert_eq(all_events.map(&:seq), [1, 2], "all seqs")

    # -- kinds never cross-match --
    _broker2, client2 = setup_bus
    got = []
    collect(EB.subscribe_events(client2, [EB.tag_int(TAG::KIND, 5)]), got)
    EB.publish_event(client2, [EB.tag_string(TAG::KIND, "5")], "s")
    EB.publish_event(client2, [EB.tag_enum(TAG::KIND, 5)], "e")
    TestUtil.assert_eq(EB.publish_event(client2, [EB.tag_int(TAG::KIND, 5)], "i"), 3, "seq 3")
    wait_for("kind match") { got.length == 1 }
    TestUtil.assert_eq(got[0].payload, "i", "int kind only")

    # -- user tags pass through --
    _broker3, client3 = setup_bus
    mine = EventsPb::TagValue.new(tag: 1004, string_value: "x")
    got3 = []
    collect(EB.subscribe_events(client3, [mine]), got3)
    EB.publish_event(client3, [EventsPb::TagValue.new(tag: 1004, string_value: "x")], "u")
    wait_for("user tag") { got3.length == 1 }
    TestUtil.assert_eq(got3[0].tags[0].tag, 1004, "user tag number")
    TestUtil.assert_eq(got3[0].tags[0].string_value, "x", "user tag value")

    # -- slow subscriber drops oldest --
    require "tmpdir"
    broker4 = EB::EventBusBroker.new(queue_capacity: 4)
    sub = broker4.subscribe_local([])
    (1..6).each { |i| broker4.publish_event([], "m#{i}") }
    TestUtil.assert_eq(broker4.stats["dropped"], 2, "dropped count")
    TestUtil.assert_eq(sub.dropped, 2, "sub dropped")
    TestUtil.assert_eq((1..4).map { sub.take.seq }, [3, 4, 5, 6], "kept newest")
    sub.close
    TestUtil.assert_eq(broker4.stats["subscribers"], 0, "close unregisters")

    # -- close unsubscribes (RPC) --
    broker5, client5 = setup_bus
    stream = EB.subscribe_events(client5, [])
    wait_for("1 subscriber") { broker5.stats["subscribers"] == 1 }
    EB.publish_event(client5, [], "a")
    TestUtil.assert_eq(stream.recv.payload, "a", "recv before close")
    stream.close
    EB.publish_event(client5, [], "b")
    wait_for("reaped") { broker5.stats["subscribers"] == 0 }

    # -- git log round-trip + idempotent --
    Dir.mktmpdir("grpc-dc-eventbus-") do |repo|
      broker6 = EB::EventBusBroker.new
      events = [
        broker6.publish_event([EB.tag_string(TAG::TOPIC, "orders")], "o1", "test"),
        broker6.publish_event([EB.tag_string(TAG::TOPIC, "other")], "x1", "test"),
        broker6.publish_event([EB.tag_string(TAG::TOPIC, "orders")], "o2", "test")
      ]
      head1 = GIT.export_events(repo, events)
      count = GIT.git_text(repo, ["rev-list", "--count", "grpc-dc-events"])
      TestUtil.assert_eq(count, "3", "commit count")
      TestUtil.assert_eq(GIT.export_events(repo, events), head1, "idempotent re-export")
      imported = GIT.import_events(repo)
      TestUtil.assert_eq(imported.map(&:seq), [1, 2, 3], "import seqs")
      TestUtil.assert_eq(imported.map(&:payload), ["o1", "x1", "o2"], "import payloads")
      filtered = GIT.import_events(repo, filter_tags: [EB.tag_string(TAG::TOPIC, "orders")])
      TestUtil.assert_eq(filtered.map(&:seq), [1, 3], "import filter")
      window = GIT.import_events(repo, from_seq: 1, to_seq: 2)
      TestUtil.assert_eq(window.map(&:seq), [2], "import window")
    end

    puts "TestEventBus OK"
  end
end
TPL
   ))

(define (emit-ruby-demo)
  (string-append
   (ruby-header)
   #<<TPL
# Event bus demo: a broker, one filtered subscriber, and
# three publishes over one in-memory data channel.
# `ruby ruby/examples/eventbus_demo.rb` from the repo root.

$LOAD_PATH.unshift(File.expand_path("..", __dir__))

require "grpcdc"
require "grpcdc/eventbus"

EB = Grpcdc::Eventbus

broker = EB::EventBusBroker.new
a, b = Grpcdc.memory_transport_pair
server = Grpcdc::Server.new
broker.register(server)
server.serve_transport(b)
client = EB::EventBusClient.new(Grpcdc::Channel.new(a))

received = []
thread = Thread.new do
  stream = EB.subscribe_events(client, [EB.tag_string(EventsPb::Tag::TOPIC, "orders")])
  stream.each do |event|
    received << "##{event.seq} #{event.payload}"
    if received.length == 2
      stream.close
      break
    end
  end
end
sleep(0.01) while broker.stats["subscribers"] < 1
EB.publish_event(client, [EB.tag_string(EventsPb::Tag::TOPIC, "orders")], "order-1", "demo")
EB.publish_event(client, [EB.tag_string(EventsPb::Tag::TOPIC, "other")], "noise", "demo")
EB.publish_event(client, [EB.tag_string(EventsPb::Tag::TOPIC, "orders")], "order-2", "demo")
thread.join(5)
puts "subscriber got: #{received.join(", ")}"
puts "broker stats: #{broker.stats}"
TPL
   ))

(define (generate-eventbus)
  (define (write rel text)
    (define path (build-path root rel))
    (make-directory* (path-only path))
    (call-with-output-file path #:exists 'replace
      (lambda (out) (display text out) (unless (string-suffix? text "\n") (newline out))))
    (printf "generated ~a\n" (path->string path)))
  (write (build-path "js" "src" "eventbus.js") (emit-js-eventbus))
  (write (build-path "js" "src" "eventbus_gitlog.js") (emit-js-gitlog))
  (write (build-path "js" "test" "eventbus.test.js") (emit-js-test))
  (write (build-path "js" "examples" "eventbus_demo.js") (emit-js-demo))
  (write (build-path "python" "grpcdc" "eventbus.py") (emit-py-eventbus))
  (write (build-path "python" "grpcdc" "eventbus_git.py") (emit-py-gitlog))
  (write (build-path "python" "tests" "test_eventbus.py") (emit-py-test))
  (write (build-path "python" "examples" "eventbus_demo.py") (emit-py-demo))
  (write (build-path "go" "eventbus" "eventbus.go") (emit-go-eventbus))
  (write (build-path "go" "eventbus" "eventbus_git.go") (emit-go-gitlog))
  (write (build-path "go" "eventbus_test.go") (emit-go-test))
  (write (build-path "go" "examples" "eventbus_demo" "main.go") (emit-go-demo))
  (write (build-path "rust" "src" "eventbus.rs") (emit-rust-eventbus))
  (write (build-path "ruby" "grpcdc" "eventbus.rb") (emit-ruby-eventbus))
  (write (build-path "ruby" "grpcdc" "eventbus_git.rb") (emit-ruby-gitlog))
  (write (build-path "ruby" "tests" "test_eventbus.rb") (emit-ruby-test))
  (write (build-path "ruby" "examples" "eventbus_demo.rb") (emit-ruby-demo))
  (write (build-path "rust" "src" "eventbus_git.rs") (emit-rust-gitlog))
  (write (build-path "rust" "tests" "eventbus.rs") (emit-rust-test))
  (write (build-path "rust" "examples" "eventbus_demo.rs") (emit-rust-demo)))
