    }
}

final class EventbusSubscriber
{
    public array $filter;
    public int $dropped = 0;
    private array $queue = [];
    private int $capacity;

    public function __construct(array $filterTags, int $capacity)
    {
        $this->filter = $filterTags;
        $this->capacity = $capacity;
    }

    public function push(\EventsPb\Event $event): bool
    {
        $dropped = false;
        if (count($this->queue) >= $this->capacity) {
            array_shift($this->queue);
            $this->dropped++;
            $dropped = true;
        }
        $this->queue[] = $event;
        return $dropped;
    }

    public function poll(): ?\EventsPb\Event
    {
        if (count($this->queue) === 0) {
            return null;
        }
        return array_shift($this->queue);
    }

    // Next queued event, or null when the wait times out. In a
    // Fiber the wait suspends (the endpoint pump resumes it);
    // outside one it sleeps briefly between polls.
    public function take(float $timeout): ?\EventsPb\Event
    {
        $deadline = microtime(true) + $timeout;
        while (true) {
            $event = $this->poll();
            if ($event !== null) {
                return $event;
            }
            if (microtime(true) >= $deadline) {
                return null;
            }
            if (\Fiber::getCurrent() !== null) {
                \Fiber::suspend();
            } else {
                usleep(1000);
            }
        }
    }
}

// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: register() it on a Grpcdc\Server next to your own
// services, or call publishEvent directly in-process.
final class EventBusBroker
{
    private int $queueCapacity;
    private array $subscribers = [];
    private int $seq = 0;
    private int $published = 0;
    private int $dropped = 0;

    public function __construct(int $queueCapacity = Eventbus::SUBSCRIBER_QUEUE_CAPACITY)
    {
        $this->queueCapacity = $queueCapacity;
    }

    // Accept an event: assign its sequence number and
    // timestamp and fan it out to matching subscribers.
    // Returns the stamped \EventsPb\Event.
    public function publishEvent(array $tags, string $payload, string $publisherId = ""): \EventsPb\Event
    {
        $this->seq++;
        $event = new \EventsPb\Event(
            $tags,
            $payload,
            $this->seq,
            $publisherId,
            (int) (microtime(true) * 1000)
        );
        $this->published++;
        foreach ($this->subscribers as $sub) {
            if (Eventbus::tagsMatch($event->tags, $sub->filter) && $sub->push($event)) {
                $this->dropped++;
            }
        }
        return $event;
    }

    public function stats(): array
    {
        return [
            "published" => $this->published,
            "subscribers" => count($this->subscribers),
            "dropped" => $this->dropped,
        ];
    }

    // grpcdc.events.v1.EventBus service implementation
    // (register calls these).
    public function Publish(\Grpcdc\CallContext $ctx, \EventsPb\PublishRequest $req): \EventsPb\PublishReply
    {
        $event = $this->publishEvent($req->tags, $req->payload, $req->publisherId);
        return new \EventsPb\PublishReply($event->seq);
    }

    public function Subscribe(\EventsPb\SubscribeRequest $req, \EventsGrpcDc\SendStream $stream): void
    {
        $sub = new EventbusSubscriber($req->filter, $this->queueCapacity);
        $this->subscribers[] = $sub;
