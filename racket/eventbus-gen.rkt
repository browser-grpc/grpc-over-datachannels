(define (emit-go-gitlog)
  (string-append
   (go-header)
   (format #<<TPL
// Git log serde for the event bus: exports an event log to a
// git branch (one commit per event) and imports it back. The
// live broker never touches git; this is the durable serde
// layer beside it. Stdlib os/exec drives the git plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is a
// no-op (each event's sequence number is the dedup key). The
// commit blob (~a) is authoritative; the message subject and
// trailers are a human index for `git log`.
package v1

import (
	"bytes"
	"fmt"
	"os"
	"os/exec"
	"sort"
	"strconv"
	"strings"
)

const (
	eventLogAuthorName  = "~a"
	eventLogAuthorEmail = "~a"
	eventLogBlobPath    = "~a"
	eventLogSubject     = "~a"
	eventLogTrailerSeq  = "~a"
	eventLogTrailerPub  = "~a"
	eventLogTrailerTag  = "~a"
)

// EventLogBranch is the default branch an event log exports to.
const EventLogBranch = "grpc-dc-events"

const zeroSHA = "0000000000000000000000000000000000000000"

func gitRun(repo string, input []byte, extraEnv []string, args ...string) ([]byte, error) {
	full := append([]string{"-C", repo}, args...)
	cmd := exec.Command("git", full...)
	if input != nil {
		cmd.Stdin = bytes.NewReader(input)
	}
	if extraEnv != nil {
		cmd.Env = append(os.Environ(), extraEnv...)
	}
	var stderr bytes.Buffer
	cmd.Stderr = &stderr
	out, err := cmd.Output()
	if err != nil {
		return nil, fmt.Errorf("git %s: %w: %s", strings.Join(args, " "), err, strings.TrimSpace(stderr.String()))
	}
	return out, nil
}

func gitText(repo string, input []byte, extraEnv []string, args ...string) (string, error) {
	out, err := gitRun(repo, input, extraEnv, args...)
	if err != nil {
		return "", err
	}
	return strings.TrimSpace(string(out)), nil
}

// InitEventLogRepo creates the log repo if needed (a plain
// `git init`).
func InitEventLogRepo(repo string) error {
	if _, err := gitText(repo, nil, nil, "rev-parse", "--git-dir"); err == nil {
		return nil
	}
	if err := os.MkdirAll(repo, 0o755); err != nil {
		return err
	}
	cmd := exec.Command("git", "init", "-q", repo)
	if out, err := cmd.CombinedOutput(); err != nil {
		return fmt.Errorf("git init: %w: %s", err, strings.TrimSpace(string(out)))
	}
	return nil
}

func eventLogBranchHead(repo, branch string) (string, bool) {
	head, err := gitText(repo, nil, nil, "rev-parse", "--verify", "refs/heads/"+branch)
	if err != nil {
		return "", false
	}
	return head, true
}

// EventCommitMessage renders the commit message for an event:
// "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
// `git log` alone can filter the log without decoding blobs.
func EventCommitMessage(event *Event) string {
	var b strings.Builder
	fmt.Fprintf(&b, "%s %d\n\n%s: %d\n", eventLogSubject, event.Seq, eventLogTrailerSeq, event.Seq)
	if event.PublisherId != "" {
		fmt.Fprintf(&b, "%s: %s\n", eventLogTrailerPub, event.PublisherId)
	}
	for _, tv := range event.Tags {
		fmt.Fprintf(&b, "%s: %s\n", eventLogTrailerTag, TagValueKey(tv))
	}
	return b.String()
}

func eventCommitEnv(event *Event) []string {
	seconds := event.TimestampUnixMs / 1000
	if seconds < 0 {
		seconds = 0
	}
	date := strconv.FormatInt(seconds, 10) + " +0000"
	return []string{
		"GIT_AUTHOR_NAME=" + eventLogAuthorName,
		"GIT_AUTHOR_EMAIL=" + eventLogAuthorEmail,
		"GIT_COMMITTER_NAME=" + eventLogAuthorName,
		"GIT_COMMITTER_EMAIL=" + eventLogAuthorEmail,
		"GIT_AUTHOR_DATE=" + date,
		"GIT_COMMITTER_DATE=" + date,
	}
}

// ImportEventsFromGit imports a branch: events in chain order
// (oldest first), optionally windowed by sequence number
// (fromSeq exclusive, toSeq inclusive; 0 = unbounded) and
// narrowed by a tag filter (same containment semantics as
// Subscribe). A missing branch imports as an empty log.
func ImportEventsFromGit(repo, branch string, filter []*TagValue, fromSeq, toSeq uint64) ([]*Event, error) {
	if _, ok := eventLogBranchHead(repo, branch); !ok {
		return nil, nil
	}
	out, err := gitText(repo, nil, nil, "rev-list", "--reverse", branch)
	if err != nil {
		return nil, err
	}
	var events []*Event
	for _, sha := range strings.Fields(out) {
		data, err := gitRun(repo, nil, nil, "cat-file", "-p", sha+":"+eventLogBlobPath)
		if err != nil {
			return nil, err
		}
		event := new(Event)
		if err := event.UnmarshalDC(data); err != nil {
			return nil, err
		}
		if event.Seq <= fromSeq {
			continue
		}
		if toSeq != 0 && event.Seq > toSeq {
			continue
		}
		if len(filter) > 0 && !TagsMatch(event.Tags, filter) {
			continue
		}
		events = append(events, event)
	}
	return events, nil
}

// ExportEventsToGit exports events onto the branch: one
// commit per event, in sequence order, skipping sequence
// numbers the branch already has. It returns the new head sha
// (or the existing one when nothing was appended). The ref
// update is a compare-and-swap: a concurrent exporter fails
// loudly instead of forking the log; retrying is safe.
func ExportEventsToGit(repo string, events []*Event, branch string) (string, error) {
	if err := InitEventLogRepo(repo); err != nil {
		return "", err
	}
	existingEvents, err := ImportEventsFromGit(repo, branch, nil, 0, 0)
	if err != nil {
		return "", err
	}
	existing := map[uint64]bool{}
	for _, e := range existingEvents {
		existing[e.Seq] = true
	}
	ordered := append([]*Event(nil), events...)
	sort.Slice(ordered, func(i, j int) bool { return ordered[i].Seq < ordered[j].Seq })
	head, _ := eventLogBranchHead(repo, branch)
	before := head
	for _, event := range ordered {
		if existing[event.Seq] {
			continue
		}
		blob, err := gitText(repo, event.MarshalDC(), nil, "hash-object", "-w", "--stdin")
		if err != nil {
			return "", err
		}
		tree, err := gitText(repo, []byte(fmt.Sprintf("100644 blob %s\t%s\n", blob, eventLogBlobPath)), nil, "mktree")
		if err != nil {
			return "", err
		}
		args := []string{"commit-tree", tree, "-m", EventCommitMessage(event)}
		if head != "" {
			args = append(args, "-p", head)
		}
		head, err = gitText(repo, nil, eventCommitEnv(event), args...)
		if err != nil {
			return "", err
		}
		existing[event.Seq] = true
	}
	if head != "" && head != before {
		old := before
		if old == "" {
			old = zeroSHA
		}
		if _, err := gitText(repo, nil, nil, "update-ref", "refs/heads/"+branch, head, old); err != nil {
			return "", err
		}
	}
	return head, nil
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

