// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (EventsPb,
// EventsGrpcDc); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SubscriberQueueCapacity) and drops its oldest
// events when it falls behind; Stats reports the drops.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;

namespace Grpcdc.events.v1;

public static class Eventbus
{
    public const int SubscriberQueueCapacity = ~a;

    // Canonical identity of one tag value. The oneof kind is
    // part of the identity (int 5 != "5" != enum 5). Kinds are
    // told apart by value, so an all-default TagValue reads as
    // the empty string value; numbers compare bit-exact, never
    // via decimal text.
    private static string ValueKey(TagValue tv)
    {
        if (tv.StringValue != "") return "s:" + tv.StringValue;
        if (tv.IntValue != 0) return "i:" + tv.IntValue.ToString(CultureInfo.InvariantCulture);
        if (tv.DoubleValue != 0)
        {
            var bytes = BitConverter.GetBytes(tv.DoubleValue);
            if (BitConverter.IsLittleEndian) Array.Reverse(bytes);
            return "d:" + BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
        }
        if (tv.BoolValue) return "b:true";
        if (tv.EnumValue != 0) return "e:" + tv.EnumValue.ToString(CultureInfo.InvariantCulture);
        return "s:";
    }

    /// <summary>Stable key for one TagValue, e.g. "1|s:orders".</summary>
    public static string TagValueKey(TagValue tv) => (int)tv.Tag + "|" + ValueKey(tv);

    // Containment match: the event is delivered when its tag
    // list contains every (tag, value) pair of the filter. An
    // empty filter matches everything.
    public static bool TagsMatch(List<TagValue> eventTags, List<TagValue> filterTags)
    {
        if (filterTags == null || filterTags.Count == 0) return true;
        var have = new HashSet<string>();
        if (eventTags != null)
        {
            foreach (var tv in eventTags) have.Add(TagValueKey(tv));
        }
        foreach (var f in filterTags)
        {
            if (!have.Contains(TagValueKey(f))) return false;
        }
        return true;
    }

    public static TagValue TagString(Tag tag, object value) =>
        new(tag, Convert.ToString(value, CultureInfo.InvariantCulture) ?? "", 0, 0, false, 0);

    public static TagValue TagInt(Tag tag, object value) =>
        new(tag, "", Convert.ToInt64(value, CultureInfo.InvariantCulture), 0, false, 0);

    public static TagValue TagDouble(Tag tag, object value) =>
        new(tag, "", 0, Convert.ToDouble(value, CultureInfo.InvariantCulture), false, 0);

    public static TagValue TagBool(Tag tag, object value) =>
        new(tag, "", 0, 0, Convert.ToBoolean(value, CultureInfo.InvariantCulture), 0);

    public static TagValue TagEnum(Tag tag, object value) =>
        new(tag, "", 0, 0, false, Convert.ToInt32(value, CultureInfo.InvariantCulture));

    // Publish through a generated EventBusClient; returns the
    // broker-assigned sequence number.
    public static long PublishEvent(EventsGrpcDc.EventBusClient client,
                                    List<TagValue> tags, byte[] payload,
                                    string publisherId = "")
