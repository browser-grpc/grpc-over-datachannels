package grpcdc.events.v1;

// Handle for EventBusBroker.subscribeLocal: pull events
// in-process. take returns the next event (waiting up to
// the timeout, in milliseconds), or null; dropped counts
// this subscription's drop-oldest losses.

public final class LocalSubscription {
    private final EventBusBroker broker;
    private final EventBusBroker.Subscriber sub;

    LocalSubscription(EventBusBroker broker, EventBusBroker.Subscriber sub) {
        this.broker = broker;
        this.sub = sub;
    }

    public int dropped() {
        return sub.droppedCount();
    }

    public Event take(long timeoutMs) throws InterruptedException {
        return sub.take(timeoutMs);
    }

    public Event take() throws InterruptedException {
        return take(1000);
    }

    public void close() {
