// Git log serde for the event bus: exports an event log to
// a git branch (one commit per event) and imports it back.
// The live broker never touches git; this is the durable
// serde layer beside it. System.Diagnostics.Process drives
// the git plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is
// a no-op (each event's sequence number is the dedup key).
// The commit blob (~a) is authoritative; the message
// subject and trailers are a human index for `git log`.

using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.Linq;
using System.Text;

namespace Grpcdc.events.v1;

public static class EventbusGit
{
    public const string AuthorName = "~a";
    public const string AuthorEmail = "~a";
    public const string BlobPath = "~a";
    public const string CommitSubject = "~a";
    public const string TrailerSeq = "~a";
    public const string TrailerPublisher = "~a";
    public const string TrailerTag = "~a";
    public const string ZeroSha = "0000000000000000000000000000000000000000";

    public const string EventLogBranch = "grpc-dc-events";

    public static byte[] Git(string repo, List<string> args, byte[] inputBytes = null,
                             Dictionary<string, string> envExtra = null)
    {
        var psi = new ProcessStartInfo("git")
        {
            RedirectStandardInput = true,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            UseShellExecute = false,
        };
        psi.ArgumentList.Add("-C");
        psi.ArgumentList.Add(repo);
        foreach (var a in args) psi.ArgumentList.Add(a);
        if (envExtra != null)
        {
            foreach (var kv in envExtra) psi.Environment[kv.Key] = kv.Value;
        }
        using var proc = Process.Start(psi);
        if (inputBytes != null) proc.StandardInput.BaseStream.Write(inputBytes, 0, inputBytes.Length);
        proc.StandardInput.Close();
        var outBytes = new List<byte>();
        var buffer = new byte[8192];
        int n;
        while ((n = proc.StandardOutput.BaseStream.Read(buffer, 0, buffer.Length)) > 0)
        {
            for (var i = 0; i < n; i++) outBytes.Add(buffer[i]);
        }
        proc.StandardError.ReadToEnd();
        proc.WaitForExit();
        if (proc.ExitCode != 0)
        {
            throw new InvalidOperationException("git " + args[0] + " failed in " + repo);
        }
        return outBytes.ToArray();
    }

    public static string GitText(string repo, List<string> args, byte[] inputBytes = null,
                                 Dictionary<string, string> envExtra = null) =>
        Encoding.UTF8.GetString(Git(repo, args, inputBytes, envExtra)).Trim();

    /// <summary>Create the log repo if needed (a plain `git init`).</summary>
    public static void InitEventLogRepo(string repo)
    {
        try
        {
            GitText(repo, new List<string> { "rev-parse", "--git-dir" });
        }
        catch (Exception)
        {
            var psi = new ProcessStartInfo("git")
            {
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
            };
            psi.ArgumentList.Add("init");
            psi.ArgumentList.Add("-q");
            psi.ArgumentList.Add(repo);
            using var proc = Process.Start(psi);
            proc.StandardOutput.ReadToEnd();
            proc.StandardError.ReadToEnd();
            proc.WaitForExit();
            if (proc.ExitCode != 0)
            {
                throw new InvalidOperationException("git init failed for " + repo);
            }
        }
    }

    public static string BranchHead(string repo, string branch)
    {
        try
        {
            return GitText(repo, new List<string> { "rev-parse", "--verify", "refs/heads/" + branch });
        }
        catch (Exception)
        {
            return null;
        }
    }

    // "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    // `git log` alone can filter the log without decoding blobs.
    public static string CommitMessage(Event ev)
    {
        var lines = new List<string>
        {
            CommitSubject + " " + ev.Seq,
            "",
            TrailerSeq + ": " + ev.Seq,
        };
        if (ev.PublisherId != "") lines.Add(TrailerPublisher + ": " + ev.PublisherId);
        foreach (var tv in ev.Tags) lines.Add(TrailerTag + ": " + Eventbus.TagValueKey(tv));
        return string.Join("\n", lines) + "\n";
    }

    public static Dictionary<string, string> CommitEnv(Event ev)
    {
        var seconds = Math.Max(0, ev.TimestampUnixMs / 1000);
        var date = seconds + " +0000";
        return new Dictionary<string, string>
        {
            ["GIT_AUTHOR_NAME"] = AuthorName,
            ["GIT_AUTHOR_EMAIL"] = AuthorEmail,
            ["GIT_COMMITTER_NAME"] = AuthorName,
            ["GIT_COMMITTER_EMAIL"] = AuthorEmail,
            ["GIT_AUTHOR_DATE"] = date,
            ["GIT_COMMITTER_DATE"] = date,
        };
    }

    // Import a branch: events in chain order (oldest first),
    // optionally windowed by sequence number and narrowed by
    // a tag filter (same containment semantics as
    // Subscribe). A missing branch imports as an empty log.
    public static List<Event> ImportEvents(string repo, string branch = EventLogBranch,
                                           long fromSeq = 0, long? toSeq = null,
                                           List<TagValue> filterTags = null)
    {
        var events = new List<Event>();
        if (BranchHead(repo, branch) == null) return events;
        var list = GitText(repo, new List<string> { "rev-list", "--reverse", branch });
        foreach (var sha in list.Split('\n'))
        {
            if (sha == "") continue;
            var data = Git(repo, new List<string> { "cat-file", "-p", sha + ":" + BlobPath });
            var ev = new Event();
            ev.UnmarshalDc(data);
            if ((long)ev.Seq <= fromSeq) continue;
            if (toSeq != null && (long)ev.Seq > toSeq.Value) continue;
            if (filterTags != null && !Eventbus.TagsMatch(ev.Tags, filterTags)) continue;
            events.Add(ev);
        }
        return events;
    }

    // Export events onto the branch: one commit per event, in
    // sequence order, skipping sequence numbers the branch
    // already has. Returns the new head sha (or the existing
    // one when nothing was appended). The ref update is a
    // compare-and-swap: a concurrent exporter fails loudly
    // instead of forking the log; retrying is safe.
    public static string ExportEvents(string repo, List<Event> events,
                                      string branch = EventLogBranch)
    {
        InitEventLogRepo(repo);
        var existing = new HashSet<ulong>();
        foreach (var e in ImportEvents(repo, branch)) existing.Add(e.Seq);
        var ordered = events.OrderBy(e => e.Seq).ToList();
        var head = BranchHead(repo, branch);
        var before = head;
        foreach (var ev in ordered)
        {
            if (existing.Contains(ev.Seq)) continue;
            var blob = GitText(repo, new List<string> { "hash-object", "-w", "--stdin" },
                ev.MarshalDc());
            var tree = GitText(repo, new List<string> { "mktree" },
                Encoding.UTF8.GetBytes("100644 blob " + blob + "\t" + BlobPath + "\n"));
            var args = new List<string> { "commit-tree", tree, "-m", CommitMessage(ev) };
            if (head != null)
            {
                args.Add("-p");
                args.Add(head);
            }
            head = GitText(repo, args, null, CommitEnv(ev));
            existing.Add(ev.Seq);
        }
        if (head != null && head != before)
        {
            GitText(repo, new List<string>
            {
                "update-ref", "refs/heads/" + branch, head, before ?? ZeroSha,
            });
        }
        return head;
    }
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

