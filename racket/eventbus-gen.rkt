(define (emit-rust-eventbus)
  (string-append
   (rust-header)
   (format #<<TPL
//! Event bus (grpcdc.events.v1.EventBus): in-memory broker,
//! client helpers, and tag matching. Wire messages are
//! generated from proto/events.proto (the `pb` module below,
//! stamped into rust/gen); the broker policy comes from the
//! shared event-bus spec.
//!
//! Delivery is at-most-once: each subscriber has a bounded
//! queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
//! events when it falls behind; stats() reports the drops.

#[path = "../gen/events_pb.rs"]
pub mod pb;

use crate::{
    server_stream_method, unary_method, CallCtx, Channel, Message, ResponseStream, ServiceDef,
    Status,
};
use pb::{Event, PublishReply, PublishRequest, SubscribeRequest, Tag, TagValue};
use std::collections::{HashMap, HashSet, VecDeque};
use std::pin::Pin;
use std::sync::{Arc, Mutex};
use std::task::{Context, Poll, Waker};

/// Per-subscriber queue bound: a slower subscriber drops its
/// oldest queued events instead of blocking publishers.
pub const SUBSCRIBER_QUEUE_CAPACITY: usize = ~a;

macro_rules! impl_message {
    ($t:ty) => {
        impl Message for $t {
            fn encode(&self) -> Vec<u8> {
                <$t>::encode(self)
            }
            fn decode(bytes: &[u8]) -> Result<Self, Status> {
                <$t>::decode(bytes).map_err(Status::invalid_argument)
            }
        }
    };
}
impl_message!(TagValue);
impl_message!(PublishRequest);
impl_message!(PublishReply);
impl_message!(SubscribeRequest);
impl_message!(Event);

/// Build a string-valued tag.
pub fn tag_string(tag: Tag, value: &str) -> TagValue {
    TagValue { tag, string_value: value.to_string(), ..Default::default() }
}

/// Build an int64-valued tag.
pub fn tag_int(tag: Tag, value: i64) -> TagValue {
    TagValue { tag, int_value: value, ..Default::default() }
}

/// Build a float64-valued tag.
pub fn tag_double(tag: Tag, value: f64) -> TagValue {
    TagValue { tag, double_value: value, ..Default::default() }
}

/// Build a bool-valued tag.
pub fn tag_bool(tag: Tag, value: bool) -> TagValue {
    TagValue { tag, bool_value: value, ..Default::default() }
}

/// Build an enum-valued tag (any enum, carried as its number
/// so it survives peers that do not know the enum).
pub fn tag_enum(tag: Tag, value: i32) -> TagValue {
    TagValue { tag, enum_value: value, ..Default::default() }
}

fn value_key(tv: &TagValue) -> String {
    // Canonical identity of one tag value. The oneof kind is
    // part of the identity (int 5 != "5" != enum 5). Kinds
    // are told apart by value, so an all-default TagValue
    // reads as the empty string value; numbers compare
    // bit-exact, never via decimal text.
    if !tv.string_value.is_empty() {
        return format!("s:{}", tv.string_value);
    }
    if tv.int_value != 0 {
        return format!("i:{}", tv.int_value);
    }
    if tv.double_value != 0.0 {
        return format!("d:{:016x}", tv.double_value.to_bits());
    }
    if tv.bool_value {
        return "b:true".to_string();
    }
    if tv.enum_value != 0 {
        return format!("e:{}", tv.enum_value);
    }
    "s:".to_string()
}

/// Stable key for one TagValue, e.g. "1|s:orders".
pub fn tag_value_key(tv: &TagValue) -> String {
    format!("{}|{}", tv.tag.to_i32(), value_key(tv))
}

/// Containment match: the event is delivered when its tag
/// list contains every (tag, value) pair of the filter. An
/// empty filter matches everything.
pub fn tags_match(event_tags: &[TagValue], filter: &[TagValue]) -> bool {
    if filter.is_empty() {
        return true;
    }
    let have: HashSet<String> = event_tags.iter().map(tag_value_key).collect();
    filter.iter().all(|f| have.contains(&tag_value_key(f)))
}

#[cfg(not(target_arch = "wasm32"))]
fn now_unix_ms() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_millis() as i64)
        .unwrap_or(0)
}

#[cfg(target_arch = "wasm32")]
fn now_unix_ms() -> i64 {
    // No wall clock on wasm32-unknown; hosts that care stamp
    // timestamps by re-publishing through a native broker.
    0
}

struct SubscriberState {
    filter: Vec<TagValue>,
    queue: VecDeque<Event>,
    waker: Option<Waker>,
    dropped: u64,
}

struct BrokerState {
    subscribers: HashMap<u64, Arc<Mutex<SubscriberState>>>,
    next_subscriber: u64,
    seq: u64,
    published: u64,
    dropped: u64,
}

/// A point-in-time broker snapshot.
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
pub struct EventBusStats {
    pub published: u64,
    pub subscribers: u64,
    pub dropped: u64,
}

/// In-memory grpcdc.events.v1.EventBus broker. Any peer can
/// host it: hand service() to Server::serve next to your own
/// services, or call publish_event() directly in-process.
pub struct EventBusBroker {
    state: Mutex<BrokerState>,
    /// Bounds each subscriber's queue.
    pub queue_capacity: usize,
}

impl Default for EventBusBroker {
    fn default() -> Self {
        Self::new()
    }
}

impl EventBusBroker {
    pub fn new() -> Self {
        EventBusBroker {
            state: Mutex::new(BrokerState {
                subscribers: HashMap::new(),
                next_subscriber: 0,
                seq: 0,
                published: 0,
                dropped: 0,
            }),
            queue_capacity: SUBSCRIBER_QUEUE_CAPACITY,
        }
    }

    /// Accept an event: assign its sequence number and
    /// timestamp and fan it out to matching subscribers.
    /// Returns the stamped event.
    pub fn publish_event(&self, tags: Vec<TagValue>, payload: Vec<u8>, publisher_id: &str) -> Event {
        let mut state = self.state.lock().unwrap();
        state.seq += 1;
        let event = Event {
            tags,
            payload,
            seq: state.seq,
            publisher_id: publisher_id.to_string(),
            timestamp_unix_ms: now_unix_ms(),
            ..Default::default()
        };
        state.published += 1;
        let capacity = if self.queue_capacity > 0 { self.queue_capacity } else { SUBSCRIBER_QUEUE_CAPACITY };
        let subscribers: Vec<Arc<Mutex<SubscriberState>>> =
            state.subscribers.values().cloned().collect();
        let mut dropped = 0u64;
        for sub in subscribers {
            let mut sub = sub.lock().unwrap();
            if !tags_match(&event.tags, &sub.filter) {
                continue;
            }
            if sub.queue.len() >= capacity {
                sub.queue.pop_front();
                sub.dropped += 1;
                dropped += 1;
            }
            sub.queue.push_back(event.clone());
            if let Some(waker) = sub.waker.take() {
                waker.wake();
            }
        }
        state.dropped += dropped;
        event
    }

    /// Broker snapshot.
    pub fn stats(&self) -> EventBusStats {
        let state = self.state.lock().unwrap();
        EventBusStats {
            published: state.published,
            subscribers: state.subscribers.len() as u64,
            dropped: state.dropped,
        }
    }

    fn add_subscriber(
        &self,
        filter: Vec<TagValue>,
    ) -> (u64, Arc<Mutex<SubscriberState>>) {
        let mut state = self.state.lock().unwrap();
        state.next_subscriber += 1;
        let id = state.next_subscriber;
        let sub = Arc::new(Mutex::new(SubscriberState {
            filter,
            queue: VecDeque::new(),
            waker: None,
            dropped: 0,
        }));
        state.subscribers.insert(id, sub.clone());
        (id, sub)
    }

    fn remove_subscriber(&self, id: u64) {
        self.state.lock().unwrap().subscribers.remove(&id);
    }

    /// In-process subscription: events fan out to it exactly
    /// like an RPC subscriber, without a call. Useful embedded
    /// and for tests; dropping it unregisters.
    pub fn subscribe_local(self: &Arc<Self>, filter: Vec<TagValue>) -> LocalSubscription {
        let (id, sub) = self.add_subscriber(filter);
        LocalSubscription { broker: self.clone(), id, sub }
    }

    /// The EventBus service definition for Server::serve.
    pub fn service(self: &Arc<Self>) -> ServiceDef {
        let broker = self.clone();
        ServiceDef::new(
            "grpcdc.events.v1.EventBus",
            vec![
                unary_method("Publish", move |req: PublishRequest, _ctx: CallCtx| {
                    let broker = broker.clone();
                    async move {
                        let event =
                            broker.publish_event(req.tags, req.payload, &req.publisher_id);
                        Ok(PublishReply { seq: event.seq, ..Default::default() })
                    }
                }),
                server_stream_method("Subscribe", {
                    let broker = self.clone();
                    move |req: SubscribeRequest, _ctx: CallCtx| {
                        let broker = broker.clone();
                        async move {
                            let (id, sub) = broker.add_subscriber(req.filter);
                            let stream = SubscribeStream { broker, id, sub };
                            Ok(Box::pin(stream) as ResponseStream<Event>)
                        }
                    }
                }),
            ],
        )
    }
}

struct SubscribeStream {
    broker: Arc<EventBusBroker>,
    id: u64,
    sub: Arc<Mutex<SubscriberState>>,
}

impl futures_core::Stream for SubscribeStream {
    type Item = Result<Event, Status>;

    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
        let mut sub = self.sub.lock().unwrap();
        if let Some(event) = sub.queue.pop_front() {
            return Poll::Ready(Some(Ok(event)));
        }
        sub.waker = Some(cx.waker().clone());
        Poll::Pending
    }
}

impl Drop for SubscribeStream {
    fn drop(&mut self) {
        self.broker.remove_subscriber(self.id);
    }
}

/// Handle for EventBusBroker::subscribe_local: pull events
/// in-process. try_recv returns the next queued event without
/// waiting; dropped counts this subscription's drop-oldest
/// losses. Dropping the handle unregisters.
pub struct LocalSubscription {
    broker: Arc<EventBusBroker>,
    id: u64,
    sub: Arc<Mutex<SubscriberState>>,
}

impl LocalSubscription {
    /// Next queued event, or None when the queue is empty.
    pub fn try_recv(&self) -> Option<Event> {
        self.sub.lock().unwrap().queue.pop_front()
    }

    /// This subscription's drop-oldest loss count.
    pub fn dropped(&self) -> u64 {
        self.sub.lock().unwrap().dropped
    }
}

impl Drop for LocalSubscription {
    fn drop(&mut self) {
        self.broker.remove_subscriber(self.id);
    }
}

/// Client helpers over a generated channel: publish and
/// subscribe without hand-building requests.
pub struct EventBusClient {
    channel: Channel,
}

impl EventBusClient {
    pub fn new(channel: Channel) -> Self {
        EventBusClient { channel }
    }

    /// Publish; resolves to the broker-assigned sequence number.
    pub async fn publish(
        &self,
        tags: Vec<TagValue>,
        payload: Vec<u8>,
        publisher_id: &str,
    ) -> Result<u64, Status> {
        let reply: PublishReply = self
            .channel
            .unary(
                "/grpcdc.events.v1.EventBus/Publish",
                PublishRequest {
                    tags,
                    payload,
                    publisher_id: publisher_id.to_string(),
                    ..Default::default()
                },
            )
            .await?;
        Ok(reply.seq)
    }

    /// Subscribe; dropping the stream unsubscribes.
    pub async fn subscribe(&self, filter: Vec<TagValue>) -> Result<ResponseStream<Event>, Status> {
        self.channel
            .server_stream(
                "/grpcdc.events.v1.EventBus/Subscribe",
                SubscribeRequest { filter, ..Default::default() },
            )
            .await
    }
}
TPL
           queue-capacity)))

(define (emit-rust-gitlog)
  (string-append
   (rust-header)
   (format #<<TPL
//! Git log serde for the event bus: exports an event log to a
//! git branch (one commit per event) and imports it back. The
//! live broker never touches git; this is the durable serde
//! layer beside it. std::process drives the git plumbing.
//!
//! Deterministic: the same events always produce the same
//! commits, so re-exporting a log the branch already has is a
//! no-op (each event's sequence number is the dedup key). The
//! commit blob (~a) is authoritative; the message subject and
//! trailers are a human index for `git log`.

use crate::eventbus::pb::Event;
use crate::eventbus::{tag_value_key, tags_match};
use std::collections::HashSet;
use std::io::Write;
use std::path::Path;
use std::process::{Command, Stdio};

const AUTHOR_NAME: &str = "~a";
const AUTHOR_EMAIL: &str = "~a";
const BLOB_PATH: &str = "~a";
const COMMIT_SUBJECT: &str = "~a";
const TRAILER_SEQ: &str = "~a";
const TRAILER_PUBLISHER: &str = "~a";
const TRAILER_TAG: &str = "~a";
const ZERO_SHA: &str = "0000000000000000000000000000000000000000";

/// The default branch an event log exports to.
pub const EVENT_LOG_BRANCH: &str = "grpc-dc-events";

fn git(
    repo: &Path,
    args: &[&str],
    input: Option<&[u8]>,
    envs: &[(&str, String)],
) -> Result<Vec<u8>, String> {
    let mut cmd = Command::new("git");
    cmd.arg("-C").arg(repo).args(args);
    for (key, value) in envs {
        cmd.env(key, value);
    }
    if input.is_some() {
        cmd.stdin(Stdio::piped());
    }
    cmd.stdout(Stdio::piped()).stderr(Stdio::piped());
    let mut child = cmd.spawn().map_err(|e| format!("spawn git: {e}"))?;
    if let Some(bytes) = input {
        let mut stdin = child.stdin.take().ok_or("git stdin unavailable")?;
        stdin.write_all(bytes).map_err(|e| format!("write git stdin: {e}"))?;
        drop(stdin);
    }
    let out = child.wait_with_output().map_err(|e| format!("wait git: {e}"))?;
    if !out.status.success() {
        return Err(format!(
            "git {}: {}",
            args.join(" "),
            String::from_utf8_lossy(&out.stderr).trim()
        ));
    }
    Ok(out.stdout)
}

fn git_text(
    repo: &Path,
    args: &[&str],
    input: Option<&[u8]>,
    envs: &[(&str, String)],
) -> Result<String, String> {
    let out = git(repo, args, input, envs)?;
    Ok(String::from_utf8_lossy(&out).trim().to_string())
}

/// Create the log repo if needed (a plain `git init`).
pub fn init_event_log_repo(repo: &Path) -> Result<(), String> {
    if git_text(repo, &["rev-parse", "--git-dir"], None, &[]).is_ok() {
        return Ok(());
    }
    std::fs::create_dir_all(repo).map_err(|e| format!("create repo dir: {e}"))?;
    let out = Command::new("git")
        .arg("init")
        .arg("-q")
        .arg(repo)
        .output()
        .map_err(|e| format!("spawn git init: {e}"))?;
    if !out.status.success() {
        return Err(format!("git init: {}", String::from_utf8_lossy(&out.stderr).trim()));
    }
    Ok(())
}

fn branch_head(repo: &Path, branch: &str) -> Option<String> {
    git_text(repo, &["rev-parse", "--verify", &format!("refs/heads/{branch}")], None, &[]).ok()
}

/// The commit message for an event: "grpc-dc event 42" plus
/// Seq/Publisher/Tag trailers, so `git log` alone can filter
/// the log without decoding blobs.
pub fn commit_message(event: &Event) -> String {
    let mut msg = format!("{COMMIT_SUBJECT} {}\n\n{TRAILER_SEQ}: {}\n", event.seq, event.seq);
    if !event.publisher_id.is_empty() {
        msg.push_str(&format!("{TRAILER_PUBLISHER}: {}\n", event.publisher_id));
    }
    for tv in &event.tags {
        msg.push_str(&format!("{TRAILER_TAG}: {}\n", tag_value_key(tv)));
    }
    msg
}

fn commit_env(event: &Event) -> Vec<(&'static str, String)> {
    let seconds = (event.timestamp_unix_ms / 1000).max(0);
    let date = format!("{seconds} +0000");
    vec![
        ("GIT_AUTHOR_NAME", AUTHOR_NAME.to_string()),
        ("GIT_AUTHOR_EMAIL", AUTHOR_EMAIL.to_string()),
        ("GIT_COMMITTER_NAME", AUTHOR_NAME.to_string()),
        ("GIT_COMMITTER_EMAIL", AUTHOR_EMAIL.to_string()),
        ("GIT_AUTHOR_DATE", date.clone()),
        ("GIT_COMMITTER_DATE", date),
    ]
}

/// Import a branch: events in chain order (oldest first),
/// optionally windowed by sequence number (from_seq
/// exclusive, to_seq inclusive; 0 = unbounded) and narrowed
/// by a tag filter (same containment semantics as Subscribe).
/// A missing branch imports as an empty log.
pub fn import_events(
    repo: &Path,
    branch: &str,
    filter: &[crate::eventbus::pb::TagValue],
    from_seq: u64,
    to_seq: u64,
) -> Result<Vec<Event>, String> {
    if branch_head(repo, branch).is_none() {
        return Ok(Vec::new());
    }
    let listing = git_text(repo, &["rev-list", "--reverse", branch], None, &[])?;
    let mut events = Vec::new();
    for sha in listing.split_whitespace() {
        let data = git(repo, &["cat-file", "-p", &format!("{sha}:{BLOB_PATH}")], None, &[])?;
        let event = Event::decode(&data)?;
        if event.seq <= from_seq {
            continue;
        }
        if to_seq != 0 && event.seq > to_seq {
            continue;
        }
        if !filter.is_empty() && !tags_match(&event.tags, filter) {
            continue;
        }
        events.push(event);
    }
    Ok(events)
}

/// Export events onto the branch: one commit per event, in
/// sequence order, skipping sequence numbers the branch
/// already has. Returns the new head sha (or the existing one
/// when nothing was appended). The ref update is a
/// compare-and-swap: a concurrent exporter fails loudly
/// instead of forking the log; retrying is safe.
pub fn export_events(repo: &Path, events: &[Event], branch: &str) -> Result<String, String> {
    init_event_log_repo(repo)?;
    let mut existing: HashSet<u64> =
        import_events(repo, branch, &[], 0, 0)?.iter().map(|e| e.seq).collect();
    let mut ordered: Vec<&Event> = events.iter().collect();
    ordered.sort_by_key(|e| e.seq);
    let mut head = branch_head(repo, branch);
    let before = head.clone();
    for event in ordered {
        if existing.contains(&event.seq) {
            continue;
        }
        let blob = git_text(repo, &["hash-object", "-w", "--stdin"], Some(&event.encode()), &[])?;
        let tree = git_text(
            repo,
            &["mktree"],
            Some(format!("100644 blob {blob}\t{BLOB_PATH}\n").as_bytes()),
            &[],
        )?;
        let message = commit_message(event);
        let mut args = vec!["commit-tree", tree.as_str(), "-m", message.as_str()];
        if let Some(parent) = &head {
            args.push("-p");
            args.push(parent.as_str());
        }
        head = Some(git_text(repo, &args, None, &commit_env(event))?);
        existing.insert(event.seq);
    }
    if let Some(head) = &head {
        if before.as_deref() != Some(head.as_str()) {
            git_text(
                repo,
                &[
                    "update-ref",
                    &format!("refs/heads/{branch}"),
                    head,
                    before.as_deref().unwrap_or(ZERO_SHA),
                ],
                None,
                &[],
            )?;
        }
    }
    Ok(head.unwrap_or_default())
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

;; ---------------------------------------------------------------------------
;; Generated tests + demos. The scenarios are the shared
;; event-bus semantics, stamped per language: fan-out with tag
;; filters, value-kind separation, user-tag (1000+) passthrough,
;; drop-oldest overflow, cancel-unsubscribes, and the git log
;; round-trip (native only).
;; ---------------------------------------------------------------------------

(define (emit-js-test)
  (string-append
   (js-header)
   #<<TPL
// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import test from "node:test";

import { Channel, Server, memoryDataChannelPair } from "../index.js";
import {
  EventBusBroker,
  EventBusClient,
  publishEvent,
  subscribeEvents,
  tagEnum,
  tagInt,
  tagString,
  tagsMatch,
} from "../src/eventbus.js";
import { exportEvents, importEvents } from "../src/eventbus_gitlog.js";
import { Tag, TagValue } from "../src/events_pb.js";

const enc = (s) => new TextEncoder().encode(s);
const dec = (b) => new TextDecoder().decode(b);
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function waitFor(fn, timeoutMs = 5000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    if (fn()) return;
    await sleep(10);
  }
  throw new Error("waitFor timed out");
}

function setup({ queueCapacity } = {}) {
  const broker = new EventBusBroker(queueCapacity ? { queueCapacity } : {});
  const [a, b] = memoryDataChannelPair();
  const server = new Server();
  broker.register(server);
  server.serve(b);
  return { broker, client: new EventBusClient(new Channel(a)) };
}

// Collect a subscription into `out`; tracked in `bag` so the
// test can cancel every collector (cancelling is what returns
// the client iterators and, after one more publish, reaps the
// broker-side subscriptions so the process can exit).
function collect(streamPromise, out, bag) {
  const done = (async () => {
    const stream = await streamPromise;
    const it = stream[Symbol.asyncIterator]();
    bag.push(it);
    for (;;) {
      const step = await it.next();
      if (step.done) return;
      out.push(step.value);
    }
  })();
  done.catch(() => {});
  return done;
}

// Cancel every collector, then publish one flush event per
// filter: a cancelled subscription is reaped when the broker
// next tries to deliver to it (the runtime surfaces
// cancellation at send time), so each filter needs a matching
// flush. Waits until the broker has no subscribers left,
// which also lets this process exit.
async function stopCollecting(broker, client, bag, flushFilters) {
  await Promise.all(bag.map((it) => it.return().catch(() => {})));
  for (const filter of flushFilters) {
    await publishEvent(client, filter, enc("close")).catch(() => {});
  }
  await waitFor(() => broker.stats().subscribers === 0);
}

test("tagsMatch: containment, kinds, empty filter", () => {
  const tags = [tagString(Tag.TOPIC, "orders"), tagInt(Tag.KIND, 5)];
  assert.equal(tagsMatch(tags, []), true);
  assert.equal(tagsMatch(tags, [tagString(Tag.TOPIC, "orders")]), true);
  assert.equal(tagsMatch(tags, [tagString(Tag.TOPIC, "orders"), tagInt(Tag.KIND, 5)]), true);
  assert.equal(tagsMatch(tags, [tagEnum(Tag.KIND, 5)]), false);
  assert.equal(tagsMatch(tags, [tagString(Tag.KIND, "5")]), false);
  assert.equal(tagsMatch(tags, [tagString(Tag.TOPIC, "other")]), false);
});

test("fan-out honors tag filters", async () => {
  const { broker, client } = setup();
  const orders = [];
  const all = [];
  const bag = [];
  collect(subscribeEvents(client, [tagString(Tag.TOPIC, "orders")]), orders, bag);
  collect(subscribeEvents(client, []), all, bag);
  await waitFor(() => broker.stats().subscribers === 2);
  assert.equal(await publishEvent(client, [tagString(Tag.TOPIC, "orders")], enc("o1"), "test"), 1n);
  assert.equal(await publishEvent(client, [tagString(Tag.TOPIC, "other")], enc("x1"), "test"), 2n);
  await waitFor(() => orders.length === 1 && all.length === 2);
  assert.equal(dec(orders[0].payload), "o1");
  assert.equal(orders[0].publisherId, "test");
  assert.deepEqual(all.map((e) => e.seq), [1n, 2n]);
  await stopCollecting(broker, client, bag, [[tagString(Tag.TOPIC, "orders")], []]);
});

test("tag value kinds never cross-match", async () => {
  const { broker, client } = setup();
  const got = [];
  const bag = [];
  collect(subscribeEvents(client, [tagInt(Tag.KIND, 5)]), got, bag);
  await waitFor(() => broker.stats().subscribers === 1);
  await publishEvent(client, [tagString(Tag.KIND, "5")], enc("s"));
  await publishEvent(client, [tagEnum(Tag.KIND, 5)], enc("e"));
  assert.equal(await publishEvent(client, [tagInt(Tag.KIND, 5)], enc("i")), 3n);
  await waitFor(() => got.length === 1);
  assert.equal(dec(got[0].payload), "i");
  await stopCollecting(broker, client, bag, [[tagInt(Tag.KIND, 5)]]);
});

test("user tags (1000+) pass through the stock broker", async () => {
  const { broker, client } = setup();
  const mine = () => new TagValue({ tag: 1004, stringValue: "x" });
  const got = [];
  const bag = [];
  collect(subscribeEvents(client, [mine()]), got, bag);
  await waitFor(() => broker.stats().subscribers === 1);
  await publishEvent(client, [mine()], enc("u"));
  await waitFor(() => got.length === 1);
  assert.equal(got[0].tags[0].tag, 1004);
  assert.equal(got[0].tags[0].stringValue, "x");
  await stopCollecting(broker, client, bag, [[mine()]]);
});

test("slow subscriber drops oldest, counted", async () => {
  const broker = new EventBusBroker({ queueCapacity: 4 });
  const sub = broker.subscribeLocal([]);
  for (let i = 1; i <= 6; i++) {
    broker.publishEvent([], enc(`m${i}`));
  }
  assert.equal(broker.stats().dropped, 2);
  assert.equal(sub.dropped, 2);
  const seqs = [];
  for (let i = 0; i < 4; i++) seqs.push(Number((await sub.take()).seq));
  assert.deepEqual(seqs, [3, 4, 5, 6]);
  sub.close();
  assert.equal(broker.stats().subscribers, 0);
});

test("breaking the iteration unsubscribes", async () => {
  const { broker, client } = setup();
  const stream = await subscribeEvents(client, []);
  await waitFor(() => broker.stats().subscribers === 1);
  const it = stream[Symbol.asyncIterator]();
  await publishEvent(client, [], enc("a"));
  assert.equal(dec((await it.next()).value.payload), "a");
  await it.return();
  await publishEvent(client, [], enc("b"));
  await waitFor(() => broker.stats().subscribers === 0);
});

test("git log serde round-trips and is idempotent", () => {
  const repo = mkdtempSync(join(tmpdir(), "grpc-dc-eventbus-"));
  try {
    const broker = new EventBusBroker();
    const events = [
      broker.publishEvent([tagString(Tag.TOPIC, "orders")], enc("o1"), "test"),
      broker.publishEvent([tagString(Tag.TOPIC, "other")], enc("x1"), "test"),
      broker.publishEvent([tagString(Tag.TOPIC, "orders")], enc("o2"), "test"),
    ];
    const head1 = exportEvents(repo, events);
    const count = execFileSync("git", ["-C", repo, "rev-list", "--count", "grpc-dc-events"], {
      encoding: "utf8",
    }).trim();
    assert.equal(count, "3");
    assert.equal(exportEvents(repo, events), head1);
    const all = importEvents(repo);
    assert.deepEqual(all.map((e) => e.seq), [1n, 2n, 3n]);
    assert.deepEqual(all.map((e) => dec(e.payload)), ["o1", "x1", "o2"]);
    assert.ok(all.every((e) => e.publisherId === "test"));
    const ordersOnly = importEvents(repo, "grpc-dc-events", {
      filter: [tagString(Tag.TOPIC, "orders")],
    });
    assert.deepEqual(ordersOnly.map((e) => e.seq), [1n, 3n]);
    const window = importEvents(repo, "grpc-dc-events", { fromSeq: 1n, toSeq: 2n });
    assert.deepEqual(window.map((e) => e.seq), [2n]);
  } finally {
    rmSync(repo, { recursive: true, force: true });
  }
});
TPL
   ))

(define (emit-js-demo)
  (string-append
   (js-header)
   #<<TPL
// Event bus demo: a broker, one filtered subscriber, and
// three publishes over one in-memory data channel.
// `node js/examples/eventbus_demo.js`

import { Channel, Server, memoryDataChannelPair } from "../index.js";
import {
  EventBusBroker,
  EventBusClient,
  publishEvent,
  subscribeEvents,
  tagString,
} from "../src/eventbus.js";
import { Tag } from "../src/events_pb.js";

const broker = new EventBusBroker();
const [a, b] = memoryDataChannelPair();
const server = new Server();
broker.register(server);
server.serve(b);
const client = new EventBusClient(new Channel(a));

const text = (bytes) => new TextDecoder().decode(bytes);
const received = [];
const done = (async () => {
  for await (const event of await subscribeEvents(client, [tagString(Tag.TOPIC, "orders")])) {
    received.push(`#${event.seq} ${text(event.payload)}`);
    if (received.length === 2) break;
  }
})();

await publishEvent(client, [tagString(Tag.TOPIC, "orders")], new TextEncoder().encode("order-1"), "demo");
await publishEvent(client, [tagString(Tag.TOPIC, "other")], new TextEncoder().encode("noise"), "demo");
await publishEvent(client, [tagString(Tag.TOPIC, "orders")], new TextEncoder().encode("order-2"), "demo");
await done;
console.log(`subscriber got: ${received.join(", ")}`);
console.log(`broker stats: ${JSON.stringify(broker.stats())}`);
process.exit(0);
