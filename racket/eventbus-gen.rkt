package grpcdc.events.v1

// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (EventsMessages,
// EventsGrpcDc); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
// events when it falls behind; stats reports the drops.
// Tag itself is a plain Int on the wire model, so unknown
// (user-defined) tag numbers pass through unchanged.

import java.nio.ByteBuffer
import java.nio.ByteOrder
import scala.collection.mutable

object Eventbus {
  final val SUBSCRIBER_QUEUE_CAPACITY = ~a

  // Canonical identity of one tag value. The oneof kind is
  // part of the identity (int 5 != "5" != enum 5). Kinds are
  // told apart by value, so an all-default TagValue reads as
  // the empty string value; numbers compare bit-exact, never
  // via decimal text.
  private def valueKey(tv: TagValue): String = {
    if (tv.stringValue != "") return "s:" + tv.stringValue
    if (tv.intValue != 0L) return "i:" + tv.intValue
    if (tv.doubleValue != 0.0) {
      val bits = ByteBuffer.allocate(8).order(ByteOrder.BIG_ENDIAN)
        .putDouble(tv.doubleValue).getLong(0)
      return "d:" + java.lang.String.format("%016x", java.lang.Long.valueOf(bits))
    }
    if (tv.boolValue) return "b:true"
    if (tv.enumValue != 0) return "e:" + tv.enumValue
    "s:"
  }

  /** Stable key for one TagValue, e.g. "1|s:orders". */
  def tagValueKey(tv: TagValue): String = tv.tag.toString + "|" + valueKey(tv)

  // Containment match: the event is delivered when its tag
  // list contains every (tag, value) pair of the filter. An
  // empty filter matches everything.
  def tagsMatch(eventTags: List[TagValue], filterTags: List[TagValue]): Boolean = {
    if (filterTags == null || filterTags.isEmpty) return true
    val have = mutable.HashSet[String]()
    if (eventTags != null) {
      for (tv <- eventTags) have.add(tagValueKey(tv))
    }
    for (f <- filterTags) {
      if (!have.contains(tagValueKey(f))) return false
    }
    true
  }

  def tagString(tag: Int, value: Any): TagValue =
    new TagValue(tag, String.valueOf(value), 0, 0.0, false, 0)

  def tagInt(tag: Int, value: Any): TagValue =
    new TagValue(tag, "", value.asInstanceOf[Number].longValue(), 0.0, false, 0)

  def tagDouble(tag: Int, value: Any): TagValue =
    new TagValue(tag, "", 0, value.asInstanceOf[Number].doubleValue(), false, 0)

  def tagBool(tag: Int, value: Any): TagValue =
    new TagValue(tag, "", 0, 0.0, value == true, 0)

  def tagEnum(tag: Int, value: Any): TagValue =
    new TagValue(tag, "", 0, 0.0, false, value.asInstanceOf[Number].intValue())

  // Publish through a generated EventBusClient; returns the
  // broker-assigned sequence number.
  def publishEvent(client: EventsGrpcDc.EventBusClient,
                   tags: List[TagValue], payload: Array[Byte],
                   publisherId: String = ""): Long = {
    val reply = client.Publish(new PublishRequest(
      if (tags == null) List.empty else tags,
      if (payload == null) Array.empty[Byte] else payload,
      if (publisherId == null) "" else publisherId))
    reply.seq
  }

  // Subscribe through a generated EventBusClient; returns
  // the receiving stream (recv from it, or close it to
  // unsubscribe).
  def subscribeEvents(client: EventsGrpcDc.EventBusClient,
                      filterTags: List[TagValue]):
      EventsGrpcDc.EventBusClient#EventBusServerStreamStream = {
    client.Subscribe(new SubscribeRequest(
      if (filterTags == null) List.empty else filterTags))
  }
}
