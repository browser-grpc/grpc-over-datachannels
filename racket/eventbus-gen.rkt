        $userStream = EB::subscribeEvents($client3, [new \EventsPb\TagValue(1004, "x")]);
        EB::publishEvent($client3, [new \EventsPb\TagValue(1004, "x")], "u");
        $user = $userStream->recv();
        T::assertEq($user->tags[0]->tag, 1004, "user tag number");
        T::assertEq($user->tags[0]->stringValue, "x", "user tag value");
        $userStream->close();

        // -- slow subscriber drops oldest --
        $broker4 = new \Grpcdc\EventBusBroker(4);
        $sub = $broker4->subscribeLocal([]);
        for ($i = 1; $i <= 6; $i++) {
