package grpcdc.events.v1

// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
// client helpers, and tag matching. Wire messages and stubs
// are generated from proto/events.proto (EventsMessages,
// EventsGrpcDc); the broker policy comes from the shared
// event-bus spec.
//
// Delivery is at-most-once: each subscriber has a bounded
// queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
// events when it falls behind; stats reports the drops.
//
// Note: the generated Tag is a closed Kotlin enum, so a
// Kotlin peer can only carry tag values present in its
// generated copy of events.proto. To use your own tags, copy
// events.proto, add values (1000+), and regenerate -- the
// standard extension flow. Brokers in open-enum languages
// pass unknown tag numbers through unchanged.

import java.nio.ByteBuffer
import java.nio.ByteOrder

object Eventbus {
    const val SUBSCRIBER_QUEUE_CAPACITY = ~a

    // Canonical identity of one tag value. The oneof kind is
    // part of the identity (int 5 != "5" != enum 5). Kinds are
    // told apart by value, so an all-default TagValue reads as
    // the empty string value; numbers compare bit-exact, never
    // via decimal text.
    private fun valueKey(tv: TagValue): String {
        if (tv.stringValue != "") return "s:" + tv.stringValue
        if (tv.intValue != 0L) return "i:" + tv.intValue
        if (tv.doubleValue != 0.0) {
            val bits = ByteBuffer.allocate(8).order(ByteOrder.BIG_ENDIAN)
                .putDouble(tv.doubleValue).getLong(0)
            return "d:" + java.lang.String.format("%016x", bits)
        }
        if (tv.boolValue) return "b:true"
        if (tv.enumValue != 0) return "e:" + tv.enumValue
        return "s:"
    }

    /** Stable key for one TagValue, e.g. "1|s:orders". */
    fun tagValueKey(tv: TagValue): String = tv.tag.number.toString() + "|" + valueKey(tv)

    // Containment match: the event is delivered when its tag
    // list contains every (tag, value) pair of the filter. An
    // empty filter matches everything.
    fun tagsMatch(eventTags: List<TagValue>?, filterTags: List<TagValue>?): Boolean {
        if (filterTags.isNullOrEmpty()) return true
        val have = HashSet<String>()
        if (eventTags != null) {
            for (tv in eventTags) have.add(tagValueKey(tv))
        }
        for (f in filterTags) {
            if (!have.contains(tagValueKey(f))) return false
        }
        return true
    }

    fun tagString(tag: Tag, value: Any?): TagValue =
        TagValue(tag, value.toString(), 0, 0.0, false, 0)

    fun tagInt(tag: Tag, value: Any?): TagValue =
        TagValue(tag, "", (value as Number).toLong(), 0.0, false, 0)

    fun tagDouble(tag: Tag, value: Any?): TagValue =
        TagValue(tag, "", 0, (value as Number).toDouble(), false, 0)

    fun tagBool(tag: Tag, value: Any?): TagValue =
        TagValue(tag, "", 0, 0.0, value == true, 0)

    fun tagEnum(tag: Tag, value: Any?): TagValue =
        TagValue(tag, "", 0, 0.0, false, (value as Number).toInt())

    // Publish through a generated EventBusClient; returns the
    // broker-assigned sequence number.
    fun publishEvent(client: EventsGrpcDc.EventBusClient,
                     tags: List<TagValue>?, payload: ByteArray?,
                     publisherId: String = ""): Long {
        val reply = client.Publish(PublishRequest(
            (tags ?: emptyList()).toMutableList(),
            payload ?: ByteArray(0),
            publisherId))
        return reply.seq.toLong()
    }

    // Subscribe through a generated EventBusClient; returns
    // the receiving stream (recv from it, or close it to
    // unsubscribe).
    fun subscribeEvents(client: EventsGrpcDc.EventBusClient,
                        filterTags: List<TagValue>?):
            EventsGrpcDc.EventBusClient.EventBusSubscribeStream {
        return client.Subscribe(SubscribeRequest(
            (filterTags ?: emptyList()).toMutableList()))
    }
}
