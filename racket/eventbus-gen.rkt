(define (emit-kotlin-gitlog)
  (string-append
   (kotlin-header)
   (format #<<TPL
package grpcdc.events.v1

// Git log serde for the event bus: exports an event log to
// a git branch (one commit per event) and imports it back.
// The live broker never touches git; this is the durable
// serde layer beside it. ProcessBuilder drives the git
// plumbing.
//
// Deterministic: the same events always produce the same
// commits, so re-exporting a log the branch already has is
// a no-op (each event's sequence number is the dedup key).
// The commit blob (~a) is authoritative; the message
// subject and trailers are a human index for `git log`.

import java.io.File
import java.nio.charset.StandardCharsets

object EventbusGit {
    const val AUTHOR_NAME = "~a"
    const val AUTHOR_EMAIL = "~a"
    const val BLOB_PATH = "~a"
    const val COMMIT_SUBJECT = "~a"
    const val TRAILER_SEQ = "~a"
    const val TRAILER_PUBLISHER = "~a"
    const val TRAILER_TAG = "~a"
    const val ZERO_SHA = "0000000000000000000000000000000000000000"

    const val EVENT_LOG_BRANCH = "grpc-dc-events"

    fun git(repo: String, args: List<String>, inputBytes: ByteArray? = null,
            envExtra: Map<String, String>? = null): ByteArray {
        val cmd = ArrayList<String>()
        cmd.add("git")
        cmd.add("-C")
        cmd.add(repo)
        cmd.addAll(args)
        val pb = ProcessBuilder(cmd)
        if (envExtra != null) pb.environment().putAll(envExtra)
        val proc = pb.start()
        if (inputBytes != null) {
            proc.outputStream.use { it.write(inputBytes) }
        } else {
            proc.outputStream.close()
        }
        val out = proc.inputStream.readBytes()
        proc.errorStream.readBytes()
        if (proc.waitFor() != 0) {
            throw IllegalStateException("git " + args[0] + " failed in " + repo)
        }
        return out
    }

    fun gitText(repo: String, args: List<String>, inputBytes: ByteArray? = null,
                envExtra: Map<String, String>? = null): String =
        String(git(repo, args, inputBytes, envExtra), StandardCharsets.UTF_8).trim()

    /** Create the log repo if needed (a plain `git init`). */
    fun initEventLogRepo(repo: String) {
        try {
            gitText(repo, listOf("rev-parse", "--git-dir"))
        } catch (e: Exception) {
            val proc = ProcessBuilder("git", "init", "-q", repo).start()
            proc.inputStream.readBytes()
            proc.errorStream.readBytes()
            if (proc.waitFor() != 0) {
                throw IllegalStateException("git init failed for " + repo)
            }
        }
    }

    fun branchHead(repo: String, branch: String): String? {
        return try {
            gitText(repo, listOf("rev-parse", "--verify", "refs/heads/" + branch))
        } catch (e: Exception) {
            null
        }
    }

    // "grpc-dc event 42" plus Seq/Publisher/Tag trailers, so
    // `git log` alone can filter the log without decoding blobs.
    fun commitMessage(event: Event): String {
        val sb = StringBuilder()
        sb.append(COMMIT_SUBJECT).append(' ').append(event.seq).append("\n\n")
        sb.append(TRAILER_SEQ).append(": ").append(event.seq)
        if (event.publisherId != "") {
            sb.append('\n').append(TRAILER_PUBLISHER).append(": ")
                .append(event.publisherId)
        }
        for (tv in event.tags) {
            sb.append('\n').append(TRAILER_TAG).append(": ")
                .append(Eventbus.tagValueKey(tv))
        }
        return sb.append('\n').toString()
    }

    fun commitEnv(event: Event): Map<String, String> {
        val seconds = Math.max(0, event.timestampUnixMs / 1000)
        val date = seconds.toString() + " +0000"
        return mapOf(
            "GIT_AUTHOR_NAME" to AUTHOR_NAME,
            "GIT_AUTHOR_EMAIL" to AUTHOR_EMAIL,
            "GIT_COMMITTER_NAME" to AUTHOR_NAME,
            "GIT_COMMITTER_EMAIL" to AUTHOR_EMAIL,
            "GIT_AUTHOR_DATE" to date,
            "GIT_COMMITTER_DATE" to date)
    }

    // Import a branch: events in chain order (oldest first),
    // optionally windowed by sequence number and narrowed by
    // a tag filter (same containment semantics as
    // Subscribe). A missing branch imports as an empty log.
    fun importEvents(repo: String, branch: String = EVENT_LOG_BRANCH,
                     fromSeq: Long = 0, toSeq: Long? = null,
                     filterTags: List<TagValue>? = null): List<Event> {
        val events = ArrayList<Event>()
        if (branchHead(repo, branch) == null) return events
        val list = gitText(repo, listOf("rev-list", "--reverse", branch))
        for (sha in list.split("\n")) {
            if (sha == "") continue
            val data = git(repo, listOf("cat-file", "-p", sha + ":" + BLOB_PATH))
            val event = Event()
            event.unmarshalDc(data)
            if (event.seq.toLong() <= fromSeq) continue
            if (toSeq != null && event.seq.toLong() > toSeq) continue
            if (filterTags != null && !Eventbus.tagsMatch(event.tags, filterTags)) {
                continue
            }
            events.add(event)
        }
        return events
    }

    // Export events onto the branch: one commit per event, in
    // sequence order, skipping sequence numbers the branch
    // already has. Returns the new head sha (or the existing
    // one when nothing was appended). The ref update is a
    // compare-and-swap: a concurrent exporter fails loudly
    // instead of forking the log; retrying is safe.
    fun exportEvents(repo: String, events: List<Event>,
                     branch: String = EVENT_LOG_BRANCH): String? {
        initEventLogRepo(repo)
        val existing = HashSet<ULong>()
        for (e in importEvents(repo, branch)) existing.add(e.seq)
        val ordered = events.sortedBy { it.seq }
        var head = branchHead(repo, branch)
        val before = head
        for (event in ordered) {
            if (existing.contains(event.seq)) continue
            val blob = gitText(repo, listOf("hash-object", "-w", "--stdin"),
                event.marshalDc())
            val tree = gitText(repo, listOf("mktree"),
                ("100644 blob " + blob + "\t" + BLOB_PATH + "\n")
                    .toByteArray(StandardCharsets.UTF_8))
            val args = ArrayList(listOf("commit-tree", tree, "-m", commitMessage(event)))
            if (head != null) {
                args.add("-p")
                args.add(head)
            }
            head = gitText(repo, args, null, commitEnv(event))
            existing.add(event.seq)
        }
        if (head != null && head != before) {
            gitText(repo, listOf("update-ref", "refs/heads/" + branch, head,
                before ?: ZERO_SHA))
        }
        return head
    }
}
TPL
           git-blob-path git-author-name git-author-email git-blob-path
           git-commit-subject git-trailer-seq git-trailer-publisher git-trailer-tag)))

(define (emit-kotlin-test)
  (string-append
   (kotlin-header)
   #<<TPL
package tests

// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.

import grpcdc.Channel
import grpcdc.MemoryTransport
import grpcdc.Server
import grpcdc.events.v1.Event
import grpcdc.events.v1.EventBusBroker
import grpcdc.events.v1.Eventbus
import grpcdc.events.v1.EventbusGit
import grpcdc.events.v1.EventsGrpcDc
import grpcdc.events.v1.Tag
import grpcdc.events.v1.TagValue
import java.nio.charset.StandardCharsets
import java.nio.file.Files

private fun checkEb(condition: Boolean, what: String) {
    if (!condition) throw AssertionError(what)
}

private fun waitForEb(fn: () -> Boolean, what: String) {
    val deadline = System.currentTimeMillis() + 5000
    while (!fn()) {
        if (System.currentTimeMillis() > deadline) {
            throw AssertionError("waitFor timed out: " + what)
        }
        Thread.sleep(5)
    }
}

private fun setupBus(): Pair<EventBusBroker, EventsGrpcDc.EventBusClient> {
    val broker = EventBusBroker()
    val (a, b) = MemoryTransport.pair()
    val server = Server()
    broker.register(server)
    server.serveTransport(b)
    return Pair(broker, EventsGrpcDc.EventBusClient(Channel(a)))
}

private fun collect(stream: EventsGrpcDc.EventBusClient.EventBusSubscribeStream,
                    out: MutableList<Event>): Thread {
    val thread = Thread {
        try {
            while (true) out.add(stream.recv())
        } catch (e: Exception) {
            // stream closed
        }
    }
    thread.isDaemon = true
    thread.start()
    return thread
}

private fun bytes(s: String): ByteArray = s.toByteArray(StandardCharsets.UTF_8)
private fun text(b: ByteArray): String = String(b, StandardCharsets.UTF_8)

fun testEventBus() {
    // -- tagsMatch: containment, kinds, empty --
    val tags = listOf(
        Eventbus.tagString(Tag.TOPIC, "orders"),
        Eventbus.tagInt(Tag.KIND, 5))
    checkEb(Eventbus.tagsMatch(tags, listOf()), "empty filter matches")
    checkEb(Eventbus.tagsMatch(tags,
        listOf(Eventbus.tagString(Tag.TOPIC, "orders"))), "containment")
    checkEb(Eventbus.tagsMatch(tags, tags), "self match")
    checkEb(!Eventbus.tagsMatch(tags,
        listOf(Eventbus.tagEnum(Tag.KIND, 5))), "int != enum")
    checkEb(!Eventbus.tagsMatch(tags,
        listOf(Eventbus.tagString(Tag.KIND, "5"))), "int != string")
    checkEb(!Eventbus.tagsMatch(tags,
        listOf(Eventbus.tagString(Tag.TOPIC, "other"))), "value mismatch")

    // -- fan-out honors filters --
    val (broker, client) = setupBus()
    val orders = ArrayList<Event>()
    val all = ArrayList<Event>()
    collect(Eventbus.subscribeEvents(client,
        listOf(Eventbus.tagString(Tag.TOPIC, "orders"))), orders)
    collect(Eventbus.subscribeEvents(client, listOf()), all)
    waitForEb({ broker.stats()["subscribers"] == 2L }, "2 subscribers")
    checkEb(Eventbus.publishEvent(client,
        listOf(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o1"), "test") == 1L,
        "seq 1")
    checkEb(Eventbus.publishEvent(client,
        listOf(Eventbus.tagString(Tag.TOPIC, "other")), bytes("x1"), "test") == 2L,
        "seq 2")
    waitForEb({ orders.size == 1 && all.size == 2 }, "fanout")
    checkEb(text(orders[0].payload) == "o1", "filtered payload")
    checkEb(orders[0].publisherId == "test", "publisher")
    checkEb(all[0].seq == 1uL && all[1].seq == 2uL, "all seqs")

    // -- kinds never cross-match --
    val (_, client2) = setupBus()
    val got = ArrayList<Event>()
    collect(Eventbus.subscribeEvents(client2,
        listOf(Eventbus.tagInt(Tag.KIND, 5))), got)
    Eventbus.publishEvent(client2,
        listOf(Eventbus.tagString(Tag.KIND, "5")), bytes("s"), "")
    Eventbus.publishEvent(client2,
        listOf(Eventbus.tagEnum(Tag.KIND, 5)), bytes("e"), "")
    checkEb(Eventbus.publishEvent(client2,
        listOf(Eventbus.tagInt(Tag.KIND, 5)), bytes("i"), "") == 3L, "seq 3")
    waitForEb({ got.size == 1 }, "kind match")
    checkEb(text(got[0].payload) == "i", "int kind only")

    // (No user-tag pass-through leg: the generated Tag is a
    // closed Kotlin enum; see Eventbus.kt. Own tags arrive by
    // regenerating from an extended events.proto copy.)

    // -- slow subscriber drops oldest --
    val broker4 = EventBusBroker(4)
    val sub = broker4.subscribeLocal(listOf())
    for (i in 1..6) broker4.publishEvent(listOf(), bytes("m" + i), "")
    checkEb(broker4.stats()["dropped"] == 2L, "dropped count")
    checkEb(sub.dropped == 2, "sub dropped")
    val seqs = ArrayList<ULong>()
    for (i in 0 until 4) seqs.add(sub.take()!!.seq)
    checkEb(seqs == listOf(3uL, 4uL, 5uL, 6uL), "kept newest: " + seqs)
    sub.close()
    checkEb(broker4.stats()["subscribers"] == 0L, "close unregisters")

    // -- close unsubscribes (RPC) --
    val (broker5, client5) = setupBus()
    val stream = Eventbus.subscribeEvents(client5, listOf())
    waitForEb({ broker5.stats()["subscribers"] == 1L }, "1 subscriber")
    Eventbus.publishEvent(client5, listOf(), bytes("a"), "")
    checkEb(text(stream.recv().payload) == "a", "recv before close")
    stream.close()
    Eventbus.publishEvent(client5, listOf(), bytes("b"), "")
    waitForEb({ broker5.stats()["subscribers"] == 0L }, "reaped")

    // -- git log round-trip + idempotent --
    val repo = Files.createTempDirectory("grpc-dc-eventbus-").toFile()
    val broker6 = EventBusBroker()
    val events = listOf(
        broker6.publishEvent(
            listOf(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o1"), "test"),
        broker6.publishEvent(
            listOf(Eventbus.tagString(Tag.TOPIC, "other")), bytes("x1"), "test"),
        broker6.publishEvent(
            listOf(Eventbus.tagString(Tag.TOPIC, "orders")), bytes("o2"), "test"))
    val head1 = EventbusGit.exportEvents(repo.path, events)
    checkEb(EventbusGit.gitText(repo.path,
        listOf("rev-list", "--count", "grpc-dc-events")) == "3", "commit count")
    checkEb(EventbusGit.exportEvents(repo.path, events) == head1, "idempotent re-export")
    val imported = EventbusGit.importEvents(repo.path)
    checkEb(imported.size == 3 && imported[0].seq == 1uL && imported[2].seq == 3uL,
        "import seqs")
    checkEb(text(imported[0].payload) == "o1" && text(imported[2].payload) == "o2",
        "import payloads")
    val filtered = EventbusGit.importEvents(repo.path, EventbusGit.EVENT_LOG_BRANCH,
        0, null, listOf(Eventbus.tagString(Tag.TOPIC, "orders")))
    checkEb(filtered.size == 2 && filtered[1].seq == 3uL, "import filter")
    val window = EventbusGit.importEvents(repo.path, EventbusGit.EVENT_LOG_BRANCH,
        1, 2, null)
    checkEb(window.size == 1 && window[0].seq == 2uL, "import window")

    println("TestEventBus OK")
}
TPL
   ))

