package grpcdc.events.v1

// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: register() it on a grpcdc.Server next to your own
// services, or call publishEvent() directly in-process.

import java.util.ArrayDeque
import java.util.concurrent.TimeUnit
import java.util.concurrent.locks.ReentrantLock
import scala.collection.mutable

class EventbusSubscriber(val filter: List[TagValue], val capacity: Int) {
  private val lock = new ReentrantLock()
  private val notEmpty = lock.newCondition()
  private val queue = new ArrayDeque[Event]()

  @volatile var dropped: Int = 0

  def push(event: Event): Boolean = {
    lock.lock()
    try {
      var wasDropped = false
      if (queue.size() >= capacity) {
        queue.pollFirst()
        dropped += 1
        wasDropped = true
      }
      queue.addLast(event)
      notEmpty.signalAll()
      wasDropped
    } finally {
      lock.unlock()
    }
  }

  // Next queued event, or null when the wait times out.
  // The broker re-checks every tick; a cancelled call is
  // reaped when its next matching send fails (the runtime
  // surfaces cancellation only at send time).
  def take(timeoutMs: Long): Event = {
    lock.lock()
    try {
      var remainingNs = TimeUnit.MILLISECONDS.toNanos(timeoutMs)
      while (queue.isEmpty()) {
        if (remainingNs <= 0) return null
        remainingNs = notEmpty.awaitNanos(remainingNs)
      }
      queue.pollFirst()
    } finally {
      lock.unlock()
    }
  }
}

class EventBusBroker(queueCapacity: Int = Eventbus.SUBSCRIBER_QUEUE_CAPACITY)
    extends EventsGrpcDc.EventBusServer {

  type Subscriber = EventbusSubscriber

  private val lock = new ReentrantLock()
  private val subscribers = mutable.ArrayBuffer[Subscriber]()
  private var seq = 0L
  private var published = 0L
  private var droppedCount = 0L

  // Accept an event: assign its sequence number and
  // timestamp and fan it out to matching subscribers.
  // Returns the stamped Event.
  def publishEvent(tags: List[TagValue], payload: Array[Byte],
                   publisherId: String = ""): Event = {
    var event: Event = null
    var current: List[Subscriber] = null
    lock.lock()
    try {
      seq += 1
      event = new Event(
        if (tags == null) List.empty else tags,
        if (payload == null) Array.empty[Byte] else payload,
        seq,
        if (publisherId == null) "" else publisherId,
        System.currentTimeMillis())
      published += 1
      current = subscribers.toList
    } finally {
      lock.unlock()
    }
    for (sub <- current) {
      if (Eventbus.tagsMatch(event.tags, sub.filter) && sub.push(event)) {
        lock.lock()
        try {
          droppedCount += 1
        } finally {
          lock.unlock()
        }
      }
    }
    event
  }

  def stats(): Map[String, Long] = {
    lock.lock()
    try {
      Map(
        "published" -> published,
        "subscribers" -> subscribers.size.toLong,
        "dropped" -> droppedCount)
    } finally {
      lock.unlock()
    }
  }

  // grpcdc.events.v1.EventBus service implementation
  // (register calls these).
  override def Publish(ctx: grpcdc.Endpoint#CallContext, req: PublishRequest): PublishReply = {
    val event = publishEvent(req.tags, req.payload, req.publisherId)
    new PublishReply(event.seq)
  }

  override def Subscribe(req: SubscribeRequest,
                         stream: EventsGrpcDc.EventBusServerStreamServer): Unit = {
    val sub = new Subscriber(req.filter, queueCapacity)
    lock.lock()
    try {
      subscribers += sub
    } finally {
      lock.unlock()
    }
    try {
      while (true) {
        val event = sub.take(100)
        if (event != null) stream.send(event)
      }
    } finally {
      lock.lock()
      try {
        subscribers -= sub
      } finally {
        lock.unlock()
      }
    }
  }

  // In-process subscription: events fan out to it exactly
  // like an RPC subscriber, without a call. Useful embedded
  // and for tests; close() unregisters.
  def subscribeLocal(filterTags: List[TagValue]): LocalSubscription = {
    val sub = new Subscriber(
      if (filterTags == null) List.empty else filterTags, queueCapacity)
    lock.lock()
    try {
      subscribers += sub
    } finally {
      lock.unlock()
    }
    new LocalSubscription(this, sub)
  }

  def removeSubscriber(sub: Subscriber): Unit = {
    lock.lock()
    try {
      subscribers -= sub
    } finally {
      lock.unlock()
    }
  }

  def register(server: grpcdc.Server): EventBusBroker = {
    EventsGrpcDc.registerEventBusServer(server, this)
    this
  }
}
TPL
   ))

