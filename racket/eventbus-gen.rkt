    }

    // Subscribe through a generated EventBusClient; returns
    // the receiving stream (iterate it, or close it to
    // unsubscribe).
    public static function subscribeEvents(\EventsGrpcDc\EventBusClient $client, array $filterTags): \EventsGrpcDc\RecvStream
