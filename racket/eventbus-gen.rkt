    }

    public function dropped(): int
    {
        return $this->sub->dropped;
    }

    public function take(float $timeout = 1.0): ?\EventsPb\Event
    {
        return $this->sub->take($timeout);
    }

    public function close(): void
    {
        $this->broker->removeSubscriber($this->sub);
    }
}
