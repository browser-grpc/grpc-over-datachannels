    public static EventsGrpcDc.EventBusSubscribeStream SubscribeEvents(
        EventsGrpcDc.EventBusClient client, List<TagValue> filterTags)
    {
        return client.Subscribe(new SubscribeRequest(filterTags ?? new List<TagValue>()));
    }
}
