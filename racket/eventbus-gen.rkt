   (py-header)
   #<<TPL
"""Event bus end-to-end over the loopback transport, plus the
git log serde round-trip."""

import os
import subprocess
import sys
import tempfile
import threading
import time
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

import grpcdc
from grpcdc import eventbus, eventbus_git
from grpcdc.events_pb import Tag, TagValue


def wait_for(fn, timeout=5.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if fn():
            return
        time.sleep(0.01)
    raise AssertionError("wait_for timed out")


class BusSetup:
    def __init__(self, queue_capacity=None):
        kwargs = {} if queue_capacity is None else {"queue_capacity": queue_capacity}
        self.broker = eventbus.EventBusBroker(**kwargs)
        a, b = grpcdc.memory_transport_pair()
        server = grpcdc.Server()
        self.broker.register(server)
        server.serve_transport(b)
        self.client = eventbus.EventBusClient(grpcdc.Channel(a))


def collect(stream, out):
    def run():
        try:
            for event in stream:
                out.append(event)
        except Exception:
            pass

    thread = threading.Thread(target=run, daemon=True)
    thread.start()
    return thread


class TestTagsMatch(unittest.TestCase):
    def test_containment_kinds_empty(self):
        tags = [eventbus.tag_string(Tag.TOPIC, "orders"), eventbus.tag_int(Tag.KIND, 5)]
        self.assertTrue(eventbus.tags_match(tags, []))
        self.assertTrue(eventbus.tags_match(tags, [eventbus.tag_string(Tag.TOPIC, "orders")]))
        self.assertTrue(eventbus.tags_match(tags, tags))
        self.assertFalse(eventbus.tags_match(tags, [eventbus.tag_enum(Tag.KIND, 5)]))
        self.assertFalse(eventbus.tags_match(tags, [eventbus.tag_string(Tag.KIND, "5")]))
        self.assertFalse(eventbus.tags_match(tags, [eventbus.tag_string(Tag.TOPIC, "other")]))


class TestFanOut(unittest.TestCase):
    def test_fanout_honors_filters(self):
        bus = BusSetup()
        orders, all_events = [], []
        collect(eventbus.subscribe_events(bus.client, [eventbus.tag_string(Tag.TOPIC, "orders")]), orders)
        collect(eventbus.subscribe_events(bus.client, []), all_events)
        wait_for(lambda: bus.broker.stats()["subscribers"] == 2)
        self.assertEqual(eventbus.publish_event(bus.client, [eventbus.tag_string(Tag.TOPIC, "orders")], b"o1", "test"), 1)
        self.assertEqual(eventbus.publish_event(bus.client, [eventbus.tag_string(Tag.TOPIC, "other")], b"x1", "test"), 2)
        wait_for(lambda: len(orders) == 1 and len(all_events) == 2)
        self.assertEqual(orders[0].payload, b"o1")
        self.assertEqual(orders[0].publisher_id, "test")
        self.assertEqual([e.seq for e in all_events], [1, 2])

    def test_kinds_never_cross_match(self):
        bus = BusSetup()
        got = []
        collect(eventbus.subscribe_events(bus.client, [eventbus.tag_int(Tag.KIND, 5)]), got)
        wait_for(lambda: bus.broker.stats()["subscribers"] == 1)
        eventbus.publish_event(bus.client, [eventbus.tag_string(Tag.KIND, "5")], b"s")
        eventbus.publish_event(bus.client, [eventbus.tag_enum(Tag.KIND, 5)], b"e")
        self.assertEqual(eventbus.publish_event(bus.client, [eventbus.tag_int(Tag.KIND, 5)], b"i"), 3)
        wait_for(lambda: len(got) == 1)
        self.assertEqual(got[0].payload, b"i")

    def test_user_tags_pass_through(self):
        bus = BusSetup()
        mine = TagValue(tag=1004, string_value="x")
        got = []
        collect(eventbus.subscribe_events(bus.client, [mine]), got)
        wait_for(lambda: bus.broker.stats()["subscribers"] == 1)
        eventbus.publish_event(bus.client, [TagValue(tag=1004, string_value="x")], b"u")
        wait_for(lambda: len(got) == 1)
        self.assertEqual(got[0].tags[0].tag, 1004)
        self.assertEqual(got[0].tags[0].string_value, "x")

    def test_slow_subscriber_drops_oldest(self):
        broker = eventbus.EventBusBroker(queue_capacity=4)
        sub = broker.subscribe_local([])
        for i in range(1, 7):
            broker.publish_event([], ("m%d" % i).encode())
        self.assertEqual(broker.stats()["dropped"], 2)
        self.assertEqual(sub.dropped, 2)
        seqs = [sub.take().seq for _ in range(4)]
        self.assertEqual(seqs, [3, 4, 5, 6])
        sub.close()
        self.assertEqual(broker.stats()["subscribers"], 0)

    def test_close_unsubscribes(self):
        bus = BusSetup()
        stream = eventbus.subscribe_events(bus.client, [])
        wait_for(lambda: bus.broker.stats()["subscribers"] == 1)
        eventbus.publish_event(bus.client, [], b"a")
        self.assertEqual(stream.recv().payload, b"a")
        stream.close()
        eventbus.publish_event(bus.client, [], b"b")
        wait_for(lambda: bus.broker.stats()["subscribers"] == 0)


class TestGitLog(unittest.TestCase):
    def test_round_trip_and_idempotent(self):
        repo = tempfile.mkdtemp(prefix="grpc-dc-eventbus-")
        broker = eventbus.EventBusBroker()
        events = [
            broker.publish_event([eventbus.tag_string(Tag.TOPIC, "orders")], b"o1", "test"),
            broker.publish_event([eventbus.tag_string(Tag.TOPIC, "other")], b"x1", "test"),
            broker.publish_event([eventbus.tag_string(Tag.TOPIC, "orders")], b"o2", "test"),
        ]
        head1 = eventbus_git.export_events(repo, events)
        count = subprocess.run(
            ["git", "-C", repo, "rev-list", "--count", "grpc-dc-events"],
            stdout=subprocess.PIPE,
            check=True,
        ).stdout.decode().strip()
        self.assertEqual(count, "3")
        self.assertEqual(eventbus_git.export_events(repo, events), head1)
        all_events = eventbus_git.import_events(repo)
        self.assertEqual([e.seq for e in all_events], [1, 2, 3])
        self.assertEqual([e.payload for e in all_events], [b"o1", b"x1", b"o2"])
        self.assertTrue(all(e.publisher_id == "test" for e in all_events))
        orders = eventbus_git.import_events(repo, filter_tags=[eventbus.tag_string(Tag.TOPIC, "orders")])
        self.assertEqual([e.seq for e in orders], [1, 3])
        window = eventbus_git.import_events(repo, from_seq=1, to_seq=2)
        self.assertEqual([e.seq for e in window], [2])


if __name__ == "__main__":
    unittest.main()
TPL
   ))

