/// Event bus (grpcdc.events.v1.EventBus): in-memory broker,
/// client helpers, and tag matching. Wire messages and stubs
/// are generated from proto/events.proto (events_messages,
/// events_grpc_dc); the broker policy comes from the shared
/// event-bus spec.
///
/// Delivery is at-most-once: each subscriber has a bounded
/// queue (subscriberQueueCapacity) and drops its oldest
/// events when it falls behind; stats reports the drops.
///
/// Note: the generated Tag is a closed Dart enum, so a Dart
/// peer can only carry tag values present in its generated
/// copy of events.proto. To use your own tags, copy
/// events.proto, add values (1000+), and regenerate — the
/// standard extension flow. Brokers in open-enum languages
/// pass unknown tag numbers through unchanged.

import 'dart:async';
import 'dart:convert';
import 'dart:typed_data';

import 'endpoint.dart';
import 'events_grpc_dc.dart';
import 'events_messages.dart';
import 'server.dart';

const int subscriberQueueCapacity = ~a;

String _doubleBits(double value) {
  final data = ByteData(8)..setFloat64(0, value, Endian.big);
  return data.getUint64(0, Endian.big).toRadixString(16).padLeft(16, '0');
}

// Canonical identity of one tag value. The oneof kind is
// part of the identity (int 5 != "5" != enum 5). Kinds are
// told apart by value, so an all-default TagValue reads as
// the empty string value; numbers compare bit-exact, never
// via decimal text.
String _valueKey(TagValue tv) {
  if (tv.stringValue != '') return 's:${tv.stringValue}';
  if (tv.intValue != 0) return 'i:${tv.intValue}';
  if (tv.doubleValue != 0) return 'd:${_doubleBits(tv.doubleValue)}';
  if (tv.boolValue) return 'b:true';
  if (tv.enumValue != 0) return 'e:${tv.enumValue}';
  return 's:';
}

/// Stable key for one TagValue, e.g. "1|s:orders".
String tagValueKey(TagValue tv) => '${tv.tag.index}|${_valueKey(tv)}';

/// Containment match: the event is delivered when its tag
/// list contains every (tag, value) pair of the filter. An
/// empty filter matches everything.
bool tagsMatch(List<TagValue> eventTags, List<TagValue> filterTags) {
  if (filterTags.isEmpty) return true;
  final have = <String>{};
  for (final tv in eventTags) {
    have.add(tagValueKey(tv));
  }
  return filterTags.every((f) => have.contains(tagValueKey(f)));
}

TagValue tagString(Tag tag, Object value) =>
    TagValue(tag, value.toString());
TagValue tagInt(Tag tag, Object value) =>
    TagValue(tag, '', (value as num).toInt());
TagValue tagDouble(Tag tag, Object value) =>
    TagValue(tag, '', 0, (value as num).toDouble());
TagValue tagBool(Tag tag, Object value) =>
    TagValue(tag, '', 0, 0, value == true);
TagValue tagEnum(Tag tag, Object value) =>
    TagValue(tag, '', 0, 0, false, (value as num).toInt());

class _Subscriber {
  final List<TagValue> filter;
  final int capacity;
  final List<Event> queue = [];
  int dropped = 0;

  _Subscriber(this.filter, this.capacity);

  bool push(Event event) {
    var wasDropped = false;
    if (queue.length >= capacity) {
      queue.removeAt(0);
      dropped++;
      wasDropped = true;
    }
    queue.add(event);
    return wasDropped;
  }

  Future<Event?> take(Duration timeout) async {
    final deadline = DateTime.now().add(timeout);
    while (true) {
      if (queue.isNotEmpty) return queue.removeAt(0);
      if (!DateTime.now().isBefore(deadline)) return null;
      await Future<void>.delayed(const Duration(milliseconds: 5));
    }
  }
}

/// In-memory grpcdc.events.v1.EventBus broker. Any peer can
/// host it: register() it on a Server next to your own
/// services, or call publishEvent directly in-process.
class EventBusBroker implements EventBusServer {
  final int queueCapacity;
  final List<_Subscriber> _subscribers = [];
  int _seq = 0;
  int _published = 0;
  int _dropped = 0;

  EventBusBroker({this.queueCapacity = subscriberQueueCapacity});

  /// Accept an event: assign its sequence number and
  /// timestamp and fan it out to matching subscribers.
  /// Returns the stamped Event.
  Event publishEvent(List<TagValue> tags, List<int> payload,
      [String publisherId = '']) {
    _seq++;
    final event = Event(_seq, publisherId,
        DateTime.now().millisecondsSinceEpoch)
      ..tags = List<TagValue>.from(tags)
      ..payload = Uint8List.fromList(payload);
    _published++;
    for (final sub in List<_Subscriber>.from(_subscribers)) {
      if (tagsMatch(event.tags, sub.filter) && sub.push(event)) {
        _dropped++;
      }
    }
    return event;
  }

  Map<String, int> stats() => {
        'published': _published,
        'subscribers': _subscribers.length,
        'dropped': _dropped,
      };

  // grpcdc.events.v1.EventBus service implementation
  // (register calls these).
  @override
  Future<PublishReply> publish(CallContext ctx, PublishRequest req) async {
    final event = publishEvent(req.tags, req.payload, req.publisherId);
    return PublishReply(event.seq);
  }

  @override
  Future<void> subscribe(
      SubscribeRequest req, EventBusSubscribeServer stream) async {
    final sub = _Subscriber(req.filter, queueCapacity);
    _subscribers.add(sub);
    try {
      while (true) {
        final event = await sub.take(const Duration(milliseconds: 100));
        if (event != null) stream.send(event);
      }
    } finally {
      _subscribers.remove(sub);
    }
  }

  /// In-process subscription: events fan out to it exactly
  /// like an RPC subscriber, without a call. Useful embedded
  /// and for tests; close() unregisters.
  LocalSubscription subscribeLocal(List<TagValue> filterTags) {
    final sub = _Subscriber(filterTags, queueCapacity);
    _subscribers.add(sub);
    return LocalSubscription._(this, sub);
  }

  void _removeSubscriber(_Subscriber sub) {
    _subscribers.remove(sub);
  }

  EventBusBroker register(Server server) {
    EventsGrpcDc.registerEventBusServer(server, this);
    return this;
  }
}

/// Handle for EventBusBroker.subscribeLocal: pull events
/// in-process. take returns the next event (waiting up to
/// the timeout), or null; dropped counts this subscription's
/// drop-oldest losses.
class LocalSubscription {
  final EventBusBroker _broker;
  final _Subscriber _sub;

  LocalSubscription._(this._broker, this._sub);

  int get dropped => _sub.dropped;

  Future<Event?> take([Duration timeout = const Duration(seconds: 1)]) =>
      _sub.take(timeout);

  void close() {
    _broker._removeSubscriber(_sub);
  }
}

/// Publish through a generated EventBusClient; returns the
/// broker-assigned sequence number.
Future<int> publishEvent(
    EventBusClient client, List<TagValue> tags, List<int> payload,
    [String publisherId = '']) async {
  final reply = await client.publish(PublishRequest()
    ..tags = List<TagValue>.from(tags)
    ..payload = Uint8List.fromList(payload)
    ..publisherId = publisherId);
  return reply.seq;
}

/// Subscribe through a generated EventBusClient; returns the
/// receiving stream (listen to its responses, or close() it
/// to unsubscribe).
Future<EventBusSubscribeStream> subscribeEvents(
        EventBusClient client, List<TagValue> filterTags) =>
    client.subscribe(SubscribeRequest()
      ..filter = List<TagValue>.from(filterTags));
