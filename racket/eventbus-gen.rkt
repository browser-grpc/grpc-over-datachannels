   #<<TPL
package grpcdc.events.v1

// In-memory grpcdc.events.v1.EventBus broker. Any peer can
// host it: register() it on a grpcdc.Server next to your own
// services, or call publishEvent() directly in-process.

import grpcdc.Endpoint
import grpcdc.Server
import java.util.ArrayDeque
import java.util.concurrent.TimeUnit
import java.util.concurrent.locks.ReentrantLock
import kotlin.concurrent.withLock

class EventBusBroker(
    private val queueCapacity: Int = Eventbus.SUBSCRIBER_QUEUE_CAPACITY
) : EventsGrpcDc.EventBusServer {

    internal class Subscriber(val filter: List<TagValue>, val capacity: Int) {
        private val lock = ReentrantLock()
        private val notEmpty = lock.newCondition()
        private val queue = ArrayDeque<Event>()

        @Volatile
        var dropped: Int = 0
            private set

        fun push(event: Event): Boolean {
            lock.withLock {
                var wasDropped = false
                if (queue.size >= capacity) {
                    queue.pollFirst()
                    dropped++
                    wasDropped = true
                }
                queue.addLast(event)
                notEmpty.signalAll()
                return wasDropped
            }
        }

        // Next queued event, or null when the wait times out.
        // The broker re-checks every tick; a cancelled call is
        // reaped when its next matching send fails (the
        // runtime surfaces cancellation only at send time).
        fun take(timeoutMs: Long): Event? {
            lock.withLock {
                var remainingNs = TimeUnit.MILLISECONDS.toNanos(timeoutMs)
                while (queue.isEmpty()) {
                    if (remainingNs <= 0) return null
                    remainingNs = notEmpty.awaitNanos(remainingNs)
                }
                return queue.pollFirst()
            }
        }
    }

    private val lock = ReentrantLock()
    private val subscribers = ArrayList<Subscriber>()
    private var seq = 0L
    private var published = 0L
    private var dropped = 0L

    // Accept an event: assign its sequence number and
    // timestamp and fan it out to matching subscribers.
    // Returns the stamped Event.
    fun publishEvent(tags: List<TagValue>?, payload: ByteArray?,
                     publisherId: String = ""): Event {
        val event: Event
        val current: List<Subscriber>
        lock.withLock {
            seq++
            event = Event(
                (tags ?: emptyList()).toMutableList(),
                payload ?: ByteArray(0),
                seq.toULong(),
                publisherId,
                System.currentTimeMillis())
            published++
            current = ArrayList(subscribers)
        }
        for (sub in current) {
            if (Eventbus.tagsMatch(event.tags, sub.filter) && sub.push(event)) {
                lock.withLock { dropped++ }
            }
        }
        return event
    }

    fun stats(): Map<String, Long> {
        lock.withLock {
            return mapOf(
                "published" to published,
                "subscribers" to subscribers.size.toLong(),
                "dropped" to dropped)
        }
    }

    // grpcdc.events.v1.EventBus service implementation
    // (register calls these).
    override fun Publish(ctx: Endpoint.CallContext, req: PublishRequest): PublishReply {
        val event = publishEvent(req.tags, req.payload, req.publisherId)
        return PublishReply(event.seq)
    }

    override fun Subscribe(req: SubscribeRequest,
                           stream: EventsGrpcDc.EventBusSubscribeServer) {
        val sub = Subscriber(req.filter, queueCapacity)
        lock.withLock { subscribers.add(sub) }
        try {
            while (true) {
                val event = sub.take(100)
                if (event != null) stream.send(event)
            }
        } finally {
            lock.withLock { subscribers.remove(sub) }
        }
    }

    // In-process subscription: events fan out to it exactly
    // like an RPC subscriber, without a call. Useful embedded
    // and for tests; close() unregisters.
    fun subscribeLocal(filterTags: List<TagValue>?): LocalSubscription {
        val sub = Subscriber(filterTags ?: emptyList(), queueCapacity)
        lock.withLock { subscribers.add(sub) }
        return LocalSubscription(this, sub)
    }

    internal fun removeSubscriber(sub: Subscriber) {
        lock.withLock { subscribers.remove(sub) }
    }

    fun register(server: Server): EventBusBroker {
        EventsGrpcDc.registerEventBusServer(server, this)
        return this
    }
}
TPL
   ))

