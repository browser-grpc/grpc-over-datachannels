  (string-append
   (go-header)
   #<<TPL
// Event bus end-to-end over the loopback transport, plus the
// git log serde round-trip.
package grpcdc_test

import (
	"context"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
	"time"

	grpcdc "grpcdc"
	busv1 "grpcdc/eventbus"
)

func setupEventBus(t *testing.T, capacity int) (*busv1.EventBusBroker, *busv1.EventBusClient) {
	t.Helper()
	broker := busv1.NewEventBusBroker()
	if capacity > 0 {
		broker.QueueCapacity = capacity
	}
	a, b := grpcdc.MemoryTransportPair()
	server := grpcdc.NewServer()
	broker.Register(server)
	server.ServeTransport(b)
	return broker, busv1.NewEventBusClient(grpcdc.NewChannel(a))
}

func waitForEventBus(t *testing.T, cond func() bool, what string) {
	t.Helper()
	deadline := time.Now().Add(5 * time.Second)
	for time.Now().Before(deadline) {
		if cond() {
			return
		}
		time.Sleep(10 * time.Millisecond)
	}
	t.Fatalf("timed out waiting for %s", what)
}

type eventCollector struct {
	ch chan *busv1.Event
}

func collectEvents(stream *busv1.EventBusSubscribeStream) *eventCollector {
	c := &eventCollector{ch: make(chan *busv1.Event, 64)}
	go func() {
		defer close(c.ch)
		for {
			event, err := stream.Recv()
			if err != nil {
				return
			}
			c.ch <- event
		}
	}()
	return c
}

func (c *eventCollector) next(t *testing.T) *busv1.Event {
	t.Helper()
	select {
	case event := <-c.ch:
		return event
	case <-time.After(5 * time.Second):
		t.Fatal("timed out waiting for event")
		return nil
	}
}

func TestTagsMatch(t *testing.T) {
	tags := []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders"), busv1.TagInt(busv1.Tag_KIND, 5)}
	if !busv1.TagsMatch(tags, nil) {
		t.Fatal("empty filter must match")
	}
	if !busv1.TagsMatch(tags, tags) {
		t.Fatal("identical tag list must match")
	}
	if busv1.TagsMatch(tags, []*busv1.TagValue{busv1.TagEnum(busv1.Tag_KIND, 5)}) {
		t.Fatal("int 5 must not match enum 5")
	}
	if busv1.TagsMatch(tags, []*busv1.TagValue{busv1.TagString(busv1.Tag_KIND, "5")}) {
		t.Fatal("int 5 must not match string 5")
	}
	if busv1.TagsMatch(tags, []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "other")}) {
		t.Fatal("different topic must not match")
	}
}

func TestEventBusFanOut(t *testing.T) {
	broker, client := setupEventBus(t, 0)
	ctx := context.Background()
	ordersStream, err := busv1.SubscribeEvents(ctx, client, []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders")})
	if err != nil {
		t.Fatal(err)
	}
	orders := collectEvents(ordersStream)
	allStream, err := busv1.SubscribeEvents(ctx, client, nil)
	if err != nil {
		t.Fatal(err)
	}
	all := collectEvents(allStream)
	waitForEventBus(t, func() bool { return broker.Stats().Subscribers == 2 }, "two subscribers")

	seq, err := busv1.PublishEvent(ctx, client, []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders")}, []byte("o1"), "test")
	if err != nil || seq != 1 {
		t.Fatalf("publish 1: seq=%d err=%v", seq, err)
	}
	seq, err = busv1.PublishEvent(ctx, client, []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "other")}, []byte("x1"), "test")
	if err != nil || seq != 2 {
		t.Fatalf("publish 2: seq=%d err=%v", seq, err)
	}
	got := orders.next(t)
	if string(got.Payload) != "o1" || got.PublisherId != "test" {
		t.Fatalf("orders event = %+v", got)
	}
	if first, second := all.next(t), all.next(t); first.Seq != 1 || second.Seq != 2 {
		t.Fatalf("all seqs = %d, %d", first.Seq, second.Seq)
	}
}

func TestEventBusKindsNeverCrossMatch(t *testing.T) {
	broker, client := setupEventBus(t, 0)
	ctx := context.Background()
	stream, err := busv1.SubscribeEvents(ctx, client, []*busv1.TagValue{busv1.TagInt(busv1.Tag_KIND, 5)})
	if err != nil {
		t.Fatal(err)
	}
	got := collectEvents(stream)
	waitForEventBus(t, func() bool { return broker.Stats().Subscribers == 1 }, "one subscriber")
	if _, err := busv1.PublishEvent(ctx, client, []*busv1.TagValue{busv1.TagString(busv1.Tag_KIND, "5")}, []byte("s"), ""); err != nil {
		t.Fatal(err)
	}
	if _, err := busv1.PublishEvent(ctx, client, []*busv1.TagValue{busv1.TagEnum(busv1.Tag_KIND, 5)}, []byte("e"), ""); err != nil {
		t.Fatal(err)
	}
	seq, err := busv1.PublishEvent(ctx, client, []*busv1.TagValue{busv1.TagInt(busv1.Tag_KIND, 5)}, []byte("i"), "")
	if err != nil || seq != 3 {
		t.Fatalf("publish 3: seq=%d err=%v", seq, err)
	}
	if event := got.next(t); string(event.Payload) != "i" {
		t.Fatalf("payload = %q, want only the int-kind event", event.Payload)
	}
}

func TestEventBusUserTagsPassThrough(t *testing.T) {
	broker, client := setupEventBus(t, 0)
	ctx := context.Background()
	mine := &busv1.TagValue{Tag: busv1.Tag(1004), StringValue: "x"}
	stream, err := busv1.SubscribeEvents(ctx, client, []*busv1.TagValue{mine})
	if err != nil {
		t.Fatal(err)
	}
	got := collectEvents(stream)
	waitForEventBus(t, func() bool { return broker.Stats().Subscribers == 1 }, "one subscriber")
	if _, err := busv1.PublishEvent(ctx, client, []*busv1.TagValue{{Tag: busv1.Tag(1004), StringValue: "x"}}, []byte("u"), ""); err != nil {
		t.Fatal(err)
	}
	event := got.next(t)
	if int32(event.Tags[0].Tag) != 1004 || event.Tags[0].StringValue != "x" {
		t.Fatalf("user tag mangled: %+v", event.Tags[0])
	}
}

func TestEventBusSlowSubscriberDropsOldest(t *testing.T) {
	broker := busv1.NewEventBusBroker()
	broker.QueueCapacity = 4
	sub := broker.SubscribeLocal(nil)
	for i := 1; i <= 6; i++ {
		broker.PublishEvent(nil, []byte("m"+string(rune('0'+i))), "")
	}
	if dropped := broker.Stats().Dropped; dropped != 2 {
		t.Fatalf("dropped = %d, want 2", dropped)
	}
	if dropped := sub.Dropped(); dropped != 2 {
		t.Fatalf("subscription dropped = %d, want 2", dropped)
	}
	for want := uint64(3); want <= 6; want++ {
		event, err := sub.Recv(context.Background())
		if err != nil {
			t.Fatal(err)
		}
		if event.Seq != want {
			t.Fatalf("seq = %d, want %d", event.Seq, want)
		}
	}
	sub.Close()
	if got := broker.Stats().Subscribers; got != 0 {
		t.Fatalf("subscribers = %d after Close, want 0", got)
	}
}

func TestEventBusCancelUnsubscribes(t *testing.T) {
	broker, client := setupEventBus(t, 0)
	ctx, cancel := context.WithCancel(context.Background())
	stream, err := busv1.SubscribeEvents(ctx, client, nil)
	if err != nil {
		t.Fatal(err)
	}
	waitForEventBus(t, func() bool { return broker.Stats().Subscribers == 1 }, "one subscriber")
	if _, err := busv1.PublishEvent(context.Background(), client, nil, []byte("a"), ""); err != nil {
		t.Fatal(err)
	}
	if _, err := stream.Recv(); err != nil {
		t.Fatal(err)
	}
	cancel()
	// The broker reaps the subscription on the handler's next
	// failed send after the RST lands; keep flushing until it
	// observes it (exactly the documented reap condition).
	deadline := time.Now().Add(5 * time.Second)
	for broker.Stats().Subscribers != 0 {
		if time.Now().After(deadline) {
			t.Fatal("timed out waiting for unsubscribe after cancel")
		}
		if _, err := busv1.PublishEvent(context.Background(), client, nil, []byte("flush"), ""); err != nil {
			t.Fatal(err)
		}
		time.Sleep(20 * time.Millisecond)
	}
}

func TestEventBusGitLogRoundTrip(t *testing.T) {
	repo := filepath.Join(t.TempDir(), "log")
	broker := busv1.NewEventBusBroker()
	events := []*busv1.Event{
		broker.PublishEvent([]*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders")}, []byte("o1"), "test"),
		broker.PublishEvent([]*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "other")}, []byte("x1"), "test"),
		broker.PublishEvent([]*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders")}, []byte("o2"), "test"),
	}
	head1, err := busv1.ExportEventsToGit(repo, events, busv1.EventLogBranch)
	if err != nil {
		t.Fatal(err)
	}
	count, err := exec.Command("git", "-C", repo, "rev-list", "--count", busv1.EventLogBranch).Output()
	if err != nil {
		t.Fatal(err)
	}
	if strings.TrimSpace(string(count)) != "3" {
		t.Fatalf("commit count = %s, want 3", count)
	}
	head2, err := busv1.ExportEventsToGit(repo, events, busv1.EventLogBranch)
	if err != nil {
		t.Fatal(err)
	}
	if head2 != head1 {
		t.Fatalf("re-export not idempotent: %s != %s", head2, head1)
	}
	all, err := busv1.ImportEventsFromGit(repo, busv1.EventLogBranch, nil, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	if len(all) != 3 || all[0].Seq != 1 || all[1].Seq != 2 || all[2].Seq != 3 {
		t.Fatalf("imported = %+v", all)
	}
	for i, want := range []string{"o1", "x1", "o2"} {
		if string(all[i].Payload) != want || all[i].PublisherId != "test" {
			t.Fatalf("event %d = %+v", i, all[i])
		}
	}
	orders, err := busv1.ImportEventsFromGit(repo, busv1.EventLogBranch, []*busv1.TagValue{busv1.TagString(busv1.Tag_TOPIC, "orders")}, 0, 0)
	if err != nil {
		t.Fatal(err)
	}
	if len(orders) != 2 || orders[0].Seq != 1 || orders[1].Seq != 3 {
		t.Fatalf("orders = %+v", orders)
	}
	window, err := busv1.ImportEventsFromGit(repo, busv1.EventLogBranch, nil, 1, 2)
	if err != nil {
		t.Fatal(err)
	}
	if len(window) != 1 || window[0].Seq != 2 {
		t.Fatalf("window = %+v", window)
	}
	if _, err := os.Stat(filepath.Join(repo, ".git")); err != nil {
		t.Fatal(err)
	}
}
TPL
   ))

