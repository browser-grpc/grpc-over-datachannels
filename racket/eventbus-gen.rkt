        "noise".toByteArray(StandardCharsets.UTF_8), "demo")
    Eventbus.publishEvent(client,
        listOf(Eventbus.tagString(Tag.TOPIC, "orders")),
        "order-2".toByteArray(StandardCharsets.UTF_8), "demo")
    thread.join(5000)
    println("subscriber got: " + received.joinToString(", "))
    println("broker stats: " + broker.stats())
}
