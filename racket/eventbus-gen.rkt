# Event bus (grpcdc.events.v1.EventBus): in-memory broker,
# client helpers, and tag matching. Wire messages and stubs
# are generated from proto/events.proto (events_pb,
# events_grpc_dc); the broker policy comes from the shared
# event-bus spec.
#
# Delivery is at-most-once: each subscriber has a bounded
# queue (SUBSCRIBER_QUEUE_CAPACITY) and drops its oldest
# events when it falls behind; stats reports the drops.

require "thread"

require_relative "events_pb"
require_relative "events_grpc_dc"

module Grpcdc
  module Eventbus
    SUBSCRIBER_QUEUE_CAPACITY = ~a

    # Canonical identity of one tag value. The oneof kind is
    # part of the identity (int 5 != "5" != enum 5). Kinds are
    # told apart by value, so an all-default TagValue reads as
    # the empty string value; numbers compare bit-exact, never
    # via decimal text.
    def self.value_key(tv)
      return "s:#{tv.string_value}" unless tv.string_value.empty?
      return "i:#{tv.int_value}" unless tv.int_value.zero?
      return "d:#{[tv.double_value].pack("G").unpack1("H*")}" unless tv.double_value.zero?
      return "b:true" if tv.bool_value
      return "e:#{tv.enum_value}" unless tv.enum_value.zero?

      "s:"
    end

    # Stable key for one TagValue, e.g. "1|s:orders".
    def self.tag_value_key(tv)
      "#{tv.tag}|#{value_key(tv)}"
    end

    # Containment match: the event is delivered when its tag
    # list contains every (tag, value) pair of the filter. An
    # empty filter matches everything.
    def self.tags_match(event_tags, filter_tags)
      return true if filter_tags.nil? || filter_tags.empty?

      have = {}
      (event_tags || []).each { |tv| have[tag_value_key(tv)] = true }
      filter_tags.all? { |f| have.key?(tag_value_key(f)) }
    end

    def self.tag_string(tag, value)
      EventsPb::TagValue.new(tag: tag, string_value: value.to_s)
    end

    def self.tag_int(tag, value)
      EventsPb::TagValue.new(tag: tag, int_value: Integer(value))
    end

    def self.tag_double(tag, value)
      EventsPb::TagValue.new(tag: tag, double_value: Float(value))
    end

    def self.tag_bool(tag, value)
      EventsPb::TagValue.new(tag: tag, bool_value: value ? true : false)
    end

    def self.tag_enum(tag, value)
      EventsPb::TagValue.new(tag: tag, enum_value: Integer(value))
    end

    class Subscriber
      attr_reader :filter, :dropped

      def initialize(filter_tags, capacity)
        @filter = filter_tags || []
        @capacity = capacity
        @queue = []
        @mutex = Mutex.new
        @cond = ConditionVariable.new
        @dropped = 0
      end

      def push(event)
        @mutex.synchronize do
          dropped = false
          if @queue.length >= @capacity
            @queue.shift
            @dropped += 1
            dropped = true
          end
          @queue << event
          @cond.broadcast
          dropped
        end
      end

      # Next queued event, or nil when the wait times out. The
      # broker re-checks every tick; a cancelled call is reaped
      # when its next matching send fails (the runtime surfaces
      # cancellation only at send time).
      def take(timeout)
        @mutex.synchronize do
          @cond.wait(@mutex, timeout) if @queue.empty?
          @queue.empty? ? nil : @queue.shift
        end
      end
    end

    # In-memory grpcdc.events.v1.EventBus broker. Any peer can
    # host it: register() it on a Grpcdc::Server next to your
    # own services, or call publish_event directly in-process.
    class EventBusBroker
      def initialize(queue_capacity: SUBSCRIBER_QUEUE_CAPACITY)
        @queue_capacity = queue_capacity
        @mutex = Mutex.new
        @subscribers = []
        @seq = 0
        @published = 0
        @dropped = 0
      end

      # Accept an event: assign its sequence number and
      # timestamp and fan it out to matching subscribers.
      # Returns the stamped EventsPb::Event.
      def publish_event(tags, payload, publisher_id = "")
        event = nil
        subscribers = nil
        @mutex.synchronize do
          @seq += 1
          event = EventsPb::Event.new(
            tags: tags || [],
            payload: (payload || "".b).to_s.b,
            seq: @seq,
            publisher_id: publisher_id || "",
            timestamp_unix_ms: (Time.now.to_f * 1000).to_i
          )
          @published += 1
          subscribers = @subscribers.dup
        end
        subscribers.each do |sub|
          next unless Eventbus.tags_match(event.tags, sub.filter)

          if sub.push(event)
            @mutex.synchronize { @dropped += 1 }
          end
        end
        event
      end

      def stats
        @mutex.synchronize do
          { "published" => @published, "subscribers" => @subscribers.length, "dropped" => @dropped }
        end
      end

      # grpcdc.events.v1.EventBus service implementation
      # (register calls these).
      def Publish(_ctx, req)
        event = publish_event(req.tags, req.payload, req.publisher_id)
        EventsPb::PublishReply.new(seq: event.seq)
      end

      def Subscribe(req, stream)
        sub = Subscriber.new(req.filter, @queue_capacity)
        @mutex.synchronize { @subscribers << sub }
        begin
          loop do
            event = sub.take(0.1)
            stream.send(event) unless event.nil?
          end
        ensure
          @mutex.synchronize { @subscribers.delete(sub) }
        end
      end

      # In-process subscription: events fan out to it exactly
      # like an RPC subscriber, without a call. Useful embedded
      # and for tests; close() unregisters.
      def subscribe_local(filter_tags)
        sub = Subscriber.new(filter_tags, @queue_capacity)
