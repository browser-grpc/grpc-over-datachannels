(define go-codec-body
#<<GRPC_RUNTIME_EOF
// Package grpcdc is the Go runtime for gRPC over WebRTC DataChannels
// (wire protocol in ../SPEC.md). Standard library only. Frame, status,
// channel and server semantics mirror the Rust and JavaScript runtimes;
// the tables in wire_gen.go are generated by grpc-dc codegen.
package grpcdc

import (
	"context"
	"crypto/rand"
	"encoding/binary"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"strings"
	"sync"
	"time"
)

// HeaderLen is the frame header size: type:u8 | stream:u32be | len:u32be.
const HeaderLen = 9

// MaxDataPayload caps one DATA frame (SPEC.md), 16 MiB.
const MaxDataPayload = 16 * 1024 * 1024

// StatusError is a gRPC status (code + message) carried as an error.
type StatusError struct {
	Code    Code
	Message string
	// Trailers is the trailing metadata carried by a status
	// frame (nil when the peer sent none).
	Trailers map[string]string
}

func (e *StatusError) Error() string {
	if e == nil {
		return "OK"
	}
	return fmt.Sprintf("%s: %s", e.Code.Name(), e.Message)
}

// NewStatus builds a StatusError.
func NewStatus(code Code, message string) *StatusError {
	return &StatusError{Code: code, Message: message}
}

// Status extracts a *StatusError from err, converting foreign errors
// to INTERNAL with their message (OK for nil).
func Status(err error) *StatusError {
	if err == nil {
		return NewStatus(CodeOk, "")
	}
	var se *StatusError
	if errors.As(err, &se) {
		return se
	}
	return NewStatus(CodeInternal, err.Error())
}

// --- Homegrown tracing@@TRACING_BETA@@ (W3C traceparent propagation) -------------
// Dormant until SetTracer registers an observer. Generated code
// stays dependency-free: sampling and export are the app's problem.

// Tracer receives span callbacks (kind is "client" or "server").
type Tracer interface {
	OnStart(kind, method, traceID, spanID, parentSpanID string)
	OnEnd(kind, method, traceID, spanID, status string, durationMs float64)
}

var tracerMu sync.RWMutex
var tracer Tracer

// SetTracer registers the global span observer (nil disables).
func SetTracer(t Tracer) {
	tracerMu.Lock()
	defer tracerMu.Unlock()
	tracer = t
}

func getTracer() Tracer {
	tracerMu.RLock()
	defer tracerMu.RUnlock()
	return tracer
}

var traceFilter []string

// SetTraceFilter restricts traced methods: ';'-separated paths,
// a trailing '*' means prefix match ('/echo.Echo/*'). Empty =
// trace all.
func SetTraceFilter(patterns string) {
	tracerMu.Lock()
	defer tracerMu.Unlock()
	traceFilter = nil
	for _, p := range strings.Split(patterns, ";") {
		if p != "" {
			traceFilter = append(traceFilter, p)
		}
	}
}

func traceAllowed(method string) bool {
	if len(traceFilter) == 0 {
		return true
	}
	for _, p := range traceFilter {
		if strings.HasSuffix(p, "*") {
			if strings.HasPrefix(method, p[:len(p)-1]) {
				return true
			}
		} else if method == p {
			return true
		}
	}
	return false
}

type traceContext struct {
	TraceID      string
	SpanID       string
	ParentSpanID string
	Sampled      bool
	start        time.Time
	kind         string
	method       string
}

func randomHex(n int) string {
	buf := make([]byte, n)
	if _, err := rand.Read(buf); err != nil {
		for i := range buf {
			buf[i] = byte(time.Now().UnixNano() >> (8 * (i % 8)))
		}
	}
	return hex.EncodeToString(buf)
}

// FormatTraceparent renders a W3C traceparent header value.
func FormatTraceparent(traceID, spanID string, sampled bool) string {
	flags := "00"
	if sampled {
		flags = "01"
	}
	return "00-" + traceID + "-" + spanID + "-" + flags
}

// ParseTraceparent parses a traceparent header value.
func ParseTraceparent(value string) *traceContext {
	parts := strings.Split(value, "-")
	if len(parts) != 4 || len(parts[1]) != 32 || len(parts[2]) != 16 {
		return nil
	}
	if _, err := hex.DecodeString(parts[1]); err != nil {
		return nil
	}
	if _, err := hex.DecodeString(parts[2]); err != nil {
		return nil
	}
	flags, err := hex.DecodeString(parts[3])
	if err != nil || len(flags) != 1 {
		return nil
	}
	return &traceContext{TraceID: parts[1], SpanID: parts[2], Sampled: flags[0]&1 == 1}
}

func traceStart(kind, method string, parent *traceContext) *traceContext {
	t := getTracer()
	if t == nil || !traceAllowed(method) {
		return nil
	}
	ctx := &traceContext{SpanID: randomHex(8), Sampled: true, start: time.Now(), kind: kind, method: method}
	if parent != nil {
		ctx.TraceID = parent.TraceID
		ctx.ParentSpanID = parent.SpanID
		ctx.Sampled = parent.Sampled
	} else {
		ctx.TraceID = randomHex(16)
	}
	if !ctx.Sampled {
		return ctx
	}
	defer func() { _ = recover() }() // observers must never break the call
	t.OnStart(kind, method, ctx.TraceID, ctx.SpanID, ctx.ParentSpanID)
	return ctx
}

func traceEnd(kind, method string, ctx *traceContext, status string) {
	if ctx == nil || !ctx.Sampled {
		return
	}
	t := getTracer()
	if t == nil {
		return
	}
	defer func() { _ = recover() }()
	t.OnEnd(kind, method, ctx.TraceID, ctx.SpanID, status,
		float64(time.Since(ctx.start))/float64(time.Millisecond))
}

type traceContextKey struct{}

// ContextWithTraceContext returns a context carrying tc as the
// ambient trace context: outbound calls made with it (directly or
// through generated stubs, which thread context.Context) are
// parented to tc with no manual metadata handling. The server
// installs its span context this way before dispatch.
func ContextWithTraceContext(ctx context.Context, tc *traceContext) context.Context {
	if tc == nil {
		return ctx
	}
	return context.WithValue(ctx, traceContextKey{}, tc)
}

// TraceContextFromContext returns the ambient trace context, or nil.
func TraceContextFromContext(ctx context.Context) *traceContext {
	if ctx == nil {
		return nil
	}
	tc, _ := ctx.Value(traceContextKey{}).(*traceContext)
	return tc
}

// NewTraceContext starts a root span context (e.g. for a client
// workflow grouping several outbound calls under one trace).
// Pair with EndTraceContext. Nil when tracing is dormant.
func NewTraceContext(kind, method string) *traceContext {
	return traceStart(kind, method, nil)
}

// EndTraceContext ends a context from NewTraceContext.
func EndTraceContext(tc *traceContext, status string) {
	if tc == nil {
		return
	}
	traceEnd(tc.kind, tc.method, tc, status)
}

func traceParentOf(tc *traceContext) *traceContext {
	if tc == nil {
		return nil
	}
	return &traceContext{TraceID: tc.TraceID, SpanID: tc.SpanID, Sampled: tc.Sampled}
}

// Marshaler is implemented by protobuf message types (see the
// hand-written echo messages and generated stubs).
type Marshaler interface {
	MarshalDC() []byte
}

// Unmarshaler is implemented by pointer message types.
type Unmarshaler interface {
	UnmarshalDC([]byte) error
}

// EncodeFrame builds one DataChannel message: header + payload.
func EncodeFrame(frameType FrameType, streamID uint32, payload []byte) ([]byte, error) {
	if !frameType.Valid() {
		return nil, NewStatus(CodeInvalidArgument, fmt.Sprintf("unknown frame type %d", frameType))
	}
	if frameType == FrameData && len(payload) > MaxDataPayload {
		return nil, NewStatus(CodeResourceExhausted, "DATA payload exceeds 16 MiB")
	}
	out := make([]byte, HeaderLen+len(payload))
	out[0] = byte(frameType)
	binary.BigEndian.PutUint32(out[1:5], streamID)
	binary.BigEndian.PutUint32(out[5:9], uint32(len(payload)))
	copy(out[HeaderLen:], payload)
	return out, nil
}

// DecodeFrame parses one DataChannel message.
func DecodeFrame(data []byte) (FrameType, uint32, []byte, error) {
	if len(data) < HeaderLen {
		return 0, 0, nil, NewStatus(CodeInvalidArgument,
			fmt.Sprintf("frame shorter than 9-byte header: %d bytes", len(data)))
	}
	length := binary.BigEndian.Uint32(data[5:9])
	if int(length) != len(data)-HeaderLen {
		return 0, 0, nil, NewStatus(CodeInvalidArgument,
			fmt.Sprintf("payload length %d does not match message size %d", length, len(data)))
	}
	return FrameType(data[0]), binary.BigEndian.Uint32(data[1:5]), data[HeaderLen:], nil
}

type headersBody struct {
	Path     *string           `json:"path,omitempty"`
	Metadata map[string]string `json:"metadata,omitempty"`
}

// Headers is a parsed HEADERS payload: a nil Path marks a server's
// response headers.
type Headers struct {
	Path     *string
	Metadata map[string]string
}

// gRPC timeout grammar (grpc-timeout metadata): <digits><unit>,
// units H/M/S/m/u/n (at most 8 digits). Encoding uses
// milliseconds (seconds past the digit limit), rounded up so a
// deadline never shrinks in propagation.
func EncodeTimeout(d time.Duration) string {
	ms := (d + time.Millisecond - 1) / time.Millisecond
	if ms <= 99999999 {
		return fmt.Sprintf("%dm", ms)
	}
	return fmt.Sprintf("%dS", (d+time.Second-1)/time.Second)
}

// ParseTimeout decodes a grpc-timeout value; ok is false when malformed.
func ParseTimeout(text string) (time.Duration, bool) {
	if len(text) < 2 || len(text) > 9 {
		return 0, false
	}
	var unit time.Duration
	switch text[len(text)-1] {
	case 'H':
		unit = time.Hour
	case 'M':
		unit = time.Minute
	case 'S':
		unit = time.Second
	case 'm':
		unit = time.Millisecond
	case 'u':
		unit = time.Microsecond
	case 'n':
		unit = time.Nanosecond
	default:
		return 0, false
	}
	n := 0
	for _, c := range text[:len(text)-1] {
		if c < '0' || c > '9' {
			return 0, false
		}
		n = n*10 + int(c-'0')
	}
	return time.Duration(n) * unit, true
}

func headersFrame(streamID uint32, path *string, metadata map[string]string) ([]byte, error) {
	body := headersBody{Path: path, Metadata: metadata}
	if body.Metadata == nil {
		body.Metadata = map[string]string{}
	}
	payload, err := json.Marshal(body)
	if err != nil {
		return nil, err
	}
	return EncodeFrame(FrameHeaders, streamID, payload)
}

// Status frames (TRAILERS/RST) carry {code, message} and, when
// the call produced trailing metadata, a metadata member with
// the same JSON shape as HEADERS metadata (SPEC.md). Peers that
// predate trailing metadata ignore the member.
func statusFrame(frameType FrameType, streamID uint32, status *StatusError) ([]byte, error) {
	payload, err := json.Marshal(struct {
		Code     Code              `json:"code"`
		Message  string            `json:"message"`
		Metadata map[string]string `json:"metadata,omitempty"`
	}{status.Code, status.Message, status.Trailers})
	if err != nil {
		return nil, err
	}
	return EncodeFrame(frameType, streamID, payload)
}

func parseHeaders(payload []byte) (Headers, error) {
	var body headersBody
	if err := json.Unmarshal(payload, &body); err != nil {
		return Headers{}, NewStatus(CodeInvalidArgument, "malformed HEADERS payload")
	}
	if body.Metadata == nil {
		body.Metadata = map[string]string{}
	}
	return Headers{Path: body.Path, Metadata: body.Metadata}, nil
}

func parseStatus(payload []byte) *StatusError {
	var body struct {
		Code     *Code             `json:"code"`
		Message  string            `json:"message"`
		Metadata map[string]string `json:"metadata"`
	}
	if err := json.Unmarshal(payload, &body); err != nil {
		return NewStatus(CodeInternal, "malformed status payload")
	}
	code := CodeUnknown
	if body.Code != nil {
		code = *body.Code
	}
	status := NewStatus(code, body.Message)
	status.Trailers = body.Metadata
	return status
}
GRPC_RUNTIME_EOF
)

(define go-endpoint-body
#<<GRPC_RUNTIME_EOF
package grpcdc

import (
	"context"
	"io"
	"sync"
)

// Transport carries whole DataChannel messages: one Send/Recv is one
// message, boundaries preserved, ordered and reliable — the contract
// an RTCDataChannel (or the loopback pair) offers.
type Transport interface {
	Send([]byte) error
	Recv() ([]byte, error)
}

type eventKind int

const (
	eventHeaders eventKind = iota
	eventData
	eventHalfClose
	eventTrailers
	eventRST
)

type streamEvent struct {
	kind    eventKind
	headers Headers
	payload []byte
	status  *StatusError
}

// streamInput is the receiving queue of one stream. The channel closes
// after a terminal (trailers/RST) event has been delivered. All sends
// and the close are serialized on mu: the read loop, cancelStream and
// failAll may touch one stream concurrently, and a send racing a close
// would panic.
type streamInput struct {
	events chan streamEvent
	mu     sync.Mutex
	closed bool
}

func newStreamInput() *streamInput {
	return &streamInput{events: make(chan streamEvent, 256)}
}

// deliver queues ev unless the stream already terminated.
func (in *streamInput) deliver(ev streamEvent) {
	in.mu.Lock()
	defer in.mu.Unlock()
	if !in.closed {
		in.events <- ev
	}
}

// terminate delivers the terminal event and closes the queue, once.
func (in *streamInput) terminate(ev streamEvent) {
	in.mu.Lock()
	defer in.mu.Unlock()
	if in.closed {
		return
	}
	in.closed = true
	in.events <- ev
	close(in.events)
}

// Dispatcher handles one inbound call (installed by Server). The
// returned status becomes the call's TRAILERS (nil means OK).
type Dispatcher func(ctx context.Context, headers Headers, in *streamInput, sink *responseSink) *StatusError

type responseSink struct {
	ep *Endpoint
	id uint32
	// Initial/trailing metadata the handler accumulates via
	// SetHeader/SetTrailer. Initial metadata flushes lazily,
	// right before the first response DATA; trailers merge
	// into the terminal status frame.
	respHeaders  map[string]string
	respTrailers map[string]string
	headersSent  bool
}

func (s *responseSink) SendData(payload []byte) error {
	// A stream the endpoint has forgotten was RST by the peer
	// (or the channel went away): fail the send so a producing
	// handler stops instead of streaming into the void.
	if s.ep.stream(s.id) == nil {
		return NewStatus(CodeCancelled, "call cancelled")
	}
	if err := s.FlushHeaders(); err != nil {
		return err
	}
	frame, err := EncodeFrame(FrameData, s.id, payload)
	if err != nil {
		return err
	}
	return s.ep.SendFrame(frame)
}

// FlushHeaders sends the HEADERS frame (with accumulated
// initial metadata) if it has not gone out yet.
func (s *responseSink) FlushHeaders() error {
	if s.headersSent {
		return nil
	}
	s.headersSent = true
	return s.sendHeaders(s.respHeaders)
}

func (s *responseSink) sendHeaders(metadata map[string]string) error {
	if s.ep.stream(s.id) == nil {
		return NewStatus(CodeCancelled, "call cancelled")
	}
	frame, err := headersFrame(s.id, nil, metadata)
	if err != nil {
		return err
	}
	return s.ep.SendFrame(frame)
}

func (s *responseSink) sendTrailers(status *StatusError) error {
	if len(s.respTrailers) > 0 {
		merged := make(map[string]string, len(s.respTrailers)+len(status.Trailers))
		for k, v := range s.respTrailers {
			merged[k] = v
		}
		for k, v := range status.Trailers {
			merged[k] = v
		}
		clone := *status
		clone.Trailers = merged
		status = &clone
	}
	frame, err := statusFrame(FrameTrailers, s.id, status)
	if err != nil {
		return err
	}
	return s.ep.SendFrame(frame)
}

// Endpoint multiplexes streams over one Transport. The side that
// created the channel allocates odd stream ids, the answerer even.
type Endpoint struct {
	transport  Transport
	dispatcher Dispatcher
	nextID     uint32

	sendMu   sync.Mutex
	streams  sync.Map // uint32 -> *streamInput
	done     chan struct{}
	once     sync.Once
	startOnce sync.Once
}

// NewEndpoint builds an endpoint on t. creator selects odd ids. The
// read loop starts on Start — after any dispatcher is installed, so
// an early HEADERS can never race dispatcher setup.
func NewEndpoint(t Transport, creator bool) *Endpoint {
	ep := &Endpoint{transport: t, done: make(chan struct{})}
	if creator {
		ep.nextID = 1
	} else {
		ep.nextID = 2
	}
	return ep
}

// Start begins the read loop (idempotent).
func (ep *Endpoint) Start() {
	ep.startOnce.Do(func() { go ep.readLoop() })
}

// SetDispatcher installs the server-side call handler.
func (ep *Endpoint) SetDispatcher(d Dispatcher) { ep.dispatcher = d }

// SendFrame serializes one frame onto the transport.
func (ep *Endpoint) SendFrame(frame []byte) error {
	ep.sendMu.Lock()
	defer ep.sendMu.Unlock()
	return ep.transport.Send(frame)
}

func (ep *Endpoint) openStream() (uint32, *streamInput) {
	ep.sendMu.Lock()
	id := ep.nextID
	ep.nextID += 2
	ep.sendMu.Unlock()
	in := newStreamInput()
	ep.streams.Store(id, in)
	return id, in
}

func (ep *Endpoint) closeStream(id uint32) {
	ep.streams.Delete(id)
}

// cancelStream aborts one stream with RST and forgets it locally.
// The goroutine blocked in Recv selects on the call context, so it
// wakes on its own; the synthetic event covers races where Recv is
// entered after the abort.
func (ep *Endpoint) cancelStream(id uint32) {
	if in, ok := ep.streams.LoadAndDelete(id); ok {
		in.(*streamInput).terminate(streamEvent{kind: eventRST, status: NewStatus(CodeCancelled, "call cancelled")})
	}
	if frame, err := statusFrame(FrameRst, id, NewStatus(CodeCancelled, "call cancelled")); err == nil {
		_ = ep.SendFrame(frame)
	}
}

func (ep *Endpoint) stream(id uint32) *streamInput {
	in, ok := ep.streams.Load(id)
	if !ok {
		return nil
	}
	return in.(*streamInput)
}

// Close fails every live stream and stops the read loop.
func (ep *Endpoint) Close() {
	ep.once.Do(func() {
		close(ep.done)
		if c, ok := ep.transport.(io.Closer); ok {
			_ = c.Close()
		}
		ep.failAll()
	})
}

func (ep *Endpoint) failAll() {
	ep.streams.Range(func(key, value any) bool {
		value.(*streamInput).terminate(streamEvent{kind: eventRST, status: NewStatus(CodeUnavailable, "data channel closed")})
		ep.streams.Delete(key)
		return true
	})
}

func (ep *Endpoint) readLoop() {
	for {
		data, err := ep.transport.Recv()
		if err != nil {
			ep.failAll()
			return
		}
		select {
		case <-ep.done:
			return
		default:
		}
		ep.onBytes(data)
	}
}

func (ep *Endpoint) onBytes(data []byte) {
	frameType, streamID, payload, err := DecodeFrame(data)
	if err != nil {
		return // malformed frame: drop, keep the channel up
	}
@@FRAME_DISPATCH@@
}

func (ep *Endpoint) onTerminal(streamID uint32, payload []byte, kind eventKind) {
	if in := ep.stream(streamID); in != nil {
		in.terminate(streamEvent{kind: kind, status: parseStatus(payload)})
		ep.streams.Delete(streamID)
	}
}

func (ep *Endpoint) pushEvent(streamID uint32, ev streamEvent) {
	if in := ep.stream(streamID); in != nil {
		in.deliver(ev)
	}
}

func (ep *Endpoint) onHeaders(streamID uint32, payload []byte) {
	headers, err := parseHeaders(payload)
	if err != nil {
		frame, ferr := statusFrame(FrameRst, streamID, Status(err))
		if ferr == nil {
			_ = ep.SendFrame(frame)
		}
		return
	}
	if headers.Path == nil {
		// Server response headers for one of our outbound streams.
		if in := ep.stream(streamID); in != nil {
			in.deliver(streamEvent{kind: eventHeaders, headers: headers})
		}
		return
	}
	if ep.stream(streamID) != nil {
		frame, _ := statusFrame(FrameRst, streamID,
			NewStatus(CodeInternal, "HEADERS for stream already in use"))
		_ = ep.SendFrame(frame)
		return
	}
	if ep.dispatcher == nil {
		frame, _ := statusFrame(FrameTrailers, streamID,
			NewStatus(CodeUnimplemented, "unknown method "+*headers.Path))
		_ = ep.SendFrame(frame)
		return
	}
	in := newStreamInput()
	ep.streams.Store(streamID, in)
	sink := &responseSink{ep: ep, id: streamID}
	go func() {
		defer ep.streams.Delete(streamID)
		// No eager HEADERS: initial metadata flushes lazily via
		// the sink (first DATA, or here on a DATA-less success)
		// so handlers can SetHeader first. Errors end
		// trailers-only, as gRPC allows.
		ctx := context.WithValue(context.Background(), metadataKey{}, headers.Metadata)
		if d, ok := ParseTimeout(headers.Metadata["grpc-timeout"]); ok {
			var cancel context.CancelFunc
			ctx, cancel = context.WithTimeout(ctx, d)
			defer cancel()
		}
		status := ep.dispatcher(ctx, headers, in, sink)
		if status == nil {
			status = NewStatus(CodeOk, "")
			_ = sink.FlushHeaders()
		}
		_ = sink.sendTrailers(status)
	}()
}

// SendTrailersOK is used by the server dispatch wrapper after a
// handler completes; exported for the generated code path in server.go.
func (s *responseSink) SendTrailers(status *StatusError) error {
	return s.sendTrailers(status)
}
GRPC_RUNTIME_EOF
)

(define go-channel-body
#<<GRPC_RUNTIME_EOF
package grpcdc

import (
	"context"
	"errors"
	"io"
	"sync"
	"time"
)

type metadataKey struct{}

// MetadataFromContext returns call metadata sent in HEADERS.
func MetadataFromContext(ctx context.Context) map[string]string {
	if md, ok := ctx.Value(metadataKey{}).(map[string]string); ok {
		return md
	}
	return map[string]string{}
}

// Channel is the client side of one Endpoint.
type Channel struct {
	ep *Endpoint
}

// NewChannel wraps a transport, allocating odd stream ids.
func NewChannel(t Transport) *Channel {
	return NewChannelOnEndpoint(NewEndpoint(t, true))
}

// NewChannelOnEndpoint wraps an existing endpoint (bidirectional
// use; starts its read loop).
func NewChannelOnEndpoint(ep *Endpoint) *Channel {
	ep.Start()
	return &Channel{ep: ep}
}

// Endpoint returns the underlying endpoint.
func (ch *Channel) Endpoint() *Endpoint { return ch.ep }

// ClientStream receives response messages of one call.
type ClientStream struct {
	ep         *Endpoint
	id         uint32
	in         *streamInput
	header     Headers
	gotHdr     bool
	trailer    map[string]string
	ctx        context.Context
	traceCtx   *traceContext
	tracePath  string
	traceEnded bool
	done       chan struct{}
	finishOnce sync.Once
}

// finish marks the call terminated (trailers, RST, cancel, or
// channel close) and releases the context watcher goroutine.
func (s *ClientStream) finish() {
	s.finishOnce.Do(func() {
		if s.done != nil {
			close(s.done)
		}
	})
}

// Header returns the response initial metadata (nil until the
// response HEADERS arrive).
func (s *ClientStream) Header() map[string]string {
	if !s.gotHdr {
		return nil
	}
	return s.header.Metadata
}

// Trailer returns the response trailing metadata (nil until
// the call's terminal status arrives).
func (s *ClientStream) Trailer() map[string]string {
	return s.trailer
}

func (s *ClientStream) endTrace(status string) {
	if !s.traceEnded {
		s.traceEnded = true
		traceEnd("client", s.tracePath, s.traceCtx, status)
	}
}

// Recv decodes the next response into resp. io.EOF means the call
// completed OK; a *StatusError reports the trailers status.
func (s *ClientStream) Recv(resp Unmarshaler) error {
	for {
		var ev streamEvent
		var ok bool
		if s.ctx != nil {
			select {
			case ev, ok = <-s.in.events:
			case <-s.ctx.Done():
				s.finish()
				s.ep.cancelStream(s.id)
				if errors.Is(s.ctx.Err(), context.DeadlineExceeded) {
					return NewStatus(CodeDeadlineExceeded, "deadline exceeded")
				}
				return NewStatus(CodeCancelled, "call cancelled")
			}
		} else {
			ev, ok = <-s.in.events
		}
		if !ok {
			s.finish()
			return NewStatus(CodeUnavailable, "data channel closed")
		}
		switch ev.kind {
		case eventHeaders:
			s.header, s.gotHdr = ev.headers, true
		case eventData:
			return resp.UnmarshalDC(ev.payload)
		case eventTrailers:
			s.trailer = ev.status.Trailers
			s.endTrace(ev.status.Code.Name())
			s.finish()
			if ev.status.Code != CodeOk {
				return ev.status
			}
			return io.EOF
		case eventRST:
			s.trailer = ev.status.Trailers
			s.endTrace(ev.status.Code.Name())
			s.finish()
			return ev.status
		}
	}
}

func (ch *Channel) open(ctx context.Context, path string, metadata map[string]string) (*ClientStream, error) {
	var traceCtx *traceContext
	_, hasDeadline := ctx.Deadline()
	if hasDeadline || getTracer() != nil {
		merged := make(map[string]string, len(metadata)+2)
		for k, v := range metadata {
			merged[k] = v
		}
		if hasDeadline {
			deadline, _ := ctx.Deadline()
			merged["grpc-timeout"] = EncodeTimeout(time.Until(deadline))
		}
		if getTracer() != nil {
			parent := ParseTraceparent(metadata["traceparent"])
			if parent == nil {
				parent = traceParentOf(TraceContextFromContext(ctx))
			}
			traceCtx = traceStart("client", path, parent)
			if traceCtx != nil {
				merged["traceparent"] = FormatTraceparent(traceCtx.TraceID, traceCtx.SpanID, traceCtx.Sampled)
			}
		}
		metadata = merged
	}
	id, in := ch.ep.openStream()
	frame, err := headersFrame(id, &path, metadata)
	if err == nil {
		err = ch.ep.SendFrame(frame)
	}
	if err != nil {
		ch.ep.closeStream(id)
		traceEnd("client", path, traceCtx, "UNAVAILABLE")
		return nil, err
	}
	stream := &ClientStream{ep: ch.ep, id: id, in: in, ctx: ctx, traceCtx: traceCtx, tracePath: path, done: make(chan struct{})}
	// Context cancellation must reach the peer even when no
	// Recv is in flight (grpc-go semantics): watch Done for the
	// life of the call and RST the stream when it fires.
	if ctx != nil {
		if ctxDone := ctx.Done(); ctxDone != nil {
			go func() {
				select {
				case <-ctxDone:
					stream.Cancel()
				case <-stream.done:
				}
			}()
		}
	}
	return stream, nil
}

// Cancel aborts the call: RST towards the peer; a pending Recv
// returns CodeCancelled (or CodeDeadlineExceeded when the abort
// came from the context deadline).
func (s *ClientStream) Cancel() {
	s.finish()
	s.ep.cancelStream(s.id)
}

func (ch *Channel) sendMessage(stream *ClientStream, msg Marshaler) error {
	frame, err := EncodeFrame(FrameData, stream.id, msg.MarshalDC())
	if err != nil {
		return err
	}
	return ch.ep.SendFrame(frame)
}

func (ch *Channel) halfClose(stream *ClientStream) error {
	frame, err := EncodeFrame(FrameHalfClose, stream.id, nil)
	if err != nil {
		return err
	}
	return ch.ep.SendFrame(frame)
}

// Unary runs a unary call, decoding the single response into resp.
func (ch *Channel) Unary(ctx context.Context, path string, req Marshaler, resp Unmarshaler) error {
	return ch.UnaryWithMetadata(ctx, path, req, resp, nil)
}

// UnaryStream starts a unary call and returns its stream, for
// callers that need the response headers/trailers (Header and
// Trailer on the returned stream). The request is sent and the
// stream half-closed before returning; read with Recv.
func (ch *Channel) UnaryStream(ctx context.Context, path string, req Marshaler, metadata map[string]string) (*ClientStream, error) {
	stream, err := ch.open(ctx, path, metadata)
	if err != nil {
		return nil, err
	}
	if err := ch.sendMessage(stream, req); err != nil {
		ch.ep.closeStream(stream.id)
		return nil, err
	}
	if err := ch.halfClose(stream); err != nil {
		ch.ep.closeStream(stream.id)
		return nil, err
	}
	return stream, nil
}

// UnaryWithMetadata is Unary with call metadata.
func (ch *Channel) UnaryWithMetadata(ctx context.Context, path string, req Marshaler, resp Unmarshaler, metadata map[string]string) error {
	stream, err := ch.open(ctx, path, metadata)
	if err != nil {
		return err
	}
	defer ch.ep.closeStream(stream.id)
	if err := ch.sendMessage(stream, req); err != nil {
		return err
	}
	if err := ch.halfClose(stream); err != nil {
		return err
	}
	got := false
	for {
		err := stream.Recv(resp)
		if err == io.EOF {
			if !got {
				return NewStatus(CodeInternal, "call closed with no response")
			}
			return nil
		}
		if err != nil {
			return err
		}
		if got {
			return NewStatus(CodeInternal, "unary call received more than one response")
		}
		got = true
	}
}

// ServerStream starts a server-streaming call.
func (ch *Channel) ServerStream(ctx context.Context, path string, req Marshaler) (*ClientStream, error) {
	return ch.ServerStreamWithMetadata(ctx, path, req, nil)
}

// ServerStreamWithMetadata is ServerStream with call metadata.
func (ch *Channel) ServerStreamWithMetadata(ctx context.Context, path string, req Marshaler, metadata map[string]string) (*ClientStream, error) {
	stream, err := ch.open(ctx, path, metadata)
	if err != nil {
		return nil, err
	}
	if err := ch.sendMessage(stream, req); err != nil {
		return nil, err
	}
	if err := ch.halfClose(stream); err != nil {
		return nil, err
	}
	return stream, nil
}

func (ch *Channel) sendAll(stream *ClientStream, reqs []Marshaler) error {
	for _, req := range reqs {
		if err := ch.sendMessage(stream, req); err != nil {
			return err
		}
	}
	return ch.halfClose(stream)
}

// ClientStreamCall sends all requests, then decodes the one response.
func (ch *Channel) ClientStreamCall(ctx context.Context, path string, reqs []Marshaler, resp Unmarshaler) error {
	return ch.ClientStreamCallWithMetadata(ctx, path, reqs, resp, nil)
}

// ClientStreamCallWithMetadata is ClientStreamCall with call metadata.
func (ch *Channel) ClientStreamCallWithMetadata(ctx context.Context, path string, reqs []Marshaler, resp Unmarshaler, metadata map[string]string) error {
	stream, err := ch.open(ctx, path, metadata)
	if err != nil {
		return err
	}
	defer ch.ep.closeStream(stream.id)
	if err := ch.sendAll(stream, reqs); err != nil {
		return err
	}
	got := false
	for {
		err := stream.Recv(resp)
		if err == io.EOF {
			if !got {
				return NewStatus(CodeInternal, "call closed with no response")
			}
			return nil
		}
		if err != nil {
			return err
		}
		if got {
			return NewStatus(CodeInternal, "client-streaming call received more than one response")
		}
		got = true
	}
}

// Bidi starts a bidirectional call with all requests sent up front.
func (ch *Channel) Bidi(ctx context.Context, path string, reqs []Marshaler) (*ClientStream, error) {
	return ch.BidiWithMetadata(ctx, path, reqs, nil)
}

// BidiWithMetadata is Bidi with call metadata.
func (ch *Channel) BidiWithMetadata(ctx context.Context, path string, reqs []Marshaler, metadata map[string]string) (*ClientStream, error) {
	stream, err := ch.open(ctx, path, metadata)
	if err != nil {
		return nil, err
	}
	if err := ch.sendAll(stream, reqs); err != nil {
		return nil, err
	}
	return stream, nil
}
GRPC_RUNTIME_EOF
)

(define go-server-body
#<<GRPC_RUNTIME_EOF
package grpcdc

import (
	"context"
	"io"
)

// Method kinds (values match the grpc-dc specification's streaming-kind names).
const (
	KindUnary           = "unary"
	KindServerStreaming = "server-streaming"
	KindClientStreaming = "client-streaming"
	KindBidi            = "bidi"
)

// RequestStream reads request messages of one inbound call.
type RequestStream struct {
	in *streamInput
}

// RecvRaw returns the next request payload; io.EOF at half-close.
func (s *RequestStream) RecvRaw() ([]byte, error) {
	for {
		ev, ok := <-s.in.events
		if !ok {
			return nil, NewStatus(CodeUnavailable, "data channel closed")
		}
		switch ev.kind {
		case eventData:
			return ev.payload, nil
		case eventHalfClose:
			return nil, io.EOF
		case eventTrailers, eventRST:
			return nil, ev.status
		}
	}
}

// RecvInto decodes the next request message into req.
func (s *RequestStream) RecvInto(req Unmarshaler) error {
	payload, err := s.RecvRaw()
	if err != nil {
		return err
	}
	return req.UnmarshalDC(payload)
}

// ServerSink sends response payloads of one inbound call.
type ServerSink interface {
	Send(payload []byte) error
}

type sinkAdapter struct{ sink *responseSink }

func (a sinkAdapter) Send(payload []byte) error { return a.sink.SendData(payload) }

// MethodHandler implements one method against raw payloads; the
// generated stubs adapt it to typed handlers.
type MethodHandler func(ctx context.Context, req *RequestStream, sink ServerSink) error

// Method is one entry of a ServiceDesc.
type Method struct {
	Name    string
	Path    string
	Kind    string
	Handler MethodHandler
}

// ServiceDesc describes a service for Server.RegisterService.
type ServiceDesc struct {
	Name    string
	Methods []Method
}

// Server dispatches inbound calls to registered methods.
type Server struct {
	methods map[string]Method
	auth    *RendezvousAuth
}

// NewServer builds an empty server.
func NewServer() *Server {
	return &Server{methods: map[string]Method{}}
}

// RegisterService adds a service's methods (generated code calls it).
func (s *Server) RegisterService(desc ServiceDesc) {
	for _, m := range desc.Methods {
		s.methods[m.Path] = m
	}
}

// ServeTransport attaches the server to a transport (even stream ids).
func (s *Server) ServeTransport(t Transport) *Endpoint {
	ep := NewEndpoint(t, false)
	s.ServeEndpoint(ep)
	return ep
}

// ServeEndpoint attaches the server to an existing endpoint (and
// starts its read loop).
func (s *Server) ServeEndpoint(ep *Endpoint) {
	ep.SetDispatcher(s.dispatch)
	ep.Start()
}

// SetRendezvousAuth requires a rendezvous bearer token on
// every call (installed by ServeRendezvousWithAuth): a bad,
// missing or expired token fails UNAUTHENTICATED, a valid but
// under-scoped token fails PERMISSION_DENIED, and verified
// claims are exposed via ClaimsFromContext. Rendezvous-only
// by design: no protoc plugin option.
func (s *Server) SetRendezvousAuth(auth *RendezvousAuth) {
	s.auth = auth
}

type callStateKey struct{}

type claimsKey struct{}

// ClaimsFromContext returns the verified rendezvous claims
// for the call, or nil when the call was not authenticated.
func ClaimsFromContext(ctx context.Context) *RendezvousClaims {
	if claims, ok := ctx.Value(claimsKey{}).(*RendezvousClaims); ok {
		return claims
	}
	return nil
}

// SetHeader records response initial metadata for the call in
// ctx (sent lazily, before the first response message). Safe
// to call from a handler; a no-op outside a served call.
func SetHeader(ctx context.Context, md map[string]string) {
	if sink, ok := ctx.Value(callStateKey{}).(*responseSink); ok && sink != nil {
		if sink.respHeaders == nil {
			sink.respHeaders = map[string]string{}
		}
		for k, v := range md {
			sink.respHeaders[k] = v
		}
	}
}

// SetTrailer records response trailing metadata for the call
// in ctx (rides the terminal status frame). Safe to call from
// a handler; a no-op outside a served call.
func SetTrailer(ctx context.Context, md map[string]string) {
	if sink, ok := ctx.Value(callStateKey{}).(*responseSink); ok && sink != nil {
		if sink.respTrailers == nil {
			sink.respTrailers = map[string]string{}
		}
		for k, v := range md {
			sink.respTrailers[k] = v
		}
	}
}

func (s *Server) dispatch(ctx context.Context, headers Headers, in *streamInput, sink *responseSink) *StatusError {
	method, ok := s.methods[*headers.Path]
	if !ok {
		return NewStatus(CodeUnimplemented, "unknown method "+*headers.Path)
	}
	if s.auth != nil {
		claims, st := s.auth.verify(headers.Metadata)
		if st != nil {
			return st
		}
		if st := s.auth.checkScopes(*headers.Path, claims); st != nil {
			return st
		}
		ctx = context.WithValue(ctx, claimsKey{}, claims)
	}
	ctx = context.WithValue(ctx, callStateKey{}, sink)
	traceCtx := traceStart("server", *headers.Path, ParseTraceparent(headers.Metadata["traceparent"]))
	ctx = ContextWithTraceContext(ctx, traceCtx)
	err := method.Handler(ctx, &RequestStream{in: in}, sinkAdapter{sink: sink})
	status := "OK"
	if err != nil {
		status = Status(err).Code.Name()
	}
	traceEnd("server", *headers.Path, traceCtx, status)
	if err != nil {
		return Status(err)
	}
	return nil
}
GRPC_RUNTIME_EOF
)

(define go-loopback-body
#<<GRPC_RUNTIME_EOF
package grpcdc

import (
	"io"
	"sync"
)

type memoryTransport struct {
	in     chan []byte
	out    chan []byte
	closed chan struct{}
	once   sync.Once
}

func (t *memoryTransport) Send(data []byte) error {
	select {
	case <-t.closed:
		return NewStatus(CodeUnavailable, "data channel is not open")
	default:
	}
	cp := make([]byte, len(data))
	copy(cp, data)
	t.out <- cp
	return nil
}

func (t *memoryTransport) Recv() ([]byte, error) {
	select {
	case data := <-t.in:
		return data, nil
	case <-t.closed:
		return nil, io.EOF
	}
}

func (t *memoryTransport) Close() error {
	t.once.Do(func() { close(t.closed) })
	return nil
}

// MemoryTransportPair returns two connected in-memory transports for
// tests and demos: message boundaries preserved, ordered, reliable —
// the same contract a real RTCDataChannel offers.
func MemoryTransportPair() (Transport, Transport) {
	ab := make(chan []byte, 1024)
	ba := make(chan []byte, 1024)
	a := &memoryTransport{in: ba, out: ab, closed: make(chan struct{})}
	b := &memoryTransport{in: ab, out: ba, closed: make(chan struct{})}
	// Closing either side ends both receive loops.
	go func() { <-a.closed; b.Close() }()
	return a, b
}
GRPC_RUNTIME_EOF
)

(define go-sidecar-body
#<<GRPC_RUNTIME_EOF
package grpcdc

// Transport over the Rust WebRTC-Direct sidecar: the sidecar
// owns DTLS/SCTP/TURN and bridges one datachannel to a local
// TCP socket using u32 big-endian length-prefixed messages
// (one prefix per DataChannel message). Stdlib only; see
// grpcdc.SidecarTransport in the Python runtime for the same
// framing in another language.

import (
	"encoding/binary"
	"io"
	"net"
)

// SidecarTransport is one length-prefixed TCP connection to a
// direct_sidecar process.
type SidecarTransport struct {
	conn net.Conn
}

// NewSidecarTransport wraps an established TCP connection.
func NewSidecarTransport(conn net.Conn) *SidecarTransport {
	return &SidecarTransport{conn: conn}
}

// DialSidecar connects to a direct_sidecar at addr ("host:port").
func DialSidecar(addr string) (*SidecarTransport, error) {
	conn, err := net.Dial("tcp", addr)
	if err != nil {
		return nil, err
	}
	return &SidecarTransport{conn: conn}, nil
}

// Send sends one frame as one length-prefixed message.
func (t *SidecarTransport) Send(data []byte) error {
	var header [4]byte
	binary.BigEndian.PutUint32(header[:], uint32(len(data)))
	if _, err := t.conn.Write(header[:]); err != nil {
		return err
	}
	_, err := t.conn.Write(data)
	return err
}

// Recv returns the next length-prefixed message.
func (t *SidecarTransport) Recv() ([]byte, error) {
	var header [4]byte
	if _, err := io.ReadFull(t.conn, header[:]); err != nil {
		return nil, err
	}
	payload := make([]byte, binary.BigEndian.Uint32(header[:]))
	if _, err := io.ReadFull(t.conn, payload); err != nil {
		return nil, err
	}
	return payload, nil
}

// Close closes the connection.
func (t *SidecarTransport) Close() error { return t.conn.Close() }
GRPC_RUNTIME_EOF
)

;; Frame dispatch: switch arms are expanded from spec.rkt's frame
;; table, one arm per table entry; the arm bodies are the per-language
;; handlers for each frame name.
(define (go-frame-const sym)
  (define parts (string-split (symbol->string sym) "-"))
  (apply string-append
         (for/list ([p (in-list parts)])
           (string-append (string (char-upcase (string-ref p 0)))
                          (string-downcase (substring p 1))))))

(define go-dispatch-arms
  '((HEADERS    . "ep.onHeaders(streamID, payload)")
    (DATA       . "ep.pushEvent(streamID, streamEvent{kind: eventData, payload: payload})")
    (HALF-CLOSE . "ep.pushEvent(streamID, streamEvent{kind: eventHalfClose})")
    (TRAILERS   . "ep.onTerminal(streamID, payload, eventTrailers)")
    (RST        . "ep.onTerminal(streamID, payload, eventRST)")))

(define (emit-go-dispatch)
  (string-append
   "\tswitch frameType {\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (define arm (assoc (first e) go-dispatch-arms))
            (unless arm (error 'runtime-go "no Go dispatch arm for ~a" (first e)))
            (format "\tcase Frame~a:\n\t\t~a\n" (go-frame-const (first e)) (cdr arm))))
   "\tdefault:\n\t\t// Unknown frame type: ignore for forward compatibility.\n\t}"))

(define go-http-signaling-body
#<<GRPC_RUNTIME_EOF
package grpcdc

// HTTP/POST signaling server for browser clients: the server
// half of the browser signaling contract (js/src/signaling.js).
// Each POST creates a fresh Peer from the WebRTC stack, answers
// the offer, returns the answer JSON immediately, then connects
// in the background and serves the browser's "grpc" DataChannel
// with the given Server. Non-trickle: the answer carries the
// peer's host candidates as created; configure PeerOptions
// (LocalIPs / StunServers / TurnServers) when those candidates
// are not reachable as-is. Auth and CORS belong to the host
// application: mount HttpSignalingHandler behind them, or use
// ServeHttpSignaling for the standalone no-auth shape.
//
// Contract:
//   POST /grpc-dc/signal  {"type":"offer","sdp":"v=0\r\n..."}
//   200                   {"type":"answer","sdp":"v=0\r\n..."}

import (
	"crypto/rand"
	"encoding/hex"
	"encoding/json"
	"io"
	"net"
	"net/http"
	"strconv"
	"sync"

	dcwebrtc "github.com/browser-grpc/grpc-over-datachannels/webrtc/go"
)

// DefaultSignalingPath is the default HTTP/POST signaling path.
const DefaultSignalingPath = "/grpc-dc/signal"

const maxSignalingBody = 1 << 20

// HttpSignalingOptions configures HttpSignalingHandler.
type HttpSignalingOptions struct {
	// Path is the signaling path; empty selects /grpc-dc/signal.
	Path string
	// PeerOptions configures each WebRTC peer created per POST.
	PeerOptions dcwebrtc.PeerOptions
	// Mux is the shared PeerMux every session peer is created
	// on (one UDP socket per process). When nil, the handler
	// binds its own mux at MuxAddr on first use; a supplied mux
	// stays caller-owned.
	Mux *dcwebrtc.PeerMux
	// MuxAddr is the bind address for the handler-owned mux;
	// nil selects 0.0.0.0:0. Ignored when Mux is set.
	MuxAddr *net.UDPAddr
	// OnError, when set, receives background connect failures.
	OnError func(error)
}

type signalingMessage struct {
	Type      string `json:"type"`
	SDP       string `json:"sdp"`
	Session   string `json:"session,omitempty"`
	Candidate string `json:"candidate,omitempty"`
}

type signalingError struct {
	Error string `json:"error"`
}

func writeSignalingJSON(w http.ResponseWriter, status int, value any) {
	body, err := json.Marshal(value)
	if err != nil {
		status = http.StatusInternalServerError
		body = []byte(`{"error":"encode failed"}`)
	}
	w.Header().Set("Content-Type", "application/json")
	w.Header().Set("Content-Length", strconv.Itoa(len(body)))
	w.WriteHeader(status)
	_, _ = w.Write(body)
}

type httpSignalingCore struct {
	srv     *Server
	options HttpSignalingOptions
	muxOnce sync.Once
	mux     *dcwebrtc.PeerMux
	muxErr  error

	sessionsMu sync.Mutex
	sessions   map[string]*dcwebrtc.Peer
}

func (c *httpSignalingCore) addSession(peer *dcwebrtc.Peer) string {
	var raw [16]byte
	if _, err := rand.Read(raw[:]); err != nil {
		return ""
	}
	session := hex.EncodeToString(raw[:])
	c.sessionsMu.Lock()
	if c.sessions == nil {
		c.sessions = make(map[string]*dcwebrtc.Peer)
	}
	c.sessions[session] = peer
	c.sessionsMu.Unlock()
	return session
}

func (c *httpSignalingCore) sessionPeer(session string) *dcwebrtc.Peer {
	c.sessionsMu.Lock()
	defer c.sessionsMu.Unlock()
	return c.sessions[session]
}

func (c *httpSignalingCore) deleteSession(session string) {
	c.sessionsMu.Lock()
	delete(c.sessions, session)
	c.sessionsMu.Unlock()
}

func (c *httpSignalingCore) getMux() (*dcwebrtc.PeerMux, error) {
	if c.options.Mux != nil {
		return c.options.Mux, nil
	}
	c.muxOnce.Do(func() {
		addr := c.options.MuxAddr
		if addr == nil {
			addr = &net.UDPAddr{IP: net.IPv4zero, Port: 0}
		}
		c.mux, c.muxErr = dcwebrtc.NewPeerMux(addr)
	})
	return c.mux, c.muxErr
}

func (c *httpSignalingCore) handler() http.HandlerFunc {
	srv := c.srv
	options := c.options
	path := options.Path
	if path == "" {
		path = DefaultSignalingPath
	}
	onError := options.OnError
	if onError == nil {
		onError = func(error) {}
	}
	return func(w http.ResponseWriter, r *http.Request) {
		isSignal := r.URL.Path == path
		isCandidate := r.URL.Path == path+"/candidate"
		isRestart := r.URL.Path == path+"/restart"
		if !isSignal && !isCandidate && !isRestart {
			writeSignalingJSON(w, http.StatusNotFound, signalingError{Error: "not found"})
			return
		}
		if r.Method != http.MethodPost {
			writeSignalingJSON(w, http.StatusMethodNotAllowed, signalingError{Error: "method not allowed"})
			return
		}
		var offer signalingMessage
		decoder := json.NewDecoder(io.LimitReader(r.Body, maxSignalingBody))
		if err := decoder.Decode(&offer); err != nil {
			writeSignalingJSON(w, http.StatusBadRequest, signalingError{Error: "expected JSON signaling body"})
			return
		}
		if isCandidate || isRestart {
			sessionPeer := c.sessionPeer(offer.Session)
			if sessionPeer == nil {
				writeSignalingJSON(w, http.StatusNotFound, signalingError{Error: "unknown session"})
				return
			}
			if isCandidate {
				sessionPeer.AddRemoteCandidate(offer.Candidate)
				writeSignalingJSON(w, http.StatusOK, map[string]bool{"ok": true})
				return
			}
			if offer.Type != "offer" || offer.SDP == "" {
				writeSignalingJSON(w, http.StatusBadRequest, signalingError{Error: "expected {\"session\",\"type\":\"offer\",\"sdp\":...}"})
				return
			}
			restartAnswer, err := sessionPeer.HandleRestartOffer(offer.SDP)
			if err != nil {
				writeSignalingJSON(w, http.StatusBadRequest, signalingError{Error: "invalid restart offer SDP"})
				return
			}
			writeSignalingJSON(w, http.StatusOK, signalingMessage{Type: "answer", SDP: restartAnswer, Session: offer.Session})
			return
		}
		if offer.Type != "offer" || offer.SDP == "" {
			writeSignalingJSON(w, http.StatusBadRequest, signalingError{Error: "expected {\"type\":\"offer\",\"sdp\":...}"})
			return
		}
		mux, err := c.getMux()
		if err != nil {
			writeSignalingJSON(w, http.StatusInternalServerError, signalingError{Error: "peer creation failed"})
			return
		}
		peer, err := mux.NewPeer(options.PeerOptions)
		if err != nil {
			writeSignalingJSON(w, http.StatusInternalServerError, signalingError{Error: "peer creation failed"})
			return
		}
		answer, err := peer.HandleOffer(offer.SDP)
		if err != nil {
			peer.Close()
			writeSignalingJSON(w, http.StatusBadRequest, signalingError{Error: "invalid offer SDP"})
			return
		}
		session := c.addSession(peer)
		writeSignalingJSON(w, http.StatusOK, signalingMessage{Type: "answer", SDP: answer, Session: session})
		go func() {
			endpoint, err := peer.Connect()
			if err != nil {
				onError(err)
				c.deleteSession(session)
				peer.Close()
				return
			}
			endpoint.SetOnChannel(func(channel *dcwebrtc.DataChannel) {
				if channel.Label == "grpc" || channel.Label == "" {
					srv.ServeTransport(NewDcTransport(channel))
					// One signaling POST owns one peer: when its
					// grpc channel closes, tear the peer down
					// with it instead of leaking it per request.
					channel.OnClose(func() {
						c.deleteSession(session)
						peer.Close()
					})
				}
			})
		}()
	}
}

// HttpSignalingHandler answers browser signaling POSTs and
// serves each resulting "grpc" DataChannel with srv. Every
// session peer is created on one shared PeerMux (see
// HttpSignalingOptions.Mux). Mount it on any net/http mux;
// paths other than the signaling path get a 404 and non-POST
// methods a 405.
func HttpSignalingHandler(srv *Server, options HttpSignalingOptions) http.HandlerFunc {
	core := &httpSignalingCore{srv: srv, options: options}
	return core.handler()
}

// HttpSignalingServer is a signaling handler plus the shared
// PeerMux its session peers are created on, so hosts can
// share one mux across several signaling servers in a process
// and close it on shutdown.
type HttpSignalingServer struct {
	Handler http.Handler
	Mux     *dcwebrtc.PeerMux
	ownsMux bool
}

// NewHttpSignalingServer builds a signaling handler and binds
// (or adopts, via options.Mux) its shared PeerMux eagerly.
func NewHttpSignalingServer(srv *Server, options HttpSignalingOptions) (*HttpSignalingServer, error) {
	core := &httpSignalingCore{srv: srv, options: options}
	mux, err := core.getMux()
	if err != nil {
		return nil, err
	}
	return &HttpSignalingServer{
		Handler: core.handler(),
		Mux:     mux,
		ownsMux: options.Mux == nil,
	}, nil
}

// Close closes the shared mux when this server bound it; a
// caller-supplied mux (options.Mux) stays caller-owned.
func (s *HttpSignalingServer) Close() error {
	if s.ownsMux && s.Mux != nil {
		return s.Mux.Close()
	}
	return nil
}

// ServeHttpSignaling starts a standalone signaling HTTP server
// on addr (for example "127.0.0.1:8080") and returns it; call
// Shutdown to stop. Host applications that need auth/CORS
// should mount HttpSignalingHandler on their own server.
func ServeHttpSignaling(addr string, srv *Server, options HttpSignalingOptions) (*http.Server, error) {
	listener, err := net.Listen("tcp", addr)
	if err != nil {
		return nil, err
	}
	server := &http.Server{Addr: listener.Addr().String(), Handler: HttpSignalingHandler(srv, options)}
	go func() { _ = server.Serve(listener) }()
	return server, nil
}
GRPC_RUNTIME_EOF
)

(define go-rendezvous-body
#<<GRPC_RUNTIME_EOF
package grpcdc

// Rendezvous server: one fixed, pre-published WebRTC endpoint
// browsers dial with no signaling exchange. Wraps the WebRTC
// stack's RendezvousListener: one UDP socket, fixed ICE
// credentials and DTLS certificate. Publish the returned
// listener's Descriptor(host) wherever browsers can find it;
// serve HTTP signaling instead when the server address cannot
// be fixed in advance.

import (
	"crypto/hmac"
	"crypto/sha256"
	"crypto/subtle"
	"encoding/base64"
	"errors"
	"net"
	"strings"
	"time"

	dcwebrtc "github.com/browser-grpc/grpc-over-datachannels/webrtc/go"
)

// RendezvousDescriptor is the publishable description of a
// rendezvous endpoint (the same shape the generated browser
// rendezvousChannel consumes).
type RendezvousDescriptor = dcwebrtc.RendezvousDescriptor

// ServeRendezvous serves srv to rendezvous browsers on addr
// (nil selects 0.0.0.0:0) and returns the listener: publish
// listener.Descriptor(host) and call listener.Close() on
// shutdown. Fix options' IceUfrag/IcePwd/Certificate and the
// descriptor stays stable across restarts; ephemeral values
// rotate per process.
func ServeRendezvous(srv *Server, addr *net.UDPAddr, options dcwebrtc.RendezvousOptions) (*dcwebrtc.RendezvousListener, error) {
	options.OnChannel = func(channel *dcwebrtc.DataChannel, peer *dcwebrtc.Peer) {
		if channel.Label == "grpc" || channel.Label == "" {
			srv.ServeTransport(NewDcTransport(channel))
			channel.OnClose(func() { peer.Close() })
		}
	}
	return dcwebrtc.ListenRendezvous(addr, options)
}

// ServeRendezvousWithAuth is ServeRendezvous with rendezvous
// bearer auth required on every call (see RendezvousAuth):
// srv.SetRendezvousAuth(auth) plus the same listener wiring.
func ServeRendezvousWithAuth(srv *Server, addr *net.UDPAddr, options dcwebrtc.RendezvousOptions, auth *RendezvousAuth) (*dcwebrtc.RendezvousListener, error) {
	srv.SetRendezvousAuth(auth)
	return ServeRendezvous(srv, addr, options)
}

// ---------------------------------------------------------------------------
// Rendezvous auth tokens: base64url(protobuf claims) + "." +
// base64url(HMAC-SHA256(secret, claims)). Claims wire layout
// (protobuf, no schema dependency): 1 Sub, 2 Iss, 3 Aud
// (strings); 4 Exp, 5 Nbf, 6 Iat (varint seconds); 7 Scopes
// (repeated string); 8 Jti (string). The same layout is
// implemented in the JS and Rust rendezvous code, so one token
// verifies on every stack. Rendezvous-only by design: no
// protoc plugin option.

// RendezvousClaims is the payload of a rendezvous token.
type RendezvousClaims struct {
	Sub    string
	Iss    string
	Aud    string
	Exp    int64
	Nbf    int64
	Iat    int64
	Scopes []string
	Jti    string
}

// RendezvousAuth configures bearer-token verification:
// Secret is the HMAC key; Issuer/Audience, when set, must
// match the token's iss/aud; Scopes maps a method path to the
// scopes it requires (no entry = any authenticated caller);
// Now overrides the clock (tests).
type RendezvousAuth struct {
	Secret   []byte
	Issuer   string
	Audience string
	Scopes   map[string][]string
	Now      func() time.Time
}

func (a *RendezvousAuth) now() time.Time {
	if a.Now != nil {
		return a.Now()
	}
	return time.Now()
}

func appendRendezvousVarint(out []byte, v uint64) []byte {
	for v >= 0x80 {
		out = append(out, byte(v)|0x80)
		v >>= 7
	}
	return append(out, byte(v))
}

func appendRendezvousLenField(out []byte, field uint64, payload []byte) []byte {
	out = appendRendezvousVarint(out, field<<3|2)
	out = appendRendezvousVarint(out, uint64(len(payload)))
	return append(out, payload...)
}

func appendRendezvousVarintField(out []byte, field uint64, v int64) []byte {
	out = appendRendezvousVarint(out, field<<3|0)
	return appendRendezvousVarint(out, uint64(v))
}

// EncodeRendezvousClaims serializes claims to protobuf wire bytes.
func EncodeRendezvousClaims(c *RendezvousClaims) []byte {
	var out []byte
	if c.Sub != "" {
		out = appendRendezvousLenField(out, 1, []byte(c.Sub))
	}
	if c.Iss != "" {
		out = appendRendezvousLenField(out, 2, []byte(c.Iss))
	}
	if c.Aud != "" {
		out = appendRendezvousLenField(out, 3, []byte(c.Aud))
	}
	if c.Exp != 0 {
		out = appendRendezvousVarintField(out, 4, c.Exp)
	}
	if c.Nbf != 0 {
		out = appendRendezvousVarintField(out, 5, c.Nbf)
	}
	if c.Iat != 0 {
		out = appendRendezvousVarintField(out, 6, c.Iat)
	}
	for _, scope := range c.Scopes {
		out = appendRendezvousLenField(out, 7, []byte(scope))
	}
	if c.Jti != "" {
		out = appendRendezvousLenField(out, 8, []byte(c.Jti))
	}
	return out
}

// DecodeRendezvousClaims parses claims from protobuf wire bytes.
func DecodeRendezvousClaims(data []byte) (*RendezvousClaims, error) {
	claims := &RendezvousClaims{}
	pos := 0
	readVarint := func() (uint64, error) {
		var v uint64
		var shift uint
		for {
			if pos >= len(data) {
				return 0, errors.New("truncated varint")
			}
			b := data[pos]
			pos++
			v |= uint64(b&0x7f) << shift
			if b&0x80 == 0 {
				return v, nil
			}
			shift += 7
		}
	}
	for pos < len(data) {
		tag, err := readVarint()
		if err != nil {
			return nil, err
		}
		field := tag >> 3
		wire := tag & 7
		switch wire {
		case 2:
			length, err := readVarint()
			if err != nil {
				return nil, err
			}
			if pos+int(length) > len(data) {
				return nil, errors.New("truncated length-delimited field")
			}
			slice := data[pos : pos+int(length)]
			pos += int(length)
			switch field {
			case 1:
				claims.Sub = string(slice)
			case 2:
				claims.Iss = string(slice)
			case 3:
				claims.Aud = string(slice)
			case 7:
				claims.Scopes = append(claims.Scopes, string(slice))
			case 8:
				claims.Jti = string(slice)
			}
		case 0:
			v, err := readVarint()
			if err != nil {
				return nil, err
			}
			switch field {
			case 4:
				claims.Exp = int64(v)
			case 5:
				claims.Nbf = int64(v)
			case 6:
				claims.Iat = int64(v)
			}
		default:
			return nil, errors.New("unsupported wire type")
		}
	}
	return claims, nil
}

func rendezvousMAC(secret, body []byte) []byte {
	mac := hmac.New(sha256.New, secret)
	mac.Write(body)
	return mac.Sum(nil)
}

// IssueRendezvousToken mints a token for claims under secret.
func IssueRendezvousToken(secret []byte, claims *RendezvousClaims) string {
	body := EncodeRendezvousClaims(claims)
	return base64.RawURLEncoding.EncodeToString(body) + "." +
		base64.RawURLEncoding.EncodeToString(rendezvousMAC(secret, body))
}

// VerifyRendezvousToken verifies a token under this auth
// config and returns its claims.
func (a *RendezvousAuth) VerifyRendezvousToken(token string) (*RendezvousClaims, error) {
	parts := strings.Split(token, ".")
	if len(parts) != 2 {
		return nil, errors.New("malformed rendezvous token")
	}
	body, err := base64.RawURLEncoding.DecodeString(parts[0])
	if err != nil {
		return nil, errors.New("malformed rendezvous token")
	}
	sig, err := base64.RawURLEncoding.DecodeString(parts[1])
	if err != nil {
		return nil, errors.New("malformed rendezvous token")
	}
	if subtle.ConstantTimeCompare(sig, rendezvousMAC(a.Secret, body)) != 1 {
		return nil, errors.New("bad rendezvous token signature")
	}
	claims, err := DecodeRendezvousClaims(body)
	if err != nil {
		return nil, err
	}
	now := a.now().Unix()
	if claims.Exp != 0 && now >= claims.Exp {
		return nil, errors.New("rendezvous token expired")
	}
	if claims.Nbf != 0 && now < claims.Nbf {
		return nil, errors.New("rendezvous token not yet valid")
	}
	if a.Issuer != "" && claims.Iss != a.Issuer {
		return nil, errors.New("rendezvous token issuer mismatch")
	}
	if a.Audience != "" && claims.Aud != a.Audience {
		return nil, errors.New("rendezvous token audience mismatch")
	}
	return claims, nil
}

func (a *RendezvousAuth) verify(metadata map[string]string) (*RendezvousClaims, *StatusError) {
	header := metadata["authorization"]
	token, ok := strings.CutPrefix(header, "Bearer ")
	if !ok || token == "" {
		return nil, NewStatus(CodeUnauthenticated, "missing bearer token")
	}
	claims, err := a.VerifyRendezvousToken(token)
	if err != nil {
		return nil, NewStatus(CodeUnauthenticated, err.Error())
	}
	return claims, nil
}

func (a *RendezvousAuth) checkScopes(path string, claims *RendezvousClaims) *StatusError {
	required := a.Scopes[path]
	if len(required) == 0 {
		return nil
	}
	granted := make(map[string]bool, len(claims.Scopes))
	for _, scope := range claims.Scopes {
		granted[scope] = true
	}
	for _, scope := range required {
		if !granted[scope] {
			return NewStatus(CodePermissionDenied, "missing required scope "+scope)
		}
	}
	return nil
}
GRPC_RUNTIME_EOF
)

