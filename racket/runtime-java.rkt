#<<GRPC_RUNTIME_EOF
package grpcdc;

import java.io.DataInputStream;
import java.io.EOFException;
import java.io.OutputStream;
import java.net.Socket;

/**
 * Transport over the Rust WebRTC-Direct sidecar: the sidecar
 * owns DTLS/SCTP/TURN and bridges one datachannel to a local
 * TCP socket using u32 big-endian length-prefixed messages
 * (one prefix per DataChannel message). JDK only.
 */
public final class SidecarTransport implements Transport {
    private final Socket socket;
    private final DataInputStream in;
    private final OutputStream out;
    private volatile boolean closed;

    public SidecarTransport(Socket socket) throws Exception {
        this.socket = socket;
        this.in = new DataInputStream(socket.getInputStream());
        this.out = socket.getOutputStream();
    }

    public static SidecarTransport connect(String host, int port) throws Exception {
        return new SidecarTransport(new Socket(host, port));
    }

    @Override
    public void send(byte[] data) throws Exception {
        if (closed) {
            throw new EOFException("transport closed");
        }
        byte[] header = new byte[4];
        header[0] = (byte) (data.length >>> 24);
        header[1] = (byte) (data.length >>> 16);
        header[2] = (byte) (data.length >>> 8);
        header[3] = (byte) data.length;
        synchronized (out) {
            out.write(header);
            out.write(data);
            out.flush();
        }
    }

    @Override
    public byte[] recv() throws Exception {
        int length = in.readInt();
        byte[] payload = new byte[length];
        in.readFully(payload);
        return payload;
    }

    @Override
    public void close() {
        closed = true;
        try {
            socket.close();
        } catch (Exception ignored) {
        }
    }
}
