package grpcdc;

import java.io.EOFException;
import java.util.List;
import java.util.Map;

/** Channel: the client side of one Endpoint. */
public class Channel {
    private final Endpoint endpoint;

    /** Wrap a transport, allocating odd stream ids. */
    public Channel(Transport transport) {
        this(new Endpoint(transport, true));
    }

    /** Wrap an existing endpoint (bidirectional use; starts its read loop). */
    public Channel(Endpoint endpoint) {
        this.endpoint = endpoint;
        endpoint.start();
    }

    public Endpoint endpoint() {
        return endpoint;
    }

    /** Receives response messages of one call. */
    public static final class ClientStream {
        private final Endpoint endpoint;
        private final long streamId;
        private final Endpoint.StreamInput input;
        private Codec.Headers headers;
        private Map<String, String> trailers;
        private long deadlineNanos = -1L;
        private Tracing.TraceContext traceCtx;
        private String tracePath;
        private boolean traceEnded;

        private void endTrace(String status) {
            if (!traceEnded) {
                traceEnded = true;
                Tracing.traceEnd("client", tracePath, traceCtx, status);
            }
        }

        ClientStream(Endpoint endpoint, long streamId, Endpoint.StreamInput input) {
            this.endpoint = endpoint;
            this.streamId = streamId;
            this.input = input;
        }

        public long streamId() {
            return streamId;
        }

        private Endpoint.StreamEvent failDeadline() throws Exception {
            endpoint.cancelStream(streamId);
            throw new StatusException(Wire.CODE_DEADLINE_EXCEEDED, "deadline exceeded");
        }

        public Codec.Headers headers() {
            return headers;
        }

        /** Trailing metadata of the terminal status (null until it arrives). */
        public Map<String, String> trailers() {
            return trailers;
        }

        /**
         * Decode the next response into resp. EOFException means the
         * call completed OK; StatusException reports trailers status.
         */
        /** Abort this stream (sends RST, wakes a pending recv). */
        public void cancel() {
            endpoint.cancelStream(streamId);
        }

        public void recv(Unmarshaler resp) throws Exception {
            while (true) {
                Endpoint.StreamEvent event;
                if (deadlineNanos >= 0) {
                    long remaining = deadlineNanos - System.nanoTime();
                    try {
                        event = remaining <= 0 ? failDeadline() : input.get(remaining);
                    } catch (java.util.concurrent.TimeoutException e) {
                        event = failDeadline();
                    }
                } else {
                    event = input.get();
                }
                if (event == null) {
                    throw new StatusException(Wire.CODE_UNAVAILABLE, "data channel closed");
                }
                switch (event.kind) {
                    case HEADERS -> headers = event.headers;
                    case DATA -> {
                        resp.unmarshalDc(event.payload);
                        return;
                    }
                    case TRAILERS -> {
                        trailers = event.status.trailers;
                        endTrace(Wire.statusName(event.status.code));
                        if (event.status.code != Wire.CODE_OK) {
                            throw event.status;
                        }
                        throw new EOFException("call completed");
                    }
                    case RST -> {
                        trailers = event.status.trailers;
                        endTrace(Wire.statusName(event.status.code));
                        throw event.status;
                    }
                    default -> {
                        // HEADERS/DATA handled above; ignore others.
                    }
                }
            }
        }
    }

    private ClientStream open(String path, Map<String, String> metadata) throws Exception {
        return open(path, metadata, null);
    }

    private ClientStream open(String path, Map<String, String> metadata, java.time.Duration timeout)
            throws Exception {
        long deadlineNanos = -1L;
        Tracing.TraceContext traceCtx = null;
        if (timeout != null || Tracing.enabled()) {
            Map<String, String> merged = new java.util.HashMap<>();
            if (metadata != null) {
                merged.putAll(metadata);
            }
            if (timeout != null) {
                deadlineNanos = System.nanoTime() + timeout.toNanos();
                merged.put("grpc-timeout", Codec.encodeTimeout(timeout));
            }
            if (Tracing.enabled()) {
                traceCtx = Tracing.traceStart("client", path,
                        Tracing.parseTraceparent(merged.get("traceparent")));
                if (traceCtx != null) {
                    merged.put("traceparent",
                            Tracing.formatTraceparent(traceCtx.traceId(), traceCtx.spanId()));
                }
            }
            metadata = merged;
        }
        ClientStream stream;
        try {
            stream = openRaw(path, metadata);
        } catch (Exception e) {
            Tracing.traceEnd("client", path, traceCtx, "UNAVAILABLE");
            throw e;
        }
        stream.deadlineNanos = deadlineNanos;
        stream.traceCtx = traceCtx;
        stream.tracePath = path;
        return stream;
    }

    private ClientStream openRaw(String path, Map<String, String> metadata) throws Exception {
        Endpoint.OpenedStream opened = endpoint.openStream();
        try {
            endpoint.sendFrame(Codec.headersFrame(opened.id(), path, metadata));
        } catch (Exception e) {
            endpoint.closeStream(opened.id());
            throw e;
        }
        return new ClientStream(endpoint, opened.id(), opened.input());
    }

    private void sendMessage(ClientStream stream, Marshaler msg) throws Exception {
        endpoint.sendFrame(Codec.encodeFrame(Wire.FRAME_DATA, stream.streamId(), msg.marshalDc()));
    }

    private void halfClose(ClientStream stream) throws Exception {
        endpoint.sendFrame(Codec.encodeFrame(Wire.FRAME_HALF_CLOSE, stream.streamId(), new byte[0]));
    }

    private void sendAll(ClientStream stream, List<? extends Marshaler> reqs) throws Exception {
        for (Marshaler req : reqs) {
            sendMessage(stream, req);
        }
        halfClose(stream);
    }

    /** Run a unary call, decoding the single response into resp. */
    public void unary(String path, Marshaler req, Unmarshaler resp, Map<String, String> metadata)
            throws Exception {
        ClientStream stream = open(path, metadata);
        try {
            sendMessage(stream, req);
            halfClose(stream);
            boolean got = false;
            while (true) {
                try {
                    stream.recv(resp);
                } catch (EOFException eof) {
                    if (!got) {
                        throw new StatusException(Wire.CODE_INTERNAL, "call closed with no response");
                    }
                    return;
                }
                if (got) {
                    throw new StatusException(Wire.CODE_INTERNAL, "unary call received more than one response");
                }
                got = true;
            }
        } finally {
            endpoint.closeStream(stream.streamId());
        }
    }

    /** Start a server-streaming call. */
    public ClientStream serverStream(String path, Marshaler req, Map<String, String> metadata)
            throws Exception {
        ClientStream stream = open(path, metadata);
        sendMessage(stream, req);
        halfClose(stream);
        return stream;
    }

    /** Send all requests, then decode the one response into resp. */
    public void clientStream(String path, List<? extends Marshaler> reqs, Unmarshaler resp,
            Map<String, String> metadata) throws Exception {
        ClientStream stream = open(path, metadata);
        try {
            sendAll(stream, reqs);
            boolean got = false;
            while (true) {
                try {
                    stream.recv(resp);
                } catch (EOFException eof) {
                    if (!got) {
                        throw new StatusException(Wire.CODE_INTERNAL, "call closed with no response");
                    }
                    return;
                }
                if (got) {
                    throw new StatusException(Wire.CODE_INTERNAL,
                            "client-streaming call received more than one response");
                }
                got = true;
            }
        } finally {
            endpoint.closeStream(stream.streamId());
        }
    }

    /** Start a bidi call with all requests sent up front. */
    public ClientStream bidi(String path, List<? extends Marshaler> reqs, Map<String, String> metadata)
            throws Exception {
        ClientStream stream = open(path, metadata);
        sendAll(stream, reqs);
        return stream;
    }

    /** Unary with a deadline timeout (grpc-timeout; DEADLINE_EXCEEDED on expiry). */
    public void unary(String path, Marshaler req, Unmarshaler resp, Map<String, String> metadata,
            java.time.Duration timeout) throws Exception {
        ClientStream stream = open(path, metadata, timeout);
        try {
            sendMessage(stream, req);
            halfClose(stream);
            boolean got = false;
            while (true) {
                try {
                    stream.recv(resp);
                } catch (EOFException eof) {
                    if (!got) {
                        throw new StatusException(Wire.CODE_INTERNAL, "call closed with no response");
                    }
                    return;
                }
                if (got) {
                    throw new StatusException(Wire.CODE_INTERNAL, "unary call received more than one response");
                }
                got = true;
            }
        } finally {
            endpoint.closeStream(stream.streamId());
        }
    }

    /** Server-streaming with a deadline timeout. */
    public ClientStream serverStream(String path, Marshaler req, Map<String, String> metadata,
            java.time.Duration timeout) throws Exception {
        ClientStream stream = open(path, metadata, timeout);
        sendMessage(stream, req);
        halfClose(stream);
        return stream;
    }

    /** Client-streaming with a deadline timeout. */
    public void clientStream(String path, List<? extends Marshaler> reqs, Unmarshaler resp,
            Map<String, String> metadata, java.time.Duration timeout) throws Exception {
        ClientStream stream = open(path, metadata, timeout);
        try {
            sendAll(stream, reqs);
            boolean got = false;
            while (true) {
                try {
                    stream.recv(resp);
                } catch (EOFException eof) {
                    if (!got) {
                        throw new StatusException(Wire.CODE_INTERNAL, "call closed with no response");
                    }
                    return;
                }
                if (got) {
                    throw new StatusException(Wire.CODE_INTERNAL,
                            "client-streaming call received more than one response");
                }
                got = true;
            }
        } finally {
            endpoint.closeStream(stream.streamId());
        }
    }

    /** Bidi with a deadline timeout. */
    public ClientStream bidi(String path, List<? extends Marshaler> reqs, Map<String, String> metadata,
            java.time.Duration timeout) throws Exception {
        ClientStream stream = open(path, metadata, timeout);
        sendAll(stream, reqs);
        return stream;
    }
}
