#lang racket

;;; mux-gen.rkt — stamps mux-spec.rkt (the shared-socket mux
;;; scenario) into the three native stacks' test trees: Rust
;;; (webrtc/rust/tests/mux.rs), Go (webrtc/go/mux_test.go),
;;; JS Node (webrtc/js/test/mux.test.js). Invoked from
;;; metagen.rkt so `make generate` regenerates everything in
;;; one pass. The stacks' PeerMux implementations are
;;; hand-mirrored (like the stacks themselves); the parity
;;; scenario is generated so it cannot drift.

(require "mux-spec.rkt" racket/runtime-path)
(provide generate-mux-tests)

(define-runtime-path here ".")
(define root (build-path here ".."))

(define pairs (mux-spec 'pairs))
(define label (mux-spec 'label))
(define payload-prefix (mux-spec 'payload-prefix))
(define reply-prefix (mux-spec 'reply-prefix))
(define bind-ip (mux-spec 'bind-ip))

(define (header)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n"
   "// @generated by grpc-dc codegen. DO NOT EDIT.\n"))

