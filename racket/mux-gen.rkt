(define (emit-go)
  (string-append
   (header)
   "package dcwebrtc\n"
   (format #<<TPL

import (
	"fmt"
	"net"
	"testing"
	"time"
)

// One PeerMux server (one UDP port) hosting peers,
// cross-connected to ordinary single-socket clients: both
// pairs connect concurrently and echo on the same channel
// label without cross-talk.
func TestMuxTwoPairsShareOneServerSocket(t *testing.T) {
	mux, err := NewPeerMux(&net.UDPAddr{IP: net.ParseIP("~a"), Port: 0})
	if err != nil {
		t.Fatal(err)
	}
	defer mux.Close()
	muxPort := mux.LocalAddr().Port

	type outcome struct {
		pair  int
		heard string
		reply string
		err   error
	}
	outcomes := make(chan outcome, ~a)

	for pair := 0; pair < ~a; pair++ {
		answerer, err := mux.NewPeer(PeerOptions{LocalIPs: []string{"~a"}, RequirePeerCertificate: true})
		if err != nil {
			t.Fatal(err)
		}
		defer answerer.Close()
		for _, cand := range answerer.LocalCandidates() {
			if cand.Port != muxPort {
				t.Fatalf("mux peer candidate port = %d, want shared %d", cand.Port, muxPort)
			}
		}
		offerer, err := NewPeer(PeerOptions{LocalIPs: []string{"~a"}, RequirePeerCertificate: true})
		if err != nil {
			t.Fatal(err)
		}
		defer offerer.Close()

		offer := offerer.CreateOffer()
		answer, err := answerer.HandleOffer(offer)
		if err != nil {
			t.Fatal(err)
		}
		if err := offerer.HandleAnswer(answer); err != nil {
			t.Fatal(err)
		}

		go func(pair int, offerer, answerer *Peer) {
			out := outcome{pair: pair}
			results := make(chan *DcEndpoint, 2)
			errs := make(chan error, 2)
			go func() {
				ep, err := offerer.ConnectWithOptions(true)
				if err != nil {
					errs <- err
					return
				}
				results <- ep
			}()
			go func() {
				ep, err := answerer.ConnectWithOptions(true)
				if err != nil {
					errs <- err
					return
				}
				results <- ep
			}()
			var endpoints []*DcEndpoint
			for i := 0; i < 2; i++ {
				select {
				case ep := <-results:
					endpoints = append(endpoints, ep)
				case err := <-errs:
					out.err = err
					outcomes <- out
					return
				case <-time.After(30 * time.Second):
					out.err = fmt.Errorf("connect timed out")
					outcomes <- out
					return
				}
			}
			epOffer, epAnswer := endpoints[0], endpoints[1]

			heard := make(chan string, 1)
			epAnswer.SetOnChannel(func(channel *DataChannel) {
				channel.OnMessage(func(data []byte, isText bool) {
					heard <- string(data)
					channel.Send([]byte("~a" + string(data)))
				})
			})
			channel := epOffer.OpenChannel(DefaultChannelParams("~a"))
			reply := make(chan string, 1)
			channel.OnMessage(func(data []byte, isText bool) {
				reply <- string(data)
			})
			want := fmt.Sprintf("~a%d", pair)
			channel.Send([]byte(want))
			select {
			case out.heard = <-heard:
			case <-time.After(15 * time.Second):
				out.err = fmt.Errorf("answerer heard nothing")
				outcomes <- out
				return
			}
			select {
			case out.reply = <-reply:
			case <-time.After(15 * time.Second):
				out.err = fmt.Errorf("offerer got no reply")
				outcomes <- out
				return
			}
			outcomes <- out
		}(pair, offerer, answerer)
	}

	seen := map[int]outcome{}
	for i := 0; i < ~a; i++ {
		out := <-outcomes
		if out.err != nil {
			t.Fatalf("pair %d: %v", out.pair, out.err)
		}
		seen[out.pair] = out
	}
	for pair := 0; pair < ~a; pair++ {
		out := seen[pair]
		if want := fmt.Sprintf("~a%d", pair); out.heard != want {
			t.Fatalf("pair %d: answerer heard %q, want %q (cross-talk?)", pair, out.heard, want)
		}
		if want := fmt.Sprintf("~a~a%d", pair); out.reply != want {
			t.Fatalf("pair %d: offerer reply %q, want %q", pair, out.reply, want)
		}
	}
}
TPL
           bind-ip pairs pairs bind-ip bind-ip
           reply-prefix label payload-prefix
           pairs pairs payload-prefix reply-prefix payload-prefix)))

