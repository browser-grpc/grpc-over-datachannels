   "      const full = Buffer.concat(parts);\n"
   "      if (completePartial.unordered) {\n"
   "        events.push({ stream, ppid: completePartial.ppid, payload: full });\n"
   "      } else {\n"
   "        entry.completed.set(completePartial.ssn, [completePartial.ppid, full]);\n"
   "        completedAny = true;\n"
   "      }\n"
