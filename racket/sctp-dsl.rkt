#lang racket

;;; sctp-dsl.rkt — the SCTP fragment-reassembly machine (RFC 9260
;;; §6.1/6.6 receive side), described once and emitted for the
;;; Go/JS/Rust stacks. Phase 1 (sctp-spec.rkt) generated only the
;;; conformance vectors; the state machines stayed hand-mirrored
;;; and drifted once (the v0.32.12 wedge: fragments merged across
;;; a message boundary). Here the machine itself is generated:
;;; the spec below fixes the state shape and every load-bearing
;;; rule, and the three emitters render it per language.
;;;
;;; Machine contract (identical in all three stacks):
;;;   feed(tsn, stream, ssn, ppid, unordered, begin, end, payload)
;;;     -> deliveries [{stream, ppid, payload}] in delivery order
;;;   drain(stream)  -> deliver completed messages in SSN order
;;;   skip(stream, ssn)   FORWARD-TSN: drop state at/below ssn, drain
;;;   reset(stream)  stream reset: drain, then clear the stream
;;; Rules:
;;;   attach:  a non-BEGIN fragment joins the partial whose max
;;;            TSN + 1 == its TSN (never an already-ended partial)
;;;   merge:   TSN-contiguous partials merge, but never across a
;;;            message boundary (a BEGIN holder starts a new
;;;            message; an END holder is already whole)
;;;   complete: BEGIN..END all present (count == last-first+1)
;;;   deliver: unordered immediately; ordered via the SSN drain

(provide sctp-reassembly-spec
         emit-go-sctp-reassembly
         emit-js-sctp-reassembly
         emit-rust-sctp-reassembly)

;; State shape: (field type) with type in {u16 u32 bool tsn ssn
;; bytes (map k v) (maybe t)}. Emitters map these per language.
(define sctp-reassembly-spec
  '((partial
     (ssn u16)
     (ppid u32)
     (unordered bool)
     (parts (map tsn bytes))
     (first-tsn (maybe tsn))
     (last-tsn (maybe tsn)))
    (stream
     (next-ssn ssn)
     (partials (map tsn partial))
     (completed (map ssn completed)))
    (completed
     (ppid u32)
     (payload bytes))
    (delivery
     (stream u16)
     (ppid u32)
     (payload bytes))))

(define (spec-fields kind)
  (cdr (assq kind sctp-reassembly-spec)))

;; ---------------------------------------------------------------------------
;; Go emitter -> webrtc/go/sctp_reassembly_gen.go
;; ---------------------------------------------------------------------------

(define (go-type t)
  (match t
    ['u16 "uint16"]
    ['u32 "uint32"]
    ['bool "bool"]
    ['tsn "uint32"]
    ['ssn "uint16"]
    ['bytes "[]byte"]
    [`(map ,k ,v) (format "map[~a]~a" (go-type k) (go-type v))]
    [`(maybe ,inner) (go-type inner)]
    ['partial "*sctpPartial"]
    ['completed "sctpCompleted"]))

(define (go-field-decl kind f)
  (match-define (list name t) f)
  (define camel (go-name name))
  (define stem (if (string-suffix? camel "Tsn")
                   (substring camel 0 (- (string-length camel) 3))
                   camel))
  (define gname (string-append
                 (string-upcase (substring stem 0 1))
                 (substring stem 1)))
  (if (and (pair? t) (eq? (car t) 'maybe))
      (format "    ~a ~a\n    has~a bool\n"
              camel (go-type t) gname)
      (format "    ~a ~a\n" camel (go-type t))))

(define (go-name sym)
  ;; ssn -> ssn, first-tsn -> firstTsn, next-ssn -> nextSsn
  (define parts (string-split (symbol->string sym) "-"))
  (string-join
   (cons (car parts)
         (map (lambda (p)
                (string-append (string-upcase (substring p 0 1)) (substring p 1)))
              (cdr parts)))
   ""))

(define (emit-go-sctp-reassembly)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n"
   "// @generated by grpc-dc codegen (racket/sctp-dsl.rkt). DO NOT EDIT.\n"
   "package dcwebrtc\n\n"
   "// SCTP fragment reassembly, generated from the shared DSL\n"
   "// (racket/sctp-dsl.rkt): one machine for Go/JS/Rust. The\n"
   "// association keeps TSN-window/SACK bookkeeping; this type\n"
   "// owns per-stream partials, completion, and SSN ordering.\n\n"
   "type sctpDelivery struct {\n"
   "    Stream  uint16\n"
   "    Ppid    uint32\n"
   "    Payload []byte\n"
   "}\n\n"
   "type sctpPartial struct {\n"
   (apply string-append (map (lambda (f) (go-field-decl 'partial f)) (spec-fields 'partial)))
   "}\n\n"
   "type sctpCompleted struct {\n"
   (apply string-append (map (lambda (f) (go-field-decl 'completed f)) (spec-fields 'completed)))
   "}\n\n"
   "type sctpInStream struct {\n"
   (apply string-append (map (lambda (f) (go-field-decl 'stream f)) (spec-fields 'stream)))
   "}\n\n"
   "type sctpReassembler struct {\n"
   "    streams map[uint16]*sctpInStream\n"
   "}\n\n"
   "func newSctpReassembler() *sctpReassembler {\n"
   "    return &sctpReassembler{streams: map[uint16]*sctpInStream{}}\n"
   "}\n\n"
   "func (r *sctpReassembler) streamIds() []uint16 {\n"
   "    out := make([]uint16, 0, len(r.streams))\n"
   "    for id := range r.streams {\n"
   "        out = append(out, id)\n"
   "    }\n"
   "    return out\n"
   "}\n\n"
   "func (r *sctpReassembler) entry(stream uint16) *sctpInStream {\n"
   "    e, ok := r.streams[stream]\n"
   "    if !ok {\n"
   "        e = &sctpInStream{partials: map[uint32]*sctpPartial{}, completed: map[uint16]sctpCompleted{}}\n"
   "        r.streams[stream] = e\n"
   "    }\n"
   "    return e\n"
   "}\n\n"
   "func sctpPartialMax(p *sctpPartial) uint32 {\n"
   "    var m uint32\n"
   "    first := true\n"
   "    for t := range p.parts {\n"
   "        if first || t > m {\n"
   "            m, first = t, false\n"
   "        }\n"
   "    }\n"
   "    return m\n"
   "}\n\n"
   "func sctpPartialMin(p *sctpPartial) uint32 {\n"
   "    var m uint32\n"
   "    first := true\n"
   "    for t := range p.parts {\n"
   "        if first || t < m {\n"
   "            m, first = t, false\n"
   "        }\n"
   "    }\n"
   "    return m\n"
   "}\n\n"
   "func (r *sctpReassembler) feed(tsn uint32, stream uint16, ssn uint16, ppid uint32, unordered bool, isBegin bool, isEnd bool, payload []byte) []sctpDelivery {\n"
   "    entry := r.entry(stream)\n"
   "    key := tsn\n"
   "    if !isBegin {\n"
   "        for k, p := range entry.partials {\n"
   "            if p.hasLast {\n"
   "                continue // already ended: a later fragment starts a new partial\n"
   "            }\n"
   "            if sctpPartialMax(p)+1 == tsn {\n"
   "                key = k\n"
   "                break\n"
   "            }\n"
   "        }\n"
   "    }\n"
   "    partial, ok := entry.partials[key]\n"
   "    if !ok {\n"
   "        partial = &sctpPartial{parts: map[uint32][]byte{}}\n"
   "        entry.partials[key] = partial\n"
   "    }\n"
   "    if isBegin {\n"
   "        partial.ssn, partial.ppid, partial.unordered = ssn, ppid, unordered\n"
   "        partial.firstTsn, partial.hasFirst = tsn, true\n"
   "    }\n"
   "    if isEnd {\n"
   "        partial.lastTsn, partial.hasLast = tsn, true\n"
   "    }\n"
   "    cp := make([]byte, len(payload))\n"
   "    copy(cp, payload)\n"
   "    partial.parts[tsn] = cp\n\n"
   "    // Merge TSN-contiguous partials: a fragment that arrives\n"
   "    // out of order starts a dangling partial that could\n"
   "    // otherwise never complete. Never merge across a message\n"
   "    // boundary: pb holding a BEGIN fragment starts a new\n"
   "    // message, and pa holding an END fragment is already a\n"
   "    // whole message.\n"
   "    for {\n"
   "        merged := false\n"
   "        keys := make([]uint32, 0, len(entry.partials))\n"
   "        for k := range entry.partials {\n"
   "            keys = append(keys, k)\n"
   "        }\n"
   "    scan:\n"
   "        for _, ka := range keys {\n"
   "            for _, kb := range keys {\n"
   "                if ka == kb {\n"
   "                    continue\n"
   "                }\n"
   "                pa, pb := entry.partials[ka], entry.partials[kb]\n"
   "                if pa == nil || pb == nil {\n"
   "                    continue\n"
   "                }\n"
   "                if pb.hasFirst || pa.hasLast {\n"
   "                    continue\n"
   "                }\n"
   "                if sctpPartialMax(pa)+1 == sctpPartialMin(pb) {\n"
   "                    for t, b := range pb.parts {\n"
   "                        pa.parts[t] = b\n"
   "                    }\n"
   "                    if pb.hasLast {\n"
   "                        pa.lastTsn, pa.hasLast = pb.lastTsn, true\n"
   "                    }\n"
   "                    delete(entry.partials, kb)\n"
   "                    merged = true\n"
   "                    break scan\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        if !merged {\n"
   "            break\n"
   "        }\n"
   "    }\n\n"
   "    // Extract any completed messages (a merge can complete\n"
   "    // more than the message this fragment belonged to).\n"
   "    var events []sctpDelivery\n"
   "    completedAny := false\n"
   "    for {\n"
   "        completeKey, found := uint32(0), false\n"
   "        for k, p := range entry.partials {\n"
   "            if !p.hasFirst || !p.hasLast {\n"
   "                continue\n"
   "            }\n"
   "            count := int(diff32(p.lastTsn, p.firstTsn)) + 1\n"
   "            if len(p.parts) != count {\n"
   "                continue\n"
   "            }\n"
   "            okAll := true\n"
   "            for i := 0; i < count; i++ {\n"
   "                if _, ok := p.parts[p.firstTsn+uint32(i)]; !ok {\n"
   "                    okAll = false\n"
   "                    break\n"
   "                }\n"
   "            }\n"
   "            if okAll {\n"
   "                completeKey, found = k, true\n"
   "                break\n"
   "            }\n"
   "        }\n"
   "        if !found {\n"
   "            break\n"
   "        }\n"
   "        p := entry.partials[completeKey]\n"
   "        delete(entry.partials, completeKey)\n"
   "        count := int(diff32(p.lastTsn, p.firstTsn)) + 1\n"
   "        var full []byte\n"
   "        for i := 0; i < count; i++ {\n"
   "            full = append(full, p.parts[p.firstTsn+uint32(i)]...)\n"
   "        }\n"
   "        if p.unordered {\n"
   "            events = append(events, sctpDelivery{Stream: stream, Ppid: p.ppid, Payload: full})\n"
   "        } else {\n"
   "            entry.completed[p.ssn] = sctpCompleted{p.ppid, full}\n"
   "            completedAny = true\n"
   "        }\n"
   "    }\n"
   "    if completedAny {\n"
   "        events = append(events, r.drain(stream)...)\n"
   "    }\n"
   "    return events\n"
   "}\n\n"
   "func (r *sctpReassembler) drain(stream uint16) []sctpDelivery {\n"
   "    entry := r.entry(stream)\n"
   "    var events []sctpDelivery\n"
   "    for {\n"
   "        completed, ok := entry.completed[entry.nextSsn]\n"
   "        if !ok {\n"
   "            return events\n"
   "        }\n"
   "        delete(entry.completed, entry.nextSsn)\n"
   "        entry.nextSsn++\n"
   "        events = append(events, sctpDelivery{Stream: stream, Ppid: completed.ppid, Payload: completed.payload})\n"
   "    }\n"
   "}\n\n"
   "// skip applies FORWARD-TSN for one stream: drop completed\n"
   "// messages at or below ssn, drop the ordered partial for\n"
   "// ssn, advance nextSsn past it, then drain what is ready.\n"
   "func (r *sctpReassembler) skip(stream uint16, ssn uint16) []sctpDelivery {\n"
   "    entry := r.entry(stream)\n"
   "    for s := range entry.completed {\n"
   "        if s <= ssn {\n"
   "            delete(entry.completed, s)\n"
   "        }\n"
   "    }\n"
   "    if entry.nextSsn <= ssn {\n"
   "        entry.nextSsn = ssn + 1\n"
   "    }\n"
   "    for k, p := range entry.partials {\n"
   "        if !p.unordered && p.ssn == ssn {\n"
   "            delete(entry.partials, k)\n"
   "        }\n"
   "    }\n"
   "    return r.drain(stream)\n"
   "}\n\n"
   "// reset drains completed messages in order, then clears the\n"
   "// stream's reassembly state (stream reset, RFC 8831 §6.4).\n"
   "func (r *sctpReassembler) reset(stream uint16) []sctpDelivery {\n"
   "    events := r.drain(stream)\n"
   "    entry := r.entry(stream)\n"
   "    entry.partials = map[uint32]*sctpPartial{}\n"
   "    entry.completed = map[uint16]sctpCompleted{}\n"
   "    entry.nextSsn = 0\n"
   "    return events\n"
   "}\n"))

