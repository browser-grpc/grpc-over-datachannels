#lang racket

;;; sctp-dsl.rkt — the SCTP fragment-reassembly machine (RFC 9260
;;; §6.1/6.6 receive side), described once and emitted for the
;;; Rust stack (the only stack since the consolidation: Go/JS
;;; consume the Rust core). Phase 1 (sctp-spec.rkt) generated
;;; only the conformance vectors; the state machines stayed
;;; hand-mirrored and drifted once (the v0.32.12 wedge:
;;; fragments merged across a message boundary). Here the
;;; machine itself is generated: the spec below fixes the
;;; state shape and every load-bearing rule.
;;;
;;; Machine contract (identical in all three stacks):
;;;   feed(tsn, stream, ssn, ppid, unordered, begin, end, payload)
;;;     -> deliveries [{stream, ppid, payload}] in delivery order
;;;   drain(stream)  -> deliver completed messages in SSN order
;;;   skip(stream, ssn)   FORWARD-TSN: drop state at/below ssn, drain
;;;   reset(stream)  stream reset: drain, then clear the stream
;;; Rules:
;;;   attach:  a non-BEGIN fragment joins the partial whose max
;;;            TSN + 1 == its TSN (never an already-ended partial)
;;;   merge:   TSN-contiguous partials merge, but never across a
;;;            message boundary (a BEGIN holder starts a new
;;;            message; an END holder is already whole)
;;;   complete: BEGIN..END all present (count == last-first+1)
;;;   deliver: unordered immediately; ordered via the SSN drain

;;; Phase 3 (below the reassembly emitters): the SACK/gap/
;;; retransmit machine (RFC 9260 §6.2/7.2) gets the same
;;; treatment — cumulative-TSN tracking with gap blocks on the
;;; receive side, and miss-count fast retransmit on the send
;;; side, generated once for Go/JS/Rust. The association keeps
;;; cwnd/inflight/packet building; this machine owns only the
;;; TSN bookkeeping that must not drift (it already had: the
;;; Rust gap walk compared TSNs without serial arithmetic).

(provide sctp-reassembly-spec
         emit-rust-sctp-reassembly
         sctp-sack-spec
         emit-rust-sctp-sack)

;; State shape: (field type) with type in {u16 u32 bool tsn ssn
;; bytes (map k v) (maybe t)}. Emitters map these per language.
(define sctp-reassembly-spec
  '((partial
     (ssn u16)
     (ppid u32)
     (unordered bool)
     (parts (map tsn bytes))
     (first-tsn (maybe tsn))
     (last-tsn (maybe tsn))
     (min-tsn (maybe tsn))
     (max-tsn (maybe tsn)))
    (stream
     (next-ssn ssn)
     (partials (map tsn partial))
     (completed (map ssn completed)))
    (completed
     (ppid u32)
     (payload bytes))
    (delivery
     (stream u16)
     (ppid u32)
     (payload bytes))))

(define (spec-fields kind)
  (cdr (assq kind sctp-reassembly-spec)))

;; ---------------------------------------------------------------------------
;; Go emitter -> webrtc/go/sctp_reassembly_gen.go
;; ---------------------------------------------------------------------------

(define (go-type t)
  (match t
    ['u16 "uint16"]
    ['u32 "uint32"]
    ['bool "bool"]
    ['tsn "uint32"]
    ['ssn "uint16"]
    ['bytes "[]byte"]
    [`(map ,k ,v) (format "map[~a]~a" (go-type k) (go-type v))]
    [`(maybe ,inner) (go-type inner)]
    ['partial "*sctpPartial"]
    ['completed "sctpCompleted"]))

(define (go-field-decl kind f)
  (match-define (list name t) f)
  (define camel (go-name name))
  (define stem (if (string-suffix? camel "Tsn")
                   (substring camel 0 (- (string-length camel) 3))
                   camel))
  (define gname (string-append
                 (string-upcase (substring stem 0 1))
                 (substring stem 1)))
  (if (and (pair? t) (eq? (car t) 'maybe))
      (format "    ~a ~a\n    has~a bool\n"
              camel (go-type t) gname)
      (format "    ~a ~a\n" camel (go-type t))))

(define (go-name sym)
  ;; ssn -> ssn, first-tsn -> firstTsn, next-ssn -> nextSsn
  (define parts (string-split (symbol->string sym) "-"))
  (string-join
   (cons (car parts)
         (map (lambda (p)
                (string-append (string-upcase (substring p 0 1)) (substring p 1)))
              (cdr parts)))
   ""))
;; ---------------------------------------------------------------------------
;; JS emitter -> webrtc/js/sctp_reassembly_gen.js
;; ---------------------------------------------------------------------------

(define (js-name sym)
  (define parts (string-split (symbol->string sym) "-"))
  (string-join
   (cons (car parts)
         (map (lambda (p)
                (string-append (string-upcase (substring p 0 1)) (substring p 1)))
              (cdr parts)))
   ""))
;; ---------------------------------------------------------------------------
;; Rust emitter -> webrtc/rust/src/sctp_reassembly_gen.rs
;; ---------------------------------------------------------------------------

(define (rust-name sym)
  (string-replace (symbol->string sym) "-" "_"))

(define (emit-rust-sctp-reassembly)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n"
   "//! @generated by grpc-dc codegen (shared SCTP reassembly DSL). DO NOT EDIT.\n\n"
   "//! SCTP fragment reassembly, generated from the shared DSL\n"
   "//! (shared SCTP reassembly DSL): one machine for Go/JS/Rust. The\n"
   "//! association keeps TSN-window/SACK bookkeeping; this type\n"
   "//! owns per-stream partials, completion, and SSN ordering.\n\n"
   "#[cfg(feature = \"std\")]\n"
   "use std::collections::HashMap;\n"
   "#[cfg(not(feature = \"std\"))]\n"
   "use alloc::collections::BTreeMap as HashMap;\n"
   "#[cfg(not(feature = \"std\"))]\n"
   "use alloc::vec::Vec;\n\n"
   "pub struct SctpDelivery {\n"
   "    pub stream: u16,\n"
   "    pub ppid: u32,\n"
   "    pub payload: Vec<u8>,\n"
   "}\n\n"
   "#[derive(Default)]\n"
   "struct ReasmPartial {\n"
   "    ssn: u16,\n"
   "    ppid: u32,\n"
   "    unordered: bool,\n"
   "    parts: HashMap<u32, Vec<u8>>,\n"
   "    first_tsn: Option<u32>,\n"
   "    last_tsn: Option<u32>,\n"
   "    min_tsn: Option<u32>,\n"
   "    max_tsn: Option<u32>,\n"
   "}\n\n"
   "#[derive(Default)]\n"
   "struct ReasmStream {\n"
   "    next_ssn: u16,\n"
   "    partials: HashMap<u32, ReasmPartial>,\n"
   "    completed: HashMap<u16, (u32, Vec<u8>)>,\n"
   "}\n\n"
   "#[derive(Default)]\n"
   "pub struct SctpReassembler {\n"
   "    streams: HashMap<u16, ReasmStream>,\n"
   "}\n\n"
   "fn reasm_diff32(a: u32, b: u32) -> i32 {\n"
   "    a.wrapping_sub(b) as i32\n"
   "}\n\n"
   "fn partial_max(p: &ReasmPartial) -> u32 {\n"
   "    p.max_tsn.unwrap_or(0)\n"
   "}\n\n"
   "fn partial_min(p: &ReasmPartial) -> u32 {\n"
   "    p.min_tsn.unwrap_or(0)\n"
   "}\n\n"
   "impl SctpReassembler {\n"
   "    pub fn new() -> Self {\n"
   "        Self::default()\n"
   "    }\n\n"
   "    pub fn stream_ids(&self) -> Vec<u16> {\n"
   "        self.streams.keys().copied().collect()\n"
   "    }\n\n"
   "    #[allow(clippy::too_many_arguments)]\n"
   "    pub fn feed(\n"
   "        &mut self,\n"
   "        tsn: u32,\n"
   "        stream: u16,\n"
   "        ssn: u16,\n"
   "        ppid: u32,\n"
   "        unordered: bool,\n"
   "        is_begin: bool,\n"
   "        is_end: bool,\n"
   "        payload: &[u8],\n"
   "    ) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        let mut key = tsn;\n"
   "        // A retransmitted fragment belongs to the partial\n"
   "        // that already holds its TSN; keying a fresh partial\n"
   "        // for it splits one message across two partials, and\n"
   "        // neither can complete (an END-holding partial is\n"
   "        // merge-exempt), wedging ordered delivery while\n"
   "        // SACKs keep acking.\n"
   "        let mut owned = false;\n"
   "        for (k, p) in entry.partials.iter() {\n"
   "            if p.parts.contains_key(&tsn) {\n"
   "                key = *k;\n"
   "                owned = true;\n"
   "                break;\n"
   "            }\n"
   "        }\n"
   "        if !owned && !is_begin {\n"
   "            for (k, p) in entry.partials.iter() {\n"
   "                if p.last_tsn.is_some() {\n"
   "                    continue; // already ended: new partial\n"
   "                }\n"
   "                if partial_max(p).wrapping_add(1) == tsn {\n"
   "                    key = *k;\n"
   "                    break;\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        let partial = entry.partials.entry(key).or_default();\n"
   "        if is_begin {\n"
   "            partial.ssn = ssn;\n"
   "            partial.ppid = ppid;\n"
   "            partial.unordered = unordered;\n"
   "            partial.first_tsn = Some(tsn);\n"
   "        }\n"
   "        if is_end {\n"
   "            partial.last_tsn = Some(tsn);\n"
   "        }\n"
   "        partial.parts.insert(tsn, payload.to_vec());\n"
   "        if partial.min_tsn.map_or(true, |m| reasm_diff32(tsn, m) < 0) {\n"
   "            partial.min_tsn = Some(tsn);\n"
   "        }\n"
   "        if partial.max_tsn.map_or(true, |m| reasm_diff32(tsn, m) > 0) {\n"
   "            partial.max_tsn = Some(tsn);\n"
   "        }\n\n"
   "        // Merge TSN-contiguous partials: a fragment that\n"
   "        // arrives out of order starts a dangling partial that\n"
   "        // could otherwise never complete. Never merge across\n"
   "        // a message boundary: a partial holding a BEGIN\n"
   "        // fragment starts a new message, and one holding an\n"
   "        // END fragment is already a whole message.\n"
   "        loop {\n"
   "            let mut merged_pair: Option<(u32, u32)> = None;\n"
   "            'scan: for (ka, pa) in entry.partials.iter() {\n"
   "                for (kb, pb) in entry.partials.iter() {\n"
   "                    if ka == kb {\n"
   "                        continue;\n"
   "                    }\n"
   "                    if pb.first_tsn.is_some() || pa.last_tsn.is_some() {\n"
   "                        continue;\n"
   "                    }\n"
   "                    if partial_max(pa).wrapping_add(1) == partial_min(pb) {\n"
   "                        merged_pair = Some((*ka, *kb));\n"
   "                        break 'scan;\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            match merged_pair {\n"
   "                Some((ka, kb)) => {\n"
   "                    let pb = entry.partials.remove(&kb).unwrap();\n"
   "                    let pa = entry.partials.get_mut(&ka).unwrap();\n"
   "                    for (t, b) in pb.parts {\n"
   "                        pa.parts.insert(t, b);\n"
   "                    }\n"
   "                    if pb.last_tsn.is_some() {\n"
   "                        pa.last_tsn = pb.last_tsn;\n"
   "                    }\n"
   "                    if pb.min_tsn.map_or(false, |m| pa.min_tsn.map_or(true, |a| reasm_diff32(m, a) < 0)) {\n"
   "                        pa.min_tsn = pb.min_tsn;\n"
   "                    }\n"
   "                    if pb.max_tsn.map_or(false, |m| pa.max_tsn.map_or(true, |a| reasm_diff32(m, a) > 0)) {\n"
   "                        pa.max_tsn = pb.max_tsn;\n"
   "                    }\n"
   "                }\n"
   "                None => break,\n"
   "            }\n"
   "        }\n\n"
   "        // Extract any completed messages (a merge can complete\n"
   "        // more than the message this fragment belonged to).\n"
   "        let mut events = Vec::new();\n"
   "        let mut completed_any = false;\n"
   "        loop {\n"
   "            let complete_key = entry.partials.iter().find_map(|(k, p)| {\n"
   "                let (first, last) = (p.first_tsn?, p.last_tsn?);\n"
   "                let count = (reasm_diff32(last, first) + 1) as usize;\n"
   "                if p.parts.len() != count {\n"
   "                    return None;\n"
   "                }\n"
   "                if p.min_tsn != Some(first) || p.max_tsn != Some(last) {\n"
   "                    return None;\n"
   "                }\n"
   "                Some(*k)\n"
   "            });\n"
   "            let k = match complete_key {\n"
   "                Some(k) => k,\n"
   "                None => break,\n"
   "            };\n"
   "            let p = entry.partials.remove(&k).unwrap();\n"
   "            let (first, last) = (p.first_tsn.unwrap(), p.last_tsn.unwrap());\n"
   "            let count = (reasm_diff32(last, first) + 1) as usize;\n"
   "            let mut full = Vec::new();\n"
   "            for i in 0..count {\n"
   "                full.extend_from_slice(&p.parts[&first.wrapping_add(i as u32)]);\n"
   "            }\n"
   "            if p.unordered {\n"
   "                events.push(SctpDelivery { stream, ppid: p.ppid, payload: full });\n"
   "            } else {\n"
   "                entry.completed.insert(p.ssn, (p.ppid, full));\n"
   "                completed_any = true;\n"
   "            }\n"
   "        }\n"
   "        if completed_any {\n"
   "            events.extend(self.drain(stream));\n"
   "        }\n"
   "        events\n"
   "    }\n\n"
   "    pub fn drain(&mut self, stream: u16) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        let mut events = Vec::new();\n"
   "        while let Some((ppid, payload)) = entry.completed.remove(&entry.next_ssn) {\n"
   "            entry.next_ssn = entry.next_ssn.wrapping_add(1);\n"
   "            events.push(SctpDelivery { stream, ppid, payload });\n"
   "        }\n"
   "        events\n"
   "    }\n\n"
   "    /// skip applies FORWARD-TSN for one stream: drop completed\n"
   "    /// messages at or below ssn, drop the ordered partial for\n"
   "    /// ssn, advance next_ssn past it, then drain.\n"
   "    pub fn skip(&mut self, stream: u16, ssn: u16) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        entry.completed.retain(|&s, _| s > ssn);\n"
   "        if entry.next_ssn <= ssn {\n"
   "            entry.next_ssn = ssn.wrapping_add(1);\n"
   "        }\n"
   "        entry.partials.retain(|_, p| p.unordered || p.ssn != ssn);\n"
   "        self.drain(stream)\n"
   "    }\n\n"
   "    /// reset drains completed messages in order, then clears\n"
   "    /// the stream's reassembly state (stream reset).\n"
   "    pub fn reset(&mut self, stream: u16) -> Vec<SctpDelivery> {\n"
   "        let mut events = self.drain(stream);\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        entry.partials.clear();\n"
   "        entry.completed.clear();\n"
   "        entry.next_ssn = 0;\n"
   "        events\n"
   "    }\n"
   "}\n"))

;; ---------------------------------------------------------------------------
;; Phase 3: the SACK/gap/retransmit machine (RFC 9260 §6.2/7.2).
;; Same treatment as reassembly: the spec fixes the state shape
;; and the emitters render the machine per language. All TSN
;; comparisons are serial (diff32), including at wrap.
;;
;; Machine contract (identical in all three stacks):
;;   reset(cum)      handshake: cumulative TSN = cum, state cleared
;;   noteReceived(tsn)   record an inbound DATA TSN; advance cum
;;                       over the contiguous run it completes
;;   forwardTsn(newCum)  FORWARD-TSN: drop received at/below newCum
;;   gapBlocks()     SACK gap (start,end) offsets from cum, serial
;;                   order, coalesced
;;   noteSack(cum, blocks, unacked) -> (acked, retransmit)
;;                   acked: unacked at/below cum or inside a block
;;                   retransmit: still-unacked below the first
;;                   block start whose miss count reaches 3
;; ---------------------------------------------------------------------------

(define sctp-sack-spec
  '((tracker
     (cum-tsn tsn)
     (received (map tsn bool))
     (miss (map tsn u32)))))

(define (sack-fields kind)
  (cdr (assq kind sctp-sack-spec)))
;; ---------------------------------------------------------------------------
;; Rust emitter -> webrtc/rust/src/sctp_sack_gen.rs
;; ---------------------------------------------------------------------------

(define (emit-rust-sctp-sack)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n"
   "// @generated by grpc-dc codegen (shared SCTP SACK DSL). DO NOT EDIT.\n\n"
   "// SCTP SACK/gap/retransmit bookkeeping, generated from the\n"
   "// shared DSL (sctp-dsl.rkt phase 3): one machine for\n"
   "// Go/JS/Rust. The association keeps cwnd, inflight\n"
   "// accounting, and packet building; this type owns\n"
   "// cumulative-TSN tracking, gap-block computation, and\n"
   "// miss-count fast-retransmit decisions. All TSN comparisons\n"
   "// are serial (diff32), including at wrap.\n\n"
   "use alloc::collections::{BTreeMap as HashMap, BTreeSet as HashSet};\n"
   "use alloc::vec::Vec;\n\n"
   "fn diff32(a: u32, b: u32) -> i32 {\n"
   "    a.wrapping_sub(b) as i32\n"
   "}\n\n"
   "pub struct SctpSackTracker {\n"
   "    cum_tsn: u32,\n"
   "    received: HashSet<u32>,\n"
   "    miss: HashMap<u32, u32>,\n"
   "}\n\n"
   "impl SctpSackTracker {\n"
   "    pub fn new(cum_tsn: u32) -> Self {\n"
   "        SctpSackTracker { cum_tsn, received: HashSet::new(), miss: HashMap::new() }\n"
   "    }\n\n"
   "    /// reset restarts cumulative tracking at cum_tsn (handshake).\n"
   "    pub fn reset(&mut self, cum_tsn: u32) {\n"
   "        self.cum_tsn = cum_tsn;\n"
   "        self.received.clear();\n"
   "        self.miss.clear();\n"
   "    }\n\n"
   "    pub fn cum_tsn(&self) -> u32 {\n"
   "        self.cum_tsn\n"
   "    }\n\n"
   "    /// note_received records one inbound DATA TSN and advances\n"
   "    /// the cumulative TSN over any contiguous run it completes.\n"
   "    pub fn note_received(&mut self, tsn: u32) {\n"
   "        if diff32(tsn, self.cum_tsn) > 0 {\n"
   "            self.received.insert(tsn);\n"
   "            while self.received.contains(&self.cum_tsn.wrapping_add(1)) {\n"
   "                self.cum_tsn = self.cum_tsn.wrapping_add(1);\n"
   "                self.received.remove(&self.cum_tsn);\n"
   "            }\n"
   "        }\n"
   "    }\n\n"
   "    /// forward_tsn applies FORWARD-TSN: everything at or below\n"
   "    /// new_cum is done; out-of-order state there is dropped.\n"
   "    pub fn forward_tsn(&mut self, new_cum: u32) {\n"
   "        if diff32(new_cum, self.cum_tsn) > 0 {\n"
   "            self.received.retain(|&tsn| diff32(tsn, new_cum) > 0);\n"
   "            self.cum_tsn = new_cum;\n"
   "        }\n"
   "    }\n\n"
   "    /// gap_blocks returns the SACK gap blocks as (start, end)\n"
   "    /// offsets from the cumulative TSN, serial order, coalesced.\n"
   "    pub fn gap_blocks(&self) -> Vec<(u16, u16)> {\n"
   "        let mut sorted: Vec<u32> = self\n"
   "            .received\n"
   "            .iter()\n"
   "            .copied()\n"
   "            .filter(|&t| diff32(t, self.cum_tsn) > 0)\n"
   "            .collect();\n"
   "        sorted.sort_by_key(|&t| t.wrapping_sub(self.cum_tsn));\n"
   "        let mut blocks = Vec::new();\n"
   "        let mut i = 0;\n"
   "        while i < sorted.len() {\n"
   "            let start = sorted[i];\n"
   "            let mut end = start;\n"
   "            while i + 1 < sorted.len() && sorted[i + 1] == end.wrapping_add(1) {\n"
   "                end = sorted[i + 1];\n"
   "                i += 1;\n"
   "            }\n"
   "            blocks.push((\n"
   "                start.wrapping_sub(self.cum_tsn) as u16,\n"
   "                end.wrapping_sub(self.cum_tsn) as u16,\n"
   "            ));\n"
   "            i += 1;\n"
   "        }\n"
   "        blocks\n"
   "    }\n\n"
   "    /// note_sack folds one inbound SACK into the send-side state.\n"
   "    /// Returns (acked, retransmit): acked lists the unacked TSNs\n"
   "    /// the SACK retires (at/below cum or inside a gap block);\n"
   "    /// retransmit lists the still-unacked TSNs below the first\n"
   "    /// gap start whose miss count reaches 3 (RFC 9260 section\n"
   "    /// 7.2.4 fast retransmit). unacked is every in-flight TSN in\n"
   "    /// serial order.\n"
   "    pub fn note_sack(&mut self, cum: u32, blocks: &[(u16, u16)], unacked: &[u32]) -> (Vec<u32>, Vec<u32>) {\n"
   "        let mut acked = Vec::new();\n"
   "        let mut acked_set: HashSet<u32> = HashSet::new();\n"
   "        for &tsn in unacked {\n"
   "            let in_gap = blocks.iter().any(|&(s, e)| {\n"
   "                diff32(tsn, cum.wrapping_add(s as u32)) >= 0\n"
   "                    && diff32(tsn, cum.wrapping_add(e as u32)) <= 0\n"
   "            });\n"
   "            if diff32(tsn, cum) <= 0 || in_gap {\n"
   "                acked.push(tsn);\n"
   "                acked_set.insert(tsn);\n"
   "                self.miss.remove(&tsn);\n"
   "            }\n"
   "        }\n"
   "        let mut retransmit = Vec::new();\n"
   "        if let Some(&(first, _)) = blocks.first() {\n"
   "            let first_start = cum.wrapping_add(first as u32);\n"
   "            for &tsn in unacked {\n"
   "                if acked_set.contains(&tsn) {\n"
   "                    continue;\n"
   "                }\n"
   "                if diff32(tsn, cum) > 0 && diff32(tsn, first_start) < 0 {\n"
   "                    let count = {\n"
   "                        let e = self.miss.entry(tsn).or_insert(0);\n"
   "                        *e += 1;\n"
   "                        *e\n"
   "                    };\n"
   "                    if count >= 3 {\n"
   "                        self.miss.remove(&tsn);\n"
   "                        retransmit.push(tsn);\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        (acked, retransmit)\n"
   "    }\n"
   "}\n"))
