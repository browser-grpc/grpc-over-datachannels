(define (js-name sym)
  (define parts (string-split (symbol->string sym) "-"))
  (string-join
   (cons (car parts)
         (map (lambda (p)
                (string-append (string-upcase (substring p 0 1)) (substring p 1)))
              (cdr parts)))
   ""))

(define (emit-js-sctp-reassembly)
  (string-append
   "// SPDX-License-Identifier: Apache-2.0\n"
   "// @generated by grpc-dc codegen (shared SCTP reassembly DSL). DO NOT EDIT.\n\n"
   "// SCTP fragment reassembly, generated from the shared DSL\n"
   "// (shared SCTP reassembly DSL): one machine for Go/JS/Rust. The\n"
   "// association keeps TSN-window/SACK bookkeeping; this class\n"
   "// owns per-stream partials, completion, and SSN ordering.\n\n"
   "function add32(a, b) { return (a + b) >>> 0; }\n"
   "function diff32(a, b) { return (a - b) | 0; }\n\n"
   "export class SctpReassembler {\n"
   "  constructor() {\n"
   "    this.streams = new Map();\n"
   "  }\n\n"
   "  streamIds() {\n"
   "    return [...this.streams.keys()];\n"
   "  }\n\n"
   "  #entry(stream) {\n"
   "    let e = this.streams.get(stream);\n"
   "    if (!e) {\n"
   "      e = { nextSsn: 0, partials: new Map(), completed: new Map() };\n"
   "      this.streams.set(stream, e);\n"
   "    }\n"
   "    return e;\n"
   "  }\n\n"
   "  feed(tsn, stream, ssn, ppid, unordered, isBegin, isEnd, payload) {\n"
   "    const entry = this.#entry(stream);\n"
   "    let key = tsn;\n"
   "    if (!isBegin) {\n"
   "      for (const [k, p] of entry.partials) {\n"
   "        if (p.lastTsn !== null) continue; // already ended: new partial\n"
   "        const maxTsn = Math.max(...p.parts.keys());\n"
   "        if (add32(maxTsn, 1) === tsn) {\n"
   "          key = k;\n"
   "          break;\n"
   "        }\n"
   "      }\n"
   "    }\n"
   "    let partial = entry.partials.get(key);\n"
   "    if (!partial) {\n"
   "      partial = { ssn: 0, ppid: 0, unordered: false, parts: new Map(), firstTsn: null, lastTsn: null };\n"
   "      entry.partials.set(key, partial);\n"
   "    }\n"
   "    if (isBegin) {\n"
   "      partial.ssn = ssn;\n"
   "      partial.ppid = ppid;\n"
   "      partial.unordered = unordered;\n"
   "      partial.firstTsn = tsn;\n"
   "    }\n"
   "    if (isEnd) partial.lastTsn = tsn;\n"
   "    partial.parts.set(tsn, Buffer.from(payload));\n\n"
   "    // Merge TSN-contiguous partials: a fragment that arrives\n"
   "    // out of order starts a dangling partial that could\n"
   "    // otherwise never complete. Never merge across a message\n"
   "    // boundary: a partial holding a BEGIN fragment starts a\n"
   "    // new message, and one holding an END fragment is whole.\n"
   "    const maxOf = (p) => Math.max(...p.parts.keys());\n"
   "    const minOf = (p) => Math.min(...p.parts.keys());\n"
   "    let merged = true;\n"
   "    while (merged) {\n"
   "      merged = false;\n"
   "    scan:\n"
   "      for (const [ka, pa] of [...entry.partials]) {\n"
   "        for (const [kb, pb] of [...entry.partials]) {\n"
   "          if (ka === kb) continue;\n"
   "          if (pb.firstTsn !== null || pa.lastTsn !== null) continue;\n"
   "          if (add32(maxOf(pa), 1) === minOf(pb)) {\n"
   "            for (const [t, b] of pb.parts) pa.parts.set(t, b);\n"
   "            if (pb.lastTsn !== null) pa.lastTsn = pb.lastTsn;\n"
   "            entry.partials.delete(kb);\n"
   "            merged = true;\n"
   "            break scan;\n"
   "          }\n"
   "        }\n"
   "      }\n"
   "    }\n\n"
   "    // Extract any completed messages (a merge can complete\n"
   "    // more than the message this fragment belonged to).\n"
   "    const events = [];\n"
   "    let completedAny = false;\n"
   "    for (;;) {\n"
   "      let completeKey = null;\n"
   "      let completePartial = null;\n"
   "      for (const [k, p] of entry.partials) {\n"
   "        if (p.firstTsn === null || p.lastTsn === null) continue;\n"
   "        const count = diff32(p.lastTsn, p.firstTsn) + 1;\n"
   "        if (p.parts.size !== count) continue;\n"
   "        let okAll = true;\n"
   "        for (let i = 0; i < count; i++) {\n"
   "          if (!p.parts.has(add32(p.firstTsn, i))) { okAll = false; break; }\n"
   "        }\n"
   "        if (okAll) { completeKey = k; completePartial = p; break; }\n"
   "      }\n"
   "      if (completeKey === null) break;\n"
   "      entry.partials.delete(completeKey);\n"
   "      const count = diff32(completePartial.lastTsn, completePartial.firstTsn) + 1;\n"
   "      const parts = [];\n"
   "      for (let i = 0; i < count; i++) parts.push(completePartial.parts.get(add32(completePartial.firstTsn, i)));\n"
   "      const full = Buffer.concat(parts);\n"
   "      if (completePartial.unordered) {\n"
   "        events.push({ stream, ppid: completePartial.ppid, payload: full });\n"
   "      } else {\n"
   "        entry.completed.set(completePartial.ssn, [completePartial.ppid, full]);\n"
   "        completedAny = true;\n"
   "      }\n"
   "    }\n"
   "    if (completedAny) events.push(...this.drain(stream));\n"
   "    return events;\n"
   "  }\n\n"
   "  drain(stream) {\n"
   "    const entry = this.#entry(stream);\n"
   "    const events = [];\n"
   "    while (entry.completed.has(entry.nextSsn)) {\n"
   "      const [ppid, payload] = entry.completed.get(entry.nextSsn);\n"
   "      entry.completed.delete(entry.nextSsn);\n"
   "      entry.nextSsn = (entry.nextSsn + 1) & 0xffff;\n"
   "      events.push({ stream, ppid, payload });\n"
   "    }\n"
   "    return events;\n"
   "  }\n\n"
   "  // skip applies FORWARD-TSN for one stream: drop completed\n"
   "  // messages at or below ssn, drop the ordered partial for\n"
   "  // ssn, advance nextSsn past it, then drain what is ready.\n"
   "  skip(stream, ssn) {\n"
   "    const entry = this.#entry(stream);\n"
   "    for (const s of [...entry.completed.keys()]) {\n"
   "      if (s <= ssn) entry.completed.delete(s);\n"
   "    }\n"
   "    if (entry.nextSsn <= ssn) entry.nextSsn = (ssn + 1) & 0xffff;\n"
   "    for (const [k, p] of [...entry.partials]) {\n"
   "      if (!p.unordered && p.ssn === ssn) entry.partials.delete(k);\n"
   "    }\n"
   "    return this.drain(stream);\n"
   "  }\n\n"
   "  // reset drains completed messages in order, then clears the\n"
   "  // stream's reassembly state (stream reset, RFC 8831 §6.4).\n"
   "  reset(stream) {\n"
   "    const events = this.drain(stream);\n"
   "    const entry = this.#entry(stream);\n"
   "    entry.partials.clear();\n"
   "    entry.completed.clear();\n"
   "    entry.nextSsn = 0;\n"
   "    return events;\n"
   "  }\n"
   "}\n"))

