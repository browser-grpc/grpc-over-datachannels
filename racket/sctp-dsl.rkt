   "pub struct SctpReassembler {\n"
   "    streams: HashMap<u16, ReasmStream>,\n"
   "}\n\n"
   "fn reasm_diff32(a: u32, b: u32) -> i32 {\n"
   "    a.wrapping_sub(b) as i32\n"
   "}\n\n"
   "fn partial_max(p: &ReasmPartial) -> u32 {\n"
   "    p.parts.keys().copied().max().unwrap_or(0)\n"
   "}\n\n"
   "fn partial_min(p: &ReasmPartial) -> u32 {\n"
   "    p.parts.keys().copied().min().unwrap_or(0)\n"
   "}\n\n"
   "impl SctpReassembler {\n"
   "    pub fn new() -> Self {\n"
   "        Self::default()\n"
   "    }\n\n"
   "    pub fn stream_ids(&self) -> Vec<u16> {\n"
   "        self.streams.keys().copied().collect()\n"
   "    }\n\n"
   "    #[allow(clippy::too_many_arguments)]\n"
   "    pub fn feed(\n"
   "        &mut self,\n"
   "        tsn: u32,\n"
   "        stream: u16,\n"
   "        ssn: u16,\n"
   "        ppid: u32,\n"
   "        unordered: bool,\n"
   "        is_begin: bool,\n"
   "        is_end: bool,\n"
   "        payload: &[u8],\n"
   "    ) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        let mut key = tsn;\n"
   "        if !is_begin {\n"
   "            for (k, p) in entry.partials.iter() {\n"
   "                if p.last_tsn.is_some() {\n"
   "                    continue; // already ended: new partial\n"
   "                }\n"
   "                if partial_max(p).wrapping_add(1) == tsn {\n"
   "                    key = *k;\n"
   "                    break;\n"
   "                }\n"
   "            }\n"
   "        }\n"
   "        let partial = entry.partials.entry(key).or_default();\n"
   "        if is_begin {\n"
   "            partial.ssn = ssn;\n"
   "            partial.ppid = ppid;\n"
   "            partial.unordered = unordered;\n"
   "            partial.first_tsn = Some(tsn);\n"
   "        }\n"
   "        if is_end {\n"
   "            partial.last_tsn = Some(tsn);\n"
   "        }\n"
   "        partial.parts.insert(tsn, payload.to_vec());\n\n"
   "        // Merge TSN-contiguous partials: a fragment that\n"
   "        // arrives out of order starts a dangling partial that\n"
   "        // could otherwise never complete. Never merge across\n"
   "        // a message boundary: a partial holding a BEGIN\n"
   "        // fragment starts a new message, and one holding an\n"
   "        // END fragment is already a whole message.\n"
   "        loop {\n"
   "            let mut merged_pair: Option<(u32, u32)> = None;\n"
   "            'scan: for (ka, pa) in entry.partials.iter() {\n"
   "                for (kb, pb) in entry.partials.iter() {\n"
   "                    if ka == kb {\n"
   "                        continue;\n"
   "                    }\n"
   "                    if pb.first_tsn.is_some() || pa.last_tsn.is_some() {\n"
   "                        continue;\n"
   "                    }\n"
   "                    if partial_max(pa).wrapping_add(1) == partial_min(pb) {\n"
   "                        merged_pair = Some((*ka, *kb));\n"
   "                        break 'scan;\n"
   "                    }\n"
   "                }\n"
   "            }\n"
   "            match merged_pair {\n"
   "                Some((ka, kb)) => {\n"
   "                    let pb = entry.partials.remove(&kb).unwrap();\n"
   "                    let pa = entry.partials.get_mut(&ka).unwrap();\n"
   "                    for (t, b) in pb.parts {\n"
   "                        pa.parts.insert(t, b);\n"
   "                    }\n"
   "                    if pb.last_tsn.is_some() {\n"
   "                        pa.last_tsn = pb.last_tsn;\n"
   "                    }\n"
   "                }\n"
   "                None => break,\n"
   "            }\n"
   "        }\n\n"
   "        // Extract any completed messages (a merge can complete\n"
   "        // more than the message this fragment belonged to).\n"
   "        let mut events = Vec::new();\n"
   "        let mut completed_any = false;\n"
   "        loop {\n"
   "            let complete_key = entry.partials.iter().find_map(|(k, p)| {\n"
   "                let (first, last) = (p.first_tsn?, p.last_tsn?);\n"
   "                let count = (reasm_diff32(last, first) + 1) as usize;\n"
   "                if p.parts.len() != count {\n"
   "                    return None;\n"
   "                }\n"
   "                for i in 0..count {\n"
   "                    if !p.parts.contains_key(&first.wrapping_add(i as u32)) {\n"
   "                        return None;\n"
   "                    }\n"
   "                }\n"
   "                Some(*k)\n"
   "            });\n"
   "            let k = match complete_key {\n"
   "                Some(k) => k,\n"
   "                None => break,\n"
   "            };\n"
   "            let p = entry.partials.remove(&k).unwrap();\n"
   "            let (first, last) = (p.first_tsn.unwrap(), p.last_tsn.unwrap());\n"
   "            let count = (reasm_diff32(last, first) + 1) as usize;\n"
   "            let mut full = Vec::new();\n"
   "            for i in 0..count {\n"
   "                full.extend_from_slice(&p.parts[&first.wrapping_add(i as u32)]);\n"
   "            }\n"
   "            if p.unordered {\n"
   "                events.push(SctpDelivery { stream, ppid: p.ppid, payload: full });\n"
   "            } else {\n"
   "                entry.completed.insert(p.ssn, (p.ppid, full));\n"
   "                completed_any = true;\n"
   "            }\n"
   "        }\n"
   "        if completed_any {\n"
   "            events.extend(self.drain(stream));\n"
   "        }\n"
   "        events\n"
   "    }\n\n"
   "    pub fn drain(&mut self, stream: u16) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        let mut events = Vec::new();\n"
   "        while let Some((ppid, payload)) = entry.completed.remove(&entry.next_ssn) {\n"
   "            entry.next_ssn = entry.next_ssn.wrapping_add(1);\n"
   "            events.push(SctpDelivery { stream, ppid, payload });\n"
   "        }\n"
   "        events\n"
   "    }\n\n"
   "    /// skip applies FORWARD-TSN for one stream: drop completed\n"
   "    /// messages at or below ssn, drop the ordered partial for\n"
   "    /// ssn, advance next_ssn past it, then drain.\n"
   "    pub fn skip(&mut self, stream: u16, ssn: u16) -> Vec<SctpDelivery> {\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        entry.completed.retain(|&s, _| s > ssn);\n"
   "        if entry.next_ssn <= ssn {\n"
   "            entry.next_ssn = ssn.wrapping_add(1);\n"
   "        }\n"
   "        entry.partials.retain(|_, p| p.unordered || p.ssn != ssn);\n"
   "        self.drain(stream)\n"
   "    }\n\n"
   "    /// reset drains completed messages in order, then clears\n"
   "    /// the stream's reassembly state (stream reset).\n"
   "    pub fn reset(&mut self, stream: u16) -> Vec<SctpDelivery> {\n"
   "        let mut events = self.drain(stream);\n"
   "        let entry = self.streams.entry(stream).or_default();\n"
   "        entry.partials.clear();\n"
   "        entry.completed.clear();\n"
   "        entry.next_ssn = 0;\n"
   "        events\n"
   "    }\n"
   "}\n"))

