(define ruby-codec-body
#<<GRPC_RUNTIME_EOF
# Codec + status types for gRPC over WebRTC DataChannels.
#
# Wire protocol in ../SPEC.md. Frame, status, channel and server
# semantics mirror the Rust, JavaScript, Go and Python runtimes;
# the tables in wire_gen.rb are generated by grpc-dc codegen.

require "json"
require_relative "wire_gen"

module Grpcdc
  HEADER_LEN = 9
  MAX_DATA_PAYLOAD = 16 * 1024 * 1024

  # Canonical status name ("CODE_N" for unknown codes).
  def self.status_name(code)
    STATUS_NAMES.fetch(code, "CODE_#{code}")
  end

  # A gRPC status (code + message) carried as an exception.
  # (message is an attribute, like the Python runtime; note
  # Exception#message normally delegates to to_s, so to_s must
  # build from the attribute, never from itself.)
  class StatusError < StandardError
    attr_reader :code, :message

    # Trailing metadata carried by a status frame (never nil).
    attr_accessor :trailers

    def initialize(code, message = "")
      super(message)
      @code = code
      @message = message
      @trailers = {}
    end

    def to_s
      "#{Grpcdc.status_name(@code)}: #{@message}"
    end
  end

  # The call completed OK (client-side stream end).
  class CallClosed < EOFError; end

  # --- Homegrown tracing@@TRACING_BETA@@ (W3C traceparent propagation) ----------
  # Dormant until Grpcdc.set_tracer registers an observer with
  # on_start(kind, method, trace_id, span_id, parent_span_id) and
  # on_end(kind, method, trace_id, span_id, status_name, duration_ms).
  # Generated code stays dependency-free: sampling and export are
  # the application's problem.
  @tracer = nil

  def self.set_tracer(tracer)
    @tracer = tracer
  end

  def self.tracer
    @tracer
  end

  @trace_filter = []

  # Restrict traced methods: ';'-separated paths, a trailing
  # '*' means prefix match ('/echo.Echo/*'). Empty = trace all.
  def self.set_trace_filter(patterns)
    @trace_filter = patterns.split(";").reject(&:empty?)
  end

  def self.trace_allowed?(method)
    return true if @trace_filter.empty?

    @trace_filter.any? do |p|
      p.end_with?("*") ? method.start_with?(p[0...-1]) : method == p
    end
  end

  def self.format_traceparent(trace_id, span_id, sampled = true)
    "00-#{trace_id}-#{span_id}-#{sampled ? "01" : "00"}"
  end

  # Parse a traceparent header ->
  # [trace_id, span_id, sampled] or nil.
  def self.parse_traceparent(value)
    return nil unless value.is_a?(String)

    parts = value.split("-")
    return nil unless parts.length == 4

    trace_id, span_id, flags = parts[1], parts[2], parts[3]
    return nil unless trace_id.length == 32 && span_id.length == 16
    return nil unless trace_id.match?(/\A[0-9a-f]+\z/) && span_id.match?(/\A[0-9a-f]+\z/)
    return nil unless flags.length == 2 && flags.match?(/\A[0-9a-f]+\z/)

    [trace_id, span_id, (flags.to_i(16) & 1) == 1]
  end

  def self.trace_start(kind, method, parent)
    return nil if @tracer.nil? || !trace_allowed?(method)

    require "securerandom"
    trace_id, parent_span_id, parent_sampled = parent || [SecureRandom.hex(16), "", true]
    ctx = {
      "trace_id" => trace_id,
      "span_id" => SecureRandom.hex(8),
      "parent_span_id" => parent_span_id,
      "sampled" => parent_sampled,
      "start_time" => Process.clock_gettime(Process::CLOCK_MONOTONIC)
    }
    if ctx["sampled"]
      begin
        @tracer.on_start(kind, method, ctx["trace_id"], ctx["span_id"], parent_span_id)
      rescue StandardError
        # observers must never break the call
      end
    end
    ctx
  end

  # Start a root span context (client workflows). Pair with trace_end.
  def self.new_trace_context(kind, method)
    trace_start(kind, method, nil)
  end

  # View a span context as a traceparent parent for an outbound call.
  def self.parent_of(ctx)
    return nil if ctx.nil?

    [ctx["trace_id"], ctx["span_id"], ctx["sampled"]]
  end

  def self.trace_end(kind, method, ctx, status)
    return if ctx.nil? || @tracer.nil? || ctx["sampled"] == false

    duration_ms = (Process.clock_gettime(Process::CLOCK_MONOTONIC) - ctx["start_time"]) * 1000.0
    begin
      @tracer.on_end(kind, method, ctx["trace_id"], ctx["span_id"], status, duration_ms)
    rescue StandardError
      # observers must never break the call
    end
  end

  # Convert an exception to StatusError (OK for nil).
  def self.to_status(err)
    return StatusError.new(CODE_OK, "") if err.nil?
    return err if err.is_a?(StatusError)

    StatusError.new(CODE_INTERNAL, err.message)
  end

  # A parsed HEADERS payload: path=nil marks response headers.
  class Headers
    attr_reader :path, :metadata

    def initialize(path = nil, metadata = nil, timeout: nil)
      @path = path
      @metadata = metadata || {}
    end

    def inspect
      "Headers(path=#{@path.inspect}, metadata=#{@metadata.inspect})"
    end
  end

  module Codec
    module_function

    # Build one DataChannel message: header + payload.
    def encode_frame(frame_type, stream_id, payload)
      unless FRAME_NAMES.value?(frame_type)
        raise StatusError.new(CODE_INVALID_ARGUMENT, "unknown frame type #{frame_type}")
      end
      payload = payload.b
      if frame_type == FRAME_DATA && payload.bytesize > MAX_DATA_PAYLOAD
        raise StatusError.new(CODE_RESOURCE_EXHAUSTED, "DATA payload exceeds 16 MiB")
      end

      [frame_type, stream_id, payload.bytesize].pack("CNN") + payload
    end

    # Parse one DataChannel message -> [frame_type, stream_id, payload].
    def decode_frame(data)
      if data.bytesize < HEADER_LEN
        raise StatusError.new(
          CODE_INVALID_ARGUMENT,
          "frame shorter than 9-byte header: #{data.bytesize} bytes"
        )
      end
      frame_type, stream_id, length = data.byteslice(0, HEADER_LEN).unpack("CNN")
      if length != data.bytesize - HEADER_LEN
        raise StatusError.new(
          CODE_INVALID_ARGUMENT,
          "payload length #{length} does not match message size #{data.bytesize}"
        )
      end

      [frame_type, stream_id, data.byteslice(HEADER_LEN..-1) || "".b]
    end

    def headers_frame(stream_id, path, metadata)
      body = {}
      body["path"] = path unless path.nil?
      body["metadata"] = metadata if metadata && !metadata.empty?
      encode_frame(FRAME_HEADERS, stream_id, JSON.generate(body).b)
    end

    def parse_headers(payload)
      begin
        body = JSON.parse(payload.dup.force_encoding(Encoding::UTF_8))
      rescue JSON::ParserError, EncodingError => e
        raise StatusError.new(CODE_INVALID_ARGUMENT, "bad HEADERS payload: #{e.message}")
      end
      unless body.is_a?(Hash)
        raise StatusError.new(CODE_INVALID_ARGUMENT, "HEADERS payload is not an object")
      end
      metadata = body["metadata"] || {}
      unless metadata.is_a?(Hash)
        raise StatusError.new(CODE_INVALID_ARGUMENT, "HEADERS metadata is not an object")
      end

      Headers.new(body["path"], metadata)
    end

        # gRPC timeout grammar (grpc-timeout metadata): <digits><unit>,
    # units H/M/S/m/u/n (at most 8 digits). Encoding uses
    # milliseconds (seconds past the digit limit), rounded up.
    def encode_timeout(seconds)
      ms = (seconds * 1000.0).ceil
      return "#{ms}m" if ms <= 99999999

      "#{seconds.ceil}S"
    end

    # Decoded grpc-timeout in seconds, or nil when malformed.
    def parse_timeout(text)
      return nil unless text.is_a?(String) && text.length >= 2 && text.length <= 9

      digits = text[0...-1]
      return nil unless digits.match?(/\A\d+\z/)

      n = digits.to_i.to_f
      case text[-1]
      when "H" then n * 3600.0
      when "M" then n * 60.0
      when "S" then n
      when "m" then n / 1000.0
      when "u" then n / 1000000.0
      when "n" then n / 1000000000.0
      end
    end

def status_frame(frame_type, stream_id, status)
      body = { "code" => status.code, "message" => status.message }
      body["metadata"] = status.trailers if status.trailers && !status.trailers.empty?
      encode_frame(frame_type, stream_id, JSON.generate(body).b)
    end

    def parse_status(payload)
      body = JSON.parse(payload.dup.force_encoding(Encoding::UTF_8))
      status = StatusError.new(Integer(body.fetch("code")), String(body["message"] || ""))
      md = body["metadata"]
      if md.is_a?(Hash)
        status.trailers = md.each_with_object({}) do |(k, v), out|
          out[k.to_s] = v.to_s
        end
      end
      status
    rescue JSON::ParserError, EncodingError, KeyError, TypeError, ArgumentError
      StatusError.new(CODE_UNKNOWN, "malformed trailers")
    end
  end

  # Convenience delegates (the Python runtime's flat surface).
  def self.encode_frame(frame_type, stream_id, payload)
    Codec.encode_frame(frame_type, stream_id, payload)
  end

  def self.decode_frame(data)
    Codec.decode_frame(data)
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-endpoint-body
#<<GRPC_RUNTIME_EOF
# Endpoint: multiplexes grpc-dc streams over one Transport.

require_relative "codec"
require_relative "wire_gen"

module Grpcdc
  EVENT_HEADERS = "headers"
  EVENT_DATA = "data"
  EVENT_HALF_CLOSE = "half-close"
  EVENT_TRAILERS = "trailers"
  EVENT_RST = "rst"

  # Carries whole DataChannel messages (boundaries preserved).
  #
  # recv returns one message, or raises EOFError when the
  # transport is closed.
  class Transport
    def send(_data)
      raise NotImplementedError
    end

    def recv
      raise NotImplementedError
    end
  end

  class StreamEvent
    attr_reader :kind, :headers, :payload, :status

    def initialize(kind, headers: nil, payload: nil, status: nil)
      @kind = kind
      @headers = headers
      @payload = payload
      @status = status
    end
  end

  # Receiving queue of one stream; closed after a terminal event.
  class StreamInput
    CLOSED = Object.new

    def initialize
      @events = Queue.new
    end

    def put(event)
      @events << event
    end

    def close
      @events << CLOSED
    end

    TIMEOUT = Object.new

    # Next event, or nil once the stream is closed. With a
    # timeout (seconds), returns TIMEOUT when the wait expires.
    def get(timeout = nil)
      return get_blocking if timeout.nil?

      # Portable timed wait: Queue#pop(timeout:) only exists on
      # Ruby >= 3.2 (3.1 raises immediately), so poll non-blocking.
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
      loop do
        begin
          event = @events.pop(true)
          return event.equal?(CLOSED) ? nil : event
        rescue ThreadError
          return TIMEOUT if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

          sleep(0.001)
        end
      end
    end

    private

    def get_blocking
      event = @events.pop
      event.equal?(CLOSED) ? nil : event
    end

    public
  end

  class ResponseSink
    # Wired to the CallContext maps by the endpoint.
    attr_accessor :resp_headers, :resp_trailers

    def initialize(endpoint, stream_id)
      @endpoint = endpoint
      @id = stream_id
      @resp_headers = {}
      @resp_trailers = {}
      @headers_sent = false
    end

    def send_data(payload)
      # A stream the endpoint has forgotten was RST by the peer
      # (or the channel went away): fail the send so a producing
      # handler stops instead of streaming into the void.
      if @endpoint.stream(@id).nil?
        raise StatusError.new(CODE_CANCELLED, "call cancelled")
      end

      flush_headers
      @endpoint.send_frame(Codec.encode_frame(FRAME_DATA, @id, payload))
    end

    def flush_headers
      return if @headers_sent

      @headers_sent = true
      send_headers(@resp_headers)
    end

    def send_headers(metadata = nil)
      if @endpoint.stream(@id).nil?
        raise StatusError.new(CODE_CANCELLED, "call cancelled")
      end

      @headers_sent = true
      @endpoint.send_frame(Codec.headers_frame(@id, nil, metadata || @resp_headers))
    end

    def send_trailers(status)
      if @resp_trailers && !@resp_trailers.empty?
        merged = @resp_trailers.merge(status.trailers || {})
        status = StatusError.new(status.code, status.message)
        status.trailers = merged
      end
      @endpoint.send_frame(Codec.status_frame(FRAME_TRAILERS, @id, status))
    end

    # Server sink interface used by Server.
    def send(payload)
      send_data(payload)
    end
  end

  # Per-call context: metadata sent in HEADERS, plus deadline.
  class CallContext
    attr_reader :metadata, :deadline, :response_headers, :response_trailers
    # This call's server span context (nil when dormant).
    attr_accessor :trace_context

    # Record response initial metadata (sent lazily, before
    # the first response message).
    def set_headers(md)
      @response_headers.merge!(md)
    end

    # Record response trailing metadata (rides the terminal
    # status frame).
    def set_trailers(md)
      @response_trailers.merge!(md)
    end

    def initialize(metadata = nil, timeout: nil)
      @metadata = metadata || {}
      @response_headers = {}
      @response_trailers = {}
      remaining = Codec.parse_timeout(@metadata["grpc-timeout"])
      @deadline = remaining.nil? ? nil : Process.clock_gettime(Process::CLOCK_MONOTONIC) + remaining
    end

    # Seconds left before the deadline, or nil when unbounded.
    def time_remaining
      return nil if @deadline.nil?

      [@deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC), 0.0].max
    end

    def deadline_exceeded?
      time_remaining == 0.0
    end
  end

  # Multiplexes streams over one Transport.
  #
  # The side that created the channel allocates odd stream ids,
  # the answerer even.
  class Endpoint
    attr_reader :transport
    attr_accessor :dispatcher

    def initialize(transport, creator:)
      @transport = transport
      @dispatcher = nil
      @next_id = creator ? 1 : 2
      @send_lock = Mutex.new
      @streams = {}
      @streams_lock = Mutex.new
      @closed = false
      @started = false
    end

    # Start the read loop (idempotent). Called after any
    # dispatcher is installed, so an early HEADERS can never race
    # dispatcher setup.
    def start
      return if @started

      @started = true
      Thread.new { read_loop }
    end

    def set_dispatcher(dispatcher)
      @dispatcher = dispatcher
    end

    def send_frame(frame)
      @send_lock.synchronize { @transport.send(frame) }
    end

    def open_stream
      stream_id = @send_lock.synchronize do
        id = @next_id
        @next_id += 2
        id
      end
      stream_input = StreamInput.new
      @streams_lock.synchronize { @streams[stream_id] = stream_input }
      [stream_id, stream_input]
    end

    def close_stream(stream_id)
      @streams_lock.synchronize { @streams.delete(stream_id) }
    end

    # Abort one stream: RST towards the peer; any thread blocked
    # in recv wakes with the cancellation status (the local input
    # is closed with a synthetic RST event).
    def cancel_stream(stream_id)
      status = StatusError.new(CODE_CANCELLED, "call cancelled")
      input = @streams_lock.synchronize { @streams.delete(stream_id) }
      unless input.nil?
        input.put(StreamEvent.new(EVENT_RST, status: status))
        input.close
      end
      begin
        send_frame(Codec.status_frame(FRAME_RST, stream_id, status))
      rescue StandardError
        nil
      end
    end

    def stream(stream_id)
      @streams_lock.synchronize { @streams[stream_id] }
    end

    def close
      return if @closed

      @closed = true
      begin
        @transport.close if @transport.respond_to?(:close)
      rescue StandardError
        nil
      end
      fail_all
    end

    private

    def fail_all
      pending = @streams_lock.synchronize do
        items = @streams.to_a
        @streams.clear
        items
      end
      pending.each do |_stream_id, stream_input|
        stream_input.put(StreamEvent.new(
                           EVENT_RST,
                           status: StatusError.new(CODE_UNAVAILABLE, "data channel closed")
                         ))
        stream_input.close
      end
    end

    def read_loop
      loop do
        begin
          data = @transport.recv
        rescue StandardError
          fail_all
          return
        end
        return if @closed

        on_bytes(data)
      end
    end

    def on_bytes(data)
      begin
        frame_type, stream_id, payload = Codec.decode_frame(data)
      rescue StatusError
        return # malformed frame: drop, keep the channel up
      end
@@FRAME_DISPATCH@@
    end

    def on_terminal(stream_id, payload, kind)
      stream_input = stream(stream_id)
      return unless stream_input

      stream_input.put(StreamEvent.new(kind, status: Codec.parse_status(payload)))
      stream_input.close
      close_stream(stream_id)
    end

    def push_event(stream_id, event)
      stream_input = stream(stream_id)
      stream_input&.put(event)
    end

    def on_headers(stream_id, payload)
      begin
        headers = Codec.parse_headers(payload)
      rescue StatusError => e
        begin
          send_frame(Codec.status_frame(FRAME_RST, stream_id, Grpcdc.to_status(e)))
        rescue StandardError
          nil
        end
        return
      end
      if headers.path.nil?
        # Server response headers for one of our outbound streams.
        stream_input = stream(stream_id)
        stream_input&.put(StreamEvent.new(EVENT_HEADERS, headers: headers))
        return
      end
      if stream(stream_id)
        begin
          send_frame(Codec.status_frame(
                       FRAME_RST, stream_id,
                       StatusError.new(CODE_INTERNAL, "HEADERS for stream already in use")
                     ))
        rescue StandardError
          nil
        end
        return
      end
      if @dispatcher.nil?
        begin
          send_frame(Codec.status_frame(
                       FRAME_TRAILERS, stream_id,
                       StatusError.new(CODE_UNIMPLEMENTED, "unknown method #{headers.path}")
                     ))
        rescue StandardError
          nil
        end
        return
      end
      stream_input = StreamInput.new
      @streams_lock.synchronize { @streams[stream_id] = stream_input }
      sink = ResponseSink.new(self, stream_id)
      dispatcher = @dispatcher
      Thread.new do
        begin
          # No eager HEADERS: initial metadata flushes lazily
          # via the sink (first DATA, or below on a DATA-less
          # success) so handlers can set_headers first. Errors
          # end trailers-only, as gRPC allows.
          ctx = CallContext.new(headers.metadata)
          sink.resp_headers = ctx.response_headers
          sink.resp_trailers = ctx.response_trailers
          status = dispatcher.call(ctx, headers, stream_input, sink)
          if status.nil?
            status = StatusError.new(CODE_OK, "")
            begin
              sink.flush_headers
            rescue StandardError
              nil
            end
          end
          begin
            sink.send_trailers(status)
          rescue StandardError
            nil
          end
        ensure
          close_stream(stream_id)
        end
      end
    end
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-channel-body
#<<GRPC_RUNTIME_EOF
# Channel: the client side of one Endpoint.

require_relative "codec"
require_relative "endpoint"
require_relative "wire_gen"

module Grpcdc
  # Client side; allocates odd stream ids on a fresh Endpoint.
  class Channel
    attr_reader :endpoint

    def initialize(transport = nil, endpoint: nil)
      @endpoint = endpoint || Endpoint.new(transport, creator: true)
      @trace_context = nil
      @endpoint.start
    end

    # Parent this channel's outbound spans to ctx (usually
    # ctx.trace_context of the call being served, or a root from
    # Grpcdc.new_trace_context). Explicit metadata still wins.
    def with_trace_context(ctx)
      ch = Channel.allocate
      ch.instance_variable_set(:@endpoint, @endpoint)
      ch.instance_variable_set(:@trace_context, ctx)
      ch
    end

    def unary(path, req, resp, metadata = nil, timeout: nil)
      stream = open_call(path, metadata, timeout)
      begin
        send_message(stream, req)
        half_close(stream)
        got = false
        loop do
          begin
            stream.recv(resp)
          rescue EOFError
            raise StatusError.new(CODE_INTERNAL, "call closed with no response") unless got

            return resp
          end
          if got
            raise StatusError.new(CODE_INTERNAL, "unary call received more than one response")
          end

          got = true
        end
      ensure
        @endpoint.close_stream(stream.stream_id)
      end
    end

    def server_stream(path, req, metadata = nil, timeout: nil)
      stream = open_call(path, metadata, timeout)
      send_message(stream, req)
      half_close(stream)
      stream
    end

    def client_stream(path, reqs, resp, metadata = nil, timeout: nil)
      stream = open_call(path, metadata, timeout)
      begin
        send_all(stream, reqs)
        got = false
        loop do
          begin
            stream.recv(resp)
          rescue EOFError
            raise StatusError.new(CODE_INTERNAL, "call closed with no response") unless got

            return resp
          end
          if got
            raise StatusError.new(
              CODE_INTERNAL, "client-streaming call received more than one response"
            )
          end

          got = true
        end
      ensure
        @endpoint.close_stream(stream.stream_id)
      end
    end

    def bidi(path, reqs, metadata = nil, timeout: nil)
      stream = open_call(path, metadata, timeout)
      send_all(stream, reqs)
      stream
    end

    # Open a stream without sending anything: drive it with
    # send_message / half_close / recv / cancel.
    def open_stream(path, metadata = nil, timeout: nil)
      open_call(path, metadata, timeout)
    end

    private

    def open_call(path, metadata, timeout = nil)
      deadline = nil
      trace_ctx = nil
      unless timeout.nil? && Grpcdc.tracer.nil?
        metadata = (metadata || {}).dup
        unless timeout.nil?
          deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
          metadata["grpc-timeout"] = Codec.encode_timeout(timeout)
        end
        unless Grpcdc.tracer.nil?
          parent = Grpcdc.parse_traceparent(metadata["traceparent"]) || Grpcdc.parent_of(@trace_context)
          trace_ctx = Grpcdc.trace_start("client", path, parent)
          unless trace_ctx.nil?
            metadata["traceparent"] = Grpcdc.format_traceparent(trace_ctx["trace_id"], trace_ctx["span_id"], trace_ctx["sampled"])
          end
        end
      end
      stream_id, stream_input = @endpoint.open_stream
      begin
        @endpoint.send_frame(Codec.headers_frame(stream_id, path, metadata))
      rescue StandardError
        @endpoint.close_stream(stream_id)
        Grpcdc.trace_end("client", path, trace_ctx, "UNAVAILABLE")
        raise
      end
      stream = ClientStream.new(@endpoint, stream_id, stream_input)
      stream.deadline = deadline
      stream.trace_ctx = trace_ctx
      stream.trace_path = path
      stream
    end

    def send_message(stream, msg)
      @endpoint.send_frame(Codec.encode_frame(FRAME_DATA, stream.stream_id, msg.marshal_dc))
    end
    public :send_message

    def half_close(stream)
      @endpoint.send_frame(Codec.encode_frame(FRAME_HALF_CLOSE, stream.stream_id, "".b))
    end
    public :half_close

    def send_all(stream, reqs)
      reqs.each { |req| send_message(stream, req) }
      half_close(stream)
    end
  end

  # Receives response messages of one call.
  class ClientStream
    attr_reader :stream_id, :headers, :trailers, :endpoint

    attr_accessor :deadline, :trace_ctx, :trace_path

    def initialize(endpoint, stream_id, stream_input)
      @endpoint = endpoint
      @stream_id = stream_id
      @input = stream_input
      @headers = nil
      @trailers = nil
      @deadline = nil
      @trace_ctx = nil
      @trace_path = nil
      @trace_ended = false
      @terminated = false
      # Abandoning the stream object without break/close (a dropped
      # Enumerator or receiving-stream wrapper) must still RST the
      # call so the peer stops producing: a finalizer cancels unless
      # the call already terminated (see register_cancel_finalizer).
      @final_state = [false]
      self.class.register_cancel_finalizer(self, endpoint, stream_id, @final_state)
    end

    # Register the abandon finalizer for a stream. The proc is
    # built by build_cancel_proc, whose frame never holds the
    # stream: a proc that captures the stream itself (directly, or
    # via a local in its creation frame) would keep it alive
    # forever and the finalizer would never run.
    def self.register_cancel_finalizer(stream, endpoint, stream_id, state)
      ObjectSpace.define_finalizer(stream, build_cancel_proc(endpoint, stream_id, state))
    end

    def self.build_cancel_proc(endpoint, stream_id, state)
      proc {
        begin
          # Finalizers run in trap context, where Mutex#synchronize
          # raises ThreadError: hand the cancel to a fresh thread
          # (which re-checks the terminated flag when it runs).
          Thread.new { endpoint.cancel_stream(stream_id) unless state[0] }
        rescue StandardError
          nil
        end
      }
    end

    # Mark the call terminated (trailers/RST/deadline/close seen):
    # a later abandon (finalizer or close) then sends no RST.
    def mark_terminated
      @terminated = true
      @final_state[0] = true
    end

    def end_trace(status)
      return if @trace_ended

      @trace_ended = true
      Grpcdc.trace_end("client", @trace_path, @trace_ctx, status)
    end

    # Decode the next response into resp.
    #
    # Raises EOFError when the call completed OK; StatusError
    # reports the trailers status.
    def recv(resp)
      loop do
        event =
          if @deadline.nil?
            @input.get
          else
            remaining = @deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
            remaining <= 0 ? StreamInput::TIMEOUT : @input.get(remaining)
          end
        if event.equal?(StreamInput::TIMEOUT)
          mark_terminated
          @endpoint.cancel_stream(@stream_id)
          raise StatusError.new(CODE_DEADLINE_EXCEEDED, "deadline exceeded")
        end
        if event.nil?
          mark_terminated
          raise StatusError.new(CODE_UNAVAILABLE, "data channel closed")
        end

        case event.kind
        when EVENT_HEADERS
          @headers = event.headers
        when EVENT_DATA
          return resp.unmarshal_dc(event.payload)
        when EVENT_TRAILERS
          mark_terminated
          @trailers = event.status.trailers
          end_trace(Grpcdc.status_name(event.status.code))
          raise event.status unless event.status.code == CODE_OK

          raise EOFError, "call completed"
        when EVENT_RST
          mark_terminated
          @trailers = event.status.trailers
          end_trace(Grpcdc.status_name(event.status.code))
          raise event.status
        end
      end
    end

    # Abort this stream (sends RST, wakes a pending recv).
    # No-op once the call terminated (trailers/RST already seen),
    # so abandoning a completed stream never sends a spurious RST.
    def cancel
      return if @terminated

      mark_terminated
      @endpoint.cancel_stream(@stream_id)
    end

    # Abandon the call early: RST unless it already terminated.
    def close
      cancel
    end
  end

  # Fiber receiving stream: same recv contract as ClientStream,
  # executed inside a Fiber so the call composes with
  # fiber-per-request servers and Fiber.scheduler-based loops
  # (Queue waits are scheduler-aware; with no scheduler the
  # behavior is identical to the blocking stream).
  class FiberClientStream
    def initialize(stream)
      @stream = stream
    end

    def stream_id
      @stream.stream_id
    end

    def headers
      @stream.headers
    end

    def recv(resp)
      Fiber.new { @stream.recv(resp) }.resume
    end

    def cancel
      @stream.cancel
    end

    def close
      @stream.cancel
    end
  end

  # Fiber client facade over Channel. Every call runs inside a
  # dedicated Fiber (see FiberClientStream); wrap an existing
  # Channel or build one over a transport/endpoint.
  class FiberChannel
    attr_reader :channel

    def initialize(channel = nil, transport: nil, endpoint: nil)
      @channel =
        if channel.is_a?(Channel)
          channel
        elsif !channel.nil? && transport.nil? && endpoint.nil?
          Channel.new(channel) # a bare transport
        else
          Channel.new(transport, endpoint: endpoint)
        end
    end

    def endpoint
      @channel.endpoint
    end

    def unary(path, req, resp, metadata = nil, timeout: nil)
      Fiber.new { @channel.unary(path, req, resp, metadata, timeout: timeout) }.resume
    end

    def client_stream(path, reqs, resp, metadata = nil, timeout: nil)
      Fiber.new { @channel.client_stream(path, reqs, resp, metadata, timeout: timeout) }.resume
    end

    def server_stream(path, req, metadata = nil, timeout: nil)
      FiberClientStream.new(@channel.server_stream(path, req, metadata, timeout: timeout))
    end

    def bidi(path, reqs, metadata = nil, timeout: nil)
      FiberClientStream.new(@channel.bidi(path, reqs, metadata, timeout: timeout))
    end
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-server-body
#<<GRPC_RUNTIME_EOF
# Server: dispatches inbound calls to registered methods.

require_relative "codec"
require_relative "endpoint"
require_relative "wire_gen"

module Grpcdc
  KIND_UNARY = "unary"
  KIND_SERVER_STREAMING = "server-streaming"
  KIND_CLIENT_STREAMING = "client-streaming"
  KIND_BIDI = "bidi"

  # Reads request messages of one inbound call.
  class RequestStream
    def initialize(stream_input)
      @input = stream_input
    end

    # Next request payload; EOFError at half-close.
    def recv_raw
      loop do
        event = @input.get
        raise StatusError.new(CODE_UNAVAILABLE, "data channel closed") if event.nil?

        case event.kind
        when EVENT_DATA
          return event.payload
        when EVENT_HALF_CLOSE
          raise EOFError, "half-close"
        when EVENT_TRAILERS, EVENT_RST
          raise event.status
        end
      end
    end

    def recv_into(req)
      req.unmarshal_dc(recv_raw)
      req
    end
  end

  class Method
    attr_reader :name, :path, :kind, :handler

    # handler: callable(ctx, RequestStream, sink) -> nil
    def initialize(name, path, kind, handler)
      @name = name
      @path = path
      @kind = kind
      @handler = handler
    end
  end

  class ServiceDesc
    attr_reader :name, :methods

    def initialize(name, methods)
      @name = name
      @methods = methods
    end
  end

  # Dispatches inbound calls to registered methods.
  class Server
    def initialize
      @methods = {}
    end

    def register_service(desc)
      desc.methods.each { |method| @methods[method.path] = method }
    end

    # Attach to a transport (even stream ids); returns Endpoint.
    def serve_transport(transport)
      endpoint = Endpoint.new(transport, creator: false)
      serve_endpoint(endpoint)
      endpoint
    end

    def serve_endpoint(endpoint)
      endpoint.set_dispatcher(method(:dispatch))
      endpoint.start
    end

    private

    def dispatch(ctx, headers, stream_input, sink)
      method = @methods[headers.path]
      if method.nil?
        return StatusError.new(CODE_UNIMPLEMENTED, "unknown method #{headers.path}")
      end

      trace_ctx = Grpcdc.trace_start("server", headers.path, Grpcdc.parse_traceparent((headers.metadata || {})["traceparent"]))
      ctx.trace_context = trace_ctx
      result = nil
      begin
        method.handler.call(ctx, RequestStream.new(stream_input), sink)
      rescue StandardError => e # StatusError passes through via to_status
        result = Grpcdc.to_status(e)
      end
      Grpcdc.trace_end("server", headers.path, trace_ctx, result.nil? ? "OK" : Grpcdc.status_name(result.code))
      result
    end
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-loopback-body
#<<GRPC_RUNTIME_EOF
# In-memory transport pair for tests (one queue per direction).

require_relative "endpoint"

module Grpcdc
  class MemoryTransport < Transport
    SENTINEL = Object.new

    def initialize(inbox, outbox)
      super()
      @inbox = inbox
      @outbox = outbox
      @closed = false
    end

    def send(data)
      raise EOFError, "transport closed" if @closed

      @outbox << data.b.dup
    end

    def recv
      item = @inbox.pop
      raise EOFError, "transport closed" if item.equal?(SENTINEL)

      item
    end

    def close
      @closed = true
      @inbox << SENTINEL
    end
  end

  # Two connected in-memory transports.
  def self.memory_transport_pair
    a_to_b = Queue.new
    b_to_a = Queue.new
    [MemoryTransport.new(b_to_a, a_to_b), MemoryTransport.new(a_to_b, b_to_a)]
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-sidecar-body
#<<GRPC_RUNTIME_EOF
# Transport over the Rust WebRTC-Direct sidecar: the sidecar
# owns DTLS/SCTP/TURN and bridges one datachannel to a local
# TCP socket using u32 big-endian length-prefixed messages
# (one prefix per DataChannel message). Stdlib only.

require "socket"
require_relative "endpoint"

module Grpcdc
  class SidecarTransport < Transport
    def initialize(sock)
      super()
      @sock = sock
      @buf = +"".b
      @closed = false
    end

    def self.connect(host, port)
      new(TCPSocket.new(host, port))
    end

    def self.from_socket(sock)
      new(sock)
    end

    def send(data)
      raise EOFError, "transport closed" if @closed

      payload = data.b
      @sock.write([payload.bytesize].pack("N") + payload)
    end

    def recv
      fill(4)
      length = @buf.unpack1("N")
      @buf = @buf.byteslice(4..) || +"".b
      fill(length)
      payload = @buf.byteslice(0, length) || +"".b
      @buf = @buf.byteslice(length..) || +"".b
      payload
    end

    def close
      @closed = true
      @sock.close
    rescue IOError
      nil
    end

    private

    def fill(need)
      while @buf.bytesize < need
        chunk = @sock.readpartial(65_536)
        raise EOFError, "transport closed" if chunk.nil? || chunk.empty?

        @buf << chunk.b
      end
    end
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-dynamic-body
#<<GRPC_RUNTIME_EOF
# Dynamic, descriptor-driven client and server.
#
# Parses a FileDescriptorSet (as produced by
# `protoc --descriptor_set_out`) at runtime and builds clients
# and servers whose messages are generic field maps — no
# generated stubs required. This is the runtime-generation
# counterpart of the protoc-plugin surfaces: schemas arrive as
# data (descriptor.proto), not as code.
#
# Generic values by field type: varint family -> Integer,
# string -> String, bytes/message -> String / GenericMessage,
# fixed/float -> Integer / Float, bool -> true/false. Repeated
# fields are arrays in field-number order.

require_relative "codec"
require_relative "server"
require_relative "wire_gen"

module Grpcdc
  # FieldDescriptorProto.Type values (descriptor.proto).
  TYPE_DOUBLE = 1
  TYPE_FLOAT = 2
  TYPE_INT64 = 3
  TYPE_UINT64 = 4
  TYPE_INT32 = 5
  TYPE_FIXED64 = 6
  TYPE_FIXED32 = 7
  TYPE_BOOL = 8
  TYPE_STRING = 9
  TYPE_GROUP = 10
  TYPE_MESSAGE = 11
  TYPE_BYTES = 12
  TYPE_UINT32 = 13
  TYPE_ENUM = 14
  TYPE_SFIXED32 = 15
  TYPE_SFIXED64 = 16
  TYPE_SINT32 = 17
  TYPE_SINT64 = 18

  VARINT_TYPES = [TYPE_INT64, TYPE_UINT64, TYPE_INT32, TYPE_BOOL,
                  TYPE_UINT32, TYPE_ENUM, TYPE_SINT32, TYPE_SINT64].freeze
  LEN_TYPES = [TYPE_STRING, TYPE_BYTES, TYPE_MESSAGE, TYPE_GROUP].freeze

  WIRE_TYPE = {}.tap do |table|
    VARINT_TYPES.each { |t| table[t] = 0 }
    [TYPE_FIXED64, TYPE_SFIXED64, TYPE_DOUBLE].each { |t| table[t] = 1 }
    LEN_TYPES.each { |t| table[t] = 2 }
    [TYPE_FIXED32, TYPE_SFIXED32, TYPE_FLOAT].each { |t| table[t] = 5 }
  end.freeze

  LABEL_REPEATED = 3

  # Minimal protobuf reader over a binary String.
  class PbReader
    attr_reader :last_chunk

    def initialize(data)
      @buf = data.b
      @pos = 0
      @last_chunk = nil
    end

    def varint
      result = 0
      shift = 0
      loop do
        raise ArgumentError, "truncated varint" if @pos >= @buf.bytesize

        b = @buf.getbyte(@pos)
        @pos += 1
        result |= (b & 0x7F) << shift
        return result if (b & 0x80).zero?

        shift += 7
        raise ArgumentError, "varint too long" if shift >= 70
      end
    end

    def bytes_field
      n = varint
      raise ArgumentError, "truncated bytes field" if @pos + n > @buf.bytesize

      out = @buf.byteslice(@pos, n)
      @pos += n
      out
    end

    # Yield [number, wire_type, value] until end of buffer.
    # Sets last_chunk to the raw bytes of the yielded field
    # (captured before the yield, so consumers may read it while
    # processing this field).
    def each_field
      return enum_for(:each_field) unless block_given?

      while @pos < @buf.bytesize
        start = @pos
        tag = varint
        number = tag >> 3
        wire = tag & 7
        value =
          case wire
          when 0 then varint
          when 2 then bytes_field
          when 1
            raise ArgumentError, "truncated fixed64" if @pos + 8 > @buf.bytesize

            v = @buf.byteslice(@pos, 8)
            @pos += 8
            v
          when 5
            raise ArgumentError, "truncated fixed32" if @pos + 4 > @buf.bytesize

            v = @buf.byteslice(@pos, 4)
            @pos += 4
            v
          else
            raise ArgumentError, "unsupported wire type #{wire}"
          end
        @last_chunk = @buf.byteslice(start...@pos)
        yield number, wire, value
      end
    end
  end

  class FieldModel
    attr_reader :number, :name, :type, :type_name

    def initialize(number, name, field_type, label, type_name)
      @number = number
      @name = name
      @type = field_type
      @repeated = label == LABEL_REPEATED
      @type_name = type_name # for TYPE_MESSAGE, e.g. ".echo.EchoRequest"
    end

    def repeated?
      @repeated
    end
  end

  class MessageModel
    attr_reader :full_name, :fields, :by_name

    def initialize(full_name, fields)
      @full_name = full_name
      @fields = fields # number -> FieldModel
      @by_name = {}
      fields.each_value { |f| @by_name[f.name] = f }
    end

    def refresh_by_name
      @by_name = {}
      @fields.each_value { |f| @by_name[f.name] = f }
    end
  end

  class MethodModel
    attr_reader :name, :path, :kind, :input, :output

    def initialize(name, path, kind, input_model, output_model)
      @name = name
      @path = path
      @kind = kind
      @input = input_model
      @output = output_model
    end
  end

  class ServiceModel
    attr_reader :full_name, :methods

    def initialize(full_name, methods)
      @full_name = full_name
      @methods = methods # name -> MethodModel
    end
  end

  # Parsed descriptor set: messages and services by full name.
  class FileModel
    attr_reader :messages, :services

    def initialize
      @messages = {} # ".echo.EchoRequest" -> MessageModel
      @services = {} # "echo.Echo" -> ServiceModel
    end

    def message(full_name)
      @messages.fetch(full_name)
    end

    def service(full_name)
      @services.fetch(full_name)
    end
  end

  # A message as field number -> list of values (descriptor order).
  #
  # Fields not in the model are retained as raw encoded chunks in
  # `unknown` (protobuf unknown-field retention): a decode ->
  # encode round trip re-emits them after the known fields, so
  # intermediate hops do not strip newer fields.
  class GenericMessage
    attr_accessor :model
    attr_reader :values, :unknown

    def initialize(model = nil)
      @model = model
      @values = {}
      @unknown = []
    end

    def set(number, value)
      @values[number] = [value]
      self
    end

    def add(number, value)
      (@values[number] ||= []) << value
      self
    end

    def get_all(number)
      (@values[number] || []).dup
    end

    def get(number, default = nil)
      items = @values[number]
      items && !items.empty? ? items[0] : default
    end

    def get_string(number, default = "")
      value = get(number)
      value.is_a?(String) ? value : default
    end

    def get_int(number, default = 0)
      value = get(number)
      value.is_a?(Integer) ? value : default
    end

    def ==(other)
      other.is_a?(GenericMessage) && @values == other.values
    end

    def inspect
      "GenericMessage(#{@values.inspect})"
    end
  end

  class << self
    def encode_varint(value)
      out = String.new(encoding: Encoding::BINARY)
      v = value & 0xFFFFFFFFFFFFFFFF
      while v > 0x7F
        out << ((v & 0x7F) | 0x80)
        v >>= 7
      end
      out << v
      out
    end

    def encode_generic(model, message, file_model)
      out = String.new(encoding: Encoding::BINARY)
      message.values.keys.sort.each do |number|
        field = model.fields[number]
        if field.nil?
          raise StatusError.new(CODE_INVALID_ARGUMENT, "unknown field #{number} for #{model.full_name}")
        end

        values = message.values[number]
        if field.repeated?
          values.each { |value| out << encode_value(field, value, file_model) }
        elsif !values.empty?
          out << encode_value(field, values[0], file_model)
        end
      end
      (message.unknown || []).each { |chunk| out << chunk }
      out
    end

    def decode_generic(model, data, file_model)
      message = GenericMessage.new(model)
      reader = PbReader.new(data)
      reader.each_field do |number, wire, raw|
        field = model.fields[number]
        if field.nil?
          # Unknown field: retain the raw encoded chunk verbatim.
          message.unknown << reader.last_chunk
          next
        end
        (message.values[number] ||= []) << decode_value(field, wire, raw, file_model)
      end
      message
    end

    # Parse FileDescriptorSet bytes into a FileModel.
    def parse_descriptor_set(data)
      file_model = FileModel.new
      pending_services = []
      PbReader.new(data).each_field do |number, _wire, file_bytes|
        next unless number == 1

        package = ""
        service_types = []
        fields_of_file = PbReader.new(file_bytes).each_field.to_a
        fields_of_file.each do |fnum, _w, fval|
          package = fval.dup.force_encoding(Encoding::UTF_8) if fnum == 2
        end
        fields_of_file.each do |fnum, _w, fval|
          case fnum
          when 4 then parse_message(package, fval, file_model)
          when 6 then service_types << [package, fval]
          end
        end
        pending_services.concat(service_types)
      end
      pending_services.each { |package, bytes| parse_service(package, bytes, file_model) }
      file_model
    end

    # Register a runtime-built service on a Grpcdc::Server.
    #
    # handler is an object with methods by kind:
    #   unary(ctx, method, request) -> GenericMessage
    #   server_stream(ctx, method, request, send) -> nil
    #   client_stream(ctx, method, request_enum) -> GenericMessage
    #   bidi(ctx, method, request_enum, send) -> nil
    # where send is a callable taking a GenericMessage and
    # request_enum yields GenericMessages until half-close.
    def register_dynamic_service(server, file_model, service_name, handler)
      service = file_model.services.fetch(service_name)
      methods = service.methods.values.map do |method|
        Method.new(method.name, method.path, method.kind, make_handler(handler, method, file_model))
      end
      server.register_service(ServiceDesc.new(service.full_name, methods))
    end

    private

    def to_signed(value, bits)
      value &= (1 << bits) - 1
      value >= (1 << (bits - 1)) ? value - (1 << bits) : value
    end

    def zigzag_decode(value)
      (value >> 1) ^ -(value & 1)
    end

    def zigzag_encode(value)
      ((value << 1) ^ (value >> 63)) & 0xFFFFFFFFFFFFFFFF
    end

    def encode_value(field, value, file_model)
      wire = WIRE_TYPE.fetch(field.type)
      out = encode_varint((field.number << 3) | wire)
      case wire
      when 0
        if [TYPE_SINT32, TYPE_SINT64].include?(field.type)
          bits = field.type == TYPE_SINT32 ? 32 : 64
          out << encode_varint(zigzag_encode(value) & ((1 << bits) - 1))
        elsif field.type == TYPE_BOOL
          out << encode_varint(value ? 1 : 0)
        else
          out << encode_varint(value & 0xFFFFFFFFFFFFFFFF)
        end
      when 1
        out << if field.type == TYPE_DOUBLE
                 [value].pack("E")
               elsif field.type == TYPE_SFIXED64
                 [value].pack("q<")
               else
                 [value & 0xFFFFFFFFFFFFFFFF].pack("Q<")
               end
      when 5
        out << if field.type == TYPE_FLOAT
                 [value].pack("e")
               elsif field.type == TYPE_SFIXED32
                 [value].pack("l<")
               else
                 [value & 0xFFFFFFFF].pack("V")
               end
      else
        data =
          case field.type
          when TYPE_STRING then value.encode(Encoding::UTF_8).b
          when TYPE_MESSAGE then encode_generic(file_model.messages.fetch(field.type_name), value, file_model)
          else value.b
          end
        out << encode_varint(data.bytesize)
        out << data
      end
      out
    end

    def decode_value(field, wire, raw, file_model)
      case wire
      when 0
        case field.type
        when TYPE_BOOL then raw != 0
        when TYPE_SINT32, TYPE_SINT64 then zigzag_decode(raw)
        when TYPE_INT32, TYPE_ENUM then to_signed(raw, 32)
        when TYPE_INT64 then to_signed(raw, 64)
        else raw
        end
      when 1
        case field.type
        when TYPE_DOUBLE then raw.unpack1("E")
        when TYPE_SFIXED64 then raw.unpack1("q<")
        else raw.unpack1("Q<")
        end
      when 5
        case field.type
        when TYPE_FLOAT then raw.unpack1("e")
        when TYPE_SFIXED32 then raw.unpack1("l<")
        else raw.unpack1("V")
        end
      else
        # length-delimited
        case field.type
        when TYPE_STRING then raw.dup.force_encoding(Encoding::UTF_8)
        when TYPE_MESSAGE then decode_generic(file_model.messages.fetch(field.type_name), raw, file_model)
        else raw.b
        end
      end
    end

    def parse_message(package, data, file_model)
      name = ""
      raw_fields = []
      nested = []
      PbReader.new(data).each_field do |fnum, _w, fval|
        case fnum
        when 1 then name = fval.dup.force_encoding(Encoding::UTF_8)
        when 2 then raw_fields << fval
        when 3 then nested << fval
        end
      end
      full_name = package.empty? ? name : "#{package}.#{name}"
      fields = {}
      model = MessageModel.new(full_name, fields)
      file_model.messages["." + full_name] = model
      nested.each { |bytes| parse_nested(package, name, bytes, file_model) }
      raw_fields.each do |field_bytes|
        field = parse_field(field_bytes)
        fields[field.number] = field
      end
      model.refresh_by_name
      model
    end

    def parse_nested(package, outer, data, file_model)
      name = ""
      raw_fields = []
      PbReader.new(data).each_field do |fnum, _w, fval|
        case fnum
        when 1 then name = fval.dup.force_encoding(Encoding::UTF_8)
        when 2 then raw_fields << fval
        end
      end
      full_name = package.empty? ? "#{outer}.#{name}" : "#{package}.#{outer}.#{name}"
      fields = {}
      model = MessageModel.new(full_name, fields)
      file_model.messages["." + full_name] = model
      raw_fields.each do |field_bytes|
        field = parse_field(field_bytes)
        fields[field.number] = field
      end
      model.refresh_by_name
      model
    end

    def parse_field(data)
      name = ""
      number = 0
      label = 1
      field_type = 0
      type_name = ""
      PbReader.new(data).each_field do |fnum, _w, fval|
        case fnum
        when 1 then name = fval.dup.force_encoding(Encoding::UTF_8)
        when 3 then number = fval
        when 4 then label = fval
        when 5 then field_type = fval
        when 6 then type_name = fval.dup.force_encoding(Encoding::UTF_8)
        end
      end
      FieldModel.new(number, name, field_type, label, type_name)
    end

    def kind_of(client_streaming, server_streaming)
      if client_streaming && server_streaming
        KIND_BIDI
      elsif server_streaming
        KIND_SERVER_STREAMING
      elsif client_streaming
        KIND_CLIENT_STREAMING
      else
        KIND_UNARY
      end
    end

    def parse_service(package, data, file_model)
      name = ""
      raw_methods = []
      PbReader.new(data).each_field do |fnum, _w, fval|
        case fnum
        when 1 then name = fval.dup.force_encoding(Encoding::UTF_8)
        when 2 then raw_methods << fval
        end
      end
      full_name = package.empty? ? name : "#{package}.#{name}"
      methods = {}
      raw_methods.each do |method_bytes|
        mname = ""
        input_type = ""
        output_type = ""
        client_streaming = false
        server_streaming = false
        PbReader.new(method_bytes).each_field do |fnum, _w, fval|
          case fnum
          when 1 then mname = fval.dup.force_encoding(Encoding::UTF_8)
          when 2 then input_type = fval.dup.force_encoding(Encoding::UTF_8)
          when 3 then output_type = fval.dup.force_encoding(Encoding::UTF_8)
          when 5 then client_streaming = fval != 0
          when 6 then server_streaming = fval != 0
          end
        end
        methods[mname] = MethodModel.new(
          mname, "/#{full_name}/#{mname}", kind_of(client_streaming, server_streaming),
          file_model.messages.fetch(input_type), file_model.messages.fetch(output_type)
        )
      end
      service = ServiceModel.new(full_name, methods)
      file_model.services[full_name] = service
      service
    end

    def make_handler(handler, method, file_model)
      lambda do |ctx, reqs, sink|
        send = lambda do |generic|
          sink.send(encode_generic(method.output, generic, file_model))
        end
        request_enum = Enumerator.new do |yielder|
          loop do
            begin
              payload = reqs.recv_raw
            rescue EOFError
              break
            end
            yielder << decode_generic(method.input, payload, file_model)
          end
        end
        case method.kind
        when KIND_UNARY
          send.call(handler.unary(ctx, method, request_enum.next))
        when KIND_SERVER_STREAMING
          handler.server_stream(ctx, method, request_enum.next, send)
        when KIND_CLIENT_STREAMING
          send.call(handler.client_stream(ctx, method, request_enum))
        else
          handler.bidi(ctx, method, request_enum, send)
        end
      end
    end
  end

  # Adapts a (MessageModel, GenericMessage) pair to the Channel
  # marshal/unmarshal contract.
  class BoundMessage
    attr_reader :model, :file_model
    attr_accessor :generic

    def initialize(model, generic, file_model)
      @model = model
      @generic = generic || GenericMessage.new(model)
      @file_model = file_model
    end

    def marshal_dc
      Grpcdc.encode_generic(@model, @generic, @file_model)
    end

    def unmarshal_dc(data)
      @generic = Grpcdc.decode_generic(@model, data, @file_model)
      self
    end
  end

  class DynamicRecvStream
    include Enumerable

    def initialize(stream, model, file_model)
      @stream = stream
      @model = model
      @file_model = file_model
    end

    def recv
      @stream.recv(BoundMessage.new(@model, nil, @file_model)).generic
    end

    # Abandon the call early: RST unless it already terminated.
    def cancel
      @stream.cancel
    end

    def close
      @stream.cancel
    end

    def each
      return enum_for(:each) unless block_given?

      begin
        loop do
          begin
            yield recv
          rescue EOFError
            return
          end
        end
      ensure
        # Breaking out of the block abandons the call: RST so
        # the server stops producing (no-op once terminated).
        close
      end
    end
  end

  # Runtime-built client: methods resolve from the FileModel.
  class DynamicClient
    def initialize(channel, file_model)
      @channel = channel
      @model = file_model
    end

    def unary(service_name, method_name, request, metadata = nil, timeout: nil)
      method = resolve(service_name, method_name)
      resp = BoundMessage.new(method.output, nil, @model)
      @channel.unary(method.path, BoundMessage.new(method.input, request, @model), resp, metadata, timeout: timeout)
      resp.generic
    end

    def server_stream(service_name, method_name, request, metadata = nil, timeout: nil)
      method = resolve(service_name, method_name)
      stream = @channel.server_stream(
        method.path, BoundMessage.new(method.input, request, @model), metadata, timeout: timeout
      )
      DynamicRecvStream.new(stream, method.output, @model)
    end

    def client_stream(service_name, method_name, requests, metadata = nil, timeout: nil)
      method = resolve(service_name, method_name)
      resp = BoundMessage.new(method.output, nil, @model)
      @channel.client_stream(
        method.path, requests.map { |r| BoundMessage.new(method.input, r, @model) }, resp, metadata, timeout: timeout
      )
      resp.generic
    end

    def bidi(service_name, method_name, requests, metadata = nil, timeout: nil)
      method = resolve(service_name, method_name)
      stream = @channel.bidi(
        method.path, requests.map { |r| BoundMessage.new(method.input, r, @model) }, metadata, timeout: timeout
      )
      DynamicRecvStream.new(stream, method.output, @model)
    end

    private

    def resolve(service_name, method_name)
      @model.services.fetch(service_name).methods.fetch(method_name)
    end
  end
end
GRPC_RUNTIME_EOF
)

(define ruby-init-body
#<<GRPC_RUNTIME_EOF
# grpcdc: gRPC over WebRTC DataChannels (generated runtime).

require_relative "grpcdc/wire_gen"
require_relative "grpcdc/codec"
require_relative "grpcdc/endpoint"
require_relative "grpcdc/channel"
require_relative "grpcdc/server"
require_relative "grpcdc/loopback"
require_relative "grpcdc/sidecar"
require_relative "grpcdc/dynamic"
GRPC_RUNTIME_EOF
)

(define ruby-dispatch-arms
  '((HEADERS    . "on_headers(stream_id, payload)")
    (DATA       . "push_event(stream_id, StreamEvent.new(EVENT_DATA, payload: payload))")
    (HALF-CLOSE . "push_event(stream_id, StreamEvent.new(EVENT_HALF_CLOSE))")
    (TRAILERS   . "on_terminal(stream_id, payload, EVENT_TRAILERS)")
    (RST        . "on_terminal(stream_id, payload, EVENT_RST)")))

(define (emit-ruby-dispatch)
  (string-append
   "      case frame_type\n"
   (apply string-append
          (for/list ([e (in-list frame-table)])
            (format "      when ~a then ~a\n"
                    (second e)
                    (let ([arm (assoc (first e) ruby-dispatch-arms)])
                      (unless arm
                        (error 'runtime-ruby "no Ruby dispatch arm for ~a" (first e)))
                      (cdr arm)))))
   "      end\n"))

(define (emit-ruby-runtime-files)
  (list
   (cons "grpcdc.rb" ruby-init-body)
   (cons "grpcdc/codec.rb" ruby-codec-body)
   (cons "grpcdc/endpoint.rb"
         (string-replace ruby-endpoint-body "@@FRAME_DISPATCH@@" (emit-ruby-dispatch)))
   (cons "grpcdc/channel.rb" ruby-channel-body)
   (cons "grpcdc/server.rb" ruby-server-body)
   (cons "grpcdc/loopback.rb" ruby-loopback-body)
   (cons "grpcdc/sidecar.rb" ruby-sidecar-body)
   (cons "grpcdc/dynamic.rb" ruby-dynamic-body)))
