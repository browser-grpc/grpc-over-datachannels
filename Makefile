# C++ WASM facade: generated callback client over the JS bridge,
# zig c++ wasm32-wasi reactor without exceptions (Zig's wasm32
# libc++ has no exception runtime; see wasm/cpp/bridge.hpp).
test-cpp-wasm-browser:
	$(ZIG) c++ -target wasm32-wasi -std=c++17 -O1 -mexec-model=reactor \
		-fno-exceptions -fno-rtti -Iwasm/cpp \
		-Wl,--export=_initialize -Wl,--export=run_echo_client \
		-Wl,--export=wasm_alloc -Wl,--export=wasm_free \
		-Wl,--export=on_bridge_message -Wl,--export=on_bridge_done \
		-Wl,--export=on_bridge_error \
		wasm/cpp/bridge.cpp wasm/cpp/echo_client.cpp \
		-o browser-test/echo_cpp.wasm
	$(ZIG) c++ -target wasm32-wasi -std=c++17 -O1 -mexec-model=reactor \
		-fno-exceptions -fno-rtti -Iwasm/cpp \
		-Wl,--export=_initialize -Wl,--export=run_echo_server \
		-Wl,--export=wasm_alloc -Wl,--export=wasm_free \
		-Wl,--export=serve_unary -Wl,--export=serve_serverStream \
		-Wl,--export=serve_clientStream -Wl,--export=serve_bidi \
		wasm/cpp/bridge.cpp wasm/cpp/echo_server.cpp \
		-o browser-test/echo_cpp_server.wasm
	cd browser-test && node wasm_facade.test.mjs C++ "wasm_facade_page.html?wasm=/browser-test/echo_cpp.wasm" all
	$(BRIDGE_GEN)
	cd browser-test && node wasm_facade.test.mjs C++ "wasm_facade_rust_page.html?wasm=/browser-test/echo_cpp.wasm" all
	cd browser-test && node wasm_cpp_facade_server.test.mjs all
	$(ZIG) c++ -target wasm32-wasi -std=c++17 -O1 -mexec-model=reactor \
		-fno-exceptions -fno-rtti -Iwasm/cpp \
		-Wl,--export=_initialize -Wl,--export=run_echo_stream_server \
		-Wl,--export=wasm_alloc -Wl,--export=wasm_free \
		-Wl,--export=serve_clientStreamStart -Wl,--export=serve_clientStreamFeed \
		-Wl,--export=serve_clientStreamEnd -Wl,--export=serve_bidiStart \
		-Wl,--export=serve_bidiFeed -Wl,--export=serve_bidiEnd \
		wasm/cpp/bridge.cpp wasm/cpp/echo_stream_server.cpp \
		-o browser-test/echo_cpp_stream_server.wasm
	cd browser-test && node wasm_cpp_stream_server.test.mjs all

WASI_SDK ?= $(firstword $(wildcard $(HOME)/.local/wasi-sdk-33 /usr/local/wasi-sdk-33 /opt/wasi-sdk-33))
WASI_CXX ?= $(WASI_SDK)/bin/clang++

# Native C++ WASM runtime: the real grpcdc runtime + native
# generated stub (cpp/examples) in a Web Worker over a
# SharedArrayBuffer mailbox, endpoint in inline pump mode.
# Needs wasi-sdk 33's exception-enabled libc++ (eh multilib) —
# Zig's wasm32 libc++ has no exception runtime and the native
# runtime throws StatusException. Installed by Dockerfile.ci
# (developer machines: ~/.local/wasi-sdk-33, same version).
test-cpp-wasm-native-browser:
	$(WASI_CXX) -target wasm32-wasip1 -std=c++17 -O1 -mexec-model=reactor \
		-fwasm-exceptions -mllvm -wasm-use-legacy-eh=false \
		-Icpp -I. -Iwasm/cpp/native \
		-L$(WASI_SDK)/share/wasi-sysroot/lib/wasm32-wasip1/eh -lunwind \
		-Wl,--export=_initialize -Wl,--export=run_echo_client -Wl,--export=run_echo_client_tracing \
		wasm/cpp/native/echo_client.cpp \
		-o browser-test/echo_cpp_native.wasm
	$(WASI_CXX) -target wasm32-wasip1 -std=c++17 -O1 -mexec-model=reactor \
		-fwasm-exceptions -mllvm -wasm-use-legacy-eh=false \
		-Icpp -I. -Iwasm/cpp/native \
		-L$(WASI_SDK)/share/wasi-sysroot/lib/wasm32-wasip1/eh -lunwind \
		-Wl,--export=_initialize -Wl,--export=run_echo_server -Wl,--export=run_echo_server_tracing \
		wasm/cpp/native/echo_server.cpp \
		-o browser-test/echo_cpp_native_server.wasm
	$(WASI_CXX) -target wasm32-wasip1 -std=c++17 -O1 -mexec-model=reactor \
		-fwasm-exceptions -mllvm -wasm-use-legacy-eh=false \
		-Icpp -I. -Iwasm/cpp/native \
		-L$(WASI_SDK)/share/wasi-sysroot/lib/wasm32-wasip1/eh -lunwind \
		-Wl,--export=_initialize -Wl,--export=run_echo_tracing \
		wasm/cpp/native/echo_tracing.cpp \
		-o browser-test/echo_cpp_native_tracing.wasm
	cd browser-test && node wasm_cpp_native.test.mjs all
	cd browser-test && node wasm_cpp_native_server.test.mjs all
	cd browser-test && node wasm_cpp_tracing.test.mjs all

WASM_LD ?= wasm-ld
SWIFT_WASM_LIBDIR ?= $(shell $(SWIFTC) -print-target-info 2>/dev/null | sed -n 's/.*"runtimeResourcePath": "\([^"]*\)".*/\1/p')/embedded/wasm32-unknown-none-wasm

# Swift WASM facade: Embedded Swift (wasm32-unknown-none-wasm,
# no Foundation) over the JS bridge. swiftc emits the object;
# wasm-ld links it with the bump-allocator support in
# wasm/swift/support.c and the toolchain's Unicode tables.
test-swift-wasm-browser:

	$(SWIFTC) -target wasm32-unknown-none-wasm \
		-enable-experimental-feature Embedded \
		-enable-experimental-feature Extern -wmo -O \
		-c wasm/swift/bridge.swift wasm/swift/EchoWasmGrpcDc.swift \
		swift/grpcdc/Wire.swift swift/examples/Pb.swift \
		swift/examples/EchoMessages.swift wasm/swift/echo_server.swift \
		-o wasm/swift/build/echo_swift_server.o
	$(WASM_LD) --no-entry --allow-undefined \
		--export=run_echo_server --export=wasm_alloc --export=wasm_free \
		--export=serve_unary --export=serve_serverStream \
		--export=serve_clientStream --export=serve_bidi \
		wasm/swift/build/echo_swift_server.o wasm/swift/build/support.o \
		$(SWIFT_WASM_LIBDIR)/libswiftUnicodeDataTables.a \
		$(SWIFT_WASM_LIBDIR)/libswiftEmbeddedPlatformPOSIX.a \
		$(SWIFT_WASM_LIBDIR)/libswiftExclusivitySingleThreaded.a \
		-o browser-test/echo_swift_server.wasm
	cd browser-test && node wasm_swift_facade_server.test.mjs all
	$(SWIFTC) -target wasm32-unknown-none-wasm \
		-enable-experimental-feature Embedded \
		-enable-experimental-feature Extern -wmo -O \
		-c wasm/swift/bridge.swift wasm/swift/EchoWasmGrpcDc.swift \
		swift/grpcdc/Wire.swift swift/examples/Pb.swift \
		swift/examples/EchoMessages.swift wasm/swift/echo_stream_server.swift \
		-o wasm/swift/build/echo_swift_stream_server.o
	$(WASM_LD) --no-entry --allow-undefined \
		--export=run_echo_stream_server --export=wasm_alloc --export=wasm_free \
		--export=serve_clientStreamStart --export=serve_clientStreamFeed \
		--export=serve_clientStreamEnd --export=serve_bidiStart \
		--export=serve_bidiFeed --export=serve_bidiEnd \
		wasm/swift/build/echo_swift_stream_server.o wasm/swift/build/support.o \
		$(SWIFT_WASM_LIBDIR)/libswiftUnicodeDataTables.a \
		$(SWIFT_WASM_LIBDIR)/libswiftEmbeddedPlatformPOSIX.a \
		$(SWIFT_WASM_LIBDIR)/libswiftExclusivitySingleThreaded.a \
		-o browser-test/echo_swift_stream_server.wasm
	cd browser-test && node wasm_swift_stream_server.test.mjs all

	mkdir -p wasm/swift/build
	$(SWIFTC) -target wasm32-unknown-none-wasm \
		-enable-experimental-feature Embedded \
		-enable-experimental-feature Extern -wmo -O \
		-c wasm/swift/bridge.swift wasm/swift/EchoWasmGrpcDc.swift \
		swift/grpcdc/Wire.swift swift/examples/Pb.swift \
		swift/examples/EchoMessages.swift wasm/swift/echo_client.swift \
		-o wasm/swift/build/echo_swift.o
	$(ZIG) cc -target wasm32-freestanding -O1 -c wasm/swift/support.c \
		-o wasm/swift/build/support.o
	$(WASM_LD) --no-entry --allow-undefined \
		--export=run_echo_client --export=wasm_alloc --export=wasm_free \
		--export=on_bridge_message --export=on_bridge_done \
		--export=on_bridge_error \
		wasm/swift/build/echo_swift.o wasm/swift/build/support.o \
		$(SWIFT_WASM_LIBDIR)/libswiftUnicodeDataTables.a \
		$(SWIFT_WASM_LIBDIR)/libswiftEmbeddedPlatformPOSIX.a \
		$(SWIFT_WASM_LIBDIR)/libswiftExclusivitySingleThreaded.a \
		-o browser-test/echo_swift.wasm
	cd browser-test && node wasm_facade.test.mjs Swift "wasm_facade_page.html?wasm=/browser-test/echo_swift.wasm" all
	$(BRIDGE_GEN)
	cd browser-test && node wasm_facade.test.mjs Swift "wasm_facade_rust_page.html?wasm=/browser-test/echo_swift.wasm" all

# Native Swift WASM runtime: the real grpcdc runtime +
# native generated stub as Embedded Swift
# (wasm32-unknown-none-wasm, no Foundation; inline pump mode)
# in a Web Worker over a SharedArrayBuffer mailbox.
test-swift-wasm-native-browser:
	mkdir -p wasm/swift/build
	$(SWIFTC) -target wasm32-unknown-none-wasm \
		-enable-experimental-feature Embedded \
		-enable-experimental-feature Extern -wmo -O \
		-c swift/grpcdc/Status.swift swift/grpcdc/Wire.swift \
		swift/grpcdc/Codec.swift swift/grpcdc/Transport.swift \
		swift/grpcdc/Endpoint.swift swift/grpcdc/Channel.swift \
		swift/grpcdc/Server.swift swift/grpcdc/MemoryTransport.swift \
		swift/examples/Pb.swift swift/examples/EchoMessages.swift \
		swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift \
		wasm/swift/native/dc_transport.swift \
		wasm/swift/native/echo_client.swift \
		wasm/swift/native/echo_server.swift \
		wasm/swift/native/echo_tracing.swift \
		-o wasm/swift/build/echo_swift_native.o
	$(ZIG) cc -target wasm32-freestanding -O1 -c wasm/swift/support.c \
		-o wasm/swift/build/support.o
	$(WASM_LD) --no-entry --allow-undefined \
		--export=run_echo_client --export=run_echo_server --export=run_echo_tracing \
		--export=run_echo_client_tracing --export=run_echo_server_tracing \
		wasm/swift/build/echo_swift_native.o wasm/swift/build/support.o \
		$(SWIFT_WASM_LIBDIR)/libswiftUnicodeDataTables.a \
		$(SWIFT_WASM_LIBDIR)/libswiftEmbeddedPlatformPOSIX.a \
		$(SWIFT_WASM_LIBDIR)/libswiftExclusivitySingleThreaded.a \
		-o browser-test/echo_swift_native.wasm
	cd browser-test && node wasm_swift_native.test.mjs all
	cd browser-test && node wasm_swift_native_server.test.mjs all
	cd browser-test && node wasm_swift_tracing.test.mjs all

KOTLINC_JS ?= kotlinc-js
KOTLIN_WASM_STDLIB ?= $(firstword $(wildcard $(HOME)/.local/kotlin-dist/kotlinc/lib/kotlin-stdlib-wasm-js.klib /usr/local/kotlinc/lib/kotlin-stdlib-wasm-js.klib))

# Kotlin/Wasm facade: generated callback client over the JS
# bridge via Kotlin/Wasm JS interop. Two-step CLI build (KLIB,
# then JS+WASM) as the K2 compiler requires; the Wasm stdlib
# klib is a pinned Maven artifact installed by Dockerfile.ci
# (developer machines: ~/.local/kotlin-dist, same version).
test-kotlin-wasm-browser:
	rm -rf wasm/kotlin/build browser-test/kotlin_wasm_gen
	mkdir -p wasm/kotlin/build browser-test/kotlin_wasm_gen
	$(KOTLINC_JS) -Xwasm -Xwasm-target=wasm-js \
		-libraries $(KOTLIN_WASM_STDLIB) \
		-ir-output-dir wasm/kotlin/build -ir-output-name echo_kotlin \
		-module-kind es -target es2015 -main noCall -Xir-produce-klib-file \
		wasm/kotlin/bridge.kt wasm/kotlin/Pb.kt \
		wasm/kotlin/grpcdc/Transport.kt \
		wasm/kotlin/EchoMessages.kt wasm/kotlin/EchoWasmGrpcDc.kt \
		wasm/kotlin/echo_client.kt wasm/kotlin/echo_server_facade.kt
	$(KOTLINC_JS) -Xwasm -Xwasm-target=wasm-js \
		-Xwasm-use-new-exception-proposal \
		-libraries $(KOTLIN_WASM_STDLIB) \
		-Xinclude=wasm/kotlin/build/echo_kotlin.klib \
		-ir-output-dir browser-test/kotlin_wasm_gen \
		-ir-output-name echo_kotlin \
		-module-kind es -target es2015 -main noCall -Xir-produce-js
	cd browser-test && node wasm_facade.test.mjs Kotlin wasm_kotlin_page.html all
	$(BRIDGE_GEN)
	cd browser-test && node wasm_facade.test.mjs Kotlin wasm_kotlin_rust_page.html all
	cd browser-test && node wasm_kotlin_facade_server.test.mjs all
	cd browser-test && node wasm_kotlin_stream_server.test.mjs all

