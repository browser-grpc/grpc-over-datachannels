generate: plugins stubs direct-examples coverage-docs

## Regenerate the WebRTC-Direct examples + compose wiring
direct-examples:
	$(RACKET) racket/direct-examples-gen.rkt

## Per-language TESTS.md: links to each language's tests/examples
coverage-docs:
	$(RACKET) racket/coverage-doc-gen.rkt

## Descriptor compatibility gate (racket/compat.rkt): fails on
## wire/API-breaking schema changes vs the committed baseline.
compat:
	$(RACKET) racket/compat.rkt fixtures/echo_descriptor_set.baseline.bin fixtures/echo_descriptor_set.bin

## Accept a deliberate breaking schema change: refresh the baseline.
update-baseline:
	cp fixtures/echo_descriptor_set.bin fixtures/echo_descriptor_set.baseline.bin

## Generated-source drift gate: every generated file (runtimes,
## stubs, fixtures, BDD.md and the per-language scenario tables) is
## a pure function of the Racket sources, so regenerating must be
## byte-stable. Hash the source tree, regenerate, hash again; any
## difference means a generated file was hand-edited or a Racket
## change was not regenerated — either way the docs/tests would
## silently disagree with the implementation, so fail.
## CI status across the generated public repos (latest
## CI run each; exit 1 when any is red). --watch via
## CI_WATCH=1 polls until nothing is in progress.
ci-status:
	node scripts/ci-status.mjs $(if $(CI_WATCH),--watch,)

check-generated:
	@before=$$(find . -path ./.git -prune -o -path ./node_modules -prune -o -path '*/target' -prune -o -path '*/build' -prune -o -path '*/node_modules' -prune -o -path './browser-test/scalajs_gen' -prune -o -path '*/.scala-build' -prune -o -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1); \
	$(MAKE) --no-print-directory generate; \
	after=$$(find . -path ./.git -prune -o -path ./node_modules -prune -o -path '*/target' -prune -o -path '*/build' -prune -o -path '*/node_modules' -prune -o -path './browser-test/scalajs_gen' -prune -o -path '*/.scala-build' -prune -o -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1); \
	if [ "$$before" != "$$after" ]; then echo "check-generated: FAIL (generated files drift from Racket sources; run make generate and commit the result)"; exit 1; fi; \
	echo "check-generated: OK (generated tree is byte-stable)"

# Serve the built SPA locally with the COOP/COEP headers the
# in-browser Racket/Wasm plugin runner requires (SharedArrayBuffer).
webapp-serve: webapp-dist
	python3 scripts/serve-webapp.py webapp/dist 8006

test-racket:
	raco test racket/tests/

test-rust:
	cd rust && $(CARGO) test

test-rust-nostd:
	python3 scripts/test-rust-nostd.py

test-js:
	cd js && node --test test/*.test.js

test-go:
	cd go && go test -race ./...

test-webrtc-rust:
	cd webrtc/rust && $(CARGO) test

# IoT/embedded proof: bare-metal net-stack tests (ICE/DHCP over
# raw Ethernet), the two-device cable bring-up example, and the
# no_std cross-builds (in test-webrtc-nostd).
test-iot:
	cd webrtc/rust && $(CARGO) test --test net_stack && $(CARGO) run --example iot_cable

# Bare-metal core proof: the protocol core (ICE/DTLS/SCTP/DCEP/
# SDP/STUN/net/platform) compiles with no std at all — host
# --no-default-features plus wasm32 (no std exists there) and
# thumbv7em-none-eabihf (Cortex-M: no 64-bit atomics, no OS) so
# std cannot sneak back in.
test-webrtc-nostd:
	cd webrtc/rust && $(CARGO) build --no-default-features && $(CARGO) build --no-default-features --target wasm32-unknown-unknown && $(CARGO) build --no-default-features --target thumbv7em-none-eabihf

test-webrtc-js: wasm-cores-gen
	cd webrtc/js && npm test

## Supported TCP<->DataChannel proxy (proxy/grpc-dc-proxy.mjs):
## generated JS client over a real DataChannel through the
## proxy to a stock HTTP/2 backend (unary/stream/error paths).
test-proxy:
	node --test proxy/proxy.test.mjs
	node --test proxy/rust_proxy.test.mjs
	node --test proxy/http2_corpus.test.mjs
	cd proxy/tcp-sidecar && cargo test --offline

# The Go WebRTC stack links the Rust cores by default
# (crates/dc-*-ffi cdylibs, in-repo release paths in the
# bindings' cgo directives), so build them first.
test-webrtc-go:
	cd crates/dc-sctp-ffi && cargo build --release
	cd crates/dc-dtls-ffi && cargo build --release
	cd crates/dc-ice-ffi && cargo build --release
	cd webrtc/go && go test -race ./...

# Live-network smoke tests: gather a server-reflexive
# candidate from Google's public STUN server in all three
# native stacks plus a real browser RTCPeerConnection. These
# need public UDP egress, so locally they are opt-in
# (GRPC_DC_LIVE_STUN); in CI they run for real via
# test-live-stun-ci below.
test-live-stun:
	cd webrtc/go && GRPC_DC_LIVE_STUN=1 go test -run TestLiveStunSrflx -v .
	cd webrtc/js && GRPC_DC_LIVE_STUN=1 node --test test/live_stun.test.js
	cd webrtc/rust && GRPC_DC_LIVE_STUN=1 $(CARGO) test --test live_stun -- --nocapture
	cd browser-test && GRPC_DC_LIVE_STUN=1 node live_stun.test.mjs all

# CI gate for the live STUN tests: part of `make test`, but
# only actually dials out when CI=true (GitHub Actions sets
# it; its runners have public egress). A bare local
# `make test` stays hermetic and just prints the skip.
test-live-stun-ci:
	@if [ -n "$$CI" ]; then \
		$(MAKE) test-live-stun; \
	else \
		echo "test-live-stun-ci: SKIP (CI not set; run 'make test-live-stun' for the live check)"; \
	fi

# Opt-in double-NAT end-to-end test (NOT in the default gate):
# two peers behind separate kernel NATs (netns + MASQUERADE)
# exchange real gRPC traffic in both directions. Needs root
# netns privileges, so it runs inside the CI image.
CI_IMAGE ?= grpc-dc-ci:latest
test-nat-e2e:
	docker run --rm --user root --privileged \
		-v $(CURDIR):/work -w /work $(CI_IMAGE) bash -c \
		'command -v ip >/dev/null 2>&1 || (apt-get update -qq && apt-get install -y -qq iproute2 iptables); bash scripts/nat-e2e.sh'

