# grpc-over-datachannels — generation and test entry points.
#
# The protoc plugins, the wire_gen tables AND the language runtimes
# (rust/src/*.rs, js/src/*.js, go/*.go) are GENERATED by the Racket
# metaprogram from racket/{spec,template-*,runtime-*}.rkt; never edit
# bin/, rust/gen/, generated stubs or runtime files by hand — edit the
# Racket sources and run `make generate`.

RACKET ?= racket
PROTOC ?= protoc
CARGO  ?= cargo

.PHONY: generate plugins stubs compat update-baseline test test-racket test-rust test-js test-go test-python test-java test-csharp test-cpp test-swift test-kotlin test-dart test-zig test-lua test-ruby test-webrtc-rust test-webrtc-js test-webrtc-go test-grpc-webrtc test-browser test-wasm test-zig-wasm-browser test-dart-browser test-dart-wasm-browser demos clean-gen

## Regenerate plugins + wire tables + fixtures from racket/spec.rkt
plugins:
	$(RACKET) racket/metagen.rkt
	$(PROTOC) --descriptor_set_out=fixtures/echo_descriptor_set.bin -I proto proto/echo.proto

## Regenerate service stubs for proto/echo.proto
stubs:
	mkdir -p rust/gen js/examples go/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-rust=bin/protoc-gen-grpc-dc-rust \
		--grpc-dc-rust_out=rust/gen -I proto proto/echo.proto
	$(PROTOC) --plugin=protoc-gen-grpc-dc-js=bin/protoc-gen-grpc-dc-js \
		--grpc-dc-js_out=js/examples -I proto proto/echo.proto
	$(PROTOC) --plugin=protoc-gen-grpc-dc-go=bin/protoc-gen-grpc-dc-go \
		--grpc-dc-go_out=go/examples -I proto proto/echo.proto
	gofmt -w go/examples/echo_grpc_dc.go
	mkdir -p python/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-python=bin/protoc-gen-grpc-dc-python \
		--grpc-dc-python_out=python/examples -I proto proto/echo.proto
	mkdir -p java/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-java=bin/protoc-gen-grpc-dc-java \
		--grpc-dc-java_out=java/examples -I proto proto/echo.proto
	mkdir -p csharp/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-csharp=bin/protoc-gen-grpc-dc-csharp \
		--grpc-dc-csharp_out=csharp/examples -I proto proto/echo.proto
	mkdir -p cpp/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-cpp=bin/protoc-gen-grpc-dc-cpp \
		--grpc-dc-cpp_out=cpp/examples -I proto proto/echo.proto
	mkdir -p swift/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-swift=bin/protoc-gen-grpc-dc-swift \
		--grpc-dc-swift_out=swift/examples -I proto proto/echo.proto
	mkdir -p kotlin/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-kotlin=bin/protoc-gen-grpc-dc-kotlin \
		--grpc-dc-kotlin_out=kotlin/examples -I proto proto/echo.proto
	mkdir -p dart/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-dart=bin/protoc-gen-grpc-dc-dart \
		--grpc-dc-dart_out=dart/examples -I proto proto/echo.proto
	mkdir -p zig/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-zig=bin/protoc-gen-grpc-dc-zig \
		--grpc-dc-zig_out=zig/examples -I proto proto/echo.proto
	mkdir -p lua/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-lua=bin/protoc-gen-grpc-dc-lua \
		--grpc-dc-lua_out=lua/examples -I proto proto/echo.proto
	mkdir -p ruby/examples
	$(PROTOC) --plugin=protoc-gen-grpc-dc-ruby=bin/protoc-gen-grpc-dc-ruby \
		--grpc-dc-ruby_out=ruby/examples -I proto proto/echo.proto
	mkdir -p wasm/go
	$(PROTOC) --plugin=protoc-gen-grpc-dc-wasm-go=bin/protoc-gen-grpc-dc-wasm-go \
		--grpc-dc-wasm-go_out=wasm/go -I proto proto/echo.proto
	gofmt -w wasm/go/echo_wasm_dc.go
	mkdir -p wasm/zig
	$(PROTOC) --plugin=protoc-gen-grpc-dc-wasm-zig=bin/protoc-gen-grpc-dc-wasm-zig \
		--grpc-dc-wasm-zig_out=wasm/zig -I proto proto/echo.proto

generate: plugins stubs

## Descriptor compatibility gate (racket/compat.rkt): fails on
## wire/API-breaking schema changes vs the committed baseline.
compat:
	$(RACKET) racket/compat.rkt fixtures/echo_descriptor_set.baseline.bin fixtures/echo_descriptor_set.bin

## Accept a deliberate breaking schema change: refresh the baseline.
update-baseline:
	cp fixtures/echo_descriptor_set.bin fixtures/echo_descriptor_set.baseline.bin

test-racket:
	raco test racket/tests/

test-rust:
	cd rust && $(CARGO) test

test-js:
	cd js && node --test test/*.test.js

test-go:
	cd go && go test -race ./...

test-webrtc-rust:
	cd webrtc/rust && $(CARGO) test

test-webrtc-js:
	cd webrtc/js && npm test

test-webrtc-go:
	cd webrtc/go && go test -race ./...

test-python:
	cd python && python3 -m unittest discover -s tests

test-java:
	cd java && mkdir -p build && javac -encoding UTF-8 -d build $$(find grpcdc examples tests -name '*.java') \
		&& java -cp build tests.TestCodec && java -cp build tests.TestEcho \
		&& java -cp build tests.TestInterop && java -cp build tests.TestOracle \
		&& java -cp build tests.TestDynamic && java -cp build tests.TestBdd

test-csharp:
	cd csharp && dotnet build tests/Tests.csproj --nologo -v q \
		&& dotnet build examples/EchoServerStdio/EchoServerStdio.csproj --nologo -v q \
		&& dotnet build examples/EchoClientStdio/EchoClientStdio.csproj --nologo -v q \
		&& dotnet run --project tests --no-build -- TestCodec \
		&& dotnet run --project tests --no-build -- TestEcho \
		&& dotnet run --project tests --no-build -- TestInterop \
		&& dotnet build examples/DynamicEchoServerStdio/DynamicEchoServerStdio.csproj --nologo -v q \
		&& dotnet run --project tests --no-build -- TestOracle \
		&& dotnet run --project tests --no-build -- TestDynamic \
		&& dotnet run --project tests --no-build -- TestBdd

CXX ?= g++
CXXFLAGS ?= -std=c++17 -pthread -O1 -Icpp -I.

test-cpp:
	mkdir -p cpp/build
	$(CXX) $(CXXFLAGS) cpp/tests/main.cpp cpp/tests/test_codec.cpp cpp/tests/test_echo.cpp cpp/tests/test_interop.cpp cpp/tests/test_oracle.cpp cpp/tests/test_dynamic.cpp cpp/tests/test_bdd.cpp -o cpp/build/tests
	$(CXX) $(CXXFLAGS) cpp/examples/echo_server_stdio.cpp -o cpp/build/echo_server_stdio
	$(CXX) $(CXXFLAGS) cpp/examples/echo_client_stdio.cpp -o cpp/build/echo_client_stdio
	$(CXX) $(CXXFLAGS) cpp/examples/dynamic_echo_server_stdio.cpp -o cpp/build/dynamic_echo_server_stdio
	cd cpp && ./build/tests TestCodec && ./build/tests TestEcho \
		&& ./build/tests TestInterop && ./build/tests TestOracle \
		&& ./build/tests TestDynamic && ./build/tests TestBdd

SWIFTC ?= swiftc
SWIFTFLAGS ?= -swift-version 5 -O -o

test-swift:
	mkdir -p swift/build
	$(SWIFTC) -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/DynamicEchoService.swift swift/tests/*.swift -o swift/build/tests
	$(SWIFTC) -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/EchoServerStdio/main.swift -o swift/build/echo_server_stdio
	$(SWIFTC) -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/EchoClientStdio/main.swift -o swift/build/echo_client_stdio
	$(SWIFTC) -swift-version 5 -O swift/grpcdc/*.swift swift/examples/StdioTransport.swift swift/examples/DynamicEchoService.swift swift/examples/DynamicEchoServerStdio/main.swift -o swift/build/dynamic_echo_server_stdio
	cd swift && ./build/tests TestCodec && ./build/tests TestEcho \
		&& ./build/tests TestInterop && ./build/tests TestOracle \
		&& ./build/tests TestDynamic && ./build/tests TestBdd

KOTLINC ?= kotlinc

test-kotlin:
	mkdir -p kotlin/build
	$(KOTLINC) -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/DynamicEchoService.kt kotlin/tests/*.kt -d kotlin/build/tests.jar
	$(KOTLINC) -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/EchoServerStdio/Main.kt -d kotlin/build/echo_server_stdio.jar
	$(KOTLINC) -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/EchoClientStdio/Main.kt -d kotlin/build/echo_client_stdio.jar
	$(KOTLINC) -include-runtime kotlin/grpcdc/*.kt kotlin/examples/StdioTransport.kt kotlin/examples/DynamicEchoService.kt kotlin/examples/DynamicEchoServerStdio/Main.kt -d kotlin/build/dynamic_echo_server_stdio.jar
	java -jar kotlin/build/tests.jar TestCodec && java -jar kotlin/build/tests.jar TestEcho \
		&& java -jar kotlin/build/tests.jar TestInterop && java -jar kotlin/build/tests.jar TestOracle \
		&& java -jar kotlin/build/tests.jar TestDynamic && java -jar kotlin/build/tests.jar TestBdd

DART ?= dart

test-dart:
	mkdir -p dart/build
	$(DART) compile exe dart/tests/main.dart -o dart/build/tests
	$(DART) compile exe dart/examples/EchoServerStdio/main.dart -o dart/build/echo_server_stdio
	$(DART) compile exe dart/examples/EchoClientStdio/main.dart -o dart/build/echo_client_stdio
	$(DART) compile exe dart/examples/DynamicEchoServerStdio/main.dart -o dart/build/dynamic_echo_server_stdio
	cd dart && ./build/tests TestCodec && ./build/tests TestEcho \
		&& ./build/tests TestInterop && ./build/tests TestOracle \
		&& ./build/tests TestDynamic && ./build/tests TestBdd

ZIG ?= zig

test-zig:
	cd zig && rm -rf build .zig-cache && $(ZIG) build --prefix build
	cd zig && ./build/bin/tests TestCodec && ./build/bin/tests TestEcho \
		&& ./build/bin/tests TestInterop && ./build/bin/tests TestOracle \
		&& ./build/bin/tests TestDynamic && ./build/bin/tests TestBdd

LUA ?= lua

test-lua:
	LUA=$(LUA) $(LUA) lua/tests/main.lua TestCodec \
		&& LUA=$(LUA) $(LUA) lua/tests/main.lua TestEcho \
		&& LUA=$(LUA) $(LUA) lua/tests/main.lua TestInterop \
		&& LUA=$(LUA) $(LUA) lua/tests/main.lua TestOracle \
		&& LUA=$(LUA) $(LUA) lua/tests/main.lua TestDynamic \
		&& LUA=$(LUA) $(LUA) lua/tests/main.lua TestBdd

RUBY ?= ruby

test-ruby:
	RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestCodec \
		&& RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestEcho \
		&& RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestInterop \
		&& RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestOracle \
		&& RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestDynamic \
		&& RUBY=$(RUBY) $(RUBY) ruby/tests/main.rb TestBdd

test-grpc-webrtc:
	cd rust && $(CARGO) test --features webrtc

test-browser:
	cd webrtc/rust && cargo build --example peer_echo
	cd browser-test && npm test

ifneq (,$(wildcard $(HOME)/.local/wasm-bindgen/wasm-bindgen))
WASM_BINDGEN ?= $(HOME)/.local/wasm-bindgen/wasm-bindgen
else
WASM_BINDGEN ?= wasm-bindgen
endif

test-wasm:
	cd wasm/go && GOOS=js GOARCH=wasm go build -o ../../browser-test/echo.wasm ./cmd/echo_wasm
	cp $$(go env GOROOT)/lib/wasm/wasm_exec.js browser-test/wasm_exec.js
	cd wasm/rust && cargo build --release --target wasm32-unknown-unknown
	$(WASM_BINDGEN) --target web --out-dir ../../browser-test/wasm_rust_gen wasm/rust/target/wasm32-unknown-unknown/release/grpc_dc_wasm_rust.wasm
	cd browser-test && node wasm.test.mjs all && node wasm_rust.test.mjs all

test-zig-wasm-browser:
	$(ZIG) build-exe -target wasm32-freestanding -O ReleaseSmall -fno-entry -fPIC -rdynamic \
		--dep grpcdc_status --dep echo_messages \
		-Mroot=wasm/zig/echo_client.zig -Mgrpcdc_status=zig/grpcdc/status.zig \
		-Mecho_messages=zig/examples/echo_messages.zig \
		-femit-bin=browser-test/echo_zig.wasm
	cd browser-test && node wasm_zig.test.mjs all

test-dart-browser:
	$(DART) compile js wasm/dart/echo_client.dart -o browser-test/echo_dart.js
	cd browser-test && node dart.test.mjs all

test-dart-wasm-browser:
	$(DART) compile wasm wasm/dart/echo_client.dart -o browser-test/echo_dart_wasm.wasm
	cd browser-test && node dart_wasm.test.mjs all

test: test-racket compat test-rust test-js test-go test-python test-java test-csharp test-cpp test-swift test-kotlin test-dart test-zig test-lua test-ruby test-webrtc-rust test-webrtc-js test-webrtc-go test-grpc-webrtc test-browser test-wasm test-zig-wasm-browser test-dart-browser test-dart-wasm-browser

demos:
	cd rust && $(CARGO) run --example echo_demo
	node js/examples/echo_demo.js
	cd go && go run ./examples/echo_demo

clean-gen:
	rm -f bin/protoc-gen-grpc-dc-kotlin bin/protoc-gen-grpc-dc-rust bin/protoc-gen-grpc-dc-js bin/protoc-gen-grpc-dc-go bin/protoc-gen-grpc-dc-wasm-go bin/protoc-gen-grpc-dc-wasm-zig bin/protoc-gen-grpc-dc-cpp bin/protoc-gen-grpc-dc-swift
	rm -f rust/gen/echo_grpc_dc.rs js/examples/echo_grpc_dc.js go/examples/echo_grpc_dc.go wasm/go/echo_wasm_dc.go wasm/zig/echo_wasm_dc.zig cpp/examples/echo_grpc_dc.hpp swift/examples/EchoGrpcDc.swift kotlin/examples/EchoGrpcDc.kt
	rm -f rust/src/wire_gen.rs js/wire_gen.js go/wire_gen.go fixtures/vectors.json
	rm -f rust/src/{lib,codec,status,message,transport,endpoint,channel,server,webrtc_transport}.rs
	rm -f js/src/{codec,endpoint,channel,server,loopback}.js
	rm -f go/{codec,endpoint,channel,server,loopback}.go
