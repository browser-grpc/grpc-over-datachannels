(define (seg-ref node key)
  (if (eq? key 'impl-name)
    (hash-ref node 'impl-name (hash-ref node 'name))
    (hash-ref node key #f)))

(define (run-segments
         program
         node
         svc
         (model #f)
         (args '())
         (err "return err"))
  (run-env program (list model node svc args err node 0)))

(define (run-env program env)
  (apply
   string-append
   (for/list ((seg (in-list program))) (run-segment seg env))))

(define (env-model env) (first env))

(define (env-node env) (second env))

(define (env-svc env) (third env))

(define (env-args env) (fourth env))

(define (env-err env) (fifth env))

(define (env-root env) (sixth env))

(define (env-index env) (seventh env))

(define (env-with
         env
         #:model
         (model (env-model env))
         #:node
         (node (env-node env))
         #:args
         (args (env-args env))
         #:err
         (err (env-err env))
         #:root
         (root (env-root env))
         #:index
         (index (env-index env)))
  (list model node (env-svc env) args err root index))

(define seg-rust-no-std (make-parameter #f))

(define (seg-truthy? v) (not (or (not v) (equal? v "") (equal? v 0))))

(define (seg-pascal s)
  (string-join
   (map
    (lambda (part)
      (if (string=? part "")
        ""
        (string-append
         (string (char-upcase (string-ref part 0)))
         (substring part 1))))
    (string-split s "_"))
   ""))

(define (seg-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (seg-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'run-segments "unresolved type ~a" type-name))))

(define (seg-entry-type entry)
  (seg-flat
   (hash-ref entry 'pkg)
   (if (eq? (hash-ref entry 'kind) 'enum)
     (hash-ref entry 'full)
     (hash-ref (hash-ref entry 'msg) 'full-name))))

(define (seg-entry-type-of model node)
  (if (hash-has-key? node 'type-name)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name)))
    (seg-entry-type node)))

(define (seg-field-type model f)
  (define type (hash-ref f 'type))
  (define base
    (cond
     ((= type 11)
      (define entry (seg-resolve model (hash-ref f 'type-name)))
      (if (eq? (hash-ref entry 'kind) 'map)
        (let* ((entry-msg (hash-ref entry 'msg))
               (kf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 1))
                 (hash-ref entry-msg 'fields)))
               (vf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 2))
                 (hash-ref entry-msg 'fields))))
          (format
           "map[~a]~a"
           (seg-field-type model (hash-set kf 'label 1))
           (seg-field-type model (hash-set vf 'label 1))))
        (string-append "*" (seg-entry-type entry))))
     ((= type 14) (seg-entry-type (seg-resolve model (hash-ref f 'type-name))))
     (else (scalar-type-entry 'go type))))
  (if (= (hash-ref f 'label) 3)
    (if (and (= type 11)
             (eq?
              (hash-ref (seg-resolve model (hash-ref f 'type-name)) 'kind)
              'map))
      base
      (string-append "[]" base))
    base))

(define (seg-category model node)
  (define type (hash-ref node 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map))
    "map")
   ((= type 11) "message")
   ((memv type varint-scalar-types) "varint")
   ((assv type (fixed-scalar-table 'go)) "fixed")
   ((= type 9) "string")
   ((= type 12) "bytes")
   (else "other")))

(define (seg-fixed-info node)
  (assv (hash-ref node 'type) (fixed-scalar-table 'go)))

(define (seg-zero node)
  (case (hash-ref node 'type)
    ((11 12) "nil")
    ((9) "\"\"")
    ((8) "false")
    (else "0")))

(define (seg-set-expr sib)
  (define v (format "m.~a" (seg-pascal (hash-ref sib 'name))))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a != nil" v))
    ((9) (format "~a != \"\"" v))
    ((12) (format "len(~a) > 0" v))
    ((8) v)
    (else (format "~a != 0" v))))

(define (seg-oneof-clearing model node)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "\t\t\tm.~a = ~a\n"
       (seg-pascal (hash-ref sib 'name))
       (seg-zero sib)))
    (oneof-siblings model node))))

(define (seg-lower-first s0)
  (define s (if (symbol? s0) (symbol->string s0) s0))
  (if (string=? s "")
    s
    (string-append (string (char-downcase (string-ref s 0))) (substring s 1))))

(define (seg-js-name f)
  (define jn (hash-ref f 'json-name ""))
  (if (and jn (not (string=? jn "")))
    jn
    (regexp-replace*
     #rx"_([a-zA-Z0-9])"
     (hash-ref f 'name)
     (lambda (all c) (string-upcase c)))))

(define (seg-snake-case s0)
  (define s (if (symbol? s0) (symbol->string s0) s0))
  (list->string
   (for/fold
    ((out '()) (prev-lower? #f) #:result (reverse out))
    ((c (in-string s)))
    (cond
     ((char-upper-case? c)
      (values
       (cons
        (char-downcase c)
        (if (and prev-lower? (not (null? out))) (cons #\_ out) out))
       #f))
     (else (values (cons c out) #t))))))

(define (seg-rs-camel s0)
  (define s (if (symbol? s0) (symbol->string s0) s0))
  (apply
   string-append
   (map
    (lambda (p)
      (if (string=? p "")
        ""
        (string-append
         (string (char-upcase (string-ref p 0)))
         (string-downcase (substring p 1)))))
    (string-split s "_"))))

(define seg-rs-keywords
  '("type"
    "ref"
    "box"
    "self"
    "Self"
    "crate"
    "super"
    "move"
    "static"
    "mut"
    "fn"
    "struct"
    "enum"
    "impl"
    "trait"
    "loop"
    "match"
    "mod"
    "pub"
    "use"
    "where"
    "async"
    "await"
    "dyn"
    "abstract"
    "become"
    "do"
    "final"
    "macro"
    "override"
    "priv"
    "typeof"
    "unsized"
    "virtual"
    "yield"
    "try"
    "gen"))

(define (seg-rs-field-name f)
  (define name
    (string-join
     (map string-downcase (string-split (hash-ref f 'name) "_"))
     "_"))
  (if (member name seg-rs-keywords) (string-append "r#" name) name))

(define (seg-rs-entry-ref model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (define flat
    (seg-flat
     (hash-ref entry 'pkg)
     (or (hash-ref entry 'full #f)
         (if (eq? (hash-ref entry 'kind) 'enum)
           (let ((e (hash-ref entry 'enum)))
             (if (hash-ref entry 'msg)
               (format
                "~a.~a"
                (hash-ref (hash-ref entry 'msg) 'full-name)
                (hash-ref e 'name))
               (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name))))
           (hash-ref (hash-ref entry 'msg) 'full-name)))))
  (if (or (eq? (hash-ref entry 'kind) 'map)
          (equal? (hash-ref entry 'file) (hash-ref model 'name)))
    flat
    (format
     "crate::~a_pb::~a"
     (path->string
      (path-replace-extension (file-name-from-path (hash-ref entry 'file)) ""))
     (if (eq? (hash-ref entry 'kind) 'enum)
       (hash-ref (hash-ref entry 'enum) 'name)
       flat))))

(define (seg-rb-snake s0)
  (define s (if (symbol? s0) (symbol->string s0) s0))
  (apply
   string-append
   (for/list
    ((c (in-string s)) (i (in-naturals)))
    (cond
     ((char-upper-case? c)
      (string-append (if (> i 0) "_" "") (string (char-downcase c))))
     (else (string c))))))

(define (seg-rb-module-name entry)
  (string-append
   (seg-pascal
    (path->string
     (path-replace-extension (file-name-from-path (hash-ref entry 'file)) "")))
   "Pb"))

(define (seg-rb-stub-ref model node key)
  (define e (seg-resolve model (hash-ref node key)))
  (format
   "~a::~a"
   (seg-rb-module-name e)
   (seg-flat (hash-ref e 'pkg) (hash-ref (hash-ref e 'msg) 'full-name))))

(define (seg-rb-entry-ref model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (define local
    (seg-flat
     (hash-ref entry 'pkg)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (let ((e (hash-ref entry 'enum)))
         (if (hash-ref entry 'msg)
           (format
            "~a.~a"
            (hash-ref (hash-ref entry 'msg) 'full-name)
            (hash-ref e 'name))
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name))))
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (or (eq? (hash-ref entry 'kind) 'map)
          (equal? (hash-ref entry 'file) (hash-ref model 'name)))
    local
    (format
     "~a::~a"
     (seg-rb-module-name entry)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (hash-ref (hash-ref entry 'enum) 'name)
       (seg-flat
        (hash-ref entry 'pkg)
        (hash-ref (hash-ref entry 'msg) 'full-name))))))

(define (seg-later-oneof-cond model node)
  (define later (oneof-later-siblings model node))
  (if (null? later) "" (string-join (map seg-set-expr later) " || ")))

(define (seg-eval seg env)
  (define node (env-node env))
  (define model (env-model env))
  (cond
   ((string? seg) seg)
   ((number? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply
     format
     (if (list? (second seg)) (seg-eval (second seg) env) (second seg))
     (map
      (lambda (e)
        (define v (seg-eval e env))
        (if (symbol? v) (symbol->string v) v))
      (cddr seg))))
   ((eq? (car seg) 'ref)
    (if (null? (cddr seg))
      (seg-ref node (second seg))
      (foldl (lambda (k acc) (hash-ref acc k)) node (cdr seg))))
   ((eq? (car seg) 'svc) (env-svc env))
   ((eq? (car seg) 'arg) (list-ref (env-args env) (second seg)))
   ((eq? (car seg) 'err-stmt) (env-err env))
   ((eq? (car seg) 'self) node)
   ((eq? (car seg) 'root) (env-root env))
   ((eq? (car seg) 'distinct-count)
    (define kinds-part
      (and (pair? (cdddr seg))
           (list? (fourth seg))
           (eq? (car (fourth seg)) 'kinds)
           (cdr (fourth seg))))
    (length
     (remove-duplicates
      (map
       (lambda (el) (hash-ref el (third seg)))
       (filter
        (lambda (el)
          (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
        (seg-eval (second seg) env))))))
   ((memq
     (car seg)
     '(if case-on
        when
        guarded
        kind-case
        each
        each+
        each-siblings
        each-sep
        each-unique))
    (run-segment seg env))
   ((eq? (car seg) 'pascal) (seg-pascal (seg-eval (second seg) env)))
   ((eq? (car seg) 'lower-first) (seg-lower-first (seg-eval (second seg) env)))
   ((eq? (car seg) 'js-name) (seg-js-name node))
   ((eq? (car seg) 'js-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'js-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'bigint-type)
    (and (memv (hash-ref node 'type) '(3 4 18 6 16)) #t))
   ((eq? (car seg) 'entry-flat) (seg-entry-type node))
   ((eq? (car seg) 'resolved-flat)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name))))
   ((eq? (car seg) 'index) (env-index env))
   ((eq? (car seg) 'snake-case) (seg-snake-case (seg-eval (second seg) env)))
   ((eq? (car seg) 'rs-camel) (seg-rs-camel (seg-eval (second seg) env)))
   ((eq? (car seg) 'rs-field-name) (seg-rs-field-name node))
   ((eq? (car seg) 'rs-map-type)
    (if (seg-rust-no-std) "BTreeMap" "std::collections::HashMap"))
   ((eq? (car seg) 'rs-entry-ref) (seg-rs-entry-ref model node))
   ((eq? (car seg) 'rs-scalar-type)
    (scalar-type-entry 'rust (hash-ref node 'type)))
   ((eq? (car seg) 'rs-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'rust))))
   ((eq? (car seg) 'rs-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'rust))))
   ((eq? (car seg) 'flat-of)
    (seg-flat (hash-ref model 'package) (seg-eval (second seg) env)))
   ((eq? (car seg) 'rust-enum-fragment) (rust-enum-fragment (second seg)))
   ((eq? (car seg) 'enum-first-value-name)
    (hash-ref
     (car
      (hash-ref
       (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'enum)
       'values))
     'name))
   ((eq? (car seg) 'enum-first-value-num)
    (hash-ref
     (car
      (hash-ref
       (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'enum)
       'values))
     'number))
   ((eq? (car seg) 'rb-snake) (seg-rb-snake (seg-eval (second seg) env)))
   ((eq? (car seg) 'stub-ref) (seg-rb-stub-ref model node (second seg)))
   ((eq? (car seg) 'rb-entry-ref)
    (seg-rb-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'rb-model-module)
    (string-append
     (seg-pascal
      (path->string
       (path-replace-extension
        (file-name-from-path (hash-ref model 'name))
        "")))
     "Pb"))
   ((eq? (car seg) 'rb-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'ruby))))
   ((eq? (car seg) 'rb-fixed-fmt)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'ruby))))
   ((eq? (car seg) 'flat)
    (seg-flat (hash-ref model 'package) (hash-ref node 'full-name)))
   ((eq? (car seg) 'entry-type) (seg-entry-type-of model node))
   ((eq? (car seg) 'field-type) (seg-field-type model node))
   ((eq? (car seg) 'field-type-of)
    (seg-field-type model (seg-eval (second seg) env)))
   ((eq? (car seg) 'resolved-entry)
    (seg-resolve model (hash-ref node 'type-name)))
   ((eq? (car seg) 'key-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 1))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'val-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 2))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'with-label)
    (hash-set (seg-eval (second seg) env) 'label (third seg)))
   ((eq? (car seg) 'get) (hash-ref (seg-eval (second seg) env) (third seg)))
   ((eq? (car seg) 'fixed-name) (third (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-size) (second (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-wire) (if (= (second (seg-fixed-info node)) 8) 1 5))
   ((eq? (car seg) 'type) (hash-ref node 'type))
   ((eq? (car seg) 'category) (seg-category model node))
   ((eq? (car seg) 'category-of)
    (seg-category model (seg-eval (second seg) env)))
   ((eq? (car seg) 'proto2) (equal? (hash-ref model 'syntax "") "proto2"))
   ((eq? (car seg) 'type-is) (= (hash-ref node 'type) (second seg)))
   ((eq? (car seg) 'is-varint)
    (and (memv (hash-ref node 'type) varint-scalar-types) #t))
   ((eq? (car seg) 'is-fixed) (and (seg-fixed-info node) #t))
   ((eq? (car seg) 'is-map)
    (and (= (hash-ref node 'type) 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map)))
   ((eq? (car seg) 'repeated) (= (hash-ref node 'label) 3))
   ((eq? (car seg) 'has-default) (and (field-explicit-default node) #t))
   ((eq? (car seg) 'any-default)
    (for/or
     ((f (in-list (hash-ref node 'fields))))
     (field-explicit-default f)))
   ((eq? (car seg) 'no-fields) (null? (hash-ref node 'fields)))
   ((eq? (car seg) 'default-raw) (field-explicit-default node))
   ((eq? (car seg) 'enum-default-num) (enum-default-number model node))
   ((eq? (car seg) 'oneof-clearing) (seg-oneof-clearing model node))
   ((eq? (car seg) 'later-oneof-cond) (seg-later-oneof-cond model node))
   ((eq? (car seg) 'call)
    (run-env
     (hash-ref segment-programs (second seg))
     (env-with env #:args (map (lambda (e) (seg-eval e env)) (cddr seg)))))
   ((eq? (car seg) 'call-on)
    (run-env
     (hash-ref segment-programs (third seg))
     (env-with
      env
      #:node
      (seg-eval (second seg) env)
      #:args
      (map (lambda (e) (seg-eval e env)) (cdddr seg)))))
   (else (error 'run-segments "bad expression: ~e" seg))))

(define (run-segment seg env)
  (define node (env-node env))
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'if)
    (define then-segs (cdr (assq 'then (cddr seg))))
    (define else-part (assq 'else (cddr seg)))
    (if (seg-truthy? (seg-eval (second seg) env))
      (run-env then-segs env)
      (if else-part (run-env (cdr else-part) env) "")))
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch
      (or (for/first
           ((b (in-list (cdr seg)))
            #:when
            (or (eq? (car b) kind) (and (list? (car b)) (memq kind (car b)))))
           b)
          (assq 'else (cdr seg))))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-env (cdr branch) env))
   ((eq? (car seg) 'case-on)
    (define val (seg-eval (second seg) env))
    (define raw (cddr seg))
    (define (branch-key? b)
      (and (list? b)
           (pair? b)
           (or (number? (car b))
               (string? (car b))
               (eq? (car b) 'else)
               (and (list? (car b)) (andmap number? (car b))))))
    (define branches
      (cond
       ((and (= (length raw) 1)
             (list? (car raw))
             (andmap branch-key? (car raw)))
        (car raw))
       (else
        (map
         (lambda (b)
           (if (and (list? b) (= (length b) 1) (list? (car b))) (car b) b))
         raw))))
    (define branch
      (for/first
       ((b (in-list branches))
        #:when
        (or (eq? (car b) 'else)
            (member val (if (list? (car b)) (car b) (list (car b))) equal?)))
       b))
    (if branch (run-env (cdr branch) env) ""))
   ((eq? (car seg) 'when)
    (if (seg-truthy? (seg-eval (second seg) env)) (run-env (cddr seg) env) ""))
   ((eq? (car seg) 'guarded)
    (define text (run-env (cddddr seg) env))
    (define cond-str
      (string-join
       (map
        (lambda (sib)
          (run-env
           (hash-ref segment-programs (second seg))
           (env-with env #:node sib)))
        (oneof-later-siblings (env-model env) node))
       " || "))
    (if (equal? cond-str "")
      text
      (string-append
       (format (third seg) cond-str)
       (if (string-suffix? text "\n") text (string-append text "\n"))
       (fourth seg))))
   ((eq? (car seg) 'fail)
    (error 'run-segments "unsupported field type ~a" (hash-ref node 'type)))
   ((eq? (car seg) 'each)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items)) (i (in-naturals)))
      (run-env segs (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each+)
    (define aliases
      (if (eq? (third seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (apply
     string-append
     (for/list
      ((el (in-list (append (hash-ref node (second seg)) aliases)))
       (i (in-naturals)))
      (run-env (cdddr seg) (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each-siblings)
    (apply
     string-append
     (for/list
      ((sib (in-list (oneof-siblings (env-model env) node))) (i (in-naturals)))
      (run-env (cdr seg) (env-with env #:node sib #:index i)))))
   ((eq? (car seg) 'each-unique)
    (define rest (cdddr seg))
    (define kinds-part
      (and (pair? rest)
           (list? (car rest))
           (eq? (car (car rest)) 'kinds)
           (cdr (car rest))))
    (when kinds-part (set! rest (cdr rest)))
    (define or-first?
      (and (pair? rest) (list? (car rest)) (eq? (car (car rest)) 'or-first)))
    (when or-first? (set! rest (cdr rest)))
    (define all (hash-ref node (second seg)))
    (define filtered
      (filter
       (lambda (el)
         (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
       all))
    (define seen (mutable-set))
    (define uniq
      (filter
       (lambda (el)
         (define v (hash-ref el (third seg)))
         (and (not (set-member? seen v)) (set-add! seen v)))
       filtered))
    (apply
     string-append
     (for/list
      ((el (in-list (if (and or-first? (null? uniq)) (list (car all)) uniq)))
       (i (in-naturals)))
      (run-env rest (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each-sep)
    (define-values (keys segs) (splitf-at (cddr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (string-join
     (for/list
      ((el (in-list items)) (i (in-naturals)))
      (run-env segs (env-with env #:node el #:index i)))
     (second seg)))
   (else (seg-eval seg env))))

(define current-service (make-parameter ""))

(define (snake sym)
  (define s (symbol->string sym))
  (apply
   string-append
   (for/list
    ((c (in-string s)) (i (in-naturals)))
    (cond
     ((char-upper-case? c)
      (string-append (if (> i 0) "_" "") (string (char-downcase c))))
     (else (string c))))))

(define (py-deprecated m)
  (if (hash-ref m 'deprecated #f)
    "        \"\"\"Deprecated: marked deprecated in the proto schema.\"\"\"\n        import warnings as _warnings; _warnings.warn(\"deprecated\", DeprecationWarning, stacklevel=2)\n"
    ""))

(define (py-client-method/raw pb m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    def ~a(self, req, metadata=None, timeout=None):\n"
       "~a        return self._channel.unary(~s, req, ~a.~a(), metadata, timeout)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((server-streaming)
     (format
      (string-append
       "    def ~a(self, req, metadata=None, timeout=None):\n"
       "~a        stream = self._channel.server_stream(~s, req, metadata, timeout)\n"
       "        return _RecvStream(stream, ~a.~a)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((client-streaming)
     (format
      (string-append
       "    def ~a(self, reqs, metadata=None, timeout=None):\n"
       "~a        return self._channel.client_stream(~s, reqs, ~a.~a(), metadata, timeout)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((bidi)
     (format
      (string-append
       "    def ~a(self, reqs, metadata=None, timeout=None):\n"
       "~a        stream = self._channel.bidi(~s, reqs, metadata, timeout)\n"
       "        return _RecvStream(stream, ~a.~a)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))))

(define (py-client-method pb m) (py-client-method/raw pb m))

(define (py-async-client-method/raw pb m)
  (define name (hash-ref m 'name))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    async def ~a(self, req, metadata=None, timeout=None):\n"
       "~a        return await self._channel.unary(~s, req, ~a.~a(), metadata, timeout)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((server-streaming)
     (format
      (string-append
       "    async def ~a(self, req, metadata=None, timeout=None):\n"
       "~a        stream = await self._channel.server_stream(~s, req, metadata, timeout)\n"
       "        return _AsyncRecvStream(stream, ~a.~a)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((client-streaming)
     (format
      (string-append
       "    async def ~a(self, reqs, metadata=None, timeout=None):\n"
       "~a        return await self._channel.client_stream(~s, reqs, ~a.~a(), metadata, timeout)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))
    ((bidi)
     (format
      (string-append
       "    async def ~a(self, reqs, metadata=None, timeout=None):\n"
       "~a        stream = await self._channel.bidi(~s, reqs, metadata, timeout)\n"
       "        return _AsyncRecvStream(stream, ~a.~a)\n\n")
      name
      (py-deprecated m)
      path
      pb
      resp))))

(define (py-server-handler pb m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    def _~a_handler(ctx, reqs, sink):\n"
       "        req = reqs.recv_into(~a.~a())\n"
       "        resp = impl.~a(ctx, req)\n"
       "        sink.send(resp.marshal_dc())\n\n")
      name
      pb
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "    def _~a_handler(ctx, reqs, sink):\n"
       "        req = reqs.recv_into(~a.~a())\n"
       "        impl.~a(req, _SendStream(ctx, sink))\n\n")
      name
      pb
      req
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "    def _~a_handler(ctx, reqs, sink):\n"
       "        stream = _ClientStreamImpl(ctx, reqs, ~a.~a)\n"
       "        impl.~a(stream)\n"
       "        if stream.resp is None:\n"
       "            raise grpcdc.StatusError(grpcdc.CODE_INTERNAL, \"client-streaming handler never called SendAndClose\")\n"
       "        sink.send(stream.resp.marshal_dc())\n\n")
      name
      pb
      req
      impl-name))
    ((bidi)
     (format
      (string-append
       "    def _~a_handler(ctx, reqs, sink):\n"
       "        impl.~a(_BidiStream(ctx, reqs, sink, ~a.~a))\n\n")
      name
      impl-name
      pb
      req))))

(define (py-method-entry m)
  (define kind-name
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (format
   "        grpcdc.Method(~s, ~s, grpcdc.~a, _~a_handler),\n"
   (hash-ref m 'name)
   (hash-ref m 'path)
   kind-name
   (hash-ref m 'name)))

(define py-stream-helpers
  (string-append
   "class _RecvStream:\n"
   "    \"\"\"Client receiving stream: recv() raises EOFError at end.\"\"\"\n\n"
   "    def __init__(self, stream, resp_cls):\n"
   "        self._stream = stream\n"
   "        self._resp_cls = resp_cls\n\n"
   "    def recv(self):\n"
   "        if self._stream is None:\n"
   "            raise EOFError(\"stream closed\")\n"
   "        return self._stream.recv(self._resp_cls())\n\n"
   "    def close(self):\n"
   "        \"\"\"Abandon the call early: RST so the server stops.\"\"\"\n"
   "        stream, self._stream = self._stream, None\n"
   "        if stream is not None:\n"
   "            stream.cancel()\n\n"
   "    def __del__(self):\n"
   "        self.close()\n\n"
   "    def __enter__(self):\n"
   "        return self\n\n"
   "    def __exit__(self, *exc):\n"
   "        self.close()\n"
   "        return False\n\n"
   "    def __iter__(self):\n"
   "        return self\n\n"
   "    def __next__(self):\n"
   "        try:\n"
   "            return self.recv()\n"
   "        except EOFError:\n"
   "            raise StopIteration\n\n\n"
   "class _SendStream:\n"
   "    \"\"\"Server-streaming sink passed to service implementations.\"\"\"\n\n"
   "    def __init__(self, ctx, sink):\n"
   "        self.context = ctx\n"
   "        self._sink = sink\n\n"
   "    def send(self, resp):\n"
   "        self._sink.send(resp.marshal_dc())\n\n\n"
   "class _ClientStreamImpl:\n"
   "    \"\"\"Client-streaming stream passed to service implementations.\"\"\"\n\n"
   "    def __init__(self, ctx, reqs, req_cls):\n"
   "        self.context = ctx\n"
   "        self._reqs = reqs\n"
   "        self._req_cls = req_cls\n"
   "        self.resp = None\n\n"
   "    def recv(self):\n"
   "        return self._reqs.recv_into(self._req_cls())\n\n"
   "    def send_and_close(self, resp):\n"
   "        self.resp = resp\n\n\n"
   "class _BidiStream:\n"
   "    \"\"\"Bidi stream passed to service implementations.\"\"\"\n\n"
   "    def __init__(self, ctx, reqs, sink, req_cls):\n"
   "        self.context = ctx\n"
   "        self._reqs = reqs\n"
   "        self._sink = sink\n"
   "        self._req_cls = req_cls\n\n"
   "    def send(self, resp):\n"
   "        self._sink.send(resp.marshal_dc())\n\n"
   "    def recv(self):\n"
   "        return self._reqs.recv_into(self._req_cls())\n\n\n"
   "class _AsyncRecvStream:\n"
   "    \"\"\"Async client receiving stream: async-for or await recv().\"\"\"\n\n"
   "    def __init__(self, stream, resp_cls):\n"
   "        self._stream = stream\n"
   "        self._resp_cls = resp_cls\n\n"
   "    async def recv(self):\n"
   "        return await self._stream.recv(self._resp_cls())\n\n"
   "    def cancel(self):\n"
   "        self._stream.cancel()\n\n"
   "    async def aclose(self):\n"
   "        self.cancel()\n\n"
   "    def __aiter__(self):\n"
   "        return self\n\n"
   "    async def __anext__(self):\n"
   "        try:\n"
   "            return await self.recv()\n"
   "        except EOFError:\n"
   "            raise StopAsyncIteration\n\n\n"))

(define (py-service pb svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format
     "class ~aClient:\n    def __init__(self, channel):\n        self._channel = channel\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (py-client-method pb m))
      (append methods (alias-client-methods svc))))
    (format
     "class ~aClientAsync:\n    \"\"\"Asyncio client: wrap a grpcdc.AsyncChannel (a sync Channel is wrapped).\"\"\"\n\n    def __init__(self, channel):\n        if isinstance(channel, grpcdc.AsyncChannel):\n            self._channel = channel\n        else:\n            self._channel = grpcdc.AsyncChannel(channel=channel)\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (py-async-client-method/raw pb m))
      (append methods (alias-client-methods svc))))
    (format
     "def register_~a_server(server, impl):\n"
     (snake (string->symbol sname)))
    (apply
     string-append
     (map
      (lambda (m) (py-server-handler pb m))
      (append methods (alias-server-methods svc))))
    (format
     "    server.register_service(grpcdc.ServiceDesc(\n        ~s,\n        [\n"
     (hash-ref svc 'full-name))
    (apply
     string-append
     (map py-method-entry (append methods (alias-server-methods svc))))
    "        ],\n    ))\n")))

(define py-pb-preamble
  (string-append
   "import struct as _struct\n\n\n"
   "def _append_varint(out, value):\n"
   "    v = value & 0xFFFFFFFFFFFFFFFF\n"
   "    while v > 0x7F:\n"
   "        out.append((v & 0x7F) | 0x80)\n"
   "        v >>= 7\n"
   "    out.append(v)\n"
   "    return out\n\n\n"
   "def _append_tag(out, field, wire):\n"
   "    return _append_varint(out, (field << 3) | wire)\n\n\n"
   "def _append_varint_field(out, field, value):\n"
   "    if value == 0:\n"
   "        return out\n"
   "    out = _append_tag(out, field, 0)\n"
   "    return _append_varint(out, value)\n\n\n"
   "def _append_bytes_field(out, field, data):\n"
   "    out = _append_tag(out, field, 2)\n"
   "    out = _append_varint(out, len(data))\n"
   "    out.extend(data)\n"
   "    return out\n\n\n"
   "def _append_string_field(out, field, value):\n"
   "    if value == \"\":\n"
   "        return out\n"
   "    return _append_bytes_field(out, field, value.encode(\"utf-8\"))\n\n\n"
   "def _append_fixed_field(out, field, payload):\n"
   "    out = _append_tag(out, field, 1 if len(payload) == 8 else 5)\n"
   "    out.extend(payload)\n"
   "    return out\n\n\n"
   "class _Reader:\n"
   "    def __init__(self, buf):\n"
   "        self.buf = bytes(buf)\n"
   "        self.pos = 0\n\n"
   "    def varint(self):\n"
   "        result = 0\n"
   "        shift = 0\n"
   "        while True:\n"
   "            if self.pos >= len(self.buf):\n"
   "                raise ValueError(\"truncated varint\")\n"
   "            b = self.buf[self.pos]\n"
   "            self.pos += 1\n"
   "            result |= (b & 0x7F) << shift\n"
   "            if not (b & 0x80):\n"
   "                return result\n"
   "            shift += 7\n"
   "            if shift >= 64:\n"
   "                raise ValueError(\"varint too long\")\n\n"
   "    def take(self, n):\n"
   "        if self.pos + n > len(self.buf):\n"
   "            raise ValueError(\"truncated field\")\n"
   "        value = self.buf[self.pos:self.pos + n]\n"
   "        self.pos += n\n"
   "        return value\n\n"
   "    def field(self):\n"
   "        if self.pos >= len(self.buf):\n"
   "            return None\n"
   "        start = self.pos\n"
   "        tag = self.varint()\n"
   "        num, wire = tag >> 3, tag & 7\n"
   "        if wire == 0:\n"
   "            return num, wire, self.varint(), self.buf[start:self.pos]\n"
   "        if wire == 2:\n"
   "            return num, wire, self.take(self.varint()), self.buf[start:self.pos]\n"
   "        if wire == 1:\n"
   "            return num, wire, self.take(8), self.buf[start:self.pos]\n"
   "        if wire == 5:\n"
   "            return num, wire, self.take(4), self.buf[start:self.pos]\n"
   "        raise ValueError(\"bad wire type\")\n\n\n"
   "def _as_int32(value):\n"
   "    return ((value & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000\n\n\n"
   "def _as_int64(value):\n"
   "    return ((value & 0xFFFFFFFFFFFFFFFF) ^ 0x8000000000000000) - 0x8000000000000000\n\n\n"
   "def _unzz32(value):\n"
   "    v = value & 0xFFFFFFFF\n"
   "    return (v >> 1) ^ -(v & 1)\n\n\n"
   "def _unzz64(value):\n"
   "    v = value & 0xFFFFFFFFFFFFFFFF\n"
   "    return (v >> 1) ^ -(v & 1)\n\n\n"))

(define pb-varint-types varint-scalar-types)

(define pb-fixed-formats
  (map (lambda (e) (cons (first e) (third e))) (fixed-scalar-table 'python)))

(define pb-fixed-sizes
  (map (lambda (e) (cons (first e) (second e))) (fixed-scalar-table 'python)))

(define (py-pb-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (py-pb-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'emit-python-pb-file "unresolved type ~a" type-name))))

(define (py-pb-ref model entry)
  (define flat
    (py-pb-flat
     (hash-ref entry 'pkg)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (hash-ref entry 'full)
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (equal? (hash-ref entry 'file) (hash-ref model 'name))
    flat
    (format
     "~a_pb.~a"
     (path->string
      (path-replace-extension (file-name-from-path (hash-ref entry 'file)) ""))
     flat)))

(define (py-pb-varint-expr f v)
  (case (hash-ref f 'type)
    ((8) (format "(1 if ~a else 0)" v))
    ((17) (format "(((~a << 1) ^ (~a >> 31)) & 0xFFFFFFFF)" v v))
    ((18) (format "(((~a << 1) ^ (~a >> 63)) & 0xFFFFFFFFFFFFFFFF)" v v))
    (else v)))

(define (py-pb-varint-decode f v)
  (case (hash-ref f 'type)
    ((5 14) (format "_as_int32(~a)" v))
    ((13) (format "(~a & 0xFFFFFFFF)" v))
    ((3) (format "_as_int64(~a)" v))
    ((4) v)
    ((8) (format "(~a != 0)" v))
    ((17) (format "_unzz32(~a)" v))
    ((18) (format "_unzz64(~a)" v))))

(define (py-pb-explicit-literal model f)
  (define d (field-explicit-default f))
  (and d
       (case (hash-ref f 'type)
         ((9) (format "~s" d))
         ((8) (if (equal? d "true") "True" "False"))
         ((14) (format "~a" (enum-default-number model f)))
         ((2) (format "~a" d))
         (else d))))

(define (py-pb-default f model)
  (cond
   ((py-pb-explicit-literal model f) => (lambda (lit) lit))
   ((= (hash-ref f 'label) 3)
    (let ((t
           (and (= (hash-ref f 'type) 11)
                (hash-ref
                 (hash-ref model 'types)
                 (hash-ref f 'type-name)
                 #f))))
      (if (and t (eq? (hash-ref t 'kind) 'map)) "dict" "list")))
   (else
    (case (hash-ref f 'type)
      ((9) "\"\"")
      ((12) "b\"\"")
      ((8) "False")
      ((11 10) "None")
      ((1 2) "0.0")
      (else "0")))))

(define (py-pb-encode-singular model f v indent)
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define proto2? (equal? (hash-ref model 'syntax "") "proto2"))
  (cond
   ((memv type pb-varint-types)
    (if proto2?
      (format
       "~aout = _append_tag(out, ~a, 0)\n~aout = _append_varint(out, ~a)\n"
       indent
       n
       indent
       (py-pb-varint-expr f v))
      (format
       "~aout = _append_varint_field(out, ~a, ~a)\n"
       indent
       n
       (py-pb-varint-expr f v))))
   ((assv type pb-fixed-formats)
    =>
    (lambda (p)
      (if proto2?
        (format
         "~aout = _append_fixed_field(out, ~a, _struct.pack(~s, ~a))\n"
         indent
         n
         (cdr p)
         v)
        (format
         "~aif ~a: out = _append_fixed_field(out, ~a, _struct.pack(~s, ~a))\n"
         indent
         v
         n
         (cdr p)
         v))))
   ((= type 9)
    (if proto2?
      (format
       "~aout = _append_bytes_field(out, ~a, ~a.encode(\"utf-8\"))\n"
       indent
       n
       v)
      (format "~aout = _append_string_field(out, ~a, ~a)\n" indent n v)))
   ((= type 12)
    (if proto2?
      (format "~aout = _append_bytes_field(out, ~a, ~a)\n" indent n v)
      (format
       "~aif ~a: out = _append_bytes_field(out, ~a, ~a)\n"
       indent
       v
       n
       v)))
   ((= type 11)
    (define entry (py-pb-resolve model (hash-ref f 'type-name)))
    (format
     "~aif ~a is not None: out = _append_bytes_field(out, ~a, ~a.marshal_dc())\n"
     indent
     v
     n
     v))
   (else
    (error 'emit-python-pb-file "unsupported field type ~a (groups)" type))))

(define (py-pb-encode-field model f)
  (define a (hash-ref f 'name))
  (define v (format "self.~a" a))
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (py-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (py-pb-resolve model (hash-ref f 'type-name)))
    (define helper
      (format
       "_encode_~aEntry"
       (py-pb-flat
        (hash-ref entry 'pkg)
        (hash-ref (hash-ref entry 'msg) 'full-name))))
    (format
     "        if self.~a:\n            for k, val in self.~a.items():\n                out = _append_bytes_field(out, ~a, ~a(k, val))\n"
     a
     a
     n
     helper))
   ((not (= (hash-ref f 'label) 3))
    (py-pb-encode-singular model f v "        "))
   ((memv type pb-varint-types)
    (string-append
     (format
      "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n"
      a
      a)
     (format
      "                payload = _append_varint(payload, ~a)\n"
      (py-pb-varint-expr f "v"))
     (format
      "            out = _append_bytes_field(out, ~a, bytes(payload))\n"
      n)))
   ((assv type pb-fixed-formats)
    =>
    (lambda (p)
      (string-append
       (format
        "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n"
        a
        a)
       (format "                payload.extend(_struct.pack(~s, v))\n" (cdr p))
       (format
        "            out = _append_bytes_field(out, ~a, bytes(payload))\n"
        n))))
   ((= type 9)
    (format
     "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.encode(\"utf-8\"))\n"
     a
     n))
   ((= type 12)
    (format
     "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v)\n"
     a
     n))
   ((= type 11)
    (define entry (py-pb-resolve model (hash-ref f 'type-name)))
    (format
     "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.marshal_dc())\n"
     a
     n))
   (else
    (error 'emit-python-pb-file "unsupported repeated field type ~a" type))))

(define (py-pb-decode-singular model f target src indent)
  (define type (hash-ref f 'type))
  (cond
   ((memv type pb-varint-types)
    (format "~a~a = ~a\n" indent target (py-pb-varint-decode f src)))
   ((assv type pb-fixed-formats)
    =>
    (lambda (p)
      (format "~a~a = _struct.unpack(~s, ~a)[0]\n" indent target (cdr p) src)))
   ((= type 9) (format "~a~a = ~a.decode(\"utf-8\")\n" indent target src))
   ((= type 12) (format "~a~a = bytes(~a)\n" indent target src))
   ((= type 11)
    (define ref
      (py-pb-ref model (py-pb-resolve model (hash-ref f 'type-name))))
    (string-append
     (format "~atmp = ~a()\n" indent ref)
     (format "~atmp.unmarshal_dc(~a)\n" indent src)
     (format "~a~a = tmp\n" indent target)))
   (else (error 'emit-python-pb-file "unsupported field type ~a" type))))

(define (py-pb-oneof-clearing model f)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "                self.~a = ~a\n"
       (hash-ref sib 'name)
       (py-pb-default-expr model sib)))
    (oneof-siblings model f))))

(define (py-pb-encode-guard model f code)
  (define later (oneof-later-siblings model f))
  (if (null? later)
    code
    (string-append
     (format
      "        if not (~a):\n"
      (string-join
       (map (lambda (sib) (format "self.~a" (hash-ref sib 'name))) later)
       " or "))
     (string-join
      (map
       (lambda (l) (if (string=? l "") l (string-append "    " l)))
       (string-split code "\n"))
      "\n")
     "\n")))

(define (py-pb-decode-case model f first?)
  (define a (hash-ref f 'name))
  (define target (format "self.~a" a))
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define clearing (py-pb-oneof-clearing model f))
  (define head
    (format "            ~a num == ~a:\n" (if first? "if" "elif") n))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (py-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (py-pb-resolve model (hash-ref f 'type-name)))
    (define helper
      (format
       "_decode_~aEntry"
       (py-pb-flat
        (hash-ref entry 'pkg)
        (hash-ref (hash-ref entry 'msg) 'full-name))))
    (string-append
     head
     (format "                k, val = ~a(value)\n" helper)
     (format "                self.~a[k] = val\n" a)))
   ((not (= (hash-ref f 'label) 3))
    (string-append
     head
     clearing
     (py-pb-decode-singular model f target "value" "                ")))
   ((memv type pb-varint-types)
    (string-append
     head
     "                if wire == 2:\n"
     "                    sub = _Reader(value)\n"
     "                    while sub.pos < len(sub.buf):\n"
     (format
      "                        self.~a.append(~a)\n"
      a
      (py-pb-varint-decode f "sub.varint()"))
     "                else:\n"
     (format
      "                    self.~a.append(~a)\n"
      a
      (py-pb-varint-decode f "value"))))
   ((assv type pb-fixed-formats)
    =>
    (lambda (p)
      (define size (cdr (assv type pb-fixed-sizes)))
      (string-append
       head
       "                if wire == 2:\n"
       (format
        "                    for off in range(0, len(value), ~a):\n"
        size)
       (format
        "                        self.~a.append(_struct.unpack(~s, value[off:off + ~a])[0])\n"
        a
        (cdr p)
        size)
       "                else:\n"
       (format
        "                    self.~a.append(_struct.unpack(~s, value)[0])\n"
        a
        (cdr p)))))
   ((= type 9)
    (string-append
     head
     (format "                self.~a.append(value.decode(\"utf-8\"))\n" a)))
   ((= type 12)
    (string-append
     head
     (format "                self.~a.append(bytes(value))\n" a)))
   ((= type 11)
    (string-append
     head
     (py-pb-decode-singular model f "tmp2" "value" "                ")
     (format "                self.~a.append(tmp2)\n" a)))
   (else
    (error 'emit-python-pb-file "unsupported repeated field type ~a" type))))

(define (py-pb-map-helpers model entry)
  (define msg (hash-ref entry 'msg))
  (define base (py-pb-flat (hash-ref entry 'pkg) (hash-ref msg 'full-name)))
  (define key-f
    (findf (lambda (x) (= (hash-ref x 'number) 1)) (hash-ref msg 'fields)))
  (define val-f
    (findf (lambda (x) (= (hash-ref x 'number) 2)) (hash-ref msg 'fields)))
  (unless (and key-f val-f)
    (error
     'emit-python-pb-file
     "map entry ~a lacks key/value"
     (hash-ref msg 'full-name)))
  (string-append
   (format "def _encode_~aEntry(key, value):\n    out = bytearray()\n" base)
   (py-pb-encode-singular model key-f "key" "    ")
   (py-pb-encode-singular model val-f "value" "    ")
   "    return bytes(out)\n\n\n"
   (format "def _decode_~aEntry(data):\n" base)
   (format
    "    key = ~a\n    value = ~a\n"
    (py-pb-default-expr model key-f)
    (py-pb-default-expr model val-f))
   "    reader = _Reader(data)\n"
   "    while True:\n"
   "        item = reader.field()\n"
   "        if item is None:\n"
   "            return key, value\n"
   "        num, wire, raw, _raw_bytes = item\n"
   "        if num == 1:\n"
   (py-pb-decode-singular model key-f "key" "raw" "            ")
   "        elif num == 2:\n"
   (py-pb-decode-singular model val-f "value" "raw" "            ")
   "\n"))

(define (py-pb-default-expr model f)
  (define d (py-pb-default f model))
  (cond
   ((equal? d "list") "[]")
   ((equal? d "dict") "{}")
   ((equal? d "None") "None")
   (else d)))

(define (py-pb-init-line model f)
  (define a (hash-ref f 'name))
  (cond
   ((= (hash-ref f 'label) 3)
    (define d (py-pb-default f model))
    (format
     "        self.~a = ~a(~a) if ~a is not None else ~a\n"
     a
     d
     a
     a
     (if (equal? d "dict") "{}" "[]")))
   ((= (hash-ref f 'type) 11)
    (define entry (py-pb-resolve model (hash-ref f 'type-name)))
    (if (eq? (hash-ref entry 'kind) 'map)
      (format "        self.~a = dict(~a) if ~a is not None else {}\n" a a a)
      (format "        self.~a = ~a\n" a a)))
   (else (format "        self.~a = ~a\n" a a))))

(define (py-pb-class model msg)
  (define flat
    (py-pb-flat (hash-ref model 'package) (hash-ref msg 'full-name)))
  (define fields (hash-ref msg 'fields))
  (define params
    (string-join
     (for/list
      ((f (in-list fields)))
      (format
       "~a=~a"
       (hash-ref f 'name)
       (let ((d (py-pb-default f model)))
         (if (or (equal? d "list") (equal? d "dict")) "None" d))))
     ", "))
  (string-append
   (format
    "class ~a:\n    \"\"\"Message ~a.\"\"\"\n\n"
    flat
    (hash-ref msg 'full-name))
   (format "    def __init__(self, ~a):\n" params)
   (apply string-append (map (lambda (f) (py-pb-init-line model f)) fields))
   "        self.unknown_fields = b\"\"\n"
   "\n    def marshal_dc(self):\n        out = bytearray()\n"
   (apply
    string-append
    (map
     (lambda (f) (py-pb-encode-guard model f (py-pb-encode-field model f)))
     fields))
   "        out += self.unknown_fields\n"
   "        return bytes(out)\n"
   "\n    def unmarshal_dc(self, data):\n"
   "        self.unknown_fields = b\"\"\n"
   (apply
    string-append
    (for/list
     ((f (in-list fields)))
     (format
      "        self.~a = ~a\n"
      (hash-ref f 'name)
      (let ((d (py-pb-default f model)))
        (cond ((equal? d "list") "[]") ((equal? d "dict") "{}") (else d))))))
   "        reader = _Reader(data)\n"
   "        while True:\n"
   "            item = reader.field()\n"
   "            if item is None:\n"
   "                return self\n"
   "            num, wire, value, raw = item\n"
   (apply
    string-append
    (for/list
     ((f (in-list fields)) (i (in-naturals)))
     (py-pb-decode-case model f (zero? i))))
   (if (null? fields)
     ""
     "            else:\n                self.unknown_fields = self.unknown_fields + raw\n")
   (format
    "\n    def __eq__(self, other):\n        return isinstance(other, ~a) and self.__dict__ == other.__dict__\n"
    flat)
   (format
    "\n    def __repr__(self):\n        return f\"~a(~a)\"\n\n\n"
    flat
    (string-join
     (for/list
      ((f (in-list fields)))
      (format "~a={self.~a!r}" (hash-ref f 'name) (hash-ref f 'name)))
     ", "))))

(define (py-pb-enum entry)
  (define e (hash-ref entry 'enum))
  (define full (hash-ref entry 'full))
  (string-append
   (format
    "class ~a:\n    \"\"\"Enum ~a.\"\"\"\n"
    (py-pb-flat (hash-ref entry 'pkg) full)
    full)
   (apply
    string-append
    (for/list
     ((v (in-list (hash-ref e 'values))))
     (format "    ~a = ~a\n" (hash-ref v 'name) (hash-ref v 'number))))
   "\n\n"))

(define (emit-python-pb-file file-model)
  (and (hash-has-key? file-model 'messages)
       (hash-has-key? file-model 'types)
       (let/ec
        return-false
        (emit-python-pb-file/inner file-model return-false))))

(define (emit-python-pb-file/inner file-model return-false)
  (define messages (hash-ref file-model 'messages))
  (define service-types
    (remove-duplicates
     (append-map
      (lambda (svc)
        (append-map
         (lambda (m) (list (hash-ref m 'input-full) (hash-ref m 'output-full)))
         (hash-ref svc 'methods)))
      (hash-ref file-model 'services))))
  (define imports (make-hash))
  (define reexports (make-hash))
  (define (add-import! entry also-export?)
    (unless (equal? (hash-ref entry 'file) (hash-ref file-model 'name))
      (define flat (py-pb-ref file-model entry))
      (define dep (hash-ref entry 'file))
      (hash-update! imports dep (lambda (s) (set-add s flat)) (set))
      (when also-export?
        (hash-update! reexports dep (lambda (s) (set-add s flat)) (set)))))
  (define (scan-fields msg)
    (for
     ((f (in-list (hash-ref msg 'fields))))
     (when (memv (hash-ref f 'type) '(11 14))
       (define e (py-pb-resolve file-model (hash-ref f 'type-name)))
       (add-import! e #f)
       (when (and (= (hash-ref f 'type) 11) (eq? (hash-ref e 'kind) 'map))
         (for
          ((ef (in-list (hash-ref (hash-ref e 'msg) 'fields))))
          (when (memv (hash-ref ef 'type) '(11 14))
            (add-import!
             (py-pb-resolve file-model (hash-ref ef 'type-name))
             #f))))))
    (for ((n (in-list (hash-ref msg 'nested)))) (scan-fields n)))
  (for ((m (in-list messages))) (scan-fields m))
  (for
   ((t (in-list service-types)))
   (define e (hash-ref (hash-ref file-model 'types) t #f))
   (when (and e (not (eq? (hash-ref e 'kind) 'enum))) (add-import! e #t)))
  (when (and (null? messages) (zero? (hash-count reexports)))
    (return-false #f))
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define out (open-output-string))
  (fprintf out "# @generated by protoc-gen-grpc-dc-python. DO NOT EDIT.\n")
  (fprintf out "# source: ~a\n\n" (hash-ref file-model 'name))
  (fprintf
   out
   "\"\"\"Generated protobuf messages (dependency-free wire format).\"\"\"\n\n")
  (for
   ((dep (in-list (sort (hash-keys imports) string<?))))
   (define dep-base
     (path->string (path-replace-extension (file-name-from-path dep) "")))
   (fprintf
    out
    "try:\n    from . import ~a_pb\nexcept ImportError:  # direct module load\n    import ~a_pb\n\n"
    dep-base
    dep-base))
  (when (positive? (hash-count reexports))
    (for
     ((dep (in-list (sort (hash-keys reexports) string<?))))
     (for
      ((flat (in-list (sort (set->list (hash-ref reexports dep)) string<?))))
      (define short (last (string-split flat ".")))
      (fprintf out "~a = ~a\n" short flat)))
    (fprintf out "\n"))
  (display py-pb-preamble out)
  (define (all-enum-entries)
    (define acc '())
    (define (walk msg)
      (for
       ((e (in-list (hash-ref msg 'enums))))
       (set! acc
         (cons
          (hash-ref
           (hash-ref file-model 'types)
           (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name)))
          acc)))
      (for ((n (in-list (hash-ref msg 'nested)))) (walk n)))
    (for ((m (in-list messages))) (walk m))
    (for
     ((e (in-list (hash-ref file-model 'enums))))
     (set! acc
       (cons
        (hash-ref
         (hash-ref file-model 'types)
         (if (string=? (hash-ref file-model 'package) "")
           (hash-ref e 'name)
           (format "~a.~a" (hash-ref file-model 'package) (hash-ref e 'name))))
        acc)))
    (reverse acc))
  (define seen-enums (mutable-set))
  (for
   ((e (in-list (all-enum-entries))))
   (when e
     (define flat
       (py-pb-flat
        (hash-ref e 'pkg)
        (if (hash-ref e 'msg)
          (format
           "~a.~a"
           (hash-ref (hash-ref e 'msg) 'full-name)
           (hash-ref (hash-ref e 'enum) 'name))
          (if (string=? (hash-ref e 'pkg) "")
            (hash-ref (hash-ref e 'enum) 'name)
            (format
             "~a.~a"
             (hash-ref e 'pkg)
             (hash-ref (hash-ref e 'enum) 'name))))))
     (unless (set-member? seen-enums flat)
       (set-add! seen-enums flat)
       (display (py-pb-enum e) out))))
  (define seen-maps (mutable-set))
  (define (emit-map-helpers msg)
    (for
     ((f (in-list (hash-ref msg 'fields))))
     (when (= (hash-ref f 'type) 11)
       (define e (py-pb-resolve file-model (hash-ref f 'type-name)))
       (when (and
              (eq? (hash-ref e 'kind) 'map)
              (not
               (set-member?
                seen-maps
                (hash-ref (hash-ref e 'msg) 'full-name))))
         (set-add! seen-maps (hash-ref (hash-ref e 'msg) 'full-name))
         (display (py-pb-map-helpers file-model e) out))))
    (for ((n (in-list (hash-ref msg 'nested)))) (emit-map-helpers n)))
  (for ((m (in-list messages))) (emit-map-helpers m))
  (define exported (mutable-set))
  (define (emit-msg msg)
    (unless (hash-ref msg 'map-entry)
      (display (py-pb-class file-model msg) out)
      (set-add!
       exported
       (py-pb-flat (hash-ref file-model 'package) (hash-ref msg 'full-name)))
      (for ((n (in-list (hash-ref msg 'nested)))) (emit-msg n))))
  (for ((m (in-list messages))) (emit-msg m))
  (define (emit-aliases msg)
    (for
     ((n (in-list (hash-ref msg 'nested))))
     (when (and
            (not (hash-ref n 'map-entry))
            (not (set-member? exported (hash-ref n 'name))))
       (fprintf
        out
        "~a = ~a\n"
        (hash-ref n 'name)
        (py-pb-flat (hash-ref file-model 'package) (hash-ref n 'full-name)))
       (set-add! exported (hash-ref n 'name)))
     (emit-aliases n)))
  (for ((m (in-list messages))) (emit-aliases m))
  (cons (string-append base "_pb.py") (get-output-string out)))

(define (emit-python-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define pb (string-append base "_pb"))
  (define stub
    (cons
     (string-append base "_grpc_dc.py")
     (string-append
      "# @generated by protoc-gen-grpc-dc-python. DO NOT EDIT.\n"
      (format "# source: ~a\n\n" (hash-ref file-model 'name))
      (format
       "try:\n    from . import ~a\nexcept ImportError:  # direct module load\n    import ~a\n\n"
       pb
       pb)
      "import grpcdc\n"
      (if (equal? (hash-ref params 'trace #f) "hooks")
        (string-append
         "\n# trace=hooks: register an observer via grpcdc.set_tracer(...)\nset_tracer = grpcdc.set_tracer\nset_trace_filter = grpcdc.set_trace_filter\n"
         (let ((methods (hash-ref params 'trace_methods #f)))
           (if methods (format "grpcdc.set_trace_filter(~s)\n" methods) "")))
        "")
      "\n"
      py-stream-helpers
      (apply
       string-append
       (map
        (lambda (svc) (py-service pb svc))
        (hash-ref file-model 'services))))))
  (define pb-file (emit-python-pb-file file-model))
  (if pb-file (list stub pb-file) stub))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define trace-opt (hash-ref params 'trace #f))
  (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
    (error
     (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
  (define trace-methods (hash-ref params 'trace_methods #f))
  (when trace-methods
    (unless (equal? trace-opt "hooks")
      (error "trace_methods requires trace=hooks"))
    (for
     ((p (in-list (string-split trace-methods ";"))))
     (unless (string-prefix? p "/")
       (error (format "trace_methods pattern must start with /: ~a" p)))))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map stamp-generated-header (as-file-list (emit-python-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
