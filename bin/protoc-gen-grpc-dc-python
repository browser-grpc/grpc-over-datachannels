(define wasm-zig-stream-feed-export-program
  '((kind-case
     (client-streaming
      (fmt
       "export fn serve_~aStart(call_id: u32, md_ptr: [*]const u8, md_len: usize) void {\n    const a = bridge_mod.bridgeAllocator();\n    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n    defer a.free(md);\n    g_stream_impl.?.~aBegin_fn(g_stream_impl.?.ctx, call_id, md);\n}\n\n"
