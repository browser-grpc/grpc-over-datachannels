(define wasm-cpp-service-program
  '((fmt
     "  /// Client for ~a (browser/WASM facade; see file doc).\n  class ~aClient {\n   public:\n    explicit ~aClient(grpcdc_wasm::Bridge& bridge =\n                          grpcdc_wasm::Bridge::Shared())\n        : bridge_(&bridge) {}\n\n"
     (ref full-name)
     (svc)
     (svc))
    (each+ methods client (call wasmCppClientMethod))
    "   private:\n    template <typename Resp, typename Callback>\n    static void HandleUnary(grpcdc_wasm::Status st,\n                            const grpcdc_wasm::Bytes* bytes,\n                            Callback callback) {\n      if (!st.ok()) {\n        callback(std::move(st), std::nullopt);\n        return;\n      }\n      Resp resp;\n      if (!resp.UnmarshalDc(bytes ? *bytes : grpcdc_wasm::Bytes{})) {\n        callback({3, \"malformed response payload\"}, std::nullopt);\n        return;\n      }\n      callback(grpcdc_wasm::Status::Ok(), resp);\n    }\n\n    template <typename Resp, typename OnMessage>\n    static void HandleMessage(const grpcdc_wasm::Bytes& bytes,\n                              OnMessage on_message,\n                              grpcdc_wasm::DoneCallback on_done,\n                              std::shared_ptr<bool> finished) {\n      if (*finished) return;\n      Resp resp;\n      if (!resp.UnmarshalDc(bytes)) {\n        *finished = true;\n        on_done({3, \"malformed response payload\"});\n        return;\n      }\n      on_message(resp);\n    }\n\n    template <typename Req>\n    static std::vector<grpcdc_wasm::Bytes> MarshalAll(\n        const std::vector<Req>& reqs) {\n      std::vector<grpcdc_wasm::Bytes> payloads;\n      for (const auto& req : reqs) payloads.push_back(req.MarshalDc());\n      return payloads;\n    }\n\n    grpcdc_wasm::Bridge* bridge_;\n  };\n\n  /// Streaming response sink for server handlers.\n"
    (fmt "  struct ~aServerSink {\n    std::uint32_t call_id;\n\n" (svc))
    (each-unique
     methods
     output
     (fmt
      "    grpcdc_wasm::Status Send(const ~a& resp) {\n      grpcdc_wasm::ServerSend(call_id, resp.MarshalDc());\n      return grpcdc_wasm::Status::Ok();\n    }\n"
      (ref output)))
    "  };\n\n"
    (fmt
     "  /// Service implementation for ~a (browser/WASM facade).\n  class ~aServer {\n   public:\n    virtual ~~~aServer() = default;\n"
     (ref full-name)
     (svc)
     (svc))
    (each methods (call wasmCppServerIfaceMethod))
    "  };\n\n"
    (fmt
     "  static inline ~aServer* g_impl = nullptr;\n\n  /// Register the service implementation used by the serve_* exports.\n  static void register~aServer(~aServer& impl) { g_impl = &impl; }\n\n"
     (svc)
     (svc)
     (svc))
    (fmt
     "  /// Incremental service implementation for ~a: requests arrive one at a time via serve_*Start/Feed/End.\n  class ~aStreamServer {\n   public:\n    virtual ~~~aStreamServer() = default;\n"
     (ref full-name)
     (svc)
     (svc))
    (each methods (call wasmCppStreamIfaceMethod))
    "  };\n\n"
    (fmt
     "  static inline ~aStreamServer* g_stream_impl = nullptr;\n\n  /// Register the incremental implementation used by the serve_*Start/Feed/End exports.\n  static void register~aStreamServer(~aStreamServer& impl) { g_stream_impl = &impl; }\n};\n\n"
     (svc)
     (svc)
     (svc))
    (each methods (call wasmCppServerExport (arg 0)))
    (each methods (call wasmCppStreamFeedExport (arg 0)))))

