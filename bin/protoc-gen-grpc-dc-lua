       (ref output)))
     (bidi
      (fmt
       "type ~a~aServer interface {\n\tSend(*~a) error\n\tRecv() (*~a, error)\n\tContext() context.Context\n}\n\n"
       (svc)
       (ref name)
       (ref output)
       (ref input))))))

(define go-stream-impls-program
