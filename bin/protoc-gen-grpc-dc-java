   'wasmGoStreamIfaceMethod
   wasm-go-stream-iface-method-program
   'wasmGoStreamRegisterMethod
   wasm-go-stream-register-method-program
   'wasmGoService
   wasm-go-service-program
   'wasmKotlinClientMethod
   wasm-kotlin-client-method-program
   'wasmKotlinServerIfaceMethod
   wasm-kotlin-server-iface-method-program
   'wasmKotlinRegisterMethod
   wasm-kotlin-register-method-program
   'wasmKotlinStreamIfaceMethod
   wasm-kotlin-stream-iface-method-program
   'wasmKotlinStreamRegisterMethod
   wasm-kotlin-stream-register-method-program
   'wasmKotlinService
   wasm-kotlin-service-program
   'wasmScalaClientMethod
   wasm-scala-client-method-program
   'wasmScalaServerIfaceMethod
   wasm-scala-server-iface-method-program
   'wasmScalaRegisterMethod
   wasm-scala-register-method-program
   'wasmScalaStreamIfaceMethod
   wasm-scala-stream-iface-method-program
   'wasmScalaStreamRegisterMethod
   wasm-scala-stream-register-method-program
   'wasmScalaRecvStream
   wasm-scala-recv-stream-program
   'wasmScalaSource
   wasm-scala-source-program
   'wasmScalaService
   wasm-scala-service-program))

(define (seg-ref node key)
  (if (eq? key 'impl-name)
    (hash-ref node 'impl-name (hash-ref node 'name))
    (hash-ref node key #f)))

(define (run-segments
         program
         node
         svc
         (model #f)
         (args '())
         (err "return err"))
  (run-env program (list model node svc args err node)))

(define (run-env program env)
  (apply
   string-append
   (for/list ((seg (in-list program))) (run-segment seg env))))

(define (env-model env) (first env))

(define (env-node env) (second env))

(define (env-svc env) (third env))

(define (env-args env) (fourth env))

(define (env-err env) (fifth env))

(define (env-root env) (sixth env))

(define (env-with
         env
         #:model
         (model (env-model env))
         #:node
         (node (env-node env))
         #:args
         (args (env-args env))
         #:err
         (err (env-err env))
         #:root
         (root (env-root env)))
  (list model node (env-svc env) args err root))

(define (seg-truthy? v) (not (or (not v) (equal? v "") (equal? v 0))))

(define (seg-pascal s)
  (string-join
   (map
    (lambda (part)
      (if (string=? part "")
        ""
        (string-append
         (string (char-upcase (string-ref part 0)))
         (substring part 1))))
    (string-split s "_"))
   ""))

(define (seg-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (seg-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'run-segments "unresolved type ~a" type-name))))

(define (seg-entry-type entry)
  (seg-flat
   (hash-ref entry 'pkg)
   (if (eq? (hash-ref entry 'kind) 'enum)
     (hash-ref entry 'full)
     (hash-ref (hash-ref entry 'msg) 'full-name))))

(define (seg-entry-type-of model node)
  (if (hash-has-key? node 'type-name)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name)))
    (seg-entry-type node)))

(define (seg-field-type model f)
  (define type (hash-ref f 'type))
  (define base
    (cond
     ((= type 11)
      (define entry (seg-resolve model (hash-ref f 'type-name)))
      (if (eq? (hash-ref entry 'kind) 'map)
        (let* ((entry-msg (hash-ref entry 'msg))
               (kf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 1))
                 (hash-ref entry-msg 'fields)))
               (vf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 2))
                 (hash-ref entry-msg 'fields))))
          (format
           "map[~a]~a"
           (seg-field-type model (hash-set kf 'label 1))
           (seg-field-type model (hash-set vf 'label 1))))
        (string-append "*" (seg-entry-type entry))))
     ((= type 14) (seg-entry-type (seg-resolve model (hash-ref f 'type-name))))
     (else (scalar-type-entry 'go type))))
  (if (= (hash-ref f 'label) 3)
    (if (and (= type 11)
             (eq?
              (hash-ref (seg-resolve model (hash-ref f 'type-name)) 'kind)
              'map))
      base
      (string-append "[]" base))
    base))

(define (seg-category model node)
  (define type (hash-ref node 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map))
    "map")
   ((= type 11) "message")
   ((memv type varint-scalar-types) "varint")
   ((assv type (fixed-scalar-table 'go)) "fixed")
   ((= type 9) "string")
   ((= type 12) "bytes")
   (else "other")))

(define (seg-fixed-info node)
  (assv (hash-ref node 'type) (fixed-scalar-table 'go)))

(define (seg-zero node)
  (case (hash-ref node 'type)
    ((11 12) "nil")
    ((9) "\"\"")
    ((8) "false")
    (else "0")))

(define (seg-set-expr sib)
  (define v (format "m.~a" (seg-pascal (hash-ref sib 'name))))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a != nil" v))
    ((9) (format "~a != \"\"" v))
    ((12) (format "len(~a) > 0" v))
    ((8) v)
    (else (format "~a != 0" v))))

(define (seg-oneof-clearing model node)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "\t\t\tm.~a = ~a\n"
       (seg-pascal (hash-ref sib 'name))
       (seg-zero sib)))
    (oneof-siblings model node))))

(define (seg-lower-first s0)
  (define s (if (symbol? s0) (symbol->string s0) s0))
  (if (string=? s "")
    s
    (string-append (string (char-downcase (string-ref s 0))) (substring s 1))))

(define (seg-js-name f)
  (define jn (hash-ref f 'json-name ""))
  (if (and jn (not (string=? jn "")))
    jn
    (regexp-replace*
     #rx"_([a-zA-Z0-9])"
     (hash-ref f 'name)
     (lambda (all c) (string-upcase c)))))

(define (seg-later-oneof-cond model node)
  (define later (oneof-later-siblings model node))
  (if (null? later) "" (string-join (map seg-set-expr later) " || ")))

(define (seg-eval seg env)
  (define node (env-node env))
  (define model (env-model env))
  (cond
   ((string? seg) seg)
   ((number? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply
     format
     (second seg)
     (map
      (lambda (e)
        (define v (seg-eval e env))
        (if (symbol? v) (symbol->string v) v))
      (cddr seg))))
   ((eq? (car seg) 'ref)
    (if (null? (cddr seg))
      (seg-ref node (second seg))
      (foldl (lambda (k acc) (hash-ref acc k)) node (cdr seg))))
   ((eq? (car seg) 'svc) (env-svc env))
   ((eq? (car seg) 'arg) (list-ref (env-args env) (second seg)))
   ((eq? (car seg) 'err-stmt) (env-err env))
   ((eq? (car seg) 'self) node)
   ((eq? (car seg) 'root) (env-root env))
   ((eq? (car seg) 'distinct-count)
    (define kinds-part
      (and (pair? (cdddr seg))
           (list? (fourth seg))
           (eq? (car (fourth seg)) 'kinds)
           (cdr (fourth seg))))
    (length
     (remove-duplicates
      (map
       (lambda (el) (hash-ref el (third seg)))
       (filter
        (lambda (el)
          (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
        (seg-eval (second seg) env))))))
   ((memq
     (car seg)
     '(if case-on
        when
        guarded
        kind-case
        each
        each+
        each-siblings
        each-sep
        each-unique))
    (run-segment seg env))
   ((eq? (car seg) 'pascal) (seg-pascal (seg-eval (second seg) env)))
   ((eq? (car seg) 'lower-first) (seg-lower-first (seg-eval (second seg) env)))
   ((eq? (car seg) 'js-name) (seg-js-name node))
   ((eq? (car seg) 'js-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'js-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'bigint-type)
    (and (memv (hash-ref node 'type) '(3 4 18 6 16)) #t))
   ((eq? (car seg) 'entry-flat) (seg-entry-type node))
   ((eq? (car seg) 'resolved-flat)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name))))
   ((eq? (car seg) 'flat)
    (seg-flat (hash-ref model 'package) (hash-ref node 'full-name)))
   ((eq? (car seg) 'entry-type) (seg-entry-type-of model node))
   ((eq? (car seg) 'field-type) (seg-field-type model node))
   ((eq? (car seg) 'field-type-of)
    (seg-field-type model (seg-eval (second seg) env)))
   ((eq? (car seg) 'resolved-entry)
    (seg-resolve model (hash-ref node 'type-name)))
   ((eq? (car seg) 'key-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 1))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'val-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 2))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'with-label)
    (hash-set (seg-eval (second seg) env) 'label (third seg)))
   ((eq? (car seg) 'get) (hash-ref (seg-eval (second seg) env) (third seg)))
   ((eq? (car seg) 'fixed-name) (third (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-size) (second (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-wire) (if (= (second (seg-fixed-info node)) 8) 1 5))
   ((eq? (car seg) 'type) (hash-ref node 'type))
   ((eq? (car seg) 'category) (seg-category model node))
   ((eq? (car seg) 'category-of)
    (seg-category model (seg-eval (second seg) env)))
   ((eq? (car seg) 'proto2) (equal? (hash-ref model 'syntax "") "proto2"))
   ((eq? (car seg) 'type-is) (= (hash-ref node 'type) (second seg)))
   ((eq? (car seg) 'is-varint)
    (and (memv (hash-ref node 'type) varint-scalar-types) #t))
   ((eq? (car seg) 'is-fixed) (and (seg-fixed-info node) #t))
   ((eq? (car seg) 'is-map)
    (and (= (hash-ref node 'type) 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map)))
   ((eq? (car seg) 'repeated) (= (hash-ref node 'label) 3))
   ((eq? (car seg) 'has-default) (and (field-explicit-default node) #t))
   ((eq? (car seg) 'any-default)
    (for/or
     ((f (in-list (hash-ref node 'fields))))
     (field-explicit-default f)))
   ((eq? (car seg) 'no-fields) (null? (hash-ref node 'fields)))
   ((eq? (car seg) 'default-raw) (field-explicit-default node))
   ((eq? (car seg) 'enum-default-num) (enum-default-number model node))
   ((eq? (car seg) 'oneof-clearing) (seg-oneof-clearing model node))
   ((eq? (car seg) 'later-oneof-cond) (seg-later-oneof-cond model node))
   ((eq? (car seg) 'call)
    (run-env
     (hash-ref segment-programs (second seg))
     (env-with env #:args (map (lambda (e) (seg-eval e env)) (cddr seg)))))
   ((eq? (car seg) 'call-on)
    (run-env
     (hash-ref segment-programs (third seg))
     (env-with
      env
      #:node
      (seg-eval (second seg) env)
      #:args
      (map (lambda (e) (seg-eval e env)) (cdddr seg)))))
   (else (error 'run-segments "bad expression: ~e" seg))))

(define (run-segment seg env)
  (define node (env-node env))
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'if)
    (define then-segs (cdr (assq 'then (cddr seg))))
    (define else-part (assq 'else (cddr seg)))
    (if (seg-truthy? (seg-eval (second seg) env))
      (run-env then-segs env)
      (if else-part (run-env (cdr else-part) env) "")))
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch (or (assq kind (cdr seg)) (assq 'else (cdr seg))))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-env (cdr branch) env))
   ((eq? (car seg) 'case-on)
    (define val (seg-eval (second seg) env))
    (define raw (cddr seg))
    (define (branch-key? b)
      (and (list? b)
           (pair? b)
           (or (number? (car b))
               (string? (car b))
               (eq? (car b) 'else)
               (and (list? (car b)) (andmap number? (car b))))))
    (define branches
      (cond
       ((and (= (length raw) 1)
             (list? (car raw))
             (andmap branch-key? (car raw)))
        (car raw))
       (else
        (map
         (lambda (b)
           (if (and (list? b) (= (length b) 1) (list? (car b))) (car b) b))
         raw))))
    (define branch
      (for/first
       ((b (in-list branches))
        #:when
        (or (eq? (car b) 'else)
            (member val (if (list? (car b)) (car b) (list (car b))) equal?)))
       b))
    (if branch (run-env (cdr branch) env) ""))
   ((eq? (car seg) 'when)
    (if (seg-truthy? (seg-eval (second seg) env)) (run-env (cddr seg) env) ""))
   ((eq? (car seg) 'guarded)
    (define text (run-env (cddddr seg) env))
    (define cond-str
      (string-join
       (map
        (lambda (sib)
          (run-env
           (hash-ref segment-programs (second seg))
           (env-with env #:node sib)))
        (oneof-later-siblings (env-model env) node))
       " || "))
    (if (equal? cond-str "")
      text
      (string-append
       (format (third seg) cond-str)
       (if (string-suffix? text "\n") text (string-append text "\n"))
       (fourth seg))))
   ((eq? (car seg) 'fail)
    (error 'run-segments "unsupported field type ~a" (hash-ref node 'type)))
   ((eq? (car seg) 'each)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items)))
      (run-env segs (env-with env #:node el)))))
   ((eq? (car seg) 'each+)
    (define aliases
      (if (eq? (third seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (apply
     string-append
     (for/list
      ((el (in-list (append (hash-ref node (second seg)) aliases))))
      (run-env (cdddr seg) (env-with env #:node el)))))
   ((eq? (car seg) 'each-siblings)
    (apply
     string-append
     (for/list
      ((sib (in-list (oneof-siblings (env-model env) node))))
      (run-env (cdr seg) (env-with env #:node sib)))))
   ((eq? (car seg) 'each-unique)
    (define rest (cdddr seg))
    (define kinds-part
      (and (pair? rest)
           (list? (car rest))
           (eq? (car (car rest)) 'kinds)
           (cdr (car rest))))
    (when kinds-part (set! rest (cdr rest)))
    (define or-first?
      (and (pair? rest) (list? (car rest)) (eq? (car (car rest)) 'or-first)))
    (when or-first? (set! rest (cdr rest)))
    (define all (hash-ref node (second seg)))
    (define filtered
      (filter
       (lambda (el)
         (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
       all))
    (define seen (mutable-set))
    (define uniq
      (filter
       (lambda (el)
         (define v (hash-ref el (third seg)))
         (and (not (set-member? seen v)) (set-add! seen v)))
       filtered))
    (apply
     string-append
     (for/list
      ((el (in-list (if (and or-first? (null? uniq)) (list (car all)) uniq))))
      (run-env rest (env-with env #:node el)))))
   ((eq? (car seg) 'each-sep)
    (define-values (keys segs) (splitf-at (cddr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (string-join
     (for/list ((el (in-list items))) (run-env segs (env-with env #:node el)))
     (second seg)))
   (else (seg-eval seg env))))

(define current-service (make-parameter ""))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "[_-]"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (lower-first s)
  (string-append (string (char-downcase (string-ref s 0))) (substring s 1)))

(define (java-qualify-type pkg simple full)
  (cond
   ((or (not full)
        (string=? pkg "")
        (string-prefix? full (string-append pkg ".")))
    simple)
   (else
    (define parts (string-split full "."))
    (string-append (string-join (drop-right parts 1) ".") "." simple))))

(define (java-qualify-services pkg services)
  (for/list
   ((svc (in-list services)))
   (hash-set
    svc
    'methods
    (for/list
     ((m (in-list (hash-ref svc 'methods))))
     (hash-set*
      m
      'input
      (java-qualify-type pkg (hash-ref m 'input) (hash-ref m 'input-full #f))
      'output
      (java-qualify-type
       pkg
       (hash-ref m 'output)
       (hash-ref m 'output-full #f)))))))

(define (java-deprecated m indent)
  (if (hash-ref m 'deprecated #f) (format "~a@Deprecated\n" indent) ""))

(define (java-client-method/raw m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        public ~a ~a(~a req, Map<String, String> metadata) throws Exception {\n"
       "            ~a resp = new ~a();\n"
       "            channel.unary(~s, req, resp, metadata);\n"
       "            return resp;\n"
       "        }\n\n"
       "        public ~a ~a(~a req) throws Exception {\n"
       "            return ~a(req, null);\n"
       "        }\n")
      resp
      name
      req
      resp
      resp
      path
      resp
      name
      req
      name))
    ((server-streaming)
     (format
      (string-append
       "        public ~a~aStream ~a(~a req, Map<String, String> metadata) throws Exception {\n"
       "            return new ~a~aStream(channel.serverStream(~s, req, metadata));\n"
       "        }\n\n"
       "        public ~a~aStream ~a(~a req) throws Exception {\n"
       "            return ~a(req, null);\n"
       "        }\n")
      svc
      name
      name
      req
      svc
      name
      path
      svc
      name
      name
      req
      name))
    ((client-streaming)
     (format
      (string-append
       "        public ~a ~a(List<~a> reqs, Map<String, String> metadata) throws Exception {\n"
       "            ~a resp = new ~a();\n"
       "            channel.clientStream(~s, reqs, resp, metadata);\n"
       "            return resp;\n"
       "        }\n\n"
       "        public ~a ~a(List<~a> reqs) throws Exception {\n"
       "            return ~a(reqs, null);\n"
       "        }\n")
      resp
      name
      req
      resp
      resp
      path
      resp
      name
      req
      name))
    ((bidi)
     (format
      (string-append
       "        public ~a~aStream ~a(List<~a> reqs, Map<String, String> metadata) throws Exception {\n"
       "            return new ~a~aStream(channel.bidi(~s, reqs, metadata));\n"
       "        }\n\n"
       "        public ~a~aStream ~a(List<~a> reqs) throws Exception {\n"
       "            return ~a(reqs, null);\n"
       "        }\n")
      svc
      name
      name
      req
      svc
      name
      path
      svc
      name
      name
      req
      name))))

(define (java-client-method m)
  (string-append (java-deprecated m "        ") (java-client-method/raw m)))

(define (java-client-timeout-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "\n        /** Deadline variant: timeout propagates as grpc-timeout; expiry raises DEADLINE_EXCEEDED. */\n"
       "        public ~a ~a(~a req, Map<String, String> metadata, java.time.Duration timeout) throws Exception {\n"
       "            ~a resp = new ~a();\n"
       "            channel.unary(~s, req, resp, metadata, timeout);\n"
       "            return resp;\n"
       "        }\n")
      resp
      name
      req
      resp
      resp
      path))
    ((server-streaming)
     (format
      (string-append
       "\n        /** Deadline variant of ~a. */\n"
       "        public ~a~aStream ~a(~a req, Map<String, String> metadata, java.time.Duration timeout) throws Exception {\n"
       "            return new ~a~aStream(channel.serverStream(~s, req, metadata, timeout));\n"
       "        }\n")
      name
      svc
      name
      name
      req
      svc
      name
      path))
    ((client-streaming)
     (format
      (string-append
       "\n        /** Deadline variant of ~a. */\n"
       "        public ~a ~a(List<~a> reqs, Map<String, String> metadata, java.time.Duration timeout) throws Exception {\n"
       "            ~a resp = new ~a();\n"
       "            channel.clientStream(~s, reqs, resp, metadata, timeout);\n"
       "            return resp;\n"
       "        }\n")
      name
      resp
      name
      req
      resp
      resp
      path))
    ((bidi)
     (format
      (string-append
       "\n        /** Deadline variant of ~a. */\n"
       "        public ~a~aStream ~a(List<~a> reqs, Map<String, String> metadata, java.time.Duration timeout) throws Exception {\n"
       "            return new ~a~aStream(channel.bidi(~s, reqs, metadata, timeout));\n"
       "        }\n")
      name
      svc
      name
      name
      req
      svc
      name
      path))))

(define (java-client-stream-class m)
  (define name (hash-ref m 'name))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((server-streaming bidi)
     (format
      (string-append
       "    /** Receiving stream for ~a.~a: recv() throws EOFException at end. Close to abandon early (RST). */\n"
       "    public static final class ~a~aStream implements AutoCloseable {\n"
       "        private final Channel.ClientStream stream;\n\n"
       "        ~a~aStream(Channel.ClientStream stream) {\n"
       "            this.stream = stream;\n"
       "        }\n\n"
       "        public ~a recv() throws Exception {\n"
       "            ~a resp = new ~a();\n"
       "            stream.recv(resp);\n"
       "            return resp;\n"
       "        }\n\n"
       "        /** Initial metadata (response headers); null until they arrive. */\n"
       "        public Map<String, String> headers() {\n"
       "            return stream.headers() == null ? null : stream.headers().metadata;\n"
       "        }\n\n"
       "        /** Trailing metadata of the terminal status; null until it arrives. */\n"
       "        public Map<String, String> trailers() {\n"
       "            return stream.trailers();\n"
       "        }\n\n"
       "        /** Abort this stream (sends RST, wakes a pending recv). */\n"
       "        public void cancel() {\n"
       "            stream.cancel();\n"
       "        }\n\n"
       "        /** Abandon the call if still live (RST); no-op once terminated. */\n"
       "        @Override\n"
       "        public void close() {\n"
       "            stream.close();\n"
       "        }\n"
       "    }\n\n")
      svc
      name
      svc
      name
      svc
      name
      resp
      resp
      resp))
    (else "")))

