(define (java-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format "    /** Client for ~a. */\n" (hash-ref svc 'full-name))
    (format "    public static final class ~aClient {\n" sname)
    "        private final Channel channel;\n\n"
    (format
     "        public ~aClient(Channel channel) {\n            this.channel = channel;\n        }\n\n"
     sname)
    (apply
     string-append
     (map java-client-method (append methods (alias-client-methods svc))))
    (apply
     string-append
     (map
      java-client-async-method
      (append methods (alias-client-methods svc))))
    "    }\n\n"
    (apply string-append (map java-client-stream-class methods))
    (format
     "    /** Service implementation interface for ~a. */\n"
     (hash-ref svc 'full-name))
    (format "    public interface ~aServer {\n" sname)
    (apply string-append (map java-server-iface-method methods))
    "    }\n\n"
    (apply string-append (map java-server-stream-ifaces methods))
    (apply string-append (map java-stream-impls methods))
    (format
     "    /** Async service implementation interface for ~a. */\n"
     (hash-ref svc 'full-name))
    (format "    public interface ~aServerAsync {\n" sname)
    (apply string-append (map java-server-async-iface-method methods))
    "    }\n\n"
    (format
     "    private static final class ~aServerAsyncAdapter implements ~aServer {\n"
     sname
     sname)
    (format "        private final ~aServerAsync impl;\n\n" sname)
    (format
     "        ~aServerAsyncAdapter(~aServerAsync impl) {\n            this.impl = impl;\n        }\n\n"
     sname
     sname)
    (apply string-append (map java-server-async-adapter-method methods))
    "    }\n\n"
    (format
     "    /** Register an implementation of ~a on a Server. */\n"
     (hash-ref svc 'full-name))
    (format
     "    public static void register~aServer(Server server, ~aServer impl) {\n"
     sname
     sname)
    (format
     "        server.registerService(new Server.ServiceDesc(\n                ~s,\n                List.of(\n"
     (hash-ref svc 'full-name))
    (string-join
     (map
      (lambda (m)
        (regexp-replace #rx"\\}\\),[ \t\r\n]*$" (java-register-method m) "})"))
      (append methods (alias-server-methods svc)))
     ",\n")
    "\n                )));\n    }\n"
    (format
     "    /** Register an async implementation of ~a on a Server. */\n"
     (hash-ref svc 'full-name))
    (format
     "    public static void register~aServerAsync(Server server, ~aServerAsync impl) {\n"
     sname
     sname)
    (format
     "        register~aServer(server, new ~aServerAsyncAdapter(impl));\n    }\n"
     sname
     sname))))

(define (emit-java-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define class-name (string-append (pascal (string->symbol base)) "GrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (cons
   (string-append class-name ".java")
   (string-append
    "// @generated by protoc-gen-grpc-dc-java (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n\n" (hash-ref file-model 'name))
    (if (string=? pkg "") "" (format "package ~a;\n\n" pkg))
    "import grpcdc.Channel;\n"
    "import grpcdc.Endpoint;\n"
    "import grpcdc.Server;\n"
    "import grpcdc.StatusException;\n"
    "import grpcdc.Wire;\n"
    "import java.util.ArrayList;\n"
    "import java.util.List;\n"
    "import java.util.Map;\n"
    "import java.util.concurrent.CompletableFuture;\n"
    "import java.util.concurrent.CompletionException;\n\n"
    (format
     "/** Generated gRPC-over-DataChannels stubs for ~a. */\n"
     (hash-ref file-model 'name))
    (format
     "public final class ~a {\n    private ~a() {}\n\n"
     class-name
     class-name)
    (apply string-append (map java-service (hash-ref file-model 'services)))
    "}\n")))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (write-bytes
   (encode-response (map (lambda (f) (emit-java-file f params)) files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
