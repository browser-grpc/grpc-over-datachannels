(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq 'kind 'enum 'msg #f 'enum e 'file file 'pkg pkg))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq 'kind 'enum 'msg #f 'enum e 'file (hash-ref f 'name) 'pkg pkg))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (for/list
     ((f (in-list (pb-get-all fields 15))))
     (parse-file-desc (pb-parse f))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-ref
      by-name
      w
      (lambda ()
        (error 'parse-request "file_to_generate not in request: ~a" w)))
     'types
     registry))
   parameter))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define current-service (make-parameter ""))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "[_.-]"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (wasm-swift-client-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        func ~a(_ req: ~a, _ callback: @escaping (Result<~a, StatusException>) -> Void) {\n"
       "            bridge.unary(~s, req.MarshalDc()) { result in\n"
       "                callback(result.map { bytes in\n"
       "                    let resp = ~a()\n"
       "                    resp.UnmarshalDc(bytes)\n"
       "                    return resp\n"
       "                })\n"
       "            }\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "        func ~a(_ req: ~a, _ onMessage: @escaping (~a) -> Void,\n"
       "                _ onDone: @escaping (StatusException?) -> Void) {\n"
       "            bridge.serverStream(~s, req.MarshalDc(), { bytes in\n"
       "                let resp = ~a()\n"
       "                resp.UnmarshalDc(bytes)\n"
       "                onMessage(resp)\n"
       "            }, onDone)\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "        func ~a(_ reqs: [~a], _ callback: @escaping (Result<~a, StatusException>) -> Void) {\n"
       "            bridge.clientStream(~s, reqs.map { $0.MarshalDc() }) { result in\n"
       "                callback(result.map { bytes in\n"
       "                    let resp = ~a()\n"
       "                    resp.UnmarshalDc(bytes)\n"
       "                    return resp\n"
       "                })\n"
       "            }\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))
    ((bidi)
     (format
      (string-append
       "        func ~a(_ reqs: [~a], _ onMessage: @escaping (~a) -> Void,\n"
       "                _ onDone: @escaping (StatusException?) -> Void) {\n"
       "            bridge.bidi(~s, reqs.map { $0.MarshalDc() }, { bytes in\n"
       "                let resp = ~a()\n"
       "                resp.UnmarshalDc(bytes)\n"
       "                onMessage(resp)\n"
       "            }, onDone)\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))))

(define (wasm-swift-server-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "        func ~a(_ req: ~a, _ metadata: [(String, String)]) -> Result<~a, StatusException>\n"
      name
      req
      resp))
    ((server-streaming)
     (format
      "        func ~a(_ req: ~a, _ metadata: [(String, String)], _ sink: ~aServerSink) -> StatusException?\n"
      name
      req
      (current-service)))
    ((client-streaming)
     (format
      "        func ~a(_ reqs: [~a], _ metadata: [(String, String)]) -> Result<~a, StatusException>\n"
      name
      req
      resp))
    ((bidi)
     (format
      "        func ~a(_ reqs: [~a], _ metadata: [(String, String)], _ sink: ~aServerSink) -> StatusException?\n"
      name
      req
      (current-service)))))

(define (wasm-swift-serve-export enum-name m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define export-name
    (let* ((raw (hash-ref m 'name))
           (n (if (symbol? raw) (symbol->string raw) raw)))
      (string-append
       "serve_"
       (string (char-downcase (string-ref n 0)))
       (substring n 1))))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "@_cdecl(~s)\n"
       "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
       "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
       "    let req = ~a()\n"
       "    req.UnmarshalDc(Array(UnsafeBufferPointer(start: payload, count: payloadLen)))\n"
       "    switch ~a.serverImpl!.~a(req, metadata) {\n"
       "    case .success(let resp): ServerRespond(callId, resp.MarshalDc())\n"
       "    case .failure(let st): ServerFail(callId, st)\n"
       "    }\n"
       "}\n\n")
      export-name
      export-name
      req
      enum-name
      name))
    ((server-streaming)
     (format
      (string-append
       "@_cdecl(~s)\n"
       "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
       "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
       "    let req = ~a()\n"
       "    req.UnmarshalDc(Array(UnsafeBufferPointer(start: payload, count: payloadLen)))\n"
       "    if let st = ~a.serverImpl!.~a(req, metadata, ~a.~aServerSink(callId: callId)) {\n"
       "        ServerFail(callId, st)\n"
       "    } else {\n"
       "        ServerComplete(callId)\n"
       "    }\n"
       "}\n\n")
      export-name
      export-name
      req
      enum-name
      name
      enum-name
      (current-service)))
    ((client-streaming)
     (format
      (string-append
       "@_cdecl(~s)\n"
       "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
       "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
       "    let reqs = UnpackPacked(Array(UnsafeBufferPointer(start: payload, count: payloadLen))).map { bytes -> ~a in let req = ~a(); req.UnmarshalDc(bytes); return req }\n"
       "    switch ~a.serverImpl!.~a(reqs, metadata) {\n"
       "    case .success(let resp): ServerRespond(callId, resp.MarshalDc())\n"
       "    case .failure(let st): ServerFail(callId, st)\n"
       "    }\n"
       "}\n\n")
      export-name
      export-name
      req
      req
      enum-name
      name))
    ((bidi)
     (format
      (string-append
       "@_cdecl(~s)\n"
       "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
       "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
       "    let reqs = UnpackPacked(Array(UnsafeBufferPointer(start: payload, count: payloadLen))).map { bytes -> ~a in let req = ~a(); req.UnmarshalDc(bytes); return req }\n"
       "    if let st = ~a.serverImpl!.~a(reqs, metadata, ~a.~aServerSink(callId: callId)) {\n"
       "        ServerFail(callId, st)\n"
       "    } else {\n"
       "        ServerComplete(callId)\n"
       "    }\n"
       "}\n\n")
      export-name
      export-name
      req
      req
      enum-name
      name
      enum-name
      (current-service)))))

(define (wasm-swift-stream-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       "        func ~aBegin(_ callId: UInt32, _ metadata: [(String, String)])\n"
       name)
      (format "        func ~aRequest(_ callId: UInt32, _ req: ~a)\n" name req)
      (format
       "        func ~aEnd(_ callId: UInt32) -> Result<~a, StatusException>\n"
       name
       resp)))
    ((bidi)
     (string-append
      (format
       "        func ~aBegin(_ callId: UInt32, _ metadata: [(String, String)])\n"
       name)
      (format
       "        func ~aRequest(_ callId: UInt32, _ req: ~a, _ sink: ~aServerSink) -> StatusException?\n"
       name
       req
       svc)
      (format
       "        func ~aEnd(_ callId: UInt32) -> StatusException?\n"
       name)))
    (else "")))

(define (wasm-swift-export-name m)
  (let* ((raw (hash-ref m 'name))
         (n (if (symbol? raw) (symbol->string raw) raw)))
    (string-append
     "serve_"
     (string (char-downcase (string-ref n 0)))
     (substring n 1))))

(define (wasm-swift-stream-feed-export enum-name m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define export-name (wasm-swift-export-name m))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
        "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
        "    ~a.streamImpl!.~aBegin(callId, metadata)\n"
        "}\n\n")
       (string-append export-name "Start")
       (string-append export-name "Start")
       enum-name
       name)
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int) {\n"
        "    let req = ~a()\n"
        "    req.UnmarshalDc(Array(UnsafeBufferPointer(start: payload, count: payloadLen)))\n"
        "    ~a.streamImpl!.~aRequest(callId, req)\n"
        "}\n\n")
       (string-append export-name "Feed")
       (string-append export-name "Feed")
       req
       enum-name
       name)
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32) {\n"
        "    switch ~a.streamImpl!.~aEnd(callId) {\n"
        "    case .success(let resp): ServerRespond(callId, resp.MarshalDc())\n"
        "    case .failure(let st): ServerFail(callId, st)\n"
        "    }\n"
        "}\n\n")
       (string-append export-name "End")
       (string-append export-name "End")
       enum-name
       name)))
    ((bidi)
     (string-append
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32, _ md: UnsafePointer<UInt8>, _ mdLen: Int) {\n"
        "    let metadata = DecodeMetadata(Array(UnsafeBufferPointer(start: md, count: mdLen)))\n"
        "    ~a.streamImpl!.~aBegin(callId, metadata)\n"
        "}\n\n")
       (string-append export-name "Start")
       (string-append export-name "Start")
       enum-name
       name)
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32, _ payload: UnsafePointer<UInt8>, _ payloadLen: Int) {\n"
        "    let req = ~a()\n"
        "    req.UnmarshalDc(Array(UnsafeBufferPointer(start: payload, count: payloadLen)))\n"
        "    if let st = ~a.streamImpl!.~aRequest(callId, req, ~a.~aServerSink(callId: callId)) {\n"
        "        ServerFail(callId, st)\n"
        "    }\n"
        "}\n\n")
       (string-append export-name "Feed")
       (string-append export-name "Feed")
       req
       enum-name
       name
       enum-name
       (current-service))
      (format
       (string-append
        "@_cdecl(~s)\n"
        "public func ~a(_ callId: UInt32) {\n"
        "    if let st = ~a.streamImpl!.~aEnd(callId) {\n"
        "        ServerFail(callId, st)\n"
        "    } else {\n"
        "        ServerComplete(callId)\n"
        "    }\n"
        "}\n\n")
       (string-append export-name "End")
       (string-append export-name "End")
       enum-name
       name)))
    (else "")))

(define (wasm-swift-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format
     "    /// Client for ~a (browser/WASM facade; see file doc).\n"
     (hash-ref svc 'full-name))
    (format "    final class ~aClient {\n" sname)
    "        private let bridge: GrpcDcWasmBridge\n\n"
    "        init(_ bridge: GrpcDcWasmBridge = .shared) {\n"
    "            self.bridge = bridge\n"
    "        }\n\n"
    (apply
     string-append
     (map
      wasm-swift-client-method
      (append methods (alias-client-methods svc))))
    "    }\n\n"
    (format "    /// Streaming response sink for server handlers.\n")
    (format "    struct ~aServerSink {\n" sname)
    "        let callId: UInt32\n\n"
    (apply
     string-append
     (for/list
      ((resp
        (in-list
         (remove-duplicates (map (lambda (m) (hash-ref m 'output)) methods)))))
      (format
       "        func Send(_ resp: ~a) {\n            ServerSend(callId, resp.MarshalDc())\n        }\n"
       resp)))
    "    }\n\n"
    (format
     "    /// Service implementation for ~a (browser/WASM facade).\n"
     (hash-ref svc 'full-name))
    (format "    protocol ~aServer {\n" sname)
    (apply string-append (map wasm-swift-server-iface-method methods))
    "    }\n\n"
    (format "    static var serverImpl: ~aServer?\n\n" sname)
    (format
     "    /// Register the service implementation used by the serve_* exports.\n")
    (format
     "    static func register~aServer(_ impl: ~aServer) {\n"
     sname
     sname)
    (format "        serverImpl = impl\n")
    "    }\n\n"
    (format
     "    /// Incremental service implementation for ~a: requests arrive one at a time.\n"
     (hash-ref svc 'full-name))
    (format "    protocol ~aStreamServer {\n" sname)
    (apply string-append (map wasm-swift-stream-iface-method methods))
    "    }\n\n"
    (format "    static var streamImpl: ~aStreamServer?\n\n" sname)
    (format
     "    /// Register the incremental implementation used by the serve_*Start/Feed/End exports.\n")
    (format
     "    static func register~aStreamServer(_ impl: ~aStreamServer) {\n"
     sname
     sname)
    (format "        streamImpl = impl\n")
    "    }\n")))

(define (emit-wasm-swift-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define enum-name
    (string-append (pascal (string->symbol base)) "WasmGrpcDc"))
  (cons
   (string-append (pascal (string->symbol base)) "WasmGrpcDc.swift")
   (string-append
    "// @generated by protoc-gen-grpc-dc-wasm-swift (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n\n" (hash-ref file-model 'name))
    (format
     "/// Generated WASM facade stubs for ~a.\n"
     (hash-ref file-model 'name))
    (format "enum ~a {\n" enum-name)
    (apply
     string-append
     (map wasm-swift-service (hash-ref file-model 'services)))
    "}\n\n"
    (apply
     string-append
     (for/list
      ((svc (in-list (hash-ref file-model 'services))))
      (parameterize
       ((current-service (hash-ref svc 'name)))
       (string-append
        (apply
         string-append
         (map
          (lambda (m) (wasm-swift-serve-export enum-name m))
          (hash-ref svc 'methods)))
        (apply
         string-append
         (map
          (lambda (m) (wasm-swift-stream-feed-export enum-name m))
          (hash-ref svc 'methods))))))))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map
        stamp-generated-header
        (as-file-list (emit-wasm-swift-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
