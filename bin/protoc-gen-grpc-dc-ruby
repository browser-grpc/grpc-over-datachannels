(define (scalar-type-entry lang type)
  (define row (assq lang scalar-type-tables))
  (unless row (error 'scalar-type-entry "unknown language: ~e" lang))
  (define e (assv type (cddr row)))
  (if e (cdr e) (cadr row)))

(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'extendee
   (string-trim (pb-get-string fields 2 "") ".")
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'default
   (pb-get-string fields 7 #f)
   'oneof-index
   (pb-get fields 9 #f)
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 6))))
    (parse-field-desc (pb-parse f)))
   'oneofs
   (for/list
    ((o (in-list (pb-get-all fields 8))))
    (pb-get-string (pb-parse o) 1))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'syntax
   (let ((s (pb-get-string fields 12 ""))) (if (string=? s "") "proto2" s))
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 7))))
    (parse-field-desc (pb-parse f)))))

(define (merge-extensions files)
  (define exts
    (append
     (append-map (lambda (f) (hash-ref f 'extensions)) files)
     (let loop ((msgs (append-map (lambda (f) (hash-ref f 'messages)) files)))
       (if (null? msgs)
         '()
         (append
          (append-map (lambda (m) (hash-ref m 'extensions)) msgs)
          (loop (append-map (lambda (m) (hash-ref m 'nested)) msgs)))))))
  (define (add-to msg ext)
    (if (equal? (hash-ref msg 'full-name) (hash-ref ext 'extendee))
      (hash-set msg 'fields (append (hash-ref msg 'fields) (list ext)))
      (hash-set
       msg
       'nested
       (map (lambda (n) (add-to n ext)) (hash-ref msg 'nested)))))
  (for/fold
   ((fs files))
   ((ext (in-list exts)))
   (map
    (lambda (f)
      (hash-set
       f
       'messages
       (map (lambda (m) (add-to m ext)) (hash-ref f 'messages))))
    fs)))

(define (oneof-siblings model f)
  (define idx (hash-ref f 'oneof-index #f))
  (if (not idx)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (filter
         (lambda (x)
           (and (not (eq? x f)) (equal? (hash-ref x 'oneof-index #f) idx)))
         (hash-ref (car msgs) 'fields)))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (oneof-later-siblings model f)
  (define sibs (oneof-siblings model f))
  (if (null? sibs)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (define fields (hash-ref (car msgs) 'fields))
        (filter (lambda (x) (memq x (cdr (memq f fields)))) sibs))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (field-owner model f)
  (let search ((msgs (hash-ref model 'messages '())))
    (cond
     ((null? msgs) #f)
     ((memq f (hash-ref (car msgs) 'fields)) (car msgs))
     (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs)))))))

(define (field-explicit-default f)
  (and (hash-ref f 'default #f)
       (not (= (hash-ref f 'label 1) 3))
       (not (memv (hash-ref f 'type) '(10 11 12)))
       (hash-ref f 'default)))

(define (enum-default-number model f)
  (define types (and (hash-has-key? model 'types) (hash-ref model 'types)))
  (define entry (and types (hash-ref types (hash-ref f 'type-name) #f)))
  (define e (and entry (hash-ref entry 'enum #f)))
  (define v
    (and e
         (findf
          (lambda (x) (equal? (hash-ref x 'name) (hash-ref f 'default)))
          (hash-ref e 'values))))
  (and v (hash-ref v 'number)))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg
      'full
      (hash-ref msg 'full-name)))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq
       'kind
       'enum
       'msg
       #f
       'enum
       e
       'file
       file
       'pkg
       pkg
       'full
       (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq
      'kind
      'enum
      'msg
      #f
      'enum
      e
      'file
      (hash-ref f 'name)
      'pkg
      pkg
      'full
      (if (string=? pkg "")
        (hash-ref e 'name)
        (format "~a.~a" pkg (hash-ref e 'name)))))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (merge-extensions
     (for/list
      ((f (in-list (pb-get-all fields 15))))
      (parse-file-desc (pb-parse f)))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-set
      (hash-ref
       by-name
       w
       (lambda ()
         (error 'parse-request "file_to_generate not in request: ~a" w)))
      'types
      registry)
     'generate-set
     wanted))
   parameter))

(define (map-entry-emitted-in-own-file? model entry)
  (define types (hash-ref model 'types #f))
  (and types
       (not (equal? (hash-ref entry 'file) (hash-ref model 'name)))
       (member (hash-ref entry 'file) (hash-ref model 'generate-set '()))
       (for/or
        (((k e) (in-hash types)))
        (and (eq? (hash-ref e 'kind) 'message)
             (equal? (hash-ref e 'file) (hash-ref entry 'file))
             (for/or
              ((f (in-list (hash-ref (hash-ref e 'msg) 'fields))))
              (and (= (hash-ref f 'type) 11)
                   (equal?
                    (hash-ref f 'type-name)
                    (hash-ref entry 'full))))))))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define go-register-method-program
  '((kind-case
     (unary
      (fmt
       "\t\t{Name: ~s, Path: ~s, Kind: grpcdc.KindUnary, Handler: func(ctx context.Context, reqs *grpcdc.RequestStream, sink grpcdc.ServerSink) error {\n\t\t\treq := new(~a)\n\t\t\tif err := reqs.RecvInto(req); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tresp, err := srv.~a(ctx, req)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn sink.Send(resp.MarshalDC())\n\t\t}},\n"
       (ref name)
       (ref path)
       (ref input)
       (ref impl-name)))
     (server-streaming
      (fmt
       "\t\t{Name: ~s, Path: ~s, Kind: grpcdc.KindServerStreaming, Handler: func(ctx context.Context, reqs *grpcdc.RequestStream, sink grpcdc.ServerSink) error {\n\t\t\treq := new(~a)\n\t\t\tif err := reqs.RecvInto(req); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\treturn srv.~a(req, &~a~aServerImpl{ctx: ctx, sink: sink})\n\t\t}},\n"
       (ref name)
       (ref path)
       (ref input)
       (ref impl-name)
       (svc)
       (ref impl-name)))
     (client-streaming
      (fmt
       "\t\t{Name: ~s, Path: ~s, Kind: grpcdc.KindClientStreaming, Handler: func(ctx context.Context, reqs *grpcdc.RequestStream, sink grpcdc.ServerSink) error {\n\t\t\tstream := &~a~aServerImpl{ctx: ctx, reqs: reqs}\n\t\t\tif err := srv.~a(stream); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif stream.resp == nil {\n\t\t\t\treturn grpcdc.NewStatus(grpcdc.CodeInternal, \"client-streaming handler never called SendAndClose\")\n\t\t\t}\n\t\t\treturn sink.Send(stream.resp.MarshalDC())\n\t\t}},\n"
       (ref name)
       (ref path)
       (svc)
       (ref impl-name)
       (ref impl-name)))
     (bidi
      (fmt
       "\t\t{Name: ~s, Path: ~s, Kind: grpcdc.KindBidi, Handler: func(ctx context.Context, reqs *grpcdc.RequestStream, sink grpcdc.ServerSink) error {\n\t\t\treturn srv.~a(&~a~aServerImpl{ctx: ctx, reqs: reqs, sink: sink})\n\t\t}},\n"
       (ref name)
       (ref path)
       (ref impl-name)
       (svc)
       (ref impl-name))))))

(define (seg-ref node key)
  (if (eq? key 'impl-name)
    (hash-ref node 'impl-name (hash-ref node 'name))
    (hash-ref node key)))

(define (run-segments program node svc)
  (apply
   string-append
   (for/list ((seg (in-list program))) (run-segment seg node svc))))

(define (run-segment seg node svc)
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply
     format
     (second seg)
     (map (lambda (e) (run-segment e node svc)) (cddr seg))))
   ((eq? (car seg) 'ref) (seg-ref node (second seg)))
   ((eq? (car seg) 'svc) svc)
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch (assq kind (cdr seg)))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-segments (cdr branch) node svc))
   (else (error 'run-segments "bad segment: ~e" seg))))

(define current-service (make-parameter ""))

(define (snake sym)
  (define s (symbol->string sym))
  (apply
   string-append
   (for/list
    ((c (in-string s)) (i (in-naturals)))
    (cond
     ((char-upper-case? c)
      (string-append (if (> i 0) "_" "") (string (char-downcase c))))
     (else (string c))))))

(define (camel str)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split str "_"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (rb-deprecated m)
  (if (hash-ref m 'deprecated #f) "      warn \"deprecated\"\n" ""))

(define (rb-client-method/raw model m)
  (define name (hash-ref m 'name))
  (define resp (rb-stub-ref model (hash-ref m 'output-full)))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    def ~a(req, metadata = nil, timeout: nil)\n"
       "~a      @channel.unary(~s, req, ~a.new, metadata, timeout: timeout)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "    def ~a(req, metadata = nil, timeout: nil)\n"
       "~a      stream = @channel.server_stream(~s, req, metadata, timeout: timeout)\n"
       "      RecvStream.new(stream, ~a)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "    def ~a(reqs, metadata = nil, timeout: nil)\n"
       "~a      @channel.client_stream(~s, reqs, ~a.new, metadata, timeout: timeout)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((bidi)
     (format
      (string-append
       "    def ~a(reqs, metadata = nil, timeout: nil)\n"
       "~a      stream = @channel.bidi(~s, reqs, metadata, timeout: timeout)\n"
       "      RecvStream.new(stream, ~a)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))))

(define (rb-client-method model m) (rb-client-method/raw model m))

(define (rb-fiber-client-method model m)
  (define name (hash-ref m 'name))
  (define resp (rb-stub-ref model (hash-ref m 'output-full)))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    def ~a(req, metadata = nil, timeout: nil)\n"
       "~a      @channel.unary(~s, req, ~a.new, metadata, timeout: timeout)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "    def ~a(req, metadata = nil, timeout: nil)\n"
       "~a      stream = @channel.server_stream(~s, req, metadata, timeout: timeout)\n"
       "      FiberRecvStream.new(stream, ~a)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "    def ~a(reqs, metadata = nil, timeout: nil)\n"
       "~a      @channel.client_stream(~s, reqs, ~a.new, metadata, timeout: timeout)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))
    ((bidi)
     (format
      (string-append
       "    def ~a(reqs, metadata = nil, timeout: nil)\n"
       "~a      stream = @channel.bidi(~s, reqs, metadata, timeout: timeout)\n"
       "      FiberRecvStream.new(stream, ~a)\n"
       "    end\n\n")
      name
      (rb-deprecated m)
      path
      resp))))

(define (rb-server-handler model m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (rb-stub-ref model (hash-ref m 'input-full)))
  (define handler-var (string-append (snake (string->symbol name)) "_handler"))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    ~a = lambda do |ctx, reqs, sink|\n"
       "      req = reqs.recv_into(~a.new)\n"
       "      resp = impl.~a(ctx, req)\n"
       "      sink.send(resp.marshal_dc)\n"
       "    end\n\n")
      handler-var
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "    ~a = lambda do |ctx, reqs, sink|\n"
       "      req = reqs.recv_into(~a.new)\n"
       "      impl.~a(req, SendStream.new(ctx, sink))\n"
       "    end\n\n")
      handler-var
      req
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "    ~a = lambda do |ctx, reqs, sink|\n"
       "      stream = ClientStreamImpl.new(ctx, reqs, ~a)\n"
       "      impl.~a(stream)\n"
       "      if stream.resp.nil?\n"
       "        raise Grpcdc::StatusError.new(Grpcdc::CODE_INTERNAL, \"client-streaming handler never called SendAndClose\")\n"
       "      end\n"
       "      sink.send(stream.resp.marshal_dc)\n"
       "    end\n\n")
      handler-var
      req
      impl-name))
    ((bidi)
     (format
      (string-append
       "    ~a = lambda do |ctx, reqs, sink|\n"
       "      impl.~a(BidiStream.new(ctx, reqs, sink, ~a))\n"
       "    end\n\n")
      handler-var
      impl-name
      req))))

(define (rb-method-entry m)
  (define kind-name
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (format
   "        Grpcdc::Method.new(~s, ~s, Grpcdc::~a, ~a),\n"
   (hash-ref m 'name)
   (hash-ref m 'path)
   kind-name
   (string-append (snake (string->symbol (hash-ref m 'name))) "_handler")))

(define rb-stream-helpers
  (string-append
   "  # Client receiving stream: recv raises EOFError at end.\n"
   "  class RecvStream\n"
   "    include Enumerable\n\n"
   "    def initialize(stream, resp_cls)\n"
   "      @stream = stream\n"
   "      @resp_cls = resp_cls\n"
   "    end\n\n"
   "    def recv\n"
   "      @stream.recv(@resp_cls.new)\n"
   "    end\n\n"
   "    # Response initial metadata (after the first recv).\n"
   "    def headers\n"
   "      @stream.headers&.metadata\n"
   "    end\n\n"
   "    # Response trailing metadata (after the call ends).\n"
   "    def trailers\n"
   "      @stream.trailers\n"
   "    end\n\n"
   "    # Abandon the call early: RST so the server stops producing.\n"
   "    def cancel\n"
   "      @stream.cancel\n"
   "    end\n\n"
   "    def close\n"
   "      @stream.cancel\n"
   "    end\n\n"
   "    def each\n"
   "      return enum_for(:each) unless block_given?\n\n"
   "      begin\n"
   "        loop do\n"
   "          begin\n"
   "            yield recv\n"
   "          rescue EOFError\n"
   "            return\n"
   "          end\n"
   "        end\n"
   "      ensure\n"
   "        # Breaking out of the block abandons the call: RST so\n"
   "        # the server stops producing (no-op once terminated).\n"
   "        close\n"
   "      end\n"
   "    end\n"
   "  end\n\n"
   "  # Server-streaming sink passed to service implementations.\n"
   "  class SendStream\n"
   "    attr_reader :context\n\n"
   "    def initialize(ctx, sink)\n"
   "      @context = ctx\n"
   "      @sink = sink\n"
   "    end\n\n"
   "    def send(resp)\n"
   "      @sink.send(resp.marshal_dc)\n"
   "    end\n"
   "  end\n\n"
   "  # Client-streaming stream passed to service implementations.\n"
   "  class ClientStreamImpl\n"
   "    attr_reader :context, :resp\n\n"
   "    def initialize(ctx, reqs, req_cls)\n"
   "      @context = ctx\n"
   "      @reqs = reqs\n"
   "      @req_cls = req_cls\n"
   "      @resp = nil\n"
   "    end\n\n"
   "    def recv\n"
   "      @reqs.recv_into(@req_cls.new)\n"
   "    end\n\n"
   "    def send_and_close(resp)\n"
   "      @resp = resp\n"
   "    end\n"
   "  end\n\n"
   "  # Bidi stream passed to service implementations.\n"
   "  class BidiStream\n"
   "    attr_reader :context\n\n"
   "    def initialize(ctx, reqs, sink, req_cls)\n"
   "      @context = ctx\n"
   "      @reqs = reqs\n"
   "      @sink = sink\n"
   "      @req_cls = req_cls\n"
   "    end\n\n"
   "    def send(resp)\n"
   "      @sink.send(resp.marshal_dc)\n"
   "    end\n\n"
   "    def recv\n"
   "      @reqs.recv_into(@req_cls.new)\n"
   "    end\n"
   "  end\n\n"
   "  # Fiber-based client receiving stream: a producer Fiber\n"
   "  # yields each response; next_msg resumes it and raises\n"
   "  # StopIteration when the call completes. cancel aborts\n"
   "  # the underlying stream (RST).\n"
   "  class FiberRecvStream\n"
   "    include Enumerable\n\n"
   "    DONE = Object.new\n\n"
   "    def initialize(stream, resp_cls)\n"
   "      @stream = stream\n"
   "      @resp_cls = resp_cls\n"
   "      @fiber = Fiber.new do\n"
   "        begin\n"
   "          loop { Fiber.yield(@stream.recv(@resp_cls.new)) }\n"
   "        rescue EOFError\n"
   "          DONE\n"
   "        end\n"
   "      end\n"
   "    end\n\n"
   "    def next_msg\n"
   "      value = @fiber.resume\n"
   "      raise StopIteration if value.equal?(DONE)\n\n"
   "      value\n"
   "    end\n\n"
   "    # Response initial metadata (after the first recv).\n"
   "    def headers\n"
   "      @stream.headers&.metadata\n"
   "    end\n\n"
   "    # Response trailing metadata (after the call ends).\n"
   "    def trailers\n"
   "      @stream.trailers\n"
   "    end\n\n"
   "    def cancel\n"
   "      @stream.cancel\n"
   "    end\n\n"
   "    def close\n"
   "      @stream.cancel\n"
   "    end\n\n"
   "    def each\n"
   "      return enum_for(:each) unless block_given?\n\n"
   "      begin\n"
   "        loop do\n"
   "          begin\n"
   "            yield next_msg\n"
   "          rescue StopIteration\n"
   "            return\n"
   "          end\n"
   "        end\n"
   "      ensure\n"
   "        # Breaking out of the block abandons the call: RST so\n"
   "        # the server stops producing (no-op once terminated).\n"
   "        close\n"
   "      end\n"
   "    end\n"
   "  end\n\n"))

(define (rb-service model svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format
     "  class ~aClient\n    def initialize(channel)\n      @channel = channel\n    end\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (rb-client-method model m))
      (append methods (alias-client-methods svc))))
    "  end\n\n"
    (format
     "  # Fiber client: wraps a Grpcdc::FiberChannel (a sync Channel is wrapped).\n  class ~aClientFiber\n    def initialize(channel)\n      @channel = channel.is_a?(Grpcdc::FiberChannel) ? channel : Grpcdc::FiberChannel.new(channel)\n    end\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (rb-fiber-client-method model m))
      (append methods (alias-client-methods svc))))
    "  end\n\n"
    (format
     "  def self.register_~a_server(server, impl)\n"
     (snake (string->symbol sname)))
    (apply
     string-append
     (map
      (lambda (m) (rb-server-handler model m))
      (append methods (alias-server-methods svc))))
    (format
     "    server.register_service(Grpcdc::ServiceDesc.new(\n      ~s,\n      [\n"
     (hash-ref svc 'full-name))
    (apply
     string-append
     (map rb-method-entry (append methods (alias-server-methods svc))))
    "      ]\n    ))\n  end\n")))

(define rb-pb-varint-types varint-scalar-types)

(define rb-pb-fixed (fixed-scalar-table 'ruby))

(define (rb-pb-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (rb-pb-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'emit-ruby-pb-file "unresolved type ~a" type-name))))

(define (rb-stub-ref file-model full)
  (define e (rb-pb-resolve file-model full))
  (format
   "~a::~a"
   (rb-pb-module-name e)
   (rb-pb-flat (hash-ref e 'pkg) (hash-ref (hash-ref e 'msg) 'full-name))))

(define (rb-stub-requires file-model)
  (if (hash-ref file-model 'types #f)
    (apply
     string-append
     (map
      (lambda (fn)
        (format
         "require_relative \"~a_pb\"\n"
         (path->string (path-replace-extension (file-name-from-path fn) ""))))
      (remove-duplicates
       (append-map
        (lambda (svc)
          (append-map
           (lambda (m)
             (list
              (hash-ref
               (rb-pb-resolve file-model (hash-ref m 'input-full))
               'file)
              (hash-ref
               (rb-pb-resolve file-model (hash-ref m 'output-full))
               'file)))
           (hash-ref svc 'methods)))
        (hash-ref file-model 'services)))))
    (format
     "require_relative \"~a_pb\"\n"
     (path->string
      (path-replace-extension
       (file-name-from-path (hash-ref file-model 'name))
       "")))))

(define (rb-pb-module-name entry)
  (define base
    (path->string
     (path-replace-extension (file-name-from-path (hash-ref entry 'file)) "")))
  (string-append (camel base) "Pb"))

(define (rb-pb-entry-ref model entry)
  (define local
    (rb-pb-flat
     (hash-ref entry 'pkg)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (let ((e (hash-ref entry 'enum)))
         (if (hash-ref entry 'msg)
           (format
            "~a.~a"
            (hash-ref (hash-ref entry 'msg) 'full-name)
            (hash-ref e 'name))
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name))))
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (or (eq? (hash-ref entry 'kind) 'map)
          (equal? (hash-ref entry 'file) (hash-ref model 'name)))
    local
    (format
     "~a::~a"
     (rb-pb-module-name entry)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (hash-ref (hash-ref entry 'enum) 'name)
       (rb-pb-flat
        (hash-ref entry 'pkg)
        (hash-ref (hash-ref entry 'msg) 'full-name))))))

(define (rb-pb-field-name f) (hash-ref f 'name))

(define (rb-pb-explicit-literal model f)
  (define d (field-explicit-default f))
  (and d
       (case (hash-ref f 'type)
         ((9) (format "~s" d))
         ((8) d)
         ((14) (format "~a" (enum-default-number model f)))
         ((2) (format "~a" d))
         (else d))))

(define (rb-pb-default model f)
  (cond
   ((rb-pb-explicit-literal model f) => (lambda (lit) lit))
   ((and (= (hash-ref f 'type) 11)
         (eq?
          (hash-ref (rb-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    "{}")
   ((= (hash-ref f 'label) 3) "[]")
   ((= (hash-ref f 'type) 11) "nil")
   ((= (hash-ref f 'type) 9) "\"\"")
   ((= (hash-ref f 'type) 12) "\"\".b")
   ((= (hash-ref f 'type) 8) "false")
   ((memv (hash-ref f 'type) '(1 2)) "0.0")
   ((= (hash-ref f 'type) 14)
    (define entry (rb-pb-resolve model (hash-ref f 'type-name)))
    (format
     "~a"
     (hash-ref (car (hash-ref (hash-ref entry 'enum) 'values)) 'number)))
   (else "0")))

(define (rb-pb-varint-expr f v)
  (case (hash-ref f 'type)
    ((8) (format "(~a ? 1 : 0)" v))
    ((17) (format "(((~a << 1) ^ (~a >> 31)) & 0xffffffff)" v v))
    ((18) (format "((~a << 1) ^ (~a >> 63))" v v))
    (else v)))

(define (rb-pb-varint-decode f v)
  (case (hash-ref f 'type)
    ((5) (format "(((~a & 0xffffffff) ^ 0x80000000) - 0x80000000)" v))
    ((14) (format "(((~a & 0xffffffff) ^ 0x80000000) - 0x80000000)" v))
    ((13 7) (format "(~a & 0xffffffff)" v))
    ((3)
     (format
      "(((~a & 0xffffffffffffffff) ^ 0x8000000000000000) - 0x8000000000000000)"
      v))
    ((4) (format "(~a & 0xffffffffffffffff)" v))
    ((8) (format "(~a != 0)" v))
    ((17) (format "(((~a & 0xffffffff) >> 1) ^ -((~a & 0xffffffff) & 1))" v v))
    ((18) (format "((~a >> 1) ^ -(~a & 1))" v v))
    (else v)))

(define (rb-pb-fixed-fmt f) (third (assv (hash-ref f 'type) rb-pb-fixed)))

(define (rb-pb-wire f)
  (if (= (second (assv (hash-ref f 'type) rb-pb-fixed)) 8) 1 5))

(define (rb-pb-nonzero f v)
  (case (hash-ref f 'type) ((8) v) (else (format "~a != 0" v))))

(define (rb-pb-encode-singular model pb f v indent)
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define proto2? (equal? (hash-ref model 'syntax "") "proto2"))
  (cond
   ((memv type rb-pb-varint-types)
    (if proto2?
      (format
       "~aw.tag(~a, 0)\n~aw.varint(~a)\n"
       indent
       n
       indent
       (rb-pb-varint-expr f v))
      (format
       "~aif ~a\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~aend\n"
       indent
       (rb-pb-nonzero f v)
       indent
       n
       indent
       (rb-pb-varint-expr f v)
       indent)))
   ((assv type rb-pb-fixed)
    (if proto2?
      (format
       "~aw.tag(~a, ~a)\n~aw.fixed(~s, ~a)\n"
       indent
       n
       (rb-pb-wire f)
       indent
       (rb-pb-fixed-fmt f)
       v)
      (format
       "~aif ~a != 0\n~a  w.tag(~a, ~a)\n~a  w.fixed(~s, ~a)\n~aend\n"
       indent
       v
       indent
       n
       (rb-pb-wire f)
       indent
       (rb-pb-fixed-fmt f)
       v
       indent)))
   ((= type 9)
    (if proto2?
      (format "~aw.bytes_field(~a, ~a.encode(Encoding::UTF_8).b)\n" indent n v)
      (format "~aw.string_field(~a, ~a)\n" indent n v)))
   ((= type 12)
    (if proto2?
      (format "~aw.bytes_field(~a, ~a)\n" indent n v)
      (format
       "~aif ~a.bytesize > 0\n~a  w.bytes_field(~a, ~a)\n~aend\n"
       indent
       v
       indent
       n
       v
       indent)))
   ((= type 11)
    (format
     "~aunless ~a.nil?\n~a  w.bytes_field(~a, ~a.marshal_dc)\n~aend\n"
     indent
     v
     indent
     n
     v
     indent))
   (else
    (error 'emit-ruby-pb-file "unsupported field type ~a (groups)" type))))

(define (rb-pb-set-expr sib)
  (define v (format "@~a" (rb-pb-field-name sib)))
  (case (hash-ref sib 'type)
    ((11 10) (format "!~a.nil?" v))
    ((9 12) (format "(!~a.nil? && !~a.empty?)" v v))
    (else (rb-pb-nonzero sib v))))

(define (rb-pb-encode-guard model f code)
  (define later (oneof-later-siblings model f))
  (if (null? later)
    code
    (string-append
     (format
      "    unless (~a)\n"
      (string-join (map rb-pb-set-expr later) " || "))
     (if (string-suffix? code "\n") code (string-append code "\n"))
     "    end\n")))

(define (rb-pb-encode-field model pb f)
  (define v (format "@~a" (rb-pb-field-name f)))
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (rb-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (rb-pb-resolve model (hash-ref f 'type-name)))
    (define helper
      (format
       "~aPb.encode_~a"
       pb
       (snake (string->symbol (rb-pb-entry-ref model entry)))))
    (format
     "    ~a.each { |k, val| w.bytes_field(~a, ~a(k, val)) }\n"
     v
     n
     helper))
   ((not (= (hash-ref f 'label) 3))
    (rb-pb-encode-singular model pb f v "    "))
   ((memv type rb-pb-varint-types)
    (string-append
     (format "    unless ~a.empty?\n      payload = +\"\".b\n" v)
     (format
      "      ~a.each { |x| payload << ~aPbVarint.call(~a) }\n"
      v
      pb
      (rb-pb-varint-expr f "x"))
     (format "      w.bytes_field(~a, payload)\n    end\n" n)))
   ((assv type rb-pb-fixed)
    =>
    (lambda (info)
      (string-append
       (format "    unless ~a.empty?\n" v)
       (format
        "      w.bytes_field(~a, ~a.pack(~s))\n    end\n"
        n
        v
        (string-append (third info) "*")))))
   ((= type 9) (format "    ~a.each { |x| w.bytes_field(~a, x) }\n" v n))
   ((= type 12) (format "    ~a.each { |x| w.bytes_field(~a, x) }\n" v n))
   ((= type 11)
    (format "    ~a.each { |x| w.bytes_field(~a, x.marshal_dc) }\n" v n))
   (else
    (error 'emit-ruby-pb-file "unsupported repeated field type ~a" type))))

(define (rb-pb-decode-singular model f target src indent)
  (define type (hash-ref f 'type))
  (cond
   ((memv type rb-pb-varint-types)
    (format "~a~a = ~a\n" indent target (rb-pb-varint-decode f src)))
   ((assv type rb-pb-fixed)
    (format "~a~a = ~a.unpack1(~s)\n" indent target src (rb-pb-fixed-fmt f)))
   ((= type 9)
    (format
     "~a~a = ~a.dup.force_encoding(Encoding::UTF_8)\n"
     indent
     target
     src))
   ((= type 12) (format "~a~a = ~a\n" indent target src))
   ((= type 11)
    (define ref
      (rb-pb-entry-ref model (rb-pb-resolve model (hash-ref f 'type-name))))
    (string-append
     (format "~a~a = ~a.new\n" indent target ref)
     (format "~a~a.unmarshal_dc(~a)\n" indent target src)))
   (else (error 'emit-ruby-pb-file "unsupported field type ~a" type))))

(define (rb-pb-oneof-clearing model f)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "        @~a = ~a\n"
       (rb-pb-field-name sib)
       (rb-pb-default model sib)))
    (oneof-siblings model f))))

(define (rb-pb-decode-case model f)
  (define v (format "@~a" (rb-pb-field-name f)))
  (define type (hash-ref f 'type))
  (define head (format "      when ~a\n" (hash-ref f 'number)))
  (define clearing (rb-pb-oneof-clearing model f))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (rb-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (rb-pb-resolve model (hash-ref f 'type-name)))
    (define pb (rb-pb-module-name (hasheq 'file (hash-ref model 'name))))
    (define helper
      (format
       "~a.decode_~a"
       pb
       (snake (string->symbol (rb-pb-entry-ref model entry)))))
    (string-append
     head
     (format "        kk, vv = ~a(bytes_value)\n" helper)
     (format "        ~a[kk] = vv\n" v)))
   ((not (= (hash-ref f 'label) 3))
    (string-append
     head
     clearing
     (rb-pb-decode-singular
      model
      f
      v
      (cond
       ((memv type rb-pb-varint-types) "varint_value")
       ((assv type rb-pb-fixed) "fixed_value")
       (else "bytes_value"))
      "        ")))
   ((memv type rb-pb-varint-types)
    (string-append
     head
     "        if wire == 2\n"
     "          sub = Reader.new(bytes_value)\n"
     "          until sub.done?\n"
     "            raw = sub.varint\n"
     (format "            ~a << ~a\n" v (rb-pb-varint-decode f "raw"))
     "          end\n        else\n"
     (format "          ~a << ~a\n" v (rb-pb-varint-decode f "varint_value"))
     "        end\n"))
   ((assv type rb-pb-fixed)
    =>
    (lambda (info)
      (string-append
       head
       "        if wire == 2\n"
       (format
        "          bytes_value.unpack(~s).each { |x| ~a << x }\n"
        (string-append (third info) "*")
        v)
       "        else\n"
       (format "          ~a << fixed_value.unpack1(~s)\n" v (third info))
       "        end\n")))
   ((= type 9)
    (string-append
     head
     (format
      "        ~a << bytes_value.dup.force_encoding(Encoding::UTF_8)\n"
      v)))
   ((= type 12) (string-append head (format "        ~a << bytes_value\n" v)))
   ((= type 11)
    (string-append
     head
     (format
      "        item = ~a.new\n"
      (rb-pb-entry-ref model (rb-pb-resolve model (hash-ref f 'type-name))))
     "        item.unmarshal_dc(bytes_value)\n"
     (format "        ~a << item\n" v)))
   (else
    (error 'emit-ruby-pb-file "unsupported repeated field type ~a" type))))

(define (rb-pb-map-helpers model pb entry)
  (define msg (hash-ref entry 'msg))
  (define base (snake (string->symbol (rb-pb-entry-ref model entry))))
  (define key-f
    (findf (lambda (x) (= (hash-ref x 'number) 1)) (hash-ref msg 'fields)))
  (define val-f
    (findf (lambda (x) (= (hash-ref x 'number) 2)) (hash-ref msg 'fields)))
  (unless (and key-f val-f)
    (error
     'emit-ruby-pb-file
     "map entry ~a lacks key/value"
     (hash-ref msg 'full-name)))
  (string-append
   (format "  def self.encode_~a(key, value)\n    w = Writer.new\n" base)
   (rb-pb-encode-singular model pb (hash-set key-f 'label 1) "key" "    ")
   (rb-pb-encode-singular model pb (hash-set val-f 'label 1) "value" "    ")
   "    w.to_bytes\n  end\n\n"
   (format "  def self.decode_~a(data)\n" base)
   (format
    "    key = ~a\n    value = ~a\n"
    (rb-pb-default model (hash-set key-f 'label 1))
    (rb-pb-default model (hash-set val-f 'label 1)))
   "    r = Reader.new(data)\n    loop do\n      item = r.field\n      break if item.nil?\n\n      num, wire, varint_value, bytes_value, fixed_value, _raw_value = item\n"
   (format
    "      if num == ~a\n~a"
    (hash-ref key-f 'number)
    (rb-pb-decode-singular
     model
     (hash-set key-f 'label 1)
     "key"
     (cond
      ((memv (hash-ref key-f 'type) rb-pb-varint-types) "varint_value")
      ((assv (hash-ref key-f 'type) rb-pb-fixed) "fixed_value")
      (else "bytes_value"))
     "        "))
   (format
    "      elsif num == ~a\n~a"
    (hash-ref val-f 'number)
    (if (= (hash-ref val-f 'type) 11)
      (format
       "        value = ~a.new\n        value.unmarshal_dc(bytes_value)\n"
       (rb-pb-entry-ref
        model
        (rb-pb-resolve model (hash-ref val-f 'type-name))))
      (rb-pb-decode-singular
       model
       (hash-set val-f 'label 1)
       "value"
       (cond
        ((memv (hash-ref val-f 'type) rb-pb-varint-types) "varint_value")
        ((assv (hash-ref val-f 'type) rb-pb-fixed) "fixed_value")
        (else "bytes_value"))
       "        ")))
   "      end\n    end\n    [key, value]\n  end\n\n"))

(define (rb-pb-support pb)
  (string-append
   "# @generated by protoc-gen-grpc-dc-ruby. DO NOT EDIT.\n"
   (format
    "~aPbVarint = lambda do |value|\n  out = +\"\".b\n  v = value & 0xffffffffffffffff\n  while v > 0x7f\n    out << ((v & 0x7f) | 0x80)\n    v >>= 7\n  end\n  out << v\n  out\nend\n\n"
    pb)
   "  class Writer\n"
   "    def initialize\n      @out = String.new(encoding: Encoding::BINARY)\n    end\n\n"
   "    def varint(value)\n      @out << "
   pb
   "PbVarint.call(value)\n    end\n\n"
   "    def tag(field, wire)\n      varint((field << 3) | wire)\n    end\n\n"
   "    def bytes_field(field, payload)\n      tag(field, 2)\n      varint(payload.bytesize)\n      @out << payload.b\n    end\n\n"
   "    def string_field(field, value)\n      return if value.nil? || value.empty?\n\n      bytes_field(field, value.encode(Encoding::UTF_8).b)\n    end\n\n"
   "    def fixed(fmt, value)\n      @out << [value].pack(fmt)\n    end\n\n"
   "    def raw(payload)\n      @out << payload.b\n    end\n\n"
   "    def to_bytes\n      @out\n    end\n  end\n\n"
   "  class Reader\n"
   "    def initialize(buf)\n      @buf = buf.b\n      @pos = 0\n    end\n\n"
   "    def done?\n      @pos >= @buf.bytesize\n    end\n\n"
   "    def varint\n      result = 0\n      shift = 0\n      loop do\n        raise ArgumentError, \"truncated varint\" if @pos >= @buf.bytesize\n\n        b = @buf.getbyte(@pos)\n        @pos += 1\n        result |= (b & 0x7f) << shift\n        return result if (b & 0x80).zero?\n\n        shift += 7\n        raise ArgumentError, \"varint too long\" if shift >= 70\n      end\n    end\n\n"
   "    def take(n)\n      raise ArgumentError, \"truncated field\" if @pos + n > @buf.bytesize\n\n      value = @buf.byteslice(@pos, n)\n      @pos += n\n      value\n    end\n\n"
   "    # [number, wire, varint_value, bytes_value, fixed_value] or nil.\n"
   "    def field\n      return nil if done?\n\n      start = @pos\n      tag = varint\n      num = tag >> 3\n      wire = tag & 7\n      raw = -> { @buf.byteslice(start, @pos - start) }\n      case wire\n      when 0 then [num, wire, varint, \"\".b, \"\".b, raw.call]\n      when 2\n        n = varint\n        v = take(n)\n        [num, wire, 0, v, \"\".b, raw.call]\n      when 1\n        v = take(8)\n        [num, wire, 0, \"\".b, v, raw.call]\n      when 5\n        v = take(4)\n        [num, wire, 0, \"\".b, v, raw.call]\n      else raise ArgumentError, \"bad wire type\"\n      end\n    end\n  end\n\n"))

(define (rb-pb-message-class model pb msg)
  (define name
    (rb-pb-flat (hash-ref model 'package) (hash-ref msg 'full-name)))
  (define fields (hash-ref msg 'fields))
  (string-append
   (format "  class ~a\n" name)
   (if (null? fields)
     ""
     (format
      "    attr_accessor ~a\n\n"
      (string-join
       (append
        (map (lambda (f) (format ":~a" (rb-pb-field-name f))) fields)
        (list ":unknown_fields"))
       ", ")))
   (format
    "    def initialize(~a)\n"
    (string-join
     (map
      (lambda (f)
        (format "~a: ~a" (rb-pb-field-name f) (rb-pb-default model f)))
      fields)
     ", "))
   (apply
    string-append
    (map
     (lambda (f)
       (format "      @~a = ~a\n" (rb-pb-field-name f) (rb-pb-field-name f)))
     fields))
   "      @unknown_fields = \"\".b\n"
   "    end\n\n"
   "    def marshal_dc\n      w = Writer.new\n"
   (apply
    string-append
    (map
     (lambda (f) (rb-pb-encode-guard model f (rb-pb-encode-field model pb f)))
     fields))
   "      w.raw(@unknown_fields)\n"
   "      w.to_bytes\n    end\n\n"
   "    def unmarshal_dc(data)\n"
   "      @unknown_fields = \"\".b\n"
   (apply
    string-append
    (map
     (lambda (f)
       (format
        "      @~a = ~a\n"
        (rb-pb-field-name f)
        (rb-pb-default model f)))
     fields))
   "      r = Reader.new(data)\n      loop do\n        item = r.field\n        break if item.nil?\n\n        num, wire, varint_value, bytes_value, fixed_value, raw_value = item\n"
   (if (null? fields)
     "        @unknown_fields = @unknown_fields + raw_value\n"
     (string-append
      "        case num\n"
      (apply
       string-append
       (map (lambda (f) (rb-pb-decode-case model f)) fields))
      "        else\n          @unknown_fields = @unknown_fields + raw_value\n        end\n"))
   "      end\n      self\n    end\n\n"
   (format
    "    def ==(other)\n      other.is_a?(~a) && ~a\n    end\n"
    name
    (if (null? fields)
      "true"
      (string-join
       (map
        (lambda (f)
          (format "@~a == other.~a" (rb-pb-field-name f) (rb-pb-field-name f)))
        fields)
       " && ")))
   "  end\n\n"
   (apply
    string-append
    (map
     (lambda (n) (rb-pb-message-class model pb n))
     (hash-ref msg 'nested)))))

(define (rb-pb-enum model e)
  (define name
    (rb-pb-flat
     (hash-ref model 'package)
     (if (string=? (hash-ref model 'package) "")
       (hash-ref e 'name)
       (format "~a.~a" (hash-ref model 'package) (hash-ref e 'name)))))
  (string-append
   (format "  module ~a\n" name)
   (apply
    string-append
    (map
     (lambda (v)
       (format "    ~a = ~a\n" (hash-ref v 'name) (hash-ref v 'number)))
     (hash-ref e 'values)))
   "  end\n\n"))

(define (emit-ruby-pb-file file-model)
  (and (hash-has-key? file-model 'messages)
       (hash-has-key? file-model 'types)
       (emit-ruby-pb-file/inner file-model)))

(define (emit-ruby-pb-file/inner file-model)
  (define messages (hash-ref file-model 'messages))
  (define enums (hash-ref file-model 'enums))
  (and (or (pair? messages) (pair? enums))
       (let ()
         (define base
           (path->string
            (path-replace-extension
             (file-name-from-path (hash-ref file-model 'name))
             "")))
         (define pb (camel base))
         (define pkg (hash-ref file-model 'package))
         (define seen-maps (mutable-set))
         (define helpers '())
         (define (collect msg)
           (for
            ((f (in-list (hash-ref msg 'fields))))
            (when (= (hash-ref f 'type) 11)
              (define e (rb-pb-resolve file-model (hash-ref f 'type-name)))
              (when (and
                     (eq? (hash-ref e 'kind) 'map)
                     (not
                      (set-member?
                       seen-maps
                       (hash-ref (hash-ref e 'msg) 'full-name))))
                (set-add! seen-maps (hash-ref (hash-ref e 'msg) 'full-name))
                (set! helpers
                  (cons (rb-pb-map-helpers file-model pb e) helpers)))))
           (for ((n (in-list (hash-ref msg 'nested)))) (collect n)))
         (for ((m (in-list messages))) (collect m))
         (define dep-modules
           (remove-duplicates
            (map
             (lambda (d)
               (path->string
                (path-replace-extension (file-name-from-path d) "")))
             (hash-ref file-model 'dependencies))))
         (define content
           (string-append
            (apply
             string-append
             (map
              (lambda (d) (format "require_relative \"~a_pb\"\n" d))
              dep-modules))
            (if (null? dep-modules) "" "\n")
            (format "module ~aPb\n" pb)
            (rb-pb-support pb)
            (apply
             string-append
             (map (lambda (e) (rb-pb-enum file-model e)) enums))
            (apply
             string-append
             (map
              (lambda (m) (rb-pb-message-class file-model pb m))
              (filter (lambda (m) (not (hash-ref m 'map-entry))) messages)))
            (apply string-append (reverse helpers))
            "end\n"))
         (cons (string-append base "_pb.rb") content))))

(define (emit-ruby-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define mod (string-append (camel base) "GrpcDc"))
  (define stub
    (cons
     (string-append base "_grpc_dc.rb")
     (string-append
      "# @generated by protoc-gen-grpc-dc-ruby. DO NOT EDIT.\n"
      (format "# source: ~a\n\n" (hash-ref file-model 'name))
      (rb-stub-requires file-model)
      "require \"grpcdc\"\n\n"
      (format "module ~a\n" mod)
      (if (equal? (hash-ref params 'trace #f) "hooks")
        (string-append
         "  # Tracing (trace=hooks): register an observer via set_tracer.\n"
         "  def self.set_tracer(t)\n    Grpcdc.set_tracer(t)\n  end\n\n"
         "  def self.set_trace_filter(patterns)\n    Grpcdc.set_trace_filter(patterns)\n  end\n\n"
         (let ((methods (hash-ref params 'trace_methods #f)))
           (if methods
             (format "  Grpcdc.set_trace_filter(~s)\n\n" methods)
             "")))
        "")
      rb-stream-helpers
      (apply
       string-append
       (map
        (lambda (svc) (rb-service file-model svc))
        (hash-ref file-model 'services)))
      "end\n")))
  (define pb-file (emit-ruby-pb-file file-model))
  (if pb-file (list stub pb-file) stub))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define trace-opt (hash-ref params 'trace #f))
  (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
    (error
     (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
  (define trace-methods (hash-ref params 'trace_methods #f))
  (when trace-methods
    (unless (equal? trace-opt "hooks")
      (error "trace_methods requires trace=hooks"))
    (for
     ((p (in-list (string-split trace-methods ";"))))
     (unless (string-prefix? p "/")
       (error (format "trace_methods pattern must start with /: ~a" p)))))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map stamp-generated-header (as-file-list (emit-ruby-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
