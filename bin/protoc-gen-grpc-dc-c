      (ref output)))
    (fmt
     "// Register~aServer registers impl on the JS server bridge and starts serving.\nfunc Register~aServer(bridge js.Value, impl ~aServer) {\n"
     (svc)
     (svc)
     (svc))
    (each
     methods
     (call
      wasmGoRegisterMethod
      (case-on
       (distinct-count (get (root) methods) output)
       (1 (fmt "~aServerSink" (svc)))
       (else (fmt "~a~aServerSink" (svc) (ref output))))))
    (fmt "\tbridge.Call(\"start\", ~s)\n}\n" (ref full-name))
    (each-unique
     methods
     input
     (kinds client-streaming bidi)
     (fmt
      "\n// ~aSource pulls typed requests one at a time for incremental handlers.\ntype ~aSource struct {\n\traw *RequestSource\n}\n\n// Next returns the next request, or (nil, nil) at end of stream.\nfunc (s *~aSource) Next() (*echo.~a, error) {\n\tpayload, err := s.raw.Next()\n\tif err != nil || payload == nil {\n\t\treturn nil, err\n\t}\n\treq := new(echo.~a)\n\tif err := req.UnmarshalDC(payload); err != nil {\n\t\treturn nil, err\n\t}\n\treturn req, nil\n}\n\n"
      (ref input)
      (ref input)
      (ref input)
      (ref input)
      (ref input)))
    (fmt
     "// ~aStreamServer is the incremental implementation for ~a: requests arrive one at a time.\ntype ~aStreamServer interface {\n"
     (svc)
     (ref full-name)
     (svc))
    (each
     methods
     (call
      wasmGoStreamIfaceMethod
      (case-on
       (distinct-count (get (root) methods) output)
       (1 (fmt "~aServerSink" (svc)))
       (else (fmt "~a~aServerSink" (svc) (ref output))))))
    "}\n\n"
    (fmt
     "// Register~aStreamServer registers an incremental impl; call bridge start after all registrations.\nfunc Register~aStreamServer(bridge js.Value, impl ~aStreamServer) {\n"
     (svc)
     (svc)
     (svc))
    (each
     methods
     (call
      wasmGoStreamRegisterMethod
      (case-on
       (distinct-count (get (root) methods) output)
       (1 (fmt "~aServerSink" (svc)))
       (else (fmt "~a~aServerSink" (svc) (ref output))))))
    "}\n"))

