(define go-pb-encode-singular-program
  '((case-on
     (category)
     (("varint"
       (if (proto2)
         (then
          (fmt "~aout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~aout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0))))
         (else
          (fmt
           "~aif ~a {\n"
           (arg 1)
           (if (type-is 8) (then (arg 0)) (else (fmt "~a != 0" (arg 0)))))
          (fmt "~a\tout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~a\tout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0)))
          (fmt "~a}\n" (arg 1))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~aout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0))))
        (else
         (fmt "~aif ~a != 0 {\n" (arg 1) (arg 0))
         (fmt
          "~a\tout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~a\tout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0)))
         (fmt "~a}\n" (arg 1)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, []byte(~a))\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aout = appendStringField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif len(~a) > 0 {\n~a\tout = appendBytesField(out, ~a, ~a)\n~a}\n"
          (arg 1)
          (arg 0)
          (arg 1)
          (ref number)
          (arg 0)
          (arg 1)))))
     ("message"
      (fmt
       "~aif ~a != nil {\n~a\tout = appendBytesField(out, ~a, ~a.MarshalDC())\n~a}\n"
       (arg 1)
       (arg 0)
       (arg 1)
       (ref number)
       (arg 0)
       (arg 1)))
     (else (fail)))))

(define go-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "\t{\n\t\tkeys := make([]~a, 0, len(~a))\n\t\tfor k := range ~a { keys = append(keys, k) }\n\t\tsort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\n\t\tfor _, k := range keys {\n\t\t\tout = appendBytesField(out, ~a, ~a(k, ~a[k]))\n\t\t}\n\t}\n"
        (field-type-of (with-label (key-field (resolved-entry)) 1))
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (ref number)
        (fmt "encode~a" (entry-type))
        (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = appendVarint(payload, ~a)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbVarintExpr "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("fixed"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = append(payload, ~a...)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedEncode "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("string"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, []byte(x))\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("bytes"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x)\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("message"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x.MarshalDC())\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            (else (fail)))))
         (else
          (call goPbEncodeSingular (fmt "m.~a" (pascal (ref name))) "\t")))))))

(define go-pb-decode-singular-program
  '((case-on
     (category)
     (("varint"
       (fmt
        "~a~a = ~a\n"
        (arg 2)
        (arg 0)
        (if (type-is 14)
          (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode (arg 1))))
          (else (call goPbVarintDecode (arg 1))))))
      ("fixed"
       (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call goPbFixedDecode (arg 1))))
      ("string" (fmt "~a~a = string(~a)\n" (arg 2) (arg 0) (arg 1)))
      ("bytes"
       (fmt "~a~a = append([]byte(nil), ~a...)\n" (arg 2) (arg 0) (arg 1)))
      ("message"
       (fmt "~atmp~a := new(~a)\n" (arg 2) (ref number) (entry-type))
       (fmt
        "~aif err := tmp~a.UnmarshalDC(~a); err != nil {\n~a\t~a\n~a}\n"
        (arg 2)
        (ref number)
        (arg 1)
        (arg 2)
        (err-stmt)
        (arg 2))
       (fmt "~a~a = tmp~a\n" (arg 2) (arg 0) (ref number)))
      (else (fail))))))

(define go-pb-decode-case-program
  '((fmt "\t\tcase ~a:\n" (ref number))
    (if (is-map)
      (then
       "\t\t\tif b, ok := value.([]byte); ok {\n"
       (fmt "\t\t\t\tk, val, err := ~a(b)\n" (fmt "decode~a" (entry-type)))
       "\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n"
       (fmt
        "\t\t\t\tif ~a == nil {\n\t\t\t\t\t~a = make(~a)\n\t\t\t\t}\n"
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (field-type))
       (fmt "\t\t\t\t~a[k] = val\n\t\t\t}\n" (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             "\t\t\tswitch value := value.(type) {\n"
             "\t\t\tcase uint64:\n"
             (fmt
              "\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then
                 (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "value")))
                (else (call goPbVarintDecode "value"))))
             "\t\t\tcase []byte:\n"
             "\t\t\t\tsub := &pbReader{buf: value}\n"
             "\t\t\t\tfor sub.pos < len(sub.buf) {\n"
             "\t\t\t\t\tv, err := sub.varint()\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n"
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "v")))
                (else (call goPbVarintDecode "v"))))
             "\t\t\t\t}\n\t\t\t}\n")
            ("fixed"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt "\t\t\t\tif len(b) == ~a {\n" (fixed-size))
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode "b"))
             "\t\t\t\t} else {\n"
             (fmt
              "\t\t\t\t\tfor off := 0; off+~a <= len(b); off += ~a {\n"
              (fixed-size)
              (fixed-size))
             (fmt
              "\t\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode (fmt "b[off:off+~a]" (fixed-size))))
             "\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n")
            ("string"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, string(b))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("bytes"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, append([]byte(nil), b...))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("message"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt
              "\t\t\t\tvar tmpv ~a\n"
              (field-type-of (with-label (self) 1)))
             (call goPbDecodeSingular "tmpv" "b" "\t\t\t\t")
             (fmt
              "\t\t\t\t~a = append(~a, tmpv)\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            (else (fail)))))
         (else
          (oneof-clearing)
          (if (is-varint)
            (then
             (fmt
              "\t\t\tif v, ok := value.(uint64); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "v"
               "\t\t\t\t")))
            (else
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "b"
               "\t\t\t\t"))))))))))

(define go-pb-encode-field-guarded-program
  '((guarded goPbSetExpr "\tif !(~a) {\n" "\t}\n" (call goPbEncodeField))))

(define go-pb-set-expr-program
  '((case-on
     (type)
     ((11 10) (fmt "m.~a != nil" (pascal (ref name))))
     (9 (fmt "m.~a != \"\"" (pascal (ref name))))
     (12 (fmt "len(m.~a) > 0" (pascal (ref name))))
     (8 (fmt "m.~a" (pascal (ref name))))
     (else (fmt "m.~a != ~a" (pascal (ref name)) (call goPbZero))))))

(define go-pb-map-helpers-program
  '((fmt
     "func encode~a(key ~a, value ~a) []byte {\n\tvar out []byte\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (call-on (key-field) goPbEncodeSingular "key" "\t")
    (call-on (val-field) goPbEncodeSingular "value" "\t")
    "\treturn out\n}\n\n"
    (fmt
     "func decode~a(data []byte) (~a, ~a, error) {\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (fmt
     "\tvar key ~a\n\tvar value ~a\n"
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    "\tr := &pbReader{buf: data}\n\tfor {\n\t\tnum, _, value0, _, done, err := r.field()\n\t\tif err != nil {\n\t\t\treturn key, value, err\n\t\t}\n\t\tif done {\n\t\t\treturn key, value, nil\n\t\t}\n\t\tswitch num {\n"
    (fmt "\t\tcase ~a:\n" (get (key-field) number))
    (case-on
     (category-of (key-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "b" "\t\t\t\t")))))
    (fmt "\t\tcase ~a:\n" (get (val-field) number))
    (case-on
     (category-of (val-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "b" "\t\t\t\t")))))
    "\t\t}\n\t}\n}\n\n"))

