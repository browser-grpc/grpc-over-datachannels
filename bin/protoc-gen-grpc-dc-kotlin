      name
      name))
    ((bidi)
     (format
      (string-append
       "        override fun ~a(stream: ~a~aServer) {\n"
       "            AsyncPump.runSuspend { impl.~aAsync(stream) }\n"
       "        }\n\n")
      name
      svc
      name
      name))))

(define (kotlin-stream-impl m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary) "")
    ((server-streaming)
     (format
      (string-append
       "    private class ~a~aServerImpl(\n"
       "        override val context: Endpoint.CallContext,\n"
       "        private val sink: Server.ServerSink\n"
       "    ) : ~a~aServer {\n"
       "        override fun send(resp: ~a) {\n"
       "            sink.send(resp.marshalDc())\n"
       "        }\n"
       "    }\n\n")
      svc
      name
      svc
      name
      resp))
    ((client-streaming)
     (format
      (string-append
       "    private class ~a~aServerImpl(\n"
       "        override val context: Endpoint.CallContext,\n"
       "        private val reqs: Server.RequestStream\n"
       "    ) : ~a~aServer {\n"
       "        var resp: ~a? = null\n"
       "            private set\n\n"
       "        override fun recv(): ~a {\n"
       "            val req = ~a()\n"
       "            reqs.recvInto(req)\n"
       "            return req\n"
       "        }\n\n"
       "        override fun sendAndClose(resp: ~a) {\n"
       "            this.resp = resp\n"
       "        }\n"
       "    }\n\n")
      svc
      name
      svc
      name
      resp
      req
      req
      resp))
    ((bidi)
     (format
      (string-append
       "    private class ~a~aServerImpl(\n"
       "        override val context: Endpoint.CallContext,\n"
       "        private val reqs: Server.RequestStream,\n"
       "        private val sink: Server.ServerSink\n"
       "    ) : ~a~aServer {\n"
       "        override fun send(resp: ~a) {\n"
       "            sink.send(resp.marshalDc())\n"
       "        }\n\n"
       "        override fun recv(): ~a {\n"
       "            val req = ~a()\n"
       "            reqs.recvInto(req)\n"
       "            return req\n"
       "        }\n"
       "    }\n\n")
      svc
      name
      svc
      name
      resp
      req
      req))))

(define (kotlin-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define svc (current-service))
  (define kind-const
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "                    Server.Method(~s, ~s, Server.~a) { ctx, reqs, sink ->\n"
       "                        val req = ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        sink.send(impl.~a(ctx, req).marshalDc())\n"
       "                    },\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "                    Server.Method(~s, ~s, Server.~a) { ctx, reqs, sink ->\n"
       "                        val req = ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        impl.~a(req, ~a~aServerImpl(ctx, sink))\n"
       "                    },\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name
      svc
      name))
    ((client-streaming)
     (format
      (string-append
       "                    Server.Method(~s, ~s, Server.~a) { ctx, reqs, sink ->\n"
       "                        val stream = ~a~aServerImpl(ctx, reqs)\n"
       "                        impl.~a(stream)\n"
       "                        val resp = stream.resp\n"
       "                            ?: throw StatusException(\n"
       "                                Wire.CODE_INTERNAL,\n"
       "                                \"client-streaming handler never called sendAndClose\"\n"
       "                            )\n"
       "                        sink.send(resp.marshalDc())\n"
       "                    },\n")
      name
      (hash-ref m 'path)
      kind-const
      svc
      name
      impl-name))
    ((bidi)
     (format
      (string-append
       "                    Server.Method(~s, ~s, Server.~a) { ctx, reqs, sink ->\n"
       "                        impl.~a(~a~aServerImpl(ctx, reqs, sink))\n"
       "                    },\n")
      name
      (hash-ref m 'path)
      kind-const
      impl-name
      svc
      name))))

(define (kotlin-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format "    /** Client for ~a. */\n" (hash-ref svc 'full-name))
    (format "    class ~aClient(private val channel: Channel) {\n" sname)
    (apply string-append (map kotlin-client-stream-class methods))
    (apply
     string-append
     (map kotlin-client-method (append methods (alias-client-methods svc))))
    (if (kotlin-wasm-mode)
      ""
      "        // -- async (coroutine / CompletableFuture) surface ---------------\n\n")
    (if (kotlin-wasm-mode)
      ""
      (apply
       string-append
       (map
        kotlin-client-async-method
        (append methods (alias-client-methods svc)))))
    "    }\n\n"
    (apply string-append (map kotlin-server-stream-iface methods))
    (format
     "    /** Service implementation interface for ~a. */\n"
     (hash-ref svc 'full-name))
    (format "    interface ~aServer {\n" sname)
    (apply string-append (map kotlin-server-iface-method methods))
    "    }\n\n"
    (if (kotlin-wasm-mode)
      ""
      (format
       "    /** Async service implementation interface for ~a. */\n"
       (hash-ref svc 'full-name)))
    (if (kotlin-wasm-mode) "" (format "    interface ~aServerAsync {\n" sname))
    (if (kotlin-wasm-mode)
      ""
      (apply string-append (map kotlin-server-async-iface-method methods)))
    (if (kotlin-wasm-mode) "" "    }\n\n")
    (apply string-append (map kotlin-stream-impl methods))
    (if (kotlin-wasm-mode)
      ""
      (format
       "    private class ~aServerAsyncAdapter(private val impl: ~aServerAsync) : ~aServer {\n"
       sname
       sname
       sname))
    (if (kotlin-wasm-mode)
      ""
      (apply string-append (map kotlin-server-async-adapter-method methods)))
    (if (kotlin-wasm-mode) "" "    }\n\n")
    (format
     "    /** Register an implementation of ~a on a Server. */\n"
     (hash-ref svc 'full-name))
    (format
     "    fun register~aServer(server: Server, impl: ~aServer) {\n"
     sname
     sname)
    "        server.registerService(\n"
    "            Server.ServiceDesc(\n"
    (format "                ~s,\n" (hash-ref svc 'full-name))
    "                listOf(\n"
    (let ((regs
           (apply
            string-append
            (map
             kotlin-register-method
             (append methods (alias-server-methods svc))))))
      (if (string-suffix? regs ",\n")
        (string-append (substring regs 0 (- (string-length regs) 2)) "\n")
        regs))
    "                )\n"
    "            )\n"
    "        )\n"
    "    }\n\n"
    (if (kotlin-wasm-mode)
      ""
      (format
       "    /** Register an async implementation of ~a on a Server. */\n"
       (hash-ref svc 'full-name)))
    (if (kotlin-wasm-mode)
      ""
      (format
       "    fun register~aServerAsync(server: Server, impl: ~aServerAsync) {\n"
       sname
       sname))
    (if (kotlin-wasm-mode)
      ""
      "        // Adapters are retained for the process lifetime: registration is\n")
    (if (kotlin-wasm-mode)
      ""
      "        // once-per-process and bounded by service count.\n")
    (if (kotlin-wasm-mode)
      ""
      (format "        val adapter = ~aServerAsyncAdapter(impl)\n" sname))
    (if (kotlin-wasm-mode) "" "        adapters.add(adapter)\n")
    (if (kotlin-wasm-mode)
      ""
      (format "        register~aServer(server, adapter)\n    }\n\n" sname))
    (if (kotlin-wasm-mode)
      ""
      (format
       "    private val adapters = ArrayList<~aServerAsyncAdapter>()\n"
       sname)))))

(define (emit-kotlin-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define object-name (string-append (pascal (string->symbol base)) "GrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (cons
   (string-append object-name ".kt")
   (string-append
    "// @generated by protoc-gen-grpc-dc-kotlin (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n" (hash-ref file-model 'name))
    (format "package ~a\n\n" (if (string=? pkg "") "proto" pkg))
    "import grpcdc.AsyncPump\n"
    "import grpcdc.Channel\n"
    "import grpcdc.Endpoint\n"
    "import grpcdc.Server\n"
    "import grpcdc.StatusException\n"
    "import grpcdc.Wire\n"
    "import java.io.EOFException\n"
    "import java.util.concurrent.CompletableFuture\n\n"
    (format
     "/** Generated gRPC-over-DataChannels stubs for ~a. */\n"
     (hash-ref file-model 'name))
    (format "object ~a {\n" object-name)
    (apply string-append (map kotlin-service (hash-ref file-model 'services)))
    "}\n")))

(define (emit-wasm-kotlin-native-file file-model params)
  (define result
    (parameterize
     ((kotlin-wasm-mode #t))
     (emit-kotlin-file file-model params)))
  (cons
   (car result)
   (for/fold
    ((text (cdr result)))
    ((pair
      (in-list
       (list
        (cons "import grpcdc.AsyncPump\n" "")
        (cons "import java.util.concurrent.CompletableFuture\n" "")
        (cons "import java.io.EOFException\n" "import grpcdc.EOFException\n")
        (cons "java.time.Duration?" "Long?")
        (cons
         "protoc-gen-grpc-dc-kotlin"
         "protoc-gen-grpc-dc-kotlin-native")))))
    (unless (string-contains? text (car pair))
      (error
       'template-kotlin
       "wasm native stub transform: pattern not found: ~e"
       (car pair)))
    (string-replace text (car pair) (cdr pair)))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (write-bytes
   (encode-response
    (map
     (lambda (f) (stamp-generated-header (emit-kotlin-file f params)))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
