(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'extendee
   (string-trim (pb-get-string fields 2 "") ".")
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'default
   (pb-get-string fields 7 #f)
   'oneof-index
   (pb-get fields 9 #f)
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 6))))
    (parse-field-desc (pb-parse f)))
   'oneofs
   (for/list
    ((o (in-list (pb-get-all fields 8))))
    (pb-get-string (pb-parse o) 1))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'syntax
   (let ((s (pb-get-string fields 12 ""))) (if (string=? s "") "proto2" s))
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 7))))
    (parse-field-desc (pb-parse f)))))

(define (merge-extensions files)
  (define exts
    (append
     (append-map (lambda (f) (hash-ref f 'extensions)) files)
     (let loop ((msgs (append-map (lambda (f) (hash-ref f 'messages)) files)))
       (if (null? msgs)
         '()
         (append
          (append-map (lambda (m) (hash-ref m 'extensions)) msgs)
          (loop (append-map (lambda (m) (hash-ref m 'nested)) msgs)))))))
  (define (add-to msg ext)
    (if (equal? (hash-ref msg 'full-name) (hash-ref ext 'extendee))
      (hash-set msg 'fields (append (hash-ref msg 'fields) (list ext)))
      (hash-set
       msg
       'nested
       (map (lambda (n) (add-to n ext)) (hash-ref msg 'nested)))))
  (for/fold
   ((fs files))
   ((ext (in-list exts)))
   (map
    (lambda (f)
      (hash-set
       f
       'messages
       (map (lambda (m) (add-to m ext)) (hash-ref f 'messages))))
    fs)))

(define (oneof-siblings model f)
  (define idx (hash-ref f 'oneof-index #f))
  (if (not idx)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (filter
         (lambda (x)
           (and (not (eq? x f)) (equal? (hash-ref x 'oneof-index #f) idx)))
         (hash-ref (car msgs) 'fields)))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (field-explicit-default f)
  (and (hash-ref f 'default #f)
       (not (= (hash-ref f 'label 1) 3))
       (not (memv (hash-ref f 'type) '(10 11 12)))
       (hash-ref f 'default)))

(define (enum-default-number model f)
  (define types (and (hash-has-key? model 'types) (hash-ref model 'types)))
  (define entry (and types (hash-ref types (hash-ref f 'type-name) #f)))
  (define e (and entry (hash-ref entry 'enum #f)))
  (define v
    (and e
         (findf
          (lambda (x) (equal? (hash-ref x 'name) (hash-ref f 'default)))
          (hash-ref e 'values))))
  (and v (hash-ref v 'number)))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg
      'full
      (hash-ref msg 'full-name)))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq
       'kind
       'enum
       'msg
       #f
       'enum
       e
       'file
       file
       'pkg
       pkg
       'full
       (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq
      'kind
      'enum
      'msg
      #f
      'enum
      e
      'file
      (hash-ref f 'name)
      'pkg
      pkg
      'full
      (if (string=? pkg "")
        (hash-ref e 'name)
        (format "~a.~a" pkg (hash-ref e 'name)))))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (merge-extensions
     (for/list
      ((f (in-list (pb-get-all fields 15))))
      (parse-file-desc (pb-parse f)))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-ref
      by-name
      w
      (lambda ()
        (error 'parse-request "file_to_generate not in request: ~a" w)))
     'types
     registry))
   parameter))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define current-service (make-parameter ""))

(define current-struct (make-parameter ""))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "[_.-]"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (cpp-deprecated m indent)
  (if (hash-ref m 'deprecated #f)
    (format "~a[[deprecated(\"deprecated in the proto schema\")]]\n" indent)
    ""))

(define (wasm-cpp-client-method/raw m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    void ~a(~a req,\n"
       "            std::function<void(grpcdc_wasm::Status,\n"
       "                               std::optional<~a>)> callback) {\n"
       "      bridge_->Unary(~s, req.MarshalDc(),\n"
       "                     [callback](grpcdc_wasm::Status st,\n"
       "                                const grpcdc_wasm::Bytes* bytes) {\n"
       "                       HandleUnary<~a>(std::move(st), bytes, callback);\n"
       "                     });\n"
       "    }\n\n")
      name
      req
      resp
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "    void ~a(~a req,\n"
       "            std::function<void(~a)> on_message,\n"
       "            grpcdc_wasm::DoneCallback on_done) {\n"
       "      auto finished = std::make_shared<bool>(false);\n"
       "      bridge_->ServerStream(\n"
       "          ~s, req.MarshalDc(),\n"
       "          [on_message, on_done, finished](const grpcdc_wasm::Bytes& bytes) {\n"
       "            HandleMessage<~a>(bytes, on_message, on_done, finished);\n"
       "          },\n"
       "          [on_done, finished](grpcdc_wasm::Status st) {\n"
       "            if (*finished) return;\n"
       "            *finished = true;\n"
       "            on_done(std::move(st));\n"
       "          });\n"
       "    }\n\n")
      name
      req
      resp
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "    void ~a(std::vector<~a> reqs,\n"
       "            std::function<void(grpcdc_wasm::Status,\n"
       "                               std::optional<~a>)> callback) {\n"
       "      bridge_->ClientStream(\n"
       "          ~s, MarshalAll(reqs),\n"
       "          [callback](grpcdc_wasm::Status st,\n"
       "                     const grpcdc_wasm::Bytes* bytes) {\n"
       "            HandleUnary<~a>(std::move(st), bytes, callback);\n"
       "          });\n"
       "    }\n\n")
      name
      req
      resp
      path
      resp))
    ((bidi)
     (format
      (string-append
       "    void ~a(std::vector<~a> reqs,\n"
       "            std::function<void(~a)> on_message,\n"
       "            grpcdc_wasm::DoneCallback on_done) {\n"
       "      auto finished = std::make_shared<bool>(false);\n"
       "      bridge_->Bidi(\n"
       "          ~s, MarshalAll(reqs),\n"
       "          [on_message, on_done, finished](const grpcdc_wasm::Bytes& bytes) {\n"
       "            HandleMessage<~a>(bytes, on_message, on_done, finished);\n"
       "          },\n"
       "          [on_done, finished](grpcdc_wasm::Status st) {\n"
       "            if (*finished) return;\n"
       "            *finished = true;\n"
       "            on_done(std::move(st));\n"
       "          });\n"
       "    }\n\n")
      name
      req
      resp
      path
      resp))))

(define (wasm-cpp-client-method m)
  (string-append (cpp-deprecated m "    ") (wasm-cpp-client-method/raw m)))

(define wasm-cpp-helpers
  (string-append
   "   private:\n"
   "    template <typename Resp, typename Callback>\n"
   "    static void HandleUnary(grpcdc_wasm::Status st,\n"
   "                            const grpcdc_wasm::Bytes* bytes,\n"
   "                            Callback callback) {\n"
   "      if (!st.ok()) {\n"
   "        callback(std::move(st), std::nullopt);\n"
   "        return;\n"
   "      }\n"
   "      Resp resp;\n"
   "      if (!resp.UnmarshalDc(bytes ? *bytes : grpcdc_wasm::Bytes{})) {\n"
   "        callback({3, \"malformed response payload\"}, std::nullopt);\n"
   "        return;\n"
   "      }\n"
   "      callback(grpcdc_wasm::Status::Ok(), resp);\n"
   "    }\n\n"
   "    template <typename Resp, typename OnMessage>\n"
   "    static void HandleMessage(const grpcdc_wasm::Bytes& bytes,\n"
   "                              OnMessage on_message,\n"
   "                              grpcdc_wasm::DoneCallback on_done,\n"
   "                              std::shared_ptr<bool> finished) {\n"
   "      if (*finished) return;\n"
   "      Resp resp;\n"
   "      if (!resp.UnmarshalDc(bytes)) {\n"
   "        *finished = true;\n"
   "        on_done({3, \"malformed response payload\"});\n"
   "        return;\n"
   "      }\n"
   "      on_message(resp);\n"
   "    }\n\n"
   "    template <typename Req>\n"
   "    static std::vector<grpcdc_wasm::Bytes> MarshalAll(\n"
   "        const std::vector<Req>& reqs) {\n"
   "      std::vector<grpcdc_wasm::Bytes> payloads;\n"
   "      for (const auto& req : reqs) payloads.push_back(req.MarshalDc());\n"
   "      return payloads;\n"
   "    }\n\n"))

(define (wasm-cpp-server-export m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define export-name
    (let* ((raw (hash-ref m 'name))
           (n (if (symbol? raw) (symbol->string raw) raw)))
      (string-append
       "serve_"
       (string (char-downcase (string-ref n 0)))
       (substring n 1))))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "extern \"C\" void ~a(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
       "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
       "  ~a req;\n"
       "  if (!req.UnmarshalDc(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; }\n"
       "  auto result = ~a::g_impl->~a(req, md);\n"
       "  if (!result.first.ok()) { grpcdc_wasm::ServerFail(call_id, result.first); return; }\n"
       "  grpcdc_wasm::ServerRespond(call_id, result.second.MarshalDc());\n"
       "}\n\n")
      export-name
      req
      (current-struct)
      name))
    ((server-streaming)
     (format
      (string-append
       "extern \"C\" void ~a(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
       "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
       "  ~a req;\n"
       "  if (!req.UnmarshalDc(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; }\n"
       "  ~a::~aServerSink sink{call_id};\n"
       "  auto st = ~a::g_impl->~a(req, md, sink);\n"
       "  if (st.ok()) grpcdc_wasm::ServerComplete(call_id); else grpcdc_wasm::ServerFail(call_id, st);\n"
       "}\n\n")
      export-name
      req
      (current-struct)
      (current-service)
      (current-struct)
      name))
    ((client-streaming)
     (format
      (string-append
       "extern \"C\" void ~a(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
       "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
       "  std::vector<~a> reqs;\n"
       "  for (const auto& chunk : grpcdc_wasm::Unpack(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { ~a req; if (!req.UnmarshalDc(chunk)) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; } reqs.push_back(req); }\n"
       "  auto result = ~a::g_impl->~a(reqs, md);\n"
       "  if (!result.first.ok()) { grpcdc_wasm::ServerFail(call_id, result.first); return; }\n"
       "  grpcdc_wasm::ServerRespond(call_id, result.second.MarshalDc());\n"
       "}\n\n")
      export-name
      req
      req
      (current-struct)
      name))
    ((bidi)
     (format
      (string-append
       "extern \"C\" void ~a(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
       "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
       "  std::vector<~a> reqs;\n"
       "  for (const auto& chunk : grpcdc_wasm::Unpack(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { ~a req; if (!req.UnmarshalDc(chunk)) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; } reqs.push_back(req); }\n"
       "  ~a::~aServerSink sink{call_id};\n"
       "  auto st = ~a::g_impl->~a(reqs, md, sink);\n"
       "  if (st.ok()) grpcdc_wasm::ServerComplete(call_id); else grpcdc_wasm::ServerFail(call_id, st);\n"
       "}\n\n")
      export-name
      req
      req
      (current-struct)
      (current-service)
      (current-struct)
      name))))

(define (wasm-cpp-server-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "    virtual std::pair<grpcdc_wasm::Status, ~a> ~a(const ~a& req, const std::vector<grpcdc_wasm::MdPair>& md) = 0;\n"
      resp
      name
      req))
    ((server-streaming)
     (format
      "    virtual grpcdc_wasm::Status ~a(const ~a& req, const std::vector<grpcdc_wasm::MdPair>& md, ~aServerSink& sink) = 0;\n"
      name
      req
      (current-service)))
    ((client-streaming)
     (format
      "    virtual std::pair<grpcdc_wasm::Status, ~a> ~a(const std::vector<~a>& reqs, const std::vector<grpcdc_wasm::MdPair>& md) = 0;\n"
      resp
      name
      req))
    ((bidi)
     (format
      "    virtual grpcdc_wasm::Status ~a(const std::vector<~a>& reqs, const std::vector<grpcdc_wasm::MdPair>& md, ~aServerSink& sink) = 0;\n"
      name
      req
      (current-service)))))

(define (wasm-cpp-export-name m)
  (let* ((raw (hash-ref m 'name))
         (n (if (symbol? raw) (symbol->string raw) raw)))
    (string-append
     "serve_"
     (string (char-downcase (string-ref n 0)))
     (substring n 1))))

(define (wasm-cpp-stream-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       "    virtual void ~aBegin(std::uint32_t call_id, const std::vector<grpcdc_wasm::MdPair>& md) = 0;\n"
       name)
      (format
       "    virtual void ~aRequest(std::uint32_t call_id, const ~a& req) = 0;\n"
       name
       req)
      (format
       "    virtual std::pair<grpcdc_wasm::Status, ~a> ~aEnd(std::uint32_t call_id) = 0;\n"
       resp
       name)))
    ((bidi)
     (string-append
      (format
       "    virtual void ~aBegin(std::uint32_t call_id, const std::vector<grpcdc_wasm::MdPair>& md) = 0;\n"
       name)
      (format
       "    virtual grpcdc_wasm::Status ~aRequest(std::uint32_t call_id, const ~a& req, ~aServerSink& sink) = 0;\n"
       name
       req
       (current-service))
      (format
       "    virtual grpcdc_wasm::Status ~aEnd(std::uint32_t call_id) = 0;\n"
       name)))
    (else "")))

(define (wasm-cpp-stream-feed-export m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define export-name (wasm-cpp-export-name m))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       (string-append
        "extern \"C\" void ~aStart(std::uint32_t call_id, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
        "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
        "  ~a::g_stream_impl->~aBegin(call_id, md);\n"
        "}\n\n")
       export-name
       (current-struct)
       name)
      (format
       (string-append
        "extern \"C\" void ~aFeed(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len) {\n"
        "  ~a req;\n"
        "  if (!req.UnmarshalDc(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; }\n"
        "  ~a::g_stream_impl->~aRequest(call_id, req);\n"
        "}\n\n")
       export-name
       req
       (current-struct)
       name)
      (format
       (string-append
        "extern \"C\" void ~aEnd(std::uint32_t call_id) {\n"
        "  auto result = ~a::g_stream_impl->~aEnd(call_id);\n"
        "  if (!result.first.ok()) { grpcdc_wasm::ServerFail(call_id, result.first); return; }\n"
        "  grpcdc_wasm::ServerRespond(call_id, result.second.MarshalDc());\n"
        "}\n\n")
       export-name
       (current-struct)
       name)))
    ((bidi)
     (string-append
      (format
       (string-append
        "extern \"C\" void ~aStart(std::uint32_t call_id, const std::uint8_t* md_ptr, std::size_t md_len) {\n"
        "  auto md = grpcdc_wasm::DecodeMetadata(grpcdc_wasm::Bytes(md_ptr, md_ptr + md_len));\n"
        "  ~a::g_stream_impl->~aBegin(call_id, md);\n"
        "}\n\n")
       export-name
       (current-struct)
       name)
      (format
       (string-append
        "extern \"C\" void ~aFeed(std::uint32_t call_id, const std::uint8_t* payload_ptr, std::size_t payload_len) {\n"
        "  ~a req;\n"
        "  if (!req.UnmarshalDc(grpcdc_wasm::Bytes(payload_ptr, payload_ptr + payload_len))) { grpcdc_wasm::ServerFail(call_id, {3, \"malformed request payload\"}); return; }\n"
        "  ~a::~aServerSink sink{call_id};\n"
        "  auto st = ~a::g_stream_impl->~aRequest(call_id, req, sink);\n"
        "  if (!st.ok()) grpcdc_wasm::ServerFail(call_id, st);\n"
        "}\n\n")
       export-name
       req
       (current-struct)
       (current-service)
       (current-struct)
       name)
      (format
       (string-append
        "extern \"C\" void ~aEnd(std::uint32_t call_id) {\n"
        "  auto st = ~a::g_stream_impl->~aEnd(call_id);\n"
        "  if (st.ok()) grpcdc_wasm::ServerComplete(call_id); else grpcdc_wasm::ServerFail(call_id, st);\n"
        "}\n\n")
       export-name
       (current-struct)
       name)))
    (else "")))

(define (wasm-cpp-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format
     "  /// Client for ~a (browser/WASM facade; see file doc).\n"
     (hash-ref svc 'full-name))
    (format "  class ~aClient {\n" sname)
    "   public:\n"
    (format
     "    explicit ~aClient(grpcdc_wasm::Bridge& bridge =\n                          grpcdc_wasm::Bridge::Shared())\n        : bridge_(&bridge) {}\n\n"
     sname)
    (apply
     string-append
     (map wasm-cpp-client-method (append methods (alias-client-methods svc))))
    wasm-cpp-helpers
    "    grpcdc_wasm::Bridge* bridge_;\n"
    "  };\n\n"
    (format "  /// Streaming response sink for server handlers.\n")
    (format "  struct ~aServerSink {\n" sname)
    "    std::uint32_t call_id;\n\n"
    (apply
     string-append
     (for/list
      ((resp
        (in-list
         (remove-duplicates (map (lambda (m) (hash-ref m 'output)) methods)))))
      (format
       "    grpcdc_wasm::Status Send(const ~a& resp) {\n      grpcdc_wasm::ServerSend(call_id, resp.MarshalDc());\n      return grpcdc_wasm::Status::Ok();\n    }\n"
       resp)))
    "  };\n\n"
    (format
     "  /// Service implementation for ~a (browser/WASM facade).\n"
     (hash-ref svc 'full-name))
    (format "  class ~aServer {\n   public:\n" sname)
    "    virtual ~"
    sname
    "Server() = default;\n"
    (apply string-append (map wasm-cpp-server-iface-method methods))
    "  };\n\n"
    (format "  static inline ~aServer* g_impl = nullptr;\n\n" sname)
    (format
     "  /// Register the service implementation used by the serve_* exports.\n")
    (format
     "  static void register~aServer(~aServer& impl) { g_impl = &impl; }\n\n"
     sname
     sname)
    (format
     "  /// Incremental service implementation for ~a: requests arrive one at a time via serve_*Start/Feed/End.\n"
     (hash-ref svc 'full-name))
    (format "  class ~aStreamServer {\n   public:\n" sname)
    (string-append "    virtual ~" sname "StreamServer() = default;\n")
    (apply string-append (map wasm-cpp-stream-iface-method methods))
    "  };\n\n"
    (format
     "  static inline ~aStreamServer* g_stream_impl = nullptr;\n\n"
     sname)
    (format
     "  /// Register the incremental implementation used by the serve_*Start/Feed/End exports.\n")
    (format
     "  static void register~aStreamServer(~aStreamServer& impl) { g_stream_impl = &impl; }\n"
     sname
     sname)
    "};\n\n"
    (apply string-append (map wasm-cpp-server-export methods))
    (apply string-append (map wasm-cpp-stream-feed-export methods)))))

(define (emit-wasm-cpp-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define struct-name
    (string-append (pascal (string->symbol base)) "WasmGrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (define ns (if (string=? pkg "") "proto" pkg))
  (define messages-include
    (hash-ref params 'messages_include (format "~a_messages.hpp" base)))
  (define bridge-include (hash-ref params 'bridge_include "bridge.hpp"))
  (cons
   (string-append base "_wasm_dc.hpp")
   (string-append
    "// @generated by protoc-gen-grpc-dc-wasm-cpp (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n" (hash-ref file-model 'name))
    "#pragma once\n\n"
    "#include <functional>\n"
    "#include <memory>\n"
    "#include <optional>\n"
    "#include <utility>\n"
    "#include <vector>\n\n"
    (format "#include ~s\n" bridge-include)
    (format "#include ~s\n\n" messages-include)
    (format "namespace ~a {\n\n" ns)
    (format
     "/// Generated WASM facade stubs for ~a.\n"
     (hash-ref file-model 'name))
    (format "struct ~a {\n" struct-name)
    (apply
     string-append
     (map
      (lambda (svc)
        (parameterize ((current-struct struct-name)) (wasm-cpp-service svc)))
      (hash-ref file-model 'services)))
    (format "}  // namespace ~a\n" ns))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map
        stamp-generated-header
        (as-file-list (emit-wasm-cpp-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
