(define js-pb-decode-case-program
  '((if (is-map)
      (then
       (fmt
        "      case ~a: { const [k, val] = ~aDecode(value); msg.~a.set(k, val); break; }\n"
        (ref number)
        (resolved-flat)
        (js-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "      case ~a: ~aif (wire === 2) { const r = new Reader(value); while (!r.done) msg.~a.push(~a); } else msg.~a.push(~a); break;\n"
             (ref number)
             (call jsPbOneofClearing)
             (js-name)
             (call jsPbVarintDecode "r.varint()")
             (js-name)
             (call jsPbVarintDecode "value")))
           ("fixed"
            (fmt
             "      case ~a: if (wire === 2) { const r = new Reader(value); while (!r.done) msg.~a.push(readFixed(r.take(~a), (dv) => dv.get~a(0, true))); } else msg.~a.push(readFixed(value, (dv) => dv.get~a(0, true))); break;\n"
             (ref number)
             (js-name)
             (js-fixed-size)
             (js-fixed-name)
             (js-name)
             (js-fixed-name)))
           (else
            (fmt
             "      case ~a: msg.~a.push(~a); break;\n"
             (ref number)
             (js-name)
             (case-on
              (category)
              ("string" "new TextDecoder().decode(value)")
              ("bytes" "value")
              (else (fmt "~a.decode(value)" (resolved-flat))))))))
         (else
          (fmt
           "      case ~a: ~a~a break;\n"
           (ref number)
           (call jsPbOneofClearing)
           (call jsPbDecodeSingular (fmt "msg.~a" (js-name)) "value"))))))))

