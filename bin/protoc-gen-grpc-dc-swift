(define js-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~aputTag(out, ~a, 0); out.push(...varintBytes(~a));\n"
          (arg 1)
          (ref number)
          (call jsPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aputVarintField(out, ~a, ~a);\n"
          (arg 1)
          (ref number)
          (call jsPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aputFixedField(out, ~a, fixedBytes(~a, ~a, (dv, x) => dv.set~a(0, x, true)));\n"
          (arg 1)
          (ref number)
          (arg 0)
          (js-fixed-size)
          (js-fixed-name)))
        (else
         (fmt
          "~aif (~a) putFixedField(out, ~a, fixedBytes(~a, ~a, (dv, x) => dv.set~a(0, x, true)));\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)
          (js-fixed-size)
          (js-fixed-name)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aputBytesField(out, ~a, new TextEncoder().encode(~a));\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aputStringField(out, ~a, ~a);\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt "~aputBytesField(out, ~a, ~a);\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif (~a && ~a.length) putBytesField(out, ~a, ~a);\n"
          (arg 1)
          (arg 0)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif (~a) putBytesField(out, ~a, ~a.encode(~a));\n"
       (arg 1)
       (arg 0)
       (ref number)
       (resolved-flat)
       (arg 0)))
     (else (fail)))))

(define js-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "    if (msg.~a) for (const [k, val] of msg.~a) putBytesField(out, ~a, ~aEncode(k, val));\n"
        (js-name)
        (js-name)
        (ref number)
        (resolved-flat)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "    if (msg.~a && msg.~a.length) {\n      const payload = [];\n      for (const x of msg.~a) payload.push(...varintBytes(~a));\n      putBytesField(out, ~a, payload);\n    }\n"
             (js-name)
             (js-name)
             (js-name)
             (call jsPbVarintExpr "x")
             (ref number)))
           ("fixed"
            (fmt
             "    if (msg.~a && msg.~a.length) {\n      const payload = new Uint8Array(msg.~a.length * ~a);\n      const dv = new DataView(payload.buffer);\n      msg.~a.forEach((x, i) => dv.set~a(i * ~a, x, true));\n      putBytesField(out, ~a, payload);\n    }\n"
             (js-name)
             (js-name)
             (js-name)
             (js-fixed-size)
             (js-name)
             (js-fixed-name)
             (js-fixed-size)
             (ref number)))
           ("string"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, new TextEncoder().encode(v));\n"
             (js-name)
             (js-name)
             (ref number)))
           ("bytes"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, v);\n"
             (js-name)
             (js-name)
             (ref number)))
           ("message"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, ~a.encode(v));\n"
             (js-name)
             (js-name)
             (ref number)
             (resolved-flat)))
           (else (fail))))
         (else (call jsPbEncodeSingular (fmt "msg.~a" (js-name)) "    ")))))))

(define js-pb-decode-singular-program
