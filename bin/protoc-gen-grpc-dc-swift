(define wasm-zig-pending-structs-program
  '((kind-case
     ((unary client-streaming)
      (fmt
       "const ~aUnaryPending = struct {\n    alloc: std.mem.Allocator,\n    ctx: *anyopaque,\n    callback: *const fn (ctx: *anyopaque, result: CallResult(~a)) void,\n\n    fn complete(raw: *anyopaque, st: Status, payload: ?[]const u8) void {\n        const self: *@This() = @ptrCast(@alignCast(raw));\n        defer self.alloc.destroy(self);\n        if (!st.isOk()) {\n            self.callback(self.ctx, .{ .status = st });\n            return;\n        }\n        var resp = ~a{};\n        resp.unmarshalDc(self.alloc, payload orelse \"\");\n        self.callback(self.ctx, .{ .ok = resp });\n    }\n};\n\n"
       (ref name)
       (ref output)
       (ref output)))
     ((server-streaming bidi)
      (fmt
       "const ~aStreamPending = struct {\n    alloc: std.mem.Allocator,\n    ctx: *anyopaque,\n    on_message: *const fn (ctx: *anyopaque, resp: ~a) void,\n    on_done: *const fn (ctx: *anyopaque, status: Status) void,\n\n    fn message(raw: *anyopaque, payload: []const u8) void {\n        const self: *@This() = @ptrCast(@alignCast(raw));\n        var resp = ~a{};\n        resp.unmarshalDc(self.alloc, payload);\n        self.on_message(self.ctx, resp);\n    }\n\n    fn done(raw: *anyopaque, st: Status, _: ?[]const u8) void {\n        const self: *@This() = @ptrCast(@alignCast(raw));\n        defer self.alloc.destroy(self);\n        self.on_done(self.ctx, st);\n    }\n};\n\n"
       (ref name)
       (ref output)
       (ref output))))))

(define wasm-zig-server-serve-export-program
  '((kind-case
     (unary
      (fmt
       "export fn serve_~a(call_id: u32, payload_ptr: [*]const u8, payload_len: usize, md_ptr: [*]const u8, md_len: usize) void {\n    const a = bridge_mod.bridgeAllocator();\n    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n    defer a.free(md);\n    var req = ~a{};\n    req.unmarshalDc(a, payload_ptr[0..payload_len]);\n    switch (g_server_impl.?.~a_fn(g_server_impl.?.ctx, &req, md)) {\n        .ok => |resp| { const bytes = resp.marshalDc(a); defer a.free(bytes); bridge_mod.serverRespond(call_id, bytes); },\n        .status => |st| bridge_mod.serverFail(call_id, st),\n    }\n}\n\n"
       (lower-first (ref name))
