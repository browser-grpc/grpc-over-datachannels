(define rb-server-handler-program
  '((kind-case
     (unary
      (fmt
       "    ~a = lambda do |ctx, reqs, sink|\n      req = reqs.recv_into(~a.new)\n      resp = impl.~a(ctx, req)\n      sink.send(resp.marshal_dc)\n    end\n\n"
       (fmt "~a_handler" (rb-snake (ref name)))
       (stub-ref input-full)
       (ref impl-name)))
     (server-streaming
      (fmt
       "    ~a = lambda do |ctx, reqs, sink|\n      req = reqs.recv_into(~a.new)\n      impl.~a(req, SendStream.new(ctx, sink))\n    end\n\n"
       (fmt "~a_handler" (rb-snake (ref name)))
       (stub-ref input-full)
       (ref impl-name)))
     (client-streaming
      (fmt
       "    ~a = lambda do |ctx, reqs, sink|\n      stream = ClientStreamImpl.new(ctx, reqs, ~a)\n      impl.~a(stream)\n      if stream.resp.nil?\n        raise Grpcdc::StatusError.new(Grpcdc::CODE_INTERNAL, \"client-streaming handler never called SendAndClose\")\n      end\n      sink.send(stream.resp.marshal_dc)\n    end\n\n"
       (fmt "~a_handler" (rb-snake (ref name)))
       (stub-ref input-full)
       (ref impl-name)))
     (bidi
      (fmt
       "    ~a = lambda do |ctx, reqs, sink|\n      impl.~a(BidiStream.new(ctx, reqs, sink, ~a))\n    end\n\n"
       (fmt "~a_handler" (rb-snake (ref name)))
       (ref impl-name)
       (stub-ref input-full))))))

(define rb-method-entry-program
  '((fmt
     "        Grpcdc::Method.new(~s, ~s, Grpcdc::~a, ~a),\n"
     (ref name)
     (ref path)
     (kind-case
      (unary "KIND_UNARY")
      (server-streaming "KIND_SERVER_STREAMING")
      (client-streaming "KIND_CLIENT_STREAMING")
      (bidi "KIND_BIDI"))
     (fmt "~a_handler" (rb-snake (ref name))))))

(define rb-service-program
  '((fmt
     "  class ~aClient\n    def initialize(channel)\n      @channel = channel\n    end\n\n"
     (svc))
    (each+ methods client (call rbClientMethod))
    "  end\n\n"
    (fmt
     "  # Fiber client: wraps a Grpcdc::FiberChannel (a sync Channel is wrapped).\n  class ~aClientFiber\n    def initialize(channel)\n      @channel = channel.is_a?(Grpcdc::FiberChannel) ? channel : Grpcdc::FiberChannel.new(channel)\n    end\n\n"
     (svc))
    (each+ methods client (call rbFiberClientMethod))
    "  end\n\n"
    (fmt "  def self.register_~a_server(server, impl)\n" (rb-snake (svc)))
    (each+ methods server (call rbServerHandler))
    (fmt
     "    server.register_service(Grpcdc::ServiceDesc.new(\n      ~s,\n      [\n"
     (ref full-name))
    (each+ methods server (call rbMethodEntry))
    "      ]\n    ))\n  end\n"))

(define rb-pb-varint-expr-program
  '((case-on
     (type)
     (8 (fmt "(~a ? 1 : 0)" (arg 0)))
     (17 (fmt "(((~a << 1) ^ (~a >> 31)) & 0xffffffff)" (arg 0) (arg 0)))
     (18 (fmt "((~a << 1) ^ (~a >> 63))" (arg 0) (arg 0)))
     (else (arg 0)))))

(define rb-pb-varint-decode-program
  '((case-on
     (type)
     ((5 14) (fmt "(((~a & 0xffffffff) ^ 0x80000000) - 0x80000000)" (arg 0)))
     ((13 7) (fmt "(~a & 0xffffffff)" (arg 0)))
     (3
      (fmt
       "(((~a & 0xffffffffffffffff) ^ 0x8000000000000000) - 0x8000000000000000)"
       (arg 0)))
     (4 (fmt "(~a & 0xffffffffffffffff)" (arg 0)))
     (8 (fmt "(~a != 0)" (arg 0)))
     (17
      (fmt
       "(((~a & 0xffffffff) >> 1) ^ -((~a & 0xffffffff) & 1))"
       (arg 0)
       (arg 0)))
     (18 (fmt "((~a >> 1) ^ -(~a & 1))" (arg 0) (arg 0)))
     (else (arg 0)))))

(define rb-pb-nonzero-program
  '((case-on (type) (8 (arg 0)) (else (fmt "~a != 0" (arg 0))))))

(define rb-pb-explicit-literal-program
  '((if (has-default)
      (then
       (case-on
        (type)
        (9 (fmt "~s" (default-raw)))
        (14 (fmt "~a" (enum-default-num)))
        (else (default-raw))))
      (else ""))))

(define rb-pb-default-program
  '((if (call rbPbExplicitLiteral)
      (then (call rbPbExplicitLiteral))
      (else
       (if (is-map)
         (then "{}")
         (else
          (if (repeated)
            (then "[]")
            (else
             (case-on
              (type)
              (11 "nil")
              (9 "\"\"")
              (12 "\"\".b")
              (8 "false")
              ((1 2) "0.0")
              (14 (fmt "~a" (enum-first-value-num)))
              (else "0"))))))))))

(define rb-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~aw.tag(~a, 0)\n~aw.varint(~a)\n"
          (arg 1)
          (ref number)
          (arg 1)
          (call rbPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aif ~a\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~aend\n"
          (arg 1)
          (call rbPbNonzero (arg 0))
          (arg 1)
          (ref number)
          (arg 1)
          (call rbPbVarintExpr (arg 0))
          (arg 1)))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aw.tag(~a, ~a)\n~aw.fixed(~s, ~a)\n"
          (arg 1)
          (ref number)
          (case-on (rb-fixed-size) (8 "1") (else "5"))
          (arg 1)
          (rb-fixed-fmt)
          (arg 0)))
        (else
         (fmt
          "~aif ~a != 0\n~a  w.tag(~a, ~a)\n~a  w.fixed(~s, ~a)\n~aend\n"
          (arg 1)
          (arg 0)
          (arg 1)
          (ref number)
          (case-on (rb-fixed-size) (8 "1") (else "5"))
          (arg 1)
          (rb-fixed-fmt)
          (arg 0)
          (arg 1)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aw.bytes_field(~a, ~a.encode(Encoding::UTF_8).b)\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt "~aw.string_field(~a, ~a)\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw.bytes_field(~a, ~a)\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif ~a.bytesize > 0\n~a  w.bytes_field(~a, ~a)\n~aend\n"
          (arg 1)
          (arg 0)
          (arg 1)
          (ref number)
          (arg 0)
          (arg 1)))))
     ("message"
      (fmt
       "~aunless ~a.nil?\n~a  w.bytes_field(~a, ~a.marshal_dc)\n~aend\n"
       (arg 1)
       (arg 0)
       (arg 1)
       (ref number)
       (arg 0)
       (arg 1)))
     (else (fail)))))

(define rb-pb-set-expr-program
  '((case-on
     (type)
     ((11 10) (fmt "!@~a.nil?" (ref name)))
     ((9 12) (fmt "(!@~a.nil? && !@~a.empty?)" (ref name) (ref name)))
     (else (call rbPbNonzero (fmt "@~a" (ref name)))))))

(define rb-pb-oneof-clearing-program
  '((each-siblings (fmt "        @~a = ~a\n" (ref name) (call rbPbDefault)))))

(define rb-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "    @~a.each { |k, val| w.bytes_field(~a, ~a(k, val)) }\n"
        (ref name)
        (ref number)
        (fmt "~aPb.encode_~a" (arg 0) (rb-snake (rb-entry-ref)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "    unless @~a.empty?\n      payload = +\"\".b\n      @~a.each { |x| payload << ~aPbVarint.call(~a) }\n      w.bytes_field(~a, payload)\n    end\n"
             (ref name)
             (ref name)
             (arg 0)
             (call rbPbVarintExpr "x")
             (ref number)))
           ("fixed"
            (fmt
             "    unless @~a.empty?\n      w.bytes_field(~a, @~a.pack(~s))\n    end\n"
             (ref name)
             (ref number)
             (ref name)
             (fmt "~a*" (rb-fixed-fmt))))
           ("string"
            (fmt
             "    @~a.each { |x| w.bytes_field(~a, x) }\n"
             (ref name)
             (ref number)))
           ("bytes"
            (fmt
             "    @~a.each { |x| w.bytes_field(~a, x) }\n"
             (ref name)
             (ref number)))
           ("message"
            (fmt
             "    @~a.each { |x| w.bytes_field(~a, x.marshal_dc) }\n"
             (ref name)
             (ref number)))
           (else (fail))))
         (else (call rbPbEncodeSingular (fmt "@~a" (ref name)) "    ")))))))

(define rb-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call rbPbVarintDecode (arg 1))))
     ("fixed"
      (fmt "~a~a = ~a.unpack1(~s)\n" (arg 2) (arg 0) (arg 1) (rb-fixed-fmt)))
     ("string"
      (fmt
       "~a~a = ~a.dup.force_encoding(Encoding::UTF_8)\n"
       (arg 2)
       (arg 0)
       (arg 1)))
     ("bytes" (fmt "~a~a = ~a\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt
       "~a~a = ~a.new\n~a~a.unmarshal_dc(~a)\n"
       (arg 2)
       (arg 0)
       (rb-entry-ref)
       (arg 2)
       (arg 0)
       (arg 1)))
     (else (fail)))))

(define rb-pb-decode-case-program
  '((if (is-map)
      (then
       (fmt
        "      when ~a\n        kk, vv = ~a(bytes_value)\n        @~a[kk] = vv\n"
        (ref number)
        (fmt "~a.decode_~a" (rb-model-module) (rb-snake (rb-entry-ref)))
        (ref name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "      when ~a\n        if wire == 2\n          sub = Reader.new(bytes_value)\n          until sub.done?\n            raw = sub.varint\n            @~a << ~a\n          end\n        else\n          @~a << ~a\n        end\n"
             (ref number)
             (ref name)
             (call rbPbVarintDecode "raw")
             (ref name)
             (call rbPbVarintDecode "varint_value")))
           ("fixed"
            (fmt
             "      when ~a\n        if wire == 2\n          bytes_value.unpack(~s).each { |x| @~a << x }\n        else\n          @~a << fixed_value.unpack1(~s)\n        end\n"
             (ref number)
             (fmt "~a*" (rb-fixed-fmt))
             (ref name)
             (ref name)
             (rb-fixed-fmt)))
           ("string"
            (fmt
             "      when ~a\n        @~a << bytes_value.dup.force_encoding(Encoding::UTF_8)\n"
             (ref number)
             (ref name)))
           ("bytes"
            (fmt
             "      when ~a\n        @~a << bytes_value\n"
             (ref number)
             (ref name)))
           ("message"
            (fmt
             "      when ~a\n        item = ~a.new\n        item.unmarshal_dc(bytes_value)\n        @~a << item\n"
             (ref number)
             (rb-entry-ref)
             (ref name)))
           (else (fail))))
         (else
          (fmt
           "      when ~a\n~a~a"
           (ref number)
           (call rbPbOneofClearing)
           (call
            rbPbDecodeSingular
            (fmt "@~a" (ref name))
            (case-on
             (category)
             ("varint" "varint_value")
             ("fixed" "fixed_value")
             (else "bytes_value"))
            "        "))))))))

(define rb-pb-map-helpers-program
  '((fmt
     "  def self.encode_~a(key, value)\n    w = Writer.new\n"
     (rb-snake (rb-entry-ref)))
    (call-on (with-label (key-field) 1) rbPbEncodeSingular "key" "    ")
    (call-on (with-label (val-field) 1) rbPbEncodeSingular "value" "    ")
    "    w.to_bytes\n  end\n\n"
    (fmt "  def self.decode_~a(data)\n" (rb-snake (rb-entry-ref)))
    (fmt
     "    key = ~a\n    value = ~a\n"
     (call-on (with-label (key-field) 1) rbPbDefault)
     (call-on (with-label (val-field) 1) rbPbDefault))
    "    r = Reader.new(data)\n    loop do\n      item = r.field\n      break if item.nil?\n\n      num, wire, varint_value, bytes_value, fixed_value, _raw_value = item\n"
    (fmt
     "      if num == ~a\n~a"
     (get (key-field) number)
     (call-on
      (with-label (key-field) 1)
      rbPbDecodeSingular
      "key"
      (case-on
       (category-of (key-field))
       ("varint" "varint_value")
       ("fixed" "fixed_value")
       (else "bytes_value"))
      "        "))
    (fmt
     "      elsif num == ~a\n~a"
     (get (val-field) number)
     (case-on
      (get (val-field) type)
      (11
       (fmt
        "        value = ~a.new\n        value.unmarshal_dc(bytes_value)\n"
        (rb-entry-ref (val-field))))
      (else
       (call-on
        (with-label (val-field) 1)
        rbPbDecodeSingular
        "value"
        (case-on
         (category-of (val-field))
         ("varint" "varint_value")
         ("fixed" "fixed_value")
         (else "bytes_value"))
        "        "))))
    "      end\n    end\n    [key, value]\n  end\n\n"))

(define rb-pb-message-program
  '((fmt "  class ~a\n" (flat))
    (if (no-fields)
      (then "")
      (else
       (fmt
        "    attr_accessor ~a, :unknown_fields\n\n"
        (each-sep ", " fields (fmt ":~a" (ref name))))))
    (fmt
     "    def initialize(~a)\n"
     (each-sep ", " fields (fmt "~a: ~a" (ref name) (call rbPbDefault))))
    (each fields (fmt "      @~a = ~a\n" (ref name) (ref name)))
    "      @unknown_fields = \"\".b\n    end\n\n    def marshal_dc\n      w = Writer.new\n"
    (each
     fields
     (guarded
      rbPbSetExpr
      "    unless (~a)\n"
      "    end\n"
      (call rbPbEncodeField (arg 0))))
    "      w.raw(@unknown_fields)\n      w.to_bytes\n    end\n\n    def unmarshal_dc(data)\n      @unknown_fields = \"\".b\n"
    (each fields (fmt "      @~a = ~a\n" (ref name) (call rbPbDefault)))
    "      r = Reader.new(data)\n      loop do\n        item = r.field\n        break if item.nil?\n\n        num, wire, varint_value, bytes_value, fixed_value, raw_value = item\n"
    (if (no-fields)
      (then "        @unknown_fields = @unknown_fields + raw_value\n")
      (else
       "        case num\n"
       (each fields (call rbPbDecodeCase))
       "        else\n          @unknown_fields = @unknown_fields + raw_value\n        end\n"))
    "      end\n      self\n    end\n\n"
    (fmt
     "    def ==(other)\n      other.is_a?(~a) && ~a\n    end\n  end\n\n"
     (flat)
     (if (no-fields)
       (then "true")
       (else
        (each-sep
         " && "
         fields
         (fmt "@~a == other.~a" (ref name) (ref name))))))
    (each nested (call rbPbMessage (arg 0)))))

(define rb-pb-enum-program
  '((fmt "  module ~a\n" (flat-of (arg 0)))
    (each values (fmt "    ~a = ~a\n" (ref name) (ref number)))
    "  end\n\n"))

