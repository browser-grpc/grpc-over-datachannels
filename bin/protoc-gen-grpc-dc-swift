(define php-pb-decode-case-program
  '((if (is-map)
      (then
       (fmt
        "                case ~a:\n                    [$kk, $vv] = ~a($bytesValue);\n                    $this->~a[$kk] = $vv;\n                    break;\n"
        (ref number)
        (fmt "decode~a" (php-entry-ref))
        (php-field-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "                case ~a:\n                    if ($wire === 2) {\n                        $sub = new Reader($bytesValue);\n                        while (!$sub->done()) {\n                            $raw = $sub->varint();\n                            $this->~a[] = ~a;\n                        }\n                    } else {\n                        $this->~a[] = ~a;\n                    }\n                    break;\n"
             (ref number)
             (php-field-name)
             (call phpPbVarintDecode "$raw")
             (php-field-name)
             (call phpPbVarintDecode "$varintValue")))
           ("fixed"
            (fmt
             "                case ~a:\n                    if ($wire === 2) {\n                        for ($i = 0; $i < strlen($bytesValue); $i += ~a) {\n                            $this->~a[] = ~a;\n                        }\n                    } else {\n                        $this->~a[] = ~a;\n                    }\n                    break;\n"
             (ref number)
             (php-fixed-size)
             (php-field-name)
             (call
              phpPbFixedDecode
              (fmt "substr($bytesValue, $i, ~a)" (php-fixed-size)))
             (php-field-name)
             (call phpPbFixedDecode "$fixedValue")))
           ("string"
            (fmt
             "                case ~a:\n                    $this->~a[] = $bytesValue;\n                    break;\n"
             (ref number)
             (php-field-name)))
           ("bytes"
            (fmt
             "                case ~a:\n                    $this->~a[] = $bytesValue;\n                    break;\n"
             (ref number)
             (php-field-name)))
           ("message"
            (fmt
             "                case ~a:\n                    $item = new ~a();\n                    $item->unmarshalDc($bytesValue);\n                    $this->~a[] = $item;\n                    break;\n"
             (ref number)
             (php-entry-ref)
             (php-field-name)))
           (else (fail))))
         (else
          (fmt
           "                case ~a:\n~a~a                    break;\n"
           (ref number)
           (call phpPbOneofClearing)
           (call
            phpPbDecodeSingular
            (fmt "$this->~a" (php-field-name))
            (case-on
             (category)
             ("varint" "$varintValue")
             ("fixed" "$fixedValue")
             (else "$bytesValue"))
            "                    "))))))))

(define php-pb-map-helpers-program
  '((fmt
     "function encode~a($key, $value): string\n{\n    $w = new Writer();\n"
     (php-entry-ref))
    (call-on (with-label (key-field) 1) phpPbEncodeSingular "$key" "    ")
    (call-on (with-label (val-field) 1) phpPbEncodeSingular "$value" "    ")
    "    return $w->toBytes();\n}\n\n"
    (fmt "function decode~a(string $data): array\n{\n" (php-entry-ref))
    (fmt
     "    $key = ~a;\n    $value = ~a;\n"
     (call-on (with-label (key-field) 1) phpPbDefault)
     (call-on (with-label (val-field) 1) phpPbDefault))
    "    $r = new Reader($data);\n    while (($item = $r->field()) !== null) {\n        [$num, $wire, $varintValue, $bytesValue, $fixedValue, $rawValue] = $item;\n"
    (fmt
     "        if ($num === ~a) {\n~a"
     (get (key-field) number)
     (call-on
      (with-label (key-field) 1)
      phpPbDecodeSingular
      "$key"
      (case-on
       (category-of (key-field))
       ("varint" "$varintValue")
       ("fixed" "$fixedValue")
       (else "$bytesValue"))
      "            "))
    (fmt
     "        } elseif ($num === ~a) {\n~a"
     (get (val-field) number)
     (case-on
      (get (val-field) type)
      (11
       (fmt
        "            $value = new ~a();\n            $value->unmarshalDc($bytesValue);\n"
        (php-entry-ref (val-field))))
      (else
       (call-on
        (with-label (val-field) 1)
        phpPbDecodeSingular
        "$value"
        (case-on
         (category-of (val-field))
         ("varint" "$varintValue")
         ("fixed" "$fixedValue")
         (else "$bytesValue"))
        "            "))))
    "        }\n    }\n    return [$key, $value];\n}\n\n"))

(define php-pb-message-program
  '((fmt "class ~a\n{\n" (php-flat-of (ref full-name)))
    (each
     fields
     (fmt
      "    public ~a $~a = ~a;\n"
      (call phpPbType)
      (php-field-name)
      (call phpPbDefault)))
    (if (no-fields) (then "") (else "\n"))
    "    public string $unknownFields = \"\";\n"
    (fmt
     "    public function __construct(~a)\n    {\n"
     (each-sep
      ", "
      fields
      (fmt
       "~a $~a = ~a"
       (call phpPbType)
       (php-field-name)
       (call phpPbDefault))))
    (each
     fields
     (fmt "        $this->~a = $~a;\n" (php-field-name) (php-field-name)))
    "    }\n\n    public function marshalDc(): string\n    {\n        $w = new Writer();\n"
    (each
     fields
     (guarded
      phpPbSetExpr
      "        if (!(~a)) {\n"
      "        }\n"
      (call phpPbEncodeField)))
    "        $w->raw($this->unknownFields);\n        return $w->toBytes();\n    }\n\n    public function unmarshalDc(string $data): self\n    {\n        $this->unknownFields = \"\";\n"
    (each
     fields
     (fmt "        $this->~a = ~a;\n" (php-field-name) (call phpPbDefault)))
    "        $r = new Reader($data);\n        while (($item = $r->field()) !== null) {\n            [$num, $wire, $varintValue, $bytesValue, $fixedValue, $rawValue] = $item;\n            switch ($num) {\n"
    (each fields (call phpPbDecodeCase))
    "                default:\n                    $this->unknownFields .= $rawValue;\n                    break;\n            }\n        }\n        return $this;\n    }\n\n"
    (fmt
     "    public function equals(?object $other): bool\n    {\n        return $other instanceof ~a~a;\n    }\n}\n\n"
     (php-flat-of (ref full-name))
     (if (no-fields)
       (then "")
       (else
        (fmt
         "\n            && ~a"
         (each-sep
          "\n            && "
          fields
          (fmt
           "$this->~a === $other->~a"
           (php-field-name)
           (php-field-name)))))))
    (each nested (call phpPbMessage))))

(define php-pb-enum-program
  '((fmt "final class ~a\n{\n" (php-flat-of (arg 0)))
    (each values (fmt "    public const ~a = ~a;\n" (ref name) (ref number)))
    "}\n\n"))

(define py-deprecated-program
  '((when (ref deprecated)
      "        \"\"\"Deprecated: marked deprecated in the proto schema.\"\"\"\n        import warnings as _warnings; _warnings.warn(\"deprecated\", DeprecationWarning, stacklevel=2)\n")))

(define py-client-method-program
  '((kind-case
     (unary
      (fmt
       "    def ~a(self, req, metadata=None, timeout=None):\n~a        return self._channel.unary(~s, req, ~a.~a(), metadata, timeout)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (server-streaming
      (fmt
       "    def ~a(self, req, metadata=None, timeout=None):\n~a        stream = self._channel.server_stream(~s, req, metadata, timeout)\n        return _RecvStream(stream, ~a.~a)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (client-streaming
      (fmt
       "    def ~a(self, reqs, metadata=None, timeout=None):\n~a        return self._channel.client_stream(~s, reqs, ~a.~a(), metadata, timeout)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (bidi
      (fmt
       "    def ~a(self, reqs, metadata=None, timeout=None):\n~a        stream = self._channel.bidi(~s, reqs, metadata, timeout)\n        return _RecvStream(stream, ~a.~a)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output))))))

(define py-async-client-method-program
  '((kind-case
     (unary
      (fmt
       "    async def ~a(self, req, metadata=None, timeout=None):\n~a        return await self._channel.unary(~s, req, ~a.~a(), metadata, timeout)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (server-streaming
      (fmt
       "    async def ~a(self, req, metadata=None, timeout=None):\n~a        stream = await self._channel.server_stream(~s, req, metadata, timeout)\n        return _AsyncRecvStream(stream, ~a.~a)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (client-streaming
      (fmt
       "    async def ~a(self, reqs, metadata=None, timeout=None):\n~a        return await self._channel.client_stream(~s, reqs, ~a.~a(), metadata, timeout)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output)))
     (bidi
      (fmt
       "    async def ~a(self, reqs, metadata=None, timeout=None):\n~a        stream = await self._channel.bidi(~s, reqs, metadata, timeout)\n        return _AsyncRecvStream(stream, ~a.~a)\n\n"
       (ref name)
       (call pyDeprecated)
       (ref path)
       (arg 0)
       (ref output))))))

(define py-server-handler-program
  '((kind-case
     (unary
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        req = reqs.recv_into(~a.~a())\n        resp = impl.~a(ctx, req)\n        sink.send(resp.marshal_dc())\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (server-streaming
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        req = reqs.recv_into(~a.~a())\n        impl.~a(req, _SendStream(ctx, sink))\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (client-streaming
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        stream = _ClientStreamImpl(ctx, reqs, ~a.~a)\n        impl.~a(stream)\n        if stream.resp is None:\n            raise grpcdc.StatusError(grpcdc.CODE_INTERNAL, \"client-streaming handler never called SendAndClose\")\n        sink.send(stream.resp.marshal_dc())\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (bidi
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        impl.~a(_BidiStream(ctx, reqs, sink, ~a.~a))\n\n"
       (ref name)
       (ref impl-name)
       (arg 0)
       (ref input))))))

(define py-method-entry-program
  '((fmt
     "        grpcdc.Method(~s, ~s, grpcdc.~a, _~a_handler),\n"
     (ref name)
     (ref path)
     (kind-case
      (unary "KIND_UNARY")
      (server-streaming "KIND_SERVER_STREAMING")
      (client-streaming "KIND_CLIENT_STREAMING")
      (bidi "KIND_BIDI"))
     (ref name))))

(define py-service-program
  '((fmt
     "class ~aClient:\n    def __init__(self, channel):\n        self._channel = channel\n\n"
     (svc))
    (each+ methods client (call pyClientMethod (arg 0)))
    (fmt
     "class ~aClientAsync:\n    \"\"\"Asyncio client: wrap a grpcdc.AsyncChannel (a sync Channel is wrapped).\"\"\"\n\n    def __init__(self, channel):\n        if isinstance(channel, grpcdc.AsyncChannel):\n            self._channel = channel\n        else:\n            self._channel = grpcdc.AsyncChannel(channel=channel)\n\n"
     (svc))
    (each+ methods client (call pyAsyncClientMethod (arg 0)))
    (fmt "def register_~a_server(server, impl):\n" (snake-case (svc)))
    (each+ methods server (call pyServerHandler (arg 0)))
    (fmt
     "    server.register_service(grpcdc.ServiceDesc(\n        ~s,\n        [\n"
     (ref full-name))
    (each+ methods server (call pyMethodEntry))
    "        ],\n    ))\n"))

(define py-pb-varint-expr-program
  '((case-on
     (type)
     (8 (fmt "(1 if ~a else 0)" (arg 0)))
     (17 (fmt "(((~a << 1) ^ (~a >> 31)) & 0xFFFFFFFF)" (arg 0) (arg 0)))
     (18
      (fmt "(((~a << 1) ^ (~a >> 63)) & 0xFFFFFFFFFFFFFFFF)" (arg 0) (arg 0)))
     (else (arg 0)))))

(define py-pb-varint-decode-program
  '((case-on
     (type)
     ((5 14) (fmt "_as_int32(~a)" (arg 0)))
     (13 (fmt "(~a & 0xFFFFFFFF)" (arg 0)))
     (3 (fmt "_as_int64(~a)" (arg 0)))
     (4 (arg 0))
     (8 (fmt "(~a != 0)" (arg 0)))
     (17 (fmt "_unzz32(~a)" (arg 0)))
     (18 (fmt "_unzz64(~a)" (arg 0))))))

(define py-pb-explicit-literal-program
  '((if (has-default)
      (then
       (case-on
        (type)
        (9 (fmt "~s" (default-raw)))
        (8 (case-on (default-raw) ("true" "True") (else "False")))
        (14 (fmt "~a" (enum-default-num)))
        (else (default-raw))))
      (else ""))))

(define py-pb-default-program
  '((if (call pyPbExplicitLiteral)
      (then (call pyPbExplicitLiteral))
      (else
       (if (repeated)
         (then (if (is-map) (then "dict") (else "list")))
         (else
          (case-on
           (type)
           (9 "\"\"")
           (12 "b\"\"")
           (8 "False")
           ((11 10) "None")
           ((1 2) "0.0")
           (else "0"))))))))

(define py-pb-default-expr-program
  '((case-on
     (call pyPbDefault)
     ("list" "[]")
     ("dict" "{}")
     (else (call pyPbDefault)))))

(define py-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~aout = _append_tag(out, ~a, 0)\n~aout = _append_varint(out, ~a)\n"
          (arg 1)
          (ref number)
          (arg 1)
          (call pyPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aout = _append_varint_field(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (call pyPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aout = _append_fixed_field(out, ~a, _struct.pack(~s, ~a))\n"
          (arg 1)
          (ref number)
          (py-fixed-fmt)
          (arg 0)))
        (else
         (fmt
          "~aif ~a: out = _append_fixed_field(out, ~a, _struct.pack(~s, ~a))\n"
          (arg 1)
          (arg 0)
          (ref number)
          (py-fixed-fmt)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aout = _append_bytes_field(out, ~a, ~a.encode(\"utf-8\"))\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aout = _append_string_field(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aout = _append_bytes_field(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif ~a: out = _append_bytes_field(out, ~a, ~a)\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif ~a is not None: out = _append_bytes_field(out, ~a, ~a.marshal_dc())\n"
       (arg 1)
       (arg 0)
       (ref number)
       (arg 0)))
     (else (fail)))))

(define py-pb-set-expr-program '((fmt "self.~a" (ref name))))

(define py-pb-oneof-clearing-program
  '((each-siblings
     (fmt
      "                self.~a = ~a\n"
      (ref name)
      (call pyPbDefaultExpr)))))

(define py-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "        if self.~a:\n            for k, val in self.~a.items():\n                out = _append_bytes_field(out, ~a, ~a(k, val))\n"
        (ref name)
        (ref name)
        (ref number)
        (fmt "_encode_~aEntry" (resolved-flat))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n                payload = _append_varint(payload, ~a)\n            out = _append_bytes_field(out, ~a, bytes(payload))\n"
             (ref name)
             (ref name)
             (call pyPbVarintExpr "v")
             (ref number)))
           ("fixed"
            (fmt
             "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n                payload.extend(_struct.pack(~s, v))\n            out = _append_bytes_field(out, ~a, bytes(payload))\n"
             (ref name)
             (ref name)
             (py-fixed-fmt)
             (ref number)))
           ("string"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.encode(\"utf-8\"))\n"
             (ref name)
             (ref number)))
           ("bytes"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v)\n"
             (ref name)
             (ref number)))
           ("message"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.marshal_dc())\n"
             (ref name)
             (ref number)))
           (else (fail))))
         (else
          (call pyPbEncodeSingular (fmt "self.~a" (ref name)) "        ")))))))

(define py-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call pyPbVarintDecode (arg 1))))
     ("fixed"
      (fmt
       "~a~a = _struct.unpack(~s, ~a)[0]\n"
       (arg 2)
       (arg 0)
       (py-fixed-fmt)
       (arg 1)))
     ("string" (fmt "~a~a = ~a.decode(\"utf-8\")\n" (arg 2) (arg 0) (arg 1)))
     ("bytes" (fmt "~a~a = bytes(~a)\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt
       "~atmp = ~a()\n~atmp.unmarshal_dc(~a)\n~a~a = tmp\n"
       (arg 2)
       (py-ref)
       (arg 2)
       (arg 1)
       (arg 2)
       (arg 0)))
     (else (fail)))))

(define py-pb-decode-case-program
  '((fmt "            ~a num == ~a:\n" (arg 0) (ref number))
    (if (is-map)
      (then
       (fmt
        "                k, val = ~a(value)\n                self.~a[k] = val\n"
        (fmt "_decode_~aEntry" (resolved-flat))
        (ref name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "                if wire == 2:\n                    sub = _Reader(value)\n                    while sub.pos < len(sub.buf):\n                        self.~a.append(~a)\n                else:\n                    self.~a.append(~a)\n"
             (ref name)
             (call pyPbVarintDecode "sub.varint()")
             (ref name)
             (call pyPbVarintDecode "value")))
           ("fixed"
            (fmt
             "                if wire == 2:\n                    for off in range(0, len(value), ~a):\n                        self.~a.append(_struct.unpack(~s, value[off:off + ~a])[0])\n                else:\n                    self.~a.append(_struct.unpack(~s, value)[0])\n"
             (py-fixed-size)
             (ref name)
             (py-fixed-fmt)
             (py-fixed-size)
             (ref name)
             (py-fixed-fmt)))
           ("string"
            (fmt
             "                self.~a.append(value.decode(\"utf-8\"))\n"
             (ref name)))
           ("bytes"
            (fmt "                self.~a.append(bytes(value))\n" (ref name)))
           ("message"
            (call pyPbDecodeSingular "tmp2" "value" "                ")
            (fmt "                self.~a.append(tmp2)\n" (ref name)))
           (else (fail))))
         (else
          (call pyPbOneofClearing)
          (call
           pyPbDecodeSingular
           (fmt "self.~a" (ref name))
           "value"
           "                ")))))))

(define py-pb-map-helpers-program
  '((fmt
     "def _encode_~aEntry(key, value):\n    out = bytearray()\n"
     (entry-flat))
    (call-on (key-field) pyPbEncodeSingular "key" "    ")
    (call-on (val-field) pyPbEncodeSingular "value" "    ")
    "    return bytes(out)\n\n\n"
    (fmt "def _decode_~aEntry(data):\n" (entry-flat))
    (fmt
     "    key = ~a\n    value = ~a\n"
     (call-on (key-field) pyPbDefaultExpr)
     (call-on (val-field) pyPbDefaultExpr))
    "    reader = _Reader(data)\n    while True:\n        item = reader.field()\n        if item is None:\n            return key, value\n        num, wire, raw, _raw_bytes = item\n        if num == 1:\n"
    (call-on (key-field) pyPbDecodeSingular "key" "raw" "            ")
    "        elif num == 2:\n"
    (call-on (val-field) pyPbDecodeSingular "value" "raw" "            ")
    "\n"))

(define py-pb-init-line-program
  '((if (repeated)
      (then
       (fmt
        "        self.~a = ~a(~a) if ~a is not None else ~a\n"
        (ref name)
        (call pyPbDefault)
        (ref name)
        (ref name)
        (case-on (call pyPbDefault) ("dict" "{}") (else "[]"))))
      (else
       (if (type-is 11)
         (then
          (if (is-map)
            (then
             (fmt
              "        self.~a = dict(~a) if ~a is not None else {}\n"
              (ref name)
              (ref name)
              (ref name)))
            (else (fmt "        self.~a = ~a\n" (ref name) (ref name)))))
         (else (fmt "        self.~a = ~a\n" (ref name) (ref name))))))))

(define py-pb-message-program
  '((fmt "class ~a:\n    \"\"\"Message ~a.\"\"\"\n\n" (flat) (ref full-name))
    (fmt
     "    def __init__(self, ~a):\n"
     (each-sep
      ", "
      fields
      (fmt
       "~a=~a"
       (ref name)
       (case-on
        (call pyPbDefault)
        ("list" "None")
        ("dict" "None")
        (else (call pyPbDefault))))))
    (each fields (call pyPbInitLine))
    "        self.unknown_fields = b\"\"\n\n    def marshal_dc(self):\n        out = bytearray()\n"
    (each
     fields
     (guarded-indent
      pyPbSetExpr
      "        if not (~a):\n"
      "    "
      (call pyPbEncodeField)))
    "        out += self.unknown_fields\n        return bytes(out)\n\n    def unmarshal_dc(self, data):\n        self.unknown_fields = b\"\"\n"
    (each
     fields
     (fmt
      "        self.~a = ~a\n"
      (ref name)
      (case-on
       (call pyPbDefault)
       ("list" "[]")
       ("dict" "{}")
       (else (call pyPbDefault)))))
    "        reader = _Reader(data)\n        while True:\n            item = reader.field()\n            if item is None:\n                return self\n            num, wire, value, raw = item\n"
    (each
     fields
     (call pyPbDecodeCase (case-on (index) (0 "if") (else "elif"))))
    (if (no-fields)
      (then "")
      (else
       "            else:\n                self.unknown_fields = self.unknown_fields + raw\n"))
    (fmt
     "\n    def __eq__(self, other):\n        return isinstance(other, ~a) and self.__dict__ == other.__dict__\n"
     (flat))
    (fmt
     "\n    def __repr__(self):\n        return f\"~a(~a)\"\n\n\n"
     (flat)
     (each-sep ", " fields (fmt "~a={self.~a!r}" (ref name) (ref name))))))

(define py-pb-enum-program
  '((fmt "class ~a:\n    \"\"\"Enum ~a.\"\"\"\n" (entry-flat) (ref full))
    (each enum values (fmt "    ~a = ~a\n" (ref name) (ref number)))
    "\n\n"))

