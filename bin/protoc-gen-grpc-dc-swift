             (case-on (type) (15 "($x & 0xffffffff)") (else "$x"))
             (ref number)))
           ("string"
            (fmt
             "        foreach ($this->~a as $x) {\n            $w->bytesField(~a, $x);\n        }\n"
             (php-field-name)
             (ref number)))
           ("bytes"
