      orig-name
      svc
      orig-name
      resp))
    ((client-streaming)
     (format
      (string-append
       "class _~a~aServerImpl implements ~a~aServer {\n"
       "  @override\n"
       "  final CallContext context;\n"
       "  final RequestStream _reqs;\n"
       "  ~a? resp;\n\n"
       "  _~a~aServerImpl(this.context, this._reqs);\n\n"
       "  @override\n"
       "  Future<~a> recv() async {\n"
       "    final req = ~a();\n"
       "    await _reqs.recvInto(req);\n"
       "    return req;\n"
       "  }\n\n"
       "  @override\n"
       "  void sendAndClose(~a resp) {\n"
       "    this.resp = resp;\n"
       "  }\n"
       "}\n\n")
      svc
      orig-name
      svc
      orig-name
      resp
      svc
      orig-name
      req
      req
      resp))
    ((bidi)
     (format
      (string-append
       "class _~a~aServerImpl implements ~a~aServer {\n"
       "  @override\n"
       "  final CallContext context;\n"
       "  final RequestStream _reqs;\n"
       "  final ServerSink _sink;\n\n"
       "  _~a~aServerImpl(this.context, this._reqs, this._sink);\n\n"
       "  @override\n"
       "  void send(~a resp) {\n"
       "    _sink(resp.marshalDc());\n"
       "  }\n\n"
       "  @override\n"
       "  Future<~a> recv() async {\n"
       "    final req = ~a();\n"
       "    await _reqs.recvInto(req);\n"
       "    return req;\n"
       "  }\n"
       "}\n\n")
      svc
      orig-name
      svc
      orig-name
      svc
      orig-name
      resp
      req
      req))))

(define (dart-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (lower-first (method-impl-name m)))
  (define req (hash-ref m 'input))
  (define svc (current-service))
  (define kind-const
    (case (hash-ref m 'kind)
      ((unary) "kindUnary")
      ((server-streaming) "kindServerStreaming")
      ((client-streaming) "kindClientStreaming")
      ((bidi) "kindBidi")))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "      Method(~s, ~s, Server.~a,\n"
       "          (ctx, reqs, sink) async {\n"
       "        final req = ~a();\n"
       "        await reqs.recvInto(req);\n"
       "        sink((await impl.~a(ctx, req)).marshalDc());\n"
       "      }),\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "      Method(~s, ~s,\n"
       "          Server.~a, (ctx, reqs, sink) async {\n"
       "        final req = ~a();\n"
       "        await reqs.recvInto(req);\n"
       "        await impl.~a(req, _~a~aServerImpl(ctx, sink));\n"
       "      }),\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name
      svc
      name))
    ((client-streaming)
     (format
      (string-append
       "      Method(~s, ~s,\n"
       "          Server.~a, (ctx, reqs, sink) async {\n"
       "        final stream = _~a~aServerImpl(ctx, reqs);\n"
       "        await impl.~a(stream);\n"
       "        final resp = stream.resp;\n"
       "        if (resp == null) {\n"
       "          throw StatusException(Wire.codeInternal,\n"
       "              'client-streaming handler never called sendAndClose');\n"
       "        }\n"
       "        sink(resp.marshalDc());\n"
       "      }),\n")
      name
      (hash-ref m 'path)
      kind-const
      svc
      name
      impl-name))
    ((bidi)
     (format
      (string-append
       "      Method(~s, ~s, Server.~a,\n"
       "          (ctx, reqs, sink) async {\n"
       "        await impl.~a(_~a~aServerImpl(ctx, reqs, sink));\n"
       "      }),\n")
      name
      (hash-ref m 'path)
      kind-const
      impl-name
      svc
      name))))

(define (dart-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format "/// Client for ~a.\n" (hash-ref svc 'full-name))
    (format "class ~aClient {\n" sname)
    "  final Channel _channel;\n\n"
    (format "  ~aClient(this._channel);\n\n" sname)
    (apply
     string-append
     (map dart-client-method (append methods (alias-client-methods svc))))
    "}\n\n"
    (apply string-append (map dart-client-stream-class methods))
    (apply string-append (map dart-server-stream-iface methods))
    (format
     "/// Service implementation interface for ~a.\n"
     (hash-ref svc 'full-name))
    (format "abstract class ~aServer {\n" sname)
    (apply string-append (map dart-server-iface-method methods))
    "}\n\n"
    (apply string-append (map dart-stream-impl methods)))))

(define (emit-dart-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define class-name (string-append (pascal (string->symbol base)) "GrpcDc"))
  (cons
   (string-append base "_grpc_dc.dart")
   (string-append
    "// @generated by protoc-gen-grpc-dc-dart (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n\n" (hash-ref file-model 'name))
    "import 'dart:async';\n\n"
    "import '../grpcdc/channel.dart';\n"
    "import '../grpcdc/endpoint.dart';\n"
    "import '../grpcdc/server.dart';\n"
    "import '../grpcdc/status.dart';\n"
    "import '../grpcdc/wire.dart';\n"
    (format "import '~a_messages.dart';\n\n" base)
    (apply
     string-append
     (map
      (lambda (svc) (let ((body (dart-service svc))) body))
      (hash-ref file-model 'services)))
    (format
     "/// Generated gRPC-over-DataChannels stubs for ~a.\n"
     (hash-ref file-model 'name))
    (format "class ~a {\n" class-name)
    (apply
     string-append
     (map
      (lambda (svc)
        (define sname (hash-ref svc 'name))
        (string-append
         (format
          "  /// Register an implementation of ~a on a Server.\n"
          (hash-ref svc 'full-name))
         (format
          "  static void register~aServer(Server server, ~aServer impl) {\n"
          sname
          sname)
         (format
          "    server.registerService(ServiceDesc(~s, [\n"
          (hash-ref svc 'full-name))
         (parameterize
          ((current-service sname))
          (apply
           string-append
           (map
            dart-register-method
            (append (hash-ref svc 'methods) (alias-server-methods svc)))))
         "    ]));\n"
         "  }\n"))
      (hash-ref file-model 'services)))
    "}\n")))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map stamp-generated-header (as-file-list (emit-dart-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
