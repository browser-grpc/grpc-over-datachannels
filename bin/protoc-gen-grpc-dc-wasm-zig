(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'extendee
   (string-trim (pb-get-string fields 2 "") ".")
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'default
   (pb-get-string fields 7 #f)
   'oneof-index
   (pb-get fields 9 #f)
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 6))))
    (parse-field-desc (pb-parse f)))
   'oneofs
   (for/list
    ((o (in-list (pb-get-all fields 8))))
    (pb-get-string (pb-parse o) 1))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'syntax
   (let ((s (pb-get-string fields 12 ""))) (if (string=? s "") "proto2" s))
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 7))))
    (parse-field-desc (pb-parse f)))))

(define (merge-extensions files)
  (define exts
    (append
     (append-map (lambda (f) (hash-ref f 'extensions)) files)
     (let loop ((msgs (append-map (lambda (f) (hash-ref f 'messages)) files)))
       (if (null? msgs)
         '()
         (append
          (append-map (lambda (m) (hash-ref m 'extensions)) msgs)
          (loop (append-map (lambda (m) (hash-ref m 'nested)) msgs)))))))
  (define (add-to msg ext)
    (if (equal? (hash-ref msg 'full-name) (hash-ref ext 'extendee))
      (hash-set msg 'fields (append (hash-ref msg 'fields) (list ext)))
      (hash-set
       msg
       'nested
       (map (lambda (n) (add-to n ext)) (hash-ref msg 'nested)))))
  (for/fold
   ((fs files))
   ((ext (in-list exts)))
   (map
    (lambda (f)
      (hash-set
       f
       'messages
       (map (lambda (m) (add-to m ext)) (hash-ref f 'messages))))
    fs)))

(define (oneof-siblings model f)
  (define idx (hash-ref f 'oneof-index #f))
  (if (not idx)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (filter
         (lambda (x)
           (and (not (eq? x f)) (equal? (hash-ref x 'oneof-index #f) idx)))
         (hash-ref (car msgs) 'fields)))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (field-explicit-default f)
  (and (hash-ref f 'default #f)
       (not (= (hash-ref f 'label 1) 3))
       (not (memv (hash-ref f 'type) '(10 11 12)))
       (hash-ref f 'default)))

(define (enum-default-number model f)
  (define types (and (hash-has-key? model 'types) (hash-ref model 'types)))
  (define entry (and types (hash-ref types (hash-ref f 'type-name) #f)))
  (define e (and entry (hash-ref entry 'enum #f)))
  (define v
    (and e
         (findf
          (lambda (x) (equal? (hash-ref x 'name) (hash-ref f 'default)))
          (hash-ref e 'values))))
  (and v (hash-ref v 'number)))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq 'kind 'enum 'msg #f 'enum e 'file file 'pkg pkg))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq 'kind 'enum 'msg #f 'enum e 'file (hash-ref f 'name) 'pkg pkg))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (merge-extensions
     (for/list
      ((f (in-list (pb-get-all fields 15))))
      (parse-file-desc (pb-parse f)))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-ref
      by-name
      w
      (lambda ()
        (error 'parse-request "file_to_generate not in request: ~a" w)))
     'types
     registry))
   parameter))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define current-service (make-parameter ""))

(define (lower-first s)
  (if (zero? (string-length s))
    s
    (string-append (string (char-downcase (string-ref s 0))) (substring s 1))))

(define (wasm-client-method* m)
  (define name (lower-first (hash-ref m 'name)))
  (define orig-name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    pub fn ~a(self: *~aClient, req: *const ~a, ctx: *anyopaque,\n"
       "        callback: *const fn (ctx: *anyopaque, result: CallResult(~a)) void) void {\n"
       "        const alloc = self.bridge.alloc;\n"
       "        const pending = alloc.create(~aUnaryPending) catch {\n"
       "            callback(ctx, .{ .status = oomStatus() });\n"
       "            return;\n"
       "        };\n"
       "        pending.* = .{ .alloc = alloc, .ctx = ctx, .callback = callback };\n"
       "        const payload = req.marshalDc(alloc);\n"
       "        self.bridge.unary(~s, payload, pending, ~aUnaryPending.complete);\n"
       "        alloc.free(payload);\n"
       "    }\n\n")
      name
      svc
      req
      resp
      orig-name
      path
      orig-name))
    ((server-streaming)
     (format
      (string-append
       "    pub fn ~a(self: *~aClient, req: *const ~a, ctx: *anyopaque,\n"
       "        on_message: *const fn (ctx: *anyopaque, resp: ~a) void,\n"
       "        on_done: *const fn (ctx: *anyopaque, status: Status) void) void {\n"
       "        const alloc = self.bridge.alloc;\n"
       "        const pending = alloc.create(~aStreamPending) catch {\n"
       "            on_done(ctx, oomStatus());\n"
       "            return;\n"
       "        };\n"
       "        pending.* = .{ .alloc = alloc, .ctx = ctx, .on_message = on_message, .on_done = on_done };\n"
       "        const payload = req.marshalDc(alloc);\n"
       "        self.bridge.serverStream(~s, payload, pending, ~aStreamPending.message, ~aStreamPending.done);\n"
       "        alloc.free(payload);\n"
       "    }\n\n")
      name
      svc
      req
      resp
      orig-name
      path
      orig-name
      orig-name))
    ((client-streaming)
     (format
      (string-append
       "    pub fn ~a(self: *~aClient, reqs: []const ~a, ctx: *anyopaque,\n"
       "        callback: *const fn (ctx: *anyopaque, result: CallResult(~a)) void) void {\n"
       "        const alloc = self.bridge.alloc;\n"
       "        const pending = alloc.create(~aUnaryPending) catch {\n"
       "            callback(ctx, .{ .status = oomStatus() });\n"
       "            return;\n"
       "        };\n"
       "        pending.* = .{ .alloc = alloc, .ctx = ctx, .callback = callback };\n"
       "        const payloads = marshalAll(~a, reqs, alloc);\n"
       "        self.bridge.clientStream(~s, payloads, pending, ~aUnaryPending.complete);\n"
       "        freeAll(payloads, alloc);\n"
       "    }\n\n")
      name
      svc
      req
      resp
      orig-name
      req
      path
      orig-name))
    ((bidi)
     (format
      (string-append
       "    pub fn ~a(self: *~aClient, reqs: []const ~a, ctx: *anyopaque,\n"
       "        on_message: *const fn (ctx: *anyopaque, resp: ~a) void,\n"
       "        on_done: *const fn (ctx: *anyopaque, status: Status) void) void {\n"
       "        const alloc = self.bridge.alloc;\n"
       "        const pending = alloc.create(~aStreamPending) catch {\n"
       "            on_done(ctx, oomStatus());\n"
       "            return;\n"
       "        };\n"
       "        pending.* = .{ .alloc = alloc, .ctx = ctx, .on_message = on_message, .on_done = on_done };\n"
       "        const payloads = marshalAll(~a, reqs, alloc);\n"
       "        self.bridge.bidi(~s, payloads, pending, ~aStreamPending.message, ~aStreamPending.done);\n"
       "        freeAll(payloads, alloc);\n"
       "    }\n\n")
      name
      svc
      req
      resp
      orig-name
      req
      path
      orig-name
      orig-name))))

(define (wasm-pending-structs m)
  (define orig-name (hash-ref m 'name))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary client-streaming)
     (format
      (string-append
       "const ~aUnaryPending = struct {\n"
       "    alloc: std.mem.Allocator,\n"
       "    ctx: *anyopaque,\n"
       "    callback: *const fn (ctx: *anyopaque, result: CallResult(~a)) void,\n\n"
       "    fn complete(raw: *anyopaque, st: Status, payload: ?[]const u8) void {\n"
       "        const self: *@This() = @ptrCast(@alignCast(raw));\n"
       "        defer self.alloc.destroy(self);\n"
       "        if (!st.isOk()) {\n"
       "            self.callback(self.ctx, .{ .status = st });\n"
       "            return;\n"
       "        }\n"
       "        var resp = ~a{};\n"
       "        resp.unmarshalDc(self.alloc, payload orelse \"\");\n"
       "        self.callback(self.ctx, .{ .ok = resp });\n"
       "    }\n"
       "};\n\n")
      orig-name
      resp
      resp))
    ((server-streaming bidi)
     (format
      (string-append
       "const ~aStreamPending = struct {\n"
       "    alloc: std.mem.Allocator,\n"
       "    ctx: *anyopaque,\n"
       "    on_message: *const fn (ctx: *anyopaque, resp: ~a) void,\n"
       "    on_done: *const fn (ctx: *anyopaque, status: Status) void,\n\n"
       "    fn message(raw: *anyopaque, payload: []const u8) void {\n"
       "        const self: *@This() = @ptrCast(@alignCast(raw));\n"
       "        var resp = ~a{};\n"
       "        resp.unmarshalDc(self.alloc, payload);\n"
       "        self.on_message(self.ctx, resp);\n"
       "    }\n\n"
       "    fn done(raw: *anyopaque, st: Status, _: ?[]const u8) void {\n"
       "        const self: *@This() = @ptrCast(@alignCast(raw));\n"
       "        defer self.alloc.destroy(self);\n"
       "        self.on_done(self.ctx, st);\n"
       "    }\n"
       "};\n\n")
      orig-name
      resp
      resp))))

(define (wasm-server-serve-export m)
  (define name (lower-first (hash-ref m 'name)))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "export fn serve_~a(call_id: u32, payload_ptr: [*]const u8, payload_len: usize, md_ptr: [*]const u8, md_len: usize) void {\n"
       "    const a = bridge_mod.bridgeAllocator();\n"
       "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(md);\n"
       "    var req = ~a{};\n"
       "    req.unmarshalDc(a, payload_ptr[0..payload_len]);\n"
       "    switch (g_server_impl.?.~a_fn(g_server_impl.?.ctx, &req, md)) {\n"
       "        .ok => |resp| { const bytes = resp.marshalDc(a); defer a.free(bytes); bridge_mod.serverRespond(call_id, bytes); },\n"
       "        .status => |st| bridge_mod.serverFail(call_id, st),\n"
       "    }\n"
       "}\n\n")
      name
      req
      name))
    ((server-streaming)
     (format
      (string-append
       "export fn serve_~a(call_id: u32, payload_ptr: [*]const u8, payload_len: usize, md_ptr: [*]const u8, md_len: usize) void {\n"
       "    const a = bridge_mod.bridgeAllocator();\n"
       "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(md);\n"
       "    var req = ~a{};\n"
       "    req.unmarshalDc(a, payload_ptr[0..payload_len]);\n"
       "    var sink = ServerSink{ .call_id = call_id };\n"
       "    const st = g_server_impl.?.~a_fn(g_server_impl.?.ctx, &req, md, &sink);\n"
       "    if (st.isOk()) bridge_mod.serverComplete(call_id) else bridge_mod.serverFail(call_id, st);\n"
       "}\n\n")
      name
      req
      name))
    ((client-streaming)
     (format
      (string-append
       "export fn serve_~a(call_id: u32, payload_ptr: [*]const u8, payload_len: usize, md_ptr: [*]const u8, md_len: usize) void {\n"
       "    const a = bridge_mod.bridgeAllocator();\n"
       "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(md);\n"
       "    const chunks = bridge_mod.unpack(a, payload_ptr[0..payload_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(chunks);\n"
       "    const reqs = a.alloc(~a, chunks.len) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(reqs);\n"
       "    for (chunks, 0..) |chunk, i| { reqs[i] = ~a{}; reqs[i].unmarshalDc(a, chunk); }\n"
       "    switch (g_server_impl.?.~a_fn(g_server_impl.?.ctx, reqs, md)) {\n"
       "        .ok => |resp| { const bytes = resp.marshalDc(a); defer a.free(bytes); bridge_mod.serverRespond(call_id, bytes); },\n"
       "        .status => |st| bridge_mod.serverFail(call_id, st),\n"
       "    }\n"
       "}\n\n")
      name
      req
      req
      name))
    ((bidi)
     (format
      (string-append
       "export fn serve_~a(call_id: u32, payload_ptr: [*]const u8, payload_len: usize, md_ptr: [*]const u8, md_len: usize) void {\n"
       "    const a = bridge_mod.bridgeAllocator();\n"
       "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(md);\n"
       "    const chunks = bridge_mod.unpack(a, payload_ptr[0..payload_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(chunks);\n"
       "    const reqs = a.alloc(~a, chunks.len) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
       "    defer a.free(reqs);\n"
       "    for (chunks, 0..) |chunk, i| { reqs[i] = ~a{}; reqs[i].unmarshalDc(a, chunk); }\n"
       "    var sink = ServerSink{ .call_id = call_id };\n"
       "    const st = g_server_impl.?.~a_fn(g_server_impl.?.ctx, reqs, md, &sink);\n"
       "    if (st.isOk()) bridge_mod.serverComplete(call_id) else bridge_mod.serverFail(call_id, st);\n"
       "}\n\n")
      name
      req
      req
      name))))

(define (wasm-server-iface-field m)
  (define name (lower-first (hash-ref m 'name)))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "    ~a_fn: *const fn (ctx: *anyopaque, req: *const ~a, md: []const bridge_mod.MdPair) CallResult(~a),\n"
      name
      req
      resp))
    ((server-streaming)
     (format
      "    ~a_fn: *const fn (ctx: *anyopaque, req: *const ~a, md: []const bridge_mod.MdPair, sink: *ServerSink) Status,\n"
      name
      req))
    ((client-streaming)
     (format
      "    ~a_fn: *const fn (ctx: *anyopaque, reqs: []const ~a, md: []const bridge_mod.MdPair) CallResult(~a),\n"
      name
      req
      resp))
    ((bidi)
     (format
      "    ~a_fn: *const fn (ctx: *anyopaque, reqs: []const ~a, md: []const bridge_mod.MdPair, sink: *ServerSink) Status,\n"
      name
      req))))

(define (wasm-stream-iface-field m)
  (define name (lower-first (hash-ref m 'name)))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       "    ~aBegin_fn: *const fn (ctx: *anyopaque, call_id: u32, md: []const bridge_mod.MdPair) void,\n"
       name)
      (format
       "    ~aRequest_fn: *const fn (ctx: *anyopaque, call_id: u32, req: *const ~a) void,\n"
       name
       req)
      (format
       "    ~aEnd_fn: *const fn (ctx: *anyopaque, call_id: u32) CallResult(~a),\n"
       name
       resp)))
    ((bidi)
     (string-append
      (format
       "    ~aBegin_fn: *const fn (ctx: *anyopaque, call_id: u32, md: []const bridge_mod.MdPair) void,\n"
       name)
      (format
       "    ~aRequest_fn: *const fn (ctx: *anyopaque, call_id: u32, req: *const ~a, sink: *ServerSink) Status,\n"
       name
       req)
      (format
       "    ~aEnd_fn: *const fn (ctx: *anyopaque, call_id: u32) Status,\n"
       name)))
    (else "")))

(define (wasm-stream-feed-export m)
  (define name (lower-first (hash-ref m 'name)))
  (define req (hash-ref m 'input))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (string-append
      (format
       (string-append
        "export fn serve_~aStart(call_id: u32, md_ptr: [*]const u8, md_len: usize) void {\n"
        "    const a = bridge_mod.bridgeAllocator();\n"
        "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
        "    defer a.free(md);\n"
        "    g_stream_impl.?.~aBegin_fn(g_stream_impl.?.ctx, call_id, md);\n"
        "}\n\n")
       name
       name)
      (format
       (string-append
        "export fn serve_~aFeed(call_id: u32, payload_ptr: [*]const u8, payload_len: usize) void {\n"
        "    const a = bridge_mod.bridgeAllocator();\n"
        "    var req = ~a{};\n"
        "    req.unmarshalDc(a, payload_ptr[0..payload_len]);\n"
        "    g_stream_impl.?.~aRequest_fn(g_stream_impl.?.ctx, call_id, &req);\n"
        "}\n\n")
       name
       req
       name)
      (format
       (string-append
        "export fn serve_~aEnd(call_id: u32) void {\n"
        "    const a = bridge_mod.bridgeAllocator();\n"
        "    switch (g_stream_impl.?.~aEnd_fn(g_stream_impl.?.ctx, call_id)) {\n"
        "        .ok => |resp| { const bytes = resp.marshalDc(a); defer a.free(bytes); bridge_mod.serverRespond(call_id, bytes); },\n"
        "        .status => |st| bridge_mod.serverFail(call_id, st),\n"
        "    }\n"
        "}\n\n")
       name
       name)))
    ((bidi)
     (string-append
      (format
       (string-append
        "export fn serve_~aStart(call_id: u32, md_ptr: [*]const u8, md_len: usize) void {\n"
        "    const a = bridge_mod.bridgeAllocator();\n"
        "    const md = bridge_mod.decodeMetadata(a, md_ptr[0..md_len]) catch { bridge_mod.serverFail(call_id, oomStatus()); return; };\n"
        "    defer a.free(md);\n"
        "    g_stream_impl.?.~aBegin_fn(g_stream_impl.?.ctx, call_id, md);\n"
        "}\n\n")
       name
       name)
      (format
       (string-append
        "export fn serve_~aFeed(call_id: u32, payload_ptr: [*]const u8, payload_len: usize) void {\n"
        "    const a = bridge_mod.bridgeAllocator();\n"
        "    var req = ~a{};\n"
        "    req.unmarshalDc(a, payload_ptr[0..payload_len]);\n"
        "    var sink = ServerSink{ .call_id = call_id };\n"
        "    const st = g_stream_impl.?.~aRequest_fn(g_stream_impl.?.ctx, call_id, &req, &sink);\n"
        "    if (!st.isOk()) bridge_mod.serverFail(call_id, st);\n"
        "}\n\n")
       name
       req
       name)
      (format
       (string-append
        "export fn serve_~aEnd(call_id: u32) void {\n"
        "    const st = g_stream_impl.?.~aEnd_fn(g_stream_impl.?.ctx, call_id);\n"
        "    if (st.isOk()) bridge_mod.serverComplete(call_id) else bridge_mod.serverFail(call_id, st);\n"
        "}\n\n")
       name
       name)))
    (else "")))

(define (wasm-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (apply string-append (map wasm-pending-structs methods))
    (format
     "/// Client for the service (browser/WASM facade; see module doc).\npub const ~aClient = struct {\n    bridge: *bridge_mod.Bridge,\n\n    pub fn init(bridge: *bridge_mod.Bridge) ~aClient {\n        return .{ .bridge = bridge };\n    }\n\n"
     sname
     sname)
    (apply string-append (map wasm-client-method* methods))
    "};\n\n"
    "/// Streaming response sink for server handlers.\n"
    "pub const ServerSink = struct {\n"
    "    call_id: u32,\n\n"
    "    pub fn send(self: *ServerSink, resp: anytype) Status {\n"
    "        const a = bridge_mod.bridgeAllocator();\n"
    "        const bytes = resp.marshalDc(a);\n"
    "        defer a.free(bytes);\n"
    "        bridge_mod.serverSend(self.call_id, bytes);\n"
    "        return Status.ok();\n"
    "    }\n"
    "};\n\n"
    (format
     "/// Service implementation for ~a (browser/WASM facade).\n"
     (hash-ref svc 'full-name))
    (format "pub const ~aServer = struct {\n    ctx: *anyopaque,\n" sname)
    (apply string-append (map wasm-server-iface-field methods))
    "};\n\n"
    (format "var g_server_impl: ?*~aServer = null;\n\n" sname)
    (format
     "/// Register the service implementation used by the serve_* exports.\n")
    (format
     "pub fn register~aServer(impl: *~aServer) void {\n    g_server_impl = impl;\n}\n\n"
     sname
     sname)
    (apply string-append (map wasm-server-serve-export methods))
    (format
     "/// Incremental service implementation for ~a: requests arrive one at a time via serve_*Start/Feed/End.\n"
     (hash-ref svc 'full-name))
    (format
     "pub const ~aStreamServer = struct {\n    ctx: *anyopaque,\n"
     sname)
    (apply string-append (map wasm-stream-iface-field methods))
    "};\n\n"
    (format "var g_stream_impl: ?*~aStreamServer = null;\n\n" sname)
    (format
     "/// Register the incremental implementation used by the serve_*Start/Feed/End exports.\n")
    (format
     "pub fn register~aStreamServer(impl: *~aStreamServer) void {\n    g_stream_impl = impl;\n}\n\n"
     sname
     sname)
    (apply string-append (map wasm-stream-feed-export methods)))))

(define (wasm-zig-message-names file-model)
  (remove-duplicates
   (append-map
    (lambda (svc)
      (append-map
       (lambda (m) (list (hash-ref m 'input) (hash-ref m 'output)))
       (hash-ref svc 'methods)))
    (hash-ref file-model 'services))))

(define (emit-wasm-zig-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define messages-import (hash-ref params 'messages_import "echo_messages"))
  (define status-import (hash-ref params 'status_import "grpcdc_status"))
  (cons
   (string-append base "_wasm_dc.zig")
   (string-append
    "// @generated by protoc-gen-grpc-dc-wasm-zig (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n\n" (hash-ref file-model 'name))
    "const std = @import(\"std\");\n"
    "const bridge_mod = @import(\"bridge.zig\");\n"
    (format "const status_mod = @import(~s);\n" status-import)
    (format "const messages = @import(~s);\n\n" messages-import)
    "pub const Status = status_mod.Status;\n"
    "pub const CallResult = status_mod.CallResult;\n"
    (apply
     string-append
     (for/list
      ((msg (in-list (wasm-zig-message-names file-model))))
      (format "pub const ~a = messages.~a;\n" msg msg)))
    "\n"
    "fn oomStatus() Status {\n"
    "    // gRPC INTERNAL (13): a request could not be marshaled.\n"
    "    return Status.init(13, \"out of memory\");\n"
    "}\n\n"
    "fn marshalAll(comptime T: type, reqs: []const T, alloc: std.mem.Allocator) [][]u8 {\n"
    "    const out = alloc.alloc([]u8, reqs.len) catch return &.{};\n"
    "    for (reqs, 0..) |*req, i| out[i] = req.marshalDc(alloc);\n"
    "    return out;\n"
    "}\n\n"
    "fn freeAll(payloads: [][]u8, alloc: std.mem.Allocator) void {\n"
    "    for (payloads) |p| alloc.free(p);\n"
    "    if (payloads.len > 0) alloc.free(payloads);\n"
    "}\n\n"
    (apply string-append (map wasm-service (hash-ref file-model 'services))))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map
        stamp-generated-header
        (as-file-list (emit-wasm-zig-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
