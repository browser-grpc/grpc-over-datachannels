(define go-pb-encode-singular-program
  '((case-on
     (category)
     (("varint"
       (if (proto2)
         (then
          (fmt "~aout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~aout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0))))
         (else
          (fmt
           "~aif ~a {\n"
           (arg 1)
           (if (type-is 8) (then (arg 0)) (else (fmt "~a != 0" (arg 0)))))
          (fmt "~a\tout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~a\tout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0)))
          (fmt "~a}\n" (arg 1))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~aout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0))))
        (else
         (fmt "~aif ~a != 0 {\n" (arg 1) (arg 0))
         (fmt
          "~a\tout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~a\tout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0)))
         (fmt "~a}\n" (arg 1)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, []byte(~a))\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aout = appendStringField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif len(~a) > 0 {\n~a\tout = appendBytesField(out, ~a, ~a)\n~a}\n"
          (arg 1)
          (arg 0)
          (arg 1)
          (ref number)
          (arg 0)
          (arg 1)))))
     ("message"
      (fmt
       "~aif ~a != nil {\n~a\tout = appendBytesField(out, ~a, ~a.MarshalDC())\n~a}\n"
       (arg 1)
       (arg 0)
       (arg 1)
       (ref number)
       (arg 0)
       (arg 1)))
     (else (fail)))))

(define go-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "\t{\n\t\tkeys := make([]~a, 0, len(~a))\n\t\tfor k := range ~a { keys = append(keys, k) }\n\t\tsort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\n\t\tfor _, k := range keys {\n\t\t\tout = appendBytesField(out, ~a, ~a(k, ~a[k]))\n\t\t}\n\t}\n"
        (field-type-of (with-label (key-field (resolved-entry)) 1))
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (ref number)
        (fmt "encode~a" (entry-type))
        (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = appendVarint(payload, ~a)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbVarintExpr "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("fixed"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = append(payload, ~a...)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedEncode "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("string"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, []byte(x))\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("bytes"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x)\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("message"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x.MarshalDC())\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            (else (fail)))))
         (else
          (call goPbEncodeSingular (fmt "m.~a" (pascal (ref name))) "\t")))))))

(define go-pb-decode-singular-program
  '((case-on
     (category)
     (("varint"
       (fmt
        "~a~a = ~a\n"
        (arg 2)
        (arg 0)
        (if (type-is 14)
          (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode (arg 1))))
          (else (call goPbVarintDecode (arg 1))))))
      ("fixed"
       (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call goPbFixedDecode (arg 1))))
      ("string" (fmt "~a~a = string(~a)\n" (arg 2) (arg 0) (arg 1)))
      ("bytes"
       (fmt "~a~a = append([]byte(nil), ~a...)\n" (arg 2) (arg 0) (arg 1)))
      ("message"
       (fmt "~atmp~a := new(~a)\n" (arg 2) (ref number) (entry-type))
       (fmt
        "~aif err := tmp~a.UnmarshalDC(~a); err != nil {\n~a\t~a\n~a}\n"
        (arg 2)
        (ref number)
        (arg 1)
        (arg 2)
        (err-stmt)
        (arg 2))
       (fmt "~a~a = tmp~a\n" (arg 2) (arg 0) (ref number)))
      (else (fail))))))

(define go-pb-decode-case-program
  '((fmt "\t\tcase ~a:\n" (ref number))
    (if (is-map)
      (then
       "\t\t\tif b, ok := value.([]byte); ok {\n"
       (fmt "\t\t\t\tk, val, err := ~a(b)\n" (fmt "decode~a" (entry-type)))
       "\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n"
       (fmt
        "\t\t\t\tif ~a == nil {\n\t\t\t\t\t~a = make(~a)\n\t\t\t\t}\n"
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (field-type))
       (fmt "\t\t\t\t~a[k] = val\n\t\t\t}\n" (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             "\t\t\tswitch value := value.(type) {\n"
             "\t\t\tcase uint64:\n"
             (fmt
              "\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then
                 (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "value")))
                (else (call goPbVarintDecode "value"))))
             "\t\t\tcase []byte:\n"
             "\t\t\t\tsub := &pbReader{buf: value}\n"
             "\t\t\t\tfor sub.pos < len(sub.buf) {\n"
             "\t\t\t\t\tv, err := sub.varint()\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n"
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "v")))
                (else (call goPbVarintDecode "v"))))
             "\t\t\t\t}\n\t\t\t}\n")
            ("fixed"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt "\t\t\t\tif len(b) == ~a {\n" (fixed-size))
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode "b"))
             "\t\t\t\t} else {\n"
             (fmt
              "\t\t\t\t\tfor off := 0; off+~a <= len(b); off += ~a {\n"
              (fixed-size)
              (fixed-size))
             (fmt
              "\t\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode (fmt "b[off:off+~a]" (fixed-size))))
             "\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n")
            ("string"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, string(b))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("bytes"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, append([]byte(nil), b...))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("message"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt
              "\t\t\t\tvar tmpv ~a\n"
              (field-type-of (with-label (self) 1)))
             (call goPbDecodeSingular "tmpv" "b" "\t\t\t\t")
             (fmt
              "\t\t\t\t~a = append(~a, tmpv)\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            (else (fail)))))
         (else
          (oneof-clearing)
          (if (is-varint)
            (then
             (fmt
              "\t\t\tif v, ok := value.(uint64); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "v"
               "\t\t\t\t")))
            (else
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "b"
               "\t\t\t\t"))))))))))

(define go-pb-encode-field-guarded-program '((guarded (call goPbEncodeField))))

(define go-pb-map-helpers-program
  '((fmt
     "func encode~a(key ~a, value ~a) []byte {\n\tvar out []byte\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (call-on (key-field) goPbEncodeSingular "key" "\t")
    (call-on (val-field) goPbEncodeSingular "value" "\t")
    "\treturn out\n}\n\n"
    (fmt
     "func decode~a(data []byte) (~a, ~a, error) {\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (fmt
     "\tvar key ~a\n\tvar value ~a\n"
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    "\tr := &pbReader{buf: data}\n\tfor {\n\t\tnum, _, value0, _, done, err := r.field()\n\t\tif err != nil {\n\t\t\treturn key, value, err\n\t\t}\n\t\tif done {\n\t\t\treturn key, value, nil\n\t\t}\n\t\tswitch num {\n"
    (fmt "\t\tcase ~a:\n" (get (key-field) number))
    (case-on
     (category-of (key-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "b" "\t\t\t\t")))))
    (fmt "\t\tcase ~a:\n" (get (val-field) number))
    (case-on
     (category-of (val-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "b" "\t\t\t\t")))))
    "\t\t}\n\t}\n}\n\n"))

(define go-pb-enum-program
  '((fmt "type ~a int32\n\nconst (\n" (arg 0))
    (each
     enum
     values
     (fmt "\t~a_~a ~a = ~a\n" (arg 0) (ref name) (arg 0) (ref number)))
    ")\n\n"))

(define go-pb-default-literal-program
  '((if (has-default)
      (then
       (case-on
        (type)
        ((9 (fmt "~s" (default-raw)))
         (14 (fmt "~a(~a)" (entry-type) (enum-default-num)))
         (else (default-raw)))))
      (else))))

(define go-pb-constructor-program
  '((if (any-default)
      (then
       (fmt
        "// New~a returns a ~a with the descriptor's explicit (proto2)\n// default values applied.\n"
        (flat)
        (flat))
       (fmt "func New~a() *~a {\n\treturn &~a{\n" (flat) (flat) (flat))
       (each
        fields
        (when (has-default)
          (fmt "\t~a: ~a,\n" (pascal (ref name)) (call goPbDefaultLiteral))))
       "\t}\n}\n\n")
      (else))))

(define go-pb-message-program
  '((fmt "type ~a struct {\n" (flat))
    (each fields (fmt "\t~a ~a\n" (pascal (ref name)) (field-type)))
    "\tUnknownFields []byte\n}\n\n"
    (call goPbConstructor)
    (fmt "func (m *~a) MarshalDC() []byte {\n\tvar out []byte\n" (flat))
    (each fields (call goPbEncodeFieldGuarded))
    "\tout = append(out, m.UnknownFields...)\n\treturn out\n}\n\n"
    (fmt "func (m *~a) UnmarshalDC(data []byte) error {\n" (flat))
    "\tm.UnknownFields = nil\n\tr := &pbReader{buf: data}\n\tfor {\n"
    (if (no-fields)
      (then "\t\tnum, _, _, raw, done, err := r.field()\n")
      (else "\t\tnum, _, value, raw, done, err := r.field()\n"))
    "\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif done {\n\t\t\treturn nil\n\t\t}\n\t\tswitch num {\n"
    (each fields (call goPbDecodeCase))
    "\t\tdefault:\n\t\t\tm.UnknownFields = append(m.UnknownFields, raw...)\n\t\t}\n\t}\n}\n\n"))

(define segment-programs
  (hasheq
   'goRegisterMethod
   go-register-method-program
   'goDeprecated
   go-deprecated-program
   'goClientMethod
   go-client-method-program
   'goServerIfaceMethod
   go-server-iface-method-program
   'goServerIfaceMethodDeprecated
   go-server-iface-method-deprecated-program
   'goStreamIfaces
   go-stream-ifaces-program
   'goStreamImpls
   go-stream-impls-program
   'goService
   go-service-program
   'goPbVarintExpr
   go-pb-varint-expr-program
   'goPbVarintDecode
   go-pb-varint-decode-program
   'goPbFixedEncode
   go-pb-fixed-encode-program
   'goPbFixedDecode
   go-pb-fixed-decode-program
   'goPbZero
   go-pb-zero-program
   'goPbEncodeSingular
   go-pb-encode-singular-program
   'goPbEncodeField
   go-pb-encode-field-program
   'goPbDecodeSingular
   go-pb-decode-singular-program
   'goPbDecodeCase
   go-pb-decode-case-program
   'goPbEncodeFieldGuarded
   go-pb-encode-field-guarded-program
   'goPbMapHelpers
   go-pb-map-helpers-program
   'goPbEnum
   go-pb-enum-program
   'goPbDefaultLiteral
   go-pb-default-literal-program
   'goPbConstructor
   go-pb-constructor-program
   'goPbMessage
   go-pb-message-program))

(define (seg-ref node key)
  (if (eq? key 'impl-name)
    (hash-ref node 'impl-name (hash-ref node 'name))
    (hash-ref node key #f)))

(define (run-segments
         program
         node
         svc
         (model #f)
         (args '())
         (err "return err"))
  (run-env program (list model node svc args err)))

(define (run-env program env)
  (apply
   string-append
   (for/list ((seg (in-list program))) (run-segment seg env))))

(define (env-model env) (first env))

(define (env-node env) (second env))

(define (env-svc env) (third env))

(define (env-args env) (fourth env))

(define (env-err env) (fifth env))

(define (env-with
         env
         #:model
         (model (env-model env))
         #:node
         (node (env-node env))
         #:args
         (args (env-args env))
         #:err
         (err (env-err env)))
  (list model node (env-svc env) args err))

(define (seg-truthy? v) (not (or (not v) (equal? v "") (equal? v 0))))

(define (seg-pascal s)
  (string-join
   (map
    (lambda (part)
      (if (string=? part "")
        ""
        (string-append
         (string (char-upcase (string-ref part 0)))
         (substring part 1))))
    (string-split s "_"))
   ""))

(define (seg-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (seg-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'run-segments "unresolved type ~a" type-name))))

(define (seg-entry-type entry)
  (seg-flat
   (hash-ref entry 'pkg)
   (if (eq? (hash-ref entry 'kind) 'enum)
     (hash-ref entry 'full)
     (hash-ref (hash-ref entry 'msg) 'full-name))))

(define (seg-entry-type-of model node)
  (if (hash-has-key? node 'type-name)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name)))
    (seg-entry-type node)))

(define (seg-field-type model f)
  (define type (hash-ref f 'type))
  (define base
    (cond
     ((= type 11)
      (define entry (seg-resolve model (hash-ref f 'type-name)))
      (if (eq? (hash-ref entry 'kind) 'map)
        (let* ((entry-msg (hash-ref entry 'msg))
               (kf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 1))
                 (hash-ref entry-msg 'fields)))
               (vf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 2))
                 (hash-ref entry-msg 'fields))))
          (format
           "map[~a]~a"
           (seg-field-type model (hash-set kf 'label 1))
           (seg-field-type model (hash-set vf 'label 1))))
        (string-append "*" (seg-entry-type entry))))
     ((= type 14) (seg-entry-type (seg-resolve model (hash-ref f 'type-name))))
     (else (scalar-type-entry 'go type))))
  (if (= (hash-ref f 'label) 3)
    (if (and (= type 11)
             (eq?
              (hash-ref (seg-resolve model (hash-ref f 'type-name)) 'kind)
              'map))
      base
      (string-append "[]" base))
    base))

(define (seg-category model node)
  (define type (hash-ref node 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map))
    "map")
   ((= type 11) "message")
   ((memv type varint-scalar-types) "varint")
   ((assv type (fixed-scalar-table 'go)) "fixed")
   ((= type 9) "string")
   ((= type 12) "bytes")
   (else "other")))

(define (seg-fixed-info node)
  (assv (hash-ref node 'type) (fixed-scalar-table 'go)))

(define (seg-zero node)
  (case (hash-ref node 'type)
    ((11 12) "nil")
    ((9) "\"\"")
    ((8) "false")
    (else "0")))

(define (seg-set-expr sib)
  (define v (format "m.~a" (seg-pascal (hash-ref sib 'name))))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a != nil" v))
    ((9) (format "~a != \"\"" v))
    ((12) (format "len(~a) > 0" v))
    ((8) v)
    (else (format "~a != 0" v))))

(define (seg-oneof-clearing model node)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "\t\t\tm.~a = ~a\n"
       (seg-pascal (hash-ref sib 'name))
       (seg-zero sib)))
    (oneof-siblings model node))))

(define (seg-later-oneof-cond model node)
  (define later (oneof-later-siblings model node))
  (if (null? later) "" (string-join (map seg-set-expr later) " || ")))

(define (seg-eval seg env)
  (define node (env-node env))
  (define model (env-model env))
  (cond
   ((string? seg) seg)
   ((number? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply format (second seg) (map (lambda (e) (seg-eval e env)) (cddr seg))))
   ((eq? (car seg) 'ref)
    (if (null? (cddr seg))
      (seg-ref node (second seg))
      (foldl (lambda (k acc) (hash-ref acc k)) node (cdr seg))))
   ((eq? (car seg) 'svc) (env-svc env))
   ((eq? (car seg) 'arg) (list-ref (env-args env) (second seg)))
   ((eq? (car seg) 'err-stmt) (env-err env))
   ((eq? (car seg) 'self) node)
   ((memq (car seg) '(if case-on when guarded kind-case))
    (run-segment seg env))
   ((eq? (car seg) 'pascal) (seg-pascal (seg-eval (second seg) env)))
   ((eq? (car seg) 'flat)
    (seg-flat (hash-ref model 'package) (hash-ref node 'full-name)))
   ((eq? (car seg) 'entry-type) (seg-entry-type-of model node))
   ((eq? (car seg) 'field-type) (seg-field-type model node))
   ((eq? (car seg) 'field-type-of)
    (seg-field-type model (seg-eval (second seg) env)))
   ((eq? (car seg) 'resolved-entry)
    (seg-resolve model (hash-ref node 'type-name)))
   ((eq? (car seg) 'key-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 1))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'val-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 2))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'with-label)
    (hash-set (seg-eval (second seg) env) 'label (third seg)))
   ((eq? (car seg) 'get) (hash-ref (seg-eval (second seg) env) (third seg)))
   ((eq? (car seg) 'fixed-name) (third (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-size) (second (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-wire) (if (= (second (seg-fixed-info node)) 8) 1 5))
   ((eq? (car seg) 'type) (hash-ref node 'type))
   ((eq? (car seg) 'category) (seg-category model node))
   ((eq? (car seg) 'category-of)
    (seg-category model (seg-eval (second seg) env)))
   ((eq? (car seg) 'proto2) (equal? (hash-ref model 'syntax "") "proto2"))
   ((eq? (car seg) 'type-is) (= (hash-ref node 'type) (second seg)))
   ((eq? (car seg) 'is-varint)
    (and (memv (hash-ref node 'type) varint-scalar-types) #t))
   ((eq? (car seg) 'is-fixed) (and (seg-fixed-info node) #t))
   ((eq? (car seg) 'is-map)
    (and (= (hash-ref node 'type) 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map)))
   ((eq? (car seg) 'repeated) (= (hash-ref node 'label) 3))
   ((eq? (car seg) 'has-default) (and (field-explicit-default node) #t))
   ((eq? (car seg) 'any-default)
    (for/or
     ((f (in-list (hash-ref node 'fields))))
     (field-explicit-default f)))
   ((eq? (car seg) 'no-fields) (null? (hash-ref node 'fields)))
   ((eq? (car seg) 'default-raw) (field-explicit-default node))
   ((eq? (car seg) 'enum-default-num) (enum-default-number model node))
   ((eq? (car seg) 'oneof-clearing) (seg-oneof-clearing model node))
   ((eq? (car seg) 'later-oneof-cond) (seg-later-oneof-cond model node))
   ((eq? (car seg) 'call)
    (run-env
     (hash-ref segment-programs (second seg))
     (env-with env #:args (map (lambda (e) (seg-eval e env)) (cddr seg)))))
   ((eq? (car seg) 'call-on)
    (run-env
     (hash-ref segment-programs (third seg))
     (env-with
      env
      #:node
      (seg-eval (second seg) env)
      #:args
      (map (lambda (e) (seg-eval e env)) (cdddr seg)))))
   (else (error 'run-segments "bad expression: ~e" seg))))

(define (run-segment seg env)
  (define node (env-node env))
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'if)
    (define then-segs (cdr (assq 'then (cddr seg))))
    (define else-part (assq 'else (cddr seg)))
    (if (seg-truthy? (seg-eval (second seg) env))
      (run-env then-segs env)
      (if else-part (run-env (cdr else-part) env) "")))
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch (assq kind (cdr seg)))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-env (cdr branch) env))
   ((eq? (car seg) 'case-on)
    (define val (seg-eval (second seg) env))
    (define raw (cddr seg))
    (define (branch-key? b)
      (and (list? b)
           (pair? b)
           (or (number? (car b)) (string? (car b)) (eq? (car b) 'else))))
    (define branches
      (cond
       ((and (= (length raw) 1)
             (list? (car raw))
             (andmap branch-key? (car raw)))
        (car raw))
       (else
        (map
         (lambda (b)
           (if (and (list? b) (= (length b) 1) (list? (car b))) (car b) b))
         raw))))
    (define branch
      (for/first
       ((b (in-list branches))
        #:when
        (or (eq? (car b) 'else) (equal? (car b) val)))
       b))
    (if branch (run-env (cdr branch) env) ""))
   ((eq? (car seg) 'when)
    (if (seg-truthy? (seg-eval (second seg) env)) (run-env (cddr seg) env) ""))
   ((eq? (car seg) 'guarded)
    (define text (run-env (cdr seg) env))
    (define cond-str (seg-later-oneof-cond (env-model env) node))
    (if (equal? cond-str "")
      text
      (string-append
       "\tif !("
       cond-str
       ") {\n"
       (if (string-suffix? text "\n") text (string-append text "\n"))
       "\t}\n")))
   ((eq? (car seg) 'fail)
    (error 'run-segments "unsupported field type ~a" (hash-ref node 'type)))
   ((eq? (car seg) 'each)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items)))
      (run-env segs (env-with env #:node el)))))
   ((eq? (car seg) 'each+)
    (define aliases
      (if (eq? (third seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (apply
     string-append
     (for/list
      ((el (in-list (append (hash-ref node (second seg)) aliases))))
      (run-env (cdddr seg) (env-with env #:node el)))))
   (else (seg-eval seg env))))

(define current-service (make-parameter ""))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "[_.-]"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (csharp-deprecated m indent)
  (if (hash-ref m 'deprecated #f)
    (format "~a[Obsolete(\"deprecated in the proto schema\")]\n" indent)
    ""))

(define (csharp-client-method/raw m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        public ~a ~a(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n"
       "        {\n"
       "            var resp = new ~a();\n"
       "            _channel.Unary(~s, req, resp, metadata, timeout);\n"
       "            return resp;\n"
       "        }\n\n")
      resp
      name
      req
      resp
      path))
    ((server-streaming)
     (format
      (string-append
       "        public ~a~aStream ~a(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n"
       "        {\n"
       "            return new ~a~aStream(_channel.ServerStream(~s, req, metadata, timeout));\n"
       "        }\n\n")
      svc
      name
      name
      req
      svc
      name
      path))
    ((client-streaming)
     (format
      (string-append
       "        public ~a ~a(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n"
       "        {\n"
       "            var resp = new ~a();\n"
       "            _channel.ClientStreamCall(~s, reqs, resp, metadata, timeout);\n"
       "            return resp;\n"
       "        }\n\n")
      resp
      name
      req
      resp
      path))
    ((bidi)
     (format
      (string-append
       "        public ~a~aStream ~a(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n"
       "        {\n"
       "            return new ~a~aStream(_channel.Bidi(~s, reqs, metadata, timeout));\n"
       "        }\n\n")
      svc
      name
      name
      req
      svc
      name
      path))))

(define (csharp-client-method m)
  (string-append
   (csharp-deprecated m "        ")
   (csharp-client-method/raw m)))

(define (csharp-client-stream-class m)
  (define name (hash-ref m 'name))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((server-streaming bidi)
     (format
      (string-append
       "    /// <summary>Receiving stream for ~a.~a: Recv() throws EndOfStreamException at end. Dispose to abandon early (RST).</summary>\n"
       "    public sealed class ~a~aStream : IDisposable\n"
       "    {\n"
       "        private readonly Channel.ClientStream _stream;\n\n"
       "        internal ~a~aStream(Channel.ClientStream stream)\n"
       "        {\n"
       "            _stream = stream;\n"
       "        }\n\n"
       "        public ~a Recv()\n"
       "        {\n"
       "            var resp = new ~a();\n"
       "            _stream.Recv(resp);\n"
       "            return resp;\n"
       "        }\n\n"
       "        /// <summary>Initial metadata (response headers); null until they arrive.</summary>\n"
       "        public Dictionary<string, string> Headers => _stream.Headers?.Metadata;\n\n"
       "        /// <summary>Trailing metadata of the terminal status; null until it arrives.</summary>\n"
       "        public Dictionary<string, string> Trailers => _stream.Trailers;\n\n"
       "        /// <summary>Abort this stream (sends RST, wakes a pending Recv).</summary>\n"
       "        public void Cancel() => _stream.Cancel();\n\n"
       "        /// <summary>Abandon the call if still live (RST); no-op once terminated.</summary>\n"
       "        public void Dispose() => _stream.Dispose();\n"
       "    }\n\n")
      svc
      name
      svc
      name
      svc
      name
      resp
      resp))
    (else "")))

(define (csharp-server-iface-method/raw m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "        ~a ~a(Endpoint.CallContext ctx, ~a req);\n"
      resp
      name
      req))
    ((server-streaming)
     (format
      "        void ~a(~a req, ~a~aServer stream);\n"
      name
      req
      svc
      name))
    ((client-streaming)
     (format "        void ~a(~a~aServer stream);\n" name svc name))
    ((bidi) (format "        void ~a(~a~aServer stream);\n" name svc name))))

(define (csharp-server-iface-method m)
  (string-append
   (csharp-deprecated m "        ")
   (csharp-server-iface-method/raw m)))

(define (csharp-server-stream-ifaces m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary) "")
    ((server-streaming)
     (format
      (string-append
       "    /// <summary>Server-streaming sink passed to service implementations.</summary>\n"
       "    public interface ~a~aServer\n"
       "    {\n"
       "        void Send(~a resp);\n"
       "        Endpoint.CallContext Context { get; }\n"
       "    }\n\n")
      svc
      name
      resp))
    ((client-streaming)
     (format
      (string-append
       "    /// <summary>Client-streaming stream passed to service implementations.</summary>\n"
       "    public interface ~a~aServer\n"
       "    {\n"
       "        ~a Recv();\n"
       "        void SendAndClose(~a resp);\n"
       "        Endpoint.CallContext Context { get; }\n"
       "    }\n\n")
      svc
      name
      req
      resp))
    ((bidi)
     (format
      (string-append
       "    /// <summary>Bidi stream passed to service implementations.</summary>\n"
       "    public interface ~a~aServer\n"
       "    {\n"
       "        void Send(~a resp);\n"
       "        ~a Recv();\n"
       "        Endpoint.CallContext Context { get; }\n"
       "    }\n\n")
      svc
      name
      resp
      req))))

(define (csharp-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define svc (current-service))
  (define kind-const
    (case (hash-ref m 'kind)
      ((unary) "KindUnary")
      ((server-streaming) "KindServerStreaming")
      ((client-streaming) "KindClientStreaming")
      ((bidi) "KindBidi")))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "                new Server.Method(~s, ~s, Server.~a, (ctx, reqs, sink) =>\n"
       "                {\n"
       "                    var req = new ~a();\n"
       "                    reqs.RecvInto(req);\n"
       "                    sink(impl.~a(ctx, req).MarshalDc());\n"
       "                }),\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "                new Server.Method(~s, ~s, Server.~a, (ctx, reqs, sink) =>\n"
       "                {\n"
       "                    var req = new ~a();\n"
       "                    reqs.RecvInto(req);\n"
       "                    impl.~a(req, new ~a~aServerImpl(ctx, sink));\n"
       "                }),\n")
      name
      (hash-ref m 'path)
      kind-const
      req
      impl-name
      svc
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "                new Server.Method(~s, ~s, Server.~a, (ctx, reqs, sink) =>\n"
       "                {\n"
       "                    var stream = new ~a~aServerImpl(ctx, reqs);\n"
       "                    impl.~a(stream);\n"
       "                    if (stream.Resp == null)\n"
       "                    {\n"
       "                        throw new StatusException(Wire.CodeInternal,\n"
       "                            \"client-streaming handler never called SendAndClose\");\n"
       "                    }\n"
       "                    sink(stream.Resp.MarshalDc());\n"
       "                }),\n")
      name
      (hash-ref m 'path)
      kind-const
      svc
      impl-name
      impl-name))
    ((bidi)
     (format
      (string-append
       "                new Server.Method(~s, ~s, Server.~a, (ctx, reqs, sink) =>\n"
       "                {\n"
       "                    impl.~a(new ~a~aServerImpl(ctx, reqs, sink));\n"
       "                }),\n")
      name
      (hash-ref m 'path)
      kind-const
      impl-name
      svc
      impl-name))))

(define (csharp-stream-impls m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary) "")
    ((server-streaming)
     (format
      (string-append
       "    private sealed class ~a~aServerImpl : ~a~aServer\n"
       "    {\n"
       "        private readonly Server.ServerSink _sink;\n\n"
       "        internal ~a~aServerImpl(Endpoint.CallContext ctx, Server.ServerSink sink)\n"
       "        {\n"
       "            Context = ctx;\n"
       "            _sink = sink;\n"
       "        }\n\n"
       "        public Endpoint.CallContext Context { get; }\n\n"
       "        public void Send(~a resp) => _sink(resp.MarshalDc());\n"
       "    }\n\n")
      svc
      name
      svc
      name
      svc
      name
      resp))
    ((client-streaming)
     (format
      (string-append
       "    private sealed class ~a~aServerImpl : ~a~aServer\n"
       "    {\n"
       "        private readonly Server.RequestStream _reqs;\n\n"
       "        internal ~a~aServerImpl(Endpoint.CallContext ctx, Server.RequestStream reqs)\n"
       "        {\n"
       "            Context = ctx;\n"
       "            _reqs = reqs;\n"
       "        }\n\n"
       "        public Endpoint.CallContext Context { get; }\n"
       "        public ~a Resp { get; private set; }\n\n"
       "        public ~a Recv()\n"
       "        {\n"
       "            var req = new ~a();\n"
       "            _reqs.RecvInto(req);\n"
       "            return req;\n"
       "        }\n\n"
       "        public void SendAndClose(~a resp) => Resp = resp;\n"
       "    }\n\n")
      svc
      name
      svc
      name
      svc
      name
      resp
      req
      req
      resp))
    ((bidi)
     (format
      (string-append
       "    private sealed class ~a~aServerImpl : ~a~aServer\n"
       "    {\n"
       "        private readonly Server.RequestStream _reqs;\n"
       "        private readonly Server.ServerSink _sink;\n\n"
       "        internal ~a~aServerImpl(Endpoint.CallContext ctx, Server.RequestStream reqs, Server.ServerSink sink)\n"
       "        {\n"
       "            Context = ctx;\n"
       "            _reqs = reqs;\n"
       "            _sink = sink;\n"
       "        }\n\n"
       "        public Endpoint.CallContext Context { get; }\n\n"
       "        public void Send(~a resp) => _sink(resp.MarshalDc());\n\n"
       "        public ~a Recv()\n"
       "        {\n"
       "            var req = new ~a();\n"
       "            _reqs.RecvInto(req);\n"
       "            return req;\n"
       "        }\n"
       "    }\n\n")
      svc
      name
      svc
      name
      svc
      name
      resp
      req
      req))))

(define (csharp-client-async-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        public Task<~a> ~aAsync(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null,\n"
       "            CancellationToken cancellationToken = default)\n"
       "        {\n"
       "            return AsyncPump.Run(() => ~a(req, metadata, timeout), cancellationToken);\n"
       "        }\n\n")
      resp
      name
      req
      name))
    ((server-streaming)
     (format
      (string-append
       "        public async IAsyncEnumerable<~a> ~aAsync(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null,\n"
       "            [EnumeratorCancellation] CancellationToken cancellationToken = default)\n"
       "        {\n"
       "            var stream = ~a(req, metadata, timeout);\n"
       "            await foreach (var item in AsyncPump.Stream(stream.Recv, stream.Cancel, cancellationToken))\n"
       "            {\n"
       "                yield return item;\n"
       "            }\n"
       "        }\n\n")
      resp
      name
      req
      name))
    ((client-streaming)
     (format
      (string-append
       "        public Task<~a> ~aAsync(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null,\n"
       "            CancellationToken cancellationToken = default)\n"
       "        {\n"
       "            return AsyncPump.Run(() => ~a(reqs, metadata, timeout), cancellationToken);\n"
       "        }\n\n")
      resp
      name
      req
      name))
    ((bidi)
     (format
      (string-append
       "        public async IAsyncEnumerable<~a> ~aAsync(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null,\n"
       "            [EnumeratorCancellation] CancellationToken cancellationToken = default)\n"
       "        {\n"
       "            var stream = ~a(reqs, metadata, timeout);\n"
       "            await foreach (var item in AsyncPump.Stream(stream.Recv, stream.Cancel, cancellationToken))\n"
       "            {\n"
       "                yield return item;\n"
       "            }\n"
       "        }\n\n")
      resp
      name
      req
      name))))

