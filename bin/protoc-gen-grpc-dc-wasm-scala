(define py-pb-decode-case-program
  '((fmt "            ~a num == ~a:\n" (arg 0) (ref number))
    (if (is-map)
      (then
       (fmt
        "                k, val = ~a(value)\n                self.~a[k] = val\n"
        (fmt "_decode_~aEntry" (resolved-flat))
        (ref name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "                if wire == 2:\n                    sub = _Reader(value)\n                    while sub.pos < len(sub.buf):\n                        self.~a.append(~a)\n                else:\n                    self.~a.append(~a)\n"
             (ref name)
             (call pyPbVarintDecode "sub.varint()")
             (ref name)
             (call pyPbVarintDecode "value")))
           ("fixed"
            (fmt
             "                if wire == 2:\n                    for off in range(0, len(value), ~a):\n                        self.~a.append(_struct.unpack(~s, value[off:off + ~a])[0])\n                else:\n                    self.~a.append(_struct.unpack(~s, value)[0])\n"
             (py-fixed-size)
             (ref name)
             (py-fixed-fmt)
             (py-fixed-size)
             (ref name)
             (py-fixed-fmt)))
           ("string"
            (fmt
             "                self.~a.append(value.decode(\"utf-8\"))\n"
             (ref name)))
           ("bytes"
            (fmt "                self.~a.append(bytes(value))\n" (ref name)))
           ("message"
            (call pyPbDecodeSingular "tmp2" "value" "                ")
            (fmt "                self.~a.append(tmp2)\n" (ref name)))
           (else (fail))))
         (else
          (call pyPbOneofClearing)
          (call
           pyPbDecodeSingular
           (fmt "self.~a" (ref name))
           "value"
           "                ")))))))

(define py-pb-map-helpers-program
  '((fmt
     "def _encode_~aEntry(key, value):\n    out = bytearray()\n"
     (entry-flat))
    (call-on (key-field) pyPbEncodeSingular "key" "    ")
    (call-on (val-field) pyPbEncodeSingular "value" "    ")
    "    return bytes(out)\n\n\n"
    (fmt "def _decode_~aEntry(data):\n" (entry-flat))
    (fmt
     "    key = ~a\n    value = ~a\n"
     (call-on (key-field) pyPbDefaultExpr)
     (call-on (val-field) pyPbDefaultExpr))
    "    reader = _Reader(data)\n    while True:\n        item = reader.field()\n        if item is None:\n            return key, value\n        num, wire, raw, _raw_bytes = item\n        if num == 1:\n"
    (call-on (key-field) pyPbDecodeSingular "key" "raw" "            ")
    "        elif num == 2:\n"
    (call-on (val-field) pyPbDecodeSingular "value" "raw" "            ")
    "\n"))

(define py-pb-init-line-program
  '((if (repeated)
      (then
       (fmt
        "        self.~a = ~a(~a) if ~a is not None else ~a\n"
        (ref name)
        (call pyPbDefault)
        (ref name)
        (ref name)
        (case-on (call pyPbDefault) ("dict" "{}") (else "[]"))))
      (else
       (if (type-is 11)
         (then
          (if (is-map)
            (then
             (fmt
              "        self.~a = dict(~a) if ~a is not None else {}\n"
              (ref name)
              (ref name)
              (ref name)))
            (else (fmt "        self.~a = ~a\n" (ref name) (ref name)))))
         (else (fmt "        self.~a = ~a\n" (ref name) (ref name))))))))

(define py-pb-message-program
  '((fmt "class ~a:\n    \"\"\"Message ~a.\"\"\"\n\n" (flat) (ref full-name))
    (fmt
     "    def __init__(self, ~a):\n"
     (each-sep
      ", "
      fields
      (fmt
       "~a=~a"
       (ref name)
       (case-on
        (call pyPbDefault)
        ("list" "None")
        ("dict" "None")
        (else (call pyPbDefault))))))
    (each fields (call pyPbInitLine))
    "        self.unknown_fields = b\"\"\n\n    def marshal_dc(self):\n        out = bytearray()\n"
    (each
     fields
     (guarded-indent
      pyPbSetExpr
      "        if not (~a):\n"
      "    "
      (call pyPbEncodeField)))
    "        out += self.unknown_fields\n        return bytes(out)\n\n    def unmarshal_dc(self, data):\n        self.unknown_fields = b\"\"\n"
    (each
     fields
     (fmt
      "        self.~a = ~a\n"
      (ref name)
      (case-on
       (call pyPbDefault)
       ("list" "[]")
       ("dict" "{}")
       (else (call pyPbDefault)))))
    "        reader = _Reader(data)\n        while True:\n            item = reader.field()\n            if item is None:\n                return self\n            num, wire, value, raw = item\n"
    (each
     fields
     (call pyPbDecodeCase (case-on (index) (0 "if") (else "elif"))))
    (if (no-fields)
      (then "")
      (else
       "            else:\n                self.unknown_fields = self.unknown_fields + raw\n"))
    (fmt
     "\n    def __eq__(self, other):\n        return isinstance(other, ~a) and self.__dict__ == other.__dict__\n"
     (flat))
    (fmt
     "\n    def __repr__(self):\n        return f\"~a(~a)\"\n\n\n"
     (flat)
     (each-sep ", " fields (fmt "~a={self.~a!r}" (ref name) (ref name))))))

(define py-pb-enum-program
  '((fmt "class ~a:\n    \"\"\"Enum ~a.\"\"\"\n" (entry-flat) (ref full))
    (each enum values (fmt "    ~a = ~a\n" (ref name) (ref number)))
    "\n\n"))

