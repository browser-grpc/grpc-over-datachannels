          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aout = _append_string_field(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aout = _append_bytes_field(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))
