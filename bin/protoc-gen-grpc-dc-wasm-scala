       (arg 0))))
    (fmt "    return ~a_writer_to_bytes(&w);\n}\n\n" (arg 0))
    (fmt
     "static inline ~a decode_~a(const uint8_t *data, size_t len) {\n"
     (c-entry-ref)
     (c-entry-ref))
    (fmt "    ~a result; memset(&result, 0, sizeof(result));\n" (c-entry-ref))
    (fmt
     "    result.key = ~a;\n"
     (call-on (with-label (key-field) 1) cPbDefault (arg 0)))
