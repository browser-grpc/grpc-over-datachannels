          (case-on
           (type)
           (15 (fmt "(~a & 0xffffffff)" (arg 0)))
           (else (arg 0)))
          (arg 1)))))
     ("string"
      (if (proto2)
        (then (fmt "~a$w->bytesField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))
