(define dart-client-stream-class-program
  '((kind-case
     ((server-streaming bidi)
      (fmt
       "/// Receiving stream for ~a/~a responses.\nclass ~a~aStream {\n  final ClientStream _stream;\n\n  ~a~aStream(this._stream);\n\n  Future<~a> recv() async {\n    final resp = ~a();\n    await _stream.recv(resp);\n    return resp;\n  }\n\n  /// Initial metadata (response headers); null until they arrive.\n  Map<String, String>? get headers => _stream.headers?.metadata;\n\n  /// Trailing metadata of the terminal status; null until it arrives.\n  Map<String, String>? get trailers => _stream.trailers;\n\n  /// Abort this stream (sends RST, wakes a pending recv).\n  void cancel() => _stream.cancel();\n\n  /// Abandon the call if still live (RST); no-op once terminated.\n  void close() => _stream.close();\n\n  /// Responses as a Dart Stream (native async surface).\n  /// Cancelling the subscription abandons the call:\n  /// RST CANCELLED is sent so the server stops.\n  Stream<~a> get responses {\n    var cancelled = false;\n    late StreamController<~a> controller;\n    controller = StreamController<~a>(\n      onListen: () {\n        () async {\n          try {\n            while (!cancelled) {\n              controller.add(await recv());\n            }\n          } on EndOfStreamError {\n            if (!cancelled) await controller.close();\n          } catch (e, st) {\n            if (!cancelled) {\n              controller.addError(e, st);\n              await controller.close();\n            }\n          }\n        }();\n      },\n      onCancel: () {\n        cancelled = true;\n        _stream.cancel();\n      },\n    );\n    return controller.stream;\n  }\n}\n\n"
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref output)
       (ref output)
       (ref output)
       (ref output)
       (ref output)))
     (else ""))))

