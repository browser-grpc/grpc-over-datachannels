       (ref output))))))

(define py-server-handler-program
  '((kind-case
     (unary
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        req = reqs.recv_into(~a.~a())\n        resp = impl.~a(ctx, req)\n        sink.send(resp.marshal_dc())\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (server-streaming
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        req = reqs.recv_into(~a.~a())\n        impl.~a(req, _SendStream(ctx, sink))\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (client-streaming
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        stream = _ClientStreamImpl(ctx, reqs, ~a.~a)\n        impl.~a(stream)\n        if stream.resp is None:\n            raise grpcdc.StatusError(grpcdc.CODE_INTERNAL, \"client-streaming handler never called SendAndClose\")\n        sink.send(stream.resp.marshal_dc())\n\n"
       (ref name)
       (arg 0)
       (ref input)
       (ref impl-name)))
     (bidi
      (fmt
       "    def _~a_handler(ctx, reqs, sink):\n        impl.~a(_BidiStream(ctx, reqs, sink, ~a.~a))\n\n"
       (ref name)
       (ref impl-name)
       (arg 0)
       (ref input))))))

(define py-method-entry-program
  '((fmt
     "        grpcdc.Method(~s, ~s, grpcdc.~a, _~a_handler),\n"
     (ref name)
     (ref path)
     (kind-case
      (unary "KIND_UNARY")
      (server-streaming "KIND_SERVER_STREAMING")
      (client-streaming "KIND_CLIENT_STREAMING")
      (bidi "KIND_BIDI"))
     (ref name))))

(define py-service-program
  '((fmt
     "class ~aClient:\n    def __init__(self, channel):\n        self._channel = channel\n\n"
     (svc))
    (each+ methods client (call pyClientMethod (arg 0)))
    (fmt
     "class ~aClientAsync:\n    \"\"\"Asyncio client: wrap a grpcdc.AsyncChannel (a sync Channel is wrapped).\"\"\"\n\n    def __init__(self, channel):\n        if isinstance(channel, grpcdc.AsyncChannel):\n            self._channel = channel\n        else:\n            self._channel = grpcdc.AsyncChannel(channel=channel)\n\n"
     (svc))
    (each+ methods client (call pyAsyncClientMethod (arg 0)))
    (fmt "def register_~a_server(server, impl):\n" (snake-case (svc)))
    (each+ methods server (call pyServerHandler (arg 0)))
    (fmt
     "    server.register_service(grpcdc.ServiceDesc(\n        ~s,\n        [\n"
     (ref full-name))
    (each+ methods server (call pyMethodEntry))
    "        ],\n    ))\n"))

