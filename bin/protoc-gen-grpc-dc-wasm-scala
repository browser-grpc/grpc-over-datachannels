     (else (fmt "BigInt(~a)" (arg 0))))))

(define js-pb-varint-decode-program
  '((case-on
     (type)
     ((5 14) (fmt "Number(BigInt.asIntN(32, ~a))" (arg 0)))
     (13 (fmt "Number(BigInt.asUintN(32, ~a))" (arg 0)))
     (3 (fmt "BigInt.asIntN(64, ~a)" (arg 0)))
     (4 (fmt "BigInt.asUintN(64, ~a)" (arg 0)))
