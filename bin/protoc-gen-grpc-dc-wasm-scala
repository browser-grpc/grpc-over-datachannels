      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n                payload = _append_varint(payload, ~a)\n            out = _append_bytes_field(out, ~a, bytes(payload))\n"
             (ref name)
             (ref name)
             (call pyPbVarintExpr "v")
             (ref number)))
           ("fixed"
            (fmt
             "        if self.~a:\n            payload = bytearray()\n            for v in self.~a:\n                payload.extend(_struct.pack(~s, v))\n            out = _append_bytes_field(out, ~a, bytes(payload))\n"
             (ref name)
             (ref name)
             (py-fixed-fmt)
             (ref number)))
           ("string"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.encode(\"utf-8\"))\n"
             (ref name)
             (ref number)))
           ("bytes"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v)\n"
             (ref name)
             (ref number)))
           ("message"
            (fmt
             "        for v in self.~a:\n            out = _append_bytes_field(out, ~a, v.marshal_dc())\n"
             (ref name)
             (ref number)))
           (else (fail))))
         (else
          (call pyPbEncodeSingular (fmt "self.~a" (ref name)) "        ")))))))

(define py-pb-decode-singular-program
