        (arg 0)
        (arg 0)))
      ((18)
       (fmt
        "static_cast<std::uint64_t>((~a << 1) ^ (~a >> 63))"
        (arg 0)
        (arg 0)))
      ((14) (fmt "static_cast<std::int32_t>(~a)" (arg 0)))
      ((5) (fmt "static_cast<std::int64_t>(~a)" (arg 0)))
      (else (fmt "static_cast<std::uint64_t>(~a)" (arg 0)))))))

