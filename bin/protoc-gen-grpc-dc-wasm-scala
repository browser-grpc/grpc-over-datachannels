(define cpp-register-method-program
  (let ((kind-const
         '(case-on
           (ref kind)
           ((unary) "kKindUnary")
           ((server-streaming) "kKindServerStreaming")
           ((client-streaming) "kKindClientStreaming")
           ((bidi) "kKindBidi"))))
    (list
     (list
      'kind-case
      (list
       'unary
       (list
        'fmt
        "            {~s, ~s, grpcdc::Server::~a,\n             [&impl](const grpcdc::Endpoint::CallContext& ctx,\n                     grpcdc::Server::RequestStream& reqs,\n                     grpcdc::Server::ServerSink& sink) {\n               ~a req;\n               reqs.RecvInto(req);\n               auto mutable_ctx = const_cast<grpcdc::Endpoint::CallContext&>(ctx);\n               ~a resp = impl.~a(mutable_ctx, req);\n               sink(resp.MarshalDc());\n             }},\n"
        '(ref name)
        '(ref path)
        kind-const
        '(cpp-stub-type 'input-full)
        '(cpp-stub-type 'output-full)
        '(ref impl-name)))
      (list
       'server-streaming
       (list
        'fmt
        "            {~s, ~s,\n             grpcdc::Server::~a,\n             [&impl](const grpcdc::Endpoint::CallContext& ctx,\n                     grpcdc::Server::RequestStream& reqs,\n                     grpcdc::Server::ServerSink& sink) {\n               ~a req;\n               reqs.RecvInto(req);\n               ~a~aServerImpl stream(\n                   const_cast<grpcdc::Endpoint::CallContext&>(ctx), sink);\n               impl.~a(req, stream);\n             }},\n"
        '(ref name)
        '(ref path)
        kind-const
        '(cpp-stub-type 'input-full)
        '(svc)
        '(ref name)
        '(ref impl-name)))
      (list
       'client-streaming
       (list
        'fmt
        "            {~s, ~s,\n             grpcdc::Server::~a,\n             [&impl](const grpcdc::Endpoint::CallContext& ctx,\n                     grpcdc::Server::RequestStream& reqs,\n                     grpcdc::Server::ServerSink& sink) {\n               ~a~aServerImpl stream(\n                   const_cast<grpcdc::Endpoint::CallContext&>(ctx), reqs);\n               impl.~a(stream);\n               if (!stream.HasResp()) {\n                 throw grpcdc::StatusException(\n                     grpcdc::wire::kCodeInternal,\n                     \"client-streaming handler never called SendAndClose\");\n               }\n               ~a resp = stream.Resp();\n               sink(resp.MarshalDc());\n             }},\n"
        '(ref name)
        '(ref path)
        kind-const
        '(svc)
        '(ref name)
        '(ref impl-name)
        '(cpp-stub-type 'output-full)))
      (list
       'bidi
       (list
        'fmt
        "            {~s, ~s, grpcdc::Server::~a,\n             [&impl](const grpcdc::Endpoint::CallContext& ctx,\n                     grpcdc::Server::RequestStream& reqs,\n                     grpcdc::Server::ServerSink& sink) {\n               ~a~aServerImpl stream(\n                   const_cast<grpcdc::Endpoint::CallContext&>(ctx), reqs, sink);\n               impl.~a(stream);\n             }},\n"
        '(ref name)
        '(ref path)
        kind-const
        '(svc)
        '(ref name)
        '(ref impl-name)))))))

(define cpp-service-program
  '((fmt "  /// Client for ~a.\n" (ref full-name))
    (fmt "  class ~aClient {\n" (ref name))
    "   public:\n"
    (fmt
     "    explicit ~aClient(std::shared_ptr<grpcdc::Channel> channel)\n        : channel_(std::move(channel)) {}\n\n"
     (ref name))
    (each methods (call cppClientStreamClass))
    (each+ methods client (call cppClientMethod "    "))
    "    // -- async (std::future) surface -------------------------------------\n\n"
    (each+ methods client (call cppClientAsyncMethod))
    "   private:\n    std::shared_ptr<grpcdc::Channel> channel_;\n  };\n\n"
    "#if __cplusplus >= 202002L\n"
    (fmt
     "  /// C++20 coroutine client for ~a (co_await / grpcdc::Task).\n"
     (ref full-name))
    (fmt "  class ~aClientCoro {\n" (ref name))
    "   public:\n"
    (fmt
     "    explicit ~aClientCoro(std::shared_ptr<grpcdc::AsyncChannel> channel)\n        : channel_(std::move(channel)) {}\n"
     (ref name))
    (fmt
     "    explicit ~aClientCoro(std::shared_ptr<grpcdc::Channel> channel)\n        : channel_(std::make_shared<grpcdc::AsyncChannel>(std::move(channel))) {}\n\n"
     (ref name))
    (each+ methods client (call cppCoroStreamClass))
    (each+ methods client (call cppCoroMethod))
    "   private:\n    std::shared_ptr<grpcdc::AsyncChannel> channel_;\n  };\n"
    "#endif  // __cplusplus >= 202002L\n\n"
    (each methods (call cppServerStreamIface))
    (fmt "  /// Service implementation interface for ~a.\n" (ref full-name))
    (fmt
     "  struct ~aServer {\n    virtual ~~~aServer() = default;\n"
     (ref name)
     (ref name))
    (each methods (call cppServerIfaceMethod "    "))
    "  };\n\n"
    (fmt
     "  /// Async service implementation interface for ~a.\n"
     (ref full-name))
    (fmt
     "  struct ~aServerAsync {\n    virtual ~~~aServerAsync() = default;\n"
     (ref name)
     (ref name))
    (each methods (call cppServerAsyncIfaceMethod))
    "  };\n\n"
    " private:\n"
    (each methods (call cppStreamImpl))
    (fmt
     "  class ~aServerAsyncAdapter : public ~aServer {\n"
     (ref name)
     (ref name))
    (fmt
     "   public:\n    explicit ~aServerAsyncAdapter(~aServerAsync* impl) : impl_(impl) {}\n"
     (ref name)
     (ref name))
    (each methods (call cppServerAsyncAdapterMethod))
    (fmt "\n   private:\n    ~aServerAsync* impl_;\n  };\n\n" (ref name))
    " public:\n"
    (fmt
     "  /// Register an implementation of ~a on a Server.\n"
     (ref full-name))
    (fmt
     "  static void Register~aServer(grpcdc::Server& server, ~aServer& impl) {\n"
     (ref name)
     (ref name))
    (fmt
     "    server.RegisterService(grpcdc::Server::ServiceDesc{\n        ~s,\n        {\n"
     (ref full-name))
    (each+ methods server (call cppRegisterMethod))
    "        }});\n  }\n\n"
    (fmt
     "  /// Register an async implementation of ~a on a Server.\n"
     (ref full-name))
    (fmt
     "  static void Register~aServerAsync(grpcdc::Server& server,\n                                      ~aServerAsync& impl) {\n"
     (ref name)
     (ref name))
    "    // Adapters are retained for the process lifetime: registration is\n"
    "    // once-per-process and bounded by service count.\n"
    (fmt
     "    static std::vector<std::shared_ptr<~aServerAsyncAdapter>> adapters;\n"
     (ref name))
    (fmt
     "    auto adapter = std::make_shared<~aServerAsyncAdapter>(&impl);\n"
     (ref name))
    "    adapters.push_back(adapter);\n"
    (fmt "    Register~aServer(server, *adapter);\n  }\n" (ref name))))

(define cpp-pb-type-program
  '((if (is-map)
      (then
       (fmt
        "std::map<~a, ~a>"
        (call-on (key-field (resolved-entry)) cppPbType)
        (call-on (val-field (resolved-entry)) cppPbTypeOrRef)))
      (else
       (if (repeated)
         (then
          (fmt
           "std::vector<~a>"
           (case-on
            (ref type)
            ((11) (cpp-entry-ref))
            (else (call-on (with-label (self) 1) cppPbType)))))
         (else
          (case-on
           (ref type)
           ((11) (fmt "std::optional<~a>" (cpp-entry-ref)))
           ((14) (cpp-entry-ref))
           (else (cpp-scalar-type)))))))))

(define cpp-pb-type-or-ref-program
  '((if (is-map)
      (then (call cppPbType))
      (else
       (case-on (ref type) ((11) (cpp-entry-ref)) (else (call cppPbType)))))))

(define cpp-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt "~a::~a" (cpp-entry-ref) (default-raw)))
         ((2) (fmt "~a" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define cpp-pb-default-program
  '((if (call cppPbExplicitLiteral)
      (then (call cppPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then "{}")
          (else
           (case-on
            (ref label)
            ((3) "{}")
            (else
             (case-on
              (ref type)
              ((11) "std::nullopt")
              ((14) (fmt "~a::~a" (cpp-entry-ref) (enum-first-value-name)))
              (else (cpp-scalar-zero))))))))))))

