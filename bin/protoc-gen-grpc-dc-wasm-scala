(define py-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "        if self.~a:\n            for k, val in self.~a.items():\n                out = _append_bytes_field(out, ~a, ~a(k, val))\n"
        (ref name)
        (ref name)
        (ref number)
