(define kt-pb-map-helpers-program
  '((fmt
     "    fun ~aEncode(key: ~a, value: ~a): ByteArray {\n"
     (kt-map-name)
     (call-on (key-field) ktPbType)
     (call-on (val-field) ktPbTypeOrRef))
    "        val w = Writer()\n"
    (call-on (key-field) ktPbEncodeSingular "key" "        ")
    (call-on (val-field) ktPbMapValEncode)
    "        return w.toBytes()\n    }\n\n"
    (fmt
     "    fun ~aDecode(bytes: ByteArray): Pair<~a, ~a> {\n"
     (kt-map-name)
     (call-on (key-field) ktPbType)
     (call-on (val-field) ktPbTypeOrRef))
    (fmt
     "        var key: ~a = ~a\n"
     (call-on (key-field) ktPbType)
     (call-on (key-field) ktPbDefault))
    (fmt
     "        var value: ~a = ~a\n"
     (call-on (val-field) ktPbTypeOrRef)
     (call-on (val-field) ktPbMapValInit))
    "        val r = Reader(bytes)\n        while (true) {\n            val field = r.next() ?: break\n            when (field.number) {\n"
    (call-on (key-field) ktPbMapKeyDecode (arg 0))
    (call-on (val-field) ktPbMapValDecode (arg 0))
    "                else -> {}\n            }\n        }\n        return Pair(key, value)\n    }\n\n"))

(define kt-pb-nested-enum-program
  '((fmt "~aenum class ~a(val number: Int) {\n" (arg 0) (ref name))
    (each-sep
     ",\n"
     values
     (fmt "~a    ~a(~a)" (arg 0) (ref name) (ref number)))
    (fmt ";\n~a    companion object {\n" (arg 0))
    (fmt "~a        fun fromNumber(number: Int): ~a =\n" (arg 0) (ref name))
    (fmt "~a            when (number) {\n" (arg 0))
    (each
     values
     (fmt "~a                ~a -> ~a\n" (arg 0) (ref number) (ref name)))
    (fmt
     "~a                else -> ~a\n~a            }\n~a    }\n~a}\n"
     (arg 0)
     (first-value-name)
     (arg 0)
     (arg 0)
     (arg 0))))

(define kt-pb-message-program
  '((fmt "~a~a class ~a(\n" (arg 1) (arg 2) (ref name))
    (each-sep
     ",\n"
     fields
     (fmt
      "~a    var ~a: ~a = ~a"
      (arg 1)
      (kt-field-name)
      (call ktPbType)
      (call ktPbDefault)))
    (if (no-fields) (then "") (else ","))
    (fmt "\n~a) : Marshaler, Unmarshaler {\n" (arg 1))
    (fmt "~a    var unknownFields: ByteArray = ByteArray(0)\n" (arg 1))
    (fmt "~a    override fun marshalDc(): ByteArray {\n" (arg 1))
    (fmt "~a        val w = ~a.Writer()\n" (arg 1) (arg 0))
    (each fields (call ktPbEncodeGuard (arg 0)))
    (fmt "~a        w.raw(unknownFields)\n" (arg 1))
    (fmt "~a        return w.toBytes()\n~a    }\n" (arg 1) (arg 1))
    (fmt "~a    override fun unmarshalDc(data: ByteArray) {\n" (arg 1))
    (fmt "~a        unknownFields = ByteArray(0)\n" (arg 1))
    (each
     fields
     (fmt "~a        ~a = ~a\n" (arg 1) (kt-field-name) (call ktPbDefault)))
    (fmt "~a        val r = ~a.Reader(data)\n" (arg 1) (arg 0))
    (fmt "~a        while (true) {\n" (arg 1))
    (fmt "~a            val field = r.next() ?: break\n" (arg 1))
    (fmt "~a            when (field.number) {\n" (arg 1))
    (each fields (call ktPbDecodeCase (arg 0)))
    (fmt
     "~a                else -> { unknownFields = unknownFields + field.rawValue }\n~a            }\n~a        }\n~a    }\n"
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1))
    (each nested (call ktPbMessage (arg 0) (fmt "~a    " (arg 1)) ""))
    (each enums (call ktPbNestedEnum (fmt "~a    " (arg 1))))
    (fmt "~a}\n" (arg 1))))

(define cs-deprecated-program
  '((if (ref deprecated)
      (then (fmt "~a[Obsolete(\"deprecated in the proto schema\")]\n" (arg 0)))
      (else ""))))

(define cs-client-method-raw-program
  '((kind-case
     (unary
      (fmt
       "        public ~a ~a(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n        {\n            var resp = new ~a();\n            _channel.Unary(~s, req, resp, metadata, timeout);\n            return resp;\n        }\n\n"
       (ref output)
       (ref name)
       (ref input)
       (ref output)
       (ref path)))
     (server-streaming
      (fmt
       "        public ~a~aStream ~a(~a req, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n        {\n            return new ~a~aStream(_channel.ServerStream(~s, req, metadata, timeout));\n        }\n\n"
       (svc)
       (ref name)
       (ref name)
       (ref input)
       (svc)
       (ref name)
       (ref path)))
     (client-streaming
      (fmt
       "        public ~a ~a(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n        {\n            var resp = new ~a();\n            _channel.ClientStreamCall(~s, reqs, resp, metadata, timeout);\n            return resp;\n        }\n\n"
       (ref output)
       (ref name)
       (ref input)
       (ref output)
       (ref path)))
     (bidi
      (fmt
       "        public ~a~aStream ~a(IEnumerable<~a> reqs, IDictionary<string, string> metadata = null, TimeSpan? timeout = null)\n        {\n            return new ~a~aStream(_channel.Bidi(~s, reqs, metadata, timeout));\n        }\n\n"
       (svc)
       (ref name)
       (ref name)
       (ref input)
       (svc)
       (ref name)
       (ref path))))))

