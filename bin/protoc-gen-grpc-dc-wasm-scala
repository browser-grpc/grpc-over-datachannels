(define cs-service-program
  '((fmt "    /// <summary>Client for ~a.</summary>\n" (ref full-name))
    (fmt "    public sealed class ~aClient\n    {\n" (ref name))
    "        private readonly Channel _channel;\n\n"
    (fmt
     "        public ~aClient(Channel channel)\n        {\n            _channel = channel;\n        }\n\n"
     (ref name))
    (each+ methods client (call csClientMethod "        "))
    (each+ methods client (call csClientAsyncMethod))
    "    }\n\n"
    (each methods (call csClientStreamClass))
    (fmt
     "    /// <summary>Service implementation interface for ~a.</summary>\n"
     (ref full-name))
    (fmt "    public interface ~aServer\n    {\n" (ref name))
    (each methods (call csServerIfaceMethod "        "))
    "    }\n\n"
    (each methods (call csServerStreamIfaces))
    (each methods (call csStreamImpls))
    (fmt
     "    /// <summary>Async service implementation interface for ~a.</summary>\n"
     (ref full-name))
    (fmt "    public interface ~aServerAsync\n    {\n" (ref name))
    (each methods (call csServerAsyncIfaceMethod))
    "    }\n\n"
    (fmt
     "    private sealed class ~aServerAsyncAdapter : ~aServer\n    {\n"
     (ref name)
     (ref name))
    (fmt "        private readonly ~aServerAsync _impl;\n\n" (ref name))
    (fmt
     "        internal ~aServerAsyncAdapter(~aServerAsync impl)\n        {\n            _impl = impl;\n        }\n\n"
     (ref name)
     (ref name))
    (each methods (call csServerAsyncAdapterMethod))
    "    }\n\n"
    (fmt
     "    /// <summary>Register an implementation of ~a on a Server.</summary>\n"
     (ref full-name))
    (fmt
     "    public static void Register~aServer(Server server, ~aServer impl)\n    {\n"
     (ref name)
     (ref name))
    (fmt
     "        server.RegisterService(new Server.ServiceDesc(\n            ~s,\n            new List<Server.Method>\n            {\n"
     (ref full-name))
    (each+ methods server (call csRegisterMethod))
    "            }));\n    }\n"
    (fmt
     "    /// <summary>Register an async implementation of ~a on a Server.</summary>\n"
     (ref full-name))
    (fmt
     "    public static void Register~aServerAsync(Server server, ~aServerAsync impl)\n    {\n"
     (ref name)
     (ref name))
    (fmt
     "        Register~aServer(server, new ~aServerAsyncAdapter(impl));\n    }\n"
     (ref name)
     (ref name))))

(define cs-pb-type-program
  '((if (is-map)
      (then
       (fmt
        "System.Collections.Generic.Dictionary<~a, ~a>"
        (call-on (key-field (resolved-entry)) csPbType)
        (call-on (val-field (resolved-entry)) csPbType)))
      (else
       (if (repeated)
         (then
          (fmt
           "System.Collections.Generic.List<~a>"
           (call-on (with-label (self) 1) csPbType)))
         (else
          (case-on
           (ref type)
           ((11) (cs-entry-ref))
           ((14) (cs-entry-ref))
           (else (cs-scalar-type)))))))))

(define cs-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt "~a.~a" (cs-entry-ref) (default-raw)))
         ((2) (fmt "~af" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define cs-pb-default-program
  '((if (call csPbExplicitLiteral)
      (then (call csPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then (fmt "new ~a()" (call csPbType)))
          (else
           (case-on
            (ref label)
            ((3) (fmt "new ~a()" (call csPbType)))
            (else
             (case-on
              (ref type)
              ((11) "null")
              ((14) (fmt "~a.~a" (cs-entry-ref) (enum-first-value-name)))
              (else (cs-scalar-zero))))))))))))

