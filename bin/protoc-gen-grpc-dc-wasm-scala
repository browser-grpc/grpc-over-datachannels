(define kotlin-register-method-program
  '((kind-case
     (unary
      (fmt
       "                    Server.Method(~s, ~s, Server.KIND_UNARY) { ctx, reqs, sink ->\n                        val req = ~a()\n                        reqs.recvInto(req)\n                        sink.send(impl.~a(ctx, req).marshalDc())\n                    },\n"
       (ref name)
       (ref path)
       (ref input)
       (ref impl-name)))
     (server-streaming
      (fmt
       "                    Server.Method(~s, ~s, Server.KIND_SERVER_STREAMING) { ctx, reqs, sink ->\n                        val req = ~a()\n                        reqs.recvInto(req)\n                        impl.~a(req, ~a~aServerImpl(ctx, sink))\n                    },\n"
       (ref name)
       (ref path)
       (ref input)
       (ref impl-name)
       (svc)
       (ref name)))
     (client-streaming
      (fmt
       "                    Server.Method(~s, ~s, Server.KIND_CLIENT_STREAMING) { ctx, reqs, sink ->\n                        val stream = ~a~aServerImpl(ctx, reqs)\n                        impl.~a(stream)\n                        val resp = stream.resp\n                            ?: throw StatusException(\n                                Wire.CODE_INTERNAL,\n                                \"client-streaming handler never called sendAndClose\"\n                            )\n                        sink.send(resp.marshalDc())\n                    },\n"
       (ref name)
       (ref path)
       (svc)
       (ref name)
       (ref impl-name)))
     (bidi
      (fmt
       "                    Server.Method(~s, ~s, Server.KIND_BIDI) { ctx, reqs, sink ->\n                        impl.~a(~a~aServerImpl(ctx, reqs, sink))\n                    },\n"
       (ref name)
       (ref path)
       (ref impl-name)
       (svc)
       (ref name))))))

(define kotlin-service-program
  '((fmt "    /** Client for ~a. */\n" (ref full-name))
    (fmt "    class ~aClient(private val channel: Channel) {\n" (ref name))
    (each methods (call kotlinClientStreamClass))
    (each+ methods client (call kotlinClientMethod "        "))
    (if (kotlin-wasm-mode)
      (then "")
      (else
       "        // -- async (coroutine / CompletableFuture) surface ---------------\n\n"
       (each+ methods client (call kotlinClientAsyncMethod))))
    "    }\n\n"
    (each methods (call kotlinServerStreamIface))
    (fmt
     "    /** Service implementation interface for ~a. */\n"
     (ref full-name))
    (fmt "    interface ~aServer {\n" (ref name))
    (each methods (call kotlinServerIfaceMethod "        "))
    "    }\n\n"
    (if (kotlin-wasm-mode)
      (then "")
      (else
       (fmt
        "    /** Async service implementation interface for ~a. */\n"
        (ref full-name))
       (fmt "    interface ~aServerAsync {\n" (ref name))
       (each methods (call kotlinServerAsyncIfaceMethod))
       "    }\n\n"))
    (each methods (call kotlinStreamImpl))
    (if (kotlin-wasm-mode)
      (then "")
      (else
       (fmt
        "    private class ~aServerAsyncAdapter(private val impl: ~aServerAsync) : ~aServer {\n"
        (ref name)
        (ref name)
        (ref name))
       (each methods (call kotlinServerAsyncAdapterMethod))
       "    }\n\n"))
    (fmt
     "    /** Register an implementation of ~a on a Server. */\n"
     (ref full-name))
    (fmt
     "    fun register~aServer(server: Server, impl: ~aServer) {\n"
     (ref name)
     (ref name))
    "        server.registerService(\n"
    "            Server.ServiceDesc(\n"
    (fmt "                ~s,\n" (ref full-name))
    "                listOf(\n"
    (trim-suffix ",\n" "\n" (each+ methods server (call kotlinRegisterMethod)))
    "                )\n"
    "            )\n"
    "        )\n"
    "    }\n\n"
    (if (kotlin-wasm-mode)
      (then "")
      (else
       (fmt
        "    /** Register an async implementation of ~a on a Server. */\n"
        (ref full-name))
       (fmt
        "    fun register~aServerAsync(server: Server, impl: ~aServerAsync) {\n"
        (ref name)
        (ref name))
       "        // Adapters are retained for the process lifetime: registration is\n"
       "        // once-per-process and bounded by service count.\n"
       (fmt "        val adapter = ~aServerAsyncAdapter(impl)\n" (ref name))
       (fmt "        ~aAdapters.add(adapter)\n" (lower-first (svc)))
       (fmt "        register~aServer(server, adapter)\n    }\n\n" (ref name))
       (fmt
        "    private val ~aAdapters = ArrayList<~aServerAsyncAdapter>()\n"
        (lower-first (svc))
        (ref name))))))

(define kt-pb-type-program
  '((if (is-map)
      (then
       (fmt
        "MutableMap<~a, ~a>"
        (call-on (key-field (resolved-entry)) ktPbType)
        (call-on (val-field (resolved-entry)) ktPbTypeOrRef)))
      (else
       (if (repeated)
         (then
          (fmt
           "MutableList<~a>"
           (case-on
            (ref type)
            ((11) (kt-entry-ref))
            (else (call-on (with-label (self) 1) ktPbType)))))
         (else
          (case-on
           (ref type)
           ((11) (fmt "~a?" (kt-entry-ref)))
           ((14) (kt-entry-ref))
           (else (kt-scalar-type)))))))))

(define kt-pb-type-or-ref-program
  '((if (is-map)
      (then (call ktPbType))
      (else
       (case-on (ref type) ((11) (kt-entry-ref)) (else (call ktPbType)))))))

(define kt-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt "~a.~a" (kt-entry-ref) (default-raw)))
         ((2) (fmt "~af" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define kt-pb-default-program
  '((if (call ktPbExplicitLiteral)
      (then (call ktPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then "mutableMapOf()")
          (else
           (case-on
            (ref label)
            ((3) "mutableListOf()")
            (else
             (case-on
              (ref type)
              ((11) "null")
              ((14) (fmt "~a.~a" (kt-entry-ref) (enum-first-value-name)))
              (else (kt-scalar-zero))))))))))))

(define kt-pb-varint-expr-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((8) (fmt "if (~a) 1L else 0L" (arg 0)))
      ((17)
       (fmt
        "(((~a shl 1) xor (~a shr 31)).toLong() and 0xffffffffL)"
        (arg 0)
        (arg 0)))
      ((18) (fmt "((~a shl 1) xor (~a shr 63))" (arg 0) (arg 0)))
      ((14) (fmt "~a.number.toLong()" (arg 0)))
      ((5) (fmt "~a.toLong()" (arg 0)))
      ((13 7) (fmt "~a.toLong()" (arg 0)))
      ((3) (arg 0))
      (else (fmt "~a.toLong()" (arg 0)))))))

(define kt-pb-varint-decode-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((5) (fmt "~a.toInt()" (arg 0)))
      ((13 7) (fmt "~a.toUInt()" (arg 0)))
      ((3) (arg 0))
      ((4 6) (fmt "~a.toULong()" (arg 0)))
      ((8) (fmt "~a != 0L" (arg 0)))
      ((17) (fmt "(((~a shr 1) xor -(~a and 1L)).toInt())" (arg 0) (arg 0)))
      ((18) (fmt "((~a shr 1) xor -(~a and 1L))" (arg 0) (arg 0)))))))

(define kt-pb-nonzero-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((8) (arg 0))
      ((14) (fmt "~a.number != 0" (arg 0)))
      (else (fmt "~a != ~a" (arg 0) (kt-scalar-zero)))))))

(define kt-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, 0); w.varint(~a) }\n"
          (arg 1)
          (ref number)
          (call ktPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, 0); w.varint(~a) }\n"
          (arg 1)
          (call ktPbNonzero (arg 0))
          (ref number)
          (call ktPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, ~a); w.fixed~a(~a) }\n"
          (arg 1)
          (ref number)
          (case-on (kt-fixed-size) ((8) "1") (else "5"))
          (kt-fixed-name)
          (arg 0)))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, ~a); w.fixed~a(~a) }\n"
          (arg 1)
          (call ktPbNonzero (arg 0))
          (ref number)
          (case-on (kt-fixed-size) ((8) "1") (else "5"))
          (kt-fixed-name)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aw.bytesField(~a, ~a.toByteArray(Charsets.UTF_8))\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else (fmt "~aw.stringField(~a, ~a)\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw.bytesField(~a, ~a)\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif (~a.isNotEmpty()) w.bytesField(~a, ~a)\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~a~a?.let { w.bytesField(~a, it.marshalDc()) }\n"
       (arg 1)
       (arg 0)
       (ref number)))
     (else (fail)))))

(define kt-pb-set-expr-program
  '((case-on
     (ref type)
     ((11 10) (fmt "~a != null" (kt-field-name)))
     ((9 12) (fmt "~a.isNotEmpty()" (kt-field-name)))
     (else (call ktPbNonzero (kt-field-name))))))

(define kt-pb-encode-guard-program
  '((guarded
     ktPbSetExpr
     "        if (!(~a)) {\n"
     "        }\n"
     (call ktPbEncodeField (arg 0)))))

(define kt-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "        for (e in ~a) w.bytesField(~a, ~a.~aEncode(e.key, e.value))\n"
        (kt-field-name)
        (ref number)
        (arg 0)
        (kt-map-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt "        if (~a.isNotEmpty()) {\n" (kt-field-name))
            (fmt "            val payload = ~a.Writer()\n" (arg 0))
            (fmt
             "            for (x in ~a) payload.varint(~a)\n"
             (kt-field-name)
             (call ktPbVarintExpr "x"))
            (fmt
             "            w.bytesField(~a, payload.toBytes())\n        }\n"
             (ref number)))
           ("fixed"
            (fmt "        if (~a.isNotEmpty()) {\n" (kt-field-name))
            (fmt "            val payload = ~a.Writer()\n" (arg 0))
            (fmt
             "            for (x in ~a) payload.fixed~a(x)\n"
             (kt-field-name)
             (kt-fixed-name))
            (fmt
             "            w.bytesField(~a, payload.toBytes())\n        }\n"
             (ref number)))
           ("string"
            (fmt
             "        for (x in ~a) w.bytesField(~a, x.toByteArray(Charsets.UTF_8))\n"
             (kt-field-name)
             (ref number)))
           ("bytes"
            (fmt
             "        for (x in ~a) w.bytesField(~a, x)\n"
             (kt-field-name)
             (ref number)))
           ("message"
            (fmt
             "        for (x in ~a) w.bytesField(~a, x.marshalDc())\n"
             (kt-field-name)
             (ref number)))
           (else (fail))))
         (else (call ktPbEncodeSingular (kt-field-name) "        ")))))))

(define kt-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt
       "~a~a = ~a\n"
       (arg 2)
       (arg 0)
       (case-on
        (ref type)
        ((14)
         (fmt
          "~a.fromNumber(~a)"
          (kt-entry-ref)
          (call-on (with-type (self) 5) ktPbVarintDecode (arg 1))))
        (else (call ktPbVarintDecode (arg 1))))))
     ("fixed"
      (fmt
       "~a~a = ~a\n"
       (arg 2)
       (arg 0)
       (case-on
        (ref type)
        ((2) (fmt "~a.bitsToFloat(~a.toUInt())" (arg 3) (arg 1)))
        ((1) (fmt "~a.bitsToDouble(~a.toULong())" (arg 3) (arg 1)))
        ((7) (fmt "~a.toUInt()" (arg 1)))
        ((15) (fmt "~a.toInt()" (arg 1)))
        ((6) (fmt "~a.toULong()" (arg 1)))
        (else (arg 1)))))
     ("string"
      (fmt "~a~a = String(~a, Charsets.UTF_8)\n" (arg 2) (arg 0) (arg 1)))
     ("bytes" (fmt "~a~a = ~a\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt "~a~a = ~a()\n" (arg 2) (arg 0) (kt-entry-ref))
      (fmt "~a~a!!.unmarshalDc(~a)\n" (arg 2) (arg 0) (arg 1)))
     (else (fail)))))

(define kt-pb-clearing-program
  '((each-siblings
     (fmt
      "                    ~a = ~a\n"
      (kt-field-name)
      (call ktPbDefault)))))

(define kt-pb-enum-conv-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((14)
       (fmt
        "~a.fromNumber(~a)"
        (kt-entry-ref)
        (call-on (with-type (self) 5) ktPbVarintDecode (arg 0))))
      (else (call ktPbVarintDecode (arg 0)))))))

(define kt-pb-decode-case-program
  '((fmt "                ~a -> {\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "                    val kv = ~a.~aDecode(field.bytesValue)\n"
        (arg 0)
        (kt-map-name))
       (fmt "                    ~a[kv.first] = kv.second\n" (kt-field-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            "                    if (field.wire == 2) {\n"
            (fmt
             "                        val sub = ~a.Reader(field.bytesValue)\n"
             (arg 0))
            "                        while (!sub.done()) {\n"
            (fmt
             "                            ~a.add(~a)\n"
             (kt-field-name)
             (call ktPbEnumConv "sub.varint()"))
            "                        }\n                    } else {\n"
            (fmt
             "                        ~a.add(~a)\n"
             (kt-field-name)
             (call ktPbEnumConv "field.varintValue"))
            "                    }\n")
           ("fixed"
            "                    if (field.wire == 2) {\n"
            (fmt
             "                        val sub = ~a.Reader(field.bytesValue)\n"
             (arg 0))
            (fmt
             "                        while (!sub.done()) ~a.add(~a)\n"
             (kt-field-name)
             (case-on
              (ref type)
              ((2) (fmt "~a.bitsToFloat(sub.fixed32())" (arg 0)))
              ((1) (fmt "~a.bitsToDouble(sub.fixed64())" (arg 0)))
              ((7) "sub.fixed32()")
              ((15) "sub.fixed32().toInt()")
              (else "sub.fixed64()")))
            "                    } else {\n"
            (fmt
             "                        ~a.add(~a)\n"
             (kt-field-name)
             (case-on
              (ref type)
              ((2) (fmt "~a.bitsToFloat(field.fixedValue.toUInt())" (arg 0)))
              ((1) (fmt "~a.bitsToDouble(field.fixedValue.toULong())" (arg 0)))
              ((7) "field.fixedValue.toUInt()")
              ((15) "field.fixedValue.toInt()")
              ((6) "field.fixedValue.toULong()")
              (else "field.fixedValue")))
            "                    }\n")
           ("string"
            (fmt
             "                    ~a.add(String(field.bytesValue, Charsets.UTF_8))\n"
             (kt-field-name)))
           ("bytes"
            (fmt
             "                    ~a.add(field.bytesValue)\n"
             (kt-field-name)))
           ("message"
            (fmt "                    val item = ~a()\n" (kt-entry-ref))
            "                    item.unmarshalDc(field.bytesValue)\n"
            (fmt "                    ~a.add(item)\n" (kt-field-name)))
           (else (fail))))
         (else
          (call ktPbClearing)
          (call
           ktPbDecodeSingular
           (kt-field-name)
           (case-on
            (category)
            ("varint" "field.varintValue")
            ("fixed" "field.fixedValue")
            (else "field.bytesValue"))
           "                    "
           (arg 0))))))
    "                }\n"))

