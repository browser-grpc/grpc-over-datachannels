(define dt-pb-decode-case-program
  '((fmt "        case ~a:\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "          final kv = ~a(field.bytesValue);\n          ~a[kv.key] = kv.value;\n          break;\n"
        (fmt "~a~aDecode" (arg 0) (resolved-flat))
        (dart-field-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "          if (field.wire == 2) {\n            final sub = ~aReader(field.bytesValue);\n            while (!sub.done()) {\n              ~a.add(~a);\n            }\n          } else {\n            ~a.add(~a);\n          }\n          break;\n"
             (arg 0)
             (dart-field-name)
             (if (type-is 14)
               (then
                (fmt
                 "~a.values[~a]"
                 (dart-type-ref)
                 (call-on
                  (with-type (self) 5)
                  dtPbVarintDecode
                  "sub.varint()")))
               (else (call dtPbVarintDecode "sub.varint()")))
             (dart-field-name)
             (if (type-is 14)
               (then
                (fmt
                 "~a.values[~a]"
                 (dart-type-ref)
                 (call-on
                  (with-type (self) 5)
                  dtPbVarintDecode
                  "field.varintValue")))
               (else (call dtPbVarintDecode "field.varintValue")))))
           ("fixed"
            (fmt
             "          if (field.wire == 2) {\n            final sub = ~aReader(field.bytesValue);\n            while (!sub.done()) { ~a.add(~a); }\n          } else {\n            ~a.add(~a);\n          }\n          break;\n"
             (arg 0)
             (dart-field-name)
             (case-on
              (type)
              (2 (fmt "~aBitsToFloat32(sub.fixed32())" (arg 0)))
              (1 (fmt "~aBitsToFloat64(sub.fixed64())" (arg 0)))
              (7 "(sub.fixed32()).toUnsigned(32)")
