(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'extendee
   (string-trim (pb-get-string fields 2 "") ".")
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'default
   (pb-get-string fields 7 #f)
   'oneof-index
   (pb-get fields 9 #f)
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 6))))
    (parse-field-desc (pb-parse f)))
   'oneofs
   (for/list
    ((o (in-list (pb-get-all fields 8))))
    (pb-get-string (pb-parse o) 1))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'syntax
   (let ((s (pb-get-string fields 12 ""))) (if (string=? s "") "proto2" s))
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 7))))
    (parse-field-desc (pb-parse f)))))

(define (merge-extensions files)
  (define exts
    (append
     (append-map (lambda (f) (hash-ref f 'extensions)) files)
     (let loop ((msgs (append-map (lambda (f) (hash-ref f 'messages)) files)))
       (if (null? msgs)
         '()
         (append
          (append-map (lambda (m) (hash-ref m 'extensions)) msgs)
          (loop (append-map (lambda (m) (hash-ref m 'nested)) msgs)))))))
  (define (add-to msg ext)
    (if (equal? (hash-ref msg 'full-name) (hash-ref ext 'extendee))
      (hash-set msg 'fields (append (hash-ref msg 'fields) (list ext)))
      (hash-set
       msg
       'nested
       (map (lambda (n) (add-to n ext)) (hash-ref msg 'nested)))))
  (for/fold
   ((fs files))
   ((ext (in-list exts)))
   (map
    (lambda (f)
      (hash-set
       f
       'messages
       (map (lambda (m) (add-to m ext)) (hash-ref f 'messages))))
    fs)))

(define (oneof-siblings model f)
  (define idx (hash-ref f 'oneof-index #f))
  (if (not idx)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (filter
         (lambda (x)
           (and (not (eq? x f)) (equal? (hash-ref x 'oneof-index #f) idx)))
         (hash-ref (car msgs) 'fields)))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (field-explicit-default f)
  (and (hash-ref f 'default #f)
       (not (= (hash-ref f 'label 1) 3))
       (not (memv (hash-ref f 'type) '(10 11 12)))
       (hash-ref f 'default)))

(define (enum-default-number model f)
  (define types (and (hash-has-key? model 'types) (hash-ref model 'types)))
  (define entry (and types (hash-ref types (hash-ref f 'type-name) #f)))
  (define e (and entry (hash-ref entry 'enum #f)))
  (define v
    (and e
         (findf
          (lambda (x) (equal? (hash-ref x 'name) (hash-ref f 'default)))
          (hash-ref e 'values))))
  (and v (hash-ref v 'number)))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq 'kind 'enum 'msg #f 'enum e 'file file 'pkg pkg))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq 'kind 'enum 'msg #f 'enum e 'file (hash-ref f 'name) 'pkg pkg))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (merge-extensions
     (for/list
      ((f (in-list (pb-get-all fields 15))))
      (parse-file-desc (pb-parse f)))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-ref
      by-name
      w
      (lambda ()
        (error 'parse-request "file_to_generate not in request: ~a" w)))
     'types
     registry))
   parameter))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define current-service (make-parameter ""))

(define (wasm-scala-client-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        def ~a(req: ~a): scala.concurrent.Future[~a] = {\n"
       "            bridge.unary(~s, req.marshalDc()).map { bytes =>\n"
       "                val resp = new ~a()\n"
       "                resp.unmarshalDc(bytes)\n"
       "                resp\n"
       "            }\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "        def ~a(req: ~a): ~a = {\n"
       "            new ~a(onMessage =>\n"
       "                bridge.serverStream(~s, req.marshalDc(), onMessage))\n"
       "        }\n\n")
      name
      req
      (client-stream-name svc 'server-streaming resp)
      (client-stream-name svc 'server-streaming resp)
      path))
    ((client-streaming)
     (format
      (string-append
       "        def ~a(reqs: List[~a]): scala.concurrent.Future[~a] = {\n"
       "            bridge.clientStream(~s, reqs.map(_.marshalDc())).map { bytes =>\n"
       "                val resp = new ~a()\n"
       "                resp.unmarshalDc(bytes)\n"
       "                resp\n"
       "            }\n"
       "        }\n\n")
      name
      req
      resp
      path
      resp))
    ((bidi)
     (format
      (string-append
       "        def ~a(reqs: List[~a]): ~a = {\n"
       "            new ~a(onMessage =>\n"
       "                bridge.bidi(~s, reqs.map(_.marshalDc()), onMessage))\n"
       "        }\n\n")
      name
      req
      (client-stream-name svc 'bidi resp)
      (client-stream-name svc 'bidi resp)
      path))))

(define (wasm-scala-server-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "        def ~a(req: ~a, metadata: Map[String, String]): ~a\n"
      name
      req
      resp))
    ((server-streaming)
     (format
      "        def ~a(req: ~a, metadata: Map[String, String], sink: ~a): Unit\n"
      name
      req
      (sink-name svc resp)))
    ((client-streaming)
     (format
      "        def ~a(reqs: List[~a], metadata: Map[String, String]): ~a\n"
      name
      req
      resp))
    ((bidi)
     (format
      "        def ~a(reqs: List[~a], metadata: Map[String, String], sink: ~a): Unit\n"
      name
      req
      (sink-name svc resp)))))

(define (wasm-scala-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        bridge.registerUnary(~s, (payload, metadata) =>\n"
       "            val req = new ~a()\n"
       "            req.unmarshalDc(payload)\n"
       "            impl.~a(req, metadata).marshalDc())\n")
      path
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "        bridge.registerServerStream(~s, (payload, metadata, onMessage) =>\n"
       "            val req = new ~a()\n"
       "            req.unmarshalDc(payload)\n"
       "            impl.~a(req, metadata, resp => onMessage(resp.marshalDc())))\n")
      path
      req
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "        bridge.registerClientStream(~s, (payloads, metadata) =>\n"
       "            val reqs = payloads.map { payload =>\n"
       "                val req = new ~a()\n"
       "                req.unmarshalDc(payload)\n"
       "                req\n"
       "            }\n"
       "            impl.~a(reqs, metadata).marshalDc())\n")
      path
      req
      impl-name))
    ((bidi)
     (format
      (string-append
       "        bridge.registerBidi(~s, (payloads, metadata, onMessage) =>\n"
       "            val reqs = payloads.map { payload =>\n"
       "                val req = new ~a()\n"
       "                req.unmarshalDc(payload)\n"
       "                req\n"
       "            }\n"
       "            impl.~a(reqs, metadata, resp => onMessage(resp.marshalDc())))\n")
      path
      req
      impl-name))))

(define (wasm-scala-stream-iface-method m)
  (define name (hash-ref m 'name))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (format
      "        def ~a(source: ~aSource, metadata: Map[String, String]): scala.concurrent.Future[~a]\n"
      name
      (hash-ref m 'input)
      resp))
    ((bidi)
     (format
      "        def ~a(source: ~aSource, metadata: Map[String, String], sink: ~a => Unit): scala.concurrent.Future[Unit]\n"
      name
      (hash-ref m 'input)
      resp))
    (else "")))

(define (wasm-scala-stream-register-method m)
  (define name (hash-ref m 'name))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((client-streaming)
     (format
      (string-append
       "        bridge.registerClientStreamInc(~s, (source, metadata) =>\n"
       "            impl.~a(new ~aSource(source), metadata).map(_.marshalDc()))\n")
      path
      name
      (hash-ref m 'input)))
    ((bidi)
     (format
      (string-append
       "        bridge.registerBidiInc(~s, (source, metadata, onMessage) =>\n"
       "            impl.~a(new ~aSource(source), metadata, resp => onMessage(resp.marshalDc())))\n")
      path
      name
      (hash-ref m 'input)))
    (else "")))

(define current-methods (make-parameter '()))

(define (stream-outputs)
  (remove-duplicates
   (map
    (lambda (m) (hash-ref m 'output))
    (filter
     (lambda (m) (memq (hash-ref m 'kind) '(server-streaming bidi)))
     (current-methods)))))

(define (kind-outputs kind)
  (remove-duplicates
   (map
    (lambda (m) (hash-ref m 'output))
    (filter (lambda (m) (eq? (hash-ref m 'kind) kind)) (current-methods)))))

(define (recv-name svc out)
  (if (<= (length (stream-outputs)) 1)
    (format "~aRecvStream" svc)
    (format "~a~aRecvStream" svc out)))

(define (sink-name svc out)
  (if (<= (length (stream-outputs)) 1)
    (format "~aServerSink" svc)
    (format "~a~aServerSink" svc out)))

(define (client-stream-name svc kind out)
  (define suffix
    (if (eq? kind 'server-streaming) "ServerStreamStream" "BidiStream"))
  (if (<= (length (kind-outputs kind)) 1)
    (format "~a~a" svc suffix)
    (format "~a~a~a" svc out suffix)))

(define (wasm-scala-recv-stream sname out)
  (string-append
   (format
    "    /** Receiving stream: recv() futures queue in arrival order. */\n")
   (format
    "    class ~a(call: (Array[Byte] => Unit) => scala.concurrent.Future[Unit]) {\n"
    (recv-name sname out))
   "        private val buffer = scala.collection.mutable.Queue[Array[Byte]]()\n"
   "        private var finished = false\n"
   "        private var failure: Throwable = null\n"
   "        private var waiter: scala.concurrent.Promise[Array[Byte]] = null\n"
   "        call { bytes =>\n"
   "            if (waiter != null) {\n"
   "                val w = waiter\n"
   "                waiter = null\n"
   "                w.success(bytes)\n"
   "            } else {\n"
   "                buffer.enqueue(bytes)\n"
   "            }\n"
   "            ()\n"
   "        }.onComplete {\n"
   "            case scala.util.Success(_) =>\n"
   "                finished = true\n"
   "                if (waiter != null) {\n"
   "                    val w = waiter\n"
   "                    waiter = null\n"
   "                    w.failure(new java.io.EOFException(\"call completed\"))\n"
   "                }\n"
   "            case scala.util.Failure(err) =>\n"
   "                failure = err\n"
   "                if (waiter != null) {\n"
   "                    val w = waiter\n"
   "                    waiter = null\n"
   "                    w.failure(err)\n"
   "                }\n"
   "        }\n\n"
   (format "        def recvBytes(): scala.concurrent.Future[~a] = {\n" out)
   (format "            val buffered =\n")
   (format
    "                if (buffer.nonEmpty) scala.concurrent.Future.successful(buffer.dequeue())\n")
   (format
    "                else if (failure != null) scala.concurrent.Future.failed(failure)\n")
   (format
    "                else if (finished) scala.concurrent.Future.failed(new java.io.EOFException(\"call completed\"))\n")
   (format "                else {\n")
   (format
    "                    waiter = scala.concurrent.Promise[Array[Byte]]()\n")
   (format "                    waiter.future\n")
   (format "                }\n")
   (format "            buffered.map { bytes =>\n")
   (format "                val resp = new ~a()\n" out)
   "                resp.unmarshalDc(bytes)\n"
   "                resp\n"
   "            }\n"
   "        }\n"
   "    }\n\n"))

(define (wasm-scala-source typ)
  (string-append
   (format "    /** Typed pull source for incremental server handlers. */\n")
   (format
    "    class ~aSource(private val raw: grpcdcscalajs.GrpcdcRequestSource) {\n"
    typ)
   (format "        def next(): scala.concurrent.Future[Option[~a]] = {\n" typ)
   "            raw.next().map(_.map { bytes =>\n"
   (format "                val req = new ~a()\n" typ)
   "                req.unmarshalDc(bytes)\n"
   "                req\n"
   "            })\n"
   "        }\n"
   "    }\n\n"))

(define (wasm-scala-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (define req (hash-ref (car methods) 'input))
  (define resp (hash-ref (car methods) 'output))
  (define (outs-or-default kind)
    (define os (kind-outputs kind))
    (if (null? os) (list resp) os))
  (define recv-outs
    (let ((os (stream-outputs))) (if (null? os) (list resp) os)))
  (define stream-ins
    (let ((ins
           (remove-duplicates
            (map
             (lambda (m) (hash-ref m 'input))
             (filter
              (lambda (m) (memq (hash-ref m 'kind) '(client-streaming bidi)))
              methods)))))
      (if (null? ins) (list req) ins)))
  (parameterize
   ((current-service sname) (current-methods methods))
   (string-append
    (format
     "    /** Client for ~a (browser/Scala.js facade; see file doc). */\n"
     (hash-ref svc 'full-name))
    (format
     "    class ~aClient(private val bridge: grpcdcscalajs.GrpcdcScalaJsBridge) {\n"
     sname)
    (apply
     string-append
     (for/list
      ((out (in-list (outs-or-default 'server-streaming))))
      (format
       "        class ~a(call: (Array[Byte] => Unit) => scala.concurrent.Future[Unit]) extends ~a(call)\n\n"
       (client-stream-name sname 'server-streaming out)
       (recv-name sname out))))
    (apply
     string-append
     (for/list
      ((out (in-list (outs-or-default 'bidi))))
      (format
       "        class ~a(call: (Array[Byte] => Unit) => scala.concurrent.Future[Unit]) extends ~a(call)\n\n"
       (client-stream-name sname 'bidi out)
       (recv-name sname out))))
    (apply
     string-append
     (map
      wasm-scala-client-method
      (append methods (alias-client-methods svc))))
    "    }\n\n"
    (apply
     string-append
     (for/list ((out (in-list recv-outs))) (wasm-scala-recv-stream sname out)))
    (apply
     string-append
     (for/list
      ((out (in-list recv-outs)))
      (format
       "    /** Streaming response sink for server handlers. */\n    type ~a = ~a => Unit\n\n"
       (sink-name sname out)
       out)))
    (format
     "    /** Service implementation for ~a (browser/Scala.js facade). */\n"
     (hash-ref svc 'full-name))
    (format "    trait ~aServer {\n" sname)
    (apply string-append (map wasm-scala-server-iface-method methods))
    "    }\n\n"
    (format
     "    /** Register an implementation of ~a on a server bridge. */\n"
     (hash-ref svc 'full-name))
    (format
     "    def register~aServer(bridge: grpcdcscalajs.GrpcdcScalaJsServerBridge, impl: ~aServer): Unit = {\n"
     sname
     sname)
    (apply
     string-append
     (map
      wasm-scala-register-method
      (append methods (alias-server-methods svc))))
    (format "        bridge.start(~s)\n" (hash-ref svc 'full-name))
    "    }\n\n"
    (apply string-append (map wasm-scala-source stream-ins))
    (format
     "    /** Incremental service implementation for ~a: requests arrive one at a time. */\n"
     (hash-ref svc 'full-name))
    (format "    trait ~aStreamServer {\n" sname)
    (apply string-append (map wasm-scala-stream-iface-method methods))
    "    }\n\n"
    (format
     "    /** Register an incremental implementation; call bridge.start after all registrations. */\n")
    (format
     "    def register~aStreamServer(bridge: grpcdcscalajs.GrpcdcScalaJsServerBridge, impl: ~aStreamServer): Unit = {\n"
     sname
     sname)
    (apply
     string-append
     (map
      wasm-scala-stream-register-method
      (append methods (alias-server-methods svc))))
    "    }\n")))

(define (emit-wasm-scala-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define obj-name
    (string-append (pascal (string->symbol base)) "ScalaJsGrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (cons
   (string-append obj-name ".scala")
   (string-append
    "// @generated by protoc-gen-grpc-dc-wasm-scala (Racket metaprogram). DO NOT EDIT.\n"
    (format "// source: ~a\n" (hash-ref file-model 'name))
    (format "package ~a\n\n" pkg)
    "import scala.concurrent.ExecutionContext.Implicits.global\n\n"
    "/** Generated Scala.js facade stubs (wrap the JS runtime). */\n"
    (format "object ~a {\n" obj-name)
    (apply
     string-append
     (map wasm-scala-service (hash-ref file-model 'services)))
    "}\n")))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "_"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map
        stamp-generated-header
        (as-file-list (emit-wasm-scala-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
