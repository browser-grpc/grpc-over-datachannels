(define cpp-stream-impl-program
  '((kind-case
     (unary "")
     (server-streaming
      (fmt
       "  class ~a~aServerImpl : public ~a~aServer {\n   public:\n    ~a~aServerImpl(grpcdc::Endpoint::CallContext& ctx,\n                               grpcdc::Server::ServerSink& sink)\n        : ctx_(ctx), sink_(sink) {}\n    void Send(~a& resp) override { sink_(resp.MarshalDc()); }\n    grpcdc::Endpoint::CallContext& Context() override { return ctx_; }\n\n   private:\n    grpcdc::Endpoint::CallContext& ctx_;\n    grpcdc::Server::ServerSink& sink_;\n  };\n\n"
