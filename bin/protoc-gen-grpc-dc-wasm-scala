     (else (call zigPbEncodeSingular "value" "    ")))))

(define zig-pb-map-val-init-program
  '((case-on (ref type) ((11) ".{}") (else (call zigPbDefault)))))

(define zig-pb-map-decode-line-program
  '((fmt
     "            ~a => { ~a },\n"
     (ref number)
     (trim-end
      (call
       zigPbDecodeSingular
       (arg 0)
       (case-on
        (category)
        ("varint" "field.varint_value")
        ("fixed" "field.fixed_value")
        (else "field.bytes_value"))
       "")))))

(define zig-pb-map-val-decode-line-program
  '((case-on
     (ref type)
     ((11)
      (fmt
       "            ~a => { result.value.unmarshalDc(alloc, field.bytes_value); },\n"
       (ref number)))
     (else (call zigPbMapDecodeLine "result.value")))))

(define zig-pb-alloc-unused-program
  '((case-on
     (get (key-field) type)
     ((9 12 11) "")
     (else
      (case-on
       (get (val-field) type)
       ((9 12 11) "")
       (else "    _ = alloc;\n"))))))

(define zig-pb-map-helpers-program
  '((fmt
     "pub fn encode~a(alloc: std.mem.Allocator, key: ~a, value: ~a) []u8 {\n"
     (zig-struct-name)
     (call-on (key-field) zigPbType)
     (call-on (val-field) zigPbTypeOrRef))
    "    var w = PbWriter.init(alloc);\n    defer w.deinit();\n"
    (call-on (key-field) zigPbEncodeSingular "key" "    ")
    (call-on (val-field) zigPbMapValEncode)
    "    return w.toBytes();\n}\n\n"
    (fmt
     "pub fn decode~a(alloc: std.mem.Allocator, data: []const u8) ~a {\n"
     (zig-struct-name)
     (zig-struct-name))
    (call zigPbAllocUnused)
    (fmt
     "    var result: ~a = .{ .key = ~a, .value = ~a };\n"
     (zig-struct-name)
     (call-on (key-field) zigPbDefault)
     (call-on (val-field) zigPbMapValInit))
    "    var r = PbReader.init(data);\n    while (r.next()) |field| {\n        switch (field.number) {\n"
    (call-on (key-field) zigPbMapDecodeLine "result.key")
    (call-on (val-field) zigPbMapValDecodeLine)
    "            else => {},\n        }\n    }\n    return result;\n}\n\n"))

(define zig-pb-nested-enum-program
  '((fmt "~apub const ~a = enum(i32) {\n" (arg 0) (ref name))
    (each-sep
     ",\n"
     values
     (fmt "~a    ~a = ~a" (arg 0) (ref name) (ref number)))
    (fmt ",\n~a};\n" (arg 0))))

(define zig-pb-list-decl-program
  '((if (or (repeated) (is-map))
      (then
       (fmt
        "~a        var ~a_list = std.ArrayList(~a).empty;\n"
        (arg 0)
        (ref name)
        (if (is-map)
          (then (zig-struct-name))
          (else
           (case-on
            (ref type)
            ((11) (zig-entry-ref))
            (else (call-on (with-label (self) 1) zigPbType)))))))
      (else ""))))

(define zig-pb-list-assign-program
  '((if (or (repeated) (is-map))
      (then
       (fmt
        "~a        self.~a = ~a_list.toOwnedSlice(alloc) catch &.{};\n"
        (arg 0)
        (ref name)
        (ref name)))
      (else ""))))

(define zig-pb-message-program
  '((fmt "~apub const ~a = struct {\n" (arg 0) (ref name))
    (each
     fields
     (fmt
      "~a    ~a: ~a = ~a,\n"
      (arg 0)
      (ref name)
      (call zigPbType)
      (call zigPbDefault)))
    (fmt "~a    unknown_fields: []const u8 = &.{},\n" (arg 0))
    (fmt
     "~a    pub fn marshalDc(self: *const ~a, alloc: std.mem.Allocator) []u8 {\n"
     (arg 0)
     (ref name))
    (fmt "~a        _ = .{ self, alloc };\n" (arg 0))
    (fmt
     "~a        var w = PbWriter.init(alloc);\n~a        defer w.deinit();\n"
     (arg 0)
     (arg 0))
    (each fields (call zigPbEncodeGuard))
    (fmt "~a        w.raw(self.unknown_fields);\n" (arg 0))
    (fmt "~a        return w.toBytes();\n~a    }\n" (arg 0) (arg 0))
    (fmt
     "~a    pub fn unmarshalDc(self: *~a, alloc: std.mem.Allocator, data: []const u8) void {\n"
     (arg 0)
     (ref name))
    (fmt "~a        _ = .{ self, alloc, data };\n" (arg 0))
    (each
     fields
     (fmt "~a        self.~a = ~a;\n" (arg 0) (ref name) (call zigPbDefault)))
    (each fields (call zigPbListDecl (arg 0)))
    (fmt "~a        self.unknown_fields = &.{};\n" (arg 0))
    (fmt
     "~a        var unknown_fields_list = std.ArrayList(u8).empty;\n"
     (arg 0))
    (fmt "~a        var r = PbReader.init(data);\n" (arg 0))
    (fmt
     "~a        while (r.next()) |field| {\n~a            switch (field.number) {\n"
     (arg 0)
     (arg 0))
    (each fields (call zigPbDecodeCase))
    (fmt
     "~a                else => { unknown_fields_list.appendSlice(alloc, field.raw_value) catch {}; },\n~a            }\n~a        }\n"
     (arg 0)
     (arg 0)
     (arg 0))
    (fmt
     "~a        self.unknown_fields = unknown_fields_list.toOwnedSlice(alloc) catch &.{};\n"
     (arg 0))
    (each fields (call zigPbListAssign (arg 0)))
    (fmt "~a    }\n" (arg 0))
    (each-where
     nested
     (not (ref map-entry))
     (call zigPbMessage (fmt "~a    " (arg 0))))
    (each enums (call zigPbNestedEnum (fmt "~a    " (arg 0))))
    (fmt "~a};\n" (arg 0))))

(define kotlin-deprecated-program
  '((if (ref deprecated)
      (then
       (fmt "~a@Deprecated(\"deprecated in the proto schema\")\n" (arg 0)))
      (else ""))))

(define kotlin-client-method-raw-program
  '((kind-case
     (unary
      (fmt
       "        fun ~a(req: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a {\n            val resp = ~a()\n            channel.unary(~s, req, resp, metadata, timeout)\n            return resp\n        }\n\n"
       (ref name)
       (ref input)
       (ref output)
       (ref output)
       (ref path)))
     (server-streaming
      (fmt
       "        fun ~a(req: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a~aStream {\n            return ~a~aStream(channel.serverStream(~s, req, metadata, timeout))\n        }\n\n"
       (ref name)
       (ref input)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref path)))
     (client-streaming
      (fmt
       "        fun ~a(reqs: List<~a>, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a {\n            val resp = ~a()\n            channel.clientStreamCall(~s, reqs, resp, metadata, timeout)\n            return resp\n        }\n\n"
       (ref name)
       (ref input)
       (ref output)
       (ref output)
       (ref path)))
     (bidi
      (fmt
       "        fun ~a(reqs: List<~a>, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a~aStream {\n            return ~a~aStream(channel.bidi(~s, reqs, metadata, timeout))\n        }\n\n"
       (ref name)
       (ref input)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref path))))))

(define kotlin-client-method-program
  (append kotlin-deprecated-program kotlin-client-method-raw-program))

(define kotlin-client-stream-class-program
  '((kind-case
     ((server-streaming bidi)
      (fmt
       "        class ~a~aStream(private val stream: Channel.ClientStream) : AutoCloseable {\n            fun recv(): ~a {\n                val resp = ~a()\n                stream.recv(resp)\n                return resp\n            }\n\n            /** Initial metadata (response headers); null until they arrive. */\n            fun headers(): Map<String, String>? = stream.headers?.metadata\n\n            /** Trailing metadata of the terminal status; null until it arrives. */\n            fun trailers(): Map<String, String>? = stream.trailers\n\n            /** Abort this stream (sends RST, wakes a pending recv). */\n            fun cancel() = stream.cancel()\n\n            /** Abandon the call if still live (RST); no-op once terminated. */\n            override fun close() = stream.close()\n        }\n\n"
       (svc)
       (ref name)
       (ref output)
       (ref output)))
     (else ""))))

(define kotlin-client-async-method-program
  '((kind-case
     (unary
      (fmt
       "        suspend fun ~aAsync(req: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a {\n            return AsyncPump.await(~aFuture(req, metadata, timeout))\n        }\n\n        fun ~aFuture(req: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): CompletableFuture<~a> {\n            return AsyncPump.future { ~a(req, metadata, timeout) }\n        }\n\n"
       (ref name)
       (ref input)
       (ref output)
       (ref name)
       (ref name)
       (ref input)
       (ref output)
       (ref name)))
     ((server-streaming bidi)
      (fmt
       "        suspend fun ~aAsync(req~a: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): List<~a> {\n            return AsyncPump.await(~aFuture(req~a, metadata, timeout))\n        }\n\n        fun ~aFuture(req~a: ~a, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): CompletableFuture<List<~a>> {\n            val stream = ~a(req~a, metadata, timeout)\n            return AsyncPump.future(onCancel = { stream.cancel() }) {\n                val out = ArrayList<~a>()\n                while (true) {\n                    try {\n                        out.add(stream.recv())\n                    } catch (e: EOFException) {\n                        break\n                    }\n                }\n                out\n            }\n        }\n\n"
       (ref name)
       (kind-case (bidi "s") (else ""))
       (kind-case (bidi (fmt "List<~a>" (ref input))) (else (ref input)))
       (ref output)
       (ref name)
       (kind-case (bidi "s") (else ""))
       (ref name)
       (kind-case (bidi "s") (else ""))
       (kind-case (bidi (fmt "List<~a>" (ref input))) (else (ref input)))
       (ref output)
       (ref name)
       (kind-case (bidi "s") (else ""))
       (ref output)))
     (client-streaming
      (fmt
       "        suspend fun ~aAsync(reqs: List<~a>, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): ~a {\n            return AsyncPump.await(~aFuture(reqs, metadata, timeout))\n        }\n\n        fun ~aFuture(reqs: List<~a>, metadata: Map<String, String>? = null, timeout: java.time.Duration? = null): CompletableFuture<~a> {\n            return AsyncPump.future { ~a(reqs, metadata, timeout) }\n        }\n\n"
       (ref name)
       (ref input)
       (ref output)
       (ref name)
       (ref name)
       (ref input)
       (ref output)
       (ref name))))))

