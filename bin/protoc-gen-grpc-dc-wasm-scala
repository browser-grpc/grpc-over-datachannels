             "        w.BytesField(~a, payload.ToBytes());\n    }\n"
             (ref number)))
           ("fixed"
            (fmt "    if (!~a.empty()) {\n" (ref name))
            (fmt "        ~a::Writer payload;\n" (arg 0))
            (fmt
             "        for (auto x : ~a) payload.Fixed~a(x);\n"
             (ref name)
             (cpp-fixed-name))
            (fmt
             "        w.BytesField(~a, payload.ToBytes());\n    }\n"
             (ref number)))
           ("string"
            (fmt
             "    for (const auto& x : ~a) w.BytesField(~a, grpcdc::Bytes(x.begin(), x.end()));\n"
             (ref name)
             (ref number)))
           ("bytes"
            (fmt
             "    for (const auto& x : ~a) w.BytesField(~a, x);\n"
             (ref name)
             (ref number)))
           ("message"
            (fmt
             "    for (const auto& x : ~a) w.BytesField(~a, x.MarshalDc());\n"
             (ref name)
             (ref number)))
           (else (fail))))
         (else (call cppPbEncodeSingular (ref name) "    ")))))))

(define cpp-pb-decode-singular-program
  '((case-on
