(define zig-adapter-program
  '((kind-case
     (unary
      (fmt
       "fn ~a~aAdapter(ctx: *anyopaque, call_ctx: *CallContext, reqs: *server_mod.RequestStream, sink: server_mod.Sink) Status {\n    const impl: *~aServer = @ptrCast(@alignCast(ctx));\n    var req = ~a{};\n    switch (reqs.recvInto(&req)) {\n        .message => {},\n        .end => return Status.init(wire.codeInternal, \"unary call closed with no request\"),\n        .status => |st| return st,\n    }\n    var arena = std.heap.ArenaAllocator.init(reqs.alloc);\n    defer arena.deinit();\n    var resp = ~a{};\n    const st = impl.~a_fn(impl.ctx, call_ctx, &req, &resp, arena.allocator());\n    if (!st.isOk()) return st;\n    const payload = resp.marshalDc(reqs.alloc);\n    defer reqs.alloc.free(payload);\n    return sink.send(payload);\n}\n\n"
       (lower-first (svc))
       (ref name)
       (svc)
       (ref input)
       (ref output)
       (snake-case (ref impl-name))))
     (server-streaming
      (fmt
       "fn ~a~aAdapter(ctx: *anyopaque, call_ctx: *CallContext, reqs: *server_mod.RequestStream, sink: server_mod.Sink) Status {\n    const impl: *~aServer = @ptrCast(@alignCast(ctx));\n    var req = ~a{};\n    switch (reqs.recvInto(&req)) {\n        .message => {},\n        .end => return Status.init(wire.codeInternal, \"server-streaming call closed with no request\"),\n        .status => |st| return st,\n    }\n    var stream = ~a~aServer{ .sink = sink, .alloc = reqs.alloc };\n    return impl.~a_fn(impl.ctx, call_ctx, &req, &stream);\n}\n\n"
       (lower-first (svc))
       (ref name)
       (svc)
       (ref input)
       (svc)
       (ref name)
       (snake-case (ref impl-name))))
     (client-streaming
      (fmt
       "fn ~a~aAdapter(ctx: *anyopaque, call_ctx: *CallContext, reqs: *server_mod.RequestStream, sink: server_mod.Sink) Status {\n    const impl: *~aServer = @ptrCast(@alignCast(ctx));\n    var arena = std.heap.ArenaAllocator.init(reqs.alloc);\n    defer arena.deinit();\n    var stream = ~a~aServer{ .reqs = reqs, .alloc = arena.allocator() };\n    const st = impl.~a_fn(impl.ctx, call_ctx, &stream);\n    if (!st.isOk()) return st;\n    const resp = stream.resp orelse\n        return Status.init(wire.codeInternal, \"client-streaming handler never called sendAndClose\");\n    const payload = resp.marshalDc(reqs.alloc);\n    defer reqs.alloc.free(payload);\n    return sink.send(payload);\n}\n\n"
       (lower-first (svc))
       (ref name)
       (svc)
       (svc)
       (ref name)
       (snake-case (ref impl-name))))
     (bidi
      (fmt
       "fn ~a~aAdapter(ctx: *anyopaque, call_ctx: *CallContext, reqs: *server_mod.RequestStream, sink: server_mod.Sink) Status {\n    const impl: *~aServer = @ptrCast(@alignCast(ctx));\n    var stream = ~a~aServer{ .reqs = reqs, .sink = sink, .alloc = reqs.alloc };\n    return impl.~a_fn(impl.ctx, call_ctx, &stream);\n}\n\n"
       (lower-first (svc))
       (ref name)
       (svc)
       (svc)
       (ref name)
       (snake-case (ref impl-name)))))))

(define zig-register-method-program
  '((fmt
     "                .{ .name = ~s, .path = ~s, .kind = .~a, .ctx = impl, .handler = ~a~aAdapter },\n"
     (ref name)
     (ref path)
     (case-on
      (ref kind)
      ((unary) "unary")
      ((server-streaming) "server_streaming")
      ((client-streaming) "client_streaming")
      ((bidi) "bidi"))
     (lower-first (svc))
     (ref name))))

(define zig-service-program
  '((fmt "/// Client for ~a.\n" (ref full-name))
    (fmt "pub const ~aClient = struct {\n" (ref name))
    "    channel: *Channel,\n\n"
    (fmt "    pub fn init(channel: *Channel) ~aClient {\n" (ref name))
    "        return .{ .channel = channel };\n    }\n\n"
    (each+ methods client (call zigClientMethod "    "))
    "};\n\n"
    (each methods (call zigClientStreamClass))
    (each methods (call zigServerStreamStruct))
    (fmt
     "/// Service implementation interface for ~a (vtable: Zig has no\n"
     (ref full-name))
    "/// interfaces, so generated stubs dispatch through fn pointers).\n"
    (fmt "pub const ~aServer = struct {\n" (ref name))
    "    ctx: *anyopaque,\n"
    (each methods (call zigServerVtableField))
    "};\n\n"
    (each+ methods server (call zigAdapter))))

(define zig-pb-type-program
  '((if (is-map)
      (then (fmt "[]const ~a" (zig-struct-name)))
      (else
       (if (repeated)
         (then
          (fmt
           "[]const ~a"
           (case-on
            (ref type)
            ((11) (zig-entry-ref))
            (else (call-on (with-label (self) 1) zigPbType)))))
         (else
          (case-on
           (ref type)
           ((11) (fmt "?*~a" (zig-entry-ref)))
           ((14) (zig-entry-ref))
           (else (zig-scalar-type)))))))))

(define zig-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt ".~a" (default-raw)))
         ((2) (fmt "~a" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define zig-pb-default-program
  '((if (call zigPbExplicitLiteral)
      (then (call zigPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then "&.{}")
          (else
           (case-on
            (ref label)
            ((3) "&.{}")
            (else
             (case-on
              (ref type)
              ((11) "null")
              ((14) (fmt ".~a" (enum-first-value-name)))
              (else (zig-scalar-zero))))))))))))

(define zig-pb-varint-expr-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((8) (fmt "@intFromBool(~a)" (arg 0)))
      ((17)
       (fmt
        "@as(u64, @bitCast(@as(i64, ((~a << 1) ^ (~a >> 31)))))"
        (arg 0)
        (arg 0)))
      ((18)
       (fmt "@as(u64, @bitCast(((~a << 1) ^ (~a >> 63))))" (arg 0) (arg 0)))
      ((14) (fmt "@as(u64, @bitCast(@as(i64, @intFromEnum(~a))))" (arg 0)))
      ((5) (fmt "@as(u64, @bitCast(@as(i64, ~a)))" (arg 0)))
      ((3) (fmt "@as(u64, @bitCast(~a))" (arg 0)))
      (else (arg 0))))))

(define zig-pb-varint-decode-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((5) (fmt "@as(i32, @truncate(@as(i64, @bitCast(~a))))" (arg 0)))
      ((13 7) (fmt "@as(u32, @truncate(~a))" (arg 0)))
      ((3) (fmt "@as(i64, @bitCast(~a))" (arg 0)))
      ((4 6) (arg 0))
      ((8) (fmt "~a != 0" (arg 0)))
      ((17)
       (fmt
        "@as(i32, @bitCast(@as(u32, @truncate((~a >> 1) ^ (0 -% (~a & 1))))))"
        (arg 0)
        (arg 0)))
      ((18)
       (fmt
        "@as(i64, @bitCast((~a >> 1) ^ (0 -% (~a & 1))))"
        (arg 0)
        (arg 0)))))))

(define zig-pb-nonzero-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((8) (arg 0))
      ((14) (fmt "@intFromEnum(~a) != 0" (arg 0)))
      (else (fmt "~a != 0" (arg 0)))))))

(define zig-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, 0); w.varint(~a); }\n"
          (arg 1)
          (ref number)
          (call zigPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, 0); w.varint(~a); }\n"
          (arg 1)
          (call zigPbNonzero (arg 0))
          (ref number)
          (call zigPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, ~a); w.fixed~a(~a); }\n"
          (arg 1)
          (ref number)
          (case-on (zig-fixed-size) ((8) "1") (else "5"))
          (zig-fixed-name)
          (arg 0)))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, ~a); w.fixed~a(~a); }\n"
          (arg 1)
          (call zigPbNonzero (arg 0))
          (ref number)
          (case-on (zig-fixed-size) ((8) "1") (else "5"))
          (zig-fixed-name)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then (fmt "~aw.bytesField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt "~aw.stringField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw.bytesField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif (~a.len > 0) w.bytesField(~a, ~a);\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif (~a) |p| w.bytesField(~a, p.marshalDc(alloc));\n"
       (arg 1)
       (arg 0)
       (ref number)))
     (else (fail)))))

(define zig-pb-set-expr-program
  '((case-on
     (ref type)
     ((11 10) (fmt "self.~a != null" (ref name)))
     ((9 12) (fmt "self.~a.len > 0" (ref name)))
     (else (call zigPbNonzero (fmt "self.~a" (ref name)))))))

(define zig-pb-encode-guard-program
  '((guarded
     zigPbSetExpr
     "        if (!(~a)) {\n"
     "        }\n"
     (join " or ")
     (call zigPbEncodeField))))

(define zig-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "        for (~a) |e| w.bytesField(~a, encode~a(alloc, e.key, e.value));\n"
        (fmt "self.~a" (ref name))
        (ref number)
        (zig-struct-name)))
      (else
       (if (repeated)
         (then
          (fmt
           "~a"
           (case-on
            (category)
            ("varint"
             (fmt
              "~a~a~a"
              (fmt
               "        if (~a.len > 0) {\n            var payload = PbWriter.init(alloc);\n            defer payload.deinit();\n"
               (fmt "self.~a" (ref name)))
              (fmt
               "            for (~a) |x| payload.varint(~a);\n"
               (fmt "self.~a" (ref name))
               (call zigPbVarintExpr "x"))
              (fmt
               "            w.bytesField(~a, payload.toBytes());\n        }\n"
               (ref number))))
            ("fixed"
             (fmt
              "~a~a~a"
              (fmt
               "        if (~a.len > 0) {\n            var payload = PbWriter.init(alloc);\n            defer payload.deinit();\n"
               (fmt "self.~a" (ref name)))
              (fmt
               "            for (~a) |x| payload.fixed~a(x);\n"
               (fmt "self.~a" (ref name))
               (zig-fixed-name))
              (fmt
               "            w.bytesField(~a, payload.toBytes());\n        }\n"
               (ref number))))
            ("string"
             (fmt
              "        for (~a) |x| w.bytesField(~a, x);\n"
              (fmt "self.~a" (ref name))
              (ref number)))
            ("bytes"
             (fmt
              "        for (~a) |x| w.bytesField(~a, x);\n"
              (fmt "self.~a" (ref name))
              (ref number)))
            ("message"
             (fmt
              "        for (~a) |x| w.bytesField(~a, x.marshalDc(alloc));\n"
              (fmt "self.~a" (ref name))
              (ref number)))
            (else (fail)))))
         (else
          (call
           zigPbEncodeSingular
           (fmt "self.~a" (ref name))
           "        ")))))))

(define zig-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt
       "~a~a = ~a;\n"
       (arg 2)
       (arg 0)
       (case-on
        (ref type)
        ((14)
         (fmt
          "@enumFromInt(@as(i32, @truncate(@as(i64, @bitCast(~a)))))"
          (arg 1)))
        (else (call zigPbVarintDecode (arg 1))))))
     ("fixed"
      (fmt
       "~a~a = ~a;\n"
       (arg 2)
       (arg 0)
       (case-on
        (ref type)
        ((2) (fmt "@as(f32, @bitCast(@as(u32, @truncate(~a))))" (arg 1)))
        ((1) (fmt "@as(f64, @bitCast(~a))" (arg 1)))
        ((7) (fmt "@as(u32, @truncate(~a))" (arg 1)))
        ((15) (fmt "@as(i32, @bitCast(@as(u32, @truncate(~a))))" (arg 1)))
        ((16) (fmt "@as(i64, @bitCast(~a))" (arg 1)))
        (else (arg 1)))))
     ("string"
      (fmt "~a~a = alloc.dupe(u8, ~a) catch \"\";\n" (arg 2) (arg 0) (arg 1)))
     ("bytes"
      (fmt "~a~a = alloc.dupe(u8, ~a) catch &.{};\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt
       "~a~a = alloc.create(~a) catch unreachable;\n"
       (arg 2)
       (arg 0)
       (zig-entry-ref))
      (fmt "~a~a.?.* = .{};\n" (arg 2) (arg 0))
      (fmt "~a~a.?.unmarshalDc(alloc, ~a);\n" (arg 2) (arg 0) (arg 1)))
     (else (fail)))))

(define zig-pb-clearing-program
  '((each-siblings
     (fmt
      "                    self.~a = ~a;\n"
      (ref name)
      (call zigPbDefault)))))

(define zig-pb-enum-conv-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((14)
       (fmt
        "@enumFromInt(@as(i32, @truncate(@as(i64, @bitCast(~a)))))"
        (arg 0)))
      (else (call zigPbVarintDecode (arg 0)))))))

(define zig-pb-decode-case-program
  '((fmt "                ~a => {\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "                    const kv = decode~a(alloc, field.bytes_value);\n"
        (zig-struct-name))
       (fmt
        "                    ~a_list.append(alloc, kv) catch {};\n"
        (ref name)))
      (else
       (if (repeated)
         (then
          (fmt
           "~a"
           (case-on
            (category)
            ("varint"
             (fmt
              "~a~a~a~a"
              "                    if (field.wire == 2) {\n"
              "                        var sub = PbReader.init(field.bytes_value);\n                        while (!sub.done()) {\n"
              (fmt
               "                            ~a_list.append(alloc, ~a) catch {};\n"
               (ref name)
               (call zigPbEnumConv "sub.varint()"))
              (fmt
               "~a~a~a"
               "                        }\n                    } else {\n"
               (fmt
                "                        ~a_list.append(alloc, ~a) catch {};\n"
                (ref name)
                (call zigPbEnumConv "field.varint_value"))
               "                    }\n")))
            ("fixed"
             (fmt
              "~a~a~a~a"
              "                    if (field.wire == 2) {\n"
              "                        var sub = PbReader.init(field.bytes_value);\n                        while (!sub.done()) {\n"
              (fmt
               "                            ~a_list.append(alloc, ~a) catch {};\n"
               (ref name)
               (case-on
                (ref type)
                ((2)
                 "@as(f32, @bitCast(std.mem.readInt(u32, sub.take(4)[0..4], .little)))")
                ((1)
                 "@as(f64, @bitCast(std.mem.readInt(u64, sub.take(8)[0..8], .little)))")
                ((7) "std.mem.readInt(u32, sub.take(4)[0..4], .little)")
                ((15)
                 "@as(i32, @bitCast(std.mem.readInt(u32, sub.take(4)[0..4], .little)))")
                ((6) "std.mem.readInt(u64, sub.take(8)[0..8], .little)")
                (else
                 "@as(i64, @bitCast(std.mem.readInt(u64, sub.take(8)[0..8], .little)))")))
              (fmt
               "~a~a~a"
               "                        }\n                    } else {\n"
               (fmt
                "                        ~a_list.append(alloc, ~a) catch {};\n"
                (ref name)
                (case-on
                 (ref type)
                 ((2)
                  "@as(f32, @bitCast(@as(u32, @truncate(field.fixed_value))))")
                 ((1) "@as(f64, @bitCast(field.fixed_value))")
                 ((7) "@as(u32, @truncate(field.fixed_value))")
                 ((15)
                  "@as(i32, @bitCast(@as(u32, @truncate(field.fixed_value))))")
                 ((6) "field.fixed_value")
                 (else "@as(i64, @bitCast(field.fixed_value))")))
               "                    }\n")))
            ("string"
             (fmt
              "                    ~a_list.append(alloc, alloc.dupe(u8, field.bytes_value) catch \"\") catch {};\n"
              (ref name)))
            ("bytes"
             (fmt
              "                    ~a_list.append(alloc, alloc.dupe(u8, field.bytes_value) catch &.{}) catch {};\n"
              (ref name)))
            ("message"
             (fmt "                    var item: ~a = .{};\n" (zig-entry-ref))
             "                    item.unmarshalDc(alloc, field.bytes_value);\n"
             (fmt
              "                    ~a_list.append(alloc, item) catch {};\n"
              (ref name)))
            (else (fail)))))
         (else
          (call zigPbClearing)
          (call
           zigPbDecodeSingular
           (fmt "self.~a" (ref name))
           (case-on
            (category)
            ("varint" "field.varint_value")
            ("fixed" "field.fixed_value")
            (else "field.bytes_value"))
           "                    ")))))
    "                },\n"))

(define zig-pb-type-or-ref-program
  '((if (is-map)
      (then (call zigPbType))
      (else
       (case-on (ref type) ((11) (zig-entry-ref)) (else (call zigPbType)))))))

