              (6 "(sub.fixed64()).toUnsigned(64)")
              (else "(sub.fixed64()).toSigned(64)"))
             (dart-field-name)
             (case-on
              (type)
              (2 (fmt "~aBitsToFloat32(field.fixedValue)" (arg 0)))
              (1 (fmt "~aBitsToFloat64(field.fixedValue)" (arg 0)))
              (7 "(field.fixedValue).toUnsigned(32)")
              (15 "(field.fixedValue).toSigned(32)")
              (6 "(field.fixedValue).toUnsigned(64)")
              (else "(field.fixedValue).toSigned(64)"))))
           ("string"
            (fmt
             "          ~a.add(utf8.decode(field.bytesValue));\n          break;\n"
             (dart-field-name)))
           ("bytes"
            (fmt
             "          ~a.add(field.bytesValue);\n          break;\n"
             (dart-field-name)))
           ("message"
            (fmt
             "          final item = ~a();\n          item.unmarshalDc(field.bytesValue);\n          ~a.add(item);\n          break;\n"
             (dart-type-ref)
             (dart-field-name)))
           (else (fail))))
         (else
          (call dtPbOneofClearing)
          (call
           dtPbDecodeSingular
           (dart-field-name)
           (case-on
            (category)
            ("varint" "field.varintValue")
            ("fixed" "field.fixedValue")
            (else "field.bytesValue"))
           "          "
           (arg 0))
          "          break;\n"))))))

(define dt-pb-map-helpers-program
  '((fmt
     "Uint8List ~a~aEncode(~a key, ~a value) {\n"
     (arg 0)
     (entry-flat)
     (call-on (with-label (key-field) 1) dtPbType)
     (case-on
      (get (val-field) type)
      (11 (dart-type-ref (val-field)))
      (else (call-on (with-label (val-field) 1) dtPbType))))
    (fmt "  final w = ~aWriter();\n" (arg 0))
    (call-on (with-label (key-field) 1) dtPbEncodeSingular "key" "  ")
    (case-on
     (get (val-field) type)
     (11
      (fmt
       "  w.bytesField(~a, value.marshalDc());\n"
       (get (val-field) number)))
     (else
      (call-on (with-label (val-field) 1) dtPbEncodeSingular "value" "  ")))
    "  return w.toBytes();\n}\n\n"
    (fmt
     "MapEntry<~a, ~a> ~a~aDecode(Uint8List bytes) {\n"
     (call-on (with-label (key-field) 1) dtPbType)
     (case-on
      (get (val-field) type)
      (11 (dart-type-ref (val-field)))
      (else (call-on (with-label (val-field) 1) dtPbType)))
     (arg 0)
     (entry-flat))
    (fmt
     "  ~a key = ~a;\n"
     (call-on (with-label (key-field) 1) dtPbType)
     (call-on (with-label (key-field) 1) dtPbDefault))
    (fmt
     "  ~a value = ~a;\n"
     (case-on
      (get (val-field) type)
      (11 (dart-type-ref (val-field)))
      (else (call-on (with-label (val-field) 1) dtPbType)))
     (case-on
      (get (val-field) type)
      (11 (fmt "~a()" (dart-type-ref (val-field))))
      (else (call-on (with-label (val-field) 1) dtPbDefault))))
    (fmt "  final r = ~aReader(bytes);\n" (arg 0))
    "  while (true) {\n    final field = r.next();\n    if (field == null) break;\n    switch (field.number) {\n"
    (fmt
     "      case ~a:\n~a        break;\n"
     (get (key-field) number)
     (call-on
      (with-label (key-field) 1)
      dtPbDecodeSingular
      "key"
      (case-on
       (category-of (key-field))
       ("varint" "field.varintValue")
       ("fixed" "field.fixedValue")
       (else "field.bytesValue"))
      "        "
      (arg 0)))
    (fmt
     "      case ~a:\n~a        break;\n"
     (get (val-field) number)
     (case-on
      (get (val-field) type)
      (11 "        value.unmarshalDc(field.bytesValue);\n")
      (else
       (call-on
        (with-label (val-field) 1)
        dtPbDecodeSingular
        "value"
        (case-on
         (category-of (val-field))
         ("varint" "field.varintValue")
         ("fixed" "field.fixedValue")
         (else "field.bytesValue"))
        "        "
        (arg 0)))))
    "      default:\n        break;\n    }\n  }\n  return MapEntry(key, value);\n}\n\n"))

(define dt-pb-message-program
  '((fmt "~aclass ~a implements Marshaler, Unmarshaler {\n" (arg 1) (flat))
    (each
     fields
     (fmt "~a  ~a ~a;\n" (arg 1) (call dtPbType) (dart-field-name)))
    (fmt "~a  Uint8List unknownFields = Uint8List(0);\n" (arg 1))
    (if (any-where fields (or (repeated) (type-is 12) (is-map)))
      (then
       (fmt "~a  ~a(" (arg 1) (flat))
       (if (any-where fields (not (or (repeated) (type-is 12) (is-map))))
         (then
          (fmt
           "[~a]"
           (each-sep-where
            ", "
            fields
            (not (or (repeated) (type-is 12) (is-map)))
            (fmt "this.~a = ~a" (dart-field-name) (call dtPbDefault)))))
         (else ""))
       (fmt
        ") : ~a;\n"
        (each-sep-where
         ", "
         fields
         (or (repeated) (type-is 12) (is-map))
         (fmt "~a = ~a" (dart-field-name) (call dtPbDefault)))))
      (else
       (if (any-where fields (not (or (repeated) (type-is 12) (is-map))))
         (then
          (fmt
           "~a  ~a([~a]);\n"
           (arg 1)
           (flat)
           (each-sep-where
            ", "
            fields
            (not (or (repeated) (type-is 12) (is-map)))
            (fmt "this.~a = ~a" (dart-field-name) (call dtPbDefault)))))
         (else (fmt "~a  ~a();\n" (arg 1) (flat))))))
    (fmt
     "~a  @override\n~a  Uint8List marshalDc() {\n~a    final w = ~aWriter();\n"
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 0))
    (each
     fields
     (guarded
      dtPbSetExpr
      "    if (!(~a)) {\n"
      "    }\n"
      (call dtPbEncodeField (arg 0))))
    (fmt
     "~a    w.raw(unknownFields);\n~a    return w.toBytes();\n~a  }\n"
     (arg 1)
     (arg 1)
     (arg 1))
    (fmt
     "~a  @override\n~a  void unmarshalDc(List<int> data) {\n~a    unknownFields = Uint8List(0);\n"
     (arg 1)
     (arg 1)
     (arg 1))
    (each
     fields
     (fmt "~a    ~a = ~a;\n" (arg 1) (dart-field-name) (call dtPbDefault)))
    (fmt
     "~a    final r = ~aReader(Uint8List.fromList(data));\n~a    while (true) {\n~a      final field = r.next();\n~a      if (field == null) break;\n~a      switch (field.number) {\n"
     (arg 1)
     (arg 0)
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1))
    (each fields (call dtPbDecodeCase (arg 0)))
    (fmt
     "~a        default:\n~a          unknownFields = Uint8List.fromList([...unknownFields, ...field.rawValue]);\n~a          break;\n~a      }\n~a    }\n~a  }\n~a}\n"
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1)
     (arg 1))
    (each nested (call dtPbMessage (arg 0) (arg 1)))
    (each
     enums
     (call
      dtPbEnum
      (arg 1)
      (fmt "~a_~a" (flat-of (get (parent) full-name)) (ref name))))))

