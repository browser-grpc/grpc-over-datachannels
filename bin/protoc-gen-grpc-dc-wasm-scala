       (if (bigint-type) (then "0n") (else "0")))))))

(define js-pb-oneof-clearing-program
  '((each-siblings (fmt "msg.~a = ~a; " (js-name) (call jsPbDefault)))))

(define js-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~aputTag(out, ~a, 0); out.push(...varintBytes(~a));\n"
          (arg 1)
          (ref number)
          (call jsPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aputVarintField(out, ~a, ~a);\n"
          (arg 1)
          (ref number)
          (call jsPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aputFixedField(out, ~a, fixedBytes(~a, ~a, (dv, x) => dv.set~a(0, x, true)));\n"
          (arg 1)
          (ref number)
          (arg 0)
          (js-fixed-size)
          (js-fixed-name)))
        (else
         (fmt
          "~aif (~a) putFixedField(out, ~a, fixedBytes(~a, ~a, (dv, x) => dv.set~a(0, x, true)));\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)
          (js-fixed-size)
          (js-fixed-name)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aputBytesField(out, ~a, textEncoder.encode(~a));\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aputStringField(out, ~a, ~a);\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt "~aputBytesField(out, ~a, ~a);\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif (~a && ~a.length) putBytesField(out, ~a, ~a);\n"
          (arg 1)
          (arg 0)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif (~a) putBytesField(out, ~a, ~a.encode(~a));\n"
       (arg 1)
       (arg 0)
       (ref number)
       (resolved-flat)
       (arg 0)))
     (else (fail)))))

(define js-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "    if (msg.~a) for (const [k, val] of msg.~a) putBytesField(out, ~a, ~aEncode(k, val));\n"
        (js-name)
        (js-name)
        (ref number)
        (resolved-flat)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "    if (msg.~a && msg.~a.length) {\n      const payload = [];\n      for (const x of msg.~a) payload.push(...varintBytes(~a));\n      putBytesField(out, ~a, payload);\n    }\n"
             (js-name)
             (js-name)
             (js-name)
             (call jsPbVarintExpr "x")
             (ref number)))
           ("fixed"
            (fmt
             "    if (msg.~a && msg.~a.length) {\n      const payload = new Uint8Array(msg.~a.length * ~a);\n      const dv = new DataView(payload.buffer);\n      msg.~a.forEach((x, i) => dv.set~a(i * ~a, x, true));\n      putBytesField(out, ~a, payload);\n    }\n"
             (js-name)
             (js-name)
             (js-name)
             (js-fixed-size)
             (js-name)
             (js-fixed-name)
             (js-fixed-size)
             (ref number)))
           ("string"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, textEncoder.encode(v));\n"
             (js-name)
             (js-name)
             (ref number)))
           ("bytes"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, v);\n"
             (js-name)
             (js-name)
             (ref number)))
           ("message"
            (fmt
             "    if (msg.~a) for (const v of msg.~a) putBytesField(out, ~a, ~a.encode(v));\n"
             (js-name)
             (js-name)
             (ref number)
             (resolved-flat)))
           (else (fail))))
         (else (call jsPbEncodeSingular (fmt "msg.~a" (js-name)) "    ")))))))

(define js-pb-decode-singular-program
  '((case-on
     (category)
     ("varint" (fmt "~a = ~a;" (arg 0) (call jsPbVarintDecode (arg 1))))
     ("fixed"
      (fmt
       "~a = readFixed(~a, (dv) => dv.get~a(0, true));"
       (arg 0)
       (arg 1)
       (js-fixed-name)))
     ("string" (fmt "~a = textDecoder.decode(~a);" (arg 0) (arg 1)))
     ("bytes" (fmt "~a = ~a;" (arg 0) (arg 1)))
     ("message" (fmt "~a = ~a.decode(~a);" (arg 0) (resolved-flat) (arg 1)))
     (else (fail)))))

(define js-pb-decode-case-program
  '((if (is-map)
      (then
       (fmt
        "      case ~a: { const [k, val] = ~aDecode(value); msg.~a.set(k, val); break; }\n"
        (ref number)
        (resolved-flat)
        (js-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "      case ~a: ~aif (wire === 2) { const r = new Reader(value); while (!r.done) msg.~a.push(~a); } else msg.~a.push(~a); break;\n"
             (ref number)
             (call jsPbOneofClearing)
             (js-name)
             (call jsPbVarintDecode "r.varint()")
             (js-name)
             (call jsPbVarintDecode "value")))
           ("fixed"
            (fmt
             "      case ~a: if (wire === 2) { const r = new Reader(value); while (!r.done) msg.~a.push(readFixed(r.take(~a), (dv) => dv.get~a(0, true))); } else msg.~a.push(readFixed(value, (dv) => dv.get~a(0, true))); break;\n"
             (ref number)
             (js-name)
             (js-fixed-size)
             (js-fixed-name)
             (js-name)
             (js-fixed-name)))
           (else
            (fmt
             "      case ~a: msg.~a.push(~a); break;\n"
             (ref number)
             (js-name)
             (case-on
              (category)
              ("string" "textDecoder.decode(value)")
              ("bytes" "value")
              (else (fmt "~a.decode(value)" (resolved-flat))))))))
         (else
          (fmt
           "      case ~a: ~a~a break;\n"
           (ref number)
           (call jsPbOneofClearing)
           (call jsPbDecodeSingular (fmt "msg.~a" (js-name)) "value"))))))))

(define js-pb-map-helpers-program
  '((fmt "function ~aEncode(key, value) {\n  const out = [];\n" (entry-flat))
    (call-on (key-field) jsPbEncodeSingular "key" "  ")
    (call-on (val-field) jsPbEncodeSingular "value" "  ")
    "  return new Uint8Array(out);\n}\n\n"
    (fmt "function ~aDecode(bytes) {\n" (entry-flat))
    (fmt
     "  let key = ~a;\n  let value = ~a;\n"
     (call-on (key-field) jsPbDefault)
     (call-on (val-field) jsPbDefault))
    "  const reader = new Reader(bytes);\n  let f;\n  while ((f = reader.field()) !== null) {\n    const [num, wire, raw] = f;\n    switch (num) {\n"
    (fmt
     "      case ~a: ~a break;\n"
     (get (key-field) number)
     (call-on (key-field) jsPbDecodeSingular "key" "raw"))
    (fmt
     "      case ~a: ~a break;\n"
     (get (val-field) number)
     (call-on (val-field) jsPbDecodeSingular "value" "raw"))
    "    }\n  }\n  return [key, value];\n}\n\n"))

(define js-pb-enum-const-program
  '((fmt
     "export const ~a = { ~a };\n\n"
     (entry-flat)
     (each-sep ", " enum values (fmt "~a: ~a" (ref name) (ref number))))))

(define js-pb-message-program
  '((fmt "export class ~a {\n" (flat))
    (fmt
     "  constructor({ ~a } = {}) {\n"
     (each-sep ", " fields (fmt "~a = ~a" (js-name) (call jsPbDefault))))
    (each fields (fmt "    this.~a = ~a;\n" (js-name) (js-name)))
    "    this.unknownFields = EMPTY_BYTES;\n  }\n  static encode(msg) {\n    const out = [];\n"
    (each
     fields
     (guarded
      jsPbSetExpr
      "    if (!(~a)) {\n"
      "    }\n"
      (call jsPbEncodeField)))
    "    putRaw(out, msg.unknownFields);\n    return new Uint8Array(out);\n  }\n"
    (fmt
     "  static decode(bytes) {\n    const msg = new ~a();\n    ~a._fill(msg, bytes);\n    return msg;\n  }\n  static decodeInto(msg, bytes) {\n    msg._reset();\n    ~a._fill(msg, bytes);\n    return msg;\n  }\n  static _fill(msg, bytes) {\n"
     (flat)
     (flat)
     (flat))
    "    const reader = new Reader(bytes);\n    let f;\n    while ((f = reader.field()) !== null) {\n      const [num, wire, value, raw] = f;\n      switch (num) {\n"
    (each fields (call jsPbDecodeCase))
    "        default: msg.unknownFields = concatBytes(msg.unknownFields, raw); break;\n      }\n    }\n    return msg;\n  }\n  _reset() {\n"
    (each fields (fmt "    this.~a = ~a;\n" (js-name) (call jsPbDefault)))
    "    this.unknownFields = EMPTY_BYTES;\n  }\n}\n\n"))

