(define cs-client-stream-class-program
  '((kind-case
     ((server-streaming bidi)
      (fmt
       "    /// <summary>Receiving stream for ~a.~a: Recv() throws EndOfStreamException at end. Dispose to abandon early (RST).</summary>\n    public sealed class ~a~aStream : IDisposable\n    {\n        private readonly Channel.ClientStream _stream;\n\n        internal ~a~aStream(Channel.ClientStream stream)\n        {\n            _stream = stream;\n        }\n\n        public ~a Recv()\n        {\n            var resp = new ~a();\n            _stream.Recv(resp);\n            return resp;\n        }\n\n        /// <summary>Initial metadata (response headers); null until they arrive.</summary>\n        public Dictionary<string, string> Headers => _stream.Headers?.Metadata;\n\n        /// <summary>Trailing metadata of the terminal status; null until it arrives.</summary>\n        public Dictionary<string, string> Trailers => _stream.Trailers;\n\n        /// <summary>Abort this stream (sends RST, wakes a pending Recv).</summary>\n        public void Cancel() => _stream.Cancel();\n\n        /// <summary>Abandon the call if still live (RST); no-op once terminated.</summary>\n        public void Dispose() => _stream.Dispose();\n    }\n\n"
       (svc)
