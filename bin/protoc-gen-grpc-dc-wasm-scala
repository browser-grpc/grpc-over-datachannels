(define-syntax (define-frame-constants stx)
  (syntax-case stx ()
    ((_) #'(begin))
    ((_ (name code doc) rest ...)
     (with-syntax
      ((const (format-id #'name "frame:~a" (syntax->datum #'name))))
      #'(begin (define const code) (define-frame-constants rest ...))))))

(define-syntax (define-status-constants stx)
  (syntax-case stx ()
    ((_) #'(begin))
    ((_ (name code) rest ...)
     (with-syntax
      ((const (format-id #'name "status:~a" (syntax->datum #'name))))
      #'(begin (define const code) (define-status-constants rest ...))))))

(define-syntax (define-frame-table stx)
  (syntax-case stx ()
    ((_ (name code doc) ...)
     (with-syntax
      ((type->name (format-id stx "frame-type->name"))
       (name->type (format-id stx "frame-name->type"))
       (valid? (format-id stx "valid-frame-type?"))
       (table (format-id stx "frame-table")))
      #'(begin
          (define-frame-constants (name code doc) ...)
          (define (type->name t)
            (cond
             ((= t code) 'name)
             ...
             (else (error 'frame-type->name "unknown frame type: ~e" t))))
          (define (name->type n)
            (cond
             ((eq? n 'name) code)
             ...
             (else (error 'frame-name->type "unknown frame name: ~e" n))))
          (define (valid? t) (and (exact-integer? t) (or (= t code) ...)))
          (define table '((name code doc) ...)))))))

(define-syntax (define-status-table stx)
  (syntax-case stx ()
    ((_ (name code) ...)
     (with-syntax
      ((code->name (format-id stx "status-code->name"))
       (name->code (format-id stx "status-name->code"))
       (table (format-id stx "status-table")))
      #'(begin
          (define-status-constants (name code) ...)
          (define (code->name c)
            (cond
             ((= c code) (symbol->string 'name))
             ...
             (else (error 'status-code->name "unknown status code: ~e" c))))
          (define (name->code n)
            (cond ((equal? n (symbol->string 'name)) code) ... (else #f)))
          (define table '((name code) ...)))))))

