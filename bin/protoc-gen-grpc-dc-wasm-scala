     (fmt "          ~a = ~a\n" (sc-field-name) (call scPbDefault)))))

(define sc-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~a}\n"
          (arg 2)
          (arg 2)
          (ref number)
          (arg 2)
          (call scPbVarintExpr (arg 1))
          (arg 2)))
        (else
         (fmt
          "~aif (~a) {\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~a}\n"
          (arg 2)
          (call scPbNonzero (arg 1))
          (arg 2)
          (ref number)
          (arg 2)
          (call scPbVarintExpr (arg 1))
          (arg 2)))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{\n~a  w.fixed(~a, ~a, ~a)\n~a}\n"
          (arg 2)
          (arg 2)
          (ref number)
          (case-on (sc-fixed-size) (8 "1") (else "5"))
          (call scPbFixedEncode (arg 0) (arg 1))
          (arg 2)))
        (else
         (fmt
          "~aif (~a != 0) {\n~a  w.fixed(~a, ~a, ~a)\n~a}\n"
          (arg 2)
          (arg 1)
          (arg 2)
          (ref number)
          (case-on (sc-fixed-size) (8 "1") (else "5"))
          (call scPbFixedEncode (arg 0) (arg 1))
          (arg 2)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aw.bytesField(~a, ~a.getBytes(java.nio.charset.StandardCharsets.UTF_8))\n"
          (arg 2)
          (ref number)
          (arg 1)))
        (else (fmt "~aw.stringField(~a, ~a)\n" (arg 2) (ref number) (arg 1)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw.bytesField(~a, ~a)\n" (arg 2) (ref number) (arg 1)))
        (else
         (fmt
          "~aif (~a.nonEmpty) {\n~a  w.bytesField(~a, ~a)\n~a}\n"
          (arg 2)
          (arg 1)
          (arg 2)
          (ref number)
          (arg 1)
          (arg 2)))))
     ("message"
      (fmt
       "~aif (~a != null) {\n~a  w.bytesField(~a, ~a.marshalDc())\n~a}\n"
       (arg 2)
       (arg 1)
       (arg 2)
       (ref number)
       (arg 1)
       (arg 2)))
     (else (fail)))))

