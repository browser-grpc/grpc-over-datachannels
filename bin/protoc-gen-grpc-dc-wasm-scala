       "    private class ~a~aServerImpl(\n        override val context: Endpoint.CallContext,\n        private val reqs: Server.RequestStream\n    ) : ~a~aServer {\n        var resp: ~a? = null\n            private set\n\n        override fun recv(): ~a {\n            val req = ~a()\n            reqs.recvInto(req)\n            return req\n        }\n\n        override fun sendAndClose(resp: ~a) {\n            this.resp = resp\n        }\n    }\n\n"
       (svc)
