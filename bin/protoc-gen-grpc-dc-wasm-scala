       (call rbDeprecated)
       (ref path)
       (stub-ref output-full)))
     (server-streaming
      (fmt
       "    def ~a(req, metadata = nil, timeout: nil)\n~a      stream = @channel.server_stream(~s, req, metadata, timeout: timeout)\n      RecvStream.new(stream, ~a)\n    end\n\n"
       (ref name)
       (call rbDeprecated)
       (ref path)
       (stub-ref output-full)))
     (client-streaming
      (fmt
       "    def ~a(reqs, metadata = nil, timeout: nil)\n~a      @channel.client_stream(~s, reqs, ~a.new, metadata, timeout: timeout)\n    end\n\n"
       (ref name)
       (call rbDeprecated)
       (ref path)
       (stub-ref output-full)))
     (bidi
      (fmt
       "    def ~a(reqs, metadata = nil, timeout: nil)\n~a      stream = @channel.bidi(~s, reqs, metadata, timeout: timeout)\n      RecvStream.new(stream, ~a)\n    end\n\n"
       (ref name)
