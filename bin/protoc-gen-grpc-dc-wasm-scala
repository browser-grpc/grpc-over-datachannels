(define java-service-program
  '((fmt "    /** Client for ~a. */\n" (ref full-name))
    (fmt "    public static final class ~aClient {\n" (ref name))
    "        private final Channel channel;\n\n"
    (fmt
     "        public ~aClient(Channel channel) {\n            this.channel = channel;\n        }\n\n"
     (ref name))
    (each+ methods client (call javaClientMethodPair))
    (each+ methods client (call javaClientAsyncMethod))
    "    }\n\n"
    (each methods (call javaClientStreamClass))
    (fmt
     "    /** Service implementation interface for ~a. */\n"
     (ref full-name))
    (fmt "    public interface ~aServer {\n" (ref name))
    (each methods (call javaServerIfaceMethod "        "))
    "    }\n\n"
    (each methods (call javaServerStreamIfaces))
    (each methods (call javaStreamImpls))
    (fmt
     "    /** Async service implementation interface for ~a. */\n"
     (ref full-name))
    (fmt "    public interface ~aServerAsync {\n" (ref name))
    (each methods (call javaServerAsyncIfaceMethod))
    "    }\n\n"
    (fmt
     "    private static final class ~aServerAsyncAdapter implements ~aServer {\n"
     (ref name)
     (ref name))
    (fmt "        private final ~aServerAsync impl;\n\n" (ref name))
    (fmt
     "        ~aServerAsyncAdapter(~aServerAsync impl) {\n            this.impl = impl;\n        }\n\n"
     (ref name)
     (ref name))
    (each methods (call javaServerAsyncAdapterMethod))
    "    }\n\n"
    (fmt
     "    /** Register an implementation of ~a on a Server. */\n"
     (ref full-name))
    (fmt
     "    public static void register~aServer(Server server, ~aServer impl) {\n"
     (ref name)
     (ref name))
    (fmt
     "        server.registerService(new Server.ServiceDesc(\n                ~s,\n                List.of(\n"
     (ref full-name))
    (trim-suffix ",\n" "" (each+ methods server (call javaRegisterMethod)))
    "\n                )));\n    }\n"
    (fmt
     "    /** Register an async implementation of ~a on a Server. */\n"
     (ref full-name))
    (fmt
     "    public static void register~aServerAsync(Server server, ~aServerAsync impl) {\n"
     (ref name)
     (ref name))
    (fmt
     "        register~aServer(server, new ~aServerAsyncAdapter(impl));\n    }\n"
     (ref name)
     (ref name))))

(define java-pb-type-program
  '((if (is-map)
      (then
       (fmt
        "java.util.Map<~a, ~a>"
        (call-on (key-field (resolved-entry)) javaPbType "boxed")
        (call-on (val-field (resolved-entry)) javaPbType "boxed")))
      (else
       (if (repeated)
         (then
          (fmt
           "java.util.List<~a>"
           (call-on (with-label (self) 1) javaPbType "boxed")))
         (else
          (case-on
           (ref type)
           ((11) (java-entry-ref))
           ((14) (java-entry-ref))
           (else
            (if (arg 0)
              (then (java-scalar-boxed))
              (else (java-scalar-type)))))))))))

(define java-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt "~a.~a" (java-entry-ref) (default-raw)))
         ((2) (fmt "~af" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define java-pb-default-program
  '((if (call javaPbExplicitLiteral)
      (then (call javaPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then "new java.util.LinkedHashMap<>()")
          (else
           (case-on
            (ref label)
            ((3) "new java.util.ArrayList<>()")
            (else
             (case-on
              (ref type)
              ((11) "null")
              ((14) (fmt "~a.~a" (java-entry-ref) (enum-first-value-name)))
              (else (java-scalar-default))))))))))))

