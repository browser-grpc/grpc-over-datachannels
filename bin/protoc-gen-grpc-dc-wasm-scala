(define cs-pb-message-program
  '((fmt
     "~a~a class ~a : IMarshaler, IUnmarshaler {\n"
     (arg 1)
     (arg 2)
     (ref name))
    (each
     fields
     (fmt
      "~a    public ~a ~a = ~a;\n"
      (arg 1)
      (call csPbType)
      (cs-field-name)
      (call csPbDefault)))
    (fmt "~a    public byte[] UnknownFields = new byte[0];\n" (arg 1))
    (fmt "~a    public ~a() {}\n" (arg 1) (ref name))
    (if (no-fields)
      (then "")
      (else
       (fmt
        "~a    public ~a(~a) {\n"
        (arg 1)
        (ref name)
        (each-sep
         ", "
         fields
         (fmt "~a ~a" (call csPbType) (lower-first (cs-field-name)))))
       (each
        fields
        (fmt
         "~a        ~a = ~a;\n"
         (arg 1)
         (cs-field-name)
         (lower-first (cs-field-name))))
       (fmt "~a    }\n" (arg 1))))
    (fmt "~a    public byte[] MarshalDc() {\n" (arg 1))
    (fmt "~a        var w = new ~a.Writer();\n" (arg 1) (arg 0))
    (each fields (call csPbEncodeGuard (arg 0)))
    (fmt "~a        w.Raw(UnknownFields);\n" (arg 1))
    (fmt "~a        return w.ToBytes();\n~a    }\n" (arg 1) (arg 1))
    (fmt "~a    public void UnmarshalDc(byte[] data) {\n" (arg 1))
    (fmt "~a        UnknownFields = new byte[0];\n" (arg 1))
    (each
     fields
     (fmt "~a        ~a = ~a;\n" (arg 1) (cs-field-name) (call csPbDefault)))
    (fmt "~a        var r = new ~a.Reader(data);\n" (arg 1) (arg 0))
    (fmt "~a        ~a.Field field;\n" (arg 1) (arg 0))
    (fmt
     "~a        while ((field = r.Next()) != null) {\n~a            switch (field.Number) {\n"
     (arg 1)
     (arg 1))
    (each fields (call csPbDecodeCase (arg 0)))
    (fmt
     "~a                default: UnknownFields = ~a.ConcatBytes(UnknownFields, field.RawValue); break;\n~a            }\n~a        }\n~a    }\n"
     (arg 1)
     (arg 0)
     (arg 1)
     (arg 1)
     (arg 1))
    (each
     nested
     (call csPbMessage (arg 0) (fmt "~a    " (arg 1)) "public sealed"))
    (each enums (call csPbNestedEnum (fmt "~a    " (arg 1))))
    (fmt "~a}\n" (arg 1))))

