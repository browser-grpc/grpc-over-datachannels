       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)))
     (client-streaming
      (fmt
       "--- Client-streaming stream passed to service implementations.\nlocal ~a~aServer = {}\n~a~aServer.__index = ~a~aServer\n\nfunction ~a~aServer.new(reqs)\n  return setmetatable({ reqs = reqs, resp = nil }, ~a~aServer)\nend\n\nfunction ~a~aServer:recv()\n  local req = ~a.new()\n  self.reqs:recvInto(req)\n  return req\nend\n\nfunction ~a~aServer:sendAndClose(resp)\n  self.resp = resp\nend\n\n"
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref input)
       (svc)
       (ref name)))
     (bidi
      (fmt
       "--- Bidi stream passed to service implementations.\nlocal ~a~aServer = {}\n~a~aServer.__index = ~a~aServer\n\nfunction ~a~aServer.new(reqs, sink)\n  return setmetatable({ reqs = reqs, sink = sink }, ~a~aServer)\nend\n\nfunction ~a~aServer:send(resp)\n  self.sink(resp:marshalDc())\nend\n\nfunction ~a~aServer:recv()\n  local req = ~a.new()\n  self.reqs:recvInto(req)\n  return req\nend\n\n"
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref input))))))

(define lua-register-method-program
  (let ((kind-const
         '(case-on
           (ref kind)
           ((unary) "KIND_UNARY")
           ((server-streaming) "KIND_SERVER_STREAMING")
           ((client-streaming) "KIND_CLIENT_STREAMING")
           ((bidi) "KIND_BIDI"))))
    (list
     (list
      'kind-case
      (list
       'unary
       (list
        'fmt
        "      {\n        name = ~s,\n        path = ~s,\n        kind = Server.~a,\n        handler = function(ctx, reqs, sink)\n          local req = ~a.new()\n          reqs:recvInto(req)\n          sink(impl:~a(ctx, req):marshalDc())\n        end,\n      },\n"
        '(ref name)
        '(ref path)
        kind-const
        '(ref input)
        (list 'lower-first '(ref impl-name))))
      (list
       'server-streaming
       (list
        'fmt
        "      {\n        name = ~s,\n        path = ~s,\n        kind = Server.~a,\n        handler = function(ctx, reqs, sink)\n          local req = ~a.new()\n          reqs:recvInto(req)\n          impl:~a(ctx, req, ~a~aServer.new(sink))\n        end,\n      },\n"
        '(ref name)
        '(ref path)
        kind-const
        '(ref input)
        (list 'lower-first '(ref impl-name))
        '(svc)
        '(ref name)))
      (list
       'client-streaming
       (list
        'fmt
        "      {\n        name = ~s,\n        path = ~s,\n        kind = Server.~a,\n        handler = function(ctx, reqs, sink)\n          local stream = ~a~aServer.new(reqs)\n          impl:~a(ctx, stream)\n          local resp = stream.resp\n          if resp == nil then\n            error(Status.new(wire.CODE_INTERNAL,\n              \"client-streaming handler never called sendAndClose\"), 0)\n          end\n          sink(resp:marshalDc())\n        end,\n      },\n"
        '(ref name)
        '(ref path)
        kind-const
        '(svc)
        '(ref name)
        (list 'lower-first '(ref impl-name))))
      (list
       'bidi
       (list
        'fmt
        "      {\n        name = ~s,\n        path = ~s,\n        kind = Server.~a,\n        handler = function(ctx, reqs, sink)\n          impl:~a(ctx, ~a~aServer.new(reqs, sink))\n        end,\n      },\n"
        '(ref name)
        '(ref path)
        kind-const
        (list 'lower-first '(ref impl-name))
        '(svc)
        '(ref name)))))))

(define lua-service-program
  '((each methods (call luaClientStreamClass))
    (each methods (call luaServerStreamClass))
    (fmt "--- Client for ~a.\n" (ref full-name))
    (fmt "local ~aClient = {}\n" (ref name))
    (fmt "~aClient.__index = ~aClient\n\n" (ref name) (ref name))
    (fmt "function ~aClient.new(channel)\n" (ref name))
    (fmt "  return setmetatable({ channel = channel }, ~aClient)\n" (ref name))
    "end\n\n"
    (each+ methods client (call luaClientMethod))
    (each methods (call luaCoroClientStreamClass))
    (fmt "--- Coroutine client for ~a.\n" (ref full-name))
    (fmt "local ~aClientCoro = {}\n" (ref name))
    (fmt "~aClientCoro.__index = ~aClientCoro\n\n" (ref name) (ref name))
    (fmt "function ~aClientCoro.new(channel)\n" (ref name))
    (fmt
     "  return setmetatable({ channel = channelModule.CoroutineChannel.new(channel) }, ~aClientCoro)\n"
     (ref name))
    "end\n\n"
    (each+ methods client (call luaCoroClientMethod))))

(define lua-pb-explicit-literal-program
  '((if (has-default)
      (then
       (fmt
        "~a"
        (case-on
         (ref type)
         ((9) (fmt "~s" (default-raw)))
         ((8) (default-raw))
         ((14) (fmt "~a" (enum-default-num)))
         ((2) (fmt "~a" (default-raw)))
         (else (default-raw)))))
      (else ""))))

(define lua-pb-default-program
  '((if (call luaPbExplicitLiteral)
      (then (call luaPbExplicitLiteral))
      (else
       (fmt
        "~a"
        (if (is-map)
          (then "{}")
          (else
           (case-on
            (ref label)
            ((3) "{}")
            (else
             (case-on
              (ref type)
              ((11) "nil")
              ((9) "\"\"")
              ((12) "\"\"")
              ((8) "false")
              ((14) (fmt "~a" (enum-first-value-num)))
              (else "0")))))))))))

(define lua-pb-varint-expr-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((8) (fmt "(~a and 1 or 0)" (arg 0)))
      ((17) (fmt "((bxor(~a << 1, ~a >> 31)) & 0xffffffff)" (arg 0) (arg 0)))
      ((18) (fmt "(bxor(~a << 1, -(~a >> 63)))" (arg 0) (arg 0)))
      (else (arg 0))))))

(define lua-pb-varint-decode-program
  '((fmt
     "~a"
     (case-on
      (ref type)
      ((5 14)
       (fmt
        "((~a & 0xffffffff) >= 0x80000000 and (~a & 0xffffffff) - 0x100000000 or (~a & 0xffffffff))"
        (arg 0)
        (arg 0)
        (arg 0)))
      ((13 7) (fmt "(~a & 0xffffffff)" (arg 0)))
      ((8) (fmt "(~a ~~= 0)" (arg 0)))
      ((17)
       (fmt
        "(((bxor(~a >> 1, -(~a & 1))) & 0xffffffff) >= 0x80000000 and ((bxor(~a >> 1, -(~a & 1))) & 0xffffffff) - 0x100000000 or ((bxor(~a >> 1, -(~a & 1))) & 0xffffffff))"
        (arg 0)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg 0)
        (arg 0)))
      ((18) (fmt "(bxor(~a >> 1, -(~a & 1)))" (arg 0) (arg 0)))
      (else (arg 0))))))

(define lua-pb-nonzero-program
  '((fmt
     "~a"
     (case-on (ref type) ((8) (arg 0)) (else (fmt "~a ~~= 0" (arg 0)))))))

(define lua-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~aw:tag(~a, 0) w:varint(~a)\n"
          (arg 1)
          (ref number)
          (call luaPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aif ~a then w:tag(~a, 0) w:varint(~a) end\n"
          (arg 1)
          (call luaPbNonzero (arg 0))
          (ref number)
          (call luaPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aw:tag(~a, ~a) w:fixed(~s, ~a)\n"
          (arg 1)
          (ref number)
          (lua-fixed-wire)
          (lua-fixed-fmt)
          (arg 0)))
        (else
         (fmt
          "~aif ~a ~~= 0 then w:tag(~a, ~a) w:fixed(~s, ~a) end\n"
          (arg 1)
          (arg 0)
          (ref number)
          (lua-fixed-wire)
          (lua-fixed-fmt)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then (fmt "~aw:bytesField(~a, ~a)\n" (arg 1) (ref number) (arg 0)))
        (else (fmt "~aw:stringField(~a, ~a)\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw:bytesField(~a, ~a)\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif #~a > 0 then w:bytesField(~a, ~a) end\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif ~a ~~= nil then w:bytesField(~a, ~a:marshalDc()) end\n"
       (arg 1)
       (arg 0)
       (ref number)
       (arg 0)))
     (else (fail)))))

(define lua-pb-set-expr-program
  '((case-on
     (ref type)
     ((11 10) (fmt "self.~a ~~= nil" (lua-field-name)))
     ((9 12) (fmt "#self.~a > 0" (lua-field-name)))
     (else (call luaPbNonzero (fmt "self.~a" (lua-field-name)))))))

(define lua-pb-encode-guard-program
  '((guarded
     luaPbSetExpr
     "    if not (~a) then\n"
     "    end\n"
     (join " or ")
     (call luaPbEncodeField))))

(define lua-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "    do\n      local keys = {}\n      for k in pairs(~a) do keys[#keys + 1] = k end\n      table.sort(keys)\n      for _, k in ipairs(keys) do w:bytesField(~a, ~aEncode(k, ~a[k])) end\n    end\n"
        (fmt "self.~a" (lua-field-name))
        (ref number)
        (lua-entry-flat)
        (fmt "self.~a" (lua-field-name))))
      (else
       (if (repeated)
         (then
          (fmt
           "~a"
           (case-on
            (category)
            ("varint"
             (fmt
              "~a~a~a"
              (fmt
               "    if #~a > 0 then\n      local payload = {}\n"
               (fmt "self.~a" (lua-field-name)))
              (fmt
               "      for _, x in ipairs(~a) do payload[#payload + 1] = varintBytes(~a) end\n"
               (fmt "self.~a" (lua-field-name))
               (call luaPbVarintExpr "x"))
              (fmt
               "      w:bytesField(~a, table.concat(payload))\n    end\n"
               (ref number))))
            ("fixed"
             (fmt
              "~a~a~a"
              (fmt
               "    if #~a > 0 then\n      local payload = {}\n"
               (fmt "self.~a" (lua-field-name)))
              (fmt
               "      for _, x in ipairs(~a) do payload[#payload + 1] = string.pack(~s, x) end\n"
               (fmt "self.~a" (lua-field-name))
               (lua-fixed-fmt))
              (fmt
               "      w:bytesField(~a, table.concat(payload))\n    end\n"
               (ref number))))
            ("string"
             (fmt
              "    for _, x in ipairs(~a) do w:bytesField(~a, x) end\n"
              (fmt "self.~a" (lua-field-name))
              (ref number)))
            ("bytes"
             (fmt
              "    for _, x in ipairs(~a) do w:bytesField(~a, x) end\n"
              (fmt "self.~a" (lua-field-name))
              (ref number)))
            ("message"
             (fmt
              "    for _, x in ipairs(~a) do w:bytesField(~a, x:marshalDc()) end\n"
              (fmt "self.~a" (lua-field-name))
              (ref number)))
            (else (fail)))))
         (else
          (call
           luaPbEncodeSingular
           (fmt "self.~a" (lua-field-name))
           "    ")))))))

(define lua-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call luaPbVarintDecode (arg 1))))
     ("fixed"
      (fmt
       "~a~a = string.unpack(~s, ~a)\n"
       (arg 2)
       (arg 0)
       (lua-fixed-fmt)
       (arg 1)))
     ("string" (fmt "~a~a = ~a\n" (arg 2) (arg 0) (arg 1)))
     ("bytes" (fmt "~a~a = ~a\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt "~a~a = ~a.new()\n" (arg 2) (arg 0) (lua-entry-flat))
      (fmt "~a~a:unmarshalDc(~a)\n" (arg 2) (arg 0) (arg 1)))
     (else (fail)))))

(define lua-pb-clearing-program
  '((each-siblings
     (fmt "      self.~a = ~a\n" (lua-field-name) (call luaPbDefault)))))

(define lua-pb-src-expr
  '(case-on
    (category)
    ("varint" "field.varintValue")
    ("fixed" "field.fixedValue")
    (else "field.bytesValue")))

(define lua-pb-decode-case-program
  (list
   (list
    'if
    '(is-map)
    (list
     'then
     (list 'fmt "    elseif field.number == ~a then\n" '(ref number))
     (list
      'fmt
      "      local kk, vv = ~aDecode(field.bytesValue)\n"
      '(lua-entry-flat))
     (list 'fmt "      ~a[kk] = vv\n" (list 'fmt "self.~a" '(lua-field-name))))
    (list
     'else
     (list 'fmt "    elseif field.number == ~a then\n" '(ref number))
     (list
      'if
      '(repeated)
      (list
       'then
       (list
        'case-on
        '(category)
        (list
         "varint"
         "      if field.wire == 2 then\n"
         "        local sub = Reader.new(field.bytesValue)\n"
         "        while not sub:done() do\n"
         "          local raw = sub:varint()\n"
         (list
          'fmt
          "          ~a[#~a + 1] = ~a\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'call 'luaPbVarintDecode "raw"))
         "        end\n      else\n"
         (list
          'fmt
          "        ~a[#~a + 1] = ~a\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'call 'luaPbVarintDecode "field.varintValue"))
         "      end\n")
        (list
         "fixed"
         "      if field.wire == 2 then\n"
         (list 'fmt "        local payload = field.bytesValue\n")
         (list 'fmt "        for i = 1, #payload, ~a do\n" '(lua-fixed-size))
         (list
          'fmt
          "          ~a[#~a + 1] = string.unpack(~s, payload, i)\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))
          '(lua-fixed-fmt))
         "        end\n      else\n"
         (list
          'fmt
          "        ~a[#~a + 1] = string.unpack(~s, field.fixedValue)\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))
          '(lua-fixed-fmt))
         "      end\n")
        (list
         "string"
         (list
          'fmt
          "      ~a[#~a + 1] = field.bytesValue\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))))
        (list
         "bytes"
         (list
          'fmt
          "      ~a[#~a + 1] = field.bytesValue\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))))
        (list
         "message"
         (list 'fmt "      local item = ~a.new()\n" '(lua-entry-flat))
         "      item:unmarshalDc(field.bytesValue)\n"
         (list
          'fmt
          "      ~a[#~a + 1] = item\n"
          (list 'fmt "self.~a" '(lua-field-name))
          (list 'fmt "self.~a" '(lua-field-name))))
        (list 'else '(fail))))
      (list
       'else
       '(call luaPbClearing)
       (list
        'call
        'luaPbDecodeSingular
        (list 'fmt "self.~a" '(lua-field-name))
        lua-pb-src-expr
        "      ")))))))

(define lua-pb-map-val-decode-program
  '((case-on
     (ref type)
     ((11)
      (fmt
       "      value = ~a.new()\n      value:unmarshalDc(field.bytesValue)\n"
       (lua-entry-flat)))
     (else
      (call
       luaPbDecodeSingular
       "value"
       (case-on
        (category)
        ("varint" "field.varintValue")
        ("fixed" "field.fixedValue")
        (else "field.bytesValue"))
       "      ")))))

(define lua-pb-map-key-head-program
  '((fmt "    if field.number == ~a then\n" (ref number))))

(define lua-pb-map-val-head-program
  '((fmt "    elseif field.number == ~a then\n" (ref number))))

(define lua-pb-map-key-decode-program
  '((call
     luaPbDecodeSingular
     "key"
     (case-on
      (category)
      ("varint" "field.varintValue")
      ("fixed" "field.fixedValue")
      (else "field.bytesValue"))
     "      ")))

(define lua-pb-map-helpers-program
  '((fmt
     "~aEncode = function(key, value)\n  local w = Writer.new()\n"
     (lua-entry-flat))
    (call-on (key-field) luaPbEncodeSingular "key" "  ")
    (call-on (val-field) luaPbEncodeSingular "value" "  ")
    "  return w:toBytes()\nend\n\n"
    (fmt "~aDecode = function(data)\n" (lua-entry-flat))
    (fmt
     "  local key = ~a\n  local value = ~a\n"
     (call-on (key-field) luaPbDefault)
     (call-on (val-field) luaPbDefault))
    "  local r = Reader.new(data)\n  while true do\n    local field = r:next()\n    if field == nil then break end\n"
    (call-on (key-field) luaPbMapKeyHead)
    (call-on (key-field) luaPbMapKeyDecode)
    (call-on (val-field) luaPbMapValHead)
    (call-on (val-field) luaPbMapValDecode)
    "    end\n  end\n  return key, value\nend\n\n"))

(define lua-pb-message-program
  '((fmt "~a = {}\n~a.__index = ~a\n\n" (flat) (flat) (flat))
    (fmt
     "function ~a.new(~a)\n  return setmetatable({ ~a~aunknownFields = \"\" }, ~a)\nend\n\n"
     (flat)
     (each-sep ", " fields (lua-field-name))
     (each-sep
      ", "
      fields
      (fmt
       "~a = ~a or ~a"
       (lua-field-name)
       (lua-field-name)
       (call luaPbDefault)))
     (if (no-fields) (then "") (else ", "))
     (flat))
    (fmt "function ~a:marshalDc()\n  local w = Writer.new()\n" (flat))
    (each fields (call luaPbEncodeGuard))
    "  w:raw(self.unknownFields)\n  return w:toBytes()\nend\n\n"
    (fmt "function ~a:unmarshalDc(data)\n" (flat))
    "  self.unknownFields = \"\"\n"
    (each fields (fmt "  self.~a = ~a\n" (lua-field-name) (call luaPbDefault)))
    "  local r = Reader.new(data)\n  while true do\n    local field = r:next()\n    if field == nil then break end\n    if false then\n"
    (each fields (call luaPbDecodeCase))
    "    else\n      self.unknownFields = self.unknownFields .. field.rawValue\n    end\n  end\nend\n\n"
    (each nested (call luaPbMessage))))

(define lua-pb-enum-program
  '((fmt
     "local ~a = { ~a }\n\n"
     (lua-enum-flat)
     (each-sep ", " values (fmt "~a = ~a" (ref name) (ref number))))))

(define zig-deprecated-program
  '((if (ref deprecated)
      (then (fmt "~a/// Deprecated in the proto schema.\n" (arg 0)))
      (else ""))))

(define zig-client-method-raw-program
  '((kind-case
     (unary
      (fmt
       "    pub fn ~a(self: *~aClient, req: *const ~a, call_metadata: ?*const Metadata, timeout_ms: ?u64) status_mod.CallResult(~a) {\n        var resp = ~a{};\n        const st = self.channel.unary(~s, req, &resp, call_metadata, timeout_ms);\n        if (!st.isOk()) return .{ .status = st };\n        return .{ .ok = resp };\n    }\n\n"
       (lower-first (ref name))
       (svc)
       (ref input)
       (ref output)
       (ref output)
       (ref path)))
     (server-streaming
      (fmt
       "    pub fn ~a(self: *~aClient, req: *const ~a, call_metadata: ?*const Metadata, timeout_ms: ?u64) status_mod.CallResult(~a~aClient) {\n        switch (self.channel.serverStream(~s, req, call_metadata, timeout_ms)) {\n            .ok => |stream| return .{ .ok = .{ .stream = stream } },\n            .status => |st| return .{ .status = st },\n        }\n    }\n\n"
       (lower-first (ref name))
       (svc)
       (ref input)
       (svc)
       (ref name)
       (ref path)))
     (client-streaming
      (fmt
       "    pub fn ~a(self: *~aClient, reqs: []const ~a, call_metadata: ?*const Metadata, timeout_ms: ?u64) status_mod.CallResult(~a) {\n        var resp = ~a{};\n        const st = self.channel.clientStreamCall(~s, reqs, &resp, call_metadata, timeout_ms);\n        if (!st.isOk()) return .{ .status = st };\n        return .{ .ok = resp };\n    }\n\n"
       (lower-first (ref name))
       (svc)
       (ref input)
       (ref output)
       (ref output)
       (ref path)))
     (bidi
      (fmt
       "    pub fn ~a(self: *~aClient, reqs: []const ~a, call_metadata: ?*const Metadata, timeout_ms: ?u64) status_mod.CallResult(~a~aClient) {\n        switch (self.channel.bidi(~s, reqs, call_metadata, timeout_ms)) {\n            .ok => |stream| return .{ .ok = .{ .stream = stream } },\n            .status => |st| return .{ .status = st },\n        }\n    }\n\n"
       (lower-first (ref name))
       (svc)
       (ref input)
       (svc)
       (ref name)
       (ref path))))))

(define zig-client-method-program
  (append zig-deprecated-program zig-client-method-raw-program))

(define zig-stream-class-body
  (list
   (list
    'fmt
    "/// Response stream of a ~a call.\npub const ~a~aClient = struct {\n    stream: ClientStream,\n\n    pub fn recv(self: *~a~aClient) status_mod.RecvResult(~a) {\n        var resp = ~a{};\n        switch (self.stream.recvInto(&resp)) {\n            .message => return .{ .message = resp },\n            .end => return .end,\n            .status => |st| return .{ .status = st },\n        }\n    }\n\n    /// Initial metadata (response headers); null until they arrive.\n    pub fn headers(self: *~a~aClient) ?grpcdc.codec.Headers {\n        return self.stream.headers;\n    }\n\n    /// Trailing metadata of the terminal status.\n    pub fn trailers(self: *~a~aClient) []const status_mod.TrailerPair {\n        return self.stream.trailers;\n    }\n\n    /// Abandon the call: RST so the server stops producing.\n    pub fn cancel(self: *~a~aClient) void {\n        self.stream.cancel();\n    }\n\n    pub fn deinit(self: *~a~aClient) void {\n        self.stream.deinit();\n    }\n};\n\n"
    '(ref name)
    '(svc)
    '(ref name)
    '(svc)
    '(ref name)
    '(ref output)
    '(ref output)
    '(svc)
    '(ref name)
    '(svc)
    '(ref name)
    '(svc)
    '(ref name)
    '(svc)
    '(ref name))))

(define zig-client-stream-class-program
  (list
   (append
    (list
     'kind-case
     (append (list '(server-streaming bidi)) zig-stream-class-body)
     (list 'else "")))))

(define zig-server-stream-struct-program
  '((kind-case
     (unary "")
     (server-streaming
      (fmt
       "/// Sends responses of a ~a call.\npub const ~a~aServer = struct {\n    sink: server_mod.Sink,\n    alloc: std.mem.Allocator,\n\n    pub fn send(self: *~a~aServer, resp: *const ~a) Status {\n        const payload = resp.marshalDc(self.alloc);\n        defer self.alloc.free(payload);\n        return self.sink.send(payload);\n    }\n};\n\n"
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref output)))
     (client-streaming
      (fmt
       "/// Receives requests of a ~a call.\npub const ~a~aServer = struct {\n    reqs: *server_mod.RequestStream,\n    alloc: std.mem.Allocator,\n    resp: ?~a = null,\n\n    pub fn recv(self: *~a~aServer) status_mod.RecvResult(~a) {\n        var req = ~a{};\n        switch (self.reqs.recvInto(&req)) {\n            .message => return .{ .message = req },\n            .end => return .end,\n            .status => |st| return .{ .status = st },\n        }\n    }\n\n    pub fn sendAndClose(self: *~a~aServer, resp: ~a) void {\n        self.resp = resp;\n    }\n};\n\n"
       (ref name)
       (svc)
       (ref name)
       (ref output)
       (svc)
       (ref name)
       (ref input)
       (ref input)
       (svc)
       (ref name)
       (ref output)))
     (bidi
      (fmt
       "/// Full-duplex stream of a ~a call.\npub const ~a~aServer = struct {\n    reqs: *server_mod.RequestStream,\n    sink: server_mod.Sink,\n    alloc: std.mem.Allocator,\n\n    pub fn recv(self: *~a~aServer) status_mod.RecvResult(~a) {\n        var req = ~a{};\n        switch (self.reqs.recvInto(&req)) {\n            .message => return .{ .message = req },\n            .end => return .end,\n            .status => |st| return .{ .status = st },\n        }\n    }\n\n    pub fn send(self: *~a~aServer, resp: *const ~a) Status {\n        const payload = resp.marshalDc(self.alloc);\n        defer self.alloc.free(payload);\n        return self.sink.send(payload);\n    }\n};\n\n"
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref input)
       (ref input)
       (svc)
       (ref name)
       (ref output))))))

