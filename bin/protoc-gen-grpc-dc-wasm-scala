(define cpp-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{ w.Tag(~a, 0); w.Varint(~a); }\n"
          (arg 1)
          (ref number)
          (call cppPbVarintExpr (arg 0))))
        (else
         (fmt
          "~aif (~a) { w.Tag(~a, 0); w.Varint(~a); }\n"
          (arg 1)
          (call cppPbNonzero (arg 0))
          (ref number)
          (call cppPbVarintExpr (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{ w.Tag(~a, ~a); w.Fixed~a(~a); }\n"
          (arg 1)
          (ref number)
          (case-on (cpp-fixed-size) ((8) "1") (else "5"))
          (cpp-fixed-name)
          (arg 0)))
        (else
         (fmt
          "~aif (~a) { w.Tag(~a, ~a); w.Fixed~a(~a); }\n"
          (arg 1)
          (call cppPbNonzero (arg 0))
          (ref number)
          (case-on (cpp-fixed-size) ((8) "1") (else "5"))
          (cpp-fixed-name)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aw.BytesField(~a, grpcdc::Bytes(~a.begin(), ~a.end()));\n"
          (arg 1)
          (ref number)
          (arg 0)
          (arg 0)))
        (else
         (fmt "~aw.StringField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then (fmt "~aw.BytesField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))
        (else
         (fmt
          "~aif (!~a.empty()) w.BytesField(~a, ~a);\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif (~a) w.BytesField(~a, ~a->MarshalDc());\n"
       (arg 1)
       (arg 0)
       (ref number)
       (arg 0)))
     (else (fail)))))

