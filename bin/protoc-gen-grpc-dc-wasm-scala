(define (seg-cpp-stub-type m full-key)
  (define full (hash-ref m full-key))
  (define pkg (seg-cpp-pkg))
  (if (or (string=? pkg "")
          (not (string-contains? full "."))
          (string-prefix? full (string-append pkg ".")))
    (hash-ref m (if (eq? full-key 'input-full) 'input 'output))
    (string-append "::" (string-join (string-split full ".") "::"))))

(define (seg-cpp-rel pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "::"))

(define (seg-cpp-ns pkg)
  (if (string=? pkg "") "proto" (string-join (string-split pkg ".") "::")))

(define (seg-cpp-entry-ref model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (define rel
    (if (eq? (hash-ref entry 'kind) 'enum)
      (let ((e (hash-ref entry 'enum)))
        (if (hash-ref entry 'msg)
          (string-append
           (seg-cpp-rel
            (hash-ref entry 'pkg)
            (hash-ref (hash-ref entry 'msg) 'full-name))
           "::"
           (hash-ref e 'name))
          (seg-cpp-rel
           (hash-ref entry 'pkg)
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name)))))
      (seg-cpp-rel
       (hash-ref entry 'pkg)
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (equal? (hash-ref entry 'file) (hash-ref model 'name))
    rel
    (string-append "::" (seg-cpp-ns (hash-ref entry 'pkg)) "::" rel)))

(define (seg-cpp-map-name model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (string-join
   (string-split
    (seg-cpp-rel
     (hash-ref entry 'pkg)
     (hash-ref (hash-ref entry 'msg) 'full-name))
    "::")
   ""))

(define (seg-cs-pascal s)
  (string-join
   (map
    (lambda (part)
      (if (string=? part "")
        ""
        (string-append
         (string (char-upcase (string-ref part 0)))
         (substring part 1))))
    (string-split s "_"))
   ""))

(define (seg-cs-field-name model f)
  (define n (seg-cs-pascal (hash-ref f 'name)))
  (define owner (field-owner model f))
  (if (and owner
           (or (equal? n (hash-ref owner 'name))
               (member
                n
                (map (lambda (m) (hash-ref m 'name)) (hash-ref owner 'nested)))
               (member
                n
                (map
                 (lambda (e) (hash-ref e 'name))
                 (hash-ref owner 'enums)))))
    (string-append n "_")
    n))

(define (seg-cs-rel pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "."))

(define (seg-cs-entry-ref model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (define rel
    (if (eq? (hash-ref entry 'kind) 'enum)
      (let ((e (hash-ref entry 'enum)))
        (if (hash-ref entry 'msg)
          (string-append
           (seg-cs-rel
            (hash-ref entry 'pkg)
            (hash-ref (hash-ref entry 'msg) 'full-name))
           "."
           (hash-ref e 'name))
          (seg-cs-rel
           (hash-ref entry 'pkg)
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name)))))
      (seg-cs-rel
       (hash-ref entry 'pkg)
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (equal? (hash-ref entry 'file) (hash-ref model 'name))
    rel
    (string-append
     (if (string=? (hash-ref entry 'pkg) "")
       "Proto"
       (let ((s (hash-ref entry 'pkg)))
         (string-append
          (string (char-upcase (string-ref s 0)))
          (substring s 1))))
     "."
     rel)))

(define (seg-cs-map-name model node)
  (define entry
    (if (hash-has-key? node 'type-name)
      (seg-resolve model (hash-ref node 'type-name))
      node))
  (string-join
   (string-split
    (seg-cs-rel
     (hash-ref entry 'pkg)
     (hash-ref (hash-ref entry 'msg) 'full-name))
    ".")
   ""))

(define (seg-kt-rel pkg full)
