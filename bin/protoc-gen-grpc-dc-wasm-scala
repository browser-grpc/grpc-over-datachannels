       (then (fmt "    m->~a = ~a;\n" (ref name) (call cPbDefault (arg 0))))
       (else "")))
    "}\n\n"
    (fmt
     "static inline ~aBytes ~a_marshal(const ~a *m) {\n    ~aWriter w; ~a_writer_init(&w);\n"
     (arg 0)
     (flat)
     (flat)
     (arg 0)
     (arg 0))
    (each
     fields
     (guarded
      cPbSetExpr
      "    if (!(~a)) {\n"
      "    }\n"
      (call cPbEncodeField (arg 0))))
    (fmt
     "    ~a_writer_raw(&w, m->unknown_fields.data, m->unknown_fields.len);\n    return ~a_writer_to_bytes(&w);\n}\n\n"
     (arg 0)
     (arg 0))
    (fmt
