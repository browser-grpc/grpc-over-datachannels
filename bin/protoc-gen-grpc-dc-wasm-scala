(define cpp-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "    if (!~a.empty()) for (const auto& e : ~a) w.BytesField(~a, ~a(e.first, e.second));\n"
        (ref name)
        (ref name)
        (ref number)
        (fmt "~a::~aEncode" (arg 0) (cpp-map-name))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt "    if (!~a.empty()) {\n" (ref name))
            (fmt "        ~a::Writer payload;\n" (arg 0))
