       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (cpp-stub-type 'input-full)
       (cpp-stub-type 'input-full)
       (cpp-stub-type 'output-full)
       (cpp-stub-type 'output-full)
       (cpp-stub-type 'output-full)))
     (bidi
