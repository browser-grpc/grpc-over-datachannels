      ((18) (fmt "((~a << 1) ^ (~a >> 63))" (arg 0) (arg 0)))
      ((14) (fmt "(int) ~a" (arg 0)))
      ((4) (fmt "(long) ~a" (arg 0)))
      (else (arg 0))))))

