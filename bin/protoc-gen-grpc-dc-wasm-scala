(define rs-pb-type-program
  '((if (is-map)
      (then
       (fmt
        "~a<~a, ~a>"
        (rs-map-type)
        (call-on (key-field (resolved-entry)) rsPbElemType)
        (call-on (val-field (resolved-entry)) rsPbElemType)))
      (else
       (if (repeated)
         (then (fmt "Vec<~a>" (call rsPbElemType)))
         (else
          (if (type-is 11)
            (then (fmt "Option<Box<~a>>" (call rsPbElemType)))
            (else (call rsPbElemType)))))))))

(define rs-pb-default-program
  '((if (is-map)
      (then (fmt "~a::new()" (rs-map-type)))
      (else
       (if (repeated)
         (then "Vec::new()")
         (else
          (case-on
           (type)
           (11 "None")
           (9 "String::new()")
           (12 "Vec::new()")
           (8 "false")
           ((1 2) "0.0")
           (14
            (if (has-default)
              (then (fmt "~a::~a" (rs-entry-ref) (rs-camel (default-raw))))
              (else
               (fmt
                "~a::~a"
                (rs-entry-ref)
                (rs-camel (enum-first-value-name))))))
           (else (if (has-default) (then (default-raw)) (else "0"))))))))))

(define rs-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{ pb_append_tag(&mut out, ~a, 0); pb_append_varint(&mut out, ~a); }\n"
          (arg 1)
          (ref number)
          (if (type-is 14)
            (then (fmt "(~a.to_i32() as u64)" (arg 0)))
            (else (call rsPbVarintExpr (arg 0))))))
        (else
         (fmt
          "~aif ~a { pb_append_tag(&mut out, ~a, 0); pb_append_varint(&mut out, ~a); }\n"
          (arg 1)
          (if (type-is 8)
            (then (arg 0))
            (else
             (fmt
              "~a != ~a"
              (arg 0)
              (call-on (with-label (self) 1) rsPbDefault))))
          (ref number)
          (if (type-is 14)
            (then (fmt "(~a.to_i32() as u64)" (arg 0)))
            (else (call rsPbVarintExpr (arg 0))))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{ pb_append_tag(&mut out, ~a, ~a); ~a }\n"
          (arg 1)
          (ref number)
          (case-on (rs-fixed-size) (8 "1") (else "5"))
          (call rsPbFixedEncode (arg 0))))
        (else
         (fmt
          "~aif ~a != ~a { pb_append_tag(&mut out, ~a, ~a); ~a }\n"
          (arg 1)
          (arg 0)
          (call-on (with-label (self) 1) rsPbDefault)
          (ref number)
          (case-on (rs-fixed-size) (8 "1") (else "5"))
          (call rsPbFixedEncode (arg 0))))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~apb_append_bytes_field(&mut out, ~a, ~a.as_bytes());\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~apb_append_string_field(&mut out, ~a, &~a);\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~apb_append_bytes_field(&mut out, ~a, &~a);\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif !~a.is_empty() { pb_append_bytes_field(&mut out, ~a, &~a); }\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))))
     ("message"
      (fmt
       "~aif let Some(v) = &~a { pb_append_bytes_field(&mut out, ~a, &v.encode()); }\n"
       (arg 1)
       (arg 0)
       (ref number)))
     (else (fail)))))

(define rs-pb-set-expr-program
  '((case-on
     (type)
     ((11 10) (fmt "self.~a.is_some()" (rs-field-name)))
     ((9 12) (fmt "!self.~a.is_empty()" (rs-field-name)))
     (8 (fmt "self.~a" (rs-field-name)))
     (14 (fmt "self.~a.to_i32() != 0" (rs-field-name)))
     ((1 2) (fmt "self.~a != 0.0" (rs-field-name)))
     (else (fmt "self.~a != 0" (rs-field-name))))))

(define rs-pb-oneof-clearing-program
  '((each-siblings
     (fmt
      "                    msg.~a = ~a;\n"
      (rs-field-name)
      (call rsPbDefault)))))

(define rs-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "        { let mut keys: Vec<&_> = self.~a.keys().collect(); keys.sort(); for k in keys { let val = &self.~a[k]; pb_append_bytes_field(&mut out, ~a, &~a(k, val)); } }\n"
        (rs-field-name)
        (rs-field-name)
        (ref number)
        (fmt "pb_encode_~a" (rs-entry-ref))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "        if !self.~a.is_empty() {\n            let mut payload = Vec::new();\n            for x in &self.~a { pb_append_varint(&mut payload, ~a); }\n            pb_append_bytes_field(&mut out, ~a, &payload);\n        }\n"
             (rs-field-name)
             (rs-field-name)
             (if (type-is 14)
               (then "((*x).to_i32() as u64)")
               (else (call rsPbVarintExpr "(*x)")))
             (ref number)))
           ("fixed"
            (fmt
             "        if !self.~a.is_empty() {\n            let mut payload = Vec::new();\n            for x in &self.~a { ~a }\n            pb_append_bytes_field(&mut out, ~a, &payload);\n        }\n"
             (rs-field-name)
             (rs-field-name)
             (call rsPbFixedEncodePayload "(*x)")
             (ref number)))
           ("string"
            (fmt
             "        for x in &self.~a { pb_append_bytes_field(&mut out, ~a, x.as_bytes()); }\n"
             (rs-field-name)
             (ref number)))
           ("bytes"
            (fmt
             "        for x in &self.~a { pb_append_bytes_field(&mut out, ~a, x); }\n"
             (rs-field-name)
             (ref number)))
           ("message"
            (fmt
             "        for x in &self.~a { pb_append_bytes_field(&mut out, ~a, &x.encode()); }\n"
             (rs-field-name)
             (ref number)))
           (else (fail))))
         (else
          (call
           rsPbEncodeSingular
           (fmt "self.~a" (rs-field-name))
           "        ")))))))

(define rs-pb-decode-singular-program
  '((case-on
     (category)
     ("varint"
      (fmt
       "~a~a = ~a;\n"
       (arg 2)
       (arg 0)
       (if (type-is 14)
         (then (fmt "~a::from_i32(~a as i32)" (rs-entry-ref) (arg 1)))
         (else (call rsPbVarintDecode (arg 1))))))
     ("fixed"
      (fmt "~a~a = ~a;\n" (arg 2) (arg 0) (call rsPbFixedDecode (arg 1))))
     ("string"
      (fmt
       "~a~a = String::from_utf8_lossy(&~a).into_owned();\n"
       (arg 2)
       (arg 0)
       (arg 1)))
     ("bytes" (fmt "~a~a = ~a;\n" (arg 2) (arg 0) (arg 1)))
     ("message"
      (fmt
       "~a~a = Some(Box::new(~a::decode(&~a)?));\n"
       (arg 2)
       (arg 0)
       (rs-entry-ref)
       (arg 1)))
     (else (fail)))))

(define rs-pb-decode-singular-kv-program
  '((case-on
     (category)
     ("varint"
      (fmt
       "~a~a = ~a;\n"
       (arg 2)
       (arg 0)
       (if (type-is 14)
         (then
          (fmt
           "~a::from_i32(~a as i32)"
           (rs-entry-ref)
           (fmt "~a.varint_value" (arg 1))))
         (else (call rsPbVarintDecode (fmt "~a.varint_value" (arg 1)))))))
     ("fixed"
      (fmt
       "~a~a = ~a;\n"
       (arg 2)
       (arg 0)
       (call rsPbFixedDecode (fmt "~a.fixed_value" (arg 1)))))
     ("string"
      (fmt
       "~a~a = String::from_utf8_lossy(&~a).into_owned();\n"
       (arg 2)
       (arg 0)
       (fmt "~a.bytes_value" (arg 1))))
     ("bytes"
      (fmt
       "~a~a = ~a.clone();\n"
       (arg 2)
       (arg 0)
       (fmt "~a.bytes_value" (arg 1))))
     ("message"
      (fmt
       "~a~a = ~a::decode(&~a)?;\n"
       (arg 2)
       (arg 0)
       (rs-entry-ref)
       (fmt "~a.bytes_value" (arg 1))))
     (else (fail)))))

(define rs-pb-decode-case-program
  '((if (is-map)
      (then
       (fmt
        "                ~a => {\n                    let (kk, vv) = ~a(&field.bytes_value)?;\n                    msg.~a.insert(kk, vv);\n                }\n"
        (ref number)
        (fmt "pb_decode_~a" (rs-entry-ref))
        (rs-field-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "                ~a => {\n                    if field.wire == 2 {\n                        let mut sub = PbReader::new(&field.bytes_value);\n                        while !sub.done() {\n                            let raw = sub.varint()?;\n                            msg.~a.push(~a);\n                        }\n                    } else {\n                        msg.~a.push(~a);\n                    }\n                }\n"
             (ref number)
             (rs-field-name)
             (if (type-is 14)
               (then (fmt "~a::from_i32(raw as i32)" (rs-entry-ref)))
               (else (call rsPbVarintDecode "raw")))
             (rs-field-name)
             (if (type-is 14)
               (then
                (fmt "~a::from_i32(field.varint_value as i32)" (rs-entry-ref)))
               (else (call rsPbVarintDecode "field.varint_value")))))
           ("fixed"
            (fmt
             "                ~a => {\n                    if field.wire == 2 {\n                        let mut i = 0;\n                        while i < field.bytes_value.len() {\n                            let mut padded = [0u8; 8];\n                            padded[..~a].copy_from_slice(&field.bytes_value[i..i + ~a]);\n                            let chunk = u64::from_le_bytes(padded);\n                            msg.~a.push(~a);\n                            i += ~a;\n                        }\n                    } else {\n                        msg.~a.push(~a);\n                    }\n                }\n"
             (ref number)
             (rs-fixed-size)
             (rs-fixed-size)
             (rs-field-name)
             (case-on
              (rs-fixed-size)
              (4 (call rsPbFixedDecode32 "chunk"))
              (else (call rsPbFixedDecode "chunk")))
             (rs-fixed-size)
             (rs-field-name)
             (call rsPbFixedDecode "field.fixed_value")))
           ("string"
            (fmt
             "                ~a => {\n                    msg.~a.push(String::from_utf8_lossy(&field.bytes_value).into_owned());\n                }\n"
             (ref number)
             (rs-field-name)))
           ("bytes"
            (fmt
             "                ~a => {\n                    msg.~a.push(field.bytes_value.clone());\n                }\n"
             (ref number)
             (rs-field-name)))
           ("message"
            (fmt
             "                ~a => {\n                    msg.~a.push(~a::decode(&field.bytes_value)?);\n                }\n"
             (ref number)
             (rs-field-name)
             (rs-entry-ref)))
           (else (fail))))
         (else
          (fmt
           "                ~a => {\n~a~a                }\n"
           (ref number)
           (call rsPbOneofClearing)
           (call
            rsPbDecodeSingular
            (fmt "msg.~a" (rs-field-name))
            (case-on
             (category)
             ("varint" "field.varint_value")
             ("fixed" "field.fixed_value")
             (else "field.bytes_value"))
            "                    "))))))))

(define rs-pb-map-helpers-program
  '((fmt
     "fn pb_encode_~a(key: &~a, value: &~a) -> Vec<u8> {\n    let mut out = Vec::new();\n"
     (rs-entry-ref)
     (call-on (key-field) rsPbElemType)
     (call-on (val-field) rsPbElemType))
    (call-on (with-label (key-field) 1) rsPbEncodeSingular "(*key)" "    ")
    (case-on
     (get (val-field) type)
     (11
      (fmt
       "    pb_append_bytes_field(&mut out, ~a, &value.encode());\n"
       (get (val-field) number)))
     (else
      (call-on
       (with-label (val-field) 1)
       rsPbEncodeSingular
       "(*value)"
       "    ")))
    "    out\n}\n\n"
    (fmt
     "fn pb_decode_~a(data: &[u8]) -> Result<(~a, ~a), String> {\n"
     (rs-entry-ref)
     (call-on (key-field) rsPbElemType)
     (call-on (val-field) rsPbElemType))
    (fmt
     "    let mut key: ~a = ~a;\n    let mut value: ~a = ~a;\n"
     (call-on (key-field) rsPbElemType)
     (call-on (with-label (key-field) 1) rsPbDefault)
     (call-on (val-field) rsPbElemType)
     (case-on
      (get (val-field) type)
      (11 (fmt "~a::default()" (call-on (val-field) rsPbElemType)))
      (else (call-on (with-label (val-field) 1) rsPbDefault))))
    "    let mut r = PbReader::new(data);\n    while let Some(field) = r.next()? {\n        match field.number {\n"
    (fmt
     "            ~a => {\n~a            }\n"
     (get (key-field) number)
     (call-on
      (with-label (key-field) 1)
      rsPbDecodeSingularKv
      "key"
      "field"
      "                "))
    (fmt
     "            ~a => {\n~a            }\n"
     (get (val-field) number)
     (call-on
      (with-label (val-field) 1)
      rsPbDecodeSingularKv
      "value"
      "field"
      "                "))
    "            _ => {}\n        }\n    }\n    Ok((key, value))\n}\n\n"))

(define rs-pb-enum-named-program
  '((fmt (rust-enum-fragment header) (flat-of (arg 0)))
    (each
     values
     (fmt
      (rust-enum-fragment value)
      (case-on (index) (0 (rust-enum-fragment defaultMark)) (else ""))
      (rs-camel (ref name))
      (ref number)))
    (rust-enum-fragment unknownVariant)
    (fmt (rust-enum-fragment implOpen) (flat-of (arg 0)))
    (each
     values
     (fmt
      (rust-enum-fragment fromArm)
      (ref number)
      (flat-of (arg 0))
      (rs-camel (ref name))))
    (fmt (rust-enum-fragment unknownFromArm) (flat-of (arg 0)))
    (rust-enum-fragment toOpen)
    (each
     values
     (fmt
      (rust-enum-fragment toArm)
      (flat-of (arg 0))
      (rs-camel (ref name))
      (ref number)))
    (fmt (rust-enum-fragment unknownToArm) (flat-of (arg 0)))))

(define rs-pb-message-program
  '((each
     enums
     (call rsPbEnumNamed (fmt "~a.~a" (get (parent) full-name) (ref name))))
    (fmt "#[derive(Clone, Debug, PartialEq)]\npub struct ~a {\n" (flat))
    (each fields (fmt "    pub ~a: ~a,\n" (rs-field-name) (call rsPbType)))
    "    pub unknown_fields: Vec<u8>,\n}\n\n"
    (fmt
     "impl Default for ~a {\n    fn default() -> Self {\n        Self {\n"
     (flat))
    (each
     fields
     (fmt "            ~a: ~a,\n" (rs-field-name) (call rsPbDefault)))
    "            unknown_fields: Vec::new(),\n        }\n    }\n}\n\n"
    (fmt
     "impl ~a {\n    pub fn encode(&self) -> Vec<u8> {\n        let mut out = Vec::new();\n"
     (flat))
    (each
     fields
     (guarded
      rsPbSetExpr
      "        if !(~a) {\n"
      "        }\n"
      (call rsPbEncodeField)))
    "        out.extend_from_slice(&self.unknown_fields);\n        out\n    }\n\n    pub fn decode(bytes: &[u8]) -> Result<Self, String> {\n        let mut msg = Self::default();\n        let mut reader = PbReader::new(bytes);\n        while let Some(field) = reader.next()? {\n            match field.number {\n"
    (each fields (call rsPbDecodeCase))
    "                _ => {\n                    msg.unknown_fields.extend_from_slice(&field.raw_value);\n                }\n            }\n        }\n        Ok(msg)\n    }\n}\n\n"
    (each nested (call rsPbMessage))))

(define rb-deprecated-program
  '((when (ref deprecated) "      warn \"deprecated\"\n")))

