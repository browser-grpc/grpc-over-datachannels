(define cs-pb-decode-case-program
  '((fmt "                case ~a: {\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "                    var kv = ~a(field.BytesValue);\n"
        (fmt "~a.~aDecode" (arg 0) (cs-map-name)))
       (fmt
        "                    ~a[(~a) kv[0]] = (~a) kv[1];\n"
        (cs-field-name)
        (call-on (key-field (resolved-entry)) csPbType)
        (call-on (val-field (resolved-entry)) csPbType)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            "                    if (field.Wire == 2) {\n"
            (fmt
             "                        var sub = new ~a.Reader(field.BytesValue);\n"
             (arg 0))
            "                        while (!sub.Done) {\n"
            (fmt
             "                            ~a.Add(~a);\n"
             (cs-field-name)
             (call csPbEnumConv "sub.Varint()"))
            "                        }\n                    } else {\n"
            (fmt
             "                        ~a.Add(~a);\n"
             (cs-field-name)
             (call csPbEnumConv "field.VarintValue"))
            "                    }\n")
           ("fixed"
            "                    if (field.Wire == 2) {\n"
            (fmt
             "                        var sub = new ~a.Reader(field.BytesValue);\n"
             (arg 0))
            (fmt
             "                        while (!sub.Done) ~a.Add(~a);\n"
             (cs-field-name)
             (case-on
              (ref type)
              ((2)
               "BitConverter.ToSingle(BitConverter.GetBytes(sub.Fixed32()), 0)")
              ((1) "BitConverter.Int64BitsToDouble(sub.Fixed64())")
              ((7) "(uint) sub.Fixed32()")
              ((15) "sub.Fixed32()")
              (else "sub.Fixed64()")))
            "                    } else {\n"
            (fmt
             "                        ~a.Add(~a);\n"
             (cs-field-name)
             (case-on
              (ref type)
              ((2)
               "BitConverter.ToSingle(BitConverter.GetBytes((int) field.FixedValue), 0)")
              ((1) "BitConverter.Int64BitsToDouble(field.FixedValue)")
              ((7) "(uint) field.FixedValue")
              ((15) "(int) field.FixedValue")
              (else "field.FixedValue")))
            "                    }\n")
           ("string"
            (fmt
             "                    ~a.Add(System.Text.Encoding.UTF8.GetString(field.BytesValue));\n"
             (cs-field-name)))
           ("bytes"
            (fmt
             "                    ~a.Add(field.BytesValue);\n"
             (cs-field-name)))
           ("message"
            (fmt
             "                    var item = new ~a();\n"
             (call-on (with-label (self) 1) csPbType))
            "                    item.UnmarshalDc(field.BytesValue);\n"
            (fmt "                    ~a.Add(item);\n" (cs-field-name)))
           (else (fail))))
         (else
          (call csPbClearing)
          (call
           csPbDecodeSingular
           (cs-field-name)
           (case-on
            (category)
            ("varint" "field.VarintValue")
            ("fixed" "field.FixedValue")
            (else "field.BytesValue"))
           "                    ")))))
    "                    break;\n                }\n"))

