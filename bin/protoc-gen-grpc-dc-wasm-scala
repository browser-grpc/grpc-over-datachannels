(define java-pb-decode-case-program
  '((fmt "                case ~a -> {\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "                    Object[] kv = ~a(field.bytesValue);\n"
        (fmt "~a.~aDecode" (arg 0) (java-map-name)))
       (fmt
        "                    ~a.put((~a) kv[0], (~a) kv[1]);\n"
        (java-field-name)
        (call-on (key-field (resolved-entry)) javaPbType "boxed")
        (call-on (val-field (resolved-entry)) javaPbType "boxed")))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            "                    if (field.wire == 2) {\n"
            (fmt
             "                        ~a.Reader sub = new ~a.Reader(field.bytesValue);\n"
             (arg 0)
             (arg 0))
            "                        while (!sub.done()) {\n"
            (fmt
             "                            ~a.add(~a);\n"
             (java-field-name)
             (call javaPbEnumConv "sub.varint()"))
            "                        }\n                    } else {\n"
            (fmt
             "                        ~a.add(~a);\n"
             (java-field-name)
             (call javaPbEnumConv "field.varintValue"))
            "                    }\n")
           ("fixed"
            "                    if (field.wire == 2) {\n"
            (fmt
             "                        ~a.Reader sub = new ~a.Reader(field.bytesValue);\n"
             (arg 0)
             (arg 0))
            (fmt
             "                        while (!sub.done()) ~a.add(~a);\n"
             (java-field-name)
             (case-on
              (ref type)
              ((2) "Float.intBitsToFloat(sub.fixed32())")
              ((1) "Double.longBitsToDouble(sub.fixed64())")
              ((7 15) "sub.fixed32()")
              (else "sub.fixed64()")))
            "                    } else {\n"
            (fmt
             "                        ~a.add(~a);\n"
             (java-field-name)
             (case-on
              (ref type)
              ((2) "Float.intBitsToFloat((int) field.fixedValue)")
              ((1) "Double.longBitsToDouble(field.fixedValue)")
              ((7 15) "(int) field.fixedValue")
              (else "field.fixedValue")))
            "                    }\n")
           ("string"
            (fmt
             "                    ~a.add(new String(field.bytesValue, java.nio.charset.StandardCharsets.UTF_8));\n"
             (java-field-name)))
           ("bytes"
            (fmt
             "                    ~a.add(field.bytesValue);\n"
             (java-field-name)))
           ("message"
            (fmt
             "                    ~a item = new ~a();\n"
             (call-on (with-label (self) 1) javaPbType "boxed")
             (call-on (with-label (self) 1) javaPbType "boxed"))
            "                    item.unmarshalDc(field.bytesValue);\n"
            (fmt "                    ~a.add(item);\n" (java-field-name)))
           (else (fail))))
         (else
          (call javaPbClearing)
          (call
           javaPbDecodeSingular
           (java-field-name)
           (case-on
            (category)
            ("varint" "field.varintValue")
            ("fixed" "field.fixedValue")
            (else "field.bytesValue"))
           "                    ")))))
    "                }\n"))

