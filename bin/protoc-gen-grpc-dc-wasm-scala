(define java-pb-encode-singular-program
  '((case-on
     (category)
     ("varint"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, 0); w.varint(~a); }\n"
          (arg 1)
          (ref number)
          (call javaPbVarintPayload (arg 0))))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, 0); w.varint(~a); }\n"
          (arg 1)
          (call javaPbNonzero (arg 0))
          (ref number)
          (call javaPbVarintPayload (arg 0))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~a{ w.tag(~a, ~a); w.fixed~a(~a); }\n"
          (arg 1)
          (ref number)
          (case-on (java-fixed-size) ((8) "1") (else "5"))
          (java-fixed-name)
          (arg 0)))
        (else
         (fmt
          "~aif (~a) { w.tag(~a, ~a); w.fixed~a(~a); }\n"
          (arg 1)
          (call javaPbNonzero (arg 0))
          (ref number)
          (case-on (java-fixed-size) ((8) "1") (else "5"))
          (java-fixed-name)
          (arg 0)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aif (~a != null) w.bytesField(~a, ~a.getBytes(java.nio.charset.StandardCharsets.UTF_8));\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))
        (else
         (fmt "~aw.stringField(~a, ~a);\n" (arg 1) (ref number) (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aif (~a != null) w.bytesField(~a, ~a);\n"
          (arg 1)
          (arg 0)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif (~a != null && ~a.length > 0) w.bytesField(~a, ~a);\n"
          (arg 1)
          (arg 0)
          (arg 0)
