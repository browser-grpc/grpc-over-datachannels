(define sc-pb-decode-case-program
  '((fmt "        case ~a =>\n" (ref number))
    (if (is-map)
      (then
       (fmt
        "          val (kk, vv) = ~a(field.bytesValue)\n          ~a = ~a + (kk -> vv)\n"
        (fmt "~a.decode~a" (arg 0) (sc-entry-ref))
        (sc-field-name)
        (sc-field-name)))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           ("varint"
            (fmt
             "          if (field.wire == 2) {\n            val sub = new ~a.Reader(field.bytesValue)\n            while (!sub.done) {\n              val raw = sub.varint()\n              ~a = ~a :+ ~a\n            }\n          } else {\n            ~a = ~a :+ ~a\n          }\n"
             (arg 0)
             (sc-field-name)
             (sc-field-name)
             (call scPbVarintDecode "raw")
             (sc-field-name)
             (sc-field-name)
             (call scPbVarintDecode "field.varintValue")))
           ("fixed"
            (fmt
             "          if (field.wire == 2) {\n            var i = 0\n            while (i < field.bytesValue.length) {\n              ~a = ~a :+ ~a\n              i += ~a\n            }\n          } else {\n            ~a = ~a :+ ~a\n          }\n"
             (sc-field-name)
             (sc-field-name)
             (call
              scPbFixedDecode
              (arg 0)
              (fmt
               "java.util.Arrays.copyOfRange(field.bytesValue, i, i + ~a)"
               (sc-fixed-size)))
             (sc-fixed-size)
             (sc-field-name)
             (sc-field-name)
             (call scPbFixedDecode (arg 0) "field.fixedValue")))
           ("string"
            (fmt
             "          ~a = ~a :+ new String(field.bytesValue, java.nio.charset.StandardCharsets.UTF_8)\n"
             (sc-field-name)
             (sc-field-name)))
           ("bytes"
            (fmt
             "          ~a = ~a :+ field.bytesValue\n"
             (sc-field-name)
             (sc-field-name)))
           ("message"
            (fmt
             "          val item = new ~a()\n          item.unmarshalDc(field.bytesValue)\n          ~a = ~a :+ item\n"
             (sc-entry-ref)
             (sc-field-name)
             (sc-field-name)))
           (else (fail))))
         (else
          (call scPbOneofClearing)
          (call
           scPbDecodeSingular
           (arg 0)
           (sc-field-name)
           (case-on
            (category)
            ("varint" "field.varintValue")
            ("fixed" "field.fixedValue")
            (else "field.bytesValue"))
           "          ")))))))

(define sc-pb-map-helpers-program
  '((fmt
     "  def encode~a(key: ~a, value: ~a): Array[Byte] = {\n    val w = new Writer()\n"
     (sc-entry-ref)
     (call-on (key-field) scPbElemType)
     (call-on (val-field) scPbElemType))
    (call-on
     (with-label (key-field) 1)
     scPbEncodeSingular
     (arg 0)
     "key"
     "    ")
    (call-on
     (with-label (val-field) 1)
     scPbEncodeSingular
     (arg 0)
     "value"
     "    ")
    "    w.toBytes\n  }\n\n"
    (fmt
     "  def decode~a(data: Array[Byte]): (~a, ~a) = {\n"
     (sc-entry-ref)
     (call-on (key-field) scPbElemType)
     (call-on (val-field) scPbElemType))
    (fmt
     "    var key: ~a = ~a\n    var value: ~a = ~a\n"
     (call-on (key-field) scPbElemType)
     (call-on (with-label (key-field) 1) scPbDefault)
     (call-on (val-field) scPbElemType)
     (call-on (with-label (val-field) 1) scPbDefault))
    "    val r = new Reader(data)\n    var field = r.next()\n    while (field != null) {\n      field.number match {\n"
    (fmt
     "        case ~a =>\n~a"
     (get (key-field) number)
     (call-on
      (with-label (key-field) 1)
      scPbDecodeSingular
      (arg 0)
      "key"
      (case-on
       (category-of (key-field))
       ("varint" "field.varintValue")
       ("fixed" "field.fixedValue")
       (else "field.bytesValue"))
      "          "))
    (fmt
     "        case ~a =>\n~a"
     (get (val-field) number)
     (case-on
      (get (val-field) type)
      (11
       (fmt
        "          value = new ~a()\n          value.unmarshalDc(field.bytesValue)\n"
        (sc-entry-ref (val-field))))
      (else
       (call-on
        (with-label (val-field) 1)
        scPbDecodeSingular
        (arg 0)
        "value"
        (case-on
         (category-of (val-field))
         ("varint" "field.varintValue")
         ("fixed" "field.fixedValue")
         (else "field.bytesValue"))
        "          "))))
    "        case _ => ()\n      }\n      field = r.next()\n    }\n    (key, value)\n  }\n\n"))

(define sc-pb-message-program
  '((fmt "class ~a(\n" (flat))
    (each-sep
     ",\n"
     fields
     (fmt
      "    var ~a: ~a = ~a"
      (sc-field-name)
      (call scPbType)
      (call scPbDefault)))
    (if (no-fields) (then "") (else "\n"))
    ") extends grpcdc.Marshaler with grpcdc.Unmarshaler {\n  var unknownFields: Array[Byte] = Array.empty[Byte]\n  def marshalDc(): Array[Byte] = {\n"
    (fmt "    val w = new ~a.Writer()\n" (arg 0))
    (each
     fields
     (guarded
      scPbSetExpr
      "    if (!(~a)) {\n"
      "    }\n"
      (call scPbEncodeField (arg 0))))
    "    w.raw(unknownFields)\n    w.toBytes\n  }\n\n  def unmarshalDc(data: Array[Byte]): Unit = {\n    unknownFields = Array.empty[Byte]\n"
    (each fields (fmt "    ~a = ~a\n" (sc-field-name) (call scPbDefault)))
    (fmt "    val r = new ~a.Reader(data)\n" (arg 0))
    "    var field = r.next()\n    while (field != null) {\n      field.number match {\n"
    (each fields (call scPbDecodeCase (arg 0)))
    "        case _ => unknownFields = unknownFields ++ field.rawValue\n      }\n      field = r.next()\n    }\n  }\n}\n\n"
    (each nested (call scPbMessage (arg 0)))))

(define sc-pb-enum-program
  '((fmt "object ~a {\n" (flat-of (arg 0)))
    (each values (fmt "  final val ~a: Int = ~a\n" (ref name) (ref number)))
    "}\n\n"))

