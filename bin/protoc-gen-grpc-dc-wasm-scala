(define (seg-later-oneof-cond model node)
  (define later (oneof-later-siblings model node))
  (if (null? later) "" (string-join (map seg-set-expr later) " || ")))

(define (seg-eval seg env)
  (define node (env-node env))
  (define model (env-model env))
  (cond
   ((string? seg) seg)
   ((number? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply
     format
     (if (list? (second seg)) (seg-eval (second seg) env) (second seg))
     (map
      (lambda (e)
        (define v (seg-eval e env))
        (if (symbol? v) (symbol->string v) v))
      (cddr seg))))
   ((eq? (car seg) 'ref)
    (if (null? (cddr seg))
      (seg-ref node (second seg))
      (foldl (lambda (k acc) (hash-ref acc k)) node (cdr seg))))
   ((eq? (car seg) 'svc) (env-svc env))
   ((eq? (car seg) 'arg) (list-ref (env-args env) (second seg)))
   ((eq? (car seg) 'err-stmt) (env-err env))
   ((eq? (car seg) 'self) node)
   ((eq? (car seg) 'root) (env-root env))
   ((eq? (car seg) 'distinct-count)
    (define kinds-part
      (and (pair? (cdddr seg))
           (list? (fourth seg))
           (eq? (car (fourth seg)) 'kinds)
           (cdr (fourth seg))))
    (max
     1
     (length
      (remove-duplicates
       (map
        (lambda (el) (hash-ref el (third seg)))
        (filter
         (lambda (el)
           (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
         (seg-eval (second seg) env)))))))
   ((memq
     (car seg)
     '(if case-on
        when
        guarded
        guarded-indent
        kind-case
        each
        each+
        each-sep+
        each-siblings
        each-sep
        each-unique
        each-unique-pair
        each-where
        each-sep-where))
    (run-segment seg env))
   ((eq? (car seg) 'pascal) (seg-pascal (seg-eval (second seg) env)))
   ((eq? (car seg) 'lower-first) (seg-lower-first (seg-eval (second seg) env)))
   ((eq? (car seg) 'js-name) (seg-js-name node))
   ((eq? (car seg) 'js-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'js-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'bigint-type)
    (and (memv (hash-ref node 'type) '(3 4 18 6 16)) #t))
   ((eq? (car seg) 'entry-flat) (seg-entry-type node))
   ((eq? (car seg) 'resolved-flat)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name))))
   ((eq? (car seg) 'index) (env-index env))
   ((eq? (car seg) 'parent) (env-parent env))
   ((eq? (car seg) 'and)
    (andmap (lambda (e) (seg-truthy? (seg-eval e env))) (cdr seg)))
   ((eq? (car seg) 'or)
    (and (ormap (lambda (e) (seg-truthy? (seg-eval e env))) (cdr seg)) #t))
   ((eq? (car seg) 'not) (not (seg-truthy? (seg-eval (second seg) env))))
   ((eq? (car seg) 'any-where)
    (define keys (if (list? (second seg)) (second seg) (list (second seg))))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (and (ormap
          (lambda (el)
            (seg-truthy? (seg-eval (third seg) (env-with env #:node el))))
          items)
         #t))
   ((eq? (car seg) 'snake-case) (seg-snake-case (seg-eval (second seg) env)))
   ((eq? (car seg) 'rs-camel) (seg-rs-camel (seg-eval (second seg) env)))
   ((eq? (car seg) 'rs-field-name) (seg-rs-field-name node))
   ((eq? (car seg) 'rs-map-type)
    (if (seg-rust-no-std) "BTreeMap" "std::collections::HashMap"))
   ((eq? (car seg) 'rs-entry-ref) (seg-rs-entry-ref model node))
   ((eq? (car seg) 'rs-scalar-type)
    (scalar-type-entry 'rust (hash-ref node 'type)))
   ((eq? (car seg) 'rs-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'rust))))
   ((eq? (car seg) 'rs-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'rust))))
   ((eq? (car seg) 'flat-of)
    (seg-flat (hash-ref model 'package) (seg-eval (second seg) env)))
   ((eq? (car seg) 'rust-enum-fragment) (rust-enum-fragment (second seg)))
   ((eq? (car seg) 'enum-first-value-name)
    (hash-ref
     (car
      (hash-ref
       (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'enum)
       'values))
     'name))
   ((eq? (car seg) 'enum-first-value-num)
    (hash-ref
     (car
      (hash-ref
       (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'enum)
       'values))
     'number))
   ((eq? (car seg) 'rb-snake) (seg-rb-snake (seg-eval (second seg) env)))
   ((eq? (car seg) 'stub-ref) (seg-rb-stub-ref model node (second seg)))
   ((eq? (car seg) 'rb-entry-ref)
    (seg-rb-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'rb-model-module)
    (string-append
     (seg-pascal
      (path->string
       (path-replace-extension
        (file-name-from-path (hash-ref model 'name))
        "")))
     "Pb"))
   ((eq? (car seg) 'rb-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'ruby))))
   ((eq? (car seg) 'rb-fixed-fmt)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'ruby))))
   ((eq? (car seg) 'php-camel) (seg-php-camel (seg-eval (second seg) env)))
   ((eq? (car seg) 'php-field-name) (seg-php-field-name node))
   ((eq? (car seg) 'php-flat-of)
    (seg-php-flat (hash-ref model 'package) (seg-eval (second seg) env)))
   ((eq? (car seg) 'php-stub-ref) (seg-php-stub-ref model node (second seg)))
   ((eq? (car seg) 'php-entry-ref)
    (seg-php-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'php-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'php))))
   ((eq? (car seg) 'php-fixed-fmt)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'php))))
   ((eq? (car seg) 'py-ref) (seg-py-ref model node))
   ((eq? (car seg) 'py-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'python))))
   ((eq? (car seg) 'py-fixed-fmt)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'python))))
   ((eq? (car seg) 'with-type)
    (hash-set (seg-eval (second seg) env) 'type (third seg)))
   ((eq? (car seg) 'trim-end)
    (regexp-replace #rx"\n+$" (seg-eval (second seg) env) ""))
   ((eq? (car seg) 'c-entry-ref)
    (seg-c-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'c-entry-support)
    (define e (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (seg-c-support
     (if (hash-has-key? e 'type-name)
       (seg-resolve model (hash-ref e 'type-name))
       e)))
   ((eq? (car seg) 'c-type-ref)
    (seg-c-entry-ref model (seg-resolve model (hash-ref node (second seg)))))
   ((eq? (car seg) 'c-support-of)
    (seg-c-support (seg-resolve model (hash-ref node (second seg)))))
   ((eq? (car seg) 'c-scalar-type)
    (first (scalar-type-entry 'c (hash-ref node 'type))))
   ((eq? (car seg) 'c-scalar-zero)
    (second (scalar-type-entry 'c (hash-ref node 'type))))
   ((eq? (car seg) 'c-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'c))))
   ((eq? (car seg) 'c-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'c))))
   ((eq? (car seg) 'distinct-pair-count)
    (define kinds-part
      (and (pair? (cddr seg))
           (list? (third seg))
           (eq? (car (third seg)) 'kinds)
           (cdr (third seg))))
    (max
     1
     (length
      (remove-duplicates
       (map
        (lambda (el) (cons (hash-ref el 'input) (hash-ref el 'output)))
        (filter
         (lambda (el)
           (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
         (seg-eval (second seg) env)))))))
   ((eq? (car seg) 'sc-field-name) (seg-sc-field-name node))
   ((eq? (car seg) 'sc-entry-ref)
    (seg-sc-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'sc-scalar-type)
    (scalar-type-entry 'scala (hash-ref node 'type)))
   ((eq? (car seg) 'sc-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'scala))))
   ((eq? (car seg) 'sc-fixed-kind)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'scala))))
   ((eq? (car seg) 'dart-field-name) (seg-dart-field-name node))
   ((eq? (car seg) 'dart-entry-ref)
    (seg-dart-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'dart-type-ref)
    (string-replace
     (seg-dart-entry-ref
      model
      (if (null? (cdr seg)) node (seg-eval (second seg) env)))
     "."
     "_"))
   ((eq? (car seg) 'dart-scalar-type)
    (first (scalar-type-entry 'dart (hash-ref node 'type))))
   ((eq? (car seg) 'dart-scalar-zero)
    (second (scalar-type-entry 'dart (hash-ref node 'type))))
   ((eq? (car seg) 'dart-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'dart))))
   ((eq? (car seg) 'dart-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'dart))))
   ((eq? (car seg) 'swift-field-name) (seg-swift-field-name node))
   ((eq? (car seg) 'lua-field-name) (seg-dart-field-name node))
   ((eq? (car seg) 'cpp-stub-type)
    (seg-cpp-stub-type
     node
     (let ((k (second seg)))
       (if (and (list? k) (eq? (car k) 'quote)) (second k) k))))
   ((eq? (car seg) 'cpp-entry-ref)
    (seg-cpp-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'cpp-map-name)
    (seg-cpp-map-name
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'cpp-scalar-type)
    (first (scalar-type-entry 'cpp (hash-ref node 'type))))
   ((eq? (car seg) 'cpp-scalar-zero)
    (second (scalar-type-entry 'cpp (hash-ref node 'type))))
   ((eq? (car seg) 'cpp-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'cpp))))
   ((eq? (car seg) 'cpp-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'cpp))))
   ((eq? (car seg) 'java-field-name) (seg-dart-field-name node))
   ((eq? (car seg) 'java-entry-ref)
    (seg-kt-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'java-map-name)
    (seg-kt-map-name
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'java-scalar-type)
    (first (scalar-type-entry 'java (hash-ref node 'type))))
   ((eq? (car seg) 'java-scalar-boxed)
    (second (scalar-type-entry 'java (hash-ref node 'type))))
   ((eq? (car seg) 'java-scalar-default)
    (third (scalar-type-entry 'java (hash-ref node 'type))))
   ((eq? (car seg) 'java-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'java))))
   ((eq? (car seg) 'java-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'java))))
   ((eq? (car seg) 'cs-field-name) (seg-cs-field-name model node))
   ((eq? (car seg) 'cs-entry-ref)
    (seg-cs-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'cs-map-name)
    (seg-cs-map-name
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'cs-scalar-type)
    (first (scalar-type-entry 'csharp (hash-ref node 'type))))
   ((eq? (car seg) 'cs-scalar-zero)
    (second (scalar-type-entry 'csharp (hash-ref node 'type))))
   ((eq? (car seg) 'cs-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'csharp))))
   ((eq? (car seg) 'cs-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'csharp))))
   ((eq? (car seg) 'kotlin-wasm-mode) (seg-kotlin-wasm-mode))
   ((eq? (car seg) 'first-value-name)
    (hash-ref (car (hash-ref node 'values)) 'name))
   ((eq? (car seg) 'kt-field-name) (seg-dart-field-name node))
   ((eq? (car seg) 'kt-entry-ref)
    (seg-kt-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'kt-map-name)
    (seg-kt-map-name
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'kt-scalar-type)
    (first (scalar-type-entry 'kotlin (hash-ref node 'type))))
   ((eq? (car seg) 'kt-scalar-zero)
    (second (scalar-type-entry 'kotlin (hash-ref node 'type))))
   ((eq? (car seg) 'kt-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'kotlin))))
   ((eq? (car seg) 'kt-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'kotlin))))
   ((eq? (car seg) 'zig-entry-ref)
    (seg-zig-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'zig-struct-name)
    (string-replace
     (seg-zig-entry-ref
      model
      (if (null? (cdr seg)) node (seg-eval (second seg) env)))
     "."
     "_"))
   ((eq? (car seg) 'zig-scalar-type)
    (first (scalar-type-entry 'zig (hash-ref node 'type))))
   ((eq? (car seg) 'zig-scalar-zero)
    (second (scalar-type-entry 'zig (hash-ref node 'type))))
   ((eq? (car seg) 'zig-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'zig))))
   ((eq? (car seg) 'zig-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'zig))))
   ((eq? (car seg) 'lua-entry-flat)
    (seg-lua-entry-flat
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'lua-enum-flat) (seg-lua-enum-flat model node))
   ((eq? (car seg) 'lua-fixed-fmt)
    (string-append
     "<"
     (third (assv (hash-ref node 'type) (fixed-scalar-table 'lua)))))
   ((eq? (car seg) 'lua-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'lua))))
   ((eq? (car seg) 'lua-fixed-wire)
    (if (= (second (assv (hash-ref node 'type) (fixed-scalar-table 'lua))) 8)
      1
      5))
   ((eq? (car seg) 'swift-entry-ref)
    (seg-swift-entry-ref
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'swift-map-name)
    (seg-swift-map-name
     model
     (if (null? (cdr seg)) node (seg-eval (second seg) env))))
   ((eq? (car seg) 'swift-scalar-type)
    (first (scalar-type-entry 'swift (hash-ref node 'type))))
   ((eq? (car seg) 'swift-scalar-zero)
    (second (scalar-type-entry 'swift (hash-ref node 'type))))
   ((eq? (car seg) 'swift-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'swift))))
   ((eq? (car seg) 'swift-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'swift))))
   ((eq? (car seg) 'flat)
    (seg-flat (hash-ref model 'package) (hash-ref node 'full-name)))
   ((eq? (car seg) 'entry-type) (seg-entry-type-of model node))
   ((eq? (car seg) 'field-type) (seg-field-type model node))
   ((eq? (car seg) 'field-type-of)
    (seg-field-type model (seg-eval (second seg) env)))
   ((eq? (car seg) 'resolved-entry)
    (seg-resolve model (hash-ref node 'type-name)))
   ((eq? (car seg) 'key-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 1))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'val-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 2))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'with-label)
    (hash-set (seg-eval (second seg) env) 'label (third seg)))
   ((eq? (car seg) 'get) (hash-ref (seg-eval (second seg) env) (third seg)))
   ((eq? (car seg) 'fixed-name) (third (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-size) (second (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-wire) (if (= (second (seg-fixed-info node)) 8) 1 5))
   ((eq? (car seg) 'type) (hash-ref node 'type))
   ((eq? (car seg) 'category) (seg-category model node))
   ((eq? (car seg) 'category-of)
    (seg-category model (seg-eval (second seg) env)))
   ((eq? (car seg) 'proto2) (equal? (hash-ref model 'syntax "") "proto2"))
   ((eq? (car seg) 'type-is) (= (hash-ref node 'type) (second seg)))
   ((eq? (car seg) 'is-varint)
    (and (memv (hash-ref node 'type) varint-scalar-types) #t))
   ((eq? (car seg) 'is-fixed) (and (seg-fixed-info node) #t))
   ((eq? (car seg) 'is-map)
    (and (= (hash-ref node 'type) 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map)))
   ((eq? (car seg) 'repeated) (= (hash-ref node 'label) 3))
   ((eq? (car seg) 'has-default) (and (field-explicit-default node) #t))
   ((eq? (car seg) 'any-default)
    (for/or
     ((f (in-list (hash-ref node 'fields))))
     (field-explicit-default f)))
   ((eq? (car seg) 'no-fields) (null? (hash-ref node 'fields)))
   ((eq? (car seg) 'default-raw) (field-explicit-default node))
   ((eq? (car seg) 'enum-default-num) (enum-default-number model node))
   ((eq? (car seg) 'oneof-clearing) (seg-oneof-clearing model node))
   ((eq? (car seg) 'later-oneof-cond) (seg-later-oneof-cond model node))
   ((eq? (car seg) 'call)
    (run-env
     (hash-ref segment-programs (second seg))
     (env-with env #:args (map (lambda (e) (seg-eval e env)) (cddr seg)))))
   ((eq? (car seg) 'call-on)
    (run-env
     (hash-ref segment-programs (third seg))
     (env-with
      env
      #:node
      (seg-eval (second seg) env)
      #:args
      (map (lambda (e) (seg-eval e env)) (cdddr seg)))))
   (else (error 'run-segments "bad expression: ~e" seg))))

(define (run-segment seg env)
  (define node (env-node env))
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'if)
    (define then-segs (cdr (assq 'then (cddr seg))))
    (define else-part (assq 'else (cddr seg)))
    (if (seg-truthy? (seg-eval (second seg) env))
      (run-env then-segs env)
      (if else-part (run-env (cdr else-part) env) "")))
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch
      (or (for/first
           ((b (in-list (cdr seg)))
            #:when
            (or (eq? (car b) kind) (and (list? (car b)) (memq kind (car b)))))
           b)
          (assq 'else (cdr seg))))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-env (cdr branch) env))
   ((eq? (car seg) 'case-on)
    (define val (seg-eval (second seg) env))
    (define raw (cddr seg))
    (define (branch-key? b)
      (and (list? b)
           (pair? b)
           (or (number? (car b))
               (string? (car b))
               (eq? (car b) 'else)
               (and (list? (car b)) (andmap number? (car b))))))
    (define branches
      (cond
       ((and (= (length raw) 1)
             (list? (car raw))
             (andmap branch-key? (car raw)))
        (car raw))
       (else
        (map
         (lambda (b)
           (if (and (list? b) (= (length b) 1) (list? (car b))) (car b) b))
         raw))))
    (define branch
      (for/first
       ((b (in-list branches))
        #:when
        (or (eq? (car b) 'else)
            (member val (if (list? (car b)) (car b) (list (car b))) equal?)))
       b))
    (if branch (run-env (cdr branch) env) ""))
   ((eq? (car seg) 'when)
    (if (seg-truthy? (seg-eval (second seg) env)) (run-env (cddr seg) env) ""))
   ((eq? (car seg) 'trim-suffix)
    (define text (run-env (cdddr seg) env))
    (if (string-suffix? text (second seg))
      (string-append
       (substring text 0 (- (string-length text) (string-length (second seg))))
       (third seg))
      text))
   ((eq? (car seg) 'guarded)
    (define-values
     (joiner body-segs)
     (if (and (pair? (cddddr seg))
              (pair? (car (cddddr seg)))
              (eq? (car (car (cddddr seg))) 'join))
       (values (second (car (cddddr seg))) (cdr (cddddr seg)))
       (values " || " (cddddr seg))))
    (define text (run-env body-segs env))
    (define cond-str
      (string-join
       (map
        (lambda (sib)
          (run-env
           (hash-ref segment-programs (second seg))
           (env-with env #:node sib)))
        (oneof-later-siblings (env-model env) node))
       joiner))
    (if (equal? cond-str "")
      text
      (string-append
       (format (third seg) cond-str)
       (if (string-suffix? text "\n") text (string-append text "\n"))
       (fourth seg))))
   ((eq? (car seg) 'fail)
    (error 'run-segments "unsupported field type ~a" (hash-ref node 'type)))
   ((eq? (car seg) 'each)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items)) (i (in-naturals)))
      (run-env segs (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each+)
    (define aliases
      (if (eq? (third seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (apply
     string-append
     (for/list
      ((el (in-list (append (hash-ref node (second seg)) aliases)))
       (i (in-naturals)))
      (run-env (cdddr seg) (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each-sep+)
    (define aliases
      (if (eq? (fourth seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (string-join
     (for/list
      ((el (in-list (append (hash-ref node (third seg)) aliases)))
       (i (in-naturals)))
      (run-env (cddddr seg) (env-with env #:node el #:index i)))
     (second seg)))
   ((eq? (car seg) 'guarded-indent)
    (define text (run-env (cddddr seg) env))
    (define cond-str
      (string-join
       (map
        (lambda (sib)
          (run-env
           (hash-ref segment-programs (second seg))
           (env-with env #:node sib)))
        (oneof-later-siblings (env-model env) node))
       " or "))
    (if (equal? cond-str "")
      text
      (string-append
       (format (third seg) cond-str)
       (string-join
        (map
         (lambda (l) (if (string=? l "") l (string-append (fourth seg) l)))
         (string-split text "\n" #:trim? #f))
        "\n")
       "\n")))
   ((eq? (car seg) 'each-siblings)
    (apply
     string-append
     (for/list
      ((sib (in-list (oneof-siblings (env-model env) node))) (i (in-naturals)))
      (run-env (cdr seg) (env-with env #:node sib #:index i)))))
   ((eq? (car seg) 'each-unique)
    (define rest (cdddr seg))
    (define kinds-part
      (and (pair? rest)
           (list? (car rest))
           (eq? (car (car rest)) 'kinds)
           (cdr (car rest))))
    (when kinds-part (set! rest (cdr rest)))
    (define or-first?
      (and (pair? rest) (list? (car rest)) (eq? (car (car rest)) 'or-first)))
    (when or-first? (set! rest (cdr rest)))
    (define all (hash-ref node (second seg)))
    (define filtered
      (filter
       (lambda (el)
         (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
       all))
    (define seen (mutable-set))
    (define uniq
      (filter
       (lambda (el)
         (define v (hash-ref el (third seg)))
         (and (not (set-member? seen v)) (set-add! seen v)))
       filtered))
    (apply
     string-append
     (for/list
      ((el (in-list (if (and or-first? (null? uniq)) (list (car all)) uniq)))
       (i (in-naturals)))
      (run-env rest (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each-where)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define pred (car segs))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items))
       (i (in-naturals))
       #:when
       (seg-truthy? (seg-eval pred (env-with env #:node el))))
      (run-env (cdr segs) (env-with env #:node el #:index i)))))
   ((eq? (car seg) 'each-sep-where)
    (define-values (keys segs) (splitf-at (cddr seg) symbol?))
    (define pred (car segs))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (string-join
     (for/list
      ((el (in-list items))
       (i (in-naturals))
       #:when
       (seg-truthy? (seg-eval pred (env-with env #:node el))))
      (run-env (cdr segs) (env-with env #:node el #:index i)))
     (second seg)))
   ((eq? (car seg) 'each-unique-pair)
    (define rest (cddr seg))
    (define kinds-part
      (and (pair? rest)
           (list? (car rest))
           (eq? (car (car rest)) 'kinds)
           (cdr (car rest))))
    (when kinds-part (set! rest (cdr rest)))
    (define or-first?
      (and (pair? rest) (list? (car rest)) (eq? (car (car rest)) 'or-first)))
    (when or-first? (set! rest (cdr rest)))
    (define all (hash-ref node (second seg)))
    (define filtered
      (filter
       (lambda (el)
         (or (not kinds-part) (memq (hash-ref el 'kind) kinds-part)))
       all))
    (define seen (mutable-set))
    (define uniq
      (filter
       (lambda (el)
         (define v (cons (hash-ref el 'input) (hash-ref el 'output)))
         (and (not (set-member? seen v)) (set-add! seen v)))
       filtered))
    (apply
     string-append
     (for/list
      ((el (in-list (if (and or-first? (null? uniq)) (list (car all)) uniq)))
       (i (in-naturals)))
      (run-env
       rest
       (env-with
        env
        #:node
        (hasheq 'input (hash-ref el 'input) 'output (hash-ref el 'output))
        #:index
        i)))))
   ((eq? (car seg) 'each-sep)
    (define-values (keys segs) (splitf-at (cddr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (string-join
     (for/list
      ((el (in-list items)) (i (in-naturals)))
      (run-env segs (env-with env #:node el #:index i)))
     (second seg)))
   (else (seg-eval seg env))))

(define current-service (make-parameter ""))

(define (wasm-scala-client-method m)
  (run-segments
   wasm-scala-client-method-program
   m
   ""
   #f
   (list
    (client-stream-name
     (current-service)
     'server-streaming
     (hash-ref m 'output))
    (client-stream-name (current-service) 'bidi (hash-ref m 'output)))))

(define (wasm-scala-server-iface-method m)
  (run-segments
   wasm-scala-server-iface-method-program
   m
   ""
   #f
   (list (sink-name (current-service) (hash-ref m 'output)))))

(define (wasm-scala-register-method m)
  (run-segments wasm-scala-register-method-program m ""))

(define (wasm-scala-stream-iface-method m)
  (run-segments wasm-scala-stream-iface-method-program m ""))

(define (wasm-scala-stream-register-method m)
  (run-segments wasm-scala-stream-register-method-program m ""))

(define current-methods (make-parameter '()))

(define (stream-outputs)
  (remove-duplicates
   (map
    (lambda (m) (hash-ref m 'output))
    (filter
     (lambda (m) (memq (hash-ref m 'kind) '(server-streaming bidi)))
     (current-methods)))))

(define (kind-outputs kind)
  (remove-duplicates
   (map
    (lambda (m) (hash-ref m 'output))
    (filter (lambda (m) (eq? (hash-ref m 'kind) kind)) (current-methods)))))

(define (recv-name svc out)
  (if (<= (length (stream-outputs)) 1)
    (format "~aRecvStream" svc)
    (format "~a~aRecvStream" svc out)))

(define (sink-name svc out)
  (if (<= (length (stream-outputs)) 1)
    (format "~aServerSink" svc)
    (format "~a~aServerSink" svc out)))

(define (client-stream-name svc kind out)
  (define suffix
    (if (eq? kind 'server-streaming) "ServerStreamStream" "BidiStream"))
  (if (<= (length (kind-outputs kind)) 1)
    (format "~a~a" svc suffix)
    (format "~a~a~a" svc out suffix)))

(define (wasm-scala-recv-stream sname out)
  (run-segments
   wasm-scala-recv-stream-program
   (hash)
   sname
   #f
   (list out (recv-name sname out))))

(define (wasm-scala-source typ)
  (run-segments wasm-scala-source-program (hash) "" #f (list typ)))

(define (wasm-scala-service svc)
  (run-segments wasm-scala-service-program svc (hash-ref svc 'name)))

(define (emit-wasm-scala-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define obj-name
    (string-append (pascal (string->symbol base)) "ScalaJsGrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (cons
   (string-append obj-name ".scala")
   (string-append
    "// @generated by protoc-gen-grpc-dc-wasm-scala. DO NOT EDIT.\n"
    (format "// source: ~a\n" (hash-ref file-model 'name))
    (format "package ~a\n\n" pkg)
    "import scala.concurrent.ExecutionContext.Implicits.global\n\n"
    "/** Generated Scala.js facade stubs (wrap the JS runtime). */\n"
    (format "object ~a {\n" obj-name)
    (apply
     string-append
     (map wasm-scala-service (hash-ref file-model 'services)))
    "}\n")))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "_"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define trace-opt (hash-ref params 'trace #f))
  (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
    (error
     (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
  (define trace-methods (hash-ref params 'trace_methods #f))
  (when trace-methods
    (unless (equal? trace-opt "hooks")
      (error "trace_methods requires trace=hooks"))
    (for
     ((p (in-list (string-split trace-methods ";"))))
     (unless (string-prefix? p "/")
       (error (format "trace_methods pattern must start with /: ~a" p)))))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map
        stamp-generated-header
        (as-file-list (emit-wasm-scala-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
