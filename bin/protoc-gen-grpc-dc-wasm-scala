(define lua-coro-client-stream-class-program
  '((kind-case
     ((server-streaming bidi)
      (fmt
       "--- Coroutine receiving stream for ~a responses: a producer\n--- coroutine yields each response; next() returns nil at the\n--- end of the call and raises a Status on trailers errors.\nlocal ~a~aCoroStream = {}\n~a~aCoroStream.__index = ~a~aCoroStream\n\nfunction ~a~aCoroStream.new(stream)\n  local self = setmetatable({ stream = stream }, ~a~aCoroStream)\n  self.co = coroutine.create(function()\n    while true do\n      local resp = ~a.new()\n      stream:recv(resp)\n      coroutine.yield(resp)\n    end\n  end)\n  return self\nend\n\nfunction ~a~aCoroStream:next()\n  if coroutine.status(self.co) == \"dead\" then return nil end\n  local ok, value = coroutine.resume(self.co)\n  if not ok then\n    if value == EndOfStream then return nil end\n    error(value, 0)\n  end\n  return value\nend\n\nfunction ~a~aCoroStream:cancel()\n  self.stream:cancel()\nend\n\n--- Abandon the call early: RST so the server stops producing.\nfunction ~a~aCoroStream:close()\n  self.stream:close()\nend\n\n--- To-be-closed (<close>) and GC abandon the call the same way.\nfunction ~a~aCoroStream:__close()\n  self:close()\nend\n\nfunction ~a~aCoroStream:__gc()\n  self:close()\nend\n\n--- Generic-for iterator: for resp in stream:iter() do ... end\n--- Breaking the loop closes the closable stream, RST-ing\n--- the call unless it already terminated.\nfunction ~a~aCoroStream:iter()\n  return function() return self:next() end, nil, nil, self\nend\n\n"
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (ref output)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)
       (svc)
       (ref name)))
     (else ""))))

