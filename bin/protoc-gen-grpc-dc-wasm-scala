     (18 (fmt "((~a << 1) ^ (~a >> 63))" (arg 0) (arg 0)))
     ((5 14) (fmt "(~a.toLong)" (arg 0)))
     ((13 7) (fmt "(~a & 0xffffffffL)" (arg 0)))
     (else (fmt "~a.toLong" (arg 0))))))

