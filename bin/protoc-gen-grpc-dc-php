(define (rust-enum-fragment key)
  (define entry (assq key rust-enum-shape))
  (unless entry (error 'rust-enum-fragment "unknown key: ~e" key))
  (cdr entry))

(define-syntax (streaming-kind stx)
  (syntax-case stx ()
    ((_ client? server?)
     #'(cond
        ((and client? server?) 'bidi)
        (client? 'client-streaming)
        (server? 'server-streaming)
        (else 'unary)))))

(define method-alias-table '())

(define current-method-aliases (make-parameter method-alias-table))

(define (method-aliases-for service-full-name)
  (for/list
   ((a (in-list (current-method-aliases)))
    #:when
    (equal? (first a) service-full-name))
   a))

(define (pb-varint-bytes n)
  (unless (and (exact-integer? n) (>= n 0))
    (raise-argument-error 'pb-varint-bytes "exact-nonnegative-integer?" n))
  (let loop ((n n) (acc '()))
    (if (< n 128)
      (list->bytes (reverse (cons n acc)))
      (loop
       (arithmetic-shift n -7)
       (cons (bitwise-ior (bitwise-and n 127) 128) acc)))))

(define (pb-read-varint bstr i)
  (let loop ((i i) (shift 0) (acc 0) (count 0))
    (when (>= count 10) (error 'pb-parse "varint too long at byte ~a" i))
    (when (>= i (bytes-length bstr))
      (error 'pb-parse "truncated varint at byte ~a" i))
    (define b (bytes-ref bstr i))
    (define acc2
      (bitwise-ior acc (arithmetic-shift (bitwise-and b 127) shift)))
    (if (bitwise-bit-set? b 7)
      (loop (add1 i) (+ shift 7) acc2 (add1 count))
      (values acc2 (add1 i)))))

(define (pb-parse bstr)
  (let loop ((i 0) (acc '()))
    (if (>= i (bytes-length bstr))
      (reverse acc)
      (let-values (((tag j) (pb-read-varint bstr i)))
        (define num (arithmetic-shift tag -3))
        (define wire (bitwise-and tag 7))
        (when (zero? num) (error 'pb-parse "field number 0 at byte ~a" i))
        (case wire
          ((0)
           (let-values (((v k) (pb-read-varint bstr j)))
             (loop k (cons (list num wire v) acc))))
          ((2)
           (let-values (((len k) (pb-read-varint bstr j)))
             (when (> (+ k len) (bytes-length bstr))
               (error 'pb-parse "truncated length-delimited field ~a" num))
             (loop
              (+ k len)
              (cons (list num wire (subbytes bstr k (+ k len))) acc))))
          ((1)
           (loop (+ j 8) (cons (list num wire (subbytes bstr j (+ j 8))) acc)))
          ((5)
           (loop (+ j 4) (cons (list num wire (subbytes bstr j (+ j 4))) acc)))
          (else
           (error
            'pb-parse
            "unsupported wire type ~a for field ~a"
            wire
            num)))))))

(define (pb-get fields num (default #f))
  (define hit (findf (lambda (f) (= (first f) num)) fields))
  (if hit (third hit) default))

(define (pb-get-all fields num)
  (for/list ((f (in-list fields)) #:when (= (first f) num)) (third f)))

(define (pb-get-string fields num (default #f))
  (define v (pb-get fields num default))
  (if (bytes? v) (bytes->string/utf-8 v) v))

(define (pb-get-bool fields num)
  (define v (pb-get fields num 0))
  (and (integer? v) (not (zero? v))))

(define (pb-tag-bytes num wire)
  (pb-varint-bytes (bitwise-ior (arithmetic-shift num 3) wire)))

(define (pb-varint-field num n)
  (bytes-append (pb-tag-bytes num 0) (pb-varint-bytes n)))

(define (pb-bytes-field num bstr)
  (bytes-append
   (pb-tag-bytes num 2)
   (pb-varint-bytes (bytes-length bstr))
   bstr))

(define (pb-string-field num s) (pb-bytes-field num (string->bytes/utf-8 s)))

(define frame-header-size 9)

(define max-data-payload (* 16 1024 1024))

(define (encode-frame type stream-id payload)
  (unless (valid-frame-type? type)
    (raise-argument-error 'encode-frame "valid frame type" type))
  (unless (and (exact-integer? stream-id) (<= 0 stream-id 4294967295))
    (raise-argument-error 'encode-frame "uint32 stream id" stream-id))
  (when (and (= type frame:DATA) (> (bytes-length payload) max-data-payload))
    (error 'encode-frame "DATA payload exceeds 16 MiB"))
  (bytes-append
   (bytes type)
   (integer->integer-bytes stream-id 4 #f #t)
   (integer->integer-bytes (bytes-length payload) 4 #f #t)
   payload))

(define (decode-frame bstr)
  (when (< (bytes-length bstr) frame-header-size)
    (error
     'decode-frame
     "frame shorter than 9-byte header: ~a bytes"
     (bytes-length bstr)))
  (define type (bytes-ref bstr 0))
  (define stream-id (integer-bytes->integer bstr #f #t 1 5))
  (define len (integer-bytes->integer bstr #f #t 5 9))
  (unless (= len (- (bytes-length bstr) frame-header-size))
    (error
     'decode-frame
     "payload length ~a does not match message size ~a"
     len
     (bytes-length bstr)))
  (values type stream-id (subbytes bstr frame-header-size)))

(define (bytes->hex bstr)
  (apply
   string-append
   (for/list
    ((b (in-bytes bstr)))
    (~a (number->string b 16) #:width 2 #:align 'right #:pad-string "0"))))

(define (hex->bytes hex)
  (define clean (regexp-replace* #px"\\s+" hex ""))
  (unless (even? (string-length clean)) (error 'hex->bytes "odd hex length"))
  (list->bytes
   (for/list
    ((i (in-range 0 (string-length clean) 2)))
    (string->number (substring clean i (+ i 2)) 16))))

(define (simple-type-name full)
  (define parts (string-split (string-trim full ".") "."))
  (last parts))

(define (method-path package service method)
  (if (and package (not (string=? package "")))
    (format "/~a.~a/~a" package service method)
    (format "/~a/~a" service method)))

(define (options-deprecated fields options-field)
  (define raw (pb-get fields options-field #f))
  (and raw (bytes? raw) (pb-get-bool (pb-parse raw) 33)))

(define (parse-method fields package service-name)
  (define name (pb-get-string fields 1))
  (define client? (pb-get-bool fields 5))
  (define server? (pb-get-bool fields 6))
  (hasheq
   'name
   name
   'path
   (method-path package service-name name)
   'input
   (simple-type-name (pb-get-string fields 2))
   'output
   (simple-type-name (pb-get-string fields 3))
   'input-full
   (string-trim (pb-get-string fields 2) ".")
   'output-full
   (string-trim (pb-get-string fields 3) ".")
   'kind
   (streaming-kind client? server?)
   'client-streaming
   client?
   'server-streaming
   server?
   'deprecated
   (options-deprecated fields 4)))

(define (parse-service fields package)
  (define name (pb-get-string fields 1))
  (hasheq
   'name
   name
   'deprecated
   (options-deprecated fields 3)
   'full-name
   (if (and package (not (string=? package "")))
     (format "~a.~a" package name)
     name)
   'methods
   (for/list
    ((m (in-list (pb-get-all fields 2))))
    (parse-method (pb-parse m) package name))))

(define (parse-enum-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'values
   (for/list
    ((v (in-list (pb-get-all fields 2))))
    (define vf (pb-parse v))
    (hasheq 'name (pb-get-string vf 1) 'number (pb-get vf 2 0)))))

(define (parse-field-desc fields)
  (hasheq
   'name
   (pb-get-string fields 1)
   'extendee
   (string-trim (pb-get-string fields 2 "") ".")
   'number
   (pb-get fields 3 0)
   'label
   (pb-get fields 4 1)
   'type
   (pb-get fields 5 0)
   'type-name
   (string-trim (pb-get-string fields 6 "") ".")
   'default
   (pb-get-string fields 7 #f)
   'oneof-index
   (pb-get fields 9 #f)
   'json-name
   (pb-get-string fields 10 "")))

(define (parse-message-desc fields prefix)
  (define name (pb-get-string fields 1))
  (define full (if (string=? prefix "") name (format "~a.~a" prefix name)))
  (define opts (pb-get fields 7 #f))
  (hasheq
   'name
   name
   'full-name
   full
   'fields
   (for/list
    ((f (in-list (pb-get-all fields 2))))
    (parse-field-desc (pb-parse f)))
   'nested
   (for/list
    ((n (in-list (pb-get-all fields 3))))
    (parse-message-desc (pb-parse n) full))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 4))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 6))))
    (parse-field-desc (pb-parse f)))
   'oneofs
   (for/list
    ((o (in-list (pb-get-all fields 8))))
    (pb-get-string (pb-parse o) 1))
   'map-entry
   (and (bytes? opts) (pb-get-bool (pb-parse opts) 7))))

(define (parse-file-desc fields)
  (define package (pb-get-string fields 2 ""))
  (hasheq
   'name
   (pb-get-string fields 1)
   'package
   package
   'syntax
   (let ((s (pb-get-string fields 12 ""))) (if (string=? s "") "proto2" s))
   'dependencies
   (for/list ((d (in-list (pb-get-all fields 3)))) (bytes->string/utf-8 d))
   'services
   (for/list
    ((s (in-list (pb-get-all fields 6))))
    (parse-service (pb-parse s) package))
   'messages
   (for/list
    ((m (in-list (pb-get-all fields 4))))
    (parse-message-desc (pb-parse m) package))
   'enums
   (for/list
    ((e (in-list (pb-get-all fields 5))))
    (parse-enum-desc (pb-parse e)))
   'extensions
   (for/list
    ((f (in-list (pb-get-all fields 7))))
    (parse-field-desc (pb-parse f)))))

(define (merge-extensions files)
  (define exts
    (append
     (append-map (lambda (f) (hash-ref f 'extensions)) files)
     (let loop ((msgs (append-map (lambda (f) (hash-ref f 'messages)) files)))
       (if (null? msgs)
         '()
         (append
          (append-map (lambda (m) (hash-ref m 'extensions)) msgs)
          (loop (append-map (lambda (m) (hash-ref m 'nested)) msgs)))))))
  (define (add-to msg ext)
    (if (equal? (hash-ref msg 'full-name) (hash-ref ext 'extendee))
      (hash-set msg 'fields (append (hash-ref msg 'fields) (list ext)))
      (hash-set
       msg
       'nested
       (map (lambda (n) (add-to n ext)) (hash-ref msg 'nested)))))
  (for/fold
   ((fs files))
   ((ext (in-list exts)))
   (map
    (lambda (f)
      (hash-set
       f
       'messages
       (map (lambda (m) (add-to m ext)) (hash-ref f 'messages))))
    fs)))

(define (oneof-siblings model f)
  (define idx (hash-ref f 'oneof-index #f))
  (if (not idx)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (filter
         (lambda (x)
           (and (not (eq? x f)) (equal? (hash-ref x 'oneof-index #f) idx)))
         (hash-ref (car msgs) 'fields)))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (oneof-later-siblings model f)
  (define sibs (oneof-siblings model f))
  (if (null? sibs)
    '()
    (let search ((msgs (hash-ref model 'messages '())))
      (cond
       ((null? msgs) '())
       ((memq f (hash-ref (car msgs) 'fields))
        (define fields (hash-ref (car msgs) 'fields))
        (filter (lambda (x) (memq x (cdr (memq f fields)))) sibs))
       (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs))))))))

(define (field-owner model f)
  (let search ((msgs (hash-ref model 'messages '())))
    (cond
     ((null? msgs) #f)
     ((memq f (hash-ref (car msgs) 'fields)) (car msgs))
     (else (search (append (hash-ref (car msgs) 'nested) (cdr msgs)))))))

(define (field-explicit-default f)
  (and (hash-ref f 'default #f)
       (not (= (hash-ref f 'label 1) 3))
       (not (memv (hash-ref f 'type) '(10 11 12)))
       (hash-ref f 'default)))

(define (enum-default-number model f)
  (define types (and (hash-has-key? model 'types) (hash-ref model 'types)))
  (define entry (and types (hash-ref types (hash-ref f 'type-name) #f)))
  (define e (and entry (hash-ref entry 'enum #f)))
  (define v
    (and e
         (findf
          (lambda (x) (equal? (hash-ref x 'name) (hash-ref f 'default)))
          (hash-ref e 'values))))
  (and v (hash-ref v 'number)))

(define (build-type-registry files)
  (define reg (make-hash))
  (define (reg-msg file pkg msg)
    (hash-set!
     reg
     (hash-ref msg 'full-name)
     (hasheq
      'kind
      (if (hash-ref msg 'map-entry) 'map 'message)
      'msg
      msg
      'enum
      #f
      'file
      file
      'pkg
      pkg
      'full
      (hash-ref msg 'full-name)))
    (for ((n (in-list (hash-ref msg 'nested)))) (reg-msg file pkg n))
    (for
     ((e (in-list (hash-ref msg 'enums))))
     (hash-set!
      reg
      (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))
      (hasheq
       'kind
       'enum
       'msg
       #f
       'enum
       e
       'file
       file
       'pkg
       pkg
       'full
       (format "~a.~a" (hash-ref msg 'full-name) (hash-ref e 'name))))))
  (for
   ((f (in-list files)))
   (define pkg (hash-ref f 'package))
   (for
    ((m (in-list (hash-ref f 'messages))))
    (reg-msg (hash-ref f 'name) pkg m))
   (for
    ((e (in-list (hash-ref f 'enums))))
    (hash-set!
     reg
     (if (string=? pkg "")
       (hash-ref e 'name)
       (format "~a.~a" pkg (hash-ref e 'name)))
     (hasheq
      'kind
      'enum
      'msg
      #f
      'enum
      e
      'file
      (hash-ref f 'name)
      'pkg
      pkg
      'full
      (if (string=? pkg "")
        (hash-ref e 'name)
        (format "~a.~a" pkg (hash-ref e 'name)))))))
  reg)

(define (parse-request bstr)
  (define fields (pb-parse bstr))
  (define wanted
    (map (lambda (b) (bytes->string/utf-8 b)) (pb-get-all fields 1)))
  (define parameter (pb-get-string fields 2 ""))
  (define files
    (merge-extensions
     (for/list
      ((f (in-list (pb-get-all fields 15))))
      (parse-file-desc (pb-parse f)))))
  (define by-name
    (for/hash ((f (in-list files))) (values (hash-ref f 'name) f)))
  (define registry (build-type-registry files))
  (values
   (for/list
    ((w (in-list wanted)))
    (hash-set
     (hash-set
      (hash-ref
       by-name
       w
       (lambda ()
         (error 'parse-request "file_to_generate not in request: ~a" w)))
      'types
      registry)
     'generate-set
     wanted))
   parameter))

(define (map-entry-emitted-in-own-file? model entry)
  (define types (hash-ref model 'types #f))
  (and types
       (not (equal? (hash-ref entry 'file) (hash-ref model 'name)))
       (member (hash-ref entry 'file) (hash-ref model 'generate-set '()))
       (for/or
        (((k e) (in-hash types)))
        (and (eq? (hash-ref e 'kind) 'message)
             (equal? (hash-ref e 'file) (hash-ref entry 'file))
             (for/or
              ((f (in-list (hash-ref (hash-ref e 'msg) 'fields))))
              (and (= (hash-ref f 'type) 11)
                   (equal?
                    (hash-ref f 'type-name)
                    (hash-ref entry 'full))))))))

(define (parse-parameters parameter)
  (for/hash
   ((part (in-list (string-split parameter #rx"[,:]")))
    #:when
    (regexp-match? #rx"=" part))
   (define kv (string-split part "="))
   (values (string->symbol (first kv)) (second kv))))

(define (encode-response files)
  (apply
   bytes-append
   (pb-varint-field 2 1)
   (for/list
    ((f (in-list files)))
    (pb-bytes-field
     15
     (bytes-append
      (pb-string-field 1 (car f))
      (pb-string-field 15 (cdr f)))))))

(define (encode-error-response message) (pb-string-field 1 message))

(define (stamp-generated-header file-pair)
  (define prefix
    (cond
     ((or (string-suffix? (car file-pair) ".py")
          (string-suffix? (car file-pair) ".rb"))
      "#")
     ((string-suffix? (car file-pair) ".lua") "--")
     (else "//")))
  (if (string-suffix? (car file-pair) ".php")
    (cons
     (car file-pair)
     (string-append
      "<?php\n"
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (substring (cdr file-pair) (string-length "<?php\n"))))
    (cons
     (car file-pair)
     (string-append
      prefix
      " Generated code: use without restriction (see GENERATED-CODE-LICENSE.md).\n"
      (cdr file-pair)))))

(define (method-impl-name m) (hash-ref m 'impl-name (hash-ref m 'name)))

(define (find-method svc name)
  (findf
   (lambda (m) (equal? (hash-ref m 'name) name))
   (hash-ref svc 'methods)))

(define (alias-client-methods svc)
  (for/list
   ((a (in-list (method-aliases-for (hash-ref svc 'full-name))))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set target 'name (second a))))

(define (alias-server-methods svc)
  (define full (hash-ref svc 'full-name))
  (for/list
   ((a (in-list (method-aliases-for full)))
    #:do
    ((define target (find-method svc (third a))))
    #:when
    target)
   (hash-set*
    target
    'name
    (second a)
    'path
    (format "/~a/~a" full (second a))
    'impl-name
    (hash-ref target 'name))))

(define current-service (make-parameter ""))

(define (snake sym)
  (define s (symbol->string sym))
  (apply
   string-append
   (for/list
    ((c (in-string s)) (i (in-naturals)))
    (cond
     ((char-upper-case? c)
      (string-append (if (> i 0) "_" "") (string (char-downcase c))))
     (else (string c))))))

(define (camel str)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split str "_"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (php-deprecated m)
  (if (hash-ref m 'deprecated #f)
    "        trigger_error(\"deprecated\", E_USER_DEPRECATED);\n"
    ""))

(define (php-client-method model m)
  (define name (hash-ref m 'name))
  (define req (php-stub-ref model (hash-ref m 'input-full)))
  (define resp (php-stub-ref model (hash-ref m 'output-full)))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    public function ~a(~a $req, ?array $metadata = null, ?float $timeout = null): ~a\n"
       "    {\n~a        return $this->channel->unary(~s, $req, new ~a(), $metadata, $timeout);\n    }\n\n")
      name
      req
      resp
      (php-deprecated m)
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "    public function ~a(~a $req, ?array $metadata = null, ?float $timeout = null): RecvStream\n"
       "    {\n~a        $stream = $this->channel->serverStream(~s, $req, $metadata, $timeout);\n"
       "        return new RecvStream($stream, ~a::class);\n    }\n\n")
      name
      req
      (php-deprecated m)
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "    public function ~a(array $reqs, ?array $metadata = null, ?float $timeout = null): ~a\n"
       "    {\n~a        return $this->channel->clientStream(~s, $reqs, new ~a(), $metadata, $timeout);\n    }\n\n")
      name
      resp
      (php-deprecated m)
      path
      resp))
    ((bidi)
     (format
      (string-append
       "    public function ~a(array $reqs, ?array $metadata = null, ?float $timeout = null): RecvStream\n"
       "    {\n~a        $stream = $this->channel->bidi(~s, $reqs, $metadata, $timeout);\n"
       "        return new RecvStream($stream, ~a::class);\n    }\n\n")
      name
      (php-deprecated m)
      path
      resp))))

(define (php-fiber-client-method model m)
  (define name (hash-ref m 'name))
  (define req (php-stub-ref model (hash-ref m 'input-full)))
  (define resp (php-stub-ref model (hash-ref m 'output-full)))
  (define path (hash-ref m 'path))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    public function ~a(~a $req, ?array $metadata = null, ?float $timeout = null): ~a\n"
       "    {\n~a        return $this->channel->unary(~s, $req, new ~a(), $metadata, $timeout);\n    }\n\n")
      name
      req
      resp
      (php-deprecated m)
      path
      resp))
    ((server-streaming)
     (format
      (string-append
       "    public function ~a(~a $req, ?array $metadata = null, ?float $timeout = null): FiberRecvStream\n"
       "    {\n~a        $stream = $this->channel->serverStream(~s, $req, $metadata, $timeout);\n"
       "        return new FiberRecvStream($stream, ~a::class);\n    }\n\n")
      name
      req
      (php-deprecated m)
      path
      resp))
    ((client-streaming)
     (format
      (string-append
       "    public function ~a(array $reqs, ?array $metadata = null, ?float $timeout = null): ~a\n"
       "    {\n~a        return $this->channel->clientStream(~s, $reqs, new ~a(), $metadata, $timeout);\n    }\n\n")
      name
      resp
      (php-deprecated m)
      path
      resp))
    ((bidi)
     (format
      (string-append
       "    public function ~a(array $reqs, ?array $metadata = null, ?float $timeout = null): FiberRecvStream\n"
       "    {\n~a        $stream = $this->channel->bidi(~s, $reqs, $metadata, $timeout);\n"
       "        return new FiberRecvStream($stream, ~a::class);\n    }\n\n")
      name
      (php-deprecated m)
      path
      resp))))

(define (php-server-handler model m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (php-stub-ref model (hash-ref m 'input-full)))
  (define handler-var
    (string-append "$" (snake (string->symbol name)) "Handler"))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "    ~a = function (\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, \\Grpcdc\\ResponseSink $sink) use ($impl) {\n"
       "        $req = $reqs->recvInto(new ~a());\n"
       "        $resp = $impl->~a($ctx, $req);\n"
       "        $sink->send($resp->marshalDc());\n"
       "    };\n\n")
      handler-var
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "    ~a = function (\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, \\Grpcdc\\ResponseSink $sink) use ($impl) {\n"
       "        $req = $reqs->recvInto(new ~a());\n"
       "        $impl->~a($req, new SendStream($ctx, $sink));\n"
       "    };\n\n")
      handler-var
      req
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "    ~a = function (\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, \\Grpcdc\\ResponseSink $sink) use ($impl) {\n"
       "        $stream = new ClientStreamImpl($ctx, $reqs, ~a::class);\n"
       "        $impl->~a($stream);\n"
       "        if ($stream->resp === null) {\n"
       "            throw new \\Grpcdc\\StatusError(\\Grpcdc\\Wire::CODE_INTERNAL, \"client-streaming handler never called sendAndClose\");\n"
       "        }\n"
       "        $sink->send($stream->resp->marshalDc());\n"
       "    };\n\n")
      handler-var
      req
      impl-name))
    ((bidi)
     (format
      (string-append
       "    ~a = function (\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, \\Grpcdc\\ResponseSink $sink) use ($impl) {\n"
       "        $impl->~a(new BidiStream($ctx, $reqs, $sink, ~a::class));\n"
       "    };\n\n")
      handler-var
      impl-name
      req))))

(define (php-method-entry m)
  (define kind-name
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (format
   "            new \\Grpcdc\\Method(~s, ~s, \\Grpcdc\\Server::~a, ~a),\n"
   (hash-ref m 'name)
   (hash-ref m 'path)
   kind-name
   (string-append "$" (snake (string->symbol (hash-ref m 'name))) "Handler")))

(define php-stream-helpers
  (string-append
   "// Client receiving stream: recv throws CallClosed at end.\n"
   "class RecvStream\n"
   "{\n"
   "    private \\Grpcdc\\ClientStream $stream;\n"
   "    private string $respClass;\n\n"
   "    public function __construct(\\Grpcdc\\ClientStream $stream, string $respClass)\n"
   "    {\n        $this->stream = $stream;\n        $this->respClass = $respClass;\n    }\n\n"
   "    public function recv(): object\n"
   "    {\n        $cls = $this->respClass;\n        return $this->stream->recv(new $cls());\n    }\n\n"
   "    /** Response initial metadata (after the first recv). */\n"
   "    public function headers(): ?array\n"
   "    {\n        return $this->stream->headers?->metadata;\n    }\n\n"
   "    /** Response trailing metadata (after the call ends). */\n"
   "    public function trailers(): ?array\n"
   "    {\n        return $this->stream->trailers;\n    }\n\n"
   "    /** Abandon the call early: RST so the server stops producing. */\n"
   "    public function cancel(): void\n"
   "    {\n        $this->stream->cancel();\n    }\n\n"
   "    public function close(): void\n"
   "    {\n        $this->stream->cancel();\n    }\n\n"
   "    public function __destruct()\n"
   "    {\n        $this->close();\n    }\n\n"
   "    /** @return \\Generator<int, object> */\n"
   "    public function iterate(): \\Generator\n"
   "    {\n        $completed = false;\n        try {\n            while (true) {\n                yield $this->recv();\n            }\n        } catch (\\Grpcdc\\CallClosed $e) {\n            $completed = true;\n            return;\n        } finally {\n            if (!$completed) {\n                $this->close();\n            }\n        }\n    }\n"
   "}\n\n"
   "// Server-streaming sink passed to service implementations.\n"
   "class SendStream\n"
   "{\n"
   "    public \\Grpcdc\\CallContext $context;\n"
   "    private \\Grpcdc\\ResponseSink $sink;\n\n"
   "    public function __construct(\\Grpcdc\\CallContext $ctx, \\Grpcdc\\ResponseSink $sink)\n"
   "    {\n        $this->context = $ctx;\n        $this->sink = $sink;\n    }\n\n"
   "    public function send(object $resp): void\n"
   "    {\n        $this->sink->send($resp->marshalDc());\n    }\n"
   "}\n\n"
   "// Client-streaming stream passed to service implementations.\n"
   "class ClientStreamImpl\n"
   "{\n"
   "    public \\Grpcdc\\CallContext $context;\n"
   "    public ?object $resp = null;\n"
   "    private \\Grpcdc\\RequestStream $reqs;\n"
   "    private string $reqClass;\n\n"
   "    public function __construct(\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, string $reqClass)\n"
   "    {\n        $this->context = $ctx;\n        $this->reqs = $reqs;\n        $this->reqClass = $reqClass;\n    }\n\n"
   "    public function recv(): object\n"
   "    {\n        $cls = $this->reqClass;\n        return $this->reqs->recvInto(new $cls());\n    }\n\n"
   "    public function sendAndClose(object $resp): void\n"
   "    {\n        $this->resp = $resp;\n    }\n"
   "}\n\n"
   "// Bidi stream passed to service implementations.\n"
   "class BidiStream\n"
   "{\n"
   "    public \\Grpcdc\\CallContext $context;\n"
   "    private \\Grpcdc\\RequestStream $reqs;\n"
   "    private \\Grpcdc\\ResponseSink $sink;\n"
   "    private string $reqClass;\n\n"
   "    public function __construct(\\Grpcdc\\CallContext $ctx, \\Grpcdc\\RequestStream $reqs, \\Grpcdc\\ResponseSink $sink, string $reqClass)\n"
   "    {\n        $this->context = $ctx;\n        $this->reqs = $reqs;\n        $this->sink = $sink;\n        $this->reqClass = $reqClass;\n    }\n\n"
   "    public function send(object $resp): void\n"
   "    {\n        $this->sink->send($resp->marshalDc());\n    }\n\n"
   "    public function recv(): object\n"
   "    {\n        $cls = $this->reqClass;\n        return $this->reqs->recvInto(new $cls());\n    }\n"
   "}\n\n"
   "// Fiber-based client receiving stream: a producer Fiber suspends\n"
   "// per response; next() resumes it and throws CallClosed when the\n"
   "// call completes. cancel aborts the underlying stream (RST).\n"
   "class FiberRecvStream\n"
   "{\n"
   "    /** @var \\Grpcdc\\ClientStream|\\Grpcdc\\FiberClientStream */\n"
   "    private $stream;\n"
   "    private string $respClass;\n"
   "    private ?\\Fiber $fiber = null;\n"
   "    private bool $started = false;\n"
   "    private bool $done = false;\n\n"
   "    public function __construct($stream, string $respClass)\n"
   "    {\n        $this->stream = $stream;\n        $this->respClass = $respClass;\n    }\n\n"
   "    public function next(): object\n"
   "    {\n"
   "        if ($this->done) {\n            throw new \\Grpcdc\\CallClosed(\"stream exhausted\");\n        }\n"
   "        if (!$this->started) {\n"
   "            $this->started = true;\n"
   "            $cls = $this->respClass;\n"
   "            $stream = $this->stream;\n"
   "            $this->fiber = new \\Fiber(function () use ($stream, $cls) {\n"
   "                try {\n"
   "                    while (true) {\n"
   "                        \\Fiber::suspend($stream->recv(new $cls()));\n"
   "                    }\n"
   "                } catch (\\Grpcdc\\CallClosed $e) {\n"
   "                    return;\n"
   "                }\n"
   "            });\n"
   "            $value = $this->fiber->start();\n"
   "        } else {\n"
   "            $value = $this->fiber->resume();\n"
   "        }\n"
   "        if ($this->fiber->isTerminated()) {\n"
   "            $this->done = true;\n"
   "            throw new \\Grpcdc\\CallClosed(\"stream exhausted\");\n"
   "        }\n"
   "        return $value;\n"
   "    }\n\n"
   "    /** @return \\Generator<int, object> */\n"
   "    public function iterate(): \\Generator\n"
   "    {\n        $completed = false;\n        try {\n            while (true) {\n                yield $this->next();\n            }\n        } catch (\\Grpcdc\\CallClosed $e) {\n            $completed = true;\n            return;\n        } finally {\n            if (!$completed) {\n                $this->close();\n            }\n        }\n    }\n\n"
   "    /** Response initial metadata (after the first recv). */\n"
   "    public function headers(): ?array\n"
   "    {\n        return $this->stream->headers?->metadata;\n    }\n\n"
   "    /** Response trailing metadata (after the call ends). */\n"
   "    public function trailers(): ?array\n"
   "    {\n        return $this->stream->trailers;\n    }\n\n"
   "    public function cancel(): void\n"
   "    {\n        $this->stream->cancel();\n    }\n\n"
   "    public function close(): void\n"
   "    {\n        $this->stream->cancel();\n    }\n\n"
   "    public function __destruct()\n"
   "    {\n        $this->close();\n    }\n"
   "}\n\n"))

(define (php-service model svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (parameterize
   ((current-service sname))
   (string-append
    (format
     "class ~aClient\n{\n    private \\Grpcdc\\Channel $channel;\n\n    public function __construct(\\Grpcdc\\Channel $channel)\n    {\n        $this->channel = $channel;\n    }\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (php-client-method model m))
      (append methods (alias-client-methods svc))))
    "}\n\n"
    (format
     "// Fiber client: wraps a Grpcdc\\FiberChannel (a sync Channel is wrapped).\nclass ~aClientFiber\n{\n    private \\Grpcdc\\FiberChannel $channel;\n\n    public function __construct($channel)\n    {\n        $this->channel = $channel instanceof \\Grpcdc\\FiberChannel ? $channel : new \\Grpcdc\\FiberChannel($channel);\n    }\n\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (php-fiber-client-method model m))
      (append methods (alias-client-methods svc))))
    "}\n\n"
    (format
     "function register~aServer(\\Grpcdc\\Server $server, object $impl): void\n{\n"
     sname)
    (apply
     string-append
     (map
      (lambda (m) (php-server-handler model m))
      (append methods (alias-server-methods svc))))
    (format
     "    $server->registerService(new \\Grpcdc\\ServiceDesc(\n        ~s,\n        [\n"
     (hash-ref svc 'full-name))
    (apply
     string-append
     (map php-method-entry (append methods (alias-server-methods svc))))
    "        ]\n    ));\n}\n")))

(define php-pb-varint-types '(5 3 13 4 17 18 8 14))

(define php-pb-fixed
  '((2 4 "g") (1 8 "e") (7 4 "V") (15 4 "V") (6 8 "P") (16 8 "P")))

(define (php-pb-camel s)
  (define parts (string-split s "_"))
  (if (null? parts)
    s
    (apply
     string-append
     (car parts)
     (map
      (lambda (p)
        (if (string=? p "")
          ""
          (string-append
           (string (char-upcase (string-ref p 0)))
           (substring p 1))))
      (cdr parts)))))

(define (php-pb-field-name f)
  (define jn (hash-ref f 'json-name ""))
  (if (and jn (not (string=? jn ""))) jn (php-pb-camel (hash-ref f 'name))))

(define php-pb-reserved
  (list->set
   (map
    string-downcase
    '("abstract"
      "and"
      "array"
      "as"
      "break"
      "callable"
      "case"
      "catch"
      "class"
      "clone"
      "const"
      "continue"
      "declare"
      "default"
      "do"
      "echo"
      "else"
      "elseif"
      "empty"
      "enddeclare"
      "endfor"
      "endforeach"
      "endif"
      "endswitch"
      "endwhile"
      "enum"
      "eval"
      "exit"
      "extends"
      "final"
      "finally"
      "fn"
      "for"
      "foreach"
      "function"
      "global"
      "goto"
      "if"
      "implements"
      "include"
      "include_once"
      "instanceof"
      "insteadof"
      "interface"
      "isset"
      "list"
      "match"
      "namespace"
      "new"
      "or"
      "parent"
      "print"
      "private"
      "protected"
      "public"
      "readonly"
      "require"
      "require_once"
      "return"
      "self"
      "static"
      "switch"
      "throw"
      "trait"
      "try"
      "unset"
      "use"
      "var"
      "while"
      "xor"
      "yield"
      "int"
      "float"
      "bool"
      "string"
      "true"
      "false"
      "null"
      "void"
      "iterable"
      "object"
      "mixed"
      "never"
      "resource"
      "numeric"))))

(define (php-pb-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (define flat (string-join (string-split rel ".") "_"))
  (if (set-member? php-pb-reserved (string-downcase flat))
    (string-append flat "_")
    flat))

(define (php-pb-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'emit-php-pb-file "unresolved type ~a" type-name))))

(define (php-stub-ref file-model full)
  (define e (php-pb-resolve file-model full))
  (format
   "\\~a\\~a"
   (php-pb-namespace e)
   (php-pb-flat (hash-ref e 'pkg) (hash-ref (hash-ref e 'msg) 'full-name))))

(define (php-stub-requires file-model)
  (if (hash-ref file-model 'types #f)
    (apply
     string-append
     (map
      (lambda (fn)
        (format
         "require_once __DIR__ . \"/~a_pb.php\";\n"
         (path->string (path-replace-extension (file-name-from-path fn) ""))))
      (remove-duplicates
       (append-map
        (lambda (svc)
          (append-map
           (lambda (m)
             (list
              (hash-ref
               (php-pb-resolve file-model (hash-ref m 'input-full))
               'file)
              (hash-ref
               (php-pb-resolve file-model (hash-ref m 'output-full))
               'file)))
           (hash-ref svc 'methods)))
        (hash-ref file-model 'services)))))
    (format
     "require_once __DIR__ . \"/~a_pb.php\";\n"
     (path->string
      (path-replace-extension
       (file-name-from-path (hash-ref file-model 'name))
       "")))))

(define (php-pb-namespace entry)
  (define base
    (path->string
     (path-replace-extension (file-name-from-path (hash-ref entry 'file)) "")))
  (string-append (camel base) "Pb"))

(define (php-pb-entry-ref model entry)
  (define local
    (php-pb-flat
     (hash-ref entry 'pkg)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (let ((e (hash-ref entry 'enum)))
         (if (hash-ref entry 'msg)
           (format
            "~a.~a"
            (hash-ref (hash-ref entry 'msg) 'full-name)
            (hash-ref e 'name))
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name))))
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (if (or (eq? (hash-ref entry 'kind) 'map)
          (equal? (hash-ref entry 'file) (hash-ref model 'name)))
    local
    (format
     "\\~a\\~a"
     (php-pb-namespace entry)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (hash-ref (hash-ref entry 'enum) 'name)
       (php-pb-flat
        (hash-ref entry 'pkg)
        (hash-ref (hash-ref entry 'msg) 'full-name))))))

(define (php-pb-type model f)
  (define type (hash-ref f 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (php-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    "array")
   ((= (hash-ref f 'label) 3) "array")
   ((memv type '(1 2)) "float")
   ((memv type '(9 12)) "string")
   ((= type 8) "bool")
   ((= type 11)
    (format
     "?~a"
     (php-pb-entry-ref model (php-pb-resolve model (hash-ref f 'type-name)))))
   (else "int")))

(define (php-pb-explicit-literal model f)
  (define d (field-explicit-default f))
  (and d
       (case (hash-ref f 'type)
         ((9) (format "~s" d))
         ((8) d)
         ((14) (format "~a" (enum-default-number model f)))
         ((2) (format "~a" d))
         (else d))))

(define (php-pb-default model f)
  (cond
   ((php-pb-explicit-literal model f) => (lambda (lit) lit))
   ((and (= (hash-ref f 'type) 11)
         (eq?
          (hash-ref (php-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    "[]")
   ((= (hash-ref f 'label) 3) "[]")
   ((= (hash-ref f 'type) 11) "null")
   ((memv (hash-ref f 'type) '(9 12)) "\"\"")
   ((= (hash-ref f 'type) 8) "false")
   ((memv (hash-ref f 'type) '(1 2)) "0.0")
   ((= (hash-ref f 'type) 14)
    (define entry (php-pb-resolve model (hash-ref f 'type-name)))
    (format
     "~a"
     (hash-ref (car (hash-ref (hash-ref entry 'enum) 'values)) 'number)))
   (else "0")))

(define (php-pb-varint-expr f v)
  (case (hash-ref f 'type)
    ((8) (format "(~a ? 1 : 0)" v))
    ((17) (format "(((~a << 1) ^ (~a >> 31)) & 0xffffffff)" v v))
    ((18) (format "((~a << 1) ^ (~a >> 63))" v v))
    (else v)))

(define (php-pb-varint-decode f v)
  (case (hash-ref f 'type)
    ((5 14)
     (format
      "(((~a & 0xffffffff) >= 0x80000000) ? ((~a & 0xffffffff) - 0x100000000) : (~a & 0xffffffff))"
      v
      v
      v))
    ((13 7) (format "(~a & 0xffffffff)" v))
    ((8) (format "(~a !== 0)" v))
    ((17) (format "(((~a & 0xffffffff) >> 1) ^ -((~a & 0xffffffff) & 1))" v v))
    ((18) (format "((~a >> 1) ^ -(~a & 1))" v v))
    (else v)))

(define (php-pb-fixed-fmt f) (third (assv (hash-ref f 'type) php-pb-fixed)))

(define (php-pb-wire f)
  (if (= (second (assv (hash-ref f 'type) php-pb-fixed)) 8) 1 5))

(define (php-pb-nonzero f v)
  (case (hash-ref f 'type) ((8) v) (else (format "~a !== 0" v))))

(define (php-pb-fixed-decode f src)
  (case (hash-ref f 'type)
    ((15)
     (format
      "(((unpack('V', ~a)[1]) >= 0x80000000) ? (unpack('V', ~a)[1] - 0x100000000) : unpack('V', ~a)[1])"
      src
      src
      src))
    ((16)
     (format
      "(((((unpack('V', substr(~a, 4, 4))[1]) >= 0x80000000) ? (unpack('V', substr(~a, 4, 4))[1] - 0x100000000) : unpack('V', substr(~a, 4, 4))[1]) << 32) | unpack('V', substr(~a, 0, 4))[1])"
      src
      src
      src
      src))
    (else (format "unpack(~s, ~a)[1]" (php-pb-fixed-fmt f) src))))

(define (php-pb-encode-singular model f v indent)
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define proto2? (equal? (hash-ref model 'syntax "") "proto2"))
  (cond
   ((memv type php-pb-varint-types)
    (if proto2?
      (format
       "~a{\n~a    $w->tag(~a, 0);\n~a    $w->varint(~a);\n~a}\n"
       indent
       indent
       n
       indent
       (php-pb-varint-expr f v)
       indent)
      (format
       "~aif (~a) {\n~a    $w->tag(~a, 0);\n~a    $w->varint(~a);\n~a}\n"
       indent
       (php-pb-nonzero f v)
       indent
       n
       indent
       (php-pb-varint-expr f v)
       indent)))
   ((assv type php-pb-fixed)
    (if proto2?
      (format
       "~a{\n~a    $w->tag(~a, ~a);\n~a    $w->fixed(~s, ~a);\n~a}\n"
       indent
       indent
       n
       (php-pb-wire f)
       indent
       (if (= type 16) "P" (php-pb-fixed-fmt f))
       (if (= type 15) (format "(~a & 0xffffffff)" v) v)
       indent)
      (format
       "~aif (~a != 0) {\n~a    $w->tag(~a, ~a);\n~a    $w->fixed(~s, ~a);\n~a}\n"
       indent
       v
       indent
       n
       (php-pb-wire f)
       indent
       (if (= type 16) "P" (php-pb-fixed-fmt f))
       (if (= type 15) (format "(~a & 0xffffffff)" v) v)
       indent)))
   ((= type 9)
    (if proto2?
      (format "~a$w->bytesField(~a, ~a);\n" indent n v)
      (format "~a$w->stringField(~a, ~a);\n" indent n v)))
   ((= type 12)
    (if proto2?
      (format "~a$w->bytesField(~a, ~a);\n" indent n v)
      (format
       "~aif (strlen(~a) > 0) {\n~a    $w->bytesField(~a, ~a);\n~a}\n"
       indent
       v
       indent
       n
       v
       indent)))
   ((= type 11)
    (format
     "~aif (~a !== null) {\n~a    $w->bytesField(~a, ~a->marshalDc());\n~a}\n"
     indent
     v
     indent
     n
     v
     indent))
   (else (error 'emit-php-pb-file "unsupported field type ~a (groups)" type))))

(define (php-pb-set-expr sib)
  (define v (format "$this->~a" (php-pb-field-name sib)))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a !== null" v))
    ((9 12) (format "(~a !== null && ~a !== \"\")" v v))
    ((1 2) (format "~a != 0" v))
    (else (php-pb-nonzero sib v))))

(define (php-pb-encode-guard model f code)
  (define later (oneof-later-siblings model f))
  (if (null? later)
    code
    (format
     "        if (!(~a)) {\n~a        }\n"
     (string-join (map php-pb-set-expr later) " || ")
     (if (string-suffix? code "\n") code (string-append code "\n")))))

(define (php-pb-encode-field model f)
  (define v (format "$this->~a" (php-pb-field-name f)))
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (php-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (php-pb-resolve model (hash-ref f 'type-name)))
    (define helper (format "encode~a" (php-pb-entry-ref model entry)))
    (format
     "        foreach (~a as $k => $val) {\n            $w->bytesField(~a, ~a($k, $val));\n        }\n"
     v
     n
     helper))
   ((not (= (hash-ref f 'label) 3))
    (php-pb-encode-singular model f v "        "))
   ((memv type php-pb-varint-types)
    (string-append
     (format "        if (!empty(~a)) {\n            $payload = \"\";\n" v)
     (format
      "            foreach (~a as $x) {\n                $payload .= pbVarintBytes(~a);\n            }\n"
      v
      (php-pb-varint-expr f "$x"))
     (format "            $w->bytesField(~a, $payload);\n        }\n" n)))
   ((assv type php-pb-fixed)
    (string-append
     (format "        if (!empty(~a)) {\n            $payload = \"\";\n" v)
     (format
      "            foreach (~a as $x) {\n                $payload .= pack(~s, ~a);\n            }\n"
      v
      (if (= type 16) "P" (php-pb-fixed-fmt f))
      (if (= type 15) "($x & 0xffffffff)" "$x"))
     (format "            $w->bytesField(~a, $payload);\n        }\n" n)))
   ((= type 9)
    (format
     "        foreach (~a as $x) {\n            $w->bytesField(~a, $x);\n        }\n"
     v
     n))
   ((= type 12)
    (format
     "        foreach (~a as $x) {\n            $w->bytesField(~a, $x);\n        }\n"
     v
     n))
   ((= type 11)
    (format
     "        foreach (~a as $x) {\n            $w->bytesField(~a, $x->marshalDc());\n        }\n"
     v
     n))
   (else (error 'emit-php-pb-file "unsupported repeated field type ~a" type))))

(define (php-pb-decode-singular model f target src indent)
  (define type (hash-ref f 'type))
  (cond
   ((memv type php-pb-varint-types)
    (format "~a~a = ~a;\n" indent target (php-pb-varint-decode f src)))
   ((assv type php-pb-fixed)
    (format "~a~a = ~a;\n" indent target (php-pb-fixed-decode f src)))
   ((= type 9) (format "~a~a = ~a;\n" indent target src))
   ((= type 12) (format "~a~a = ~a;\n" indent target src))
   ((= type 11)
    (define ref
      (php-pb-entry-ref model (php-pb-resolve model (hash-ref f 'type-name))))
    (string-append
     (format "~a~a = new ~a();\n" indent target ref)
     (format "~a~a->unmarshalDc(~a);\n" indent target src)))
   (else (error 'emit-php-pb-file "unsupported field type ~a" type))))

(define (php-pb-oneof-clearing model f)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "                    $this->~a = ~a;\n"
       (php-pb-field-name sib)
       (php-pb-default model sib)))
    (oneof-siblings model f))))

(define (php-pb-decode-case model f)
  (define v (format "$this->~a" (php-pb-field-name f)))
  (define type (hash-ref f 'type))
  (define head (format "                case ~a:\n" (hash-ref f 'number)))
  (define clearing (php-pb-oneof-clearing model f))
  (define foot "                    break;\n")
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (php-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (php-pb-resolve model (hash-ref f 'type-name)))
    (define helper (format "decode~a" (php-pb-entry-ref model entry)))
    (string-append
     head
     (format "                    [$kk, $vv] = ~a($bytesValue);\n" helper)
     (format "                    ~a[$kk] = $vv;\n" v)
     foot))
   ((not (= (hash-ref f 'label) 3))
    (string-append
     head
     clearing
     (php-pb-decode-singular
      model
      f
      v
      (cond
       ((memv type php-pb-varint-types) "$varintValue")
       ((assv type php-pb-fixed) "$fixedValue")
       (else "$bytesValue"))
      "                    ")
     foot))
   ((memv type php-pb-varint-types)
    (string-append
     head
     "                    if ($wire === 2) {\n"
     "                        $sub = new Reader($bytesValue);\n"
     "                        while (!$sub->done()) {\n"
     "                            $raw = $sub->varint();\n"
     (format
      "                            ~a[] = ~a;\n"
      v
      (php-pb-varint-decode f "$raw"))
     "                        }\n                    } else {\n"
     (format
      "                        ~a[] = ~a;\n"
      v
      (php-pb-varint-decode f "$varintValue"))
     "                    }\n"
     foot))
   ((assv type php-pb-fixed)
    (string-append
     head
     "                    if ($wire === 2) {\n"
     (format
      "                        for ($i = 0; $i < strlen($bytesValue); $i += ~a) {\n"
      (second (assv type php-pb-fixed)))
     (format
      "                            ~a[] = ~a;\n"
      v
      (php-pb-fixed-decode
       f
       (format
        "substr($bytesValue, $i, ~a)"
        (second (assv type php-pb-fixed)))))
     "                        }\n                    } else {\n"
     (format
      "                        ~a[] = ~a;\n"
      v
      (php-pb-fixed-decode f "$fixedValue"))
     "                    }\n"
     foot))
   ((= type 9)
    (string-append
     head
     (format "                    ~a[] = $bytesValue;\n" v)
     foot))
   ((= type 12)
    (string-append
     head
     (format "                    ~a[] = $bytesValue;\n" v)
     foot))
   ((= type 11)
    (string-append
     head
     (format
      "                    $item = new ~a();\n"
      (php-pb-entry-ref model (php-pb-resolve model (hash-ref f 'type-name))))
     "                    $item->unmarshalDc($bytesValue);\n"
     (format "                    ~a[] = $item;\n" v)
     foot))
   (else (error 'emit-php-pb-file "unsupported repeated field type ~a" type))))

(define (php-pb-map-helpers model entry)
  (define msg (hash-ref entry 'msg))
  (define base (php-pb-entry-ref model entry))
  (define key-f
    (findf (lambda (x) (= (hash-ref x 'number) 1)) (hash-ref msg 'fields)))
  (define val-f
    (findf (lambda (x) (= (hash-ref x 'number) 2)) (hash-ref msg 'fields)))
  (unless (and key-f val-f)
    (error
     'emit-php-pb-file
     "map entry ~a lacks key/value"
     (hash-ref msg 'full-name)))
  (string-append
   (format
    "function encode~a($key, $value): string\n{\n    $w = new Writer();\n"
    base)
   (php-pb-encode-singular model (hash-set key-f 'label 1) "$key" "    ")
   (php-pb-encode-singular model (hash-set val-f 'label 1) "$value" "    ")
   "    return $w->toBytes();\n}\n\n"
   (format "function decode~a(string $data): array\n{\n" base)
   (format
    "    $key = ~a;\n    $value = ~a;\n"
    (php-pb-default model (hash-set key-f 'label 1))
    (php-pb-default model (hash-set val-f 'label 1)))
   "    $r = new Reader($data);\n    while (($item = $r->field()) !== null) {\n        [$num, $wire, $varintValue, $bytesValue, $fixedValue, $rawValue] = $item;\n"
   (format
    "        if ($num === ~a) {\n~a"
    (hash-ref key-f 'number)
    (php-pb-decode-singular
     model
     (hash-set key-f 'label 1)
     "$key"
     (cond
      ((memv (hash-ref key-f 'type) php-pb-varint-types) "$varintValue")
      ((assv (hash-ref key-f 'type) php-pb-fixed) "$fixedValue")
      (else "$bytesValue"))
     "            "))
   (format
    "        } elseif ($num === ~a) {\n~a"
    (hash-ref val-f 'number)
    (if (= (hash-ref val-f 'type) 11)
      (format
       "            $value = new ~a();\n            $value->unmarshalDc($bytesValue);\n"
       (php-pb-entry-ref
        model
        (php-pb-resolve model (hash-ref val-f 'type-name))))
      (php-pb-decode-singular
       model
       (hash-set val-f 'label 1)
       "$value"
       (cond
        ((memv (hash-ref val-f 'type) php-pb-varint-types) "$varintValue")
        ((assv (hash-ref val-f 'type) php-pb-fixed) "$fixedValue")
        (else "$bytesValue"))
       "            ")))
   "        }\n    }\n    return [$key, $value];\n}\n\n"))

(define php-pb-support
  (string-append
   "function pbVarintBytes(int $value): string\n{\n    $out = \"\";\n    $v = $value;\n    while (true) {\n        $b = $v & 0x7f;\n        $v = ($v >> 7) & 0x01ffffffffffffff;\n        if ($v === 0) {\n            return $out . chr($b);\n        }\n        $out .= chr($b | 0x80);\n    }\n}\n\n"
   "final class Writer\n{\n    private string $out = \"\";\n\n"
   "    public function varint(int $value): void\n    {\n        $this->out .= pbVarintBytes($value);\n    }\n\n"
   "    public function tag(int $field, int $wire): void\n    {\n        $this->varint(($field << 3) | $wire);\n    }\n\n"
   "    public function bytesField(int $field, string $payload): void\n    {\n        $this->tag($field, 2);\n        $this->varint(strlen($payload));\n        $this->out .= $payload;\n    }\n\n"
   "    public function stringField(int $field, string $value): void\n    {\n        if ($value === \"\") {\n            return;\n        }\n        $this->bytesField($field, $value);\n    }\n\n"
   "    public function fixed(string $fmt, $value): void\n    {\n        $this->out .= pack($fmt, $value);\n    }\n\n"
   "    public function raw(string $payload): void\n    {\n        $this->out .= $payload;\n    }\n\n"
   "    public function toBytes(): string\n    {\n        return $this->out;\n    }\n}\n\n"
   "final class Reader\n{\n    private string $buf;\n    private int $pos = 0;\n\n"
   "    public function __construct(string $buf)\n    {\n        $this->buf = $buf;\n    }\n\n"
   "    public function done(): bool\n    {\n        return $this->pos >= strlen($this->buf);\n    }\n\n"
   "    public function varint(): int\n    {\n        $result = 0;\n        $shift = 0;\n        while (true) {\n            if ($this->pos >= strlen($this->buf)) {\n                throw new \\InvalidArgumentException(\"truncated varint\");\n            }\n            $b = ord($this->buf[$this->pos]);\n            $this->pos++;\n            if ($shift < 63) {\n                $result |= ($b & 0x7f) << $shift;\n            } elseif (($b & 1) !== 0) {\n                $result |= PHP_INT_MIN;\n            }\n            if (($b & 0x80) === 0) {\n                return $result;\n            }\n            $shift += 7;\n            if ($shift >= 70) {\n                throw new \\InvalidArgumentException(\"varint too long\");\n            }\n        }\n    }\n\n"
   "    public function take(int $n): string\n    {\n        if ($this->pos + $n > strlen($this->buf)) {\n            throw new \\InvalidArgumentException(\"truncated field\");\n        }\n        $value = substr($this->buf, $this->pos, $n);\n        $this->pos += $n;\n        return $value;\n    }\n\n"
   "    /** [number, wire, varint_value, bytes_value, fixed_value] or null. */\n"
   "    public function field(): ?array\n    {\n        if ($this->done()) {\n            return null;\n        }\n        $start = $this->pos;\n        $tag = $this->varint();\n        $num = $tag >> 3;\n        $wire = $tag & 7;\n        switch ($wire) {\n            case 0:\n                $v = $this->varint();\n                return [$num, $wire, $v, \"\", \"\", substr($this->buf, $start, $this->pos - $start)];\n            case 2:\n                $n = $this->varint();\n                $b = $this->take($n);\n                return [$num, $wire, 0, $b, \"\", substr($this->buf, $start, $this->pos - $start)];\n            case 1:\n                $b = $this->take(8);\n                return [$num, $wire, 0, \"\", $b, substr($this->buf, $start, $this->pos - $start)];\n            case 5:\n                $b = $this->take(4);\n                return [$num, $wire, 0, \"\", $b, substr($this->buf, $start, $this->pos - $start)];\n            default:\n                throw new \\InvalidArgumentException(\"bad wire type\");\n        }\n    }\n}\n\n"))

(define (php-pb-message-class model msg)
  (define name
    (php-pb-flat (hash-ref model 'package) (hash-ref msg 'full-name)))
  (define fields (hash-ref msg 'fields))
  (string-append
   (format "class ~a\n{\n" name)
   (apply
    string-append
    (map
     (lambda (f)
       (format
        "    public ~a $~a = ~a;\n"
        (php-pb-type model f)
        (php-pb-field-name f)
        (php-pb-default model f)))
     fields))
   (if (null? fields) "" "\n")
   "    public string $unknownFields = \"\";\n"
   (format
    "    public function __construct(~a)\n    {\n"
    (string-join
     (map
      (lambda (f)
        (format
         "~a $~a = ~a"
         (php-pb-type model f)
         (php-pb-field-name f)
         (php-pb-default model f)))
      fields)
     ", "))
   (apply
    string-append
    (map
     (lambda (f)
       (format
        "        $this->~a = $~a;\n"
        (php-pb-field-name f)
        (php-pb-field-name f)))
     fields))
   "    }\n\n"
   "    public function marshalDc(): string\n    {\n        $w = new Writer();\n"
   (apply
    string-append
    (map
     (lambda (f) (php-pb-encode-guard model f (php-pb-encode-field model f)))
     fields))
   "        $w->raw($this->unknownFields);\n"
   "        return $w->toBytes();\n    }\n\n"
   "    public function unmarshalDc(string $data): self\n    {\n"
   "        $this->unknownFields = \"\";\n"
   (apply
    string-append
    (map
     (lambda (f)
       (format
        "        $this->~a = ~a;\n"
        (php-pb-field-name f)
        (php-pb-default model f)))
     fields))
   "        $r = new Reader($data);\n        while (($item = $r->field()) !== null) {\n            [$num, $wire, $varintValue, $bytesValue, $fixedValue, $rawValue] = $item;\n            switch ($num) {\n"
   (apply string-append (map (lambda (f) (php-pb-decode-case model f)) fields))
   "                default:\n                    $this->unknownFields .= $rawValue;\n                    break;\n            }\n        }\n        return $this;\n    }\n\n"
   (format
    "    public function equals(?object $other): bool\n    {\n        return $other instanceof ~a~a;\n    }\n}\n\n"
    name
    (if (null? fields)
      ""
      (string-append
       "\n            && "
       (string-join
        (map
         (lambda (f)
           (format
            "$this->~a === $other->~a"
            (php-pb-field-name f)
            (php-pb-field-name f)))
         fields)
        "\n            && "))))
   (apply
    string-append
    (map (lambda (n) (php-pb-message-class model n)) (hash-ref msg 'nested)))))

(define (php-pb-enum model e)
  (define name
    (php-pb-flat
     (hash-ref model 'package)
     (if (string=? (hash-ref model 'package) "")
       (hash-ref e 'name)
       (format "~a.~a" (hash-ref model 'package) (hash-ref e 'name)))))
  (string-append
   (format "final class ~a\n{\n" name)
   (apply
    string-append
    (map
     (lambda (v)
       (format
        "    public const ~a = ~a;\n"
        (hash-ref v 'name)
        (hash-ref v 'number)))
     (hash-ref e 'values)))
   "}\n\n"))

(define (emit-php-pb-file file-model)
  (and (hash-has-key? file-model 'messages)
       (hash-has-key? file-model 'types)
       (emit-php-pb-file/inner file-model)))

(define (emit-php-pb-file/inner file-model)
  (define messages (hash-ref file-model 'messages))
  (define enums (hash-ref file-model 'enums))
  (and (or (pair? messages) (pair? enums))
       (let ()
         (define base
           (path->string
            (path-replace-extension
             (file-name-from-path (hash-ref file-model 'name))
             "")))
         (define pkg (hash-ref file-model 'package))
         (define seen-maps (mutable-set))
         (define helpers '())
         (define (collect msg)
           (for
            ((f (in-list (hash-ref msg 'fields))))
            (when (= (hash-ref f 'type) 11)
              (define e (php-pb-resolve file-model (hash-ref f 'type-name)))
              (when (and
                     (eq? (hash-ref e 'kind) 'map)
                     (not
                      (set-member?
                       seen-maps
                       (hash-ref (hash-ref e 'msg) 'full-name))))
                (set-add! seen-maps (hash-ref (hash-ref e 'msg) 'full-name))
                (set! helpers
                  (cons (php-pb-map-helpers file-model e) helpers)))))
           (for ((n (in-list (hash-ref msg 'nested)))) (collect n)))
         (for ((m (in-list messages))) (collect m))
         (define dep-modules
           (remove-duplicates
            (map
             (lambda (d)
               (path->string
                (path-replace-extension (file-name-from-path d) "")))
             (hash-ref file-model 'dependencies))))
         (define content
           (string-append
            "<?php\n// @generated by protoc-gen-grpc-dc-php. DO NOT EDIT.\n\n"
            (format "namespace ~aPb;\n\n" (camel base))
            (apply
             string-append
             (map
              (lambda (d)
                (format "require_once __DIR__ . \"/~a_pb.php\";\n" d))
              dep-modules))
            (if (null? dep-modules) "" "\n")
            php-pb-support
            (apply
             string-append
             (map (lambda (e) (php-pb-enum file-model e)) enums))
            (apply
             string-append
             (map
              (lambda (m) (php-pb-message-class file-model m))
              (filter (lambda (m) (not (hash-ref m 'map-entry))) messages)))
            (apply string-append (reverse helpers))))
         (cons (string-append base "_pb.php") content))))

(define (emit-php-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define ns (string-append (camel base) "GrpcDc"))
  (define stub
    (cons
     (string-append base "_grpc_dc.php")
     (string-append
      "<?php\n// @generated by protoc-gen-grpc-dc-php. DO NOT EDIT.\n"
      (format "// source: ~a\n\n" (hash-ref file-model 'name))
      (format "namespace ~a;\n\n" ns)
      (php-stub-requires file-model)
      "require_once __DIR__ . \"/../grpcdc.php\";\n\n"
      (if (equal? (hash-ref params 'trace #f) "hooks")
        (string-append
         "// Tracing (trace=hooks): register an observer via set_tracer().\n"
         "function set_tracer(mixed $t): void { \\Status::setTracer($t); }\n"
         "function set_trace_filter(string $p): void { \\Status::setTraceFilter($p); }\n\n"
         (let ((methods (hash-ref params 'trace_methods #f)))
           (if methods
             (format "\\Status::setTraceFilter(~s);\n\n" methods)
             "")))
        "")
      php-stream-helpers
      (apply
       string-append
       (map
        (lambda (svc) (php-service file-model svc))
        (hash-ref file-model 'services))))))
  (define pb-file (emit-php-pb-file file-model))
  (if pb-file (list stub pb-file) stub))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define trace-opt (hash-ref params 'trace #f))
  (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
    (error
     (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
  (define trace-methods (hash-ref params 'trace_methods #f))
  (when trace-methods
    (unless (equal? trace-opt "hooks")
      (error "trace_methods requires trace=hooks"))
    (for
     ((p (in-list (string-split trace-methods ";"))))
     (unless (string-prefix? p "/")
       (error (format "trace_methods pattern must start with /: ~a" p)))))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map stamp-generated-header (as-file-list (emit-php-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
