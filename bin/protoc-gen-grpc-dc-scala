(define (scala-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define kind-const
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                val req = new ~a()\n"
       "                reqs.recvInto(req)\n"
       "                val resp = impl.~a(ctx, req)\n"
       "                sink.send(resp.marshalDc())\n"
       "            }),\n")
      name
      path
      kind-const
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                val req = new ~a()\n"
       "                reqs.recvInto(req)\n"
       "                impl.~a(req, new ~a {\n"
       "                    def send(resp: ~a): Unit = sink.send(resp.marshalDc())\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "            }),\n")
      name
      path
      kind-const
      req
      impl-name
      (scala-ss-trait-name svc resp)
      resp))
    ((client-streaming)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                var response: ~a = null\n"
       "                impl.~a(new ~a {\n"
       "                    def recv(): ~a = {\n"
       "                        val req = new ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        req\n"
       "                    }\n"
       "                    def sendAndClose(resp: ~a): Unit = { response = resp }\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "                if (response == null) {\n"
       "                    throw grpcdc.StatusException(grpcdc.Wire.CODE_INTERNAL, \"client-streaming handler never called sendAndClose\")\n"
       "                }\n"
       "                sink.send(response.marshalDc())\n"
       "            }),\n")
      name
      path
      kind-const
      resp
      impl-name
      (scala-pair-trait-name
       svc
       'client-streaming
       req
       resp
       "ClientStreamServer")
      req
      req
      resp))
    ((bidi)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                impl.~a(new ~a {\n"
       "                    def send(resp: ~a): Unit = sink.send(resp.marshalDc())\n"
       "                    def recv(): ~a = {\n"
       "                        val req = new ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        req\n"
       "                    }\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "            }),\n")
      name
      path
      kind-const
      impl-name
      (scala-pair-trait-name svc 'bidi req resp "BidiServer")
      resp
      req
      req))))

