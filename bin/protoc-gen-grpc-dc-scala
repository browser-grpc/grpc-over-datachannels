(define go-pb-encode-singular-program
  '((case-on
     (category)
     (("varint"
       (if (proto2)
         (then
          (fmt "~aout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~aout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0))))
         (else
          (fmt
           "~aif ~a {\n"
           (arg 1)
           (if (type-is 8) (then (arg 0)) (else (fmt "~a != 0" (arg 0)))))
          (fmt "~a\tout = appendTag(out, ~a, 0)\n" (arg 1) (ref number))
          (fmt
           "~a\tout = appendVarint(out, ~a)\n"
           (arg 1)
           (call goPbVarintExpr (arg 0)))
          (fmt "~a}\n" (arg 1))))))
     ("fixed"
      (if (proto2)
        (then
         (fmt
          "~aout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~aout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0))))
        (else
         (fmt "~aif ~a != 0 {\n" (arg 1) (arg 0))
         (fmt
          "~a\tout = appendTag(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (fixed-wire))
         (fmt
          "~a\tout = append(out, ~a...)\n"
          (arg 1)
          (call goPbFixedEncode (arg 0)))
         (fmt "~a}\n" (arg 1)))))
     ("string"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, []byte(~a))\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aout = appendStringField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))))
     ("bytes"
      (if (proto2)
        (then
         (fmt
          "~aout = appendBytesField(out, ~a, ~a)\n"
          (arg 1)
          (ref number)
          (arg 0)))
        (else
         (fmt
          "~aif len(~a) > 0 {\n~a\tout = appendBytesField(out, ~a, ~a)\n~a}\n"
          (arg 1)
          (arg 0)
          (arg 1)
          (ref number)
          (arg 0)
          (arg 1)))))
     ("message"
      (fmt
       "~aif ~a != nil {\n~a\tout = appendBytesField(out, ~a, ~a.MarshalDC())\n~a}\n"
       (arg 1)
       (arg 0)
       (arg 1)
       (ref number)
       (arg 0)
       (arg 1)))
     (else (fail)))))

(define go-pb-encode-field-program
  '((if (is-map)
      (then
       (fmt
        "\t{\n\t\tkeys := make([]~a, 0, len(~a))\n\t\tfor k := range ~a { keys = append(keys, k) }\n\t\tsort.Slice(keys, func(i, j int) bool { return keys[i] < keys[j] })\n\t\tfor _, k := range keys {\n\t\t\tout = appendBytesField(out, ~a, ~a(k, ~a[k]))\n\t\t}\n\t}\n"
        (field-type-of (with-label (key-field (resolved-entry)) 1))
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (ref number)
        (fmt "encode~a" (entry-type))
        (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = appendVarint(payload, ~a)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbVarintExpr "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("fixed"
             (fmt
              "\tif len(~a) > 0 {\n\t\tvar payload []byte\n"
              (fmt "m.~a" (pascal (ref name))))
             (fmt
              "\t\tfor _, x := range ~a {\n\t\t\tpayload = append(payload, ~a...)\n\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedEncode "x"))
             (fmt
              "\t\tout = appendBytesField(out, ~a, payload)\n\t}\n"
              (ref number)))
            ("string"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, []byte(x))\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("bytes"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x)\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            ("message"
             (fmt
              "\tfor _, x := range ~a {\n\t\tout = appendBytesField(out, ~a, x.MarshalDC())\n\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (ref number)))
            (else (fail)))))
         (else
          (call goPbEncodeSingular (fmt "m.~a" (pascal (ref name))) "\t")))))))

(define go-pb-decode-singular-program
  '((case-on
     (category)
     (("varint"
       (fmt
        "~a~a = ~a\n"
        (arg 2)
        (arg 0)
        (if (type-is 14)
          (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode (arg 1))))
          (else (call goPbVarintDecode (arg 1))))))
      ("fixed"
       (fmt "~a~a = ~a\n" (arg 2) (arg 0) (call goPbFixedDecode (arg 1))))
      ("string" (fmt "~a~a = string(~a)\n" (arg 2) (arg 0) (arg 1)))
      ("bytes"
       (fmt "~a~a = append([]byte(nil), ~a...)\n" (arg 2) (arg 0) (arg 1)))
      ("message"
       (fmt "~atmp~a := new(~a)\n" (arg 2) (ref number) (entry-type))
       (fmt
        "~aif err := tmp~a.UnmarshalDC(~a); err != nil {\n~a\t~a\n~a}\n"
        (arg 2)
        (ref number)
        (arg 1)
        (arg 2)
        (err-stmt)
        (arg 2))
       (fmt "~a~a = tmp~a\n" (arg 2) (arg 0) (ref number)))
      (else (fail))))))

(define go-pb-decode-case-program
  '((fmt "\t\tcase ~a:\n" (ref number))
    (if (is-map)
      (then
       "\t\t\tif b, ok := value.([]byte); ok {\n"
       (fmt "\t\t\t\tk, val, err := ~a(b)\n" (fmt "decode~a" (entry-type)))
       "\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n"
       (fmt
        "\t\t\t\tif ~a == nil {\n\t\t\t\t\t~a = make(~a)\n\t\t\t\t}\n"
        (fmt "m.~a" (pascal (ref name)))
        (fmt "m.~a" (pascal (ref name)))
        (field-type))
       (fmt "\t\t\t\t~a[k] = val\n\t\t\t}\n" (fmt "m.~a" (pascal (ref name)))))
      (else
       (if (repeated)
         (then
          (case-on
           (category)
           (("varint"
             "\t\t\tswitch value := value.(type) {\n"
             "\t\t\tcase uint64:\n"
             (fmt
              "\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then
                 (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "value")))
                (else (call goPbVarintDecode "value"))))
             "\t\t\tcase []byte:\n"
             "\t\t\t\tsub := &pbReader{buf: value}\n"
             "\t\t\t\tfor sub.pos < len(sub.buf) {\n"
             "\t\t\t\t\tv, err := sub.varint()\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n"
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (if (type-is 14)
                (then (fmt "~a(~a)" (entry-type) (call goPbVarintDecode "v")))
                (else (call goPbVarintDecode "v"))))
             "\t\t\t\t}\n\t\t\t}\n")
            ("fixed"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt "\t\t\t\tif len(b) == ~a {\n" (fixed-size))
             (fmt
              "\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode "b"))
             "\t\t\t\t} else {\n"
             (fmt
              "\t\t\t\t\tfor off := 0; off+~a <= len(b); off += ~a {\n"
              (fixed-size)
              (fixed-size))
             (fmt
              "\t\t\t\t\t\t~a = append(~a, ~a)\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))
              (call goPbFixedDecode (fmt "b[off:off+~a]" (fixed-size))))
             "\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n")
            ("string"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, string(b))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("bytes"
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n\t\t\t\t~a = append(~a, append([]byte(nil), b...))\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            ("message"
             "\t\t\tif b, ok := value.([]byte); ok {\n"
             (fmt
              "\t\t\t\tvar tmpv ~a\n"
              (field-type-of (with-label (self) 1)))
             (call goPbDecodeSingular "tmpv" "b" "\t\t\t\t")
             (fmt
              "\t\t\t\t~a = append(~a, tmpv)\n\t\t\t}\n"
              (fmt "m.~a" (pascal (ref name)))
              (fmt "m.~a" (pascal (ref name)))))
            (else (fail)))))
         (else
          (oneof-clearing)
          (if (is-varint)
            (then
             (fmt
              "\t\t\tif v, ok := value.(uint64); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "v"
               "\t\t\t\t")))
            (else
             (fmt
              "\t\t\tif b, ok := value.([]byte); ok {\n~a\t\t\t}\n"
              (call
               goPbDecodeSingular
               (fmt "m.~a" (pascal (ref name)))
               "b"
               "\t\t\t\t"))))))))))

(define go-pb-encode-field-guarded-program
  '((guarded goPbSetExpr "\tif !(~a) {\n" "\t}\n" (call goPbEncodeField))))

(define go-pb-set-expr-program
  '((case-on
     (type)
     ((11 10) (fmt "m.~a != nil" (pascal (ref name))))
     (9 (fmt "m.~a != \"\"" (pascal (ref name))))
     (12 (fmt "len(m.~a) > 0" (pascal (ref name))))
     (8 (fmt "m.~a" (pascal (ref name))))
     (else (fmt "m.~a != ~a" (pascal (ref name)) (call goPbZero))))))

(define go-pb-map-helpers-program
  '((fmt
     "func encode~a(key ~a, value ~a) []byte {\n\tvar out []byte\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (call-on (key-field) goPbEncodeSingular "key" "\t")
    (call-on (val-field) goPbEncodeSingular "value" "\t")
    "\treturn out\n}\n\n"
    (fmt
     "func decode~a(data []byte) (~a, ~a, error) {\n"
     (entry-type)
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    (fmt
     "\tvar key ~a\n\tvar value ~a\n"
     (field-type-of (with-label (key-field) 1))
     (field-type-of (with-label (val-field) 1)))
    "\tr := &pbReader{buf: data}\n\tfor {\n\t\tnum, _, value0, _, done, err := r.field()\n\t\tif err != nil {\n\t\t\treturn key, value, err\n\t\t}\n\t\tif done {\n\t\t\treturn key, value, nil\n\t\t}\n\t\tswitch num {\n"
    (fmt "\t\tcase ~a:\n" (get (key-field) number))
    (case-on
     (category-of (key-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (key-field) goPbDecodeSingular "key" "b" "\t\t\t\t")))))
    (fmt "\t\tcase ~a:\n" (get (val-field) number))
    (case-on
     (category-of (val-field))
     (("varint"
       (fmt
        "\t\t\tif v, ok := value0.(uint64); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "v" "\t\t\t\t")))
      (else
       (fmt
        "\t\t\tif b, ok := value0.([]byte); ok {\n~a\t\t\t}\n"
        (call-on (val-field) goPbDecodeSingular "value" "b" "\t\t\t\t")))))
    "\t\t}\n\t}\n}\n\n"))

(define go-pb-enum-program
  '((fmt "type ~a int32\n\nconst (\n" (arg 0))
    (each
     enum
     values
     (fmt "\t~a_~a ~a = ~a\n" (arg 0) (ref name) (arg 0) (ref number)))
    ")\n\n"))

(define go-pb-default-literal-program
  '((if (has-default)
      (then
       (case-on
        (type)
        ((9 (fmt "~s" (default-raw)))
         (14 (fmt "~a(~a)" (entry-type) (enum-default-num)))
         (else (default-raw)))))
      (else))))

(define go-pb-constructor-program
  '((if (any-default)
      (then
       (fmt
        "// New~a returns a ~a with the descriptor's explicit (proto2)\n// default values applied.\n"
        (flat)
        (flat))
       (fmt "func New~a() *~a {\n\treturn &~a{\n" (flat) (flat) (flat))
       (each
        fields
        (when (has-default)
          (fmt "\t~a: ~a,\n" (pascal (ref name)) (call goPbDefaultLiteral))))
       "\t}\n}\n\n")
      (else))))

(define go-pb-message-program
  '((fmt "type ~a struct {\n" (flat))
    (each fields (fmt "\t~a ~a\n" (pascal (ref name)) (field-type)))
    "\tUnknownFields []byte\n}\n\n"
    (call goPbConstructor)
    (fmt "func (m *~a) MarshalDC() []byte {\n\tvar out []byte\n" (flat))
    (each fields (call goPbEncodeFieldGuarded))
    "\tout = append(out, m.UnknownFields...)\n\treturn out\n}\n\n"
    (fmt "func (m *~a) UnmarshalDC(data []byte) error {\n" (flat))
    "\tm.UnknownFields = nil\n\tr := &pbReader{buf: data}\n\tfor {\n"
    (if (no-fields)
      (then "\t\tnum, _, _, raw, done, err := r.field()\n")
      (else "\t\tnum, _, value, raw, done, err := r.field()\n"))
    "\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif done {\n\t\t\treturn nil\n\t\t}\n\t\tswitch num {\n"
    (each fields (call goPbDecodeCase))
    "\t\tdefault:\n\t\t\tm.UnknownFields = append(m.UnknownFields, raw...)\n\t\t}\n\t}\n}\n\n"))

(define segment-programs
  (hasheq
   'goRegisterMethod
   go-register-method-program
   'goDeprecated
   go-deprecated-program
   'goClientMethod
   go-client-method-program
   'goServerIfaceMethod
   go-server-iface-method-program
   'goServerIfaceMethodDeprecated
   go-server-iface-method-deprecated-program
   'goStreamIfaces
   go-stream-ifaces-program
   'goStreamImpls
   go-stream-impls-program
   'goService
   go-service-program
   'goPbVarintExpr
   go-pb-varint-expr-program
   'goPbVarintDecode
   go-pb-varint-decode-program
   'goPbFixedEncode
   go-pb-fixed-encode-program
   'goPbFixedDecode
   go-pb-fixed-decode-program
   'goPbZero
   go-pb-zero-program
   'goPbEncodeSingular
   go-pb-encode-singular-program
   'goPbEncodeField
   go-pb-encode-field-program
   'goPbDecodeSingular
   go-pb-decode-singular-program
   'goPbDecodeCase
   go-pb-decode-case-program
   'goPbEncodeFieldGuarded
   go-pb-encode-field-guarded-program
   'goPbMapHelpers
   go-pb-map-helpers-program
   'goPbEnum
   go-pb-enum-program
   'goPbDefaultLiteral
   go-pb-default-literal-program
   'goPbConstructor
   go-pb-constructor-program
   'goPbSetExpr
   go-pb-set-expr-program
   'goPbMessage
   go-pb-message-program))

(define (seg-ref node key)
  (if (eq? key 'impl-name)
    (hash-ref node 'impl-name (hash-ref node 'name))
    (hash-ref node key #f)))

(define (run-segments
         program
         node
         svc
         (model #f)
         (args '())
         (err "return err"))
  (run-env program (list model node svc args err)))

(define (run-env program env)
  (apply
   string-append
   (for/list ((seg (in-list program))) (run-segment seg env))))

(define (env-model env) (first env))

(define (env-node env) (second env))

(define (env-svc env) (third env))

(define (env-args env) (fourth env))

(define (env-err env) (fifth env))

(define (env-with
         env
         #:model
         (model (env-model env))
         #:node
         (node (env-node env))
         #:args
         (args (env-args env))
         #:err
         (err (env-err env)))
  (list model node (env-svc env) args err))

(define (seg-truthy? v) (not (or (not v) (equal? v "") (equal? v 0))))

(define (seg-pascal s)
  (string-join
   (map
    (lambda (part)
      (if (string=? part "")
        ""
        (string-append
         (string (char-upcase (string-ref part 0)))
         (substring part 1))))
    (string-split s "_"))
   ""))

(define (seg-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (seg-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'run-segments "unresolved type ~a" type-name))))

(define (seg-entry-type entry)
  (seg-flat
   (hash-ref entry 'pkg)
   (if (eq? (hash-ref entry 'kind) 'enum)
     (hash-ref entry 'full)
     (hash-ref (hash-ref entry 'msg) 'full-name))))

(define (seg-entry-type-of model node)
  (if (hash-has-key? node 'type-name)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name)))
    (seg-entry-type node)))

(define (seg-field-type model f)
  (define type (hash-ref f 'type))
  (define base
    (cond
     ((= type 11)
      (define entry (seg-resolve model (hash-ref f 'type-name)))
      (if (eq? (hash-ref entry 'kind) 'map)
        (let* ((entry-msg (hash-ref entry 'msg))
               (kf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 1))
                 (hash-ref entry-msg 'fields)))
               (vf
                (findf
                 (lambda (x) (= (hash-ref x 'number) 2))
                 (hash-ref entry-msg 'fields))))
          (format
           "map[~a]~a"
           (seg-field-type model (hash-set kf 'label 1))
           (seg-field-type model (hash-set vf 'label 1))))
        (string-append "*" (seg-entry-type entry))))
     ((= type 14) (seg-entry-type (seg-resolve model (hash-ref f 'type-name))))
     (else (scalar-type-entry 'go type))))
  (if (= (hash-ref f 'label) 3)
    (if (and (= type 11)
             (eq?
              (hash-ref (seg-resolve model (hash-ref f 'type-name)) 'kind)
              'map))
      base
      (string-append "[]" base))
    base))

(define (seg-category model node)
  (define type (hash-ref node 'type))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map))
    "map")
   ((= type 11) "message")
   ((memv type varint-scalar-types) "varint")
   ((assv type (fixed-scalar-table 'go)) "fixed")
   ((= type 9) "string")
   ((= type 12) "bytes")
   (else "other")))

(define (seg-fixed-info node)
  (assv (hash-ref node 'type) (fixed-scalar-table 'go)))

(define (seg-zero node)
  (case (hash-ref node 'type)
    ((11 12) "nil")
    ((9) "\"\"")
    ((8) "false")
    (else "0")))

(define (seg-set-expr sib)
  (define v (format "m.~a" (seg-pascal (hash-ref sib 'name))))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a != nil" v))
    ((9) (format "~a != \"\"" v))
    ((12) (format "len(~a) > 0" v))
    ((8) v)
    (else (format "~a != 0" v))))

(define (seg-oneof-clearing model node)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "\t\t\tm.~a = ~a\n"
       (seg-pascal (hash-ref sib 'name))
       (seg-zero sib)))
    (oneof-siblings model node))))

(define (seg-lower-first s)
  (if (string=? s "")
    s
    (string-append (string (char-downcase (string-ref s 0))) (substring s 1))))

(define (seg-js-name f)
  (define jn (hash-ref f 'json-name ""))
  (if (and jn (not (string=? jn "")))
    jn
    (regexp-replace*
     #rx"_([a-zA-Z0-9])"
     (hash-ref f 'name)
     (lambda (all c) (string-upcase c)))))

(define (seg-later-oneof-cond model node)
  (define later (oneof-later-siblings model node))
  (if (null? later) "" (string-join (map seg-set-expr later) " || ")))

(define (seg-eval seg env)
  (define node (env-node env))
  (define model (env-model env))
  (cond
   ((string? seg) seg)
   ((number? seg) seg)
   ((eq? (car seg) 'fmt)
    (apply
     format
     (second seg)
     (map
      (lambda (e)
        (define v (seg-eval e env))
        (if (symbol? v) (symbol->string v) v))
      (cddr seg))))
   ((eq? (car seg) 'ref)
    (if (null? (cddr seg))
      (seg-ref node (second seg))
      (foldl (lambda (k acc) (hash-ref acc k)) node (cdr seg))))
   ((eq? (car seg) 'svc) (env-svc env))
   ((eq? (car seg) 'arg) (list-ref (env-args env) (second seg)))
   ((eq? (car seg) 'err-stmt) (env-err env))
   ((eq? (car seg) 'self) node)
   ((memq (car seg) '(if case-on when guarded kind-case))
    (run-segment seg env))
   ((eq? (car seg) 'pascal) (seg-pascal (seg-eval (second seg) env)))
   ((eq? (car seg) 'lower-first) (seg-lower-first (seg-eval (second seg) env)))
   ((eq? (car seg) 'js-name) (seg-js-name node))
   ((eq? (car seg) 'js-fixed-size)
    (second (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'js-fixed-name)
    (third (assv (hash-ref node 'type) (fixed-scalar-table 'js))))
   ((eq? (car seg) 'bigint-type)
    (and (memv (hash-ref node 'type) '(3 4 18 6 16)) #t))
   ((eq? (car seg) 'entry-flat) (seg-entry-type node))
   ((eq? (car seg) 'resolved-flat)
    (seg-entry-type (seg-resolve model (hash-ref node 'type-name))))
   ((eq? (car seg) 'flat)
    (seg-flat (hash-ref model 'package) (hash-ref node 'full-name)))
   ((eq? (car seg) 'entry-type) (seg-entry-type-of model node))
   ((eq? (car seg) 'field-type) (seg-field-type model node))
   ((eq? (car seg) 'field-type-of)
    (seg-field-type model (seg-eval (second seg) env)))
   ((eq? (car seg) 'resolved-entry)
    (seg-resolve model (hash-ref node 'type-name)))
   ((eq? (car seg) 'key-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 1))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'val-field)
    (define entry (if (null? (cdr seg)) node (seg-eval (second seg) env)))
    (findf
     (lambda (x) (= (hash-ref x 'number) 2))
     (hash-ref (hash-ref entry 'msg) 'fields)))
   ((eq? (car seg) 'with-label)
    (hash-set (seg-eval (second seg) env) 'label (third seg)))
   ((eq? (car seg) 'get) (hash-ref (seg-eval (second seg) env) (third seg)))
   ((eq? (car seg) 'fixed-name) (third (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-size) (second (seg-fixed-info node)))
   ((eq? (car seg) 'fixed-wire) (if (= (second (seg-fixed-info node)) 8) 1 5))
   ((eq? (car seg) 'type) (hash-ref node 'type))
   ((eq? (car seg) 'category) (seg-category model node))
   ((eq? (car seg) 'category-of)
    (seg-category model (seg-eval (second seg) env)))
   ((eq? (car seg) 'proto2) (equal? (hash-ref model 'syntax "") "proto2"))
   ((eq? (car seg) 'type-is) (= (hash-ref node 'type) (second seg)))
   ((eq? (car seg) 'is-varint)
    (and (memv (hash-ref node 'type) varint-scalar-types) #t))
   ((eq? (car seg) 'is-fixed) (and (seg-fixed-info node) #t))
   ((eq? (car seg) 'is-map)
    (and (= (hash-ref node 'type) 11)
         (eq?
          (hash-ref (seg-resolve model (hash-ref node 'type-name)) 'kind)
          'map)))
   ((eq? (car seg) 'repeated) (= (hash-ref node 'label) 3))
   ((eq? (car seg) 'has-default) (and (field-explicit-default node) #t))
   ((eq? (car seg) 'any-default)
    (for/or
     ((f (in-list (hash-ref node 'fields))))
     (field-explicit-default f)))
   ((eq? (car seg) 'no-fields) (null? (hash-ref node 'fields)))
   ((eq? (car seg) 'default-raw) (field-explicit-default node))
   ((eq? (car seg) 'enum-default-num) (enum-default-number model node))
   ((eq? (car seg) 'oneof-clearing) (seg-oneof-clearing model node))
   ((eq? (car seg) 'later-oneof-cond) (seg-later-oneof-cond model node))
   ((eq? (car seg) 'call)
    (run-env
     (hash-ref segment-programs (second seg))
     (env-with env #:args (map (lambda (e) (seg-eval e env)) (cddr seg)))))
   ((eq? (car seg) 'call-on)
    (run-env
     (hash-ref segment-programs (third seg))
     (env-with
      env
      #:node
      (seg-eval (second seg) env)
      #:args
      (map (lambda (e) (seg-eval e env)) (cdddr seg)))))
   (else (error 'run-segments "bad expression: ~e" seg))))

(define (run-segment seg env)
  (define node (env-node env))
  (cond
   ((string? seg) seg)
   ((eq? (car seg) 'if)
    (define then-segs (cdr (assq 'then (cddr seg))))
    (define else-part (assq 'else (cddr seg)))
    (if (seg-truthy? (seg-eval (second seg) env))
      (run-env then-segs env)
      (if else-part (run-env (cdr else-part) env) "")))
   ((eq? (car seg) 'kind-case)
    (define kind (hash-ref node 'kind))
    (define branch (assq kind (cdr seg)))
    (unless branch (error 'run-segments "no kind branch for ~e" kind))
    (run-env (cdr branch) env))
   ((eq? (car seg) 'case-on)
    (define val (seg-eval (second seg) env))
    (define raw (cddr seg))
    (define (branch-key? b)
      (and (list? b)
           (pair? b)
           (or (number? (car b))
               (string? (car b))
               (eq? (car b) 'else)
               (and (list? (car b)) (andmap number? (car b))))))
    (define branches
      (cond
       ((and (= (length raw) 1)
             (list? (car raw))
             (andmap branch-key? (car raw)))
        (car raw))
       (else
        (map
         (lambda (b)
           (if (and (list? b) (= (length b) 1) (list? (car b))) (car b) b))
         raw))))
    (define branch
      (for/first
       ((b (in-list branches))
        #:when
        (or (eq? (car b) 'else)
            (member val (if (list? (car b)) (car b) (list (car b))) equal?)))
       b))
    (if branch (run-env (cdr branch) env) ""))
   ((eq? (car seg) 'when)
    (if (seg-truthy? (seg-eval (second seg) env)) (run-env (cddr seg) env) ""))
   ((eq? (car seg) 'guarded)
    (define text (run-env (cddddr seg) env))
    (define cond-str
      (string-join
       (map
        (lambda (sib)
          (run-env
           (hash-ref segment-programs (second seg))
           (env-with env #:node sib)))
        (oneof-later-siblings (env-model env) node))
       " || "))
    (if (equal? cond-str "")
      text
      (string-append
       (format (third seg) cond-str)
       (if (string-suffix? text "\n") text (string-append text "\n"))
       (fourth seg))))
   ((eq? (car seg) 'fail)
    (error 'run-segments "unsupported field type ~a" (hash-ref node 'type)))
   ((eq? (car seg) 'each)
    (define-values (keys segs) (splitf-at (cdr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (apply
     string-append
     (for/list
      ((el (in-list items)))
      (run-env segs (env-with env #:node el)))))
   ((eq? (car seg) 'each+)
    (define aliases
      (if (eq? (third seg) 'client)
        (alias-client-methods node)
        (alias-server-methods node)))
    (apply
     string-append
     (for/list
      ((el (in-list (append (hash-ref node (second seg)) aliases))))
      (run-env (cdddr seg) (env-with env #:node el)))))
   ((eq? (car seg) 'each-siblings)
    (apply
     string-append
     (for/list
      ((sib (in-list (oneof-siblings (env-model env) node))))
      (run-env (cdr seg) (env-with env #:node sib)))))
   ((eq? (car seg) 'each-sep)
    (define-values (keys segs) (splitf-at (cddr seg) symbol?))
    (define items (foldl (lambda (k acc) (hash-ref acc k)) node keys))
    (string-join
     (for/list ((el (in-list items))) (run-env segs (env-with env #:node el)))
     (second seg)))
   (else (seg-eval seg env))))

(define current-service (make-parameter ""))

(define (pascal sym)
  (apply
   string-append
   (for/list
    ((part (in-list (string-split (symbol->string sym) "_"))))
    (if (string=? part "")
      ""
      (string-append
       (string (char-upcase (string-ref part 0)))
       (substring part 1))))))

(define (scala-client-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "        def ~a(req: ~a, metadata: Map[String, String] = null, timeout: java.time.Duration = null): ~a = {\n"
       "            val resp = new ~a()\n"
       "            channel.unary(~s, req, resp, metadata, timeout)\n"
       "            resp\n"
       "        }\n\n")
      name
      req
      resp
      resp
      path))
    ((server-streaming)
     (format
      (string-append
       "        def ~a(req: ~a, metadata: Map[String, String] = null, timeout: java.time.Duration = null): ~a = {\n"
       "            new ~a(channel.serverStream(~s, req, metadata, timeout))\n"
       "        }\n\n")
      name
      req
      (scala-client-stream-name svc 'server-streaming resp)
      (scala-client-stream-name svc 'server-streaming resp)
      path))
    ((client-streaming)
     (format
      (string-append
       "        def ~a(reqs: List[~a], metadata: Map[String, String] = null, timeout: java.time.Duration = null): ~a = {\n"
       "            val resp = new ~a()\n"
       "            channel.clientStreamCall(~s, reqs, resp, metadata, timeout)\n"
       "            resp\n"
       "        }\n\n")
      name
      req
      resp
      resp
      path))
    ((bidi)
     (format
      (string-append
       "        def ~a(reqs: List[~a], metadata: Map[String, String] = null, timeout: java.time.Duration = null): ~a = {\n"
       "            new ~a(channel.bidi(~s, reqs, metadata, timeout))\n"
       "        }\n\n")
      name
      req
      (scala-client-stream-name svc 'bidi resp)
      (scala-client-stream-name svc 'bidi resp)
      path))))

(define (scala-future-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (case (hash-ref m 'kind)
    ((unary client-streaming)
     (format
      (string-append
       "        def ~aFuture(req~a, metadata: Map[String, String] = null, timeout: java.time.Duration = null): scala.concurrent.Future[~a] = {\n"
       "            grpcdc.Futures { ~a(req~a, metadata, timeout) }\n"
       "        }\n\n")
      name
      (if (eq? (hash-ref m 'kind) 'unary)
        (format ": ~a" req)
        (format "s: List[~a]" req))
      resp
      name
      (if (eq? (hash-ref m 'kind) 'unary) "" "s")))
    ((server-streaming bidi)
     (format
      (string-append
       "        def ~aFuture(req~a, metadata: Map[String, String] = null, timeout: java.time.Duration = null): scala.concurrent.Future[List[~a]] = {\n"
       "            grpcdc.Futures {\n"
       "                val stream = ~a(req~a, metadata, timeout)\n"
       "                try {\n"
       "                val out = scala.collection.mutable.ListBuffer[~a]()\n"
       "                var done = false\n"
       "                while (!done) {\n"
       "                    try {\n"
       "                        out += stream.recv()\n"
       "                    } catch {\n"
       "                        case e: java.io.EOFException => done = true\n"
       "                    }\n"
       "                }\n"
       "                out.toList\n"
       "                } finally {\n"
       "                    stream.close()\n"
       "                }\n"
       "            }\n"
       "        }\n\n")
      name
      (if (eq? (hash-ref m 'kind) 'server-streaming)
        (format ": ~a" req)
        (format "s: List[~a]" req))
      resp
      name
      (if (eq? (hash-ref m 'kind) 'server-streaming) "" "s")
      resp))))

(define (scala-server-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "        def ~a(ctx: grpcdc.Endpoint#CallContext, req: ~a): ~a\n"
      name
      req
      resp))
    ((server-streaming)
     (format
      "        def ~a(req: ~a, stream: ~a): Unit\n"
      name
      req
      (scala-ss-trait-name svc resp)))
    ((client-streaming)
     (format
      "        def ~a(stream: ~a): Unit\n"
      name
      (scala-pair-trait-name
       svc
       'client-streaming
       req
       resp
       "ClientStreamServer")))
    ((bidi)
     (format
      "        def ~a(stream: ~a): Unit\n"
      name
      (scala-pair-trait-name svc 'bidi req resp "BidiServer")))))

(define (scala-register-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define path (hash-ref m 'path))
  (define kind-const
    (case (hash-ref m 'kind)
      ((unary) "KIND_UNARY")
      ((server-streaming) "KIND_SERVER_STREAMING")
      ((client-streaming) "KIND_CLIENT_STREAMING")
      ((bidi) "KIND_BIDI")))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                val req = new ~a()\n"
       "                reqs.recvInto(req)\n"
       "                val resp = impl.~a(ctx, req)\n"
       "                sink.send(resp.marshalDc())\n"
       "            }),\n")
      name
      path
      kind-const
      req
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                val req = new ~a()\n"
       "                reqs.recvInto(req)\n"
       "                impl.~a(req, new ~a {\n"
       "                    def send(resp: ~a): Unit = sink.send(resp.marshalDc())\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "            }),\n")
      name
      path
      kind-const
      req
      impl-name
      (scala-ss-trait-name svc resp)
      resp))
    ((client-streaming)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                var response: ~a = null\n"
       "                impl.~a(new ~a {\n"
       "                    def recv(): ~a = {\n"
       "                        val req = new ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        req\n"
       "                    }\n"
       "                    def sendAndClose(resp: ~a): Unit = { response = resp }\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "                if (response == null) {\n"
       "                    throw grpcdc.StatusException(grpcdc.Wire.CODE_INTERNAL, \"client-streaming handler never called sendAndClose\")\n"
       "                }\n"
       "                sink.send(response.marshalDc())\n"
       "            }),\n")
      name
      path
      kind-const
      resp
      impl-name
      (scala-pair-trait-name
       svc
       'client-streaming
       req
       resp
       "ClientStreamServer")
      req
      req
      resp))
    ((bidi)
     (format
      (string-append
       "            grpcdc.Server.Method(~s, ~s, grpcdc.Server.~a, (ctx, reqs, sink) => {\n"
       "                impl.~a(new ~a {\n"
       "                    def send(resp: ~a): Unit = sink.send(resp.marshalDc())\n"
       "                    def recv(): ~a = {\n"
       "                        val req = new ~a()\n"
       "                        reqs.recvInto(req)\n"
       "                        req\n"
       "                    }\n"
       "                    val context: grpcdc.Endpoint#CallContext = ctx\n"
       "                })\n"
       "            }),\n")
      name
      path
      kind-const
      impl-name
      (scala-pair-trait-name svc 'bidi req resp "BidiServer")
      resp
      req
      req))))

(define (scala-server-async-iface-method m)
  (define name (hash-ref m 'name))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      "        def ~aAsync(ctx: grpcdc.Endpoint#CallContext, req: ~a): scala.concurrent.Future[~a]\n"
      name
      req
      resp))
    ((server-streaming)
     (format
      "        def ~aAsync(req: ~a, stream: ~a): scala.concurrent.Future[Unit]\n"
      name
      req
      (scala-ss-trait-name svc resp)))
    ((client-streaming)
     (format
      "        def ~aAsync(stream: ~a): scala.concurrent.Future[Unit]\n"
      name
      (scala-pair-trait-name
       svc
       'client-streaming
       req
       resp
       "ClientStreamServer")))
    ((bidi)
     (format
      "        def ~aAsync(stream: ~a): scala.concurrent.Future[Unit]\n"
      name
      (scala-pair-trait-name svc 'bidi req resp "BidiServer")))))

(define (scala-server-async-adapter-method m)
  (define name (hash-ref m 'name))
  (define impl-name (method-impl-name m))
  (define req (hash-ref m 'input))
  (define resp (hash-ref m 'output))
  (define svc (current-service))
  (case (hash-ref m 'kind)
    ((unary)
     (format
      (string-append
       "            def ~a(ctx: grpcdc.Endpoint#CallContext, req: ~a): ~a = {\n"
       "                scala.concurrent.Await.result(impl.~aAsync(ctx, req), scala.concurrent.duration.Duration.Inf)\n"
       "            }\n")
      name
      req
      resp
      impl-name))
    ((server-streaming)
     (format
      (string-append
       "            def ~a(req: ~a, stream: ~a): Unit = {\n"
       "                scala.concurrent.Await.result(impl.~aAsync(req, stream), scala.concurrent.duration.Duration.Inf)\n"
       "            }\n")
      name
      req
      (scala-ss-trait-name svc resp)
      impl-name))
    ((client-streaming)
     (format
      (string-append
       "            def ~a(stream: ~a): Unit = {\n"
       "                scala.concurrent.Await.result(impl.~aAsync(stream), scala.concurrent.duration.Duration.Inf)\n"
       "            }\n")
      name
      (scala-pair-trait-name
       svc
       'client-streaming
       req
       resp
       "ClientStreamServer")
      impl-name))
    ((bidi)
     (format
      (string-append
       "            def ~a(stream: ~a): Unit = {\n"
       "                scala.concurrent.Await.result(impl.~aAsync(stream), scala.concurrent.duration.Duration.Inf)\n"
       "            }\n")
      name
      (scala-pair-trait-name svc 'bidi req resp "BidiServer")
      impl-name))))

(define current-methods (make-parameter '()))

(define (kind-outputs kind)
  (remove-duplicates
   (map
    (lambda (m) (hash-ref m 'output))
    (filter (lambda (m) (eq? (hash-ref m 'kind) kind)) (current-methods)))))

(define (kind-pairs kind)
  (remove-duplicates
   (map
    (lambda (m) (cons (hash-ref m 'input) (hash-ref m 'output)))
    (filter (lambda (m) (eq? (hash-ref m 'kind) kind)) (current-methods)))))

(define (scala-ss-trait-name svc out)
  (if (<= (length (kind-outputs 'server-streaming)) 1)
    (format "~aServerStreamServer" svc)
    (format "~a~aServerStreamServer" svc out)))

(define (scala-pair-trait-name svc kind in out suffix)
  (if (<= (length (kind-pairs kind)) 1)
    (format "~a~a" svc suffix)
    (format "~a~a~a~a" svc in out suffix)))

(define (scala-client-stream-name svc kind out)
  (define suffix
    (if (eq? kind 'server-streaming) "ServerStreamStream" "BidiStream"))
  (if (<= (length (kind-outputs kind)) 1)
    (format "~a~a" svc suffix)
    (format "~a~a~a" svc out suffix)))

(define (scala-service svc)
  (define sname (hash-ref svc 'name))
  (define methods (hash-ref svc 'methods))
  (define req (hash-ref (car methods) 'input))
  (define resp (hash-ref (car methods) 'output))
  (define (class-outputs kind)
    (define os (kind-outputs kind))
    (if (null? os) (list resp) os))
  (define (pair-list kind)
    (define ps (kind-pairs kind))
    (if (null? ps) (list (cons req resp)) ps))
  (parameterize
   ((current-service sname) (current-methods methods))
   (string-append
    (format "    /** Client for ~a. */\n" (hash-ref svc 'full-name))
    (format
     "    class ~aClient(private val channel: grpcdc.Channel) {\n"
     sname)
    (apply
     string-append
     (for/list
      ((out (in-list (class-outputs 'server-streaming))))
      (string-append
       (format
        "        class ~a(private val stream: grpcdc.Channel#ClientStream) extends scala.collection.Iterator[~a] with AutoCloseable {\n"
        (scala-client-stream-name sname 'server-streaming out)
        out)
       (format "            def recv(): ~a = {\n" out)
       (format "                val resp = new ~a()\n" out)
       "                stream.recv(resp)\n"
       "                resp\n"
       "            }\n"
       (format "            private var pending: ~a = null\n" out)
       "            private var finished: Boolean = false\n"
       "            def hasNext: Boolean = {\n"
       "                if (pending == null && !finished) {\n"
       "                    try {\n"
       "                        pending = recv()\n"
       "                    } catch {\n"
       "                        case e: java.io.EOFException => finished = true\n"
       "                    }\n"
       "                }\n"
       "                pending != null\n"
       "            }\n"
       (format "            def next(): ~a = {\n" out)
       "                if (!hasNext) throw new NoSuchElementException(\"next on empty stream\")\n"
       "                val out = pending\n"
       "                pending = null\n"
       "                out\n"
       "            }\n"
       "            def cancel(): Unit = stream.cancel()\n"
       "            def close(): Unit = stream.close()\n"
       "            /** Initial metadata (response headers); null until they arrive. */\n"
       "            def headers: Map[String, String] = if (stream.headers == null) null else stream.headers.metadata\n"
       "            /** Trailing metadata of the terminal status; null until it arrives. */\n"
       "            def trailers: Map[String, String] = stream.trailers\n"
       "        }\n\n")))
    (apply
     string-append
     (for/list
      ((out (in-list (class-outputs 'bidi))))
      (string-append
       (format
        "        class ~a(private val stream: grpcdc.Channel#ClientStream) extends scala.collection.Iterator[~a] with AutoCloseable {\n"
        (scala-client-stream-name sname 'bidi out)
        out)
       (format "            def recv(): ~a = {\n" out)
       (format "                val resp = new ~a()\n" out)
       "                stream.recv(resp)\n"
       "                resp\n"
       "            }\n"
       (format "            private var pending: ~a = null\n" out)
       "            private var finished: Boolean = false\n"
       "            def hasNext: Boolean = {\n"
       "                if (pending == null && !finished) {\n"
       "                    try {\n"
       "                        pending = recv()\n"
       "                    } catch {\n"
       "                        case e: java.io.EOFException => finished = true\n"
       "                    }\n"
       "                }\n"
       "                pending != null\n"
       "            }\n"
       (format "            def next(): ~a = {\n" out)
       "                if (!hasNext) throw new NoSuchElementException(\"next on empty stream\")\n"
       "                val out = pending\n"
       "                pending = null\n"
       "                out\n"
       "            }\n"
       "            def cancel(): Unit = stream.cancel()\n"
       "            def close(): Unit = stream.close()\n"
       "            /** Initial metadata (response headers); null until they arrive. */\n"
       "            def headers: Map[String, String] = if (stream.headers == null) null else stream.headers.metadata\n"
       "            /** Trailing metadata of the terminal status; null until it arrives. */\n"
       "            def trailers: Map[String, String] = stream.trailers\n"
       "        }\n\n")))
    (apply
     string-append
     (map scala-client-method (append methods (alias-client-methods svc))))
    "        // -- async (scala.concurrent.Future) surface ---------------\n\n"
    (apply
     string-append
     (map scala-future-method (append methods (alias-client-methods svc))))
    "    }\n\n"
    (apply
     string-append
     (for/list
      ((out (in-list (class-outputs 'server-streaming))))
      (string-append
       (format
        "    /** Server-streaming sink passed to service implementations. */\n")
       (format "    trait ~a {\n" (scala-ss-trait-name sname out))
       (format "        def send(resp: ~a): Unit\n" out)
       "        val context: grpcdc.Endpoint#CallContext\n"
       "    }\n\n")))
    (apply
     string-append
     (for/list
      ((pr (in-list (pair-list 'client-streaming))))
      (string-append
       (format
        "    /** Client-streaming stream passed to service implementations. */\n")
       (format
        "    trait ~a {\n"
        (scala-pair-trait-name
         sname
         'client-streaming
         (car pr)
         (cdr pr)
         "ClientStreamServer"))
       (format "        def recv(): ~a\n" (car pr))
       (format "        def sendAndClose(resp: ~a): Unit\n" (cdr pr))
       "        val context: grpcdc.Endpoint#CallContext\n"
       "    }\n\n")))
    (apply
     string-append
     (for/list
      ((pr (in-list (pair-list 'bidi))))
      (string-append
       (format "    /** Bidi stream passed to service implementations. */\n")
       (format
        "    trait ~a {\n"
        (scala-pair-trait-name sname 'bidi (car pr) (cdr pr) "BidiServer"))
       (format "        def send(resp: ~a): Unit\n" (cdr pr))
       (format "        def recv(): ~a\n" (car pr))
       "        val context: grpcdc.Endpoint#CallContext\n"
       "    }\n\n")))
    (format
     "    /** Service implementation interface for ~a. */\n"
     (hash-ref svc 'full-name))
    (format "    trait ~aServer {\n" sname)
    (apply string-append (map scala-server-iface-method methods))
    "    }\n\n"
    (format
     "    /** Register an implementation of ~a on a Server. */\n"
     (hash-ref svc 'full-name))
    (format
     "    def register~aServer(server: grpcdc.Server, impl: ~aServer): Unit = {\n"
     sname
     sname)
    (format
     "        server.registerService(grpcdc.Server.ServiceDesc(~s, List(\n"
     (hash-ref svc 'full-name))
    (apply
     string-append
     (map scala-register-method (append methods (alias-server-methods svc))))
    "        )))\n"
    "    }\n\n"
    (format
     "    /** Async service implementation for ~a (scala.concurrent.Future). */\n"
     (hash-ref svc 'full-name))
    (format "    trait ~aServerAsync {\n" sname)
    (apply string-append (map scala-server-async-iface-method methods))
    "    }\n\n"
    (format
     "    /** Register a Future-based implementation (adapts to the sync trait). */\n")
    (format
     "    def register~aServerAsync(server: grpcdc.Server, impl: ~aServerAsync): Unit = {\n"
     sname
     sname)
    (format "        register~aServer(server, new ~aServer {\n" sname sname)
    (apply string-append (map scala-server-async-adapter-method methods))
    "        })\n"
    "    }\n")))

(define sc-pb-varint-types varint-scalar-types)

(define sc-pb-fixed
  (map
   (lambda (e) (list (first e) (second e) (string->symbol (third e))))
   (fixed-scalar-table 'scala)))

(define (sc-pb-camel s)
  (define parts (string-split s "_"))
  (if (null? parts)
    s
    (apply
     string-append
     (car parts)
     (map
      (lambda (p)
        (if (string=? p "")
          ""
          (string-append
           (string (char-upcase (string-ref p 0)))
           (substring p 1))))
      (cdr parts)))))

(define sc-pb-keywords
  '("abstract"
    "case"
    "catch"
    "class"
    "def"
    "do"
    "else"
    "extends"
    "false"
    "final"
    "finally"
    "for"
    "forSome"
    "if"
    "implicit"
    "import"
    "lazy"
    "match"
    "new"
    "null"
    "object"
    "override"
    "package"
    "private"
    "protected"
    "return"
    "sealed"
    "super"
    "this"
    "throw"
    "trait"
    "try"
    "true"
    "type"
    "val"
    "var"
    "while"
    "with"
    "yield"))

(define (sc-pb-field-name f)
  (define jn (hash-ref f 'json-name ""))
  (define n
    (if (and jn (not (string=? jn ""))) jn (sc-pb-camel (hash-ref f 'name))))
  (if (member n sc-pb-keywords) (string-append "`" n "`") n))

(define (sc-pb-flat pkg full)
  (define rel
    (if (and pkg
             (not (string=? pkg ""))
             (string-prefix? full (string-append pkg ".")))
      (substring full (add1 (string-length pkg)))
      full))
  (string-join (string-split rel ".") "_"))

(define (sc-pb-resolve model type-name)
  (hash-ref
   (hash-ref model 'types)
   type-name
   (lambda () (error 'emit-scala-pb-file "unresolved type ~a" type-name))))

(define (sc-pb-entry-ref model entry)
  (define flat
    (sc-pb-flat
     (hash-ref entry 'pkg)
     (if (eq? (hash-ref entry 'kind) 'enum)
       (let ((e (hash-ref entry 'enum)))
         (if (hash-ref entry 'msg)
           (format
            "~a.~a"
            (hash-ref (hash-ref entry 'msg) 'full-name)
            (hash-ref e 'name))
           (format "~a.~a" (hash-ref entry 'pkg) (hash-ref e 'name))))
       (hash-ref (hash-ref entry 'msg) 'full-name))))
  (define simple
    (if (eq? (hash-ref entry 'kind) 'enum)
      (hash-ref (hash-ref entry 'enum) 'name)
      flat))
  (if (or (eq? (hash-ref entry 'kind) 'map)
          (equal? (hash-ref entry 'file) (hash-ref model 'name)))
    (if (eq? (hash-ref entry 'kind) 'enum)
      (sc-pb-flat
       (hash-ref entry 'pkg)
       (if (hash-ref entry 'msg)
         (format "~a.~a" (hash-ref (hash-ref entry 'msg) 'full-name) simple)
         (format "~a.~a" (hash-ref entry 'pkg) simple)))
      flat)
    (format "~a.~a" (hash-ref entry 'pkg) simple)))

(define (sc-pb-scalar-type f) (scalar-type-entry 'scala (hash-ref f 'type)))

(define (sc-pb-elem-type model f)
  (if (= (hash-ref f 'type) 11)
    (sc-pb-entry-ref model (sc-pb-resolve model (hash-ref f 'type-name)))
    (sc-pb-scalar-type f)))

(define (sc-pb-type model f)
  (cond
   ((and (= (hash-ref f 'type) 11)
         (eq?
          (hash-ref (sc-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (sc-pb-resolve model (hash-ref f 'type-name)))
    (define msg (hash-ref entry 'msg))
    (define kf
      (findf (lambda (x) (= (hash-ref x 'number) 1)) (hash-ref msg 'fields)))
    (define vf
      (findf (lambda (x) (= (hash-ref x 'number) 2)) (hash-ref msg 'fields)))
    (format
     "Map[~a, ~a]"
     (sc-pb-elem-type model kf)
     (sc-pb-elem-type model vf)))
   ((= (hash-ref f 'label) 3) (format "List[~a]" (sc-pb-elem-type model f)))
   (else (sc-pb-elem-type model f))))

(define (sc-pb-explicit-literal model f)
  (define d (field-explicit-default f))
  (and d
       (case (hash-ref f 'type)
         ((9) (format "~s" d))
         ((8) d)
         ((14) (format "~a" (enum-default-number model f)))
         ((2) (format "~af" d))
         (else d))))

(define (sc-pb-default model f)
  (cond
   ((sc-pb-explicit-literal model f) => (lambda (lit) lit))
   ((and (= (hash-ref f 'type) 11)
         (eq?
          (hash-ref (sc-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    "Map.empty")
   ((= (hash-ref f 'label) 3) "List.empty")
   ((= (hash-ref f 'type) 11) "null")
   ((= (hash-ref f 'type) 9) "\"\"")
   ((= (hash-ref f 'type) 12) "Array.empty[Byte]")
   ((= (hash-ref f 'type) 8) "false")
   ((= (hash-ref f 'type) 1) "0.0")
   ((= (hash-ref f 'type) 2) "0.0f")
   ((memv (hash-ref f 'type) '(3 4 6 16 18)) "0L")
   ((= (hash-ref f 'type) 14)
    (define entry (sc-pb-resolve model (hash-ref f 'type-name)))
    (format
     "~a"
     (hash-ref (car (hash-ref (hash-ref entry 'enum) 'values)) 'number)))
   (else "0")))

(define (sc-pb-varint-expr f v)
  (case (hash-ref f 'type)
    ((8) (format "(if (~a) 1L else 0L)" v))
    ((17) (format "(((~a << 1) ^ (~a >> 31)) & 0xffffffffL)" v v))
    ((18) (format "((~a << 1) ^ (~a >> 63))" v v))
    ((5 14) (format "(~a.toLong)" v))
    ((13 7) (format "(~a & 0xffffffffL)" v))
    (else (format "~a.toLong" v))))

(define (sc-pb-varint-decode f v)
  (case (hash-ref f 'type)
    ((5 14 13 7) (format "~a.toInt" v))
    ((8) (format "(~a != 0L)" v))
    ((17) (format "(((~a.toInt) >>> 1) ^ -((~a.toInt) & 1))" v v))
    ((18) (format "((~a >>> 1) ^ -(~a & 1L))" v v))
    (else v)))

(define (sc-pb-fixed-info f) (assv (hash-ref f 'type) sc-pb-fixed))

(define (sc-pb-wire f) (if (= (second (sc-pb-fixed-info f)) 8) 1 5))

(define (sc-pb-fixed-encode-expr f v)
  (case (third (sc-pb-fixed-info f))
    ((double)
     (format
      "~a.int64BytesLE(java.lang.Double.doubleToRawLongBits(~a))"
      (current-pb-obj)
      v))
    ((float)
     (format
      "~a.int32BytesLE(java.lang.Float.floatToRawIntBits(~a))"
      (current-pb-obj)
      v))
    ((fixed64) (format "~a.int64BytesLE(~a)" (current-pb-obj) v))
    ((fixed32) (format "~a.int32BytesLE(~a)" (current-pb-obj) v))))

(define (sc-pb-fixed-decode-expr f src)
  (case (third (sc-pb-fixed-info f))
    ((double)
     (format
      "java.lang.Double.longBitsToDouble(~a.toInt64LE(~a, 0))"
      (current-pb-obj)
      src))
    ((float)
     (format
      "java.lang.Float.intBitsToFloat(~a.toInt32LE(~a, 0))"
      (current-pb-obj)
      src))
    ((fixed64) (format "~a.toInt64LE(~a, 0)" (current-pb-obj) src))
    ((fixed32) (format "~a.toInt32LE(~a, 0)" (current-pb-obj) src))))

(define current-pb-obj (make-parameter "Pb"))

(define (sc-pb-nonzero f v)
  (case (hash-ref f 'type) ((8) v) (else (format "~a != 0" v))))

(define (sc-pb-encode-singular model f v indent)
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define obj (current-pb-obj))
  (define proto2? (equal? (hash-ref model 'syntax "") "proto2"))
  (cond
   ((memv type sc-pb-varint-types)
    (if proto2?
      (format
       "~a{\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~a}\n"
       indent
       indent
       n
       indent
       (sc-pb-varint-expr f v)
       indent)
      (format
       "~aif (~a) {\n~a  w.tag(~a, 0)\n~a  w.varint(~a)\n~a}\n"
       indent
       (sc-pb-nonzero f v)
       indent
       n
       indent
       (sc-pb-varint-expr f v)
       indent)))
   ((assv type sc-pb-fixed)
    (if proto2?
      (format
       "~a{\n~a  w.fixed(~a, ~a, ~a)\n~a}\n"
       indent
       indent
       n
       (sc-pb-wire f)
       (sc-pb-fixed-encode-expr f v)
       indent)
      (format
       "~aif (~a != 0) {\n~a  w.fixed(~a, ~a, ~a)\n~a}\n"
       indent
       v
       indent
       n
       (sc-pb-wire f)
       (sc-pb-fixed-encode-expr f v)
       indent)))
   ((= type 9)
    (if proto2?
      (format
       "~aw.bytesField(~a, ~a.getBytes(java.nio.charset.StandardCharsets.UTF_8))\n"
       indent
       n
       v)
      (format "~aw.stringField(~a, ~a)\n" indent n v)))
   ((= type 12)
    (if proto2?
      (format "~aw.bytesField(~a, ~a)\n" indent n v)
      (format
       "~aif (~a.nonEmpty) {\n~a  w.bytesField(~a, ~a)\n~a}\n"
       indent
       v
       indent
       n
       v
       indent)))
   ((= type 11)
    (format
     "~aif (~a != null) {\n~a  w.bytesField(~a, ~a.marshalDc())\n~a}\n"
     indent
     v
     indent
     n
     v
     indent))
   (else
    (error 'emit-scala-pb-file "unsupported field type ~a (groups)" type))))

(define (sc-pb-set-expr sib)
  (define v (sc-pb-field-name sib))
  (case (hash-ref sib 'type)
    ((11 10) (format "~a != null" v))
    ((9 12) (format "~a.nonEmpty" v))
    (else (sc-pb-nonzero sib v))))

(define (sc-pb-encode-guard model f code)
  (define later (oneof-later-siblings model f))
  (if (null? later)
    code
    (format
     "    if (!(~a)) {\n~a    }\n"
     (string-join (map sc-pb-set-expr later) " || ")
     (if (string-suffix? code "\n") code (string-append code "\n")))))

(define (sc-pb-encode-field model f)
  (define v (sc-pb-field-name f))
  (define n (hash-ref f 'number))
  (define type (hash-ref f 'type))
  (define obj (current-pb-obj))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (sc-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (sc-pb-resolve model (hash-ref f 'type-name)))
    (define helper (format "~a.encode~a" obj (sc-pb-entry-ref model entry)))
    (format
     "    for (k <- ~a.keys.toArray.sorted) {\n      w.bytesField(~a, ~a(k, ~a(k)))\n    }\n"
     v
     n
     helper
     v))
   ((not (= (hash-ref f 'label) 3)) (sc-pb-encode-singular model f v "    "))
   ((memv type sc-pb-varint-types)
    (string-append
     (format
      "    if (~a.nonEmpty) {\n      val payload = new java.io.ByteArrayOutputStream()\n"
      v)
     (format
      "      for (x <- ~a) {\n        payload.write(~a.varintBytes(~a))\n      }\n"
      v
      obj
      (sc-pb-varint-expr f "x"))
     (format "      w.bytesField(~a, payload.toByteArray)\n    }\n" n)))
   ((assv type sc-pb-fixed)
    (string-append
     (format
      "    if (~a.nonEmpty) {\n      val payload = new java.io.ByteArrayOutputStream()\n"
      v)
     (format
      "      for (x <- ~a) {\n        payload.write(~a)\n      }\n"
      v
      (sc-pb-fixed-encode-expr f "x"))
     (format "      w.bytesField(~a, payload.toByteArray)\n    }\n" n)))
   ((= type 9)
    (format
     "    for (x <- ~a) {\n      w.bytesField(~a, x.getBytes(java.nio.charset.StandardCharsets.UTF_8))\n    }\n"
     v
     n))
   ((= type 12)
    (format "    for (x <- ~a) {\n      w.bytesField(~a, x)\n    }\n" v n))
   ((= type 11)
    (format
     "    for (x <- ~a) {\n      w.bytesField(~a, x.marshalDc())\n    }\n"
     v
     n))
   (else
    (error 'emit-scala-pb-file "unsupported repeated field type ~a" type))))

(define (sc-pb-decode-singular model f target src indent)
  (define type (hash-ref f 'type))
  (cond
   ((memv type sc-pb-varint-types)
    (format "~a~a = ~a\n" indent target (sc-pb-varint-decode f src)))
   ((assv type sc-pb-fixed)
    (format "~a~a = ~a\n" indent target (sc-pb-fixed-decode-expr f src)))
   ((= type 9)
    (format
     "~a~a = new String(~a, java.nio.charset.StandardCharsets.UTF_8)\n"
     indent
     target
     src))
   ((= type 12) (format "~a~a = ~a\n" indent target src))
   ((= type 11)
    (define ref
      (sc-pb-entry-ref model (sc-pb-resolve model (hash-ref f 'type-name))))
    (string-append
     (format "~a~a = new ~a()\n" indent target ref)
     (format "~a~a.unmarshalDc(~a)\n" indent target src)))
   (else (error 'emit-scala-pb-file "unsupported field type ~a" type))))

(define (sc-pb-oneof-clearing model f)
  (apply
   string-append
   (map
    (lambda (sib)
      (format
       "          ~a = ~a\n"
       (sc-pb-field-name sib)
       (sc-pb-default model sib)))
    (oneof-siblings model f))))

(define (sc-pb-decode-case model f)
  (define v (sc-pb-field-name f))
  (define type (hash-ref f 'type))
  (define obj (current-pb-obj))
  (define head (format "        case ~a =>\n" (hash-ref f 'number)))
  (define clearing (sc-pb-oneof-clearing model f))
  (cond
   ((and (= type 11)
         (eq?
          (hash-ref (sc-pb-resolve model (hash-ref f 'type-name)) 'kind)
          'map))
    (define entry (sc-pb-resolve model (hash-ref f 'type-name)))
    (define helper (format "~a.decode~a" obj (sc-pb-entry-ref model entry)))
    (string-append
     head
     (format "          val (kk, vv) = ~a(field.bytesValue)\n" helper)
     (format "          ~a = ~a + (kk -> vv)\n" v v)))
   ((not (= (hash-ref f 'label) 3))
    (string-append
     head
     clearing
     (sc-pb-decode-singular
      model
      f
      v
      (cond
       ((memv type sc-pb-varint-types) "field.varintValue")
       ((assv type sc-pb-fixed) "field.fixedValue")
       (else "field.bytesValue"))
      "          ")))
   ((memv type sc-pb-varint-types)
    (string-append
     head
     "          if (field.wire == 2) {\n"
     (format "            val sub = new ~a.Reader(field.bytesValue)\n" obj)
     "            while (!sub.done) {\n"
     "              val raw = sub.varint()\n"
     (format "              ~a = ~a :+ ~a\n" v v (sc-pb-varint-decode f "raw"))
     "            }\n          } else {\n"
     (format
      "            ~a = ~a :+ ~a\n"
      v
      v
      (sc-pb-varint-decode f "field.varintValue"))
     "          }\n"))
   ((assv type sc-pb-fixed)
    (string-append
     head
     "          if (field.wire == 2) {\n"
     (format
      "            var i = 0\n            while (i < field.bytesValue.length) {\n")
     (format
      "              ~a = ~a :+ ~a\n"
      v
      v
      (sc-pb-fixed-decode-expr
       f
       (format
        "java.util.Arrays.copyOfRange(field.bytesValue, i, i + ~a)"
        (second (sc-pb-fixed-info f)))))
     (format
      "              i += ~a\n            }\n          } else {\n"
      (second (sc-pb-fixed-info f)))
     (format
      "            ~a = ~a :+ ~a\n"
      v
      v
      (sc-pb-fixed-decode-expr f "field.fixedValue"))
     "          }\n"))
   ((= type 9)
    (string-append
     head
     (format
      "          ~a = ~a :+ new String(field.bytesValue, java.nio.charset.StandardCharsets.UTF_8)\n"
      v
      v)))
   ((= type 12)
    (string-append
     head
     (format "          ~a = ~a :+ field.bytesValue\n" v v)))
   ((= type 11)
    (string-append
     head
     (format
      "          val item = new ~a()\n"
      (sc-pb-entry-ref model (sc-pb-resolve model (hash-ref f 'type-name))))
     "          item.unmarshalDc(field.bytesValue)\n"
     (format "          ~a = ~a :+ item\n" v v)))
   (else
    (error 'emit-scala-pb-file "unsupported repeated field type ~a" type))))

(define (sc-pb-map-helpers model entry)
  (define msg (hash-ref entry 'msg))
  (define base (sc-pb-entry-ref model entry))
  (define obj (current-pb-obj))
  (define key-f
    (findf (lambda (x) (= (hash-ref x 'number) 1)) (hash-ref msg 'fields)))
  (define val-f
    (findf (lambda (x) (= (hash-ref x 'number) 2)) (hash-ref msg 'fields)))
  (unless (and key-f val-f)
    (error
     'emit-scala-pb-file
     "map entry ~a lacks key/value"
     (hash-ref msg 'full-name)))
  (string-append
   (format
    "  def encode~a(key: ~a, value: ~a): Array[Byte] = {\n    val w = new Writer()\n"
    base
    (sc-pb-elem-type model key-f)
    (sc-pb-elem-type model val-f))
   (sc-pb-encode-singular model (hash-set key-f 'label 1) "key" "    ")
   (sc-pb-encode-singular model (hash-set val-f 'label 1) "value" "    ")
   "    w.toBytes\n  }\n\n"
   (format
    "  def decode~a(data: Array[Byte]): (~a, ~a) = {\n"
    base
    (sc-pb-elem-type model key-f)
    (sc-pb-elem-type model val-f))
   (format
    "    var key: ~a = ~a\n    var value: ~a = ~a\n"
    (sc-pb-elem-type model key-f)
    (sc-pb-default model (hash-set key-f 'label 1))
    (sc-pb-elem-type model val-f)
    (sc-pb-default model (hash-set val-f 'label 1)))
   "    val r = new Reader(data)\n    var field = r.next()\n    while (field != null) {\n      field.number match {\n"
   (format
    "        case ~a =>\n~a"
    (hash-ref key-f 'number)
    (sc-pb-decode-singular
     model
     (hash-set key-f 'label 1)
     "key"
     (cond
      ((memv (hash-ref key-f 'type) sc-pb-varint-types) "field.varintValue")
      ((assv (hash-ref key-f 'type) sc-pb-fixed) "field.fixedValue")
      (else "field.bytesValue"))
     "          "))
   (format
    "        case ~a =>\n~a"
    (hash-ref val-f 'number)
    (if (= (hash-ref val-f 'type) 11)
      (format
       "          value = new ~a()\n          value.unmarshalDc(field.bytesValue)\n"
       (sc-pb-entry-ref
        model
        (sc-pb-resolve model (hash-ref val-f 'type-name))))
      (sc-pb-decode-singular
       model
       (hash-set val-f 'label 1)
       "value"
       (cond
        ((memv (hash-ref val-f 'type) sc-pb-varint-types) "field.varintValue")
        ((assv (hash-ref val-f 'type) sc-pb-fixed) "field.fixedValue")
        (else "field.bytesValue"))
       "          ")))
   "        case _ => ()\n      }\n      field = r.next()\n    }\n    (key, value)\n  }\n\n"))

(define (sc-pb-support obj)
  (string-append
   (format "object ~a {\n" obj)
   "  class Writer {\n"
   "    private val out = new java.io.ByteArrayOutputStream()\n\n"
   "    def varint(value: Long): Unit = {\n      var v = value\n      while ((v & -0x80L) != 0L) {\n        out.write(((v & 0x7f) | 0x80).toInt)\n        v = v >>> 7\n      }\n      out.write(v.toInt)\n    }\n\n"
   "    def tag(field: Int, wire: Int): Unit = {\n      varint(((field << 3) | wire).toLong)\n    }\n\n"
   "    def bytesField(field: Int, payload: Array[Byte]): Unit = {\n      tag(field, 2)\n      varint(payload.length.toLong)\n      out.write(payload)\n    }\n\n"
   "    def stringField(field: Int, value: String): Unit = {\n      if (value.nonEmpty) {\n        bytesField(field, value.getBytes(java.nio.charset.StandardCharsets.UTF_8))\n      }\n    }\n\n"
   "    def fixed(field: Int, wire: Int, payload: Array[Byte]): Unit = {\n      tag(field, wire)\n      out.write(payload)\n    }\n\n"
   "    def raw(payload: Array[Byte]): Unit = {\n      out.write(payload)\n    }\n\n"
   "    def toBytes: Array[Byte] = out.toByteArray\n  }\n\n"
   "  def varintBytes(value: Long): Array[Byte] = {\n    val w = new Writer()\n    w.varint(value)\n    w.toBytes\n  }\n\n"
   "  def int32BytesLE(value: Int): Array[Byte] = {\n    Array((value & 0xff).toByte, ((value >> 8) & 0xff).toByte, ((value >> 16) & 0xff).toByte, ((value >> 24) & 0xff).toByte)\n  }\n\n"
   "  def int64BytesLE(value: Long): Array[Byte] = {\n    val out = new Array[Byte](8)\n    var i = 0\n    while (i < 8) {\n      out(i) = ((value >> (8 * i)) & 0xffL).toByte\n      i += 1\n    }\n    out\n  }\n\n"
   "  def toInt32LE(bytes: Array[Byte], off: Int): Int = {\n    (bytes(off) & 0xff) | ((bytes(off + 1) & 0xff) << 8) | ((bytes(off + 2) & 0xff) << 16) | ((bytes(off + 3) & 0xff) << 24)\n  }\n\n"
   "  def toInt64LE(bytes: Array[Byte], off: Int): Long = {\n    var result = 0L\n    var i = 0\n    while (i < 8) {\n      result |= (bytes(off + i) & 0xffL) << (8 * i)\n      i += 1\n    }\n    result\n  }\n\n"
   "  class Field(val number: Int, val wire: Int, val varintValue: Long, val bytesValue: Array[Byte], val fixedValue: Array[Byte], val rawValue: Array[Byte])\n\n"
   "  class Reader(private val buf: Array[Byte]) {\n"
   "    private var pos = 0\n\n"
   "    def done: Boolean = pos >= buf.length\n\n"
   "    def varint(): Long = {\n      var result = 0L\n      var shift = 0\n      while (true) {\n        if (pos >= buf.length) {\n          throw new IllegalArgumentException(\"truncated varint\")\n        }\n        val b = buf(pos).toInt & 0xff\n        pos += 1\n        result = result | ((b & 0x7f).toLong << shift)\n        if ((b & 0x80) == 0) {\n          return result\n        }\n        shift += 7\n        if (shift >= 70) {\n          throw new IllegalArgumentException(\"varint too long\")\n        }\n      }\n      0L\n    }\n\n"
   "    def take(n: Int): Array[Byte] = {\n      if (pos + n > buf.length) {\n        throw new IllegalArgumentException(\"truncated field\")\n      }\n      val value = buf.slice(pos, pos + n)\n      pos += n\n      value\n    }\n\n"
   "    def next(): Field = {\n      if (done) {\n        return null\n      }\n      val start = pos\n      val tag = varint()\n      val number = (tag >>> 3).toInt\n      val wire = (tag & 7).toInt\n      wire match {\n        case 0 =>\n          val v = varint()\n          new Field(number, wire, v, Array.empty[Byte], Array.empty[Byte], buf.slice(start, pos))\n        case 2 =>\n          val n = varint().toInt\n          new Field(number, wire, 0L, take(n), Array.empty[Byte], buf.slice(start, pos))\n        case 1 => new Field(number, wire, 0L, Array.empty[Byte], take(8), buf.slice(start, pos))\n        case 5 => new Field(number, wire, 0L, Array.empty[Byte], take(4), buf.slice(start, pos))\n        case _ => throw new IllegalArgumentException(\"bad wire type\")\n      }\n    }\n  }\n"))

(define (sc-pb-message-class model msg)
  (define name
    (sc-pb-flat (hash-ref model 'package) (hash-ref msg 'full-name)))
  (define fields (hash-ref msg 'fields))
  (define obj (current-pb-obj))
  (string-append
   (format "class ~a(\n" name)
   (string-join
    (map
     (lambda (f)
       (format
        "    var ~a: ~a = ~a"
        (sc-pb-field-name f)
        (sc-pb-type model f)
        (sc-pb-default model f)))
     fields)
    ",\n")
   (if (null? fields) "" "\n")
   ") extends grpcdc.Marshaler with grpcdc.Unmarshaler {\n"
   "  var unknownFields: Array[Byte] = Array.empty[Byte]\n"
   "  def marshalDc(): Array[Byte] = {\n"
   (format "    val w = new ~a.Writer()\n" obj)
   (apply
    string-append
    (map
     (lambda (f) (sc-pb-encode-guard model f (sc-pb-encode-field model f)))
     fields))
   "    w.raw(unknownFields)\n"
   "    w.toBytes\n  }\n\n"
   "  def unmarshalDc(data: Array[Byte]): Unit = {\n"
   "    unknownFields = Array.empty[Byte]\n"
   (apply
    string-append
    (map
     (lambda (f)
       (format "    ~a = ~a\n" (sc-pb-field-name f) (sc-pb-default model f)))
     fields))
   (format "    val r = new ~a.Reader(data)\n" obj)
   "    var field = r.next()\n    while (field != null) {\n      field.number match {\n"
   (apply string-append (map (lambda (f) (sc-pb-decode-case model f)) fields))
   "        case _ => unknownFields = unknownFields ++ field.rawValue\n      }\n      field = r.next()\n    }\n  }\n"
   "}\n\n"
   (apply
    string-append
    (map (lambda (n) (sc-pb-message-class model n)) (hash-ref msg 'nested)))))

(define (sc-pb-enum model e)
  (define name
    (sc-pb-flat
     (hash-ref model 'package)
     (if (string=? (hash-ref model 'package) "")
       (hash-ref e 'name)
       (format "~a.~a" (hash-ref model 'package) (hash-ref e 'name)))))
  (string-append
   (format "object ~a {\n" name)
   (apply
    string-append
    (map
     (lambda (v)
       (format
        "  final val ~a: Int = ~a\n"
        (hash-ref v 'name)
        (hash-ref v 'number)))
     (hash-ref e 'values)))
   "}\n\n"))

(define (emit-scala-pb-file file-model)
  (and (hash-has-key? file-model 'messages)
       (hash-has-key? file-model 'types)
       (emit-scala-pb-file/inner file-model)))

(define (emit-scala-pb-file/inner file-model)
  (define messages (hash-ref file-model 'messages))
  (define enums (hash-ref file-model 'enums))
  (and (or (pair? messages) (pair? enums))
       (let ()
         (define base
           (path->string
            (path-replace-extension
             (file-name-from-path (hash-ref file-model 'name))
             "")))
         (define obj (string-append (pascal (string->symbol base)) "Pb"))
         (define pkg (hash-ref file-model 'package))
         (define seen-maps (mutable-set))
         (define helpers '())
         (define (collect msg)
           (for
            ((f (in-list (hash-ref msg 'fields))))
            (when (= (hash-ref f 'type) 11)
              (define e (sc-pb-resolve file-model (hash-ref f 'type-name)))
              (when (and
                     (eq? (hash-ref e 'kind) 'map)
                     (not
                      (set-member?
                       seen-maps
                       (hash-ref (hash-ref e 'msg) 'full-name))))
                (set-add! seen-maps (hash-ref (hash-ref e 'msg) 'full-name))
                (set! helpers
                  (cons (sc-pb-map-helpers file-model e) helpers)))))
           (for ((n (in-list (hash-ref msg 'nested)))) (collect n)))
         (parameterize
          ((current-pb-obj obj))
          (for ((m (in-list messages))) (collect m))
          (define content
            (string-append
             "// @generated by protoc-gen-grpc-dc-scala. DO NOT EDIT.\n"
             (if (string=? pkg "") "" (format "package ~a\n\n" pkg))
             (sc-pb-support obj)
             (apply string-append helpers)
             "}\n\n"
             (apply
              string-append
              (map (lambda (e) (sc-pb-enum file-model e)) enums))
             (apply
              string-append
              (map
               (lambda (m) (sc-pb-message-class file-model m))
               (filter (lambda (m) (not (hash-ref m 'map-entry))) messages)))))
          (cons
           (string-append (pascal (string->symbol base)) "Messages.scala")
           content)))))

(define (scala-qualify-type pkg simple full)
  (cond
   ((or (not full)
        (string=? pkg "")
        (string-prefix? full (string-append pkg ".")))
    simple)
   (else full)))

(define (scala-qualify-services pkg services)
  (for/list
   ((svc (in-list services)))
   (hash-set
    svc
    'methods
    (for/list
     ((m (in-list (hash-ref svc 'methods))))
     (hash-set*
      m
      'input
      (scala-qualify-type pkg (hash-ref m 'input) (hash-ref m 'input-full #f))
      'output
      (scala-qualify-type
       pkg
       (hash-ref m 'output)
       (hash-ref m 'output-full #f)))))))

(define (emit-scala-file file-model params)
  (define base
    (path->string
     (path-replace-extension
      (file-name-from-path (hash-ref file-model 'name))
      "")))
  (define obj-name (string-append (pascal (string->symbol base)) "GrpcDc"))
  (define pkg (hash-ref file-model 'package))
  (define stub
    (cons
     (string-append obj-name ".scala")
     (string-append
      "// @generated by protoc-gen-grpc-dc-scala. DO NOT EDIT.\n"
      (format "// source: ~a\n" (hash-ref file-model 'name))
      (format "package ~a\n\n" pkg)
      "/** Generated gRPC-over-DataChannels stubs. */\n"
      (format "object ~a {\n" obj-name)
      (if (equal? (hash-ref params 'trace #f) "hooks")
        (string-append
         "  // Tracing (trace=hooks): register an observer via setTracer.\n"
         "  def setTracer(t: grpcdc.Tracing.Tracer): Unit = grpcdc.Tracing.setTracer(t)\n"
         "  def setTraceFilter(patterns: String): Unit = grpcdc.Tracing.setTraceFilter(patterns)\n"
         (let ((methods (hash-ref params 'trace_methods #f)))
           (if methods
             (format "  grpcdc.Tracing.setTraceFilter(~s)\n" methods)
             ""))
         "\n")
        "")
      (apply
       string-append
       (map
        scala-service
        (scala-qualify-services pkg (hash-ref file-model 'services))))
      "}\n")))
  (define pb-file (emit-scala-pb-file file-model))
  (if pb-file (list stub pb-file) stub))

(define (plugin-main)
  (define request-bytes (port->bytes (current-input-port)))
  (define-values (files parameter) (parse-request request-bytes))
  (define params (parse-parameters parameter))
  (define trace-opt (hash-ref params 'trace #f))
  (when (and trace-opt (not (member trace-opt '("off" "hooks"))))
    (error
     (format "unknown trace option ~a (expected off or hooks)" trace-opt)))
  (define trace-methods (hash-ref params 'trace_methods #f))
  (when trace-methods
    (unless (equal? trace-opt "hooks")
      (error "trace_methods requires trace=hooks"))
    (for
     ((p (in-list (string-split trace-methods ";"))))
     (unless (string-prefix? p "/")
       (error (format "trace_methods pattern must start with /: ~a" p)))))
  (define (as-file-list out)
    (if (and (pair? out) (string? (car out))) (list out) out))
  (write-bytes
   (encode-response
    (append-map
     (lambda (f)
       (map stamp-generated-header (as-file-list (emit-scala-file f params))))
     files))
   (current-output-port))
  (flush-output))
(with-handlers
 ((exn:fail?
   (lambda (e)
     (write-bytes
      (encode-error-response (exn-message e))
      (current-output-port))
     (flush-output))))
 (plugin-main))
