<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>NetstandardHost</AssemblyName>
  </PropertyGroup>
  <!-- Runs the netstandard2.0 consumer under Mono (and on .NET
       Framework). Reference assemblies let it build on Linux;
       GrpcDc resolves to its netstandard2.0 lib via the consumer. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../Consumer.csproj" />
    <ProjectReference Include="../Kafka/KafkaConsumer.csproj" />
  </ItemGroup>
</Project>
