<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>KafkaGrpc</PackageId>
    <Version>0.36.0</Version>
    <Authors>John Davis</Authors>
    <Description>Kafka over gRPC — generated grpcdc.kafka.v1 clients (produce/consume/groups/topics) speaking gRPC over WebRTC DataChannels, via the grpc-dc runtime (.NET).</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/browser-grpc/grpc-over-datachannels</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GrpcDc" Version="0.36.0" />
  </ItemGroup>
</Project>
