# syntax=docker/dockerfile:1
# grpc-over-datachannels CI image: ALL build/test/tooling/run lives here.
# A developer machine needs only Docker — no local Racket, protoc, Rust,
# or Node installs.
#
# Build:
#   docker build -f Dockerfile.ci -t grpc-dc-ci .
#
# Full test suite (Racket + Rust + JS + WebRTC stacks + browser test):
#   docker run --rm grpc-dc-ci
#
# No special networking needed: the browser legs launch Firefox
# with media.peerconnection.ice.obfuscate_host_addresses=false
# (Playwright's Firefox answers no mDNS queries for its .local
# candidates and will not initiate checks to same-IP pairs, so
# in the single-IP bridge namespace our stacks could not reach
# it; Chromium keeps obfuscated candidates and exercises the
# mDNS path).
#
# Regenerate plugins/stubs from racket/spec.rkt and proto/echo.proto:
#   docker run --rm grpc-dc-ci make generate
#
# Single suites:
#   docker run --rm grpc-dc-ci make test-racket
#   docker run --rm grpc-dc-ci make test-rust
#   docker run --rm grpc-dc-ci make test-js
#   docker run --rm grpc-dc-ci make test-go
#   docker run --rm grpc-dc-ci make test-webrtc-rust
#   docker run --rm grpc-dc-ci make test-webrtc-js
#   docker run --rm grpc-dc-ci make test-grpc-webrtc
#   docker run --rm grpc-dc-ci make test-browser
#
# Run the echo demos (both languages, all four call shapes):
#   docker run --rm grpc-dc-ci make demos
#
# Interactive shell:
#   docker run --rm -it --entrypoint bash grpc-dc-ci
#
# Notes:
# - Base images are pinned by minor release; Rust dependencies are locked
#   via rust/Cargo.lock (cargo fetch --locked below). The JS runtime has
#   zero npm dependencies, so there is no package-lock to mirror.
# - Racket and protoc come from Debian bookworm: the protoc plugin
#   protocol used by bin/protoc-gen-grpc-dc-* is stable since long before
#   bookworm's protoc 3.21, and the Racket sources use no post-8.7
#   features (the image build proves this by regenerating everything).
# - `make generate` runs during the image build, so the checked-in
#   generated files are reproduced in-image from racket/spec.rkt; test
#   runs then work fully offline.

ARG RUST_IMAGE=rust:1.96-bookworm
ARG NODE_IMAGE=node:26-slim
ARG GO_IMAGE=golang:1.24-bookworm
ARG DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim

FROM ${NODE_IMAGE} AS node-src

FROM ${GO_IMAGE} AS go-src

FROM ${DOTNET_IMAGE} AS dotnet-src

FROM ${RUST_IMAGE} AS ci

# Node.js + npm from the official Node image (same glibc family).
COPY --from=node-src /usr/local /usr/local

# Go toolchain for the Go runtime (stdlib only, no module downloads).
COPY --from=go-src /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Swift toolchain for the Swift runtime (Foundation only, no package
# downloads). Official swift.org Debian 12 tarball, extracted like the
# user-space swiftly install used on developer machines.
ARG TARGETARCH
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl binutils libc6-dev \
     libcurl4-openssl-dev libedit2 libgcc-12-dev libpython3-dev \
     libsqlite3-0 libstdc++-12-dev libxml2-dev libz3-dev openssl pkg-config \
     tzdata unzip zlib1g-dev \
  && case "$TARGETARCH" in arm64) SWIFT_PLATFORM=debian12-aarch64 ;; *) SWIFT_PLATFORM=debian12 ;; esac \
  && curl -fsSL "https://download.swift.org/swift-6.4.0-release/${SWIFT_PLATFORM}/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-${SWIFT_PLATFORM}.tar.gz" \
     | tar xz -C /usr/local --strip-components=2 \
  && rm -rf /var/lib/apt/lists/*

# Kotlin compiler for the Kotlin runtime (JDK + Kotlin stdlib only;
# coroutine support uses stdlib kotlin.coroutines, no kotlinx).
# The Kotlin/Wasm stdlib is a separate pinned Maven artifact
# (not in the compiler zip); test-kotlin-wasm-browser needs it.
RUN curl -fsSL https://github.com/JetBrains/kotlin/releases/download/v2.2.0/kotlin-compiler-2.2.0.zip -o /tmp/kotlin-compiler.zip \
  && unzip -q /tmp/kotlin-compiler.zip -d /usr/local \
  && rm /tmp/kotlin-compiler.zip \
  && curl -fsSL https://repo1.maven.org/maven2/org/jetbrains/kotlin/kotlin-stdlib-wasm-js/2.2.0/kotlin-stdlib-wasm-js-2.2.0.klib \
     -o /usr/local/kotlinc/lib/kotlin-stdlib-wasm-js.klib \
  && echo "51d111704eb3477248eb57203bed7467b068de49  /usr/local/kotlinc/lib/kotlin-stdlib-wasm-js.klib" | sha1sum -c -
ENV PATH="/usr/local/kotlinc/bin:${PATH}"
# Scala 3 (native JVM runtime + tests; JDK already installed above).
RUN curl -fsSL https://github.com/scala/scala3/releases/download/3.3.6/scala3-3.3.6.tar.gz -o /tmp/scala3.tar.gz \
  && mkdir -p /usr/local/scala3 \
  && tar -xzf /tmp/scala3.tar.gz -C /usr/local/scala3 --strip-components=1 \
  && rm /tmp/scala3.tar.gz
ENV SCALA3_HOME=/usr/local/scala3
ENV PATH="/usr/local/scala3/bin:${PATH}"

# scala-cli packages the Scala.js facade (test-scalajs-browser);
# pinned release; arch-matched asset like the other toolchains.
RUN case "$(uname -m)" in \
      x86_64) asset=scala-cli-x86_64-pc-linux.gz ;; \
      aarch64) asset=scala-cli-aarch64-pc-linux.gz ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac \
  && curl -fsSL "https://github.com/VirtusLab/scala-cli/releases/download/v1.11.0/$asset" -o /tmp/scala-cli.gz \
  && cd /tmp && gunzip -f scala-cli.gz \
  && install -m 0755 /tmp/scala-cli /usr/local/bin/scala-cli \
  && rm -f /tmp/scala-cli.gz

# Zig toolchain for the Zig runtime (stdlib only, no packages;
# arch-aware like the Swift/Dart stages).
ARG TARGETARCH
RUN case "$TARGETARCH" in arm64) ZIG_ARCH=aarch64 ;; *) ZIG_ARCH=x86_64 ;; esac \
  && curl -fsSL "https://ziglang.org/download/0.15.1/zig-${ZIG_ARCH}-linux-0.15.1.tar.xz" -o /tmp/zig.tar.xz \
  && mkdir -p /usr/local/zig-dist \
  && tar -xJf /tmp/zig.tar.xz -C /usr/local/zig-dist --strip-components=1 \
  && rm /tmp/zig.tar.xz
ENV PATH="/usr/local/zig-dist:${PATH}"

# wasi-sdk 33 for the native C++ WASM build
# (test-cpp-wasm-native-browser): its exception-enabled libc++
# (share/wasi-sysroot/lib/wasm32-wasip1/eh) is what Zig's
# wasm32 libc++ lacks, and the native C++ runtime throws
# StatusException. Toolchain only — generated code stays
# stdlib-only. Arch-aware like the Zig stage.
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      arm64) WASI_ARCH=arm64; WASI_SHA=4f98ee738c7abb45c81a94d1461fc53cc569d1cd01498951c8184d841a027844 ;; \
      *) WASI_ARCH=x86_64; WASI_SHA=0ba8b5bfaeb2adf3f29bab5841d76cf5318ab8e1642ea195f88baba1abd47bce ;; \
    esac \
  && curl -fsSL "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-33/wasi-sdk-33.0-${WASI_ARCH}-linux.tar.gz" -o /tmp/wasi-sdk.tar.gz \
  && echo "${WASI_SHA}  /tmp/wasi-sdk.tar.gz" | sha256sum -c - \
  && mkdir -p /usr/local/wasi-sdk-33 \
  && tar -xzf /tmp/wasi-sdk.tar.gz -C /usr/local/wasi-sdk-33 --strip-components=1 \
  && rm /tmp/wasi-sdk.tar.gz

# Lua 5.4 sources for the browser WASM build (test-lua-wasm-browser
# compiles the VM to wasm32-wasi with zig cc).
RUN curl -fsSL https://www.lua.org/ftp/lua-5.4.7.tar.gz -o /tmp/lua.tar.gz \
  && mkdir -p /opt && tar -C /opt -xzf /tmp/lua.tar.gz && rm /tmp/lua.tar.gz
ENV LUA_SRC=/opt/lua-5.4.7/src

# Lua for the Lua runtime (pure 5.4 stdlib; no luarocks packages).
# luarocks only proves the rockspec install path in tests.
RUN apt-get update \
  && apt-get install -y --no-install-recommends lua5.4 liblua5.4-dev luarocks \
  && rm -rf /var/lib/apt/lists/*
ENV LUA=lua5.4

# coturn: a real TURN server for the WebRTC-Direct over-TURN
# interop tests (they skip when turnserver is not on PATH).
RUN apt-get update \
  && apt-get install -y --no-install-recommends coturn \
  && rm -rf /var/lib/apt/lists/*

# Ruby for the Ruby runtime (stdlib only; no gems). Composer
# only proves the Packagist package install path in tests.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ruby \
  && apt-get install -y --no-install-recommends php-cli composer \
  && rm -rf /var/lib/apt/lists/*
ENV RUBY=ruby
ENV PHP=php

# Dart SDK for the Dart runtime (dart: libraries only, no pub
# packages; arch-aware like the Swift stage).
ARG TARGETARCH
RUN case "$TARGETARCH" in arm64) DART_ARCH=arm64 ;; *) DART_ARCH=x64 ;; esac \
  && curl -fsSL "https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.5/sdk/dartsdk-linux-${DART_ARCH}-release.zip" -o /tmp/dartsdk.zip \
  && unzip -q /tmp/dartsdk.zip -d /usr/local \
  && rm /tmp/dartsdk.zip
ENV PATH="/usr/local/dart-sdk/bin:${PATH}"

# .NET SDK for the C# runtime (BCL only, no NuGet downloads).
COPY --from=dotnet-src /usr/share/dotnet /usr/share/dotnet
ENV DOTNET_ROOT="/usr/share/dotnet" \
    PATH="/usr/share/dotnet:${PATH}" \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Racket (metaprogram + protoc plugins) and protoc (stub generation),
# plus make to drive the same entry points as local development.
# JDK + Maven build the official grpc-java oracle (oracle/java) that
# the cross-language oracle tests run against. mono-devel (its
# Facades carry netstandard.dll) executes the netstandard2.0
# consumer smoke (csharp/tests-netstandard).
RUN apt-get update \
  && apt-get install -y --no-install-recommends racket protobuf-compiler make ca-certificates python3 python3-build twine g++ gcc gcc-aarch64-linux-gnu gcc-riscv64-linux-gnu libc6-dev-arm64-cross libc6-dev-riscv64-cross qemu-user iproute2 iptables \
     openjdk-17-jdk-headless maven mono-devel \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Rust manifests first for layer caching (both crates: rust/ path-depends
# on webrtc/rust for its `webrtc` feature).
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY webrtc/rust/Cargo.toml webrtc/rust/Cargo.lock ./webrtc/rust/
COPY wasm/rust/Cargo.toml wasm/rust/Cargo.lock ./wasm/rust/
COPY crates/kafka-native/Cargo.toml crates/kafka-native/Cargo.lock ./crates/kafka-native/
COPY proxy/tcp-sidecar/Cargo.toml proxy/tcp-sidecar/Cargo.lock ./proxy/tcp-sidecar/
# Empty target stubs so the fetch layer can parse the manifests;
# `COPY . .` below replaces them with the real sources.
RUN mkdir -p rust/src webrtc/rust/src wasm/rust/src crates/kafka-native/src proxy/tcp-sidecar/src \
  && touch rust/src/lib.rs webrtc/rust/src/lib.rs wasm/rust/src/lib.rs crates/kafka-native/src/lib.rs proxy/tcp-sidecar/src/lib.rs \
  && cd rust && cargo fetch --locked \
  && cd ../wasm/rust && cargo fetch --locked \
  && cd ../../proxy/tcp-sidecar && cargo fetch --locked

# Native WASM Rust client toolchain: wasm32 target + the
# wasm-bindgen CLI pinned to the crate version (0.2.100).
# Pure toolchain download, so it lives with the pre-COPY
# layers (it used to sit after `COPY . .`).
RUN rustup target add wasm32-unknown-unknown thumbv7em-none-eabihf
ARG TARGETARCH
RUN case "$TARGETARCH" in arm64) WBG_ARCH=aarch64 ;; *) WBG_ARCH=x86_64 ;; esac \
  && curl -fsSL "https://github.com/rustwasm/wasm-bindgen/releases/download/0.2.100/wasm-bindgen-0.2.100-${WBG_ARCH}-unknown-linux-gnu.tar.gz" -o /tmp/wbg.tar.gz \
  && mkdir -p /usr/local/wasm-bindgen \
  && tar -xzf /tmp/wbg.tar.gz -C /usr/local/wasm-bindgen --strip-components=1 \
  && rm /tmp/wbg.tar.gz
ENV PATH="/usr/local/wasm-bindgen:${PATH}"

# Toolchain warm-ups that need only a few repo files, placed
# before `COPY . .` so ordinary source changes do not bust
# their download caches (these were the multi-hour layers:
# scala-cli/bloop resolution, Maven oracle deps, Playwright
# browsers, the Racket/Wasm bootstrap). The post-COPY warm
# steps below re-run against the real sources and hit these
# caches.

# scala-cli dependency cache (JS linker warm-up; output to
# /tmp, the real package step runs post-COPY).
COPY wasm/scalajs/bridge.scala wasm/scalajs/EchoScalaJsGrpcDc.scala wasm/scalajs/echo_client.scala ./wasm/scalajs/
COPY scala/grpcdc/Transport.scala scala/grpcdc/Status.scala scala/grpcdc/WireGen.scala ./scala/grpcdc/
COPY scala/examples/EchoMessages.scala ./scala/examples/
RUN scala-cli --power package --force --js --js-module-kind esmodule --scala-version 3.3.6 \
      -o /tmp/echo_scalajs_client.mjs \
      wasm/scalajs/bridge.scala wasm/scalajs/EchoScalaJsGrpcDc.scala \
      scala/grpcdc/Transport.scala scala/grpcdc/Status.scala scala/grpcdc/WireGen.scala \
      scala/examples/EchoMessages.scala wasm/scalajs/echo_client.scala

# grpc-java oracle dependencies (Maven downloads).
COPY oracle/java ./oracle/java
RUN cd oracle/java && mvn -q package -DskipTests

# Apache Kafka + Redpanda fixtures for the Kafka proxy end-to-end
# tests (`make test-kafka`, scripts/kafka-e2e.sh). Kafka is the
# stock binary tarball (runs on the JDK above); Redpanda comes
# from the official apt repository. These are the broker versions
# the proxy is developed against (Kafka 4.3.1; Redpanda latest
# stable from its repo).
RUN curl -fsSL https://downloads.apache.org/kafka/4.3.1/kafka_2.13-4.3.1.tgz -o /tmp/kafka.tgz \
  && mkdir -p /opt/kafka \
  && tar -xzf /tmp/kafka.tgz -C /opt/kafka --strip-components=1 \
  && rm /tmp/kafka.tgz
RUN curl -fsSL https://linux.pkg.redpanda.com/setup-redpanda.deb.sh | bash \
  && apt-get update \
  && apt-get install -y --no-install-recommends redpanda \
  && rm -rf /var/lib/apt/lists/*

# Webapp schema compiler module cache.
COPY webapp/compiler ./webapp/compiler
RUN cd webapp/compiler && go mod download \
  && GOOS=js GOARCH=wasm go build -o /tmp/protocompile.wasm .

# Playwright browsers (npm ci needs only the manifests).
COPY browser-test/package.json browser-test/package-lock.json ./browser-test/
RUN cd browser-test && npm ci \
  && npx playwright install --with-deps chromium firefox webkit

# Racket/Wasm bootstrap: clones and builds the pinned tree
# (host Chez + host Racket + Emscripten). Output is staged
# outside the repo copy and merged in post-COPY below.
COPY scripts/build-racket-wasm.sh ./scripts/
COPY webapp/racket ./webapp/racket
RUN apt-get update \
  && apt-get install -y --no-install-recommends libncurses-dev libx11-dev x11proto-dev \
  && RACKET_WASM_WORK=/opt/racket-wasm-work ./scripts/build-racket-wasm.sh /opt/racket-wasm-built

# Per-language source copies + warm builds, before the
# catch-all COPY: a change in one language busts only its
# own warm layer, not every language's. The catch-all below
# guarantees nothing is missed; `make generate` still runs
# on the full tree. (Kept in sync with the language list in
# the Makefile test targets.)

# fixtures/ is read at compile time by the Rust crate
# (include_str!-style vectors), so it lands with the Rust copy.
COPY fixtures ./fixtures
COPY rust ./rust
COPY crates/kafka-native ./crates/kafka-native
COPY webrtc/rust ./webrtc/rust
COPY wasm/rust ./wasm/rust
RUN cd rust && cargo test --locked --no-run \
  && cargo build --locked --examples \
  && cargo test --locked --no-run --features kafka-tls --example kafka_proxy \
  && cd ../webrtc/rust && cargo test --locked --no-run

# The Go WebRTC stack links the Rust FFI cores (in-repo
# release paths in the bindings' cgo directives), so the
# cdylibs must be built before any go build.
COPY crates/dc-sctp-ffi ./crates/dc-sctp-ffi
COPY crates/dc-dtls-ffi ./crates/dc-dtls-ffi
COPY crates/dc-ice-ffi ./crates/dc-ice-ffi
RUN cd crates/dc-sctp-ffi && cargo build --release \
  && cd ../dc-dtls-ffi && cargo build --release \
  && cd ../dc-ice-ffi && cargo build --release

# Warm the Wasm core crates too: image test runs are
# offline (CARGO_NET_OFFLINE), and the JS/browser suites
# generate their glue from these.
COPY crates/dc-sctp-wasm ./crates/dc-sctp-wasm
COPY crates/dc-dtls-wasm ./crates/dc-dtls-wasm
COPY crates/dc-ice-wasm ./crates/dc-ice-wasm
COPY crates/dc-bridge-wasm ./crates/dc-bridge-wasm
RUN cd crates/dc-sctp-wasm && cargo build --release --target wasm32-unknown-unknown \
  && cd ../dc-dtls-wasm && cargo build --release --target wasm32-unknown-unknown \
  && cd ../dc-ice-wasm && cargo build --release --target wasm32-unknown-unknown \
  && cd ../dc-bridge-wasm && cargo build --release --target wasm32-unknown-unknown

COPY go ./go
COPY webrtc/go ./webrtc/go
RUN cd go && go build ./...

COPY csharp ./csharp
RUN cd csharp && dotnet build tests/Tests.csproj --nologo -v q \
  && dotnet build examples/EchoServerStdio/EchoServerStdio.csproj --nologo -v q \
  && dotnet build examples/EchoClientStdio/EchoClientStdio.csproj --nologo -v q \
  && dotnet build examples/DynamicEchoServerStdio/DynamicEchoServerStdio.csproj --nologo -v q

COPY cpp ./cpp
RUN mkdir -p cpp/build \
  && g++ -std=c++17 -pthread -O1 -Icpp -I. cpp/tests/main.cpp cpp/tests/test_codec.cpp cpp/tests/test_echo.cpp cpp/tests/test_interop.cpp cpp/tests/test_interop_oracle.cpp cpp/tests/test_interop_server_oracle.cpp cpp/tests/test_oracle.cpp cpp/tests/test_dynamic.cpp cpp/tests/test_bdd.cpp cpp/tests/test_deadline.cpp cpp/tests/test_tracing.cpp cpp/tests/test_inline_pump.cpp cpp/tests/test_pb_messages.cpp cpp/tests/test_bdd_schemas.cpp cpp/tests/test_sidecar.cpp cpp/tests/test_bdd_sidecar.cpp cpp/tests/test_eventbus.cpp cpp/tests/test_kafka_e2e.cpp -o cpp/build/tests \
  && g++ -std=c++17 -pthread -O1 -Icpp -I. cpp/examples/echo_server_stdio.cpp -o cpp/build/echo_server_stdio \
  && g++ -std=c++17 -pthread -O1 -Icpp -I. cpp/examples/echo_client_stdio.cpp -o cpp/build/echo_client_stdio \
  && g++ -std=c++17 -pthread -O1 -Icpp -I. cpp/examples/dynamic_echo_server_stdio.cpp -o cpp/build/dynamic_echo_server_stdio \
  && g++ -std=c++17 -pthread -O1 -Icpp -I. cpp/examples/interop_server_stdio.cpp -o cpp/build/interop_server_stdio

COPY swift ./swift
RUN mkdir -p swift/build \
  && swiftc -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/DynamicEchoService.swift swift/examples/interop/*.swift $(ls swift/tests/*.swift | grep -v TestKafkaNative) -o swift/build/tests \
  && swiftc -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/EchoServerStdio/main.swift -o swift/build/echo_server_stdio \
  && swiftc -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/EchoClientStdio/main.swift -o swift/build/echo_client_stdio \
  && swiftc -swift-version 5 -O swift/grpcdc/*.swift swift/examples/StdioTransport.swift swift/examples/DynamicEchoService.swift swift/examples/DynamicEchoServerStdio/main.swift -o swift/build/dynamic_echo_server_stdio \
  && swiftc -swift-version 5 -O swift/grpcdc/*.swift swift/examples/Pb.swift swift/examples/EchoMessages.swift swift/examples/EchoGrpcDc.swift swift/examples/EchoServiceImpl.swift swift/examples/StdioTransport.swift swift/examples/interop/*.swift swift/examples/InteropServerStdio/main.swift -o swift/build/interop_server_stdio

COPY kotlin ./kotlin
RUN mkdir -p kotlin/build \
  && kotlinc -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/DynamicEchoService.kt kotlin/examples/interop/*.kt kotlin/tests/*.kt -d kotlin/build/tests.jar \
  && kotlinc -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/EchoServerStdio/Main.kt -d kotlin/build/echo_server_stdio.jar \
  && kotlinc -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/interop/*.kt kotlin/examples/InteropServerStdio/Main.kt -d kotlin/build/interop_server_stdio.jar \
  && kotlinc -include-runtime kotlin/grpcdc/*.kt kotlin/examples/Pb.kt kotlin/examples/EchoMessages.kt kotlin/examples/EchoGrpcDc.kt kotlin/examples/EchoServiceImpl.kt kotlin/examples/StdioTransport.kt kotlin/examples/EchoClientStdio/Main.kt -d kotlin/build/echo_client_stdio.jar \
  && kotlinc -include-runtime kotlin/grpcdc/*.kt kotlin/examples/StdioTransport.kt kotlin/examples/DynamicEchoService.kt kotlin/examples/DynamicEchoServerStdio/Main.kt -d kotlin/build/dynamic_echo_server_stdio.jar

COPY dart ./dart
RUN mkdir -p dart/build \
  && dart compile exe dart/tests/main.dart -o dart/build/tests \
  && dart compile exe dart/examples/EchoServerStdio/main.dart -o dart/build/echo_server_stdio \
  && dart compile exe dart/examples/EchoClientStdio/main.dart -o dart/build/echo_client_stdio \
  && dart compile exe dart/examples/DynamicEchoServerStdio/main.dart -o dart/build/dynamic_echo_server_stdio \
  && dart compile exe dart/examples/InteropServerStdio/main.dart -o dart/build/interop_server_stdio

COPY zig ./zig
RUN cd zig && zig build --prefix build

# The rest of the repo.
COPY . .

# Tests shell out to git (releasegen exports from
# `git ls-files`; several suites call `git describe` /
# `git rev-parse`), but the build context excludes .git.
# Synthesize a repo over the copied tree so those work
# exactly as in a checkout.
RUN git init -q && git add -A \
  && git -c user.email=ci@localhost -c user.name=ci commit -qm "ci snapshot" \
  && git tag v0.0.0-ci

# Reproduce every generated artifact in-image (plugins, wire tables,
# fixtures, stubs) — this is also the toolchain smoke test.
RUN make generate

# Build the Go/WASM browser client artifacts for the wasm test.
RUN cd wasm/go && GOOS=js GOARCH=wasm go build -o ../../browser-test/echo.wasm ./cmd/echo_wasm \
  && cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" ../../browser-test/wasm_exec.js

# Warm the Scala.js facade package (scala-cli deps + JS linker).
RUN mkdir -p browser-test/scalajs_gen \
  && scala-cli --power package --force --js --js-module-kind esmodule --scala-version 3.3.6 \
       -o browser-test/scalajs_gen/echo_scalajs_client.mjs \
       wasm/scalajs/bridge.scala wasm/scalajs/EchoScalaJsGrpcDc.scala \
       scala/grpcdc/Transport.scala scala/grpcdc/Status.scala scala/grpcdc/WireGen.scala \
       scala/examples/EchoMessages.scala wasm/scalajs/echo_client.scala

# Build the official grpc-java oracle (downloads Maven dependencies
# at image build time; tests then run offline).
RUN cd oracle/java && mvn -q package -DskipTests

# Build the official grpc-go interop oracle binaries (second
# interop oracle; downloads Go modules at image build time).
# The server is our local main (./oracle-server: upstream's
# interop server plus the gzip encoding import upstream's main
# omits, which the compressed interop cases need); the client
# is the stock upstream main.
COPY oracle/go-interop/go.mod oracle/go-interop/go.sum ./oracle/go-interop/
COPY oracle/go-interop/oracle-server ./oracle/go-interop/oracle-server
RUN cd oracle/go-interop && GOFLAGS=-mod=mod go build -o interop-server ./oracle-server \
  && GOFLAGS=-mod=mod go build -o interop-client google.golang.org/grpc/interop/client

# Warm the webapp schema compiler (protocompile -> WASM; module
# downloads happen at image build time, test-webapp runs offline).
RUN cd webapp/compiler && go mod download \
  && GOOS=js GOARCH=wasm go build -o /tmp/protocompile.wasm .

# Merge the pre-COPY Racket/Wasm bootstrap (staged at
# /opt/racket-wasm-built above) into the webapp assets and
# build the in-browser plugins; tests then run them offline.
RUN cp -a /opt/racket-wasm-built/. webapp/assets/racket/ \
  && make webapp-plugins

# Playwright browsers + OS libraries for the real-browser test
# (browser-test/test.mjs: native RTCDataChannel in Chromium and
# Firefox against the reimplemented stack). Installed at build time;
# test runs need no network.
RUN cd browser-test && npm ci \
  && npx playwright install --with-deps chromium firefox webkit

# Deps are fetched and built above; test/demo runs need no network.
ENV CARGO_NET_OFFLINE=true

# WebKit is installed above (playwright install ... webkit);
# enabling this makes every `all`-mode browser test also run
# its WebKit case in this image. Host runs leave it unset
# unless WebKit's system libraries are present.
ENV GRPC_DC_WEBKIT=1

# ffmpeg/ffprobe for the YouTube video pipeline (video/build.mjs:
# slide segments, caption burn-in, loudness norm). Deliberately a
# late layer so the toolchain caches above stay warm; the Drama 3
# TTS server itself lives in Dockerfile.video (GPU, GB10 only).
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

CMD ["make", "test"]
